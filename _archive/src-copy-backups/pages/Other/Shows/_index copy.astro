---
export const prerender = true;
import BaseLayout    from "@/layouts/BaseLayout.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter    from "@/components/Footer.astro";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";

import { stories } from "@/data/Other/Stories/stories.mjs";
import "@/styles/global.css";

// ----------------------
// Dynamic Logic
// ----------------------
const sectionPath = "/Other/Shows";
const requestOrigin = Astro.site?.origin ?? new URL(Astro.request.url).origin;
const toAbsoluteUrl = (value) => {
  if (!value) return value;
  try {
    const maybeUrl = new URL(value);
    return maybeUrl.toString();
  } catch {
    const normalized = value.startsWith("/") ? value : `/${value}`;
    return new URL(normalized, requestOrigin).toString();
  }
};

const defaultCoverImage = stories.length > 0 ? stories[0].cover : "/images/K4-Stories logo1b.webp";

const structuredData = getStructuredData({
  type: "BlogPosting",
  data: {
    headline: "K4 Studios Picture Shows",
    description: "Interactive picture shows and visual presentations showcasing Wayne Heim's fine art photography through immersive storytelling experiences.",
    url: toAbsoluteUrl(sectionPath),
    copyrightNotice: "© Wayne Heim",
    author: { "@type": "Person", name: "Wayne Heim" },
    image: toAbsoluteUrl(defaultCoverImage)
  },
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: toAbsoluteUrl("/copyright"),
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: toAbsoluteUrl("/")
  }
});

// ItemList structured data
const itemListStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "K4 Studios Picture Shows",
  description: "Interactive visual presentations and themed exhibitions by Wayne Heim, combining fine art photography with cinematic storytelling.",
  url: toAbsoluteUrl(sectionPath),
  creator: {
    "@type": "Person",
    name: "Wayne Heim",
    url: toAbsoluteUrl("/")
  },
  itemListElement: stories.map((show, index) => ({
    "@type": "BlogPosting",
    position: index + 1,
    headline: show.title,
    url: toAbsoluteUrl(`/Other/Shows/${show.slug}`),
    datePublished:
      typeof show.date === "string" && /^\d{4}-\d{2}-\d{2}$/.test(show.date)
        ? `${show.date}T00:00:00Z`
        : show.date,
    image: toAbsoluteUrl(show.cover || defaultCoverImage),
    description: show.excerpt,
    author: {
      "@type": "Person",
      name: "Wayne Heim",
      url: toAbsoluteUrl("/")
    }
  }))
};

// Breadcrumb structured data
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: toAbsoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Shows", item: toAbsoluteUrl(sectionPath) }
  ]
};

const landingImgUrl = defaultCoverImage;
const meta = getLandingMeta(sectionPath, landingImgUrl);
if (!meta.ogUrl) meta.ogUrl = toAbsoluteUrl(sectionPath);
if (!meta.twitterUrl) meta.twitterUrl = toAbsoluteUrl(sectionPath);

meta.description =
  "Experience interactive picture shows from Wayne Heim — immersive visual presentations combining fine art photography with cinematic storytelling. Discover themed collections and narrative-driven exhibitions.";
meta.keywords =
  "picture shows, interactive photography, visual presentations, fine art exhibitions, cinematic storytelling, Wayne Heim, themed collections, immersive art experiences";
meta.ogTitle = "K4 Studios Picture Shows – Interactive Visual Presentations by Wayne Heim";
meta.ogDescription =
  "Explore interactive picture shows featuring Wayne Heim's fine art photography — themed visual presentations that combine storytelling with immersive gallery experiences.";
meta.ogImage = toAbsoluteUrl(landingImgUrl);
meta.twitterCard = "summary_large_image";

---

<BaseLayout
  title="K4 Studios Picture Shows – Interactive Visual Presentations & Fine Art Photography by Wayne Heim"
  structuredDataJSON={structuredData}
  meta={meta}
>
  <main class="bg-white text-[#2c2c2c] min-h-screen overflow-x-hidden" style="font-family: 'Glegoo', serif;">
    <link rel="canonical" href={toAbsoluteUrl(sectionPath)} />

    <div class="page-container w-full max-w-[1200px] mx-auto px-4">
      <div class="drawer-mode">
        <LandingHeader client:load breadcrumb="Other › Shows" />
      </div>

      <section class="section-heading-wrap text-center">
        <div class="section-heading">
          <h1 class="page-title fade-in reveal-on-scroll">Picture Shows</h1>
          <h2 class="page-subtitle fade-in reveal-on-scroll">Interactive visual presentations</h2>
        </div>
      </section>

      <section class="logo-section text-center mb-6 -mt-10">
        <img
          src="/images/K4-Stories logo1b.webp"
          alt="K4 Studios Logo"
          class="mx-auto max-w-60 h-auto"
          oncontextmenu="event.preventDefault()"
        />
      </section>

      <section class="intro-text max-w-6xl mx-auto px-4 text-center mb-10">
        <h2 class="text-4xl font-extrabold mb-2">K4 Studios Picture Shows</h2>
        <h3 class="text-2xl font-semibold mb-8 text-gray-700">Interactive Visual Presentations</h3>
        <p class="text-lg leading-relaxed text-gray-700">
          Experience the Picture Shows — interactive visual presentations that bring Wayne Heim's fine art photography to life through immersive storytelling. Each show is a carefully crafted sequence designed to engage viewers in a cinematic journey through art and history. From themed exhibitions to narrative-driven presentations, these interactive experiences showcase the depth and beauty of fine art photography in new and compelling ways. Discover how visual storytelling can transform the way we experience and connect with art.
        </p>
      </section>

      {stories.length > 0 ? (
        <section class="show-layout" style="font-family: 'Glegoo', serif;">
          <div class="text-column">
            {stories.map(show => (
              <article class="show-block mb-10">
                <div class="flex flex-col md:flex-row md:items-start gap-4">
                  <a href={`/Other/Stories/${show.slug}`} aria-label={show.title} class="flex-shrink-0">
                    <img
                      src={show.cover}
                      alt={show.alt || show.title}
                      class="rounded-2xl shadow max-w-[120px] h-[120px] object-cover"
                      style="aspect-ratio: 1/1;"
                      oncontextmenu="event.preventDefault()"
                    />
                  </a>
                  <div class="flex-1 min-w-0">
                    <h2 class="text-xl font-bold mb-2">
                      <a href={`/Other/Stories/${show.slug}`}>{show.title}</a>
                    </h2>
                    <p class="text-sm text-gray-600 mb-2">{show.date}</p>
                    <p class="mb-4">{show.excerpt}</p>
                    <a href={`/Other/Stories/${show.slug}`} class="underline text-blue-700">View Show →</a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="sidebar-column hidden md:block">
            <div class="sample-fade reveal-on-scroll p-4 border rounded-xl shadow bg-gray-50">
              <h3 class="font-bold mb-3">All Shows</h3>
              <ul class="space-y-2">
                {stories.map(show => (
                  <li>
                    <a href={`/Other/Stories/${show.slug}`} class="block hover:text-red-600">
                      {show.title}
                    </a>
                    <span class="block text-xs text-gray-500">{show.date}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      ) : (
        <section class="coming-soon text-center max-w-4xl mx-auto px-4 mb-16">
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-8 shadow-sm">
            <h3 class="text-2xl font-bold mb-4 text-gray-800">Coming Soon</h3>
            <p class="text-lg text-gray-600 mb-6">
              The Picture Shows section is currently under development. Interactive visual presentations and themed exhibitions will be available here soon.
            </p>
            <p class="text-sm text-gray-500">
              Check back for updates on new interactive shows featuring Wayne Heim's fine art photography.
            </p>
          </div>
        </section>
      )}

      {stories.length > 0 && (
        <script type="application/ld+json" set:html={JSON.stringify(itemListStructuredData)}></script>
      )}
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)}></script>
    </div>

    <SiteFooter
      title="K4 Studios Picture Shows - Interactive Visual Presentations"
      label="Explore Galleries"
      class="pt-8 pb-12"
    />

    <!-- MOBILE OVERFLOW PATCH -->
    <style>
      @media (max-width: 767px) {
        html, body {
          overflow-x: hidden !important;
          width: 100% !important;
          box-sizing: border-box;
        }
        main {
          overflow-x: hidden !important;
          max-width: 100vw !important;
        }
        .page-container {
          padding-left: 1rem !important;
          padding-right: 1rem !important;
        }
        .intro-text,
        .show-layout,
        .text-column,
        .sidebar-column,
        .coming-soon {
          margin-left: auto !important;
          margin-right: auto !important;
          max-width: 100% !important;
        }
        .page-title,
        .page-subtitle {
          margin-left: 1.5rem !important;
          margin-right: 1.5rem !important;
          width: auto !important;
        }
        img {
          max-width: 100% !important;
          height: auto !important;
        }
      }
    </style>
  </main>
</BaseLayout>
