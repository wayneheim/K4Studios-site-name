---
export const prerender = false;

import CommercialDoorwayAllPage from "@/components/doorway/CommercialDoorwayAllPage.astro";
import { galleryData as cowboyColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as cowboyBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs";
import { galleryData as narrativeColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs";
import { galleryData as narrativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { galleryData as westernLandscapeData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/ColorEntranceData.ts";
import { buildWesternWallArtDock } from "@/data/Western-Wall-Art/buildWesternWallArtDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
import { wallArtFAQ } from "@/data/Western-Wall-Art/faq.ts";
import { wallArtStory } from "@/data/Western-Wall-Art/story.ts";
import { landingWestern as landscapeLocationLanding } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/landingstones.ts";

const pagePath = "/Western-Wall-Art";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color";
const canonicalPath = pagePath;

const breadcrumbHtml = [
  '<a href="/">Wayne Heim</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  "Western Wall Art",
].join(" | ");

const breadcrumbStructuredItems = [
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
];

const { sectionDockItems, dockCenterIndex } = buildWesternWallArtDock();
const westernLandscapeTombstone = landscapeLocationLanding.tombstones.find((stone: any) =>
  String(stone.href || "").includes("/Landscapes/By-Location/West/")
)?.thumb;
const catalogPreviewLimit = 15;

const gridSections = [
  {
    title: "Narrative Western Wall Art - Color Frontier Scenes",
    description: "Color Western narrative art prints built around frontier atmosphere, cowboy stories, and cinematic one-frame tension.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/all#collection-browser",
    ctaLabel: "See the full color Western narrative collection",
    ctaThumb: "/img/i-5FX3W9r/s.jpg",
    items: narrativeColorData,
    limit: catalogPreviewLimit,
  },
  {
    title: "Black and White Western Wall Art - Narrative Prints",
    description: "Monochrome Western narrative photographs for collectors who want stronger contrast, restraint, and old West atmosphere.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white Western narrative collection",
    ctaThumb: "/img/i-kp5NHNw/s.jpg",
    items: narrativeBlackWhiteData,
    limit: catalogPreviewLimit,
  },
  {
    title: "Western Landscape Wall Art",
    description: "Painterly Western landscape photographs for rooms that need open space, mountain presence, and American West atmosphere.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery/all#collection-browser",
    ctaLabel: "See the full Western landscape collection",
    ctaThumb: westernLandscapeTombstone,
    items: westernLandscapeData,
    limit: catalogPreviewLimit,
  },
  {
    title: "Cowboy Art Prints - Color Western Portraits",
    description: "Color cowboy portrait prints with painterly light, frontier character, and room-ready Western presence.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/all#collection-browser",
    ctaLabel: "See the full color cowboy portrait collection",
    ctaThumb: "/img/i-5FX3W9r/s.jpg",
    items: cowboyColorData,
    limit: catalogPreviewLimit,
  },
  {
    title: "Black and White Cowboy Portrait Wall Art",
    description: "Black and white Western cowboy portraits for offices, lodges, ranch interiors, and collectors drawn to tonal frontier character.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white cowboy portrait collection",
    ctaThumb: "/images/tombstones/cowboy-bw-ts.webp",
    items: cowboyBlackWhiteData,
    limit: catalogPreviewLimit,
  },
];

const countLiveItems = (sections: typeof gridSections) =>
  sections.reduce((total, section) => total + section.items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  ).length, 0);
const westernWallArtLiveCount = countLiveItems(gridSections);

const commercialMiddleCopy = [
  "Much of the Western wall art sold online is built around surface style - a silhouette, a desert palette, a rustic theme. Wayne Heim's work begins somewhere else. These images are camera-captured and individually shaped through the eye of an award-winning medical illustrator and fine art photographer. The result is Western art with atmosphere, authorship, and story pressure - pieces that read as decor from across a room, then deepen into character, tension, and memory up close.",
  "Fine art prints are available from $25, with options ranging from small Sketch Series studies to larger collector-grade works and Engrained Baltic Birch wood-panel statement pieces.",
].join("\n\n");

const copy = {
  seoTitle: "Western Wall Art - Fine Art Prints by Wayne Heim | K4 Studios",
  seoDescription:
    "Western wall art by Wayne Heim: cowboy portraits, frontier scenes, and Western landscape prints for homes, offices, lodges, and collectors.",
  descriptionMaxLength: "155",
  indexDefinition:
    "Wayne Heim's Western wall art includes cowboy wall art, Western art prints, vintage Western art, Wild West scenes, and frontier landscapes created as collector-grade fine art for real rooms and long-term display.",
  indexLinkNote:
    wallArtStory[0]?.paragraphs?.[1] || "This page is a broad starting point for collectors, homeowners, offices, lodge spaces, hospitality projects, and interior designers looking for Western wall decor with more authorship than generic inventory.",
  printAvailabilityNote: `All works are available as fine art prints from ${getFormattedLowestStandardPrintPrice()}. Select images are also available in the Engrained Series - printed on Baltic Birch using a five-layer UV process - with pricing specific to each image.`,
  commercialH1: "The Collection — Five Print Series, 905 Works",
  commercialDeck:
    "Cowboy portraits, frontier landscapes, narrative Western scenes, and character studies — in color and black and white, organized for rooms, collectors, and interior decisions.",
  catalogEntranceTitle: "Western Art Prints, Cowboy Wall Art, and Frontier Fine Art",
  catalogEntranceCopy:
    "Browse cowboy wall art, Western art prints, vintage Western art, Wild West scenes, and frontier landscapes created as collector-grade fine art for real rooms and long-term display.",
  collectionIntro: commercialMiddleCopy,
  breadcrumbCurrentName: "Western Wall Art",
  aggregateOfferLowPrice: "25",
  aggregateOfferHighPrice: "5000",
  aggregateOfferCount: String(westernWallArtLiveCount),
  gatewayCollectionName: "Western Wall Art",
  gatewayIntroCopy:
    "Western wall art by Wayne Heim, available as archival fine art prints ranging from the small-works introductory Sketch Series at $25 to the ultra-limited, large-format Legend Series for collectors seeking statement pieces with permanence and presence. Cowboy portraits, frontier scenes, Western landscapes, black-and-white studies, and story-driven artwork for homes, offices, lodges, hospitality spaces, and collector interiors.",
  gatewaySupportingCopy:
    "These works begin as photography, then are shaped through Heim’s painterly process into Western fine art with atmosphere, authorship, and narrative weight — pieces that can read from across a room, then deepen into character, tension, and memory up close.\n\nThe collection begins with the small-works Sketch Series, intimate 5×7 open edition pieces priced at $25 — sized for shelves, desks, and introductory collecting. It scales through open-edition Foundation works, signed Chronicle editions with numbered certificates, and ultra-limited Legend pieces for collectors who want provenance and permanence on the wall.\n\nUse the collection links below to browse by subject, mood, and finish, then open any piece to compare prints, read image stories, explore collector notes, and view print details.",
  gatewayBrandLabel: "Western Wall Art - Fine Art Prints by Wayne Heim",
  faqTitle: "Western Wall Art FAQ",
};
---

<CommercialDoorwayAllPage
  rawGalleryData={cowboyColorData}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Explore Western Wall Art Collections"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits",
    categoryName: "Western Cowboy Portraits",
  }}
  identity={{
    collectionName: "Western Wall Art",
    variantName: "Fine Art Prints",
    variantDescriptor: "western wall art",
    gatewayBrandLabel: "Western Wall Art - Fine Art Prints by Wayne Heim",
  }}
  copy={copy}
  faqItems={wallArtFAQ.slice(0, 8)}
  gridSections={gridSections}
  dockVariant="wall-art"
/>
