---
export const prerender = true;
import BaseLayout         from '@/layouts/BaseLayout.astro';
import LandingHeader      from '@/components/Landing-Header.jsx';
import ImageBar2          from '@/components/ImageBar2.jsx';
import TombstoneNav       from '@/components/TombstoneNav.jsx';
import LandingRightImages from '@/components/LandingRightImages.jsx';
import FAQAccordion       from '@/components/FAQAccordion.jsx';
import SiteFooter         from '@/components/Footer.astro';
import MobileStoryImages  from '@/components/MobileStoryImages.jsx';
import StorySlider        from '@/components/StorySlider.tsx';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';

// Story slider can still point at a cowboy gallery (fine)
import { galleryData as cowboyColorDataFull }
  from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs';
import { galleryData as cowboyBWData }
  from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs';
import { galleryData as cowboyNAData }
  from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/NA-Color.mjs';
import { storySliderImageIds } from '@/data/storySlider.ts';

import { getStructuredData, getBreadcrumbList } from '@/components/utils/getStructuredData.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';

import { siteNav } from '@/data/siteNav.ts';
import { getFeatheredImages } from '@/components/utils/getFeatheredImages.ts';
import { autoLinkKeywordsInText } from '@/components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '@/data/semantic/K4-Sem.ts';

// ✅ HUB-SCOPED DATA SOURCES (your duped folder)
import { landingWestern }
  from '@/data/Painterly-Western-Photography/landingstones.ts';
import { painterlyStory as westernStory }
  from '@/data/Painterly-Western-Photography/story.ts';
import { facingFAQ }
  from '@/data/Painterly-Western-Photography/faq.ts';

import '@/styles/global.css';
// If your hub page relied on this for header styling, keep it:
import '@/styles/oneupheader.css';

// ----------------------
// PATHS (THIS IS THE FIX)
// ----------------------

// ✅ The actual page URL (NOT in siteNav)
const pagePath = "/Painterly-Western-Photography";

// ✅ A REAL siteNav node to power feathering + gallery pool + autolinking
// (This is why Cowboy page works — we emulate that here)
const imageSectionPath =
  "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits";

// ----------------------
// STORY SLIDER DATA
// ----------------------
const cowboyColorData = cowboyColorDataFull
  .filter((img: any) => storySliderImageIds.includes(img.id))
  .map((img: any) => ({ id: img.id, title: img.title, story: img.story }));

// ----------------------
// NAV HELPERS
// ----------------------
function findNavEntry(nav: any[], url: string): any | null {
  for (const entry of nav) {
    if (entry.href === url) return entry;
    if (entry.children) {
      const found = findNavEntry(entry.children, url);
      if (found) return found;
    }
  }
  return null;
}

// Cowboy page uses children-only; keep same behavior for a clean pool.
const landingNav = findNavEntry(siteNav as any, imageSectionPath);
const galleryPaths: string[] = landingNav?.children?.map((c: any) => c.href) || [];

// Load galleryData for those galleryPaths
const allGalleryData = import.meta.glob('../../data/Galleries/**/*.mjs', { eager: true }) as any;
const galleryDatas = galleryPaths.map((path) => {
  const filePath = "../../data/Galleries" + path.replace(/^\/Galleries/, "") + ".mjs";
  return allGalleryData[filePath]?.galleryData || [];
});

// Feathering uses headingCount to decide how many it needs
const headingCount = westernStory.filter((block: any, i: number) => i > 0 && block.subhead).length;

// ✅ Feathered images: now strictly cowboy-universe, because imageSectionPath is cowboy node
const featheredImages = getFeatheredImages({
  sectionPath: imageSectionPath,
  headingCount: Math.max(headingCount, 9),
  galleryDatas,
  galleryPaths,
  minRating: 3,      // Lower threshold to get more images
  fallbackMin: 1,    // Allow any rated image as fallback
  poolMultiplier: 3  // 3x images for client-side rotation
});
// Pass full pool to component for client-side rotation

// ----------------------
// STRUCTURED DATA (URL MUST BE THE HUB PAGE)
// ----------------------
const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingWestern.title,
    description: landingWestern.subtitle || landingWestern.description,
    url: `https://k4studios.com${pagePath}`,
    keywords: landingWestern.keywords || [],
    copyrightNotice: "© Wayne Heim",
    // Enhanced "about" topics specific to Painterly methodology
    about: [
      { "@type": "Thing", name: "Painterly Photography" },
      { "@type": "Thing", name: "American West Art" },
      { "@type": "Thing", name: "One-Image Movie" },
      { "@type": "Thing", name: "Pictorialist Photography" },
      { "@type": "Thing", name: "American Frontier" },
      { "@type": "Thing", name: "Fine Art Western Photography" },
      { "@type": "Thing", name: "Old West" },
    ],
    genre: "Painterly Fine Art Photography",
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    acquireLicensePage: "https://k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

// ----------------------
// BREADCRUMB STRUCTURED DATA
// ----------------------
const breadcrumbData = getBreadcrumbList([
  { name: "Home", item: "https://k4studios.com/" },
  { name: "Painterly Western Photography", item: `https://k4studios.com${pagePath}` },
]);

// ----------------------
// FAQ STRUCTURED DATA (for rich snippets)
// ----------------------
// Helper to strip HTML tags for plain text answers
const stripHtml = (text: string) => text.replace(/<[^>]*>/g, '').trim();

const faqStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `https://k4studios.com${pagePath}#faq`,
  mainEntity: facingFAQ.slice(0, 10).map((item: any) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: stripHtml(Array.isArray(item.a) ? item.a.join(" ") : item.a),
    },
  })),
}, null, 2);

// ----------------------
// WEBPAGE SCHEMA (method/discipline authority - Painterly focus)
// ----------------------
const webPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `https://k4studios.com${pagePath}#webpage`,
  url: `https://k4studios.com${pagePath}`,
  name: "Painterly Western Photography",
  description: "Painterly Western photography by Wayne Heim exploring the craft, discipline, and narrative philosophy behind character-driven cowboy portraits and fine art.",
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    "@id": "https://k4studios.com/#website",
    name: "K4 Studios",
    url: "https://k4studios.com/"
  },
  about: [
    { "@type": "Thing", name: "Painterly Western Photography" },
    { "@type": "Thing", name: "Painterly Photography" },
    { "@type": "Thing", name: "Pictorialism" },
    { "@type": "Thing", name: "One-Image Movie" },
    { "@type": "Thing", name: "Narrative Photography" },
    { "@type": "Thing", name: "Photographic Craft" },
  ],
  author: { "@id": "https://k4studios.com/#person" },
  creator: { "@id": "https://k4studios.com/#person" },
  copyrightHolder: { "@id": "https://k4studios.com/#person" },
  mainEntity: { "@id": `https://k4studios.com${pagePath}#imagegallery` },
}, null, 2);

// OG/Twitter image: first feathered image
function makeAbsoluteUrl(src?: string) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) return src;
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

// Proxy URL helper - ensures SmugMug URLs never appear in SSR HTML
function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return `/img/${imageId}/${size}`;
}

const landingImg = featheredImages[0];
const landingImgUrl = landingImg?.id ? makeAbsoluteUrl(getProxySrc(landingImg.id, 'l')) : '';

// ✅ Meta should be keyed to the HUB PAGE, not the cowboy gallery path
const meta = getLandingMeta(pagePath, landingImgUrl);
if (!meta.ogUrl) meta.ogUrl = `https://k4studios.com${pagePath}`;
if (!meta.twitterUrl) meta.twitterUrl = `https://k4studios.com${pagePath}`;

// ----------------------
// DYNAMIC TOMBSTONE THUMBNAILS
// ----------------------
// Helper: Get an array of valid thumbnail URLs from gallery data (first 10 images)
function getTombstoneThumbs(galleryData: any[]): string[] {
  const validImages = galleryData
    .filter((img: any) => img.id !== 'i-k4studios' && img.visibility !== 'ghost')
    .slice(0, 10); // Pool of first 10 images
  return validImages
    .map((img: any) => img.id ? getProxySrc(img.id, 's') : '')
    .filter((src: string) => src !== '');
}

// Map gallery hrefs to their data for dynamic thumb lookup
const tombstoneGalleryMap: Record<string, any[]> = {
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color': cowboyColorDataFull,
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White': cowboyBWData,
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/NA-Color': cowboyNAData,
};

// Build tombstones with thumbs array for client-side random selection
const tombstonesWithThumbs = landingWestern.tombstones.map((stone: any) => {
  // If thumb is already set (like Engrained), keep it as single item
  if (stone.thumb) return { ...stone, thumbs: [stone.thumb] };
  // Otherwise, build thumbs array from gallery data
  const galleryData = tombstoneGalleryMap[stone.href];
  const thumbs = galleryData ? getTombstoneThumbs(galleryData) : [];
  return {
    ...stone,
    thumb: thumbs[0] || '', // Fallback for SSR
    thumbs, // Array for client-side random selection
  };
});
---

<BaseLayout
  title="Painterly Western Photography – Wayne Heim"
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbData}
  meta={meta}
>
  <!-- FAQ Structured Data for rich snippets -->
  <script type="application/ld+json" set:html={faqStructuredData} slot="head"></script>
  <!-- WebPage Schema for method/discipline authority -->
  <script type="application/ld+json" set:html={webPageSchema} slot="head"></script>
  
  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingWestern.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingWestern.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4">
      <div class="carousel-fade reveal-on-scroll">
        <ImageBar2 client:load />
      </div>
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">{landingWestern.title}</h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">{landingWestern.subtitle}</h2>
      </div>
    </section>

    <div class="py-5">
      <TombstoneNav client:load items={tombstonesWithThumbs} />
    </div>

    <section class="story-layout">
      <div class="text-column">
        <section class="story-section">
          {westernStory.map((section: any, index: number) => (
            <article class="story-block" key={index}>
              {section.title && (
                <h2 class="slide-in-left" set:html={autoLinkKeywordsInText(section.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}
              {section.subhead && (
                <h3 class="slide-in-left" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}
              {section.tagline && (
                <h4 class="tagline reveal-on-scroll" set:html={autoLinkKeywordsInText(section.tagline, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}

              {section.paragraphs?.map((para: string, i: number) => (
                <p key={i} class="reveal-on-scroll" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              ))}

              {section.list && section.list.length > 0 && (
                <ul>
                  {section.list.map((item: string, j: number) => (
                    <li key={j} class="reveal-on-scroll" set:html={autoLinkKeywordsInText(item, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
                  ))}
                </ul>
              )}

              {/* Insert StorySlider where you want it */}
              {index === 1 && (
                <div class="story-slider-wrapper reveal-on-scroll mt-8">
                  <div class="story-slider-skeleton relative bg-[#ebe5dc] rounded-lg shadow-md px-6 py-5 max-w-2xl mx-auto border-2 border-[#d8d0c4] mb-12 h-[280px] overflow-hidden">
                    <div class="absolute top-2.5 left-2.5 w-3.5 h-3.5 border-l-2 border-t-2 border-[#c8bfb0]"></div>
                    <div class="absolute bottom-2.5 right-2.5 w-3.5 h-3.5 border-r-2 border-b-2 border-[#c8bfb0]"></div>
                    <p class="text-[11px] uppercase tracking-[0.12em] text-[#8c7d6b] mb-3">One-Image Movie™ Preview</p>
                    <div class="animate-pulse">
                      <div class="h-5 bg-[#d8d0c4] rounded w-3/4 mb-3"></div>
                      <div class="h-4 bg-[#d8d0c4] rounded w-full mb-2"></div>
                      <div class="h-4 bg-[#d8d0c4] rounded w-5/6 mb-2"></div>
                      <div class="h-4 bg-[#d8d0c4] rounded w-4/6"></div>
                    </div>
                  </div>

                  <StorySlider
                    client:only="react"
                    stories={cowboyColorData}
                    galleryPath="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color"
                  />
                </div>
              )}
            </article>
          ))}
        </section>

        <MobileStoryImages client:only="react" images={sanitizeForClient(featheredImages)} displayCount={headingCount} />
      </div>

      <div class="sidebar-column hidden md:block">
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages
            client:load
            heading="Collection Samples"
            images={featheredImages}
            displayCount={6}
          />
        </div>
      </div>
    </section>

    <section class="pb-10">
      <input type="checkbox" id="faq-toggle" class="more-toggle" />
      <div class="truncate-container" style="min-height:0;">
        <div class="truncate-text">
          <FAQAccordion items={facingFAQ} />
        </div>
      </div>
      <label for="faq-toggle" class="more-toggle-label"></label>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }

      const faqToggle = document.getElementById("faq-toggle");
      const truncateContainer = document.querySelector(".truncate-container");
      if (truncateContainer && faqToggle) {
        truncateContainer.addEventListener("click", (e) => {
          const summaryClicked = e.target.closest("summary");
          if (summaryClicked && !faqToggle.checked) faqToggle.checked = true;
        });
      }
    });
  </script>

  <style>
    ul { list-style-type: disc; padding-left: 1.25em; }
    ul li { margin-top: 0.15em; margin-left: 1.5em; }
    ul li::marker { margin-top: 0.15em; font-size: 1.2em; color: gray; }

    @media (max-width: 768px) {
      .section-heading .page-title { font-size: 1.5rem; line-height: 1.3; }
      .section-heading .page-subtitle {
        max-width: 42ch; margin-left: auto; margin-right: auto; text-align: center;
        font-size: 1rem; line-height: 1.4; letter-spacing: -0.04em;
      }
      .section-heading-wrap { margin-top: 1rem; margin-bottom: 1rem; }
      .sidebar-column { display: none; }
      .story-section { letter-spacing: -0.03em; }
      .story-block h2 {
        letter-spacing: -0.05em;
        font-size: 1.4rem !important;
        margin-top: -0.59rem;
        line-height: 1.15;
      }
    }

    .fade-in {
      opacity: 0; visibility: hidden; transform: translateY(1px);
      transition: opacity 1.75s ease, transform 1.75s ease, visibility .5s linear 1.75s;
    }
    .fade-in.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }
    .page-title.fade-in { transition-delay: .2s; }

    .section-heading-wrap { margin: -3rem 0 1.5rem; text-align: center; }
    .section-heading .page-title { font-size: 2rem; margin-bottom: .4rem; }
    .section-heading .page-subtitle { font-size: 1rem; font-weight: 500; color: #6d5b4a; opacity: .9; }

    .story-section {
      line-height: 1.3; padding: 2rem 1.5rem; max-width: 860px; margin: 0 auto;
      font-family: 'Glegoo', serif;
    }
    .story-block { margin-bottom: 2.5rem; }
    .story-block h2 { font-weight: 500; font-size: 1.65rem; margin-bottom: 0.55rem; }
    .story-block h3 { font-weight: 500; font-size: 1.2rem; margin-top: -0.5rem; margin-bottom: -.025rem; color: #5a4a3b; }
    .story-block .tagline { font-size: 1.05rem; font-weight: 500; margin-bottom: 1rem; color: #7a6250; }
    .story-block p { line-height: 1.6; margin-bottom: 1rem; font-size: 1.01rem; }
    .story-block ul { padding-left: 1.4rem; margin-top: 0.5rem; }
    .story-block li { margin-bottom: 0.5rem; font-size: 1rem; }

    .page-subtitle.fade-in {
      opacity: 0 !important;
      transform: translateY(-12px);
      visibility: hidden;
      transition: opacity 1.1s ease-out, transform 1.1s ease-out, visibility 0s linear 1.1s;
      transition-delay: 1s;
    }
    .page-subtitle.fade-in.is-visible {
      opacity: 1 !important;
      transform: translateY(0);
      visibility: visible;
      transition-delay: 1s;
    }

    .carousel-fade {
      opacity: 0; transform: translateY(0px);
      transition: opacity 1.5s ease-out, transform 1.5s ease-out;
      transition-delay: 0.0s;
      visibility: hidden;
    }
    .carousel-fade.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }

    .sample-fade {
      opacity: 0; transform: translateY(0px);
      transition: opacity 1.5s ease-out, transform 1.5s ease-out;
      transition-delay: 0.2s;
      visibility: hidden;
      margin-top: -0.75rem;
    }
    .sample-fade.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }
  </style>
</BaseLayout>
