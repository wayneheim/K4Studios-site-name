---
export const prerender = true;
import BaseLayout         from '@/layouts/BaseLayout.astro';
import LandingHeader      from '@/components/Landing-Header.jsx';
import ImageBar2          from '@/components/ImageBar2.jsx';
import SiteFooter         from '@/components/Footer.astro';

import { getStructuredData, getBreadcrumbList } from '@/components/utils/getStructuredData.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';

import { getOrderedWesternGalleryPaths } from '@/data/carousel/westernRouting.ts';
import { getFeatheredImages } from '@/components/utils/getFeatheredImages.ts';
import { autoLinkKeywordsInText } from '@/components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '@/data/semantic/K4-Sem.ts';

// Hub-scoped data
import { slides as engrainedSlides } from '@/data/Other/K4-Select-Series/Engrained/carousel.ts';
import {
  thesis,
  definition,
  faqItems,
  catalogImages,
  pageMeta,
  breadcrumb as interiorBreadcrumb,
} from '@/data/hybrid-hubs/interior-design-rustic.ts';

import '@/styles/global.css';
import '@/styles/oneupheader.css';

// ----------------------
// PATHS
// ----------------------
const pagePath = "/Rustic-Western-Interior-Design-Art";
const imageSectionPath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits";

const galleryPaths: string[] = getOrderedWesternGalleryPaths(imageSectionPath);

// Load galleryData for those galleryPaths
const allGalleryData = import.meta.glob('../../data/Galleries/**/*.mjs', { eager: true }) as any;
const galleryDatas = galleryPaths.map((path) => {
  const filePath = "../../data/Galleries" + path.replace(/^\/Galleries/, "") + ".mjs";
  return allGalleryData[filePath]?.galleryData || [];
});

const landingWallArt = {
  title: pageMeta.title,
  subtitle: thesis.subtitle,
  keywords: [
    'rustic western interior design',
    'western home interior design ideas',
    'rustic western interior design art',
    'western lodge wall art',
    'engrained wood prints',
    'statement western artwork',
    'fine art for western interiors',
    'painterly western photography',
  ],
  breadcrumb: interiorBreadcrumb,
};

const wallArtStory = [
  {
    title: thesis.heading,
    subhead: thesis.subtitle,
    paragraphs: thesis.body,
  },
  {
    subhead: definition.heading,
    paragraphs: definition.paragraphs.slice(0, 4),
  },
  {
    subhead: 'Specifier Notes',
    paragraphs: definition.paragraphs.slice(4, 8),
  },
];

const wallArtFAQ = faqItems;

// Feathering
const headingCount = wallArtStory.filter((block: any, i: number) => i > 0 && block.subhead).length;

const featheredImages = getFeatheredImages({
  sectionPath: imageSectionPath,
  headingCount: Math.max(headingCount, 9),
  galleryDatas,
  galleryPaths,
  minRating: 3,
  fallbackMin: 1,
  poolMultiplier: 3
});

const wallArtInfoBlocks = wallArtStory.slice(0, 3);
const leadWallArtBlock = wallArtInfoBlocks[0];
const secondaryWallArtBlocks = wallArtInfoBlocks.slice(1);
const wallArtFAQMidpoint = Math.ceil(wallArtFAQ.length / 2);
const wallArtFAQLeft = wallArtFAQ.slice(0, wallArtFAQMidpoint);
const wallArtFAQRight = wallArtFAQ.slice(wallArtFAQMidpoint);
const wildWestGridImages = catalogImages.slice(0, 25);
const fullWildWestIndexPath = '/Western-Interior-Design-Art';

// ----------------------
// STRUCTURED DATA
// ----------------------
const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingWallArt.title,
    description: landingWallArt.subtitle,
    url: `https://k4studios.com${pagePath}`,
    keywords: landingWallArt.keywords || [],
    copyrightNotice: "© Wayne Heim",
    about: [
      { "@type": "Thing", name: "Rustic Western Interior Design Art" },
      { "@type": "Thing", name: "Engrained Wood Prints" },
      { "@type": "Thing", name: "Western Lodge Wall Art" },
      { "@type": "Thing", name: "Painterly Western Photography" },
      { "@type": "Thing", name: "Western Landscape Art" },
    ],
    genre: "Rustic Western Interior Design Art",
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    acquireLicensePage: "https://k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

// Breadcrumb
const breadcrumbData = getBreadcrumbList([
  { name: "Home", item: "https://k4studios.com/" },
  { name: "Rustic Western Interior Design Art", item: `https://k4studios.com${pagePath}` },
]);

// FAQ Structured Data
const stripHtml = (text: string) => text.replace(/<[^>]*>/g, '').trim();

const faqStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `https://k4studios.com${pagePath}#faq`,
  mainEntity: wallArtFAQ.slice(0, 10).map((item: any) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: stripHtml(Array.isArray(item.a) ? item.a.join(" ") : item.a),
    },
  })),
}, null, 2);

// WebPage Schema
const webPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `https://k4studios.com${pagePath}#webpage`,
  url: `https://k4studios.com${pagePath}`,
  name: pageMeta.title,
  description: pageMeta.description,
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    "@id": "https://k4studios.com/#website",
    name: "K4 Studios",
    url: "https://k4studios.com/"
  },
  about: [
    { "@type": "Thing", name: "Western Interior Design Art" },
    { "@type": "Thing", name: "Engrained Wood Prints" },
    { "@type": "Thing", name: "Western Wall Art" },
    { "@type": "Thing", name: "Painterly Western Photography" },
    { "@type": "Thing", name: "Western Landscape Art" },
  ],
  author: { "@id": "https://k4studios.com/#person" },
  creator: { "@id": "https://k4studios.com/#person" },
  copyrightHolder: { "@id": "https://k4studios.com/#person" },
  mainEntity: { "@id": `https://k4studios.com${pagePath}#imagegallery` },
}, null, 2);

// OG/Twitter image - use proxy URLs to avoid exposing SmugMug
function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return `/img/${imageId}/${size}.jpg`;
}

function makeAbsoluteUrl(src?: string) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) return src;
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}
const firstEngrainedId = (engrainedSlides[0]?.src || '').match(/\/(i-[^/]+)\.jpg$/)?.[1];
const fallbackImageId = featheredImages[0]?.id;
const landingImageId = firstEngrainedId || fallbackImageId;
const landingImgUrl = landingImageId ? makeAbsoluteUrl(getProxySrc(landingImageId, 'l')) : '';

const meta = getLandingMeta(pagePath, landingImgUrl);
if (!meta.ogUrl) meta.ogUrl = `https://k4studios.com${pagePath}`;
if (!meta.twitterUrl) meta.twitterUrl = `https://k4studios.com${pagePath}`;

const explorationPaths = [
  {
    title: "Western Interior Design Art Hub",
    eyebrow: "System / Orientation",
    hideEyebrow: true,
    href: "/Western-Interior-Design-Art",
    description: "Start with the full interior design philosophy and broader system before narrowing into specific directions.",
    cta: "OPEN HUB ->",
    accent: "#6d5b4a",
  },
  {
    title: "Wild West Collection",
    eyebrow: "The Work (Primary Path)",
    href: "/Facing-History/Wild-West",
    description: "The full body of work-where narrative, character, and story live beyond a single space.",
    cta: "EXPLORE THE WORK ->",
    accent: "#7b4a28",
    featured: true,
  },
  {
    title: "Modern Western Interiors",
    eyebrow: "Contrast Path",
    hideEyebrow: true,
    href: "/Modern-Western-Interior-Design-Art",
    description: "Compare this warm, material-heavy route with a cleaner modern weighting and more negative space.",
    cta: "Explore modern path -",
    accent: "#4d4037",
  },
];

const quickExploreLinks = [
  {
    label: "Interior Design Hub",
    href: "/Western-Interior-Design-Art",
  },
  {
    label: "Designer Spec Page",
    href: "/Western-Wall-Art-for-Interior-Designers",
  },
  {
    label: "Wild West Collection",
    href: "/Facing-History/Wild-West",
  },
  {
    label: "Modern Path",
    href: "/Modern-Western-Interior-Design-Art",
  },
];

const collectingLevels = [
  {
    marks: [{ symbol: "✽", label: "Sketch Series" }],
    titleLead: "Entry Works",
    titleTail: "Studies & First Acquisitions",
    sizingTip: "5x7 prints. Easily matted for 8x10 framing.",
    body: "Smaller open-edition studies that let any levels of collector take home these works. All images start at this level. Designed as a first step for collectors to begin exploring each series and the stories. Designed as an accessible entry point for collectors and designers specifying multiple spaces.",
  },
  {
    marks: [{ symbol: "✯", label: "Foundation Series" }],
    titleLead: "Open Editions",
    titleTail: "Open & Archive Prints",
    sizingTip: "Multiple sizes available, including 8x10 and 11x14.",
    body: "Full-scale works produced with archival materials and flexible presentation options. Built for long-term display and lasting visual presence.",
  },
  {
    marks: [
      { symbol: "⌘", label: "Chronicle Series" },
      { symbol: "❖", label: "Legend Series" },
    ],
    titleLead: "Signature Works",
    titleTail: "Limited & Signed Editions",
    sizingTip: "Multiple sizes available, including 16x20, 20x24, 30x40, and 40x60.",
    body: "Select images released in limited numbers, signed and authored. These represent the closest expression of the work as finished art objects.",
  },
];

const heroSlides = [engrainedSlides[4], engrainedSlides[5], engrainedSlides[7], engrainedSlides[3]].filter(Boolean);
const inRoomSlides = [engrainedSlides[4], engrainedSlides[5], engrainedSlides[7]].filter(Boolean);
---

<BaseLayout
  title={pageMeta.title}
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbData}
  meta={meta}
>
  <script type="application/ld+json" set:html={faqStructuredData} slot="head"></script>
  <script type="application/ld+json" set:html={webPageSchema} slot="head"></script>
  
  <main class="wallart-page bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingWallArt.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingWallArt.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4">
      <div class="carousel-container">
        <div class="carousel-placeholder" aria-hidden="true"></div>
        <div class="carousel-fade reveal-on-scroll">
          <ImageBar2 slides={heroSlides.length ? heroSlides : engrainedSlides} client:load />
        </div>
      </div>
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">{landingWallArt.title}</h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">{landingWallArt.subtitle}</h2>
      </div>
    </section>

    <section class="term-section">
      <div class="term-shell">
        <div class="term-header">
          {leadWallArtBlock.title && (
            <h2 class="term-header__title" set:html={autoLinkKeywordsInText(leadWallArtBlock.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
          )}
        </div>

        <article class="term-block term-block--lead">
          {leadWallArtBlock.subhead && (
            <h3 class="term-block__subhead" set:html={autoLinkKeywordsInText(leadWallArtBlock.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
          )}
          {leadWallArtBlock.paragraphs?.map((para: string) => (
            <p class="term-block__body" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
          ))}
        </article>

        {secondaryWallArtBlocks.map((section: any, index: number) => (
          <article class:list={["term-block", index === 0 ? "term-block--secondary" : "term-block--tertiary"]}>
            {section.subhead && (
              <h3 class="term-block__subhead" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
            )}
            {section.paragraphs?.map((para: string) => (
              <p class="term-block__body" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
            ))}
            {index === 1 && (
              <div class="term-block__watermark" aria-hidden="true">
                <span>Embrace the past..</span>
                <span>Live the Story</span>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="exploration-section">
      <div class="exploration-shell reveal-on-scroll">
        <p class="exploration-intro">Explore Rustic Western Interior Design Routes</p>
        <div class="exploration-grid">
          {explorationPaths.map((path) => (
            <a
              href={path.href}
              class:list={["exploration-card", path.featured && "exploration-card--featured"]}
              style={`--path-accent:${path.accent};`}
            >
              {!path.hideEyebrow && <span class="exploration-card__eyebrow">{path.eyebrow}</span>}
              <h3 class="exploration-card__title">{path.title}</h3>
              <p class="exploration-card__body">{path.description}</p>
              <span class="exploration-card__cta">{path.cta}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="collection-section">
      <div class="collection-shell">
        <div class="collection-heading reveal-on-scroll">
          <p class="collection-kicker">Selected Works</p>
          <h2 class="collection-title">Rustic Western Art for Interior Design (Weighted for Texture and Presence)</h2>
          <p class="collection-intro">Below is a portrait-led planning grid for rustic western interior design, emphasizing tactile imagery, wood-forward visual language, and grounded narrative moments.</p>
          <p class="collection-intro">Use this sequence when the room needs warmth, material continuity, and authored visual weight rather than purely scenic flow.</p>
          <div class="quick-explore-links">
            {quickExploreLinks.map((link) => (
              <a href={link.href} class="quick-explore-links__item">{link.label}</a>
            ))}
          </div>
        </div>

        <div class="wallart-grid reveal-on-scroll">
          {wildWestGridImages.map((item: any) => (
            <a href={item.href || `/Other/K4-Select-Series/Engrained/Engrained-Series/${item.id}`} class="wallart-grid__tile" title={item.title}>
              <div class="wallart-grid__img-wrap">
                <img
                  src={getProxySrc(item.id, 'm')}
                  data-fallback-src={item.srcM || item.src || ''}
                  alt={item.alt || `Western interior design art by Wayne Heim: ${item.title}`}
                  loading="lazy"
                  onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) { this.src = this.dataset.fallbackSrc; }"
                  width="400"
                  height="400"
                  class="wallart-grid__img"
                />
                <span class="wallart-grid__hover">View Image</span>
              </div>
              <p class="wallart-grid__title">{item.title}</p>
            </a>
          ))}
        </div>

        <div class="collection-footer reveal-on-scroll">
          <a href={fullWildWestIndexPath} class="collection-index-link">Return to the main Western Interior Design Art hub</a>
        </div>
      </div>
    </section>

    <section class="collecting-section">
      <div class="collecting-shell reveal-on-scroll">
        <div class="collecting-heading">
          <h2 class="collecting-title">Collecting for Rustic Western Spaces</h2>
          <p class="collecting-intro">This pathway is built for rooms where material texture and narrative presence are part of the architecture, not secondary decoration.</p>
        </div>

        <div class="collecting-layout">
          <div class="collecting-grid">
            {collectingLevels.map((level, levelIndex) => (
              <article class="collecting-card">
                <h3 class="collecting-card__title">
                  {level.marks?.length ? (
                    <span class="collecting-card__marks" aria-label="Series ID marks">
                      {level.marks.map((mark) => (
                        <span
                          class="collecting-card__mark"
                          title={mark.label}
                          data-tooltip={mark.label}
                          aria-label={mark.label}
                          tabindex="0"
                        >{mark.symbol}</span>
                      ))}
                    </span>
                  ) : null}
                  <span
                    class="collecting-card__title-hover"
                    data-tooltip={level.sizingTip}
                    aria-label={level.sizingTip}
                    tabindex="0"
                  >
                    <strong>{level.titleLead}</strong>
                    <span> - {level.titleTail}</span>
                  </span>
                </h3>
                <p class="collecting-card__body">
                  {level.body}
                  {levelIndex === collectingLevels.length - 1 && (
                    <>
                      {" "}For more on series and finishing option see <a href="/Other/Series">Series Info</a>.
                    </>
                  )}
                </p>
              </article>
            ))}
          </div>

          <div class="room-strip" aria-label="In-room presentation examples">
            <div class="room-strip__viewport">
              {inRoomSlides.map((slide: any, index: number) => (
                <a
                  href={slide.href}
                  class:list={["room-slide", index === 0 && "is-active", index === 2 && "room-slide--third"]}
                  data-room-slide
                  data-slide-index={index}
                  aria-hidden={index === 0 ? "false" : "true"}
                >
                  <img src={slide.src} alt={slide.alt || "In-room fine art presentation"} loading="lazy" />
                </a>
              ))}
            </div>

            <a href="/Other/K4-Select-Series/Engrained" class="room-strip__link room-strip__link--below">Explore Engrained Series</a>

            <div class="room-strip__dots" role="tablist" aria-label="In-room slides">
              {inRoomSlides.map((_: any, index: number) => (
                <button
                  type="button"
                  class:list={["room-strip__dot", index === 0 && "is-active"]}
                  data-room-dot
                  data-slide-index={index}
                  aria-label={`Show in-room image ${index + 1}`}
                  aria-pressed={index === 0 ? "true" : "false"}
                ></button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section pb-10">
      <div class="faq-shell reveal-on-scroll">
        <p class="faq-kicker">Collector Questions</p>
        <h2 class="faq-title">Western Interior Design Art FAQ</h2>

        <div class="faq-columns">
          <div class="faq-column faq-column--left">
            <div class="faq-question-list" role="list">
              {wallArtFAQLeft.map((item: any, index: number) => (
                <button
                  type="button"
                  class="faq-question"
                  data-faq-trigger
                  data-faq-side="left"
                  data-faq-target={`faq-left-${index}`}
                  aria-expanded="false"
                >
                  <span class="faq-question__text">{item.q}</span>
                  <span class="faq-question__icon" aria-hidden="true">+</span>
                </button>
              ))}
            </div>

            <div class="faq-answer-stack">
              {wallArtFAQLeft.map((item: any, index: number) => (
                <div id={`faq-left-${index}`} class="faq-answer" data-faq-panel data-faq-side="left" hidden>
                  {item.a.map((paragraph: string) => (
                    <p set:html={paragraph} />
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="faq-column faq-column--right">
            <div class="faq-question-list" role="list">
              {wallArtFAQRight.map((item: any, index: number) => (
                <button
                  type="button"
                  class="faq-question"
                  data-faq-trigger
                  data-faq-side="right"
                  data-faq-target={`faq-right-${index}`}
                  aria-expanded="false"
                >
                  <span class="faq-question__text">{item.q}</span>
                  <span class="faq-question__icon" aria-hidden="true">+</span>
                </button>
              ))}
            </div>

            <div class="faq-answer-stack">
              {wallArtFAQRight.map((item: any, index: number) => (
                <div id={`faq-right-${index}`} class="faq-answer" data-faq-panel data-faq-side="right" hidden>
                  {item.a.map((paragraph: string) => (
                    <p set:html={paragraph} />
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="faq-overlay faq-overlay--left" data-faq-overlay="left" hidden></div>
          <div class="faq-overlay faq-overlay--right" data-faq-overlay="right" hidden></div>
        </div>

        <div class="faq-header-logo">
          <a href="/" class="faq-header-logo__link" aria-label="Home">
            <img src="/images/K4Logo-web.webp" alt="K4 Studios home" loading="lazy" decoding="async" />
          </a>
        </div>
        <p class="faq-tagline">"History, lives, and hidden moments &mdash; experienced within a single frame."</p>
      </div>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }

      const faqTriggers = Array.from(document.querySelectorAll("[data-faq-trigger]"));
      const faqPanels = Array.from(document.querySelectorAll("[data-faq-panel]"));
      const faqOverlays = Array.from(document.querySelectorAll("[data-faq-overlay]"));
      const isMobileFaq = () => window.matchMedia("(max-width: 768px)").matches;

      const closeAllFaqPanels = () => {
        faqTriggers.forEach((trigger) => {
          trigger.setAttribute("aria-expanded", "false");
          const icon = trigger.querySelector(".faq-question__icon");
          if (icon) icon.textContent = "+";
        });

        faqPanels.forEach((panel) => {
          panel.hidden = true;
          panel.classList.remove("is-open");
        });

        faqOverlays.forEach((overlay) => {
          overlay.hidden = true;
          overlay.classList.remove("is-open");
          overlay.innerHTML = "";
        });

        document.querySelectorAll(".faq-mobile-answer").forEach((node) => node.remove());
      };

      faqTriggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const targetId = trigger.getAttribute("data-faq-target");
          const targetPanel = targetId ? document.getElementById(targetId) : null;
          const triggerSide = trigger.getAttribute("data-faq-side");
          const overlaySide = triggerSide === "left" ? "right" : "left";
          const overlay = document.querySelector(`[data-faq-overlay="${overlaySide}"]`);
          const isOpen = trigger.getAttribute("aria-expanded") === "true";
          const mobileMode = isMobileFaq();

          closeAllFaqPanels();

          if (!targetPanel || isOpen) return;

          trigger.setAttribute("aria-expanded", "true");
          const icon = trigger.querySelector(".faq-question__icon");
          if (icon) icon.textContent = "−";

          const questionText = trigger.querySelector(".faq-question__text")?.textContent || "";

          if (mobileMode) {
            const inlineAnswer = document.createElement("div");
            inlineAnswer.className = "faq-answer faq-mobile-answer is-open";
            inlineAnswer.innerHTML = `
              <p class="faq-overlay__eyebrow">Answer</p>
              <h3 class="faq-overlay__title">${questionText}</h3>
              <div class="faq-overlay__content">${targetPanel.innerHTML}</div>
            `;
            trigger.insertAdjacentElement("afterend", inlineAnswer);
            return;
          }

          if (!overlay) return;

          overlay.innerHTML = `
            <div class="faq-overlay__inner">
              <p class="faq-overlay__eyebrow">Answer</p>
              <h3 class="faq-overlay__title">${questionText}</h3>
              <div class="faq-overlay__content">${targetPanel.innerHTML}</div>
            </div>
          `;
          overlay.hidden = false;
          overlay.classList.add("is-open");
        });
      });

      const roomSlides = Array.from(document.querySelectorAll("[data-room-slide]"));
      const roomDots = Array.from(document.querySelectorAll("[data-room-dot]"));
      const roomViewport = document.querySelector(".room-strip__viewport");

      if (roomSlides.length && roomDots.length) {
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let activeRoomIndex = Math.max(0, roomSlides.findIndex((slide) => slide.classList.contains("is-active")));
        let roomAutoplayId = null;

        const setActiveRoomSlide = (nextIndex) => {
          activeRoomIndex = ((nextIndex % roomSlides.length) + roomSlides.length) % roomSlides.length;

          roomSlides.forEach((slide, index) => {
            const active = index === activeRoomIndex;
            slide.classList.toggle("is-active", active);
            slide.setAttribute("aria-hidden", active ? "false" : "true");
          });

          roomDots.forEach((dot, index) => {
            const active = index === activeRoomIndex;
            dot.classList.toggle("is-active", active);
            dot.setAttribute("aria-pressed", active ? "true" : "false");
          });
        };

        const stopRoomAutoplay = () => {
          if (!roomAutoplayId) return;
          window.clearInterval(roomAutoplayId);
          roomAutoplayId = null;
        };

        const startRoomAutoplay = () => {
          if (prefersReducedMotion || roomSlides.length < 2) return;
          stopRoomAutoplay();
          roomAutoplayId = window.setInterval(() => {
            setActiveRoomSlide(activeRoomIndex + 1);
          }, 5000);
        };

        setActiveRoomSlide(activeRoomIndex);
        startRoomAutoplay();

        roomDots.forEach((dot) => {
          dot.addEventListener("click", () => {
            const nextIndex = Number(dot.getAttribute("data-slide-index") || "0");
            setActiveRoomSlide(nextIndex);
            startRoomAutoplay();
          });
        });

        if (roomViewport) {
          roomViewport.addEventListener("mouseenter", stopRoomAutoplay);
          roomViewport.addEventListener("mouseleave", startRoomAutoplay);
          roomViewport.addEventListener("focusin", stopRoomAutoplay);
          roomViewport.addEventListener("focusout", () => {
            window.setTimeout(() => {
              if (!roomViewport.contains(document.activeElement)) startRoomAutoplay();
            }, 0);
          });
        }

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            stopRoomAutoplay();
            return;
          }
          startRoomAutoplay();
        });
      }
    });
  </script>

