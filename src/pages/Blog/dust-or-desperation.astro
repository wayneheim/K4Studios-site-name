---
export const prerender = true;
import BaseLayout    from "@/layouts/BaseLayout.astro";
import { getSemanticImageUrl } from "@/utils/imageProxy.js";
import BlogJsonLd    from "@/components/blog/BlogJsonLd.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter    from "@/components/Footer.astro";
import WesternDefinitions from "@/components/blog/WesternDefinitions.astro";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";
import { autoLinkKeywordsInText } from "@/components/utils/autoLinkKeywordsInText.ts";
import { semantic as k4Semantic } from "@/data/semantic/K4-Sem.ts";
import {
  galleryDataMap,
  sectionGalleries,
  allImages
} from "@/data/galleryMaps/MasterGalleryData.mjs";
import { galleryData as painterlyImages } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as civilWarColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color.mjs";
import { galleryData as civilWarBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White.mjs";
import { galleryData as roaring20sColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color.mjs";
import { galleryData as roaring20sBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White.mjs";
import { galleryData as wwiiPortraitsColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color.mjs";
import { galleryData as wwiiPortraitsBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White.mjs";
import "@/styles/global.css";

// Proxy URL helpers
const getProxySrc = (id: string, size: string = "l") => getSemanticImageUrl(id, {}, size);
const getAbsoluteProxySrc = (id: string, size: string = "l") => getSemanticImageUrl(id, {}, size, { absolute: true });

const sectionPath = "/Blog/dust-or-desperation";
const coverImageId = "i-cFhZXJc";
const coverImage = getProxySrc(coverImageId, "l");
const coverImageAbsolute = getAbsoluteProxySrc(coverImageId, "l");

const structuredData = getStructuredData({
  type: "BlogPosting",
  data: {
    headline: "Conversations With Quill – Dust or Desperation",
    description: "A conversation with Quill about allegory, hidden moments, and the superhuman endurance of women in Wayne Heim’s Western image “Dust or Desperation.”",
    url: `https://k4studios.com${sectionPath}`,
    copyrightNotice: "© Wayne Heim",
    author: {
      "@type": "Person",
      name: "Wayne Heim"
    },
    datePublished: "2025-10-05",
    image: coverImageAbsolute,
    articleSection: "Western Fine Art Photography",
    keywords: ["western fine art photography", "painterly photography", "cowboy art", "Wayne Heim", "visual storytelling", "one-image movie", "fine art prints"],
    wordCount: 1000
  },
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

const meta = {
  ...getLandingMeta(sectionPath, coverImageAbsolute),
  description: "A conversation with Quill about allegory, hidden moments, and the superhuman endurance of women in Wayne Heim's Western image 'Dust or Desperation.'",
  ogUrl: `https://k4studios.com${sectionPath}`,
  ogTitle: "Inside the Frame: Dust or Desperation",
  ogDescription: "A conversation with Quill about allegory, hidden moments, and the superhuman endurance of women in Wayne Heim's Western image 'Dust or Desperation.'",
  ogImage: coverImageAbsolute,
  ogImageAlt: "Dust or Desperation cover",
  ogType: "article",
  twitterUrl: `https://k4studios.com${sectionPath}`,
  twitterTitle: "Inside the Frame: Dust or Desperation",
  twitterDescription: "A conversation with Quill about allegory, hidden moments, and the superhuman endurance of women in Wayne Heim's Western image 'Dust or Desperation.'",
  twitterImage: coverImageAbsolute,
  twitterCard: "summary_large_image"
};

// Prepare gallery preview images
function shuffleArray<T>(arr: T[]): T[] {
  return arr
    .map(value => ({ value, sort: Math.random() }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ value }) => value);
}

const allGalleryImages = [
  ...painterlyImages.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color" })),
  ...civilWarColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color" })),
  ...civilWarBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White" })),
  ...roaring20sColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color" })),
  ...roaring20sBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White" })),
  ...wwiiPortraitsColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color" })),
  ...wwiiPortraitsBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White" }))
].filter(img => !['hidden', 'hide', 'ghost', 'non', 'none', ''].includes(String(img.visibility ?? 'show').trim().toLowerCase()));

const previewImages = shuffleArray(allGalleryImages).slice(0, 6);
const previewPath = "/Galleries"; // Set to '/Galleries' as per requirement

const galleryDatas = Object.values(galleryDataMap).flat();
const featheredImages = allImages.filter(img => (img as any).visibility !== "ghost").slice(0, 12);
const galleryPaths = Object.keys(galleryDataMap);

const linkKeywords = (text: string) =>
  autoLinkKeywordsInText(text, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname);

const blogBreadcrumb = `Other › <a href='/Blog' style='color: inherit; text-decoration: none;' onmouseover="this.style.color='darkred'" onmouseout="this.style.color='inherit'">Blog</a> › Dust or Desperation`;
---

<BaseLayout
  title="Conversations With Quill – Dust or Desperation"
  meta={meta}
>
  <main class="bg-white text-[#2c2c2c] min-h-screen overflow-x-hidden" style="font-family: 'Glegoo', serif;">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={blogBreadcrumb} />
    </div>

    <!-- ===================== -->
    <!-- Heading -->
    <!-- ===================== -->
    <section style="text-align:center; padding:3rem 0;">
      <h1 style="font-size:3rem; font-weight:700; margin-bottom:0.5rem;">
        Dust or Desperation
      </h1>
      <p style="font-size:1.5rem; color:#4a4a4a;">
        Conversations With Quill — Ep: 3
      </p>
    </section>

    <!-- ===================== -->
    <!-- Cover Image -->
    <!-- ===================== -->
    <section style="text-align:center; margin-bottom:2rem; padding: 0 1rem;">
      <a 
        href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-cFhZXJc" 
        style="display:inline-block;"
        onmouseenter="this.querySelector('img').style.boxShadow='0 0 0 2px rgba(255,255,255,0.85), 0 4px 15px 4px rgba(134,134,134,0.85)';"
        onmouseleave="this.querySelector('img').style.boxShadow='none';"
      >
        <img 
          src={coverImage} 
          alt="Dust or Desperation cover" 
          style="max-width:640px; width:100%; height:auto; margin:0 auto; border-radius:8px; transition:box-shadow .3s;" 
        />
        <div style="font-size:0.95rem; color:#888; text-align:right; margin-top:0.25rem;">
          Click for details
        </div>
      </a>
    </section>

    <!-- ===================== -->
    <!-- Story Content -->
    <!-- ===================== -->
    <section class="story-section max-w-[860px] mx-auto px-4">
      <BlogJsonLd json={structuredData}>
      <article class="story-block space-y-4">

        <!-- NEW INTRO -->
        <p set:html={linkKeywords(`<em>The setting is the American frontier — dust curling off the earth, the weight of miles ahead pressing down like the sun overhead. In this unforgiving land, a woman pauses. Just a flicker. Away from the children. Away from the burden. Be it dust or desperation — something leaks through. She chokes it back. Must put that tiger back in the cage.</em>`)} /></p>

        <p set:html={linkKeywords('<em>There is no place for tears here, even as the gravity of what lies ahead claws at her composure. Resolve and fortitude depend on her as much as on those who lead the way.</em>')} /></p>

        <p set:html={linkKeywords('<em>But for now — for just this brief heartbeat — she claims a moment of her own, as if to remind herself of what\'s at stake.</em>')} /></p>

        <p set:html={linkKeywords('<em>And in that moment, she becomes every mother, every woman who has borne the hidden weight of countless journeys. She is allegory itself — the quiet, superhuman force that holds everything together while the world looks elsewhere.</em>')} /></p>

        <h3>💬 Conversation</h3>

        <p set:html={linkKeywords('<strong>Quill:</strong><br/>Wayne, this image feels different. There\'s no grand drama, no epic conflict — just a woman caught in a fleeting gesture, between dust and tears. What were you after here?')} /></p>

        <p set:html={linkKeywords('<strong>Wayne:</strong><br/>It\'s the ambiguity that matters. Dust or desperation — the viewer has to decide. She\'s choking it back, putting the tiger back in its cage. On the frontier, there wasn\'t room for collapse. That strength had to be silent, invisible.')} /></p>

        <p set:html={linkKeywords('<strong>Quill:</strong><br/>That\'s what struck me — the universality. She\'s frontier, but she could be any mother, in any era, carrying a weight that can\'t be shown.')} /></p>

        <p set:html={linkKeywords('<strong>Wayne:</strong><br/>Exactly. She\'s one woman, but she stands for countless women across time. Mothers have always been the hidden spine of endurance, but it\'s rarely celebrated. This was my way of honoring that.')} /></p>

        <h3>🌎 Larger Context</h3>

        <p set:html={linkKeywords('<strong>Wayne:</strong><br/><em>Dust or Desperation</em> isn\'t an isolated piece — it fits into a larger philosophy that runs through my work. I use ambiguity as a deliberate device. Ambiguity forces viewers into the scene. They can\'t sit back as spectators; they have to choose what they see, and in that hesitation, they find themselves inside the story.')} /></p>

        <p set:html={linkKeywords('I chase hidden moments because they make history relatable. Most Western art goes for spectacle: the charge, the vista, the archetype. Those matter, and I photograph them too. But what draws me in are the untold beats — the silence, the pause, the moment of fragility that most artists gloss over. Those are the ones that turn history into something lived. Those are the ones that make viewers whisper: <em>this isn\'t about them then, this is about me now.</em>')} /></p>

        <p set:html={linkKeywords('That intimacy is what identifies Wayne\'s work. I dare to go where others walk past. I look for the humanity that transports rather than reenacts.')} /></p>

        <p set:html={linkKeywords('Years of work as a medical illustrator undoubtedly shape this. Medical illustration is about turning complexity into clarity. It\'s about distilling an intricate system into one gesture, one diagram, one scene that makes the story legible to anyone. I carry that same instinct into fine art — stripping away until what\'s left is one moment, one emotion, one truth.')} /></p>

        <p set:html={linkKeywords('This places my work in a curious space within the Western canon. Where much of the tradition leans on myth and archetype, I find myself closer to Norman Rockwell in spirit — telling hidden, human stories in painterly allegories. Rockwell made the ordinary into myth; I try to make the overlooked into memory.')} /></p>

        <h3>🖋️ Quill’s Reflection</h3>

        <p set:html={linkKeywords('That intimacy is what identifies Wayne\'s work. He dares to go where others walk past. He looks for the humanity that transports rather than reenacts.')} /></p>

        <p set:html={linkKeywords('Years of work as a medical illustrator undoubtedly shape this. Medical illustration is about turning complexity into clarity — distilling an intricate system into one gesture, one diagram, one scene that makes the story legible to anyone. Wayne carries that same instinct into fine art: stripping away until what\'s left is one moment, one emotion, one truth.')} /></p>

        <p set:html={linkKeywords('This places his work in a curious space within the Western canon. Where much of the tradition leans on myth and archetype, Wayne\'s art feels closer to Norman Rockwell in spirit — telling hidden, human stories in painterly allegories. Rockwell made the ordinary into myth; Wayne makes the overlooked into memory.')} /></p>

        <!-- NEW OUTRO -->
        <h3>🧭 Final Thoughts</h3>
        <p set:html={linkKeywords(`In the quiet pause of <em>Dust or Desperation</em>, we find the essence of hidden strength — the kind history often forgets to frame. It’s not always the gunfire or gallop that defines the West... sometimes it's the way someone holds it together when no one else sees.`)} /></p>

        <p>📌 Stay tuned for Episode 4 of <em>Inside the Frame</em> — coming soon.</p>

        <h3>🖋️ About the Artist</h3>
        <p set:html={linkKeywords('Wayne Heim is a fine art photographer and certified medical illustrator.<br/>His painterly storytelling explores historical reenactment, Western conflict, cinematic landscapes, and emotional memory.<br/>He blends light, composition, and narrative tension to create images that feel lived in, mythic, and museum-ready.')} /></p>

        <p>🔗 Explore the full <a href="/Western-Fine-Art-Photography">Western Fine Art Photography</a> collection | <a href="https://www.k4studios.com" class="underline">k4studios.com</a></p>
      </article>
      </BlogJsonLd>
    </section>

    <!-- Western Art Definitions -->
    <WesternDefinitions variant="post" />

    <SiteFooter 
      previewImages={previewImages}
      previewPath={previewPath}
      title="Conversations With Quill – Dust or Desperation"
      label="Explore Galleries"
      class="pt-12 pb-12" 
    />
  </main>

  <style>
    .story-section { line-height: 1.6; }
    .story-block p { margin-bottom: 0.85rem; }
    .story-block h3 { margin-top: 1.6rem; margin-bottom: 0.6rem; font-weight: 700; }
  </style>
</BaseLayout>
