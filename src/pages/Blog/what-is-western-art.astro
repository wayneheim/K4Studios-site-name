        </div>

        <!-- SECTION 10: Explore at K4 Studios -->
        <div class="section-heading-with-line">
          <h2>Explore Western Fine Art at K4 Studios</h2>
        </div>

        <ul style="list-style:disc; padding-left:1.5rem; margin:1rem 0 1.5rem;">
          <li style="margin-bottom:0.75rem;">
            <a href="/Western-Fine-Art-Photography" style="color:#8b5a2b; font-weight:600; text-decoration:underline;">Western Fine Art Photography</a> — The primary collection
          </li>
          <li style="margin-bottom:0.75rem;">
            <a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color" style="color:#8b5a2b; font-weight:600; text-decoration:underline;">Cowboy & Western Life</a> — Character portraits and frontier scenes
          </li>
          <li style="margin-bottom:0.75rem;">
