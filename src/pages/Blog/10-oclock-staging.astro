---
export const prerender = true;
import BaseLayout    from "@/layouts/BaseLayout.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter    from "@/components/Footer.astro";
import { getStructuredData, getBlogBreadcrumbList } from "@/components/utils/getStructuredData.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";
import { autoLinkKeywordsInText } from "@/components/utils/autoLinkKeywordsInText.ts";
import { semantic as k4Semantic } from "@/data/semantic/K4-Sem.ts";
import {
  galleryDataMap,
  sectionGalleries,
  allImages
} from "@/data/galleryMaps/MasterGalleryData.mjs";
import { galleryData as painterlyImages } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as civilWarColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color.mjs";
import { galleryData as civilWarBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White.mjs";
import { galleryData as roaring20sColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color.mjs";
import { galleryData as roaring20sBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White.mjs";
import { galleryData as wwiiPortraitsColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color.mjs";
import { galleryData as wwiiPortraitsBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White.mjs";
import "@/styles/global.css";

// Proxy URL helpers
const getProxySrc = (id: string, size: string) => `/img/${id}/${size}`;
const getAbsoluteProxySrc = (id: string, size: string) => `https://www.k4studios.com/img/${id}/${size}`;

const sectionPath = "/Blog/10-oclock-staging";
const coverImageId = "i-kxnK2MM";
const coverImage = getProxySrc(coverImageId, "xl");
const coverImageAbsolute = getAbsoluteProxySrc(coverImageId, "l");

const structuredData = getStructuredData({
  type: "BlogPosting",
  data: {
    headline: "Inside the Frame: 10 O’Clock Staging",
    description: "A conversation with Quill about suspense, ambiguity, and the storytelling power of black and white in Wayne Heim’s Western image “10 O’Clock Staging.”",
    url: `https://k4studios.com${sectionPath}`,
    copyrightNotice: "© Wayne Heim",
    author: {
      "@type": "Person",
      name: "Wayne Heim"
    },
    datePublished: "2025-10-23",
    image: coverImageAbsolute,
    articleSection: "Western Fine Art Photography",
    keywords: ["western fine art photography", "black and white photography", "cowboy art", "Wayne Heim", "visual storytelling", "one-image movie", "fine art prints"],
    wordCount: 1100
  },
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

const breadcrumbsJSON = getBlogBreadcrumbList({
  title: "Inside the Frame: 10 O’Clock Staging",
  url: `https://k4studios.com${sectionPath}`
});

const meta = {
  ...getLandingMeta(sectionPath, coverImageAbsolute),  description: "Explore the storytelling behind '10 O'Clock Staging' — a black-and-white Western photograph by Wayne Heim. A creative conversation about suspense, ambiguity, and visual narrative.",  ogUrl: `https://k4studios.com${sectionPath}`,
  ogTitle: "Inside the Frame: 10 O'Clock Staging",
  ogDescription: "A conversation with Quill about suspense, ambiguity, and the storytelling power of black and white in Wayne Heim's Western image '10 O'Clock Staging.'",
  ogImage: coverImageAbsolute,
  ogImageAlt: "10 O'Clock Staging cover",
  ogType: "article",
  twitterUrl: `https://k4studios.com${sectionPath}`,
  twitterTitle: "Inside the Frame: 10 O'Clock Staging",
  twitterDescription: "A conversation with Quill about suspense, ambiguity, and the storytelling power of black and white in Wayne Heim's Western image '10 O'Clock Staging.'",
  twitterImage: coverImageAbsolute,
  twitterCard: "summary_large_image"
};

// Prepare gallery preview images
function shuffleArray<T>(arr: T[]): T[] {
  return arr
    .map(value => ({ value, sort: Math.random() }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ value }) => value);
}

const allGalleryImages = [
  ...painterlyImages.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color" })),
  ...civilWarColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color" })),
  ...civilWarBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White" })),
  ...roaring20sColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color" })),
  ...roaring20sBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White" })),
  ...wwiiPortraitsColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color" })),
  ...wwiiPortraitsBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White" }))
].filter(img => img.visibility !== "ghost");

const previewImages = shuffleArray(allGalleryImages).slice(0, 6);
const previewPath = "/Galleries"; // Set to '/Galleries' for consistent Explore Galleries bar

const galleryDatas = Object.values(galleryDataMap).flat();
const featheredImages = allImages.filter(img => (img as any).visibility !== "ghost").slice(0, 12);
const galleryPaths = Object.keys(galleryDataMap);

const linkKeywords = (text: string) =>
  autoLinkKeywordsInText(text, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname);

const blogBreadcrumb = `Other › <a href='/Blog' style='color: inherit; text-decoration: none;' onmouseover="this.style.color='darkred'" onmouseout="this.style.color='inherit'">Blog</a> › 10 O'Clock Staging`;
---

<BaseLayout
  title="Inside the Frame: 10 O'Clock Staging"
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbsJSON}
  meta={meta}
>
  <main class="bg-white text-[#2c2c2c] min-h-screen overflow-x-hidden" style="font-family: 'Glegoo', serif;">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={blogBreadcrumb} />
    </div>

    <!-- ===================== -->
    <!-- Heading -->
    <!-- ===================== -->
    <section style="text-align:center; padding:3rem 0;">
      <h1 style="font-size:3rem; font-weight:700; margin-bottom:0.5rem;">
        10 O'Clock Staging
      </h1>
      <p style="font-size:1.5rem; color:#4a4a4a;">
        Inside the Frame — Ep: 4
      </p>
    </section>

     <!-- ===================== -->
    <!-- Cover Image -->
    <!-- ===================== -->
    <section style="text-align:center; margin-bottom:2rem; padding: 0 1rem;">
      <a 
        href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/i-kxnK2MM" 
        style="display:inline-block;"
        onmouseenter="this.querySelector('img').style.boxShadow='0 0 0 2px rgba(255,255,255,0.85), 0 4px 15px 4px rgba(134,134,134,0.85)';"
        onmouseleave="this.querySelector('img').style.boxShadow='none';"
      >
        <img 
          src={coverImage} 
          alt="Dust or Desperation cover" 
          style="max-width:640px; width:100%; height:auto; margin:0 auto; border-radius:8px; transition:box-shadow .3s;" 
        />
        <div style="font-size:0.95rem; color:#888; text-align:right; margin-top:0.25rem;">
          Click for details
        </div>
      </a>
    </section>

    <!-- ===================== -->
    <!-- Story Block -->
    <!-- ===================== -->
    <section class="story-section max-w-[860px] mx-auto px-4">
      <article class="story-block space-y-4">

        <!-- Title & Story -->
        <h2 style="font-size:2rem; font-weight:600;">10 O’Clock Staging</h2>
        <p set:html={linkKeywords(`
          <em>
            Morning sun climbs; heat builds with anticipation and purpose.<br/>
            Dust and perspiration settle in for the show.<br/>
            10:05—she’s late.<br/>
            Pulse quickens.<br/>
            Distant rumble—steel, leather, hooves, echo from the ridge.
          </em>
        `)} />

        <!-- Blog Conversation -->
        <h3>💬 Conversation</h3>
        <p set:html={linkKeywords(`
          <strong>Quill:</strong><br/>
          Wayne, you could have shown this in color, but you kept it black and white. Why?
        `)} />

        <p set:html={linkKeywords(`
          <strong>Wayne:</strong><br/>
          Black and white reveals the bones of a photograph. I always start in monochrome, even if I’m planning a painterly color version later. It’s a discipline I brought from the darkroom—if the composition and story don’t hold up stripped of all distraction, they won’t survive with color either.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Quill:</strong><br/>
          Your best black and whites never feel like an afterthought. They strip away the superficial and let the viewer feel the mood and atmosphere of the story immediately. The brain fills in the missing details, making the moment personal. That’s a rare quality, especially in Western art.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Wayne:</strong><br/>
          Exactly. The moment you take away the prettiness, what’s left is tension, gesture, and all that unsaid energy. In <em>10 O’Clock Staging</em>, you’re not told exactly what’s about to happen—you’re invited into the quiet before. Are these men about to ride, to hunt, to ambush, or to run? The ambiguity is the story.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Quill:</strong><br/>
          The horses almost become characters here, not just props.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Wayne:</strong><br/>
          They are. The way the horses stand—alert, but calm—mirrors the men’s discipline. When you see it in monochrome, you notice every line of tension: the grip on the rifle, the shift of weight in the saddle, the way light falls across leather and grass. It’s almost as if you’re crouched in the grass with them, holding your breath.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Quill:</strong><br/>
          There’s a mood that’s hard to define. Even though you shoot with a modern sensor, this feels archival—timeless, cinematic.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Wayne:</strong><br/>
          That’s intentional. When I choose to stay in black and white, I want the image to live somewhere between memory and myth. The best B/W images leave you with questions. Your brain invents what color couldn’t show—heat, wind, nerves, all of it. I want the collector to step inside the uncertainty.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Quill:</strong><br/>
          How do you know when a story needs to stay monochrome?
        `)} />

        <p set:html={linkKeywords(`
          <strong>Wayne:</strong><br/>
          If it “sings” in black and white—if you can feel the air, the nerves, the anticipation—then I know the image has the bones to last. Sometimes I’ll build up painterly color later, but often, like with this piece, the mood just belongs in grayscale.
        `)} />

        <h3>🖋️ Quill’s Reflection</h3>
        <p set:html={linkKeywords(`
          That’s what makes your B/Ws so magnetic: they leave room for the viewer to inhabit the story, not just look at it. You strip away the superficial and leave us with mood, atmosphere, and a hundred possible outcomes. It’s art that whispers—never shouts.
        `)} />

        <h3>🧭 Final Thoughts</h3>
        <p set:html={linkKeywords(`
          <em>10 O’Clock Staging</em> is all about what isn’t spelled out. The tension, the patience, the loaded silence—these are the stories that only black and white can tell. When you leave room for the viewer’s mind to fill in the missing details, the photograph keeps living, long after the first look.
        `)} />

        <p>📌 Stay tuned for the next episode of <em>Inside the Frame</em> — coming soon.</p>

        <h3>🖋️ About the Artist</h3>
        <p set:html={linkKeywords(`
          Wayne Heim is a fine art photographer and certified medical illustrator.<br/>
          His painterly storytelling explores historical reenactment, Western conflict, cinematic landscapes, and emotional memory.<br/>
          He blends light, composition, and narrative tension to create images that feel lived in, mythic, and museum-ready.
        `)} />

        <p>🔗 Explore the full <a href="/Western-Fine-Art-Photography">Western Fine Art Photography</a> collection | <a href="https://k4studios.com" class="underline">k4studios.com</a></p>
      </article>
    </section>

    <SiteFooter 
      previewImages={previewImages}
      previewPath={previewPath}
      title="Inside the Frame: 10 O’Clock Staging"
      label="Explore Galleries"
      class="pt-12 pb-12" 
    />
  </main>

  <style>
    .story-section { line-height: 1.6; }
    .story-block p { margin-bottom: 0.85rem; }
    .story-block h3 { margin-top: 1.6rem; margin-bottom: 0.6rem; font-weight: 700; }
  </style>
</BaseLayout>
