---
export const prerender = true;
import BaseLayout    from "@/layouts/BaseLayout.astro";
import BlogJsonLd    from "@/components/blog/BlogJsonLd.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter    from "@/components/Footer.astro";
import WesternDefinitions from "@/components/blog/WesternDefinitions.astro";
import { getStructuredData, getBlogBreadcrumbList } from "@/components/utils/getStructuredData.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";
import { autoLinkKeywordsInText } from "@/components/utils/autoLinkKeywordsInText.ts";
import { semantic as k4Semantic } from "@/data/semantic/K4-Sem.ts";
import {
  galleryDataMap,
  sectionGalleries,
  allImages
} from "@/data/galleryMaps/MasterGalleryData.mjs";
import { galleryData as painterlyImages } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as civilWarColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color.mjs";
import { galleryData as civilWarBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White.mjs";
import { galleryData as roaring20sColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color.mjs";
import { galleryData as roaring20sBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White.mjs";
import { galleryData as wwiiPortraitsColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color.mjs";
import { galleryData as wwiiPortraitsBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White.mjs";
import "@/styles/global.css";

// Proxy URL helpers
const getProxySrc = (id: string, size: string) => `/img/${id}/${size}.jpg`;
const getAbsoluteProxySrc = (id: string, size: string) => `https://www.k4studios.com/img/${id}/${size}.jpg`;

const sectionPath = "/Blog/Eye-of-the-Hunt"; // canonical path for this page
const coverImageId = "i-5j2Knmb";
const coverImage = getProxySrc(coverImageId, "xl");
const coverImageAbsolute = getAbsoluteProxySrc(coverImageId, "l");

const structuredData = getStructuredData({
  type: "BlogPosting",
  data: {
    headline: "Inside the Frame: Eye of the Hunt",
    description: "A conversation with Quill about gaze, awareness, and painterly storytelling in Wayne Heim’s Western fine art photograph 'Eye of the Hunt.'",
    url: `https://k4studios.com${sectionPath}`,
    copyrightNotice: "© Wayne Heim",
    author: { "@type": "Person", name: "Wayne Heim" },
    datePublished: "2025-10-24",
    image: coverImageAbsolute,
    articleSection: "Western Fine Art Photography",
    keywords: ["western fine art photography", "painterly photography", "cowboy art", "Wayne Heim", "visual storytelling", "one-image movie", "fine art prints"],
    wordCount: 1100
  },
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

const breadcrumbsJSON = getBlogBreadcrumbList({
  title: "Inside the Frame: Eye of the Hunt",
  url: `https://k4studios.com${sectionPath}`
});

const meta = {
  ...getLandingMeta(sectionPath, coverImageAbsolute),
  description: "A conversation with Quill about gaze, awareness, and painterly storytelling in Wayne Heim's Western fine art photograph 'Eye of the Hunt.'",
  ogUrl: `https://k4studios.com${sectionPath}`,
  ogTitle: "Inside the Frame: Eye of the Hunt",
  ogDescription: "A conversation with Quill about gaze, awareness, and painterly storytelling in Wayne Heim's Western fine art photograph 'Eye of the Hunt.'",
  ogImage: coverImageAbsolute,
  ogImageAlt: "Eye of the Hunt cover",
  ogType: "article",
  twitterUrl: `https://k4studios.com${sectionPath}`,
  twitterTitle: "Inside the Frame: Eye of the Hunt",
  twitterDescription: "A conversation with Quill about gaze, awareness, and painterly storytelling in Wayne Heim's Western fine art photograph 'Eye of the Hunt.'",
  twitterImage: coverImageAbsolute,
  twitterCard: "summary_large_image"
};

// Prepare gallery preview images (same approach as 10-oclock-staging)
function shuffleArray<T>(arr: T[]): T[] {
  return arr
    .map((value: T) => ({ value, sort: Math.random() }))
    .sort((a: { value: T; sort: number }, b: { value: T; sort: number }) => a.sort - b.sort)
    .map(({ value }) => value);
}

const allGalleryImages = [
  ...painterlyImages.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color" })),
  ...civilWarColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color" })),
  ...civilWarBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White" })),
  ...roaring20sColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color" })),
  ...roaring20sBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White" })),
  ...wwiiPortraitsColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color" })),
  ...wwiiPortraitsBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White" }))
].filter((img) => img.visibility !== "ghost");

const previewImages = shuffleArray(allGalleryImages).slice(0, 6);
const previewPath = "/Galleries";

const galleryDatas = Object.values(galleryDataMap).flat();
const featheredImages = allImages.filter((img) => ((img as any)?.visibility ?? "") !== "ghost").slice(0, 12);
const galleryPaths = Object.keys(galleryDataMap);

const linkKeywords = (text: string) =>
  autoLinkKeywordsInText(text, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname);

const blogBreadcrumb = `Other › <a href='/Blog' style='color: inherit; text-decoration: none;' onmouseover="this.style.color='darkred'" onmouseout="this.style.color='inherit'">Blog</a> › Eye of the Hunt`;
---

<BaseLayout
  title="Inside the Frame: Eye of the Hunt"
  breadcrumbsJSON={breadcrumbsJSON}
  meta={meta}
>
  <!-- Canonical/SEO assist -->
  <link rel="canonical" href={`https://k4studios.com${sectionPath}`} />
  <main class="bg-white text-[#2c2c2c] min-h-screen overflow-x-hidden" style="font-family:'Glegoo',serif;">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={blogBreadcrumb} />
    </div>

  {/* ===================== */}
  {/* Heading */}
  {/* ===================== */}
    <section style="text-align:center; padding:3rem 0;">
      <h1 style="font-size:3rem; font-weight:700; margin-bottom:0.5rem;">Eye of the Hunt</h1>
      <p style="font-size:1.5rem; color:#4a4a4a;">Inside the Frame — Ep: 6</p>
    </section>

  {/* ===================== */}
  {/* Cover Image */}
  {/* ===================== */}
    <section style="text-align:center; margin-bottom:2rem; padding:0 1rem;">
      <a
        href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-5j2Knmb"
        style="display:inline-block;"
        onmouseenter="this.querySelector('img').style.boxShadow='0 0 0 2px rgba(255,255,255,0.85),0 4px 15px 4px rgba(134,134,134,0.85)'"
        onmouseleave="this.querySelector('img').style.boxShadow='none'"
      >
        <img
          src={coverImage}
          alt="Eye of the Hunt cover"
          style="max-width:640px;width:100%;height:auto;margin:0 auto;border-radius:8px;transition:box-shadow .3s;"
        />
        <div style="font-size:0.95rem;color:#888;text-align:right;margin-top:0.25rem;">Click for details</div>
      </a>
    </section>

  {/* ===================== */}
  {/* Story Block */}
  {/* ===================== */}
    <section class="story-section max-w-[860px] mx-auto px-4">
      <BlogJsonLd json={structuredData}>
      <article class="story-block space-y-4">

  {/* Title & Story */}
        <h2 style="font-size:2rem; font-weight:600;">Eye of the Hunt</h2>
        <p set:html={linkKeywords(`<em>
          The air holds its breath.<br>
          The bow, the hand, the heartbeat — all align.<br>
          But it’s the eye that commands.<br>
          Not the eye that aims,<br>
          but the one that knows.<br><br>
          It sees beyond quarry or chase.<br>
          It sees you.<br>
          The watcher becomes the watched —<br>
          caught in the same stillness,<br>
          the same fragile truth of being seen.<br><br>
          Here, the hunt is not pursuit,<br>
          but revelation.
        </em>`)} />

        <!-- Conversation -->
        <h3>💬 Conversation</h3>
        <p set:html={linkKeywords(`<strong>Quill:</strong> When you composed this, were you thinking of mutual gaze — that idea that the subject isn’t being observed but is observing us?`)} />
        <p set:html={linkKeywords(`<strong>Wayne:</strong> Most of these images from reenactments are action scenes rather than posed. I sometimes give small prompts and watch what happens — that’s part of the magic. Other times, I’m purely observing. I’m the hunter, watching for that fleeting moment.`)} />

        <p set:html={linkKeywords(`<strong>Quill:</strong> There’s incredible symmetry between the two figures — almost a mirrored focus. Was that intentional or something that appeared later?`)} />
        <p set:html={linkKeywords(`<strong>Wayne:</strong> It’s my sixth sense, I guess. Comes from years of photographing action — watching everything and nothing at once. Sometimes you can see it before it happens.`)} />

        <p set:html={linkKeywords(`<strong>Quill:</strong> You’ve talked about balancing realism and restraint. How did you decide where to stop the painterly treatment here?`)} />
        <p set:html={linkKeywords(`<strong>Wayne:</strong> It varies per image. Some need more painterly work to set the energy — through color, or lack of it. This one didn’t. Everything funneled toward that single eye — being seen, being found out. Once that happens, you can’t look away.`)} />

        <p set:html={linkKeywords(`<strong>Quill:</strong> This is one of your most intimate portrayals of Native subjects. What does respectful representation mean here?`)} />
        <p set:html={linkKeywords(`<strong>Wayne:</strong> It’s a fine line. I’m careful not to over-direct. I want them to show me what feels natural — not what Hollywood taught us. Authenticity happens when you stop telling and start watching.`)} />

        <p set:html={linkKeywords(`<strong>Quill:</strong> You’ve said “the West is a mirror, not a myth.” Who does this mirror reflect more — the hunter, or the viewer?`)} />
        <p set:html={linkKeywords(`<strong>Wayne:</strong> Western themes — struggle, grit, exploration — are timeless. People connect to the romantic myth, but I want them to go deeper. When they see themselves in that tension or calm, maybe it speaks to their own struggles or healing.`)} />

        <p set:html={linkKeywords(`<strong>Quill:</strong> This piece has tension but no violence, stillness but no peace. What does that say about the human condition?`)} />
        <p set:html={linkKeywords(`<strong>Wayne:</strong> We all hide in the shadows until someone sees us for who we are. That’s the gut-check moment — what do you do when there’s no hiding?`)} />

        <p set:html={linkKeywords(`<strong>Quill:</strong> If a viewer stood beside you on that shoot, what would you want them to know?`)} />
        <p set:html={linkKeywords(`<strong>Wayne:</strong> Be in the moment. Watch for the story — always the story. The real magic comes in those hidden sub-stories. That’s where the eyes have it.`)} />

        <!-- Expert Commentary -->
        <h3>🎨 On Painterly Photography and the Language of Story</h3>
        <p set:html={linkKeywords(`<strong>Quill:</strong> When people hear “painterly photography,” they often imagine imitation. But in fine-art terms, it’s emotional translation — the pursuit of light, tone, and gesture that painting explored for centuries. Heim’s painterly work borrows painting’s moral grammar. Like Wyeth or Remington, he uses atmosphere to guide empathy, light to shape judgment, and restraint to invite participation. It lets viewers forget they’re seeing a modern photograph and experience something timeless — between dream and memory.`)} />
        <p set:html={linkKeywords(`<strong>Wayne:</strong> Exactly. Painterly photography isn’t about pretending to be paint — it’s about using photographic tools to reach that emotional register. Light becomes my pigment; the lens my brush. By softening or shaping texture, I’m removing distraction, not detail. The goal is to help people forget the modern world — to just live inside the story.`)} />

        <h3>🏜️ Breaking and Expanding the Western Canon</h3>
        <p set:html={linkKeywords(`<strong>Quill:</strong> In the Western art market, this distinction matters. Much of the genre still centers on surface realism. Heim’s painterly approach shifts the focus from documentation to connection. It rehumanizes the myth — showing the Western story still breathes because it still mirrors us.`)} />
        <p set:html={linkKeywords(`<strong>Wayne:</strong> The Western canon has always been about story — grit, solitude, consequence. Painters used brush and pigment; I use light and camera. Same heartbeat, different tools. I’m not replacing that tradition — I’m expanding it. If painting invites reflection, photography can invite recognition. It’s all about connection.`)} />

        <h3>🖋️ Quill’s Reflection</h3>
        <p set:html={linkKeywords(`That’s what makes <em>Eye of the Hunt</em> so arresting — it turns the Western gaze back on itself. Not about dominance, but awareness. Not about history, but humanity. The bow may be drawn, but the real weapon is the gaze — the one that finds you and refuses to blink.`)} />

        <h3>🧭 Final Thoughts</h3>
        <p set:html={linkKeywords(`<em>Eye of the Hunt</em> lives where instinct meets awareness — where hunter and viewer realize they’re both being seen. It’s less a story of pursuit than of recognition, asking us to look closer and admit what looks back.`)} />

        <p>📌 Stay tuned for the next episode of <em>Inside the Frame</em> — coming soon.</p>

        <h3>🖋️ About the Artist</h3>
        <p set:html={linkKeywords(`Wayne Heim is a fine art photographer and certified medical illustrator.<br>His painterly storytelling explores historical reenactment, Western conflict, cinematic landscapes, and emotional memory.<br>He blends light, composition, and narrative tension to create images that feel lived in, mythic, and museum-ready.`)} />

        <p>🔗 Explore the full <a href="/Western-Fine-Art-Photography">Western Fine Art Photography</a> collection | <a href="https://www.k4studios.com" class="underline">k4studios.com</a></p>
      </article>
      </BlogJsonLd>
    </section>

    <!-- Western Art Definitions -->
    <WesternDefinitions variant="post" />

    <SiteFooter
      previewImages={previewImages}
      previewPath={previewPath}
      title="Inside the Frame: Eye of the Hunt"
      label="Explore Galleries"
      class="pt-12 pb-12"
    />
  </main>

  <style>
    .story-section { line-height:1.6; }
    .story-block p { margin-bottom:0.85rem; }
    .story-block h3 { margin-top:1.6rem; margin-bottom:0.6rem; font-weight:700; }
  </style>
</BaseLayout>
