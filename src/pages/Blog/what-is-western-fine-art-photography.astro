      }
    }
    @media (min-width: 769px) and (max-width: 1024px) {
      .example-images {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    /* Mobile overflow protection */
    @media (max-width: 768px) {
      main {
        overflow-x: hidden !important;
        max-width: 100vw !important;
      }
      .story-section {
