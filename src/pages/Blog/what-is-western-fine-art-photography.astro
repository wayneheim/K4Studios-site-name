 * - Confident, corrective tone — not tutorial
 */
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter from "@/components/Footer.astro";
import WesternDefinitions from "@/components/blog/WesternDefinitions.astro";
import { getBreadcrumbList, getStructuredData } from "@/components/utils/getStructuredData.ts";

import "@/styles/global.css";

const sectionPath = "/Blog/what-is-western-fine-art-photography";
const canonicalUrl = "https://www.k4studios.com/Blog/what-is-western-fine-art-photography";

// Proxy URL helper
const getProxySrc = (id: string, size: string) => `/img/${id}/${size}.jpg`;
const getAbsoluteProxySrc = (id: string, size: string) => `https://www.k4studios.com/img/${id}/${size}.jpg`;

// Representative images - curated selection demonstrating range:
// Header bar: 5 unique images fading from edges to center (none reused in demo section)
const headerImages = [
  { id: "i-6Ffpw9t", alt: "Frontier scene with atmospheric depth" },
  { id: "i-89qzJ6S", alt: "Character study in warm directional light" },
  { id: "i-c5K798H", alt: "Defiant moment — tension composed rather than captured" },
  { id: "i-LCspRF4", alt: "Cowboy at dusk in quiet reflection" },
  { id: "i-4Hz6D7k", alt: "Native American subject with compositional dignity" },
];

// Demo section images (3) - different from header
const image1 = {
  id: "i-ncFcHDM",
  src: getProxySrc("i-ncFcHDM", "l"),
  alt: "Cowboy rendered as a man rather than a silhouette — character over cliché"
};
const image2 = {
  id: "i-Txh4c8k",
  src: getProxySrc("i-Txh4c8k", "l"),
  alt: "Rope work in black and white — craft practiced when no one is watching"
};
const image3 = {
  id: "i-7hD9CCh",
  src: getProxySrc("i-7hD9CCh", "l"),
  alt: "Quiet attention at the water's edge — presence over performance"
};

const pageTitle = "What Is Western Fine Art Photography? Definition, Distinction, and What It Is Not";
const pageDescription = "Western fine art photography is not décor, not stock imagery, not rodeo documentation. This article defines the discipline and distinguishes it from commercial Western imagery.";

const structuredImageUrls = [
  getAbsoluteProxySrc(headerImages[2].id, "l"),
  getAbsoluteProxySrc(image1.id, "l"),
  getAbsoluteProxySrc(image2.id, "l"),
  getAbsoluteProxySrc(image3.id, "l"),
];

const breadcrumbStructuredData = getBreadcrumbList(
  [
    { name: "Home", item: "https://www.k4studios.com" },
    {
      name: "Western Art",
      item: "https://www.k4studios.com/Blog/what-is-western-art",
    },
    {
      name: "Western Fine Art",
      item: "https://www.k4studios.com/Blog/what-is-western-fine-art",
    },
    { name: "Western Fine Art Photography", item: canonicalUrl },
  ],
  `${canonicalUrl}#breadcrumb`
);

const structuredData = getStructuredData({
  type: "Article",
  data: {
    headline: "What Is Western Fine Art Photography?",
    description: pageDescription,
    url: canonicalUrl,
    image: structuredImageUrls,
    copyrightNotice: "© Wayne Heim",
    author: {
      "@type": "Person",
      name: "Wayne Heim"
    },
    datePublished: "2026-01-29",
    articleSection: "Photography",
    definedTerm: {
      name: "Western Fine Art Photography",
      description: pageDescription,
    },
    keywords: [
      "western fine art photography",
      "western photography",
      "cowboy photography",
      "fine art western",
      "western wall art",
      "cowboy portraiture"
    ]
  },
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

// OG/Twitter capped at L
const meta = {
  description: pageDescription,
  keywords: "western fine art photography, western photography, cowboy photography, fine art western, western wall art, cowboy portraiture",
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogType: "article",
  ogUrl: canonicalUrl,
  ogImage: getAbsoluteProxySrc(image1.id, "l"),
  twitterTitle: pageTitle,
  twitterDescription: pageDescription,
  twitterUrl: canonicalUrl,
  twitterImage: getAbsoluteProxySrc(image1.id, "l"),
  twitterCard: "summary_large_image"
};

const blogBreadcrumb = `Other › <a href='/Blog' style='color: inherit; text-decoration: none;' onmouseover="this.style.color='darkred'" onmouseout="this.style.color='inherit'">Blog</a> › What Is Western Fine Art Photography?`;
---

<BaseLayout
  title={pageTitle}
  structuredDataJSON={structuredData}
  meta={meta}
>
  <script type="application/ld+json" set:html={breadcrumbStructuredData} />
  <main class="bg-white text-[#2c2c2c] min-h-screen overflow-x-hidden" style="font-family: 'Glegoo', serif;">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={blogBreadcrumb} />
    </div>

    <!-- Header Image Bar - 5 images fading from edges to center -->
    <section class="header-image-bar">
      <a href="/Western-Fine-Art-Photography" class="header-bar-link">
        <div class="header-bar-container">
          {headerImages.map((img, index) => (
            <div class={`header-bar-image pos-${index}`}>
              <img 
                src={getProxySrc(img.id, "l")} 
                alt={img.alt}
                loading="eager"
              />
            </div>
          ))}
        </div>
      </a>
    </section>

    <!-- Article Header -->
    <section style="text-align:center; padding:2rem 1rem 2rem;">
      <h1 style="font-size:2.5rem; font-weight:700; margin-bottom:0.5rem; line-height:1.2;">
        What Is Western Fine Art Photography?
      </h1>
      <p style="font-size:1.25rem; color:#666; font-style:italic;">
        Definition, distinction, and what it is not
      </p>
      <p style="font-size:0.95rem; color:#888; margin-top:0.75rem; letter-spacing:0.02em;">
        A working definition for collectors, curators, and serious viewers
      </p>
    </section>

    <!-- Article Content -->
    <section class="story-section max-w-[860px] mx-auto px-4">
      <article class="story-block space-y-4">

        <!-- SECTION 1: Definition (THE ANCHOR) -->
        <p><strong>Western fine art photography</strong> is the photographic expression of <a href="/Blog/what-is-western-fine-art" style="color:#8b5a2b; text-decoration:underline;">Western fine art</a>—authored work engaging the American West with intentional composition, narrative depth, and artistic restraint.</p>

        <p>It is photography created as fine art, not as documentation, décor, or commercial stock imagery. It is defined by authorship: decisions about structure, light, atmosphere, and emotional meaning that elevate the work beyond record-keeping.</p>

        <p>The distinction is not subtle.<br>
        A photograph of a cowboy is not automatically Western fine art.<br>
        A landscape of Monument Valley is not fine art simply because it is beautiful.</p>

        <p>Fine art requires the photographer to make decisions about what the image will mean. The subject does not confer status. The authorship does.</p>

        <p>This article defines what Western fine art photography is, what it is not, and why the distinction matters for collectors, curators, and anyone seeking work that endures on a wall rather than in a folder.</p>

        <!-- EARLY FUNNEL -->
        <div class="early-funnel" style="background:#f8f6f3; border-left:4px solid #8b5a2b; padding:1.25rem 1.5rem; margin:2rem 0; border-radius:0 8px 8px 0;">
          <p style="margin:0; font-size:1.05rem;">
            To see these ideas in practice, explore the primary 
            <a href="/Western-Fine-Art-Photography" style="color:#8b5a2b; font-weight:600; text-decoration:underline;">Western Fine Art Photography collection</a>.
          </p>
        </div>

        <!-- SECTION 2: Where It Fits -->
        <div class="section-heading-with-line">
          <h2>Where Western Fine Art Photography Fits</h2>
        </div>

        <p>Western fine art photography is not a separate category from <a href="/Blog/what-is-western-fine-art" style="color:#8b5a2b; text-decoration:underline;">Western fine art</a>. It is one of its mediums.</p>

        <p><a href="/Blog/what-is-western-art" style="color:#8b5a2b; text-decoration:underline;">Western art</a> as a whole includes illustration, film, décor imagery, and commercial photography. Western fine art represents the authored core of that tradition—work created with lasting artistic intent.</p>

        <p>Western fine art photography sits inside that core.<br>
        It applies the same authorship standards historically associated with painting to the photographic medium.</p>

        <p>The criteria are the same:</p>

        <ul style="list-style:disc; padding-left:1.5rem; margin:1rem 0 1.5rem;">
          <li style="margin-bottom:0.5rem;">Intentional composition</li>
          <li style="margin-bottom:0.5rem;">Narrative structure</li>
          <li style="margin-bottom:0.5rem;">Emotional depth</li>
          <li style="margin-bottom:0.5rem;">Technical restraint</li>
          <li style="margin-bottom:0.5rem;">Long-term artistic ambition</li>
        </ul>

        <p>If the work meets those standards, it belongs in the Western fine art conversation—regardless of whether it was painted or photographed.</p>

        <p>For the medium-level hub that gathers those ideas into an actual body of work, move from this definition page into the main <a href="/Western-Fine-Art-Photography" style="color:#8b5a2b; text-decoration:underline;">Western Fine Art Photography</a> collection.</p>

        <!-- SECTION 3: What It Is Not -->
        <div class="section-heading-with-line">
          <h2>What Western Fine Art Photography Is Not</h2>
        </div>

        <p>The term "Western photography" has been stretched until it means almost nothing. Search for it and you will find stock silhouettes, mass-produced sunset prints, and decorative pieces designed to match leather furniture.</p>

        <p>These serve legitimate purposes—but they are not fine art.</p>

        <p><strong>Western décor photography</strong><br>
        Designed for visual appeal without narrative weight. It prioritizes color coordination and familiar motifs over meaning.</p>

        <p><strong>Stock Western imagery</strong><br>
        Treats the West as interchangeable backdrop. The cowboy becomes a silhouette. The landscape becomes wallpaper.</p>

        <p><strong>Event and rodeo photography</strong><br>
        Documents action and performance. Valuable as journalism or record, but reactive rather than authored.</p>

        <p>Western fine art photography operates differently.<br>
        It is not reactive. It is built—light by light, frame by frame, decision by decision.</p>

        <!-- SECTION 4: What Defines It -->
        <div class="section-heading-with-line">
          <h2>What Defines Western Fine Art Photography</h2>
        </div>

        <p>Fine art photography—Western or otherwise—is defined by authorship. The photographer shapes how the image functions, what it communicates, and how it rewards attention over time.</p>

        <p>The photograph is not found.<br>
        It is made.</p>

        <p>In Western fine art photography, this authorship often appears as:</p>

        <p><strong>Character over archetype</strong><br>
        Cowboys, ranchers, and frontier figures appear as individuals rather than symbols.</p>

        <p><strong>Narrative structure</strong><br>
        Each image implies a story. Something has happened. Something is about to.</p>

        <p><strong>Emotional landscape</strong><br>
        The land shapes the human experience. Weather, sky, and distance function as narrative elements.</p>

        <p><strong>Craft and restraint</strong><br>
        Light is controlled. Composition is deliberate. The image is built for the print, not the screen.</p>

        <p>This is the difference between taking a picture and making one.</p>

        <!-- SECTION 5: Visual Demonstration -->
        <div class="section-heading-with-line">
          <h2>What This Looks Like</h2>
        </div>

        <div class="example-images">
          <figure>
            <a href={`/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/${image1.id}`}>
              <img 
                src={image1.src} 
                alt={image1.alt}
                loading="lazy"
              />
            </a>
            <figcaption style="font-size:0.85rem; color:#666; margin-top:0.5rem; font-style:italic;">
              Cowboy portrait in painterly light — a man, not a silhouette
            </figcaption>
          </figure>
          
          <figure>
            <a href={`/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/${image2.id}`}>
              <img 
                src={image2.src} 
                alt={image2.alt}
                loading="lazy"
              />
            </a>
            <figcaption style="font-size:0.85rem; color:#666; margin-top:0.5rem; font-style:italic;">
              Rope work in black and white — craft practiced when no one is watching
            </figcaption>
          </figure>

          <figure>
            <a href={`/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/NA-Color/${image3.id}`}>
              <img 
                src={image3.src} 
                alt={image3.alt}
                loading="lazy"
              />
            </a>
            <figcaption style="font-size:0.85rem; color:#666; margin-top:0.5rem; font-style:italic;">
              Native American woman at the water's edge — presence, memory, and quiet attention
            </figcaption>
          </figure>
        </div>

        <!-- SECTION 6: Why the Distinction Matters -->
        <div class="section-heading-with-line">
          <h2>Why the Distinction Matters</h2>
        </div>

        <p>For collectors, the distinction determines long-term value. Fine art is collected, written about, exhibited, and preserved. Commercial imagery is replaceable.</p>

        <p>For curators, it allows Western photography to be discussed alongside painting and sculpture, rather than confined to documentary or decorative categories.</p>

        <p>For artists, the distinction is structural. It determines whether the work participates in a fine art tradition or remains outside it.</p>

        <p>Western fine art photography exists to be considered over time—not simply viewed once and replaced.</p>

        <!-- SECTION 7: Explore -->
        <div class="section-heading-with-line">
          <h2>Explore the Work</h2>
        </div>

        <p>This article defines Western fine art photography as a discipline. The following collections present the work itself:</p>

        <ul style="list-style:disc; padding-left:1.5rem; margin:1rem 0 2rem;">
          <li style="margin-bottom:0.75rem;">
            <a href="/Western-Fine-Art-Photography" style="color:#8b5a2b; text-decoration:underline; font-weight:600;">Western Fine Art Photography</a> — 
            <span style="color:#666;">The full collection</span>
          </li>
          <li style="margin-bottom:0.75rem;">
            <a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color" style="color:#8b5a2b; text-decoration:underline;">Western Cowboy Portraits</a> — 
            <span style="color:#666;">Character studies in color and black & white</span>
          </li>
          <li style="margin-bottom:0.75rem;">
            <a href="/Painterly-Western-Photography" style="color:#8b5a2b; text-decoration:underline;">Painterly Western Photography</a> — 
            <span style="color:#666;">The visual language behind the work</span>
          </li>
        </ul>

        <p>Western fine art photography, at its best, invites the viewer past the familiar and into something specific—a person, a story, a moment that belongs to no one else.</p>

      </article>
    </section>

    <!-- Western Art Series Navigation -->
    <WesternDefinitions variant="definition" currentPage={3} />

    <SiteFooter />
  </main>

  <style>
    .story-section { line-height: 1.7; }
    .story-block p { margin-bottom: 1rem; font-size: clamp(1rem, 2.5vw, 1.125rem); }
