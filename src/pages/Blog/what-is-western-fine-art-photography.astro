      }
      .header-bar-image.pos-1::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 50%;
        background: linear-gradient(to right, rgba(255,255,255,0.8), transparent);
        z-index: 1;
        pointer-events: none;
      }
      .header-bar-image.pos-3::after {
        content: '';
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        width: 50%;
        background: linear-gradient(to left, rgba(255,255,255,0.8), transparent);
        z-index: 1;
        pointer-events: none;
      }
    }
    
    /* Section heading with extending line */
    .section-heading-with-line {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-top: 2.5rem;
      margin-bottom: 0;
