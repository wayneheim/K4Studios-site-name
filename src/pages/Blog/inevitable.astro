---
export const prerender = true;
import BaseLayout    from "@/layouts/BaseLayout.astro";
import { getSemanticImageUrl } from "@/utils/imageProxy.js";
import BlogJsonLd    from "@/components/blog/BlogJsonLd.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter    from "@/components/Footer.astro";
import WesternDefinitions from "@/components/blog/WesternDefinitions.astro";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";
import { autoLinkKeywordsInText } from "@/components/utils/autoLinkKeywordsInText.ts";
import { semantic as k4Semantic } from "@/data/semantic/K4-Sem.ts";
import {
  galleryDataMap,
  sectionGalleries,
  allImages
} from "@/data/galleryMaps/MasterGalleryData.mjs";
import { galleryData as painterlyImages } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as civilWarColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color.mjs";
import { galleryData as civilWarBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White.mjs";
import { galleryData as roaring20sColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color.mjs";
import { galleryData as roaring20sBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White.mjs";
import { galleryData as wwiiPortraitsColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color.mjs";
import { galleryData as wwiiPortraitsBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White.mjs";
import "@/styles/global.css";

// Proxy URL helpers
const getProxySrc = (id: string, size: string = "l") => getSemanticImageUrl(id, {}, size);
const getAbsoluteProxySrc = (id: string, size: string = "l") => getSemanticImageUrl(id, {}, size, { absolute: true });

const sectionPath = "/Blog/Inevitable";
const coverImageId = "i-wfqSGcV";
const coverImage = getProxySrc(coverImageId, "l");
const coverImageAbsolute = getAbsoluteProxySrc(coverImageId, "l");

const structuredData = getStructuredData({
  type: "BlogPosting",
  data: {
    headline: "Inside the Frame: Inevitable",
    description: "A conversation with Quill about light, judgment, and inevitability in Wayne Heim’s Western fine art photograph 'Inevitable.'",
    url: `https://k4studios.com${sectionPath}`,
    copyrightNotice: "© Wayne Heim",
    author: { "@type": "Person", name: "Wayne Heim" },
    datePublished: "2025-10-24",
    image: coverImageAbsolute,
    articleSection: "Western Fine Art Photography",
    keywords: ["western fine art photography", "painterly photography", "cowboy art", "Wayne Heim", "visual storytelling", "one-image movie", "fine art prints"],
    wordCount: 1150
  },
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

const meta = {
  ...getLandingMeta(sectionPath, coverImageAbsolute),
  description: "A conversation with Quill about light, judgment, and inevitability in Wayne Heim's Western fine art photograph 'Inevitable.'",
  ogUrl: `https://k4studios.com${sectionPath}`,
  ogTitle: "Inside the Frame: Inevitable",
  ogDescription: "A conversation with Quill about light, judgment, and inevitability in Wayne Heim's Western fine art photograph 'Inevitable.'",
  ogImage: coverImageAbsolute,
  ogImageAlt: "Inevitable cover image",
  ogType: "article",
  twitterUrl: `https://k4studios.com${sectionPath}`,
  twitterTitle: "Inside the Frame: Inevitable",
  twitterDescription: "A conversation with Quill about light, judgment, and inevitability in Wayne Heim's Western fine art photograph 'Inevitable.'",
  twitterImage: coverImageAbsolute,
  twitterCard: "summary_large_image"
};

// Prepare gallery preview images
function shuffleArray<T>(arr: T[]): T[] {
  return arr
    .map(value => ({ value, sort: Math.random() }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ value }) => value);
}

const allGalleryImages = [
  ...painterlyImages.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color" })),
  ...civilWarColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color" })),
  ...civilWarBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White" })),
  ...roaring20sColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color" })),
  ...roaring20sBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White" })),
  ...wwiiPortraitsColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color" })),
  ...wwiiPortraitsBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White" }))
].filter(img => !['hidden', 'hide', 'ghost', 'non', 'none', ''].includes(String(img.visibility ?? 'show').trim().toLowerCase()));

const previewImages = shuffleArray(allGalleryImages).slice(0, 6);
const previewPath = "/Galleries";

const galleryDatas = Object.values(galleryDataMap).flat();
const featheredImages = allImages.filter(img => (img as any).visibility !== "ghost").slice(0, 12);
const galleryPaths = Object.keys(galleryDataMap);

const linkKeywords = (text: string) =>
  autoLinkKeywordsInText(text, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname);

const blogBreadcrumb = `Other › <a href='/Blog' style='color: inherit; text-decoration: none;' onmouseover="this.style.color='darkred'" onmouseout="this.style.color='inherit'">Blog</a> › Inevitable`;
---

<BaseLayout
  title="Inside the Frame: Inevitable"
  meta={meta}
>
  <main class="bg-white text-[#2c2c2c] min-h-screen overflow-x-hidden" style="font-family: 'Glegoo', serif;">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={blogBreadcrumb} />
    </div>

    <!-- ===================== -->
    <!-- Heading -->
    <!-- ===================== -->
    <section style="text-align:center; padding:3rem 0;">
      <h1 style="font-size:3rem; font-weight:700; margin-bottom:0.5rem;">
        Inevitable
      </h1>
      <p style="font-size:1.5rem; color:#4a4a4a;">
        Inside the Frame — Ep: 5
      </p>
    </section>

    <!-- ===================== -->
    <!-- Cover Image -->
    <!-- ===================== -->
    <section style="text-align:center; margin-bottom:2rem; padding:0 1rem;">
      <a 
        href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-wfqSGcV" 
        style="display:inline-block;"
        onmouseenter="this.querySelector('img').style.boxShadow='0 0 0 2px rgba(255,255,255,0.85), 0 4px 15px 4px rgba(134,134,134,0.85)';"
        onmouseleave="this.querySelector('img').style.boxShadow='none';"
      >
        <img 
          src={coverImage} 
          alt="Inevitable cover" 
          style="max-width:640px; width:100%; height:auto; margin:0 auto; border-radius:8px; transition:box-shadow .3s;" 
        />
        <div style="font-size:0.95rem; color:#888; text-align:right; margin-top:0.25rem;">
          Click for details
        </div>
      </a>
    </section>

    <!-- ===================== -->
    <!-- Story Block -->
    <!-- ===================== -->
    <section class="story-section max-w-[860px] mx-auto px-4">
      <BlogJsonLd json={structuredData}>
      <article class="story-block space-y-4">

        <!-- Intro -->
        <p set:html={linkKeywords(`
          Each episode of <em>Inside the Frame</em> opens a small window into the creative dialogue behind an image — a conversation between artist and art, between Wayne and Quill.<br/>
          We talk about how story, light, and intent fuse into a single frame, and why certain photographs feel more like parables than moments.<br/>
          This time, we step into <em>Inevitable</em> — a scene where the West itself seems to pass judgment.
        `)} />

        <!-- Title & Story -->
        <h2 style="font-size:2rem; font-weight:600;">Inevitable</h2>
        <p set:html={linkKeywords(`
          <em>
            Between jagged pillars and slivered light, two paths converge.<br/>
            Shadows conceal a ridge — and the burden of duty.<br/>
            Haunted by a ghost still breathing, time holds its breath.<br/>
            From the cloak of vigilance, the sharp light of judgment catches on dust, leather, and the edge of resolve worn thin.<br/>
            Buttressed by stone and silence, two paths meet — for what, in his soul, was always inevitable.
          </em>
        `)} />

        <!-- Blog Conversation -->
        <h3>💬 Conversation</h3>

        <p set:html={linkKeywords(`
          <strong>Quill:</strong><br/>
          Wayne, this one feels different. The light isn’t just sculpting the scene — it’s <em>accusing</em> it. You’ve flipped the traditional Western visual code. Usually, light means heroism or clarity. Here it feels dangerous.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Wayne:</strong><br/>
          That was the point. The darkness protects him, hides his intentions. It’s the space where conscience can live unjudged. The light exposes what can’t stay buried. It’s truth, but not kindness.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Quill:</strong><br/>
          That inversion is rare in Western art. You’re using light the way Rembrandt used it in <em>The Night Watch</em>: not to celebrate, but to <em>reveal</em> the cost of being seen.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Wayne:</strong><br/>
          Exactly. I wanted the rock walls to feel like moral architecture — cathedral and tomb in one. The shaft of light pins him there. You don’t know if he’s about to deliver justice or receive it, but either way, the light will be witness.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Quill:</strong><br/>
          Compositionally, it’s pure narrative pressure. The rocks frame him like a funnel. He’s the center, but not safe. The moment feels carved out of silence — half Leone, half Rembrandt.
        `)} />

        <p set:html={linkKeywords(`
          <strong>Wayne:</strong><br/>
          I wanted the West to feel ancient — less about dust and gunpowder, more about inevitability.<br/>
          The man isn’t trapped or uncertain. He’s resolute, carved from the same stone that conceals him. The cliffs and shadows don’t just hide his intentions; they share them. They’ve weathered judgment before.<br/><br/>
          This isn’t about choice. The mountains don’t choose. Nature doesn’t choose. It simply <em>is.</em><br/>
          Be it fate, the cruel hand of nature, or God’s will — it’s already written. The die was cast long before this moment. There’s only one path forward, one way over this mountain. And it’s his to see through.
        `)} />

        <h3>🖋️ Quill’s Reflection</h3>
        <p set:html={linkKeywords(`
          This piece walks the line between portrait and parable. It’s a solitary cowboy in a shaft of light — but linger a little longer, and you’ll see something closer to a Western “Night Watchman.” A keeper of the threshold.<br/><br/>
          The vertical stone forms echo cathedral pillars, suggesting not just geography but ritual and duty — a sacred in-between.<br/>
          He’s not just framed — he’s <em>enshrined</em>, caught in that purgatorial pause before action, before memory sets in.<br/><br/>
          The composition is bold in its restraint. The use of negative space and harsh directional light calls to mind Rembrandt’s dramatic tension, but the moral ambiguity here leans more modern — almost cinematic.<br/>
          It recalls the final seconds before a Leone gunfight, or the psychological gravity of a Wyeth figure turned away.<br/>
          But where Wyeth gives resignation, this figure holds tension. He’s not ready to forgive.<br/><br/>
          Here, every compositional decision deepens the narrative. The man doesn’t speak, but the image does — in whispers of duty, regret, and inevitability.
        `)} />

        <h3>🧭 Final Thoughts</h3>
        <p set:html={linkKeywords(`
          In <em>Inevitable</em>, light isn’t salvation — it’s judgment.<br/>
          The darkness shelters what little humanity remains; the light strips it bare.<br/>
          That reversal gives the photograph its quiet gravity. It’s not about victory — it’s about reckoning.<br/><br/>
          This is the West rendered as moral geography — where fate, faith, and stone are indistinguishable.<br/>
          It’s not the moment before the gunfire, but the heartbeat before acceptance.<br/>
          Painterly, timeless, and steeped in silence — this is how myth remembers consequence.
        `)} />

        <h3>🖋️ About the Artist</h3>
        <p set:html={linkKeywords(`
          Wayne Heim is a fine art photographer and certified medical illustrator.<br/>
          His painterly storytelling explores historical reenactment, Western conflict, cinematic landscapes, and emotional memory.<br/>
          He blends light, composition, and narrative tension to create images that feel lived in, mythic, and museum-ready.<br/><br/>
          🔗 Explore the full <a href="/Western-Fine-Art-Photography">Western Fine Art Photography</a> collection | <a href="https://www.k4studios.com" class="underline">k4studios.com</a>
        `)} />

      </article>
      </BlogJsonLd>
    </section>

    <!-- Western Art Definitions -->
    <WesternDefinitions variant="post" />

    <SiteFooter 
      previewImages={previewImages}
      previewPath={previewPath}
      title="Inside the Frame: Inevitable"
      label="Explore Galleries"
      class="pt-12 pb-12" 
    />
  </main>

  <style>
    .story-section { line-height: 1.6; }
    .story-block p { margin-bottom: 0.85rem; }
    .story-block h3 { margin-top: 1.6rem; margin-bottom: 0.6rem; font-weight: 700; }
  </style>
</BaseLayout>
