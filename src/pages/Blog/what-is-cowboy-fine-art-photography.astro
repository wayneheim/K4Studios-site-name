    <!-- Article Header -->
    <section style="text-align:center; padding:2rem 1rem 2rem;">
      <h1 style="font-size:2.25rem; font-weight:700; margin-bottom:0.5rem; line-height:1.2;">
        What Is Cowboy Fine Art Photography?
      </h1>
      <p style="font-size:0.95rem; color:#888; margin-top:0.75rem; letter-spacing:0.02em;">
        Character over costume. Presence over pose. The cowboy treated as fine art, not nostalgia.
      </p>
    </section>

    <!-- Early Visual Bridge -->
    <section class="early-examples-section">
      <div class="early-examples-shell">
        <p class="early-examples-kicker">See the Portrait Standard</p>
