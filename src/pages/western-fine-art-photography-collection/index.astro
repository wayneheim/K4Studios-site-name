---
export const prerender = true;

// ─── Layout ──────────────────────────────────────────────────────────────────
import HybridHubLayout from "@/layouts/HybridHubLayout.astro";

// ─── Hybrid Components ───────────────────────────────────────────────────────
import HybridBookCarousel from "@/components/hybrid/HybridBookCarousel.jsx";
import HybridThesis from "@/components/hybrid/HybridThesis.astro";
import HybridDefinition from "@/components/hybrid/HybridDefinition.astro";
import HybridFAQ from "@/components/hybrid/HybridFAQ.astro";
import HybridCatalogTeaser from "@/components/hybrid/HybridCatalogTeaser.astro";
import HybridCollectorClose from "@/components/hybrid/HybridCollectorClose.astro";

// ─── Structured-data helpers ─────────────────────────────────────────────────
import { getBreadcrumbList } from "@/components/utils/getStructuredData.ts";

// ─── Auto keyword linker ─────────────────────────────────────────────────────
import { autoLinkKeywordsInText } from "@/components/utils/autoLinkKeywordsInText.ts";
import { semantic as k4Semantic } from "@/data/semantic/K4-Sem.ts";
import { siteNav } from "@/data/siteNav.ts";
import { getFeatheredImages } from "@/components/utils/getFeatheredImages.ts";

// ─── Hub data ────────────────────────────────────────────────────────────────
import {
  galleryBasePath,
  carouselSlides,
  thesis,
  definition,
  faqItems,
  catalogImages,
  collectorClose,
  pageMeta,
  breadcrumb,
} from "@/data/hybrid-hubs/cowboy.ts";

// ─── Paths ───────────────────────────────────────────────────────────────────
const pagePath = "/western-fine-art-photography-collection";
const canonicalUrl = `https://www.k4studios.com${pagePath}`;

// ─── Auto-linker wiring ──────────────────────────────────────────────────────
const imageSectionPath =
  "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits";

function findNavEntry(nav: any[], url: string): any | null {
  for (const entry of nav) {
    if (entry.href === url) return entry;
    if (entry.children) {
      const found = findNavEntry(entry.children, url);
      if (found) return found;
    }
  }
  return null;
}

const landingNav = findNavEntry(siteNav as any, imageSectionPath);
const galleryPaths: string[] = landingNav?.children?.map((c: any) => c.href) || [];

const allGalleryData = import.meta.glob('../../data/Galleries/**/*.mjs', { eager: true }) as any;
const galleryDatas = galleryPaths.map((path) => {
  const filePath = "../../data/Galleries" + path.replace(/^\/Galleries/, "") + ".mjs";
  return allGalleryData[filePath]?.galleryData || [];
});

const featheredImages = getFeatheredImages({
  sectionPath: imageSectionPath,
  headingCount: 6,
  galleryDatas,
  galleryPaths,
  minRating: 3,
  fallbackMin: 1,
  poolMultiplier: 2,
});

const linkKW = (text: string) =>
  autoLinkKeywordsInText(text, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath);

// ─── Apply auto-linker with page-level dedup ─────────────────────────────────
// Join all prose paragraphs into one string so the linker's internal Set<string>
// prevents the same phrase from linking more than once across the whole page.
const SPLIT = "<!-- §SPLIT§ -->";
const allProse = [
  ...thesis.body,
  ...definition.paragraphs,
  ...collectorClose.paragraphs,
];
const linkedAll = linkKW(allProse.join(SPLIT)).split(SPLIT);

const tLen = thesis.body.length;
const dLen = definition.paragraphs.length;
const linkedThesisBody          = linkedAll.slice(0, tLen);
const linkedDefinitionParagraphs = linkedAll.slice(tLen, tLen + dLen);
const linkedCloseParagraphs     = linkedAll.slice(tLen + dLen);

// ─── Structured Data ─────────────────────────────────────────────────────────
const stripHtml = (text: string) => text.replace(/<[^>]*>/g, "").trim();

// Breadcrumbs (getBreadcrumbList already returns a JSON string)
const breadcrumbsJSON = getBreadcrumbList([
  { name: "Home", item: "https://www.k4studios.com/" },
  {
    name: "Western Fine Art Photography Collection",
    item: canonicalUrl,
  },
]);

// FAQPage
const faqStructuredData = JSON.stringify(
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: stripHtml(Array.isArray(item.a) ? item.a.join(" ") : item.a),
      },
    })),
  },
  null,
  2
);

// WebPage
const webPageSchema = JSON.stringify(
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: pageMeta.title,
    description: pageMeta.description,
    inLanguage: "en",
    isPartOf: {
      "@type": "WebSite",
      "@id": "https://www.k4studios.com/#website",
      name: "K4 Studios",
      url: "https://www.k4studios.com/",
    },
    about: [
      { "@type": "Thing", name: "Western Fine Art Photography" },
      { "@type": "Thing", name: "Cowboy Fine Art Photography" },
      { "@type": "Thing", name: "Painterly Photography" },
      { "@type": "Thing", name: "Western Art for Collectors" },
      { "@type": "Thing", name: "Limited Edition Art Prints" },
    ],
    author: {
      "@type": "Person",
      name: "Wayne Heim",
      url: "https://www.k4studios.com/wayne-heim-western-fine-art-photography",
    },
    creator: {
      "@type": "Person",
      name: "Wayne Heim",
      url: "https://www.k4studios.com/wayne-heim-western-fine-art-photography",
    },
    copyrightHolder: {
      "@type": "Person",
      name: "Wayne Heim",
      url: "https://www.k4studios.com/wayne-heim-western-fine-art-photography",
    },
  },
  null,
  2
);

// Composite structured data for BaseLayout
const structuredDataJSON = `[${webPageSchema},${faqStructuredData}]`;

// ─── OG Image ────────────────────────────────────────────────────────────────
const ogImageUrl = `https://www.k4studios.com/img/${pageMeta.ogImage}/l`;

const meta = {
  description: pageMeta.description,
  "og:type": "website",
  "og:image": ogImageUrl,
  "og:image:width": "1024",
  "og:image:height": "683",
  "og:url": canonicalUrl,
  "twitter:card": "summary_large_image",
  "twitter:image": ogImageUrl,
};
---

<HybridHubLayout
  title={pageMeta.title}
  breadcrumb={breadcrumb}
  meta={meta}
  structuredDataJSON={structuredDataJSON}
  breadcrumbsJSON={breadcrumbsJSON}
>

  <!-- ── B: Hero Carousel ── -->
  <HybridBookCarousel
    slot="carousel"
    slides={carouselSlides}
    galleryBasePath={galleryBasePath}
    client:load
  />

  <!-- ── C: Thesis (H1) ── -->
  <HybridThesis
    slot="thesis"
    heading={thesis.heading}
    subtitle={thesis.subtitle}
    body={linkedThesisBody}
  />

  <!-- ── D: Definition ── -->
  <HybridDefinition
    slot="definition"
    heading={definition.heading}
    paragraphs={linkedDefinitionParagraphs}
    essayHref={definition.essayHref}
    essayLabel={definition.essayLabel}
  />

  <!-- ── E: FAQ ── -->
  <HybridFAQ
    slot="faq"
    faqItems={faqItems}
  />

  <!-- ── F: Catalog Grid ── -->
  <HybridCatalogTeaser
    slot="catalog"
    images={catalogImages}
    galleryHref={galleryBasePath}
    subheadingHtml={'A curated selection drawn from our larger archive of limited edition works in the <a href="/Cowboy-Fine-Art-Photography">Cowboy Fine Art Photography collection</a>.'}
  />

  <!-- ── G: Collector Close ── -->
  <HybridCollectorClose
    slot="close"
    heading={collectorClose.heading}
    paragraphs={linkedCloseParagraphs}
    ctaHref={collectorClose.ctaHref}
    ctaLabel={collectorClose.ctaLabel}
  />

</HybridHubLayout>
