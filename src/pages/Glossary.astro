function extractPhrasesWithType(sem: Record<string, SemanticSection>): Term[] {
  const all: Term[] = [];
  for (const key of Object.keys(sem || {})) {
    if (key === 'synonymMap') continue;
    const group = sem[key] as SemanticSection;
    if (!group) continue;

    const secDef = group.def; // pull section-level def

    for (const e of (group.landingPhrases || [])) {
      if (!e || e.use === false) continue;
      all.push({
        label: e.phrase,
        rating: e.rating ?? 0,
        origin: "landing",
        parentKey: key,
        path: group.path,
        definition: secDef ?? null,
        blurbPool: undefined,
        example: null
      });
    }
    for (const e of (group.imagePhrases || [])) {
      if (!e || e.use === false) continue;
      all.push({
        label: e.phrase,
        rating: e.rating ?? 0,
        origin: "image",
        parentKey: key,
        path: group.path,
        definition: secDef ?? null,
        blurbPool: undefined,
        example: null
      });
    }
  }
  // dedupe by label
  const seen = new Set<string>();
  return all.filter(({ label }) => {
    if (!label || seen.has(label)) return false;
    seen.add(label);
    return true;
  });
}

/* =============== example picker (branch-correct, deterministic) =============== */
const usedIds = new Set<string>();

function getLandingUrlForTerm(term: { parentKey?: string; path?: string }) {
  if (term?.parentKey && sectionUrlMap[term.parentKey]) return sectionUrlMap[term.parentKey];
  if (term?.path && typeof term.path === 'string') return term.path;
  return "/Galleries/Painterly-Fine-Art-Photography";
}

function pickExampleFor(termLabel: string, parentKey?: string, termPath?: string) {
  const landingHref =
    (parentKey && sectionUrlMap[parentKey]) ||
    (typeof termPath === 'string' && termPath) ||
    "/Galleries/Painterly-Fine-Art-Photography";

  const baseHref = resolveGalleryBase(landingHref);
  const images = getBranchImages(baseHref);
  if (!images.length) return null;

  const needle = (termLabel || "").toLowerCase();

  const matches = images.filter(img => {
    if (!img?.id || usedIds.has(img.id)) return false;
    const blob = [
      img.title, img.alt, img.description, img.story,
      ...(Array.isArray(img.keywords) ? img.keywords : [])
    ].filter(Boolean).join(' ').toLowerCase();
    return needle && blob.includes(needle);
  });

  let pool = matches.length ? matches : images.filter(i => i?.id && !usedIds.has(i.id));
  if (!pool.length) pool = images;

  const choice = pool[rotatingIndex(`${termLabel}|${baseHref}`, pool.length, 'day')] || pool[0];
  if (!choice) return null;

  usedIds.add(choice.id);

  const baseForHref = (choice as any).canonicalGallery || baseHref;
  const href = joinPath(baseForHref, ensureImageId(choice.id));

  return { ...choice, href, baseHref: baseForHref };
}

/* =============== curated glossary compose layer =============== */
function normalizeTermLabel(value: string = "") {
  return value
    .toLowerCase()
    .replace(/™/g, "")
    .replace(/™/g, "")
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function cleanGlossaryDefinition(value: string = "") {
  return String(value || "")
    .replace(/<[^>]*>/g, ' ')
    .replace(/\b(?:Explore|See|Read about|View)\s+[A-Z][^.]*?(?:\||$)[^.]*\.?/g, ' ')
    .replace(/\s+\|\s+/g, ' ')
    .replace(/\s+\./g, '.')
    .replace(/\s+/g, ' ')
    .trim();
}

function isPhraseVariantStuffing(term: string, config: GlossaryConceptConfig) {
  const normalized = normalizeTermLabel(term);
  if (!normalized) return true;
  if (/â„¢/.test(term)) return true;
  if (config.key === "oneImageMovie") {
    return /^(one image movies?|what is a one image movie)$/.test(normalized);
  }
  return false;
}

function isPublicVariantStuffing(term: string, pageTitle: string = "") {
  const normalized = normalizeTermLabel(term);
  const title = normalizeTermLabel(pageTitle);
  if (!normalized) return true;
  if (/[™]|â„¢|Ã¢â€žÂ¢/.test(term)) return true;
  if (title.includes("one image movie")) {
    return normalized.includes("one image movie");
  }
  return false;
}

function getPublicKeywordList(pageTitle: string, phrases: PhraseItem[] = []) {
  return phrases
    .filter(p => p?.use !== false)
    .sort((a, b) => (b.rating || 0) - (a.rating || 0))
    .map(p => p.phrase)
    .filter(phrase => !isPublicVariantStuffing(phrase, pageTitle))
    .slice(0, 6);
}

function uniqueStrings(values: Array<string | undefined | null>): string[] {
  const seen = new Set<string>();
  const out: string[] = [];
  for (const value of values) {
    const label = String(value || "").trim();
    if (!label) continue;
    const key = normalizeTermLabel(label);
    if (!key || seen.has(key)) continue;
    seen.add(key);
    out.push(label);
  }
  return out;
}

function getSynonymsFor(labels: string[]): string[] {
  const map = (semantic as any).synonymMap || {};
  const needles = new Set(labels.map(normalizeTermLabel));
  const out: string[] = [];

  for (const [canonical, synonyms] of Object.entries(map)) {
    const canonicalNorm = normalizeTermLabel(canonical);
    const synonymList = Array.isArray(synonyms) ? synonyms as string[] : [];
    const synonymNorms = synonymList.map(normalizeTermLabel);
    const matches = needles.has(canonicalNorm) || synonymNorms.some(s => needles.has(s));
    if (matches) out.push(String(canonical), ...synonymList);
  }

  return uniqueStrings(out);
}

function getPhrases(section: SemanticSection | undefined): string[] {
  if (!section) return [];
  return uniqueStrings([
    ...(section.landingPhrases || []).filter(p => p?.use !== false).map(p => p.phrase),
    ...(section.imagePhrases || []).filter(p => p?.use !== false).map(p => p.phrase),
  ]);
}

function buildFeaturedExamples(label: string, section: SemanticSection | undefined, key: string) {
  const candidates = uniqueStrings([label, ...getPhrases(section)]).slice(0, 4);
  const examples = candidates
    .map(term => pickExampleFor(term, key, section?.path))
    .filter(Boolean)
    .slice(0, 3) as Array<{ id: string; title?: string; alt?: string; href: string; }>;

  const seen = new Set<string>();
  return examples.filter(ex => {
    if (!ex?.id || seen.has(ex.id)) return false;
    seen.add(ex.id);
    return true;
  });
}

function buildGlossaryConcept(config: GlossaryConceptConfig): GlossaryConcept {
  const section = (semantic as any)[config.key] as SemanticSection | undefined;
  const phrases = getPhrases(section);
  const href = config.href || section?.path || "/Galleries/Painterly-Fine-Art-Photography";
  const relatedTerms = uniqueStrings([
    ...phrases.filter(p => normalizeTermLabel(p) !== normalizeTermLabel(config.label) && !isPhraseVariantStuffing(p, config)),
    ...getSynonymsFor([config.label, ...phrases]),
  ].filter(p => !isPhraseVariantStuffing(p || "", config))).slice(0, 8);

  return {
    label: config.label,
    kind: config.kind,
    priority: config.priority,
    href,
    definition: cleanGlossaryDefinition(section?.def || "A K4 Studios reference term connected to Wayne Heim's fine art photography, story structure, and collector presentation."),
    relatedTerms,
    featuredExamples: config.kind === "gallery" || config.kind === "canonicalConcept"
      ? buildFeaturedExamples(config.label, section, config.key)
      : [],
    sourceNote: config.sourceNote,
  };
}

const GLOSSARY_ENTRIES = Array.from(
  CURATED_GLOSSARY_CONFIG
    .map(buildGlossaryConcept)
    .reduce((map, entry) => {
      const key = normalizeTermLabel(entry.label);
      if (!map.has(key)) map.set(key, entry);
      return map;
    }, new Map<string, GlossaryConcept>())
    .values()
).sort((a, b) => a.priority - b.priority || a.label.localeCompare(b.label));

const RAW_TERMS: Term[] = GLOSSARY_ENTRIES.map(entry => ({
  label: entry.label,
  rating: 10 - entry.priority,
  origin: "landing",
  path: entry.href,
  parentKey: undefined,
  definition: [
    entry.definition,
    entry.relatedTerms.length ? `Also related: ${entry.relatedTerms.join(', ')}` : '',
  ].filter(Boolean).join(' '),
  blurbPool: [
    entry.kind === "gallery"
      ? `View the ${entry.label} collection`
      : entry.kind === "brandTerm"
        ? `Read about ${entry.label}`
        : `Explore ${entry.label}`,
  ],
  example: entry.featuredExamples[0]
    ? { ...entry.featuredExamples[0], baseHref: entry.href }
    : null,
}));

const LETTERS = Array.from(new Set(RAW_TERMS.map(t => (t.label?.[0] || "#").toUpperCase()))).sort();

const GLOSSARY_GROUPS: Array<{ title: string; kinds: GlossaryEntryKind[]; intro: string }> = [
  {
    title: "Core Concepts",
    kinds: ["canonicalConcept"],
    intro: "Primary K4 language: the concepts that deserve first-class definitions and authority links.",
  },
  {
    title: "K4 Terms",
    kinds: ["brandTerm"],
    intro: "Named K4 ideas and series that help explain the structure of Wayne Heim's work.",
  },
  {
    title: "Collector Terms",
    kinds: ["collectorTerm"],
    intro: "Terms that connect semantic meaning to print presentation, editions, interiors, and collecting.",
  },
  {
    title: "Gallery Paths",
    kinds: ["gallery"],
    intro: "Curated gallery branches that are useful as examples, not raw keyword lists.",
  },
  {
    title: "Search Language",
    kinds: ["synonym"],
    intro: "Common phrase variants grouped under nearby concepts instead of promoted as duplicate glossary entries.",
  },
];

const DUPLICATE_GLOSSARY_GROUPS = [
  "Cowboy art / cowboy artwork / cowboy photo art / cowboy fine art / cowboy portraits",
  "Western fine art photography / western photography / fine art western / western fine art prints",
  "Narrative Western art / Western narratives / western storytelling photography / cinematic Western photography",
  "Painterly photography / painterly fine art photography / painterly style photography",
  "Historically themed photography / historical themed photography / historically inspired photography / history themed photography",
  "One-Image Movie / One-Image Movies / single-frame narrative / cinematic still photography",
  "Engrained Series / Engrained Prints / wood prints / Baltic Birch",
];

/* =============== page meta / side images =============== */
// Key landing pages for grid (must be in frontmatter)
function getAllLandingPages(nav: any[]): { href: string; title: string; type?: string }[] {
  const out: { href: string; title: string; type?: string }[] = [];
  const seen = new Set<string>();

  function walk(nodes: any[], depth: number = 0, allowDepth3: boolean = false) {
    for (const node of nodes || []) {
      if (!node || typeof node !== 'object') continue;
      const { href, label, type, children } = node as any;
      const normalized = normalizeHref(href);
      const hasChildren = Array.isArray(children) && children.length > 0;
      const isLanding = href && (type !== 'gallery-source') && (type || hasChildren) && !normalized.includes('/landscapes/by-') && !['/contact', '/news-awards', '/other/photo-shoots', '/other/print-options', '/other/bio'].includes(normalized);

      if (isLanding && normalized && !seen.has(normalized)) {
        seen.add(normalized);
        out.push({
          href,
          title: label || toTitleCase(href.split('/').pop() || ''),
          type
        });
      }

      if (hasChildren) {
        const newAllowDepth3 = allowDepth3 || 
          (depth === 1 && normalized === '/galleries/traditional-fine-art-photography') || 
          (depth === 2 && normalized === '/galleries/painterly-fine-art-photography/facing-history');
        if (depth < 2 || newAllowDepth3) {
          walk(children, depth + 1, newAllowDepth3);
        }
      }
    }
  }

  walk(nav);
  return out;
}

const LANDING_PAGES = [
  { href: "/", title: "Home", type: "home" },
  ...getAllLandingPages(siteNav as any[])
];
const baseMeta = getLandingMeta(sectionPath);
const meta = {
  ...baseMeta,
  // OVERRIDE page/tab title so it doesn't use the Painterly landing title
  title: "K4 Studios Story Glossary | Wayne Heim Fine Art Photography Terms",
  description: "A curated K4 Studios glossary explaining painterly photography, Western fine art photography, One-Image Movies, Engrained prints, and collector-focused story language.",
  canonicalUrl: "https://www.k4studios.com/Glossary",
  ogTitle: "K4 Studios Story Glossary",
  ogDescription: "A curated semantic reference for Wayne Heim's painterly fine art photography, Western narrative art, historical portraiture, One-Image Movies, and Engrained prints.",
  twitterTitle: "K4 Studios Story Glossary"
};

const headingCount = 1;
const featheredImages = getSideImages({ sectionPath, headingCount });
const featheredImagesSidebar = featheredImages.slice(0, 5);

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://www.k4studios.com/Glossary#collection",
  name: "K4 Studios Story Glossary",
  description: "A curated semantic reference for Wayne Heim's painterly fine art photography, Western narrative art, historical portraiture, One-Image Movies, Engrained prints, and collector-focused image stories.",
  url: "https://www.k4studios.com/Glossary",
  inLanguage: "en",
  keywords: GLOSSARY_ENTRIES.map(entry => entry.label).join(", "),
  about: GLOSSARY_ENTRIES.slice(0, 24).map(entry => ({
    "@type": "DefinedTerm",
    name: entry.label,
    description: entry.definition,
    inDefinedTermSet: "https://www.k4studios.com/Glossary",
  })),
  creator: {
    "@type": "Person",
    name: "Wayne Heim",
    url: "https://www.k4studios.com/"
  },
  publisher: {
    "@type": "Organization",
    name: "K4 Studios",
    url: "https://www.k4studios.com/"
  },
  copyrightHolder: {
    "@type": "Person",
    name: "Wayne Heim",
    url: "https://www.k4studios.com/"
  },
  copyrightNotice: "Copyright Wayne Heim"
}, null, 2);

const breadcrumbsJSON = getBreadcrumbList([
  { name: "Home", item: "https://www.k4studios.com/" },
  { name: "K4 Studios Story Glossary", item: "https://www.k4studios.com/Glossary" },
]);
---

<BaseLayout
  title={isLegacyUrl ? "Page No Longer Available - K4 Studios" : "K4 Studios Story Glossary | Wayne Heim Fine Art Photography Terms"}
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbsJSON}
  meta={meta}
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Glegoo:wght@400;700&display=swap" />

  {isLegacyUrl ? (
    <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden flex flex-col items-center justify-center px-4" style="font-family: 'Glegoo', serif;">
      <div class="max-w-xl text-center py-20">
        <h1 class="text-3xl font-semibold mb-4">This Page Has Moved</h1>
        <p class="text-lg text-gray-600 mb-8">
          The legacy gallery URL you followed is no longer available. Our site has been redesigned with an improved browsing experience.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="px-6 py-3 bg-[#2c2c2c] text-white rounded hover:bg-[#444] transition">
            Visit Home Page
          </a>
          <a href="/Galleries/Painterly-Fine-Art-Photography" class="px-6 py-3 border border-[#2c2c2c] text-[#2c2c2c] rounded hover:bg-gray-100 transition">
            Browse Galleries
          </a>
        </div>
        <p class="text-sm text-gray-500 mt-8">
          Looking for something specific? Try our <a href="/Glossary" class="underline">Story Glossary</a> to explore by theme.
        </p>
      </div>
      <SiteFooter class="pt-8 pb-12 w-full" />
    </main>
  ) : (
  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden" style="font-family: 'Glegoo', serif;">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={glossaryBreadcrumb} />
    </div>
    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={glossaryBreadcrumb} />
    </div>
    <article aria-labelledby="glossary-title">
    <div class="w-full max-w-[1200px] mx-auto px-4">
      <div class="carousel-fade reveal-on-scroll">
        <ImageBar2 client:load slides={sanitizeForClient(painterlySlides)} />
      </div>
    </div>
    <section class="section-heading-wrap glossary-heading-wrap">
      <div class="section-heading">
        <h1 id="glossary-title" class="page-title">
          K4 Studios Story Glossary
        </h1>
        <p class="page-subtitle">
          This glossary explains the core language behind Wayne Heim's painterly fine art photography, Western narrative art, historical portraiture, One-Image Movies, Engrained prints, and collector-focused image stories.
        </p>
      </div>
    </section>

    <section class="w-full max-w-[1200px] mx-auto px-4 my-10" aria-labelledby="start-here-heading">
      <div class="rounded-lg border border-gray-200 bg-[#f8f7f3] p-6">
        <h2 id="start-here-heading" class="text-2xl font-semibold mb-4 text-center tracking-tight">Start Here</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {START_HERE_LINKS.map(item => (
            <a href={item.href} class="block rounded border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-900 hover:border-[#8b5a2b] hover:text-[#8b5a2b] transition">
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== Visual Site Map Grid ===================== -->
    <section class="w-full max-w-[1200px] mx-auto px-4 my-12">
      <h2 class="text-2xl font-semibold mb-6 text-center tracking-tight">
        Explore Galleries by Theme
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {LANDING_PAGES.map(page => {
          // Flexible semantic lookup: try exact, then strip trailing /gallery
          let sem =
            semanticByPath[normalizeHref(page.href)] ||
            semanticByPath[normalizeHref(page.href.replace(/\/gallery$/, ''))] ||
            {};

          // Explicit fallbacks for Traditional subsections
          if (!sem.def && page.href.toLowerCase().includes('/traditional-fine-art-photography/transportation'))
            sem = semantic.transportationTraditional || sem;
          if (!sem.def && page.href.toLowerCase().includes('/traditional-fine-art-photography/architecture'))
            sem = semantic.architectureTraditional || sem;

          let def = cleanGlossaryDefinition(sem.def || "Explore the collection");
          let landingPhrases = sem.landingPhrases || [];

          const keywords = getPublicKeywordList(page.title, landingPhrases);
          const colorClass = page.href === "/" ? "bg-yellow-50" : (page.href.startsWith("/Galleries/Painterly-Fine-Art-Photography") || page.href.includes("/engrained") || page.title.includes("Engrained")) ? "bg-blue-50" : page.href.startsWith("/Galleries/Traditional-Fine-Art-Photography") ? "bg-green-50" : "bg-white";
          return (
            <div class={`relative group rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-lg transition-all duration-300 ${colorClass}`}>
              <a href={page.href} class="block relative">
                <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="p-5 h-[140px] flex flex-col relative">
                  <h3 class="text-lg font-semibold text-gray-900 group-hover:text-black mb-2">
                    {page.title}
                  </h3>
                  <div class="relative">
                    <p class="text-sm text-gray-500 line-clamp-3 group-hover:hidden" set:html={def}>
                    </p>
                    <div class="absolute inset-0 hidden group-hover:block">
                      <p class="text-sm text-gray-500 line-clamp-3">
                        {keywords.join(', ')}
                      </p>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          );
        })}
      </div>
    </section>

    <!-- ===================== Photography Archives ===================== -->
    <section class="w-full max-w-[1200px] mx-auto px-4 my-12">
      <h2 class="text-2xl font-semibold mb-4 text-center tracking-tight">
        Photography Archives
      </h2>
      <p class="text-center text-gray-600 mb-6 max-w-2xl mx-auto">
        Complete image archives organized by subject. Each archive contains the full collection for its category.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
        <a href="/Western-Cowboy-Photography-Archive" class="block rounded-xl border border-gray-200 bg-amber-50 p-4 hover:shadow-md transition-shadow text-center">
          <div class="text-2xl mb-1">🤠</div>
          <h3 class="font-semibold text-gray-900">Western Cowboy</h3>
          <p class="text-sm text-gray-500">839 images</p>
        </a>
        <a href="/WWII-Photography-Archive" class="block rounded-xl border border-gray-200 bg-slate-50 p-4 hover:shadow-md transition-shadow text-center">
          <div class="text-2xl mb-1">⭐</div>
          <h3 class="font-semibold text-gray-900">World War II</h3>
          <p class="text-sm text-gray-500">767 images</p>
        </a>
        <a href="/Landscape-Photography-Archive" class="block rounded-xl border border-gray-200 bg-green-50 p-4 hover:shadow-md transition-shadow text-center">
          <div class="text-2xl mb-1">🏔️</div>
          <h3 class="font-semibold text-gray-900">Landscapes</h3>
          <p class="text-sm text-gray-500">703 images</p>
        </a>
        <a href="/Portrait-Photography-Archive" class="block rounded-xl border border-gray-200 bg-rose-50 p-4 hover:shadow-md transition-shadow text-center">
          <div class="text-2xl mb-1">👤</div>
          <h3 class="font-semibold text-gray-900">Portraits</h3>
          <p class="text-sm text-gray-500">281 images</p>
        </a>
        <a href="/Painterly-Landscape-Photography-Archive" class="block rounded-xl border border-gray-200 bg-blue-50 p-4 hover:shadow-md transition-shadow text-center">
          <div class="text-2xl mb-1">🎨</div>
          <h3 class="font-semibold text-gray-900">Painterly Landscapes</h3>
          <p class="text-sm text-gray-500">114 images</p>
        </a>
      </div>
    </section>

    <!-- ===================== Curated Glossary Layout ===================== -->
    <section class="story-layout">
      <div class="text-column">
        <section class="story-section">
          <header class="mb-8">
            <h2 class="text-2xl font-semibold tracking-tight">Curated Glossary Concepts</h2>
            <p class="mt-2 text-base text-gray-600">
              Canonical concepts are first-class entries. Related search language is grouped beneath those concepts so keyword variants and image titles do not compete with the main K4 vocabulary.
            </p>
          </header>
          {LETTERS.length > 0 && (
            <nav class="mb-8">
              <ol style="display: flex; gap: 1em;">
                {LETTERS.map(L => (
                  <li><a href={`#${L}`}>{L}</a></li>
                ))}
              </ol>
            </nav>
          )}
          <div class="space-y-12">
            {LETTERS.map(L => {
              const group = RAW_TERMS.filter(t => (t.label?.[0] || "#").toUpperCase() === L);
              if (!group.length) return null;
              return (
                <section id={L} class="scroll-mt-24">
                  <h3 class="text-xl font-semibold mb-4">{L}</h3>
                  <ul class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {group.map(t => {
                      const landingUrl = getLandingUrlForTerm(t);
                      const mainLink   = (t.origin === "image" && t.example?.href) ? t.example.href : landingUrl;
                      const blurbPool  = t.blurbPool || [];
                      const blurb      = blurbPool.length
                        ? blurbPool[rotatingIndex(`${t.label}|cta`, blurbPool.length, 'day')]
                        : "Browse the collection";
                      return (
                        <li class="rounded-2xl border border-gray-200 p-5 shadow-sm hover:shadow transition-shadow">
                          <div class="flex items-start gap-4">
                            {t.origin === "image" && t.example && t.example.id && (
                              <a href={t.example.href} class="shrink-0 rounded-xl overflow-hidden border border-gray-200">
                                <img
                                  src={`/img/${t.example.id}/s.jpg`}
                                  alt={t.example.alt || t.example.title || t.label}
                                  loading="lazy"
                                  class="block h-20 w-28 object-cover"
                                />
                              </a>
                            )}
                            <div class="min-w-0">
                              <div class="flex items-center gap-2 mb-1">
                                <a href={mainLink} class="text-lg font-medium hover:underline">{t.label}</a>
                                <span class={`ml-2 inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] tracking-wide
                                  ${t.origin === "landing"
                                    ? "border-green-300 bg-green-50 text-green-700"
                                    : "border-blue-300 bg-blue-50 text-blue-700"
                                  }`
                                }>
                                  {t.origin === "landing" ? "Concept" : "Example"}
                                </span>
                              </div>
                              {t.definition && (
                                <p class="mt-1 text-sm text-gray-700">{t.definition}</p>
                              )}
                              <div class="mt-2 flex flex-wrap items-center gap-3 text-sm">
                                <a href={landingUrl} class="underline">{blurb}</a>
                                {(t.origin === "image" && t.example) && (
                                  <a href={t.example.href} class="underline">See example image</a>
                                )}
                              </div>
                              {/* Rating intentionally removed */}
                            </div>
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                </section>
              );
            })}
          </div>
        </section>
        <section class="story-section mt-12 rounded-lg border border-gray-200 bg-gray-50 p-5">
          <h2 class="text-xl font-semibold">Grouped Duplicate Language</h2>
          <p class="mt-1 text-sm text-gray-600">
            These repetitive phrase families are now handled as related language under canonical entries instead of equal glossary headings.
          </p>
          <ul class="mt-4 grid grid-cols-1 gap-2 text-sm text-gray-700">
            {DUPLICATE_GLOSSARY_GROUPS.map(group => (
              <li class="rounded border border-gray-200 bg-white px-3 py-2">{group}</li>
            ))}
          </ul>
        </section>
        <MobileStoryImages client:only="react" images={sanitizeForClient(featheredImages)} displayCount={headingCount} />
      </div>
      <div class="sidebar-column hidden md:block">
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages heading="Collection Samples" images={featheredImagesSidebar} displayCount={5} />
        </div>
      </div>
    </section>
    </article>
    <SiteFooter class="pt-8 pb-12" />
    <!-- Hidden div to force Tailwind to include all inset utilities -->
    <div style="display:none">
      <div class="inset-0 inset-x-0 inset-y-0 inset-1 inset-2 inset-3 inset-4 inset-5 inset-6 inset-7 inset-8 inset-9 inset-10 inset-11 inset-12 inset-14 inset-16 inset-20 inset-24 inset-28 inset-32 inset-36 inset-40 inset-44 inset-48 inset-52 inset-56 inset-60 inset-64 inset-72 inset-80 inset-96 inset-auto inset-1/2 inset-1/3 inset-2/3 inset-1/4 inset-2/4 inset-3/4 inset-full top-0 right-0 bottom-0 left-0 top-1 right-1 bottom-1 left-1 top-2 right-2 bottom-2 left-2 top-4 right-4 bottom-4 left-4 top-auto right-auto bottom-auto left-auto"></div>
    </div>
  </main>
  )}
  <style>
    .story-section { font-family: 'Glegoo', serif; }
    .glossary-heading-wrap {
      margin: 2rem auto 1.25rem;
      padding: 0 1rem;
      text-align: center;
    }
    .glossary-heading-wrap .section-heading {
      margin: 0 auto;
      max-width: 920px;
    }
    .glossary-heading-wrap .page-title {
      margin: 0 0 0.65rem;
    }
    .glossary-heading-wrap .page-subtitle {
      max-width: 820px;
      margin: 0 auto;
      line-height: 1.55;
      opacity: 1;
    }
  </style>
</BaseLayout>
