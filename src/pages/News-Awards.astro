---
export const prerender = true;
import BaseLayout         from '@/layouts/BaseLayout.astro';
import LandingHeader      from '@/components/Landing-Header.jsx';
// TombstoneNav not used on News page
// import TombstoneNav       from '@/components/TombstoneNav.jsx';
import LandingRightImages from '@/components/LandingRightImages.jsx';
// import FAQAccordion       from '@/components/FAQAccordion.jsx';
import SiteFooter         from '@/components/Footer.astro';
import MobileStoryImages  from '@/components/MobileStoryImages.jsx';
import { getStructuredData } from '@/components/utils/getStructuredData.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';

import { siteNav } from '@/data/siteNav.ts';
import { getSideImages } from '@/components/utils/getSideImages.ts';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';
import { autoLinkKeywordsInText } from '@/components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '@/data/semantic/K4-Sem.ts';

import { landingWestern } from '@/data/News/landingstones.ts';
import { painterlyStory as westernStory } from '@/data/News/story.ts';
// import { facingFAQ } from '@/data/News/faq.ts';

import '@/styles/global.css';

// ----------------------
// DYNAMIC LOGIC SECTION
// ----------------------

const sectionPath = "/News-Awards";
const pagePath = "/News-Awards";
const canonicalPageUrl = `https://www.k4studios.com${pagePath}`;
const artOfTheWestFeatureUrl = "https://aotw.com/2026/02/painterly-photography/";
// Use painterly galleries for sidebar images
const gallerySectionPath = "/Galleries/Painterly-Fine-Art-Photography";
const meta = getLandingMeta(pagePath);

type AwardItem = { title: string; note: string };
type StorySection = {
  title?: string;
  subhead?: string;
  tagline?: string;
  paragraphs?: string[];
  awards?: AwardItem[];
  list?: string[];
};

const westernStorySections = westernStory as unknown as StorySection[];

const landingKeywords = Array.isArray((landingWestern as any)?.keywords)
  ? (landingWestern as any).keywords
  : [];

const headingCount = westernStorySections.filter((block, i) => i > 0 && block.subhead).length;

function findNavEntry(nav, url) {
  for (const entry of nav) {
    if (entry.href === url) return entry;
    if (entry.children) {
      const found = findNavEntry(entry.children, url);
      if (found) return found;
    }
  }
  return null;
}
function recursivelyGatherAllGalleryHrefs(node) {
  let result = [];
  if (!node) return result;
  if (node.href && node.href.startsWith('/Galleries/')) result.push(node.href);
  if (node.children) node.children.forEach(child => result = result.concat(recursivelyGatherAllGalleryHrefs(child)));
  return result;
}
const landingNav = findNavEntry(siteNav, gallerySectionPath);
const galleryPaths = landingNav
  ? recursivelyGatherAllGalleryHrefs(landingNav)
  : [];
const allGalleryData = import.meta.glob<{ galleryData?: any[] }>('@/data/Galleries/**/*.mjs', { eager: true });
const galleryDatas = galleryPaths.map(path => {
  const filePath = "@/data/Galleries" + path.replace(/^\/Galleries/, "") + ".mjs";
  return allGalleryData[filePath]?.galleryData ?? [];
});

const featheredImages = getSideImages({
  sectionPath: gallerySectionPath,
  headingCount,
  poolMultiplier: 3
});

const structuredData = getStructuredData({
  type: "Article",
  data: {
    headline: `${landingWestern.title} – ${landingWestern.subtitle}`,
    description: "Awards, juried exhibitions, and professional recognition for K4 Studios fine art photography by Wayne Heim.",
    url: canonicalPageUrl,
    articleSection: "News, Awards, and Press Recognition",
    keywords: landingKeywords,
    about: [
      { "@type": "Person", "@id": "https://www.k4studios.com/#person", name: "Wayne Heim" },
      { "@type": "Thing", name: "painterly Western photography" },
      { "@type": "Thing", name: "narrative Western art" },
      { "@type": "Thing", name: "One-Image Movie" },
      { "@type": "Thing", name: "historically themed photography" }
    ],
    mentions: [
      {
        "@type": "Organization",
        "@id": "https://aotw.com/#organization",
        name: "Art of the West",
        url: "https://aotw.com/"
      },
      { "@type": "Occupation", name: "Medical Illustrator" },
      { "@type": "Thing", name: "cinematic storytelling" }
    ],
    citation: artOfTheWestFeatureUrl,
    subjectOf: {
      "@type": "Article",
      "@id": `${artOfTheWestFeatureUrl}#article`,
      name: "Art of the West feature on Wayne Heim's painterly photography",
      url: artOfTheWestFeatureUrl,
      publisher: {
        "@type": "Organization",
        "@id": "https://aotw.com/#organization",
        name: "Art of the West",
        url: "https://aotw.com/"
      },
      about: [
        { "@type": "Person", "@id": "https://www.k4studios.com/#person", name: "Wayne Heim" },
        { "@type": "Thing", name: "painterly Western photography" },
        { "@type": "Thing", name: "narrative fine art photography" },
        { "@type": "Thing", name: "One-Image Movie" }
      ]
    },
    copyrightNotice: "© Wayne Heim"
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    acquireLicensePage: "https://k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});
---

<BaseLayout
  title="Wayne Heim — Press, Awards & Exhibition Recognition"
  structuredDataJSON={structuredData}
  meta={meta}
>

  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingWestern.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
  <div class="mobile-breadcrumb" set:html={landingWestern.breadcrumb} />
</div>

    <!-- No carousel for News & Awards page -->

    <section class="section-heading-wrap pt-2 sm:pt-4">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">
          {landingWestern.title}
        </h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">
          {landingWestern.subtitle}
        </h2>
      </div>
    </section>

    <!-- No tombstone navigation on News page -->

    <section class="story-layout">
      <div class="text-column">
        <section class="story-section">
          {westernStorySections.map((section) => (
            <Fragment>
              {section.subhead === "Press & Related Resources" && (
                /* Future press cluster candidates: /Press/Art-of-the-West, /Press/Western-Art-and-Architecture */
                <section class="story-block press-feature" aria-labelledby="art-of-the-west-feature">
                  <h2 id="art-of-the-west-feature" class="slide-in-left">Featured in Art of the West</h2>
                  <p class="reveal-on-scroll">
                    <a href={artOfTheWestFeatureUrl} target="_blank" rel="noopener">Art of the West</a> featured Wayne Heim's painterly Western photography in an editorial context attentive to process, authorship, and narrative structure. The feature places the work within a broader Western art conversation where photography, painterly finish, and cinematic storytelling meet without losing historical restraint.
                  </p>
                  <p class="reveal-on-scroll">
                    The article also notes the unusual path behind the work: Heim's background in medical illustration, with its discipline of visual clarity and anatomical precision, carried into narrative Western fine art photography. That crossover helps explain the One-Image Movie approach, where a single historically themed photograph is built to hold character, consequence, and an unresolved story within one frame.
                  </p>
                </section>
              )}

              <article class="story-block">
                {section.title && <h2 class="slide-in-left" set:html={autoLinkKeywordsInText(section.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
                {section.subhead && <h3 class="slide-in-left" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
                {section.tagline && <h4 class="tagline reveal-on-scroll" set:html={autoLinkKeywordsInText(section.tagline, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
                {section.paragraphs?.map((para) => (
                  <p class="reveal-on-scroll" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
                ))}
                {section.awards && section.awards.length > 0 && (
                  <ul class="awards-list">
                    {section.awards.map((award) => (
                      <li class="reveal-on-scroll">
                        <strong>{award.title}</strong>: <span set:html={autoLinkKeywordsInText(award.note, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
                      </li>
                    ))}
                  </ul>
                )}
                {section.list && section.list.length > 0 && (
                  <ul>
                    {section.list.map((item) => (
                      <li class="reveal-on-scroll" set:html={autoLinkKeywordsInText(item, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
                    ))}
                  </ul>
                )}
              </article>
            </Fragment>
          ))}
        </section>

        <MobileStoryImages client:only="react" images={sanitizeForClient(featheredImages)} displayCount={headingCount} />
      </div>

      <div class="sidebar-column hidden md:block">
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages
            client:load
            heading="Collection Samples"
            images={sanitizeForClient(featheredImages)}
            displayCount={6}
          />
        </div>
      </div>
    </section>

    <section class="pb-10">
      <input type="checkbox" id="faq-toggle" class="more-toggle" />
      <div class="truncate-container" style="min-height:0;">
        <div class="truncate-text">
          {/* <FAQAccordion items={facingFAQ} /> */}
        </div>
      </div>
      <label for="faq-toggle" class="more-toggle-label"></label>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // Reveal-on-scroll logic
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.15
        });
        els.forEach(el => observer.observe(el));
      }

      // NEW: auto-expand FAQ box if a question is clicked
      const faqToggle = document.getElementById("faq-toggle");
      const truncateContainer = document.querySelector(".truncate-container");

      if (truncateContainer && faqToggle) {
        truncateContainer.addEventListener("click", (e) => {
          const summaryClicked = e.target.closest("summary");
          if (summaryClicked && !faqToggle.checked) {
            faqToggle.checked = true;
          }
        });
      }
    });
  </script>


  <style>

  ul {
  list-style-type: disc;
  padding-left: 1.25em;
}

ul li {
  margin-top: 0.15em;
  margin-left: 1.5em;
}

ul li::marker {
   margin-top: 0.15em;
  font-size: 1.2em; /* makes bullet bigger */
  color: gray;      /* or any tone you want */
}
    @media (max-width: 768px) {
      .section-heading .page-title {
        font-size: 1.5rem;
        line-height: 1.3;
      }

      .section-heading .page-subtitle {
          max-width: 42ch;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
        font-size: 1rem;
        line-height: 1.4;
        letter-spacing: -0.04em;
      }

      .section-heading-wrap {
        margin-top: 1rem;
        margin-bottom: 1rem;
      }

      .sidebar-column {
        display: none;
      }

      .story-section {
        letter-spacing: -0.03em;
      }

      .story-block h2 {
        letter-spacing: -0.05em;
        font-size: 1.4rem !important;
        margin-top: -0.59rem;
        line-height: 1.15;
      }
    }

    .fade-in {
      opacity: 0;
      visibility: hidden;
      transform: translateY(1px);
      transition: opacity 1.75s ease, transform 1.75s ease, visibility .5s linear 1.75s;
    }

    .fade-in.is-visible {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }

    .page-title.fade-in {
      transition-delay: .2s;
    }

    .section-heading-wrap {
      margin: 1.5rem 0;
      text-align: center;
    }

    .section-heading .page-title {
      font-size: 2rem;
       margin-top: -3rem;
      margin-bottom: .4rem;
    }

    .section-heading .page-subtitle {
      font-size: 1rem;
      font-weight: 500;
      color: #6d5b4a;
      margin-bottom: 1.4rem;
      opacity: .9;
    }

    .story-section {
      line-height: 1.3;
      padding: 2rem 1.5rem;
      max-width: 860px;
      margin: 0 auto;
      font-family: 'Glegoo', serif;
    }

    .story-block {
      margin-bottom: 2.5rem;
    }

    .story-block h2 {
      font-weight: 500;
      font-size: 1.65rem;
      margin-bottom: 0.55rem;
    }

    .story-block h3 {
      font-weight: 500;
      font-size: 1.2rem;
      margin-top: -0.5rem;
      margin-bottom: -.025rem;
      color: #5a4a3b;
    }

    .story-block .tagline {
      font-size: 1.05rem;
      font-weight: 500;
      margin-bottom: 1rem;
      color: #7a6250;
    }

    .story-block p {
      line-height: 1.6;
      margin-bottom: 1rem;
      font-size: 1.01rem;
    }

    .story-block ul {
      padding-left: 1.4rem;
      margin-top: 0.5rem;
    }

    .story-block li {
      margin-bottom: 0.5rem;
      font-size: 1rem;
    }
.page-subtitle.fade-in {
  opacity: 0 !important; /* Forces initial hidden state */
  transform: translateY(-12px);
  visibility: hidden;
  transition:
    opacity 1.1s ease-out,
    transform 1.1s ease-out,
    visibility 0s linear 1.1s;
  transition-delay: 1s;
}

.page-subtitle.fade-in.is-visible {
  opacity: 1 !important;
  transform: translateY(0);
  visibility: visible;
  transition-delay: 1s;
}

.carousel-fade {
  opacity: 0;
  transform: translateY(0px);
  transition:
    opacity 1.5s ease-out,
    transform 1.5s ease-out;
  transition-delay: 0.0s;
  visibility: hidden;
}

.sample-fade {
  opacity: 0;
  transform: translateY(0px);
  transition:
    opacity 1.5s ease-out,
    transform 1.5s ease-out;
  transition-delay: 0.2s;
  visibility: hidden;
    margin-top: -0.75rem; /* <-- this line does the nudge */
}

.sample-fade.is-visible {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
}


.carousel-fade.is-visible {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
}


  </style>
</BaseLayout>
