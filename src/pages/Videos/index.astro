---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter from "@/components/Footer.astro";
import VideoCard from "@/components/videos/VideoCard.astro";
import { DEFAULT_VIDEO_TEASER_IMAGE, getVideoUrl, videos } from "@/data/videos/videoRegistry";
import "@/styles/global.css";

const pageTitle = "K4 Studios Videos | Fine Art Photography Films, Shorts & Stories";
const pageDescription =
  "A video archive of K4 Studios narrative films, shorts, artist commentary, and behind-the-scenes stories built around painterly fine art photography, historical imagery, and visual storytelling.";
const archiveUrl = "https://www.k4studios.com/Videos/";
const sortedVideos = [...videos].sort((a, b) => b.date.localeCompare(a.date));

const videoItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "K4 Studios Video Archive",
  description: pageDescription,
  url: archiveUrl,
  itemListElement: sortedVideos.map((video, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: video.title,
    url: new URL(getVideoUrl(video), archiveUrl).toString(),
  })),
};

const collectionPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "K4 Studios Video Archive",
  description: pageDescription,
  url: archiveUrl,
  isPartOf: {
    "@type": "WebSite",
    name: "K4 Studios",
    url: "https://www.k4studios.com/",
  },
  publisher: {
    "@type": "Organization",
    name: "K4 Studios",
    url: "https://www.k4studios.com/",
  },
  mainEntity: videoItemList,
});

const meta = {
  title: pageTitle,
  description: pageDescription,
  canonicalUrl: archiveUrl,
  ogUrl: archiveUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  twitterTitle: pageTitle,
  twitterDescription: pageDescription,
  ogImage: DEFAULT_VIDEO_TEASER_IMAGE,
  ogImageAlt: "K4 Studios video archive teaser image",
};
---

<BaseLayout title={pageTitle} description={pageDescription} structuredDataJSON={collectionPageJsonLd} meta={meta}>
  <main class="videos-page">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb="Other &rsaquo; Videos" />
    </div>

    <section class="video-hero" aria-labelledby="videos-title">
      <div class="hero-media">
        <img src={DEFAULT_VIDEO_TEASER_IMAGE} alt="K4 Studios video archive teaser image" />
      </div>

      <div class="hero-copy">
        <p class="eyebrow">K4 Studios Videos</p>
        <h1 id="videos-title">K4 Studios Video Archive</h1>
        <p>Narrative films, shorts, reels, show pieces, and behind-the-scenes video work from K4 Studios &mdash; built from still photographs, voice, music, text, and memory.</p>
      </div>
    </section>

    <section class="archive-tools" aria-label="Video archive controls">
      <label class="sort-control">
        <span>Sort</span>
        <select data-video-sort>
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
          <option value="type">Media Type</option>
          <option value="theme">Subject / Theme</option>
          <option value="title">Title A-Z</option>
        </select>
      </label>
    </section>

    <section class="video-grid" data-video-grid aria-label="K4 Studios videos">
      {sortedVideos.map((video) => <VideoCard video={video} />)}
    </section>

    <SiteFooter previewImages={[]} previewPath="" title={pageTitle} label="" class="pt-8 pb-12" />
  </main>

  <script>
    const grid = document.querySelector("[data-video-grid]");
    const cards = grid ? Array.from(grid.querySelectorAll("[data-video-card]")) : [];
    const sortSelect = document.querySelector("[data-video-sort]");

    function compareCards(a, b, sortMode) {
      if (sortMode === "oldest") return a.dataset.date.localeCompare(b.dataset.date);
      if (sortMode === "theme") return a.dataset.theme.localeCompare(b.dataset.theme) || b.dataset.date.localeCompare(a.dataset.date);
      if (sortMode === "type") return a.dataset.typeGroup.localeCompare(b.dataset.typeGroup) || b.dataset.date.localeCompare(a.dataset.date);
      if (sortMode === "title") return a.dataset.title.localeCompare(b.dataset.title);
      return b.dataset.date.localeCompare(a.dataset.date);
    }

    function insertGroupHeader(label) {
      const header = document.createElement("div");
      header.className = "video-group-header";
      header.textContent = label;
      grid.appendChild(header);
    }

    function updateArchive() {
      if (!grid) return;
      grid.querySelectorAll(".video-group-header").forEach((header) => header.remove());
      const sortMode = sortSelect ? sortSelect.value : "newest";
      const sortedCards = [...cards].sort((a, b) => compareCards(a, b, sortMode));
      let currentGroup = "";

      sortedCards.forEach((card) => {
        if (sortMode === "theme" || sortMode === "type") {
          const groupLabel = sortMode === "theme" ? card.dataset.theme : card.dataset.typeGroup;
          if (groupLabel && groupLabel !== currentGroup) {
            currentGroup = groupLabel;
            insertGroupHeader(groupLabel);
          }
        }
        card.hidden = false;
        grid.appendChild(card);
      });
    }

    if (sortSelect) sortSelect.addEventListener("change", updateArchive);
  </script>

  <style>
    .videos-page {
      background: #fbfaf7;
      color: #302a24;
      min-height: 100vh;
      overflow-x: hidden;
      font-family: "Glegoo", serif;
    }

    .video-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
      gap: clamp(1rem, 2.4vw, 2rem);
      align-items: stretch;
      max-width: 1180px;
      margin: 1rem auto 0;
      padding: clamp(0.8rem, 2.4vw, 1.5rem);
    }

    .hero-media,
    .hero-copy {
      border: 1px solid rgba(88, 72, 55, 0.18);
      background: #fffdf9;
      box-shadow: 0 18px 48px rgba(50, 38, 25, 0.08);
      border-radius: 8px;
    }

    .hero-media {
      min-height: 230px;
      max-height: 320px;
      overflow: hidden;
    }

    .hero-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: saturate(0.86) contrast(1.03);
    }

    .play-mark {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 1;
      transform: translate(-50%, -50%);
      width: 74px;
      height: 74px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.7);
      background: rgba(32, 25, 18, 0.62);
      color: transparent;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
    }

    .play-mark::before {
      content: "";
      margin-left: 5px;
      border-top: 13px solid transparent;
      border-bottom: 13px solid transparent;
      border-left: 20px solid #fff8ed;
    }

    .hero-copy {
      padding: clamp(1.1rem, 2.4vw, 1.8rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .eyebrow {
      margin: 0 0 0.75rem;
      color: #8b6a4a;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-weight: 700;
    }

    h1 {
      margin: 0;
      color: #221d18;
      font-size: clamp(1.9rem, 3.2vw, 3.2rem);
      line-height: 1.08;
      font-weight: 500;
    }

    .hero-copy p:not(.eyebrow),
    .intro-panel p {
      color: #675c52;
      line-height: 1.65;
      font-size: 1rem;
    }

    .primary-link {
      align-self: flex-start;
      margin-top: 1rem;
      border: 1px solid #b7a58f;
      background: #f4efe8;
      color: #3a2a1a;
      padding: 0.62rem 1rem;
      text-decoration: none;
      font-size: 0.82rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }

    .primary-link:hover {
      background: #eadfce;
      border-color: #8f7659;
      transform: translateY(-1px);
    }

    .intro-panel {
      max-width: 880px;
      margin: 1.25rem auto 2rem;
      padding: 0 1.25rem;
      text-align: center;
    }

    .archive-tools {
      max-width: 1180px;
      margin: 0 auto 1.5rem;
      padding: 1rem clamp(1rem, 3vw, 2rem);
      display: grid;
      grid-template-columns: minmax(220px, 280px);
      gap: 1rem;
      align-items: end;
      justify-content: end;
      border-top: 1px solid rgba(88, 72, 55, 0.13);
      border-bottom: 1px solid rgba(88, 72, 55, 0.13);
    }

    .sort-control span {
      display: block;
      margin-bottom: 0.55rem;
      color: #6d5b49;
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .sort-control select {
      border: 1px solid rgba(117, 96, 72, 0.28);
      background: #fffdf9;
      color: #47382a;
      min-height: 36px;
      font-family: "Glegoo", serif;
      font-size: 0.78rem;
    }

    .sort-control select {
      width: 100%;
      padding: 0.42rem 0.6rem;
    }

    .video-grid {
      max-width: 1180px;
      margin: 0 auto 3rem;
      padding: 0 clamp(1rem, 3vw, 2rem);
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .video-group-header {
      grid-column: 1 / -1;
      margin: 0.8rem 0 -0.15rem;
      padding: 0.55rem 0 0.35rem;
      border-top: 1px solid rgba(88, 72, 55, 0.18);
      color: #6c5946;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.13em;
    }

    :global(.video-card) {
      display: flex;
      flex-direction: column;
      min-height: 100%;
      overflow: hidden;
      border: 1px solid rgba(88, 72, 55, 0.16);
      background: #fffdf9;
      box-shadow: 0 10px 26px rgba(50, 38, 25, 0.06);
      border-radius: 8px;
    }

    :global(.video-card.type-card-movie-narrative),
    :global(.video-card[data-type-key="movie-narrative"]) {
      background: linear-gradient(180deg, #fffdf9 0%, #f1dfc8 100%) !important;
      border-color: rgba(128, 86, 45, 0.24);
    }

    :global(.video-card.type-card-short-reel),
    :global(.video-card[data-type-key="short-reel"]) {
      background: linear-gradient(180deg, #f6f5f1 0%, #e1e1da 100%) !important;
      border-color: rgba(85, 86, 79, 0.24);
    }

    :global(.video-card.type-card-process-bts),
    :global(.video-card[data-type-key="process-bts"]) {
      background: linear-gradient(180deg, #fffdf9 0%, #dfe7d6 100%) !important;
      border-color: rgba(78, 97, 64, 0.2);
    }

    :global(.video-card.type-card-artist-commentary),
    :global(.video-card[data-type-key="artist-commentary"]) {
      background: linear-gradient(180deg, #fffdf9 0%, #dfe5e7 100%) !important;
      border-color: rgba(70, 86, 100, 0.2);
    }

    :global(.video-card.type-card-show-event),
    :global(.video-card[data-type-key="show-event"]) {
      background: linear-gradient(180deg, #fffdf9 0%, #edcdb8 100%) !important;
      border-color: rgba(124, 69, 39, 0.2);
    }

    :global(.video-card.type-card-general),
    :global(.video-card[data-type-key="general"]) {
      background: linear-gradient(180deg, #fffdf9 0%, #e9e6df 100%) !important;
      border-color: rgba(88, 72, 55, 0.16);
    }

    :global(.thumb-link) {
      display: block;
      color: inherit;
      text-decoration: none;
    }

    :global(.thumb-wrap) {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: #e8e0d4;
    }

    :global(.thumb-wrap img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: saturate(0.82) contrast(1.02);
      transition: transform 0.28s ease;
    }

    :global(.video-card:hover .thumb-wrap img) {
      transform: scale(1.025);
    }

    :global(.play-mark) {
      width: 48px;
      height: 48px;
    }

    :global(.play-mark::before) {
      border-top-width: 9px;
      border-bottom-width: 9px;
      border-left-width: 14px;
    }

    :global(.thumb-fallback) {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      color: #6b5844;
      font-size: 2rem;
      letter-spacing: 0.18em;
      background: linear-gradient(135deg, #efe8dc, #d9cdbd);
    }

    :global(.card-body) {
      display: flex;
      flex: 1;
      flex-direction: column;
      padding: 1rem;
    }

    :global(.badge-row),
    :global(.meta-stack) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      align-items: center;
    }

    :global(.badge-row) {
      margin-bottom: 0.45rem;
    }

    :global(.meta-stack) {
      margin-bottom: 0.7rem;
    }

    :global(.badge) {
      border: 1px solid rgba(67, 51, 36, 0.15);
      padding: 0.18rem 0.48rem;
      font-size: 0.64rem;
      line-height: 1.35;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #3d342d;
      background: #eee8df;
    }

    :global(.type) {
      border-color: rgba(48, 39, 31, 0.2);
      color: #fff8ed;
      font-weight: 700;
    }

    :global(.type-full-video),
    :global(.type-narrated-film) {
      background: #6f3f25;
    }

    :global(.type-short),
    :global(.type-reel) {
      background: #8a742f;
    }

    :global(.type-process),
    :global(.type-behind-the-scenes) {
      background: #4f5845;
    }

    :global(.type-artist-talk) {
      background: #4b5363;
    }

    :global(.subject) {
      background: rgba(255, 253, 249, 0.72);
      color: #685747;
      font-size: 0.6rem;
    }

    :global(.featured) { background: #3d332a; color: #fff8ed; }

    :global(.date),
    :global(.runtime) {
      display: inline-flex;
      align-items: center;
      min-height: 1.45rem;
      margin: 0;
      color: #8c7a68;
      font-size: 0.72rem;
    }

    :global(.runtime) {
      border-left: 1px solid rgba(88, 72, 55, 0.18);
      padding-left: 0.5rem;
      color: #4f3d2d;
      font-weight: 700;
    }

    :global(.video-card h2) {
      margin: 0 0 0.65rem;
      font-size: 1.05rem;
      line-height: 1.35;
      font-weight: 500;
    }

    :global(.video-card h2 a) {
      color: #2d241c;
      text-decoration: none;
    }

    :global(.video-card h2 a:hover) {
      color: #7a3d28;
    }

    :global(.dek) {
      margin: 0;
      color: #665b51;
      font-size: 0.86rem;
      line-height: 1.65;
    }

    :global(.card-actions) {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      margin-top: auto;
      padding-top: 1rem;
      flex-wrap: wrap;
    }

    :global(.watch-label) {
      color: #5a4938;
      font-size: 0.76rem;
      font-weight: 700;
    }

    :global(.external-link) {
      color: #7a3d28;
      font-size: 0.78rem;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .no-results {
      max-width: 1180px;
      margin: -1rem auto 3rem;
      padding: 0 2rem;
      color: #6b5d50;
      text-align: center;
    }

    @media (max-width: 900px) {
      .video-hero,
      .archive-tools {
        grid-template-columns: 1fr;
      }

      .hero-media {
        min-height: 260px;
      }

      .video-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      .video-hero {
        padding-top: 0.75rem;
      }

      .video-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
