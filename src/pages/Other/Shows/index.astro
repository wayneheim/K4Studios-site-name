---
export const prerender = true;
import BaseLayout    from "@/layouts/BaseLayout.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter    from "@/components/Footer.astro";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";
import { normalizeImageSrc } from "@/utils/imageProxy.js";

import { stories } from "@/data/Other/Stories/stories.mjs";
import "@/styles/global.css";

// ----------------------
// Dynamic Logic
// ----------------------
const sectionPath = "/Other/Shows";
const requestOrigin = Astro.site?.origin ?? new URL(Astro.request.url).origin;
const toAbsoluteUrl = (value?: string | null): string => {
  if (!value) return "";
  try {
    const maybeUrl = new URL(value);
    return maybeUrl.toString();
  } catch {
    const normalized = value.startsWith("/") ? value : `/${value}`;
    return new URL(normalized, requestOrigin).toString();
  }
};

const visibleShows = (() => {
  const nonDemoShows = stories.filter((show) => show.slug !== "demo-show");
  const loreAndLegacyShow = nonDemoShows.find((show) => show.slug === "Lore-and-Legacy-Show");
  const loreAndLegacyChapters = nonDemoShows
    .filter((show) => /^Lore-and-Legacy-Chapter-\d+$/.test(show.slug))
    .sort((left, right) => {
      const leftChapter = Number(left.slug.split('-').pop() || 0);
      const rightChapter = Number(right.slug.split('-').pop() || 0);
      return leftChapter - rightChapter;
    });
  const otherShows = nonDemoShows.filter(
    (show) => show.slug !== "Lore-and-Legacy-Show" && !/^Lore-and-Legacy-Chapter-\d+$/.test(show.slug)
  );

  return [
    ...loreAndLegacyChapters,
    ...otherShows,
    ...(loreAndLegacyShow ? [loreAndLegacyShow] : [])
  ];
})();

const showCropBySlug: Record<string, string> = {
  // Tune these per show so heads and focal details stay in frame.
  "Lore-and-Legacy-Show": "50% 24%",
  "Lore-and-Legacy-Chapter-1": "50% 22%",
  "Lore-and-Legacy-Chapter-2": "50% 24%",
  "Lore-and-Legacy-Chapter-3": "50% 22%",
  "The-Cost-of-the-Journey": "50% 50%",
  "Sagebrush-Grit-and-Grace": "50% 30%",
  "Outlaws-and-Bandits": "50% 50%",
  "Western-Living-History": "50% 24%",
};

const showZoomBySlug: Record<string, number> = {
  // 1 = no zoom, 1.08 = slight zoom in, 1.15 = stronger zoom in.
  "Lore-and-Legacy-Show": 1.2,
  "Lore-and-Legacy-Chapter-1": 1.1,
  "Lore-and-Legacy-Chapter-2": 1.14,
  "Lore-and-Legacy-Chapter-3": 1.11,
  "The-Cost-of-the-Journey": 1,
  "Sagebrush-Grit-and-Grace": 1,
  "Outlaws-and-Bandits": 1,
  "Western-Living-History": 1,
};

const defaultCoverImage = visibleShows.length > 0 ? visibleShows[0].cover : "/images/K4-Stories-logo3b.gif";
const normalizedDefaultCoverImage = normalizeImageSrc(defaultCoverImage, "l");

const structuredData = getStructuredData({
  type: "BlogPosting",
  data: {
    headline: "K4 Studios Picture Shows",
    description: "Interactive picture shows and visual presentations showcasing Wayne Heim's fine art photography through immersive storytelling experiences.",
    url: toAbsoluteUrl(sectionPath),
    copyrightNotice: "© Wayne Heim",
    author: { "@type": "Person", name: "Wayne Heim" },
    image: toAbsoluteUrl(normalizedDefaultCoverImage),
    articleSection: "Visual Storytelling",
    keywords: ["picture shows", "interactive photography", "visual storytelling", "cinematic art", "Wayne Heim", "western fine art", "immersive presentations"],
    wordCount: 800
  },
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: toAbsoluteUrl("/copyright"),
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: toAbsoluteUrl("/")
  }
});

// ItemList structured data
const itemListStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "K4 Studios Picture Shows",
  description: "Interactive visual presentations and themed exhibitions by Wayne Heim, combining fine art photography with cinematic storytelling.",
  url: toAbsoluteUrl(sectionPath),
  creator: {
    "@type": "Person",
    name: "Wayne Heim",
    url: toAbsoluteUrl("/")
  },
  itemListElement: visibleShows.map((show, index) => ({
    "@type": "BlogPosting",
    position: index + 1,
    headline: show.title,
    url: toAbsoluteUrl(`/Other/Shows/${show.slug}`),
    datePublished:
      typeof show.date === "string" && /^\d{4}-\d{2}-\d{2}$/.test(show.date)
        ? `${show.date}T00:00:00Z`
        : show.date,
    image: toAbsoluteUrl(normalizeImageSrc(show.cover || defaultCoverImage, "l")),
    description: show.excerpt,
    author: {
      "@type": "Person",
      name: "Wayne Heim",
      url: toAbsoluteUrl("/")
    }
  }))
};

// Breadcrumb structured data
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: toAbsoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Shows", item: toAbsoluteUrl(sectionPath) }
  ]
};

const landingImgUrl = normalizedDefaultCoverImage;
const meta = getLandingMeta(sectionPath, landingImgUrl);
if (!meta.ogUrl) meta.ogUrl = toAbsoluteUrl(sectionPath);
if (!meta.twitterUrl) meta.twitterUrl = toAbsoluteUrl(sectionPath);

meta.description =
  "Experience interactive picture shows from Wayne Heim — immersive visual presentations combining fine art photography with cinematic storytelling. Discover themed collections and narrative-driven exhibitions.";
meta.keywords =
  "picture shows, interactive photography, visual presentations, fine art exhibitions, cinematic storytelling, Wayne Heim, themed collections, immersive art experiences";
meta.ogTitle = "K4 Studios Picture Shows – Interactive Visual Presentations by Wayne Heim";
meta.ogDescription =
  "Explore interactive picture shows featuring Wayne Heim's fine art photography — themed visual presentations that combine storytelling with immersive gallery experiences.";
meta.ogImage = toAbsoluteUrl(landingImgUrl);
meta.twitterCard = "summary_large_image";

---

<BaseLayout
  title="K4 Studios Picture Shows – Interactive Visual Presentations & Fine Art Photography by Wayne Heim"
  structuredDataJSON={structuredData}
  meta={meta}
>
  <main class="bg-white text-[#2c2c2c] min-h-screen overflow-x-hidden" style="font-family: 'Glegoo', serif;">
    <link rel="canonical" href={toAbsoluteUrl(sectionPath)} />

    <div class="page-container w-full max-w-[1200px] mx-auto px-4">
      <div class="drawer-mode">
        <LandingHeader client:load breadcrumb="Other › Shows" />
      </div>

      <section class="shows-hero mb-14">
        <div class="artifact-panel">
          <img
            src="/images/K4-Stories-logo3b.gif"
            alt="K4 Studios Picture Shows emblem"
            class="artifact-logo"
            oncontextmenu="event.preventDefault()"
          />
        </div>

        <div class="hero-narrative">
          <h1 class="hero-title">K4 Picture Shows</h1>
          <h2 class="hero-subtitle">
            <span class="hero-subtitle-line">Every image - a story unfinished.</span>
            <span class="hero-subtitle-line">Explore and see what the legends left out.</span>
          </h2>
          <div class="hero-copy">
            
            <p>
              Lives, stitched together in fragments. Moments that do not resolve… only gather.
              A fabric begins to form - threads of loss, discovery, and consequence knit into
              something larger than any one life.
            </p>
            <p>
              Pull it back, and you begin to see the legends - the lives, the losses, the hopes
              history moved too fast to name.
            </p>
          </div>
        </div>
      </section>

      <hr class="shows-divider" aria-hidden="true" />

      {visibleShows.length > 0 ? (
        <>
          <section class="shows-cta" style="font-family: 'Glegoo', serif;">
            <p class="shows-cta-lead">
              Explore curated cinematic presentations of Wayne Heim's Western fine art photography, writings, and narrative voices. A beginning waits in every direction. Choose a card and start your journey.
            </p>
          </section>

          <section id="shows-deck" class="shows-deck mb-24" style="font-family: 'Glegoo', serif;">
          {visibleShows.map((show, showIndex) => (
            <article class="show-face k4-card">
              <div class="show-face-inner">
                <div class="face-topline">
                  <span class="face-index">{String(showIndex + 1).padStart(2, '0')}</span>
                </div>

                <a href={`/Other/Show/${show.slug}`} aria-label={show.title} class="show-thumb-link" data-show-slug={show.slug}>
                  <img
                    src={normalizeImageSrc(show.cover, 'm')}
                    alt={show.alt || show.title}
                    class="show-thumb"
                    style={`object-position: ${showCropBySlug[show.slug] || '50% 22%'}; --thumb-zoom: ${showZoomBySlug[show.slug] || 1};`}
                    oncontextmenu="event.preventDefault()"
                  />
                </a>

                <h3 class="face-title">
                  <a href={`/Other/Show/${show.slug}`} data-show-slug={show.slug}>{show.title}</a>
                </h3>
                <p class="face-date">{show.date}</p>
                <p class="face-excerpt">{show.excerpt}</p>

                <div class="face-cta-row">
                  <a href={`/Other/Show/${show.slug}`} class="k4-play-btn" aria-label={`View show ${show.title}`} data-show-slug={show.slug}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </a>
                  <a href={`/Other/Show/${show.slug}`} class="face-cta-text" data-show-slug={show.slug}>View Show</a>
                </div>
              </div>
            </article>
          ))}
          </section>
        </>
      ) : (
        <section class="coming-soon text-center max-w-4xl mx-auto px-4 mb-16">
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-8 shadow-sm">
            <h3 class="text-2xl font-bold mb-4 text-gray-800">Coming Soon</h3>
            <p class="text-lg text-gray-600 mb-6">
              The Picture Shows section is currently under development. Interactive visual presentations and themed exhibitions will be available here soon.
            </p>
            <p class="text-sm text-gray-500">
              Check back for updates on new interactive shows featuring Wayne Heim's fine art photography.
            </p>
          </div>
        </section>
      )}

      {visibleShows.length > 0 && (
        <script type="application/ld+json" set:html={JSON.stringify(itemListStructuredData)}></script>
      )}
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)}></script>

      <script is:inline>
        (() => {
          if (typeof window === "undefined" || typeof document === "undefined") return;

          const FORCED_NAV_DEDUPE_MS = 1500;
          let lastForcedNavHref = "";
          let lastForcedNavAt = 0;

          const resolveShowAnchor = (event) => {
            const target = event?.target;
            const anchor = target && target.closest ? target.closest("a[data-show-slug]") : null;
            if (!anchor) return null;

            const slug = anchor.getAttribute("data-show-slug");
            if (!slug) return null;

            if (anchor.hasAttribute("download")) return null;
            if (anchor.target && anchor.target !== "_self") return null;

            const href = anchor.getAttribute("href") || `/Other/Show/${slug}`;
            const absoluteHref = href.startsWith("http") ? href : new URL(href, window.location.origin).toString();

            return {
              anchor,
              slug,
              showPath: `/Other/Show/${slug}`,
              href: absoluteHref
            };
          };

          const emitShowEvent = (eventType, payload, pixelLayer) => {
            try {
              if (typeof window.k4track === "function") {
                window.k4track(eventType, payload);
              }

              if (typeof window.k4emitActionPixel === "function") {
                window.k4emitActionPixel(eventType, null, {
                  galleryId: payload.galleryId,
                  pageType: payload.pageType,
                  sourceLayer: pixelLayer,
                  trigger: payload.trigger
                });
              }
            } catch (_) {
              // Keep navigation resilient if analytics helper is unavailable.
            }
          };

          const onShowClick = (event) => {
            const resolved = resolveShowAnchor(event);
            if (!resolved) return;

            // Suppress duplicate synthetic click after a forced touch fallback navigation.
            if (
              resolved.href === lastForcedNavHref &&
              Date.now() - lastForcedNavAt < FORCED_NAV_DEDUPE_MS
            ) {
              return;
            }

            emitShowEvent(
              "picture_show_click",
              {
                targetId: resolved.slug,
                galleryId: resolved.showPath,
                pageType: "gallery",
                trigger: "shows_index_click"
              },
              "picture_show_click_pixel_v1"
            );
          };

          const onTouchActivation = (event, trigger) => {
            const resolved = resolveShowAnchor(event);
            if (!resolved) return;
            if (event.defaultPrevented) return;

            emitShowEvent(
              "picture_show_tap",
              {
                targetId: resolved.slug,
                galleryId: resolved.showPath,
                pageType: "gallery",
                trigger
              },
              "picture_show_tap_pixel_v1"
            );

            lastForcedNavHref = resolved.href;
            lastForcedNavAt = Date.now();

            try {
              event.preventDefault();
            } catch (_) {
              // Some event shapes may be non-cancelable; fallback still applies.
            }

            emitShowEvent(
              "picture_show_nav_fallback",
              {
                targetId: resolved.slug,
                galleryId: resolved.showPath,
                pageType: "gallery",
                trigger: `${trigger}_nav_fallback`
              },
              "picture_show_nav_fallback_pixel_v1"
            );

            window.location.assign(resolved.href);
          };

          document.addEventListener("click", onShowClick, { capture: true });

          if ("PointerEvent" in window) {
            document.addEventListener(
              "pointerup",
              (event) => {
                if (event.pointerType !== "touch" && event.pointerType !== "pen") return;
                onTouchActivation(event, "shows_index_pointerup_touch");
              },
              { capture: true }
            );
          } else {
            document.addEventListener(
              "touchend",
              (event) => {
                if (event.touches && event.touches.length > 1) return;
                onTouchActivation(event, "shows_index_touchend");
              },
              { capture: true, passive: false }
            );
          }
        })();
      </script>

      <div class="shows-footer-gap" aria-hidden="true"></div>
    </div>

    <SiteFooter
      title="K4 Studios Picture Shows - Interactive Visual Presentations"
      label="Explore Galleries"
      class="pt-8 pb-12"
    />

    <style>
      .shows-hero {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        max-width: 1100px;
        margin: 1.2rem auto 1.8rem;
      }

      .artifact-panel,
      .hero-narrative {
        padding: 0.5rem 0;
      }

      .shows-divider {
        width: 100%;
        max-width: 900px;
        height: 4px;
        border: 0;
        margin: 0.75rem auto 1.5rem;
        background: linear-gradient(to right, transparent, #c5b39f 8%, #b89f85 50%, #c5b39f 92%, transparent);
        border-radius: 999px;
      }

      .shows-cta {
        max-width: 900px;
        margin: 0 auto 2.2rem;
        text-align: center;
      }

      .shows-cta p {
        margin: 0;
        color: #5d4a38;
        font-size: 1.08rem;
        line-height: 1.32;
      }

      .shows-cta-lead {
        margin-bottom: 0.5rem !important;
        color: #594636;
      }

      .shows-cta a {
        color: #8b5a2b;
        text-decoration: underline;
        text-underline-offset: 2px;
        margin-left: 0.25rem;
        font-weight: 700;
      }

      .shows-cta a:hover {
        color: #6f4322;
      }

      .shows-footer-gap {
        height: 6rem;
      }

      .artifact-panel {
        display: grid;
        place-items: center;
        text-align: center;
        min-height: 0;
        background: transparent;
      }

      .artifact-logo {
        width: min(75%, 295px);
        height: auto;
        filter: none;
      }

      .hero-narrative {
        text-align: left;
        background: transparent;
      }

      .hero-kicker {
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: #8a694a;
        font-size: 0.78rem;
      }

      .hero-title {
        margin: 0.4rem 0 0;
        font-size: clamp(2rem, 4vw, 3.05rem);
        line-height: 1;
        color: #3a2a1a;
        opacity: 0.57;
      }

      .hero-subtitle {
        margin: 0.7rem 0 0;
        font-size: clamp(1.05rem, 2.2vw, 1.35rem);
        line-height: 1.45;
        color: #5e4a39;
        font-weight: 600;
      }

      .hero-subtitle-line {
        display: block;
      }

      .hero-subtitle-line + .hero-subtitle-line {
        margin-top: 0.22rem;
      }

      .hero-copy {
        margin-top: 1rem;
        display: grid;
        gap: 0.7rem;
        font-size: 1.02rem;
        line-height: 1.32;
        color: #4d3a2a;
      }

      .hero-copy p {
        margin: 0;
      }

      .shows-deck {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1.15rem;
        max-width: 1100px;
        margin: 0 auto;
      }

      .show-face {
        padding: 0;
        width: 100%;
        max-width: 345px;
        justify-self: center;
        height: 100%;
        background-color: #f3ecdf;
      }

      .show-face-inner {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        padding: 1.5rem;
        min-height: 456px;
      }

      .face-topline {
        display: flex;
        justify-content: flex-end;
        align-items: baseline;
      }

      .face-index {
        font-size: 1rem;
        font-weight: 700;
        color: #704f32;
      }

      .show-thumb-link {
        display: block;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 12px rgba(68, 48, 30, 0.22);
        margin: 0.15rem 0 0.2rem;
      }

      .show-thumb {
        width: 100%;
        height: 186px;
        object-fit: cover;
        transform: scale(var(--thumb-zoom, 1));
        transform-origin: center;
        display: block;
      }

      .face-title {
        margin: 0.35rem 0 0;
        font-size: 1.15rem;
        text-align: center;
        line-height: 1.24;
        color: #392919;
        min-height: 2.95rem;
      }

      .face-title a {
        color: inherit;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .face-title a:hover {
        color: #7f2f1f;
      }

      .face-date {
        margin: 0;
        color: #6f5944;
        font-size: 0.87rem;
        letter-spacing: 0.03em;
      }

      .face-excerpt {
        margin: 0;
        color: #4f3f2f;
        line-height: 1.48;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .face-cta-row {
        display: flex;
        align-items: center;
        gap: 0.72rem;
        margin-top: 0.35rem;
      }

      .face-cta-text {
        color: #a39182;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-decoration: none;
      }

      .face-cta-text:hover {
        color: #9a3d1f;
      }

      a[data-show-slug],
      .k4-play-btn,
      .face-cta-text {
        touch-action: manipulation;
        -webkit-tap-highlight-color: rgba(139, 90, 43, 0.22);
      }

      @media (min-width: 900px) {
        .shows-hero {
          grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.3fr);
          align-items: stretch;
          margin-bottom: 2rem;
        }

        .artifact-panel {
          min-height: 100%;
        }

        .shows-deck {
          grid-template-columns: repeat(2, minmax(280px, 345px));
          justify-content: center;
          gap: 1.35rem;
        }
      }

      @media (min-width: 1220px) {
        .shows-deck {
          grid-template-columns: repeat(3, minmax(280px, 345px));
          justify-content: center;
        }
      }

      @media (max-width: 767px) {
        html, body {
          overflow-x: hidden !important;
          width: 100% !important;
          box-sizing: border-box;
        }
        main {
          overflow-x: hidden !important;
          max-width: 100vw !important;
        }
        .page-container {
          padding-left: 1rem !important;
          padding-right: 1rem !important;
        }
        .shows-hero,
        .shows-divider,
        .shows-cta,
        .shows-deck,
        .coming-soon {
          margin-left: auto !important;
          margin-right: auto !important;
          max-width: 100% !important;
        }

        .shows-hero {
          display: grid;
          grid-template-columns: minmax(108px, 39%) minmax(0, 1fr);
          align-items: start;
          column-gap: 0.8rem;
          row-gap: 0.45rem;
        }

        .hero-narrative {
          display: contents;
        }

        .artifact-panel {
          grid-column: 1;
          grid-row: 1;
          place-items: start;
          text-align: left;
          padding-top: 0.1rem;
        }

        .hero-subtitle {
          grid-column: 2;
          grid-row: 1;
          align-self: center;
          margin: 0.3rem 0 0;
          padding-left: 0.62rem;
          border-left: 2px solid #bca58d;
          font-size: 1rem;
          line-height: 1.3;
          font-style: italic;
          color: #554131;
          font-weight: 600;
        }

        .hero-title {
          grid-column: 1 / -1;
          grid-row: 2;
          margin: 0.28rem 0 0;
          text-align: center;
          font-size: clamp(1.85rem, 8.2vw, 2.25rem);
        }

        .hero-copy {
          grid-column: 1 / -1;
          grid-row: 3;
          margin-top: 0.4rem;
          gap: 0.55rem;
          font-size: 0.98rem;
          line-height: 1.32;
        }

        .shows-divider {
          height: 3px;
          margin: 0.65rem auto 1.25rem;
        }

        .shows-cta {
          margin: 0 auto 1.7rem;
        }

        .shows-cta p {
          font-size: 1rem;
          line-height: 1.32;
        }

        .shows-cta-lead {
          margin-bottom: 0.45rem !important;
        }

        .shows-footer-gap {
          height: 6rem;
        }

        .show-face {
          max-width: 100%;
        }

        .show-face-inner {
          min-height: 0;
          padding: 1.35rem;
        }

        .face-title {
          line-height: 1.2;
        }

        .face-excerpt {
          line-height: 1.4;
        }

        img {
          max-width: 100% !important;
          height: auto !important;
        }

        /* Keep show thumbnails at a fixed frame on mobile so card heights stay stable. */
        .show-thumb-link {
          width: 100%;
          height: 310px;
        }

        .show-thumb {
          width: 100% !important;
          height: 310px !important;
          max-width: none !important;
          object-fit: cover;
          transform: scale(var(--thumb-zoom, 1));
          transform-origin: center;
        }

        .artifact-logo {
          width: min(100%, 170px);
        }
      }
    </style>
  </main>
</BaseLayout>
