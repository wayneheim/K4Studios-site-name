---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PictureShowBase from "@/components/PictureShowBase.jsx";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { storyMeta, storyData } from "@/data/Other/Stories/Builder-Test-v3.mjs"; // 👈 dynamically replaced when saving

// ===== Dynamic Metadata Pull =====
const pageTitle = storyMeta?.showTitle
  ? `${storyMeta.showTitle} | Picture Show | Wayne Heim Fine Art Photography`
  : "Untitled Picture Show | Picture Show | Wayne Heim Fine Art Photography";

const pageDescription =
  storyMeta?.description ||
  "A cinematic fine art story told through painterly photography by Wayne Heim.";

const ogImage =
  Array.isArray(storyData) && storyData.length > 0
    ? storyData[0].src
    : "/og/painterly.jpg";

// ===== SEO + Social Metadata =====
const meta = {
  description: pageDescription,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogImage,
  ogType: "website",
  twitterCard: "summary_large_image",
  twitterTitle: pageTitle,
  twitterDescription: pageDescription,
  twitterImage: ogImage
};

// ===== Structured Data for Search Engines =====
const structuredData = getStructuredData({
  type: "gallery",
  data: { title: pageTitle, description: pageDescription },
  images: Array.isArray(storyData) ? storyData : []
});
---

<BaseLayout title={pageTitle} meta={meta} structuredDataJSON={structuredData}>
  <div id="picture-show-content" class="relative z-10 bg-white min-h-screen">
    <PictureShowBase
      client:only="react"
      rawData={Array.isArray(storyData) ? storyData : []}
      basePath="/Other/Stories/Builder-Test-v3"
      titleBase={storyMeta?.showTitle || "Untitled Picture Show"}
      globalAudioSrc={storyMeta?.globalAudioSrc || ""}
      globalAudioMode={storyMeta?.globalAudioMode || "score"}
      introText={storyMeta?.intro || ""}
      closingText={storyMeta?.closingText || ""}
    />
  </div>

  <style>
    #picture-show-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  </style>
</BaseLayout>
