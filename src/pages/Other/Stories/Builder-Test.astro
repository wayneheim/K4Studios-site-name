---
export const prerender = true;
// Auto-generated Astro page for Builder-Test
import BaseLayout from "@/layouts/BaseLayout.astro";
import PictureShowBase from "@/components/PictureShowBase.jsx";
import { storyMeta, storyData } from "@/data/Other/Stories/Builder-Test.mjs";
--- 

<BaseLayout title={storyMeta.showTitle}>
  <PictureShowBase
    client:load
    rawData={storyData}
    basePath="/Other/Stories/Builder-Test"
    titleBase={storyMeta.showTitle}
    globalAudioSrc={storyMeta.globalAudioSrc || ""}
    globalAudioMode={storyMeta.globalAudioMode || "score"}
  />
</BaseLayout>