---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PictureShowBase from "@/components/PictureShowBase.jsx";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { storyData } from "@/data/Other/Stories/DemoShow.mjs";

const pageTitle = "The Wayward Trail | Picture Show | Wayne Heim Fine Art Photography";
const pageDescription = "A cinematic mini-story told through five painterly photographs by Wayne Heim.";
const ogImage = Array.isArray(storyData) && storyData.length > 0 ? storyData[0].src : "/og/painterly.jpg";

const meta = {
  description: pageDescription,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogImage,
  ogType: "website",
  twitterCard: "summary_large_image",
  twitterTitle: pageTitle,
  twitterDescription: pageDescription,
  twitterImage: ogImage
};

const structuredData = getStructuredData({
  type: "gallery",
  data: { title: pageTitle, description: pageDescription },
  images: Array.isArray(storyData) ? storyData : []
});
---

<BaseLayout title={pageTitle} meta={meta} structuredDataJSON={structuredData}>
  <div id="picture-show-content" class="relative z-10 bg-white min-h-screen">
    <PictureShowBase
      client:load
      rawData={Array.isArray(storyData) ? storyData : []}
      basePath="/Other/Stories/DemoShow"
      titleBase="The Wayward Trail"
    />
  </div>

  <style>
    #picture-show-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  </style>
</BaseLayout>
