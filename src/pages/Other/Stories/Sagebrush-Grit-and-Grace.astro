---
export const prerender = true;
// Auto-generated Astro page for Sagebrush-Grit-and-Grace
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSemanticImageUrl } from "@/utils/imageProxy.js";
import PictureShowBase from "@/components/PictureShowBase.jsx";
import { sanitizeStoryShowData } from "@/components/utils/sanitizeStoryShowData.ts";
import { storyMeta, storyData } from "@/data/Other/Stories/Sagebrush-Grit-and-Grace.mjs";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { normalizeImageSrc } from "@/utils/imageProxy.js";

// Proxy URL helper - ensures SmugMug URLs never appear in SSR HTML
function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return getSemanticImageUrl(imageId, {}, size);
}

const sectionPath = "/Other/Show/Sagebrush-Grit-and-Grace";
const coverImg = storyData.find(s => s.visibility !== "ghost") || storyData[0];
const coverImage = coverImg?.id ? `https://www.k4studios.com${getProxySrc(coverImg.id, 'l')}` : "/images/K4-Stories logo1b.webp";
const noscriptImage = normalizeImageSrc(
  coverImg?.id || coverImg?.srcS || coverImg?.srcM || coverImg?.src || coverImg?.srcL || "/images/K4-Stories logo1b.webp",
  "l"
);

const meta = {
  description: storyMeta.description,
  keywords: storyMeta.keywords,
  ogTitle: `${storyMeta.showTitle} – K4 Picture Show`,
  ogDescription: storyMeta.description,
  ogImage: coverImage,
  ogType: "video.other",
  ogUrl: `https://www.k4studios.com${sectionPath}`,
  twitterCard: "summary_large_image",
  twitterTitle: `${storyMeta.showTitle} – Picture Show by Wayne Heim`,
  twitterDescription: storyMeta.description,
  twitterImage: coverImage
};

const structuredDataJSON = getStructuredData({
  type: "gallery",
  data: {
    title: storyMeta.showTitle,
    description: storyMeta.description,
    url: `https://www.k4studios.com${sectionPath}`,
    keywords: storyMeta.keywords,
    copyrightNotice: "© Wayne Heim, k4studios.com. All rights reserved."
  },
  images: storyData,
  defaults: {
    copyrightNotice: "© Wayne Heim, k4studios.com. All rights reserved.",
    license: "https://www.k4studios.com/licensing",
    acquireLicensePage: "https://www.k4studios.com/licensing",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://www.k4studios.com/"
  }
});
---

<BaseLayout title={storyMeta.showTitle} meta={meta} structuredDataJSON={structuredDataJSON}>
  <p class="sr-only">{storyMeta.showTitle} – Picture Show by Wayne Heim</p>
  <noscript>
    <img
      src={noscriptImage}
      alt={`${storyMeta.showTitle} - Cinematic Picture Show`}
      style="width:100%;height:auto;display:block;"
    />
  </noscript>
  <PictureShowBase
    client:load
    rawData={sanitizeStoryShowData(storyData)}
    basePath="/Other/Show/Sagebrush-Grit-and-Grace"
    titleBase={storyMeta.showTitle}
    globalAudioSrc={storyMeta.globalAudioSrc || ""}
    globalAudioMode={storyMeta.globalAudioMode || "score"}
    introMeta={storyMeta.introMeta || {}}
    outroMeta={storyMeta.outroMeta || {}}
  />
</BaseLayout>
