---
export const prerender = false;

import GalleryShell from '@/components/GalleryShell-Archive.astro';
import { entranceData as ArchiveEntranceData } from "@/data/Other/Archive/ArchiveEntranceData.ts";
import { galleryData } from '@/data/Other/Archive/Archive.mjs';
import { getImageMeta } from '@/components/utils/getImageMeta.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';

import imageIdMap from '@/data/imageIdMap.json';
import { isBot } from '@/utils/isBot';
import { cleanRedirect } from '@/utils/cleanRedirect';

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);

// Check if image is missing OR hidden (archived images stay in gallery with visibility: "hidden")
const isHidden = imageData?.visibility === 'hidden' || imageData?.visibility === 'hide';
const userAgent = Astro.request.headers.get('user-agent');
const isBadId = (!imageData || isHidden) && (id && (id.startsWith('i-') || id === 'i'));
if (isBadId) {
  // Smart 404: Check if image exists in another gallery (e.g., Archive)
  const correctGalleryPath = (imageIdMap as Record<string, string>)[id];
  if (correctGalleryPath) {
    // Image found elsewhere - 301 redirect to preserve SEO
    return cleanRedirect(`${correctGalleryPath}/${id}`, 301);
  }
  // Not found anywhere - return proper status
    if (isBot(userAgent)) {
      // Bots get 410 Gone so they can de-index the URL
      return new Response('Gone', { status: 410, headers: { 'X-Robots-Tag': 'noindex' } });
    }
    // Humans get redirected to gallery landing for better UX
    let cleanUrl = Astro.url.pathname.replace(/\/i[^/]*\/?$/, '');
    cleanUrl = cleanUrl.replace(/\/+$/, '');
    return cleanRedirect(cleanUrl, 302);
}

// Ensure absolute URL (don't prepend if already absolute)
function makeAbsoluteUrl(src) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) {
    return src;
  }
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

const imgUrl = imageData ? makeAbsoluteUrl(imageData.src) : "";

// Get parent gallery meta, override with correct image URL
const parentMeta = getLandingMeta("/Other/Archive", imgUrl);

const meta = imageData 
  ? getImageMeta(id, [{ images: galleryData, meta: parentMeta }], parentMeta)
  : parentMeta;
---

<GalleryShell 
  breadcrumb={ArchiveEntranceData.breadcrumb} 
  entranceData={ArchiveEntranceData}
  initialImageId={id}
  currentImageUrl={imgUrl}
  title={meta?.title || "Archive"}
/>
