---
export const prerender = true;
import BaseLayout    from "@/layouts/BaseLayout.astro";
import { getSemanticImageUrl } from "@/utils/imageProxy.js";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter    from "@/components/Footer.astro";
import StorySlider   from "@/components/StorySlider.tsx";
import { getStructuredData, getBreadcrumbList } from "@/components/utils/getStructuredData.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";

import { oneImageMoviePage } from "@/data/Other/One-Image-Movie/story.ts";
import { galleryData as painterlyImages } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { autoLinkKeywordsInText } from "@/components/utils/autoLinkKeywordsInText.ts";
import { semantic as k4Semantic } from "@/data/semantic/K4-Sem.ts";
import {
  galleryDataMap,
  allImages
} from "@/data/galleryMaps/MasterGalleryData.mjs";
import { storySliderImageIds } from '@/data/storySlider.ts';
import "@/styles/global.css";

// Proxy URL helper - ensures SmugMug URLs never appear in SSR HTML
function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return getSemanticImageUrl(imageId, {}, size);
}

// ----------------------
// Dynamic Logic
// ----------------------
const sectionPath = "/Other/One-Image-Movie";

// Build structured data with Article + DefinedTerm schema
const structuredData = getStructuredData({
  type: "Article",
  data: {
    title: oneImageMoviePage.title,
    headline: oneImageMoviePage.title,
    description: "A One-Image Movie is a single photograph constructed to function as a complete narrative moment—suggesting a beginning, middle, and end within one frame. Wayne Heim created the concept as a form of narrative photography and fine art storytelling.",
    url: `https://k4studios.com${sectionPath}`,
    articleSection: "Fine Art Photography Concepts",
    keywords: [
      "One-Image Movie",
      "One-Image Movie™",
      "single-frame narrative",
      "cinematic fine art photography",
      "painterly photography",
      "visual storytelling",
      "fine art storytelling",
      "Wayne Heim",
      "K4 Studios"
    ],
    copyrightNotice: "© Wayne Heim",
    datePublished: "2025-12-11",
    definedTerm: {
      name: "One-Image Movie",
      description: "A One-Image Movie is a single photograph constructed to function as a complete narrative moment—containing the suggestion of a beginning, middle, and end within one frame. Rather than documenting a scene, it implies a larger story through gesture, atmosphere, and unresolved tension, inviting the viewer to complete the narrative.",
      termSet: "https://k4studios.com/Glossary"
    },
    faqItems: [
      {
        question: "What is a One-Image Movie?",
        answer: "A One-Image Movie is a single photograph constructed to function as a complete narrative moment—containing the suggestion of a beginning, middle, and end within one frame. Rather than documenting a scene, it implies a larger story through gesture, atmosphere, and unresolved tension, inviting the viewer to complete the narrative."
      },
      {
        question: "What makes a One-Image Movie different from regular photography?",
        answer: "A One-Image Movie features character-driven storytelling built on gesture, posture, and expression; lighting and composition inspired by classical painting and modern cinema; narrative cues that hint at unseen events before and after the image; and painterly depth that transforms realism into mythology."
      },
      {
        question: "What is a Picture Show?",
        answer: "A Picture Show is the expanded narrative form of the One-Image Movie philosophy. Picture Shows weave multiple images into a thematic, cinematic journey, each frame acting as a chapter in a larger visual narrative—enhanced with written chapter stories, voice-over narration, and sound design."
      }
    ]
  },
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

// Use first painterly image as OG image
const landingImg = painterlyImages.find(img => img.visibility !== "ghost");
const landingImgUrl = landingImg?.id ? `https://www.k4studios.com${getProxySrc(landingImg.id, 'l')}` : '';
const meta = getLandingMeta(sectionPath, landingImgUrl);
if (!meta.ogUrl)      meta.ogUrl      = `https://k4studios.com${sectionPath}`;
if (!meta.twitterUrl) meta.twitterUrl = `https://k4studios.com${sectionPath}`;

// Prepare gallery preview images
function shuffleArray<T>(arr: T[]): T[] {
  return arr
    .map(value => ({ value, sort: Math.random() }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ value }) => value);
}

const visibleImages = painterlyImages.filter(img => img.visibility !== "ghost");
const galleryBasePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color";
const previewImages = shuffleArray(visibleImages).slice(0, 6).map(img => ({
  ...img,
  galleryPath: galleryBasePath.replace(/^\//, "") // remove leading slash for BlogGalleryPreviewStrip
}));
const previewPath = galleryBasePath;

// Setup for keyword linking
const galleryDatas = Object.values(galleryDataMap).flat();
const featheredImages = allImages.filter(img => (img as any).visibility !== "ghost").slice(0, 12);
const galleryPaths = Object.keys(galleryDataMap);

// Prepare data for StorySlider
const storySliderData = painterlyImages
  .filter((img: any) => storySliderImageIds.includes(img.id))
  .map((img: any) => ({ id: img.id, title: img.title, story: img.story }));

const topConceptImage = {
  id: "i-trZrk2w",
  title: "Night Raid",
  src: getProxySrc("i-trZrk2w", "l"),
  href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-trZrk2w",
  alt: "One-Image Movie example: frontier riders scanning the night in a rocky canyon, holding the story in suspense"
};

const bodyConceptImages = [
  {
    id: "i-HBRmWg4",
    sectionIndex: 0,
    title: "Cough and Covenant",
    label: "Pressure Before",
    src: getProxySrc("i-HBRmWg4", "l"),
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-HBRmWg4",
    alt: "One-Image Movie example: frontier figures in a tense night scene, implying immediate off-frame consequence",
    caption: "The frame arrives after something started and before anything resolves.",
    side: "left"
  },
  {
    id: "i-JKnW497",
    sectionIndex: 1,
    title: "Wounded: Blood on the Bandolier",
    label: "Held Frame",
    src: getProxySrc("i-JKnW497", "l"),
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-JKnW497",
    alt: "One-Image Movie example: vaquero with bandolier clutching a wound, head lowered in a tense frontier moment",
    caption: "The story is not narrated. It is held in tension.",
    side: "right"
  },
  {
    id: "i-LBSWzcj",
    sectionIndex: 2,
    title: "What have we here? A cowboy's dilemma.",
    label: "After Echo",
    src: getProxySrc("i-LBSWzcj", "l"),
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-LBSWzcj",
    alt: "Cowboy sitting at a wooden table drinking from a cup while a frontier woman offers a jar inside a canvas tent.",
    caption: "What comes next belongs to the viewer, not the caption.",
    side: "left"
  },
  {
    id: "i-LL2Gp5r",
    sectionIndex: 5,
    title: "Special Delivery",
    label: "Unseen Arrival",
    src: getProxySrc("i-LL2Gp5r", "l"),
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-LL2Gp5r",
    alt: "One-Image Movie example: figures confronting a halted night train in fog, loaded with implied consequence",
    caption: "A frame can announce a turning point without explaining it.",
    side: "right"
  },
  {
    id: "i-89qzJ6S",
    sectionIndex: 7,
    title: "Open Country Brothers",
    label: "Shared History",
    src: getProxySrc("i-89qzJ6S", "l"),
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-89qzJ6S",
    alt: "One-Image Movie example with Native and frontier figures sharing a horizon, carrying layered story beyond the frame",
    caption: "Some stories are held between people, not just inside one pose.",
    side: "left"
  },
  {
    id: "i-NDnxRkx",
    sectionIndex: 9,
    title: "Outlaw Watch",
    label: "Implied Consequence",
    src: getProxySrc("i-NDnxRkx", "l"),
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-NDnxRkx",
    alt: "One-Image Movie example: tense frontier watch scene where action is withheld and consequence is imminent",
    caption: "Narrative tension often peaks before visible action begins.",
    side: "right"
  },
  {
    id: "i-7VWX9vk",
    sectionIndex: 11,
    title: "One Way Out",
    label: "Forward Motion",
    src: getProxySrc("i-7VWX9vk", "l"),
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-7VWX9vk",
    alt: "One-Image Movie example: rider and horse crossing burned terrain, implying what was lost and what must follow",
    caption: "The strongest stills feel like continuation, not conclusion.",
    side: "left"
  }
];

// Breadcrumb structured data
const breadcrumbData = getBreadcrumbList([
  { name: "Home", item: "https://k4studios.com/" },
  { name: "Other", item: "https://k4studios.com/Other" },
  { name: "What Is a One-Image Movie?", item: `https://k4studios.com${sectionPath}` }
]);

---

<BaseLayout
  title={`${oneImageMoviePage.title} – K4 Studios`}
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbData}
  meta={meta}
>
  <div class="bg-white text-[#2c2c2c] min-h-screen overflow-x-hidden" style="font-family: 'Glegoo', serif;">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb="Other › One-Image Movie" />
    </div>

    <!-- Page Header -->
    <section class="section-heading-wrap" style="margin: 2.5rem 0 3.25rem;">
      <div class="section-heading">
        <h1 class="page-title" style="font-family: 'Glegoo', serif; font-size: 2.2rem; font-weight: 600; letter-spacing: -0.02em;">
          {oneImageMoviePage.title}
        </h1>
        <h2 class="page-subtitle" style="font-family: 'Glegoo', serif; font-size: 1.1rem; font-weight: 400; color: #8b6914; margin-top: 0.75rem;">
          {oneImageMoviePage.subtitle}
        </h2>
      </div>
    </section>

    <!-- One-Image Movie Visual Concept Bridge -->
    <section class="one-image-movie-bridge">
      <div class="one-image-movie-bridge__shell">

        <a href={topConceptImage.href} class="one-image-movie-hero">
          <img src={topConceptImage.src} alt={topConceptImage.alt} loading="eager" />
        </a>

        <div class="one-image-movie-bridge__text">
          <h2>A One-Image Movie™ does not explain the story. <br>It releases it.</h2>
          <p>The image holds one visible moment, but the viewer feels the pressure of what came before and what may happen next. That unresolved space is where the story begins to move.
          </p>
        </div>
      </div>
    </section>

    <section class="story-layout" style="font-family: 'Glegoo', serif;">
      <div class="text-column story-section" style="max-width: 860px; margin: 0 auto; padding: 0 1.5rem; line-height: 1.3;">
        {oneImageMoviePage.sections.map((section, index) => (
          <article class="story-block" style="margin-bottom: 2.5rem;">
            <h2 style="font-weight: 500; font-size: 1.65rem; margin-bottom: 0.55rem;">{section.subhead}</h2>

            {(() => {
              const sectionAside = bodyConceptImages.find((image) => image.sectionIndex === index);
              return sectionAside ? (
                <aside class={`inline-art-callout inline-art-callout--${sectionAside.side}`}>
                  <a href={sectionAside.href}>
                    <img src={sectionAside.src} alt={sectionAside.alt} loading="lazy" />
                  </a>
                  <p><strong>{sectionAside.label}:</strong> {sectionAside.caption}</p>
                </aside>
              ) : null;
            })()}
            
            {section.bullets && (
              <ul style="padding-left: 1.4rem; margin-top: 0.5rem; list-style-type: disc;">
                {section.bullets.map((bullet) => (
                  <li style="margin-bottom: 0.5rem; font-size: 1rem; list-style-type: disc;">{bullet}</li>
                ))}
              </ul>
            )}
            
            {section.paragraphs?.map((para) => (
              <p style="line-height: 1.6; margin-bottom: 1rem; font-size: 1.01rem;" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
            ))}
            
            {/* Insert StorySlider after first section (intro) */}
            {index === 0 && (
              <div class="story-slider-wrapper mt-8 mb-6">
                {/* Skeleton placeholder to prevent CLS */}
                <div class="story-slider-skeleton relative bg-[#ebe5dc] rounded-lg shadow-md px-6 py-5 max-w-2xl mx-auto border-2 border-[#d8d0c4] mb-12 h-[280px] overflow-hidden">
                  <div class="absolute top-2.5 left-2.5 w-3.5 h-3.5 border-l-2 border-t-2 border-[#c8bfb0]"></div>
                  <div class="absolute bottom-2.5 right-2.5 w-3.5 h-3.5 border-r-2 border-b-2 border-[#c8bfb0]"></div>
                  <p class="text-[11px] uppercase tracking-[0.12em] text-[#8c7d6b] mb-3">One-Image Movie™ Preview</p>
                  <div class="animate-pulse">
                    <div class="h-5 bg-[#d8d0c4] rounded w-3/4 mb-3"></div>
                    <div class="h-4 bg-[#d8d0c4] rounded w-full mb-2"></div>
                    <div class="h-4 bg-[#d8d0c4] rounded w-5/6 mb-2"></div>
                    <div class="h-4 bg-[#d8d0c4] rounded w-4/6"></div>
                  </div>
                </div>
                <StorySlider 
                  client:only="react" 
                  stories={storySliderData} 
                  galleryPath="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color" 
                />
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <SiteFooter 
      previewImages={previewImages}
      previewPath={previewPath}
      title={`${oneImageMoviePage.title} – K4 Studios`}
      label="Explore Galleries"
      class="pt-8 pb-12" 
    />
  </div>

  <style>
    .one-image-movie-bridge {
      max-width: 1180px;
      margin: -3.25rem auto 3rem;
      padding: 0 1rem;
    }

    .one-image-movie-bridge__shell {
      background: rgba(255, 252, 247, 0.96);
      border: 1px solid rgba(121, 98, 78, 0.16);
      border-radius: 20px;
      padding: 1.35rem 1.25rem 1.65rem;
      box-shadow: 0 18px 34px rgba(52, 38, 26, 0.07);
      text-align: center;
    }

    .one-image-movie-bridge__kicker {
      margin: 0 0 0.75rem;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      color: #7b4a28;
    }

    .one-image-movie-hero {
      display: block;
      max-width: 860px;
      margin: 0 auto 1.1rem;
      overflow: hidden;
      border-radius: 16px;
      background: #efe7dc;
      border: 1px solid rgba(121, 98, 78, 0.14);
      box-shadow: 0 12px 26px rgba(41, 30, 21, 0.09);
    }

    .one-image-movie-hero img {
      display: block;
      width: 100%;
      height: clamp(260px, 45vw, 520px);
      object-fit: cover;
      object-position: center 38%;
    }

    .one-image-movie-bridge__text {
      max-width: 760px;
      margin: 0 auto 1.2rem;
    }

    .one-image-movie-bridge__text h2 {
      margin: 0 0 0.55rem;
      font-size: clamp(1.35rem, 2.4vw, 1.85rem);
      line-height: 1.25;
      color: #241b15;
      font-weight: 600;
    }

    .one-image-movie-bridge__text p {
      margin: 0;
      font-size: 1rem;
      line-height: 1.62;
      color: #4a3d34;
    }

    .story-block::after {
      content: "";
      display: block;
      clear: both;
    }

    .inline-art-callout {
      width: min(320px, 42%);
      margin: 0.35rem 0 1.4rem 1.9rem;
      padding: 0.85rem;
      border: 1px solid rgba(121, 98, 78, 0.16);
      border-radius: 14px;
      background: rgba(249, 247, 244, 0.92);
      box-shadow: 0 12px 24px rgba(52, 38, 26, 0.06);
    }

    .inline-art-callout--right {
      float: right;
      margin-left: 2.1rem;
    }

    .inline-art-callout--left {
      float: left;
      margin: 0.35rem 2.1rem 1.4rem 0;
    }

    .inline-art-callout a {
      display: block;
      overflow: hidden;
      border-radius: 10px;
      background: #efe7dc;
    }

    .inline-art-callout img {
      width: 100%;
      display: block;
    }

    .inline-art-callout p {
      margin: 0.85rem 0 0;
      font-size: 0.85rem;
      color: #666;
      font-style: italic;
      line-height: 1.35;
    }

    .one-image-movie-bridge__cta {
      display: inline-block;
      margin-top: 0.35rem;
      color: #7b4a28;
      font-size: 0.92rem;
      font-weight: 700;
      text-decoration: none;
      border-bottom: 1px solid rgba(123, 74, 40, 0.35);
      padding-bottom: 0.12rem;
    }

    .one-image-movie-bridge__cta:hover {
      color: #5f381e;
      border-bottom-color: rgba(95, 56, 30, 0.55);
    }

    @media (max-width: 768px) {
      .one-image-movie-bridge {
        margin: -4.25rem auto 2rem;
        padding: 0 0.75rem;
      }

      .one-image-movie-bridge__shell {
        padding: 1rem 0.85rem 1.2rem;
        border-radius: 16px;
      }

      .one-image-movie-hero img {
        height: 300px;
        object-position: center 42%;
      }

      .inline-art-callout {
        width: min(100%, 520px);
        float: none;
        margin: 1rem auto 1.25rem;
      }

      .one-image-movie-bridge__text h2 {
        font-size: 1.22rem;
      }

      .one-image-movie-bridge__text p {
        font-size: 0.93rem;
        line-height: 1.55;
      }

      .inline-art-callout {
        width: 100%;
        padding: 0.75rem;
      }

      .page-subtitle {
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
        letter-spacing: -0.03em !important;
        white-space: nowrap !important;
        font-size: 1rem !important;
      }
    }
  </style>
</BaseLayout>
