---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import PictureShowBase from "@/components/PictureShowBase.jsx";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { storyMeta, storyData } from "@/data/Other/Stories/Builder-Test-v3.mjs"; // 👈 dynamically replaced when saving

// ===== Dynamic Metadata Pull =====
const pageTitle = storyMeta?.showTitle
  ? `${storyMeta.showTitle} | Picture Show | Wayne Heim Fine Art Photography`
  : "Untitled Picture Show | Picture Show | Wayne Heim Fine Art Photography";

const pageDescription =
  storyMeta?.description ||
  "A cinematic fine art story told through painterly photography by Wayne Heim.";

const ogImage =
  Array.isArray(storyData) && storyData.length > 0 && storyData[0].id
    ? `https://www.k4studios.com/img/${storyData[0].id}/l.jpg`
    : "/og/painterly.jpg";

// ===== SEO + Social Metadata =====
const meta = {
  description: pageDescription,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogImage,
  ogType: "website",
  twitterCard: "summary_large_image",
  twitterTitle: pageTitle,
  twitterDescription: pageDescription,
  twitterImage: ogImage
};

// ===== Structured Data for Search Engines =====
const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: pageTitle,
    description: pageDescription,
    url: typeof window !== "undefined"
      ? window.location.href
      : `https://k4studios.com/Other/Show/Builder-Test-v3`,
    keywords: storyMeta?.keywords || "",
    copyrightNotice: "© Wayne Heim, k4studios.com. All rights reserved."
  },
  images: Array.isArray(storyData) ? storyData : [],
  defaults: {
    copyrightNotice: "© Wayne Heim, k4studios.com. All rights reserved.",
    license: "https://k4studios.com/licensing",
    acquireLicensePage: "https://k4studios.com/licensing",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});
---

<BaseLayout title={pageTitle} meta={meta} structuredDataJSON={structuredData}>
  <head>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="video.other" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <div id="picture-show-content" class="relative z-10 bg-white min-h-screen">
    <PictureShowBase
      client:only="react"
      rawData={Array.isArray(storyData) ? storyData : []}
      basePath="/Other/Show/Builder-Test-v3"
      titleBase={storyMeta?.showTitle || "Untitled Picture Show"}
      globalAudioSrc={storyMeta?.globalAudioSrc || ""}
      globalAudioMode={storyMeta?.globalAudioMode || "score"}
    />
  </div>

  <style>
    #picture-show-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  </style>
</BaseLayout>
