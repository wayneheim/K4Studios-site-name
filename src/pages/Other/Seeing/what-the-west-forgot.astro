---
export const prerender = true;
import BaseLayout    from "@/layouts/BaseLayout.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter    from "@/components/Footer.astro";
import SeeingHero    from "@/components/SeeingHero.astro";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";
import { essays } from "@/data/Other/Seeing/story.ts";
import type { Essay, EssaySection } from "@/data/Other/Seeing/story.ts";
import { galleryData as painterlyImages } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { getSemanticImageUrl } from "@/utils/imageProxy.js";
import "@/styles/global.css";

const essay = essays.find(e => e.slug === "what-the-west-forgot");
if (!essay) {
  throw new Error("Seeing essay not found: what-the-west-forgot");
}
const currentIndex = essays.findIndex(e => e.slug === "what-the-west-forgot");
const currentNumber = currentIndex + 1;
const { title, subtitle, sections } = essay as Essay;

const sectionPath = "/Other/Seeing/what-the-west-forgot";
const canonicalUrl = `https://k4studios.com${sectionPath}`;
const heroImageId = "i-qMQf7b6";
const heroImageSrc = getSemanticImageUrl(heroImageId, {}, "l");
const heroImageLink = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/i-qMQf7b6";
const seoTitle = "What the West Forgot | Seeing the Human Story Beneath the Myth";
const seoDescription = "What the West Forgot is a Seeing essay about looking past familiar Western imagery to find the human story beneath the myth: silence, consequence, ambiguity, memory, and unresolved meaning.";

const structuredData = getStructuredData({
  type: "Article",
  data: {
    headline: title,
    description: seoDescription,
    url: canonicalUrl,
    copyrightNotice: "© Wayne Heim",
    author: {
      "@type": "Person",
      name: "Wayne Heim"
    },
    articleSection: "Seeing",
    keywords: [
      "seeing western art",
      "western art",
      "narrative western art",
      "cinematic western art",
      "western fine art photography",
      "western mythology",
      "cowboy art",
      "frontier art",
      "visual storytelling",
      "American West art"
    ]
  },
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

const meta = {
  ...getLandingMeta(sectionPath, ""),
  description: seoDescription,
  keywords: "seeing western art, western art, narrative western art, cinematic western art, western fine art photography, western mythology, cowboy art, frontier art, visual storytelling, American West art",
  ogUrl: canonicalUrl,
  ogTitle: title,
  ogDescription: "A Seeing essay on Western imagery, myth, memory, and the human story that can disappear when familiar subjects become visual shorthand.",
  ogType: "article",
  ogImage: heroImageSrc,
  twitterUrl: canonicalUrl,
  twitterTitle: title,
  twitterDescription: "A Seeing essay on Western imagery, myth, memory, and the human story that can disappear when familiar subjects become visual shorthand.",
  twitterImage: heroImageSrc,
  twitterCard: "summary_large_image"
};

function shuffleArray<T>(arr: T[]): T[] {
  return arr
    .map(value => ({ value, sort: Math.random() }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ value }) => value);
}

const allGalleryImages = painterlyImages
  .filter(img => !['hidden', 'hide', 'ghost', 'non', 'none', ''].includes(String(img.visibility ?? 'show').trim().toLowerCase()))
  .map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color" }));

const previewImages = shuffleArray(allGalleryImages).slice(0, 6);
const previewPath = "/Galleries";

const breadcrumb = `Other › <a href='/Other/Seeing' style='color: inherit; text-decoration: none;' onmouseover="this.style.color='darkred'" onmouseout="this.style.color='inherit'">Seeing</a> › ${title}`;
---

<BaseLayout
  title={seoTitle}
  structuredDataJSON={structuredData}
  meta={meta}
>
  <main class="bg-white text-[#2c2c2c] min-h-screen overflow-x-hidden" style="font-family: 'Glegoo', serif;">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={breadcrumb} />
    </div>

    <SeeingHero
      essayNumber={currentNumber}
      titleLines={[
        "What the",
        "West Forgot"
      ]}
      imageSrc={heroImageSrc}
      imageLink={heroImageLink}
      imageAlt="Western figure in a dim interior, holding more human uncertainty than myth"
    />

    <section class="story-layout" style="font-family: 'Glegoo', serif;">
      <div class="text-column story-section" style="max-width: 760px; margin: 0 auto; padding: 0 1.5rem; line-height: 1.7;">
        {sections.map((section: EssaySection) => (
          <article class="story-block" style="margin-bottom: 2rem;">
            {section.subhead && (
              <h2 style="font-weight: 600; font-size: 1.5rem; margin-bottom: 0.75rem; margin-top: 2rem; color: #3b342e;">{section.subhead}</h2>
            )}

            {section.paragraphs?.map((para: string) => (
              <p style="line-height: 1.7; margin-bottom: 1.25rem; font-size: 1.05rem;" set:html={para} />
            ))}

            {section.bullets && (
              <ul style="padding-left: 1.5rem; margin-bottom: 1.25rem;">
                {section.bullets.map((bullet: string) => (
                  <li style="margin-bottom: 0.5rem; font-size: 1.05rem; list-style-type: disc;">{bullet}</li>
                ))}
              </ul>
            )}

            {section.paragraphsAfter?.map((para: string) => (
              <p style="line-height: 1.7; margin-bottom: 1.25rem; font-size: 1.05rem;" set:html={para} />
            ))}
          </article>
        ))}
      </div>
    </section>

    <nav style="text-align: center; padding: 3rem 1rem 2rem; font-family: 'Glegoo', serif;">
      <div style="display: inline-flex; align-items: center; gap: 0.75rem; font-size: 2rem; font-weight: 700; letter-spacing: 0.05em;">
        {essays.map((e, i) => (
          <>
            {i > 0 && <span style="color: #ccc;">|</span>}
            {i === currentIndex ? (
              <span style="color: #ccc;">{i + 1}</span>
            ) : (
              <a
                href={`/Other/Seeing/${e.slug}`}
                style="color: #888; text-decoration: none; transition: color 0.2s;"
                onmouseover="this.style.color='darkred'"
                onmouseout="this.style.color='#888'"
              >
                {i + 1}
              </a>
            )}
          </>
        ))}
      </div>
    </nav>

    <SiteFooter
      previewImages={[]}
      previewPath={previewPath}
      title={`${title} — Seeing`}
      label=""
      class="pt-8 pb-12"
    />
  </main>
</BaseLayout>