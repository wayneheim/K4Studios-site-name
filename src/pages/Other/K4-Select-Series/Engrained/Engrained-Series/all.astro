---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData } from "@/data/Other/K4-Select-Series/Engrained/Engrained-Series.mjs";
import { entranceData } from "@/data/Other/K4-Select-Series/Engrained/EngrainedSeriesEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";

const basePath = "/Other/K4-Select-Series/Engrained/Engrained-Series";
const canonicalPath = `${basePath}/all`;
const rawGalleryData = [...galleryData].sort((a: any, b: any) => (a?.sortOrder ?? 0) - (b?.sortOrder ?? 0));

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey: "engrained-0",
  currentHref: canonicalPath,
});

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>',
  '<a href="/Other/K4-Select-Series">K4 Select Series</a>',
  '<a href="/Other/K4-Select-Series/Engrained">Engrained</a>',
  `<a href="${basePath}">Engrained Series</a>`,
  'Series',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Other/K4-Select-Series", name: "K4 Select Series" },
  { href: "/Other/K4-Select-Series/Engrained", name: "Engrained" },
  { href: basePath, name: "Engrained Series" },
];

const copy = {
  seoTitle: "Engrained Fine Art Wood Prints | Painterly Photography on Wood - Wayne Heim",
  gatewayHeroSrc: "/images/Untitled-1_0016_11%20lake.jpg.jpg",
  gatewayHeroHref: "#collection-grid",
  gatewayHeroTitle: "Engrained fine art story printed into wood",
  gatewayHeroAlt:
    "Engrained fine art wood print detail with lake imagery, wood grain, and painterly texture.",
  gatewayHeroObjectPosition: "56% 58%",
  seoDescription:
    "Browse {imageCount} Engrained fine art wood prints by Wayne Heim - selected painterly photographs printed into carefully selected wood panels as ready-to-hang collector statement pieces.",
  indexDefinition:
    "This page presents the complete Engrained Series archive by Wayne Heim. Engrained is a separate presentation series for selected painterly photographs across K4 Studios, printed directly into wood so grain, image, texture, and story become part of one finished object.",
  indexLinkNote:
    "All {imageCount} Engrained works open to individual artwork pages with full stories, collector notes, image metadata, size, edition, and pricing details.",
  printAvailabilityNote:
    "Engrained works are limited wood-panel editions printed with a custom layered UV process. Each piece is ready to hang, with size and pricing specific to the image.",
  commercialH1: "Engrained Fine Art Wood Print Collection",
  commercialDeck:
    "{imageCount} fine art wood prints by Wayne Heim, printed on carefully selected wood panels ready to hang.",
  catalogEntranceTitle: "Engrained Fine Art Wood Prints by Wayne Heim",
  catalogEntranceCopy:
    "Browse selected painterly photographs printed into wood, where natural grain becomes part of the story, atmosphere, and historical presence of the finished work.",
  collectionIntro:
    "Browse the complete Engrained collection of fine art wood prints - selected painterly images drawn from Western narratives, Facing History, Civil War work, landscapes, trains, Americana, and other K4 Studios bodies of work. Each piece is printed directly into wood using a layered UV process that lets grain, texture, and image work together like a historical canvas. The result is not a standard print on a decorative surface, but a ready-to-hang collector statement piece where material, story, and stature belong to the same object. Every artwork opens to its full story, collector notes, image metadata, size, edition, and pricing details.",
  gatewayIntroCopy:
    "{imageCount} Engrained fine art wood prints by Wayne Heim, featuring selected painterly photographs printed directly into selected wood panels with a custom layered UV process. Drawn from across K4 Studios, these works use wood grain as a historical canvas - tying story, atmosphere, and material presence into a ready-to-hang collector statement piece.",
  gatewaySupportingCopy:
    "Click any piece to read the full narrative, explore collector notes, and view wood print size, edition, and pricing details.",
};
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="The Engrained Fine Art Wood Print Series"
  archiveContext={{
    categoryUrl: "/Other/K4-Select-Series/Engrained",
    categoryName: "Engrained Series",
  }}
  identity={{
    collectionName: "Engrained Series",
    variantName: "Wood Prints",
    variantDescriptor: "Engrained fine art wood print",
    gatewayBrandLabel: "Engrained Fine Art Wood Prints - Complete Collection",
  }}
  copy={copy}
/>
