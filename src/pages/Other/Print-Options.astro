---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import LandingHeader from '@/components/Landing-Header.jsx';
import SiteFooter from '@/components/Footer.astro';

import '@/styles/global.css';

const pageTitle = 'Print Materials & Finishes';
const pageDescription = 'How K4 Studios prints are made — from open-edition archival paper to signed Moab cotton rag editions to Engrained Baltic Birch panels.';
const pageUrl = 'https://www.k4studios.com/Other/Print-Options';

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageTitle,
  headline: pageTitle,
  description: pageDescription,
  acquireLicensePage: pageUrl,
  isPartOf: { '@id': 'https://www.k4studios.com/#website' },
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataJSON={structuredData}
  meta={{
    description: pageDescription,
    canonicalUrl: pageUrl,
    preserveDescriptionDashes: true,
  }}
>
  <main class="print-materials-page">
    <LandingHeader client:load breadcrumb="Print Materials &amp; Finishes" />

    <article>
      <h1>Print Materials &amp; Finishes</h1>

      <section aria-labelledby="open-edition">
        <h2 id="open-edition">Open Edition — Sketch &amp; Foundation Series</h2>
        <p>
          Sketch and Foundation Series prints are produced on professional-grade glossy photo paper, with a Pearl finish available as an alternative. These are the entry point into the collection — vivid color, fast turnaround, and an accessible way to live with the work.
        </p>
      </section>

      <section aria-labelledby="limited-edition">
        <h2 id="limited-edition">Limited Edition — Chronicle &amp; Legend Series</h2>
        <p>
          Chronicle and Legend Series editions are printed separately on Moab Entrada Bright Rag, a 290gsm, 100% cotton, acid-free fine art paper. It's a matte, museum-grade sheet with a bright white base and a smooth, substantial hand — the kind of surface built for prints meant to be signed, numbered, and kept for generations.
        </p>
      </section>

      <section aria-labelledby="engrained-series">
        <h2 id="engrained-series">Engrained Series — Where Story Meets Object</h2>
        <p>
          Engrained works are printed directly onto hand-selected Baltic Birch panels, where the natural wood grain is selectively allowed to show through and become part of the image itself. No two panels are alike — the grain's own history becomes part of the story you're bringing into the room.
        </p>
      </section>

      <p>
        For edition sizes, numbering, and pricing by series, see <a href="/Other/Series">Editions &amp; Series</a>.
      </p>

      <p>
        Looking for a format not listed here? <a href="/Contact">Contact us</a> and we'll let you know what's possible.
      </p>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .print-materials-page {
    min-height: 100vh;
    color: #2c2c2c;
    background: #fff;
    font-family: "Glegoo", serif;
  }

  article {
    width: min(820px, calc(100% - 2.5rem));
    margin: 3rem auto 2rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid #e6ded5;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
  }

  h1 {
    margin: 0 0 2rem;
    color: #49382b;
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    line-height: 1.2;
  }

  section {
    margin-top: 1.8rem;
    padding-top: 1.35rem;
    border-top: 1px solid #eee7e0;
  }

  section:first-of-type {
    margin-top: 0;
  }

  h2 {
    margin: 0 0 0.7rem;
    color: #5f4635;
    font-size: 1.2rem;
    line-height: 1.4;
  }

  p {
    margin: 1rem 0;
    line-height: 1.75;
  }

  a {
    color: #6f351f;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  a:hover {
    color: #421c0e;
  }
</style>
