---
export const prerender = true;
import BaseLayout         from '../../layouts/BaseLayout.astro';
import LandingHeader      from '../../components/Landing-Header.jsx';
// import ImageBar2       from '../../components/ImageBar2.jsx'; // â† disabled
import TombstoneNav       from '../../components/TombstoneNav.jsx';
import LandingRightImages from '../../components/LandingRightImages.jsx';
import FAQAccordion       from '../../components/FAQAccordion.jsx';
import SiteFooter         from '../../components/Footer.astro';
import MobileStoryImages  from '../../components/MobileStoryImages.jsx';
import { getLandingMeta } from '../../data/landingMeta.ts';
import { getFAQPageStructuredData } from '../../components/utils/getStructuredData.ts';

import { siteNav } from '../../data/siteNav.ts';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';
import { autoLinkKeywordsInText } from '../../components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '../../data/semantic/K4-Sem.ts';

import { landingWestern } from '@/data/Other/Bio/landingstones.ts';
import { painterlyStory as westernStory } from '@/data/Other/Bio/story.ts';
import { facingFAQ } from '@/data/Other/Bio/faq.ts';

import '../../styles/global.css';

type StorySection = {
  title?: string;
  subhead?: string;
  tagline?: string;
  paragraphs?: string[];
  list?: string[];
  callout?: string;
};

// ----------------------
// DYNAMIC LOGIC SECTION
// ----------------------

const pagePath = "/Other/Bio";
const sectionPath = "/Galleries/Painterly-Fine-Art-Photography";
const meta = getLandingMeta(pagePath);
const headingCount = westernStory.filter((block, i) => i > 0 && block.subhead).length;

function findNavEntry(nav, url) {
  for (const entry of nav) {
    if (entry.href === url) return entry;
    if (entry.children) {
      const found = findNavEntry(entry.children, url);
      if (found) return found;
    }
  }
  return null;
}
function recursivelyGatherAllGalleryHrefs(node) {
  let result = [];
  if (!node) return result;
  if (node.href && node.href.startsWith('/Galleries/')) result.push(node.href);
  if (node.children) node.children.forEach(child => result = result.concat(recursivelyGatherAllGalleryHrefs(child)));
  return result;
}
const landingNav = findNavEntry(siteNav, sectionPath);
const galleryPaths = landingNav
  ? recursivelyGatherAllGalleryHrefs(landingNav)
  : [];
const allGalleryData = import.meta.glob<{ galleryData: any[] }>(
  '../../data/Galleries/**/*.mjs',
  { eager: true }
);

function getGalleryDataByHref(path: string) {
  const filePath = '../../data/Galleries' + path.replace(/^\/Galleries/, '') + '.mjs';
  const parts = path.split('/');
  const lastSegment = parts[parts.length - 1];
  const nestedPath = '../../data/Galleries' + path.replace(/^\/Galleries/, '') + '/' + lastSegment + '.mjs';
  const mod: any = allGalleryData[filePath] || allGalleryData[nestedPath];
  return mod?.galleryData || mod?.default || [];
}

const galleryDatas = galleryPaths.map((path) => {
  return getGalleryDataByHref(path);
});

const bioImageSources = [
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color',
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color',
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color',
  '/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery',
  '/Galleries/Painterly-Fine-Art-Photography/Miscellaneous/Portraits',
  '/Galleries/Painterly-Fine-Art-Photography/Transportation/Trains-Color',
];

const featheredImages = bioImageSources.flatMap((path) =>
  getGalleryDataByHref(path)
    .filter((img: any) => img?.id && img.id !== 'i-k4studios')
    .sort((a: any, b: any) => (b.rating ?? 0) - (a.rating ?? 0))
    .slice(0, 3)
    .map((img: any) => ({
      ...img,
      galleryPath: path,
      href: `${path}/${img.id}`,
    }))
);

const landingDescription =
  landingWestern.subtitle || (landingWestern as any)?.description || "";
const closingLine = 'Embrace the Past. Live the Story.';

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://www.k4studios.com/Other/Bio#profilepage",
  url: "https://www.k4studios.com/Other/Bio",
  name: "Wayne Heim - Western Fine Art Photographer & Medical Illustrator",
  description:
    "Wayne Heim is a Western fine art photographer, award-winning medical illustrator, and fine art storyteller whose painterly photography brings a trained illustrator's eye to the American West, living history, and narrative image-making.",
  mainEntity: {
    "@type": "Person",
    "@id": "https://www.k4studios.com/#person",
    name: "Wayne Heim",
    url: "https://www.k4studios.com/Other/Bio",
    image: "https://www.k4studios.com/images/Bio-Heim.jpg",
    jobTitle: "Western Fine Art Photographer, Fine Art Photographer, Medical Illustrator",
    description:
      "Wayne Heim is a Western fine art photographer, award-winning medical illustrator, and fine art storyteller known for painterly Western photography, living-history subjects, and narrative image-making.",
    worksFor: { "@id": "https://www.k4studios.com/#organization" },
    brand: { "@id": "https://www.k4studios.com/#organization" },
    sameAs: [
      "https://www.instagram.com/k4studios/"
    ],
    knowsAbout: [
      "Western fine art photography",
      "painterly photography",
      "cowboy photography",
      "living history",
      "historical reenactment photography",
      "medical illustration",
      "visual storytelling"
    ],
    subjectOf: [
      {
        "@type": "Article",
        name: "Painterly Photography",
        url: "https://aotw.com/2026/02/painterly-photography/"
      }
    ]
  },
  isPartOf: {
    "@type": "WebSite",
    "@id": "https://www.k4studios.com/#website",
    name: "K4 Studios",
    url: "https://www.k4studios.com/"
  }
}, null, 2);
const faqStructuredData = getFAQPageStructuredData(facingFAQ, "https://k4studios.com/Other/Bio");
---

<BaseLayout
  title={`${landingWestern.title} â€“ ${landingWestern.subtitle}`}
  structuredDataJSON={structuredData}
  extraStructuredDataJSON={faqStructuredData}
  meta={meta}
>

  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingWestern.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingWestern.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4">
      <!-- Carousel hidden for now
      <div class="carousel-fade reveal-on-scroll">
        <ImageBar2 client:load />
      </div>
      -->
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">
          {landingWestern.title}
        </h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">
          {landingWestern.subtitle}
        </h2>
        <div class="bio-heading-rule" aria-hidden="true"></div>
      </div>
    </section>

    {landingWestern.tombstones?.length ? (
      <div class="py-5">
        <TombstoneNav items={landingWestern.tombstones} />
      </div>
    ) : null}

    <section class="story-layout">
      <div class="text-column">
        <!-- Mobile bio photo -->
  <figure class="bio-photo-mobile md:hidden fade-in reveal-on-scroll" style="text-align:center; margin:0 auto 1.5rem; max-width:260px;">
          <img
            src="/images/Bio-Heim.jpg"
            alt="Wayne Heim portrait"
            loading="lazy"
            style="width:100%; height:auto; border-radius:3px; box-shadow:0 4px 16px rgba(0,0,0,.18); border:12px solid #fff;"
          />
          <figcaption style="font-size:.7rem; letter-spacing:.05em; opacity:.6; margin-top:.4rem;">Artist Wayne Heim</figcaption>
        </figure>
        <section class="story-section">
          {westernStory.map((section: StorySection, index: number) => (
            <article class="story-block">
              {section.title && <h2 class="slide-in-left" set:html={autoLinkKeywordsInText(section.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
              {section.subhead && <h3 class="slide-in-left" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
              {section.tagline && <h4 class="tagline reveal-on-scroll" set:html={autoLinkKeywordsInText(section.tagline, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
              {section.paragraphs?.map((para: string, i: number) => (
                <p
                  class:list={[
                    'reveal-on-scroll',
                    index === 0 && i < 2 && 'bio-lead-paragraph',
                    para === closingLine && 'bio-closing-line'
                  ]}
                  set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)}
                />
              ))}
              {section.callout && (
                <p class="bio-anchor-line reveal-on-scroll">{section.callout}</p>
              )}
              {section.list && section.list.length > 0 && (
                <ul>
                  {section.list.map((item: string, j: number) => (
                    <li class="reveal-on-scroll" set:html={autoLinkKeywordsInText(item, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
                  ))}
                </ul>
              )}
              {index === 0 && (
                <aside class="bio-pathways reveal-on-scroll" aria-label="Explore the work">
                  <p class="bio-pathways-kicker">Explore the Work</p>
                  <ul class="bio-pathways-list">
                    <li><a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Photography</a> â€” atmosphere, restraint, and authored image-making.</li>
                    <li><a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Narrative Historical Series</a> â€” story-driven work rooted in history and consequence.</li>
                    <li><a href="/Other/One-Image-Movie">One-Image Moviesâ„¢</a> â€” the core concept behind the workâ€™s narrative structure.</li>
                    <li><a href="/wayne-heim-western-fine-art-photography">Western Fine Art Photography</a> â€” a structured survey of one major body of work.</li>
                  </ul>
                  <p class="reveal-on-scroll" style="margin-top:1rem; color:#54483d; line-height:1.75;">
                    Across the work, I keep returning to the conditions that gave Western subjects their weight: labor, weather, silence, distance, and consequence rather than symbol alone.
                  </p>
                </aside>
              )}
              {index === westernStory.length - 1 && (
                <p class="bio-final-cta reveal-on-scroll">
                  <a href="/Galleries/Painterly-Fine-Art-Photography">Explore the work -></a>
                </p>
              )}
            </article>
          ))}
        </section>

        <MobileStoryImages client:only="react" images={sanitizeForClient(featheredImages)} displayCount={headingCount} />
      </div>

      <div class="sidebar-column hidden md:block">
        <!-- Desktop bio photo -->
        <div class="bio-photo-wrapper sample-fade reveal-on-scroll" style="margin:0 auto 1.25rem; max-width:260px; text-align:center;">
          <img
            src="/images/Bio-Heim.jpg"
            alt="Wayne Heim portrait"
            loading="lazy"
            style="width:100%; height:auto; border-radius:6px; box-shadow:0 6px 20px rgba(0,0,0,.22); border:10px solid #ffffff; background:#fff;"
          />
          <div style="font-size:.85rem; margin-bottom:6rem; letter-spacing:.05em; text-transform:uppercase; opacity:.55; margin-top:.5rem;">Artist Wayne Heim</div>
        </div>
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages
            client:load
            heading="Selected Work"
            images={sanitizeForClient(featheredImages)}
            displayCount={6}
            dynamicSpacing={false}
          />
        </div>
      </div>
    </section>

    <section class="pb-10">
      <input type="checkbox" id="faq-toggle" class="more-toggle" />
      <div class="truncate-container" style="min-height:0;">
        <div class="truncate-text">
          <FAQAccordion items={facingFAQ} />
        </div>
      </div>
      <label for="faq-toggle" class="more-toggle-label"></label>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // Reveal-on-scroll logic
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.15
        });
        els.forEach(el => observer.observe(el));
      }

      // NEW: auto-expand FAQ box if a question is clicked
      const faqToggle = document.getElementById("faq-toggle");
      const truncateContainer = document.querySelector(".truncate-container");

      if (truncateContainer && faqToggle) {
        truncateContainer.addEventListener("click", (e) => {
          const summaryClicked = e.target.closest("summary");
          if (summaryClicked && !faqToggle.checked) {
            faqToggle.checked = true;
          }
        });
      }
    });
  </script>

  <style>
  ul {
    list-style-type: disc;
    padding-left: 1.25em;
  }

  ul li {
    margin-top: 0.15em;
    margin-left: 1.5em;
  }

  ul li::marker {
    margin-top: 0.15em;
    font-size: 1.2em; /* makes bullet bigger */
    color: gray;      /* or any tone you want */
  }

  @media (max-width: 768px) {
    .section-heading .page-title {
      font-size: 1.5rem;
      line-height: 1.3;
    }

    .section-heading .page-subtitle {
      max-width: 42ch;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
      font-size: 1rem;
      line-height: 1.4;
      letter-spacing: -0.04em;
    }

    .section-heading-wrap {
      margin-top: 1rem;
      margin-bottom: 1rem;
    }

    .sidebar-column {
      display: none;
    }

    .story-section {
      letter-spacing: -0.03em;
    }

    .story-block h2 {
      letter-spacing: -0.05em;
      font-size: 1.4rem !important;
      margin-top: -0.59rem;
      line-height: 1.15;
    }
  }

  .fade-in {
    opacity: 0;
    visibility: hidden;
    transform: translateY(1px);
    transition: opacity 1.75s ease, transform 1.75s ease, visibility .5s linear 1.75s;
  }

  .fade-in.is-visible {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }

  .page-title.fade-in {
    transition-delay: .2s;
  }

  .section-heading-wrap {
    margin: 3.25rem 0 2.5rem;
    text-align: center;
  }

  .section-heading {
    margin-top: 2rem;
    margin-bottom: 0;
  }

  .section-heading .page-title {
    font-size: 2rem;
    margin-bottom: .4rem;
    margin-top: 0;
    line-height: 1.15;
  }

  .section-heading .page-subtitle {
    font-size: 1rem;
    font-weight: 500;
    color: #6d5b4a;
    opacity: .9;
  }

  .bio-heading-rule {
    width: min(780px, calc(100vw - 5rem));
    height: 2px;
    margin: 1.75rem auto 0;
    background: #b7aba0;
    opacity: 0.9;
  }

  .story-layout {
    margin-top: 1.25rem;
  }

  .story-section {
    line-height: 1.3;
    padding: 2rem 1.5rem;
    max-width: 860px;
    margin: 0 auto;
    font-family: 'Glegoo', serif;
  }

  .story-block {
    margin-bottom: 2.5rem;
  }

  .story-block h2 {
    font-weight: 500;
    font-size: 1.65rem;
    margin-bottom: 0.55rem;
  }

  .story-block h3 {
    font-weight: 500;
    font-size: 1.2rem;
    margin-top: -0.5rem;
    margin-bottom: -.025rem;
    color: #5a4a3b;
  }

  .story-block .tagline {
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 1rem;
    color: #7a6250;
  }

  .story-block p {
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 1.01rem;
  }

  .story-block + .story-block {
    padding-top: 1.1rem;
    border-top: 1px solid rgba(116, 97, 79, 0.14);
  }

  .bio-lead-paragraph {
    font-size: 1.12rem !important;
    line-height: 1.68 !important;
    color: #34261c;
  }

  .bio-anchor-line {
    margin: 1.35rem 0 1.45rem;
    color: #3c2f24;
    font-size: 1.08rem;
    line-height: 1.6;
    font-style: italic;
  }

  .bio-pathways {
    margin: 1.6rem 0 1.1rem;
    padding: 0.95rem 1rem 0.9rem;
    border-left: 2px solid rgba(128, 109, 89, 0.24);
    background: rgba(250, 247, 242, 0.5);
  }

  .bio-pathways-kicker {
    margin: 0 0 0.85rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #7d6551;
  }

  .bio-pathways-list {
    margin: 0;
    padding-left: 1.2rem;
  }

  .bio-pathways-list li {
    margin: 0 0 0.6rem;
    color: #4f4134;
    line-height: 1.55;
    font-size: 0.98rem;
  }

  .bio-pathways-list li:last-child {
    margin-bottom: 0;
  }

  .bio-pathways-list a {
    color: #6c2f1e;
    text-decoration: underline;
    text-underline-offset: 0.1em;
  }

  .bio-closing-line {
    text-align: center;
    font-size: 1.28rem !important;
    font-weight: 600;
    color: #3a2d21;
    margin-top: 1.65rem !important;
  }

  .bio-final-cta {
    margin-top: 0.3rem;
    text-align: center;
  }

  .bio-final-cta a {
    color: #7d2f18;
    text-decoration: none;
    border-bottom: 1px solid rgba(125, 47, 24, 0.32);
    padding-bottom: 0.05rem;
  }

  .story-block ul {
    padding-left: 1.4rem;
    margin-top: 0.5rem;
  }

  .story-block li {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .page-subtitle.fade-in {
    opacity: 0 !important; /* Forces initial hidden state */
    transform: translateY(-12px);
    visibility: hidden;
    transition:
      opacity 1.1s ease-out,
      transform 1.1s ease-out,
      visibility 0s linear 1.1s;
    transition-delay: 1s;
  }

  .page-subtitle.fade-in.is-visible {
    opacity: 1 !important;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 1s;
  }

  .carousel-fade {
    opacity: 0;
    transform: translateY(0px);
    transition:
      opacity 1.5s ease-out,
      transform 1.5s ease-out;
    transition-delay: 0.0s;
    visibility: hidden;
  }

  .sample-fade {
    opacity: 0;
    transform: translateY(0px);
    transition:
      opacity 1.5s ease-out,
      transform 1.5s ease-out;
    transition-delay: 0.2s;
    visibility: hidden;
    margin-top: -0.75rem; /* <-- this line does the nudge */
  }

  .sample-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }

  .carousel-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }

  /* Bio photo refinements */
  .bio-photo-mobile img { object-fit: cover; }
  @media (min-width: 768px) {
    .bio-photo-mobile { display: none !important; }
  }
  </style>
</BaseLayout>
