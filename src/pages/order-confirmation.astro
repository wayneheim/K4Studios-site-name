---
import BaseLayout from "@layouts/BaseLayout.astro";

const meta = {
  seoTitle: "Order Confirmation | K4 Studios",
  seoDescription: "K4 Studios order confirmation.",
  robots: "noindex, nofollow, noarchive",
  canonical: false,
  ogType: "website",
};
---

<BaseLayout title="Order Confirmation | K4 Studios" meta={meta} disableAutoBreadcrumbs={true}>
  <main class="mx-auto min-h-[80vh] max-w-3xl px-4 py-12 sm:px-6 sm:py-16" data-k4-order-confirmation>
    <section class="overflow-hidden rounded-xl border border-stone-200 bg-[#fbfaf7] shadow-md">
      <div class="border-b border-stone-200 bg-[#63776a] px-6 py-8 text-white sm:px-10">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-white/75">K4 Studios Collection</p>
        <h1 class="mt-2 text-3xl font-semibold sm:text-4xl">Thank you for your order.</h1>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/85">
          Your payment was confirmed and your print order has been safely recorded.
        </p>
      </div>

      <div class="px-6 py-8 sm:px-10 sm:py-10">
        <div class="rounded-lg border border-stone-200 bg-white px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[#8a3d2b]">K4 order number</p>
          <p class="mt-2 break-all text-xl font-semibold text-stone-900" data-order-number>Confirming…</p>
        </div>

        <div class="mt-6 hidden rounded-lg border border-amber-300 bg-amber-50 px-5 py-4 text-sm leading-relaxed text-amber-950" data-sandbox-notice>
          <strong>Sandbox test completed.</strong> No live money was collected and this is not a production order.
        </div>

        <div class="mt-7 space-y-3 text-center text-sm leading-relaxed text-stone-600">
          <h2 class="text-lg font-semibold text-stone-900">What happens next</h2>
          <p>A confirmation email will be sent to the address provided during checkout.</p>
          <p>K4 Studios will review the order details and provide production or shipping updates as the print moves forward.</p>
        </div>

        <section class="mt-8 hidden border-t border-stone-200 pt-7" data-collector-notes-section>
          <div class="text-center">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#8a3d2b]">The story behind the work</p>
            <h2 class="mt-2 text-xl font-semibold text-stone-900">About your new artwork</h2>
          </div>
          <div class="mt-5 space-y-4" data-collector-notes-list></div>
        </section>

        <div class="mt-8 flex justify-center border-t border-stone-200 pt-6">
          <a href="/" class="inline-flex min-h-11 items-center justify-center rounded-md bg-[#8a3d2b] px-5 py-2.5 text-sm font-semibold text-white shadow hover:bg-[#743120]">
            Return to K4 Studios
          </a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const orderNumber = params.get("order") || "Order confirmed";
      const orderElement = document.querySelector("[data-order-number]");
      if (orderElement) orderElement.textContent = orderNumber;
      if (params.get("mode") === "sandbox") {
        document.querySelector("[data-sandbox-notice]")?.classList.remove("hidden");
      }

      try {
        const saved = JSON.parse(window.sessionStorage.getItem(`k4-order-confirmation:${orderNumber}`) || "{}");
        const items = Array.isArray(saved.items) ? saved.items.filter((item) => String(item?.collectorNotes || "").trim()) : [];
        const section = document.querySelector("[data-collector-notes-section]");
        const list = document.querySelector("[data-collector-notes-list]");
        if (section && list && items.length) {
          for (const item of items) {
            const article = document.createElement("article");
            article.className = "rounded-lg border border-stone-200 bg-white px-5 py-5";
            const title = document.createElement("h3");
            title.className = "text-base font-semibold text-stone-900";
            title.textContent = item.imageTitle || "K4 Studios artwork";
            const notes = document.createElement("p");
            notes.className = "mt-2 whitespace-pre-line text-sm italic leading-relaxed text-stone-600";
            notes.textContent = item.collectorNotes;
            article.append(title, notes);
            try {
              const artworkUrl = new URL(String(item.artworkUrl || ""));
              if (artworkUrl.protocol === "https:" && ["www.k4studios.com", "k4studios.com"].includes(artworkUrl.hostname)) {
                const link = document.createElement("a");
                link.href = artworkUrl.toString();
                link.className = "mt-3 inline-flex text-xs font-semibold text-[#8a3d2b] underline underline-offset-4";
                link.textContent = "View this artwork on K4 Studios";
                article.append(link);
              }
            } catch {}
            list.append(article);
          }
          section.classList.remove("hidden");
        }
      } catch {}
    })();
  </script>
</BaseLayout>
