---
export const prerender = true;

import CommercialDoorwayAllPage from "@/components/doorway/CommercialDoorwayAllPage.astro";
import { galleryData as cowboyColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as cowboyBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs";
import { galleryData as narrativeColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs";
import { galleryData as narrativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { galleryData as westernLandscapeData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery.mjs";
import { galleryData as mountainData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains/Mountains.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/ColorEntranceData.ts";
import { buildWesternArtworkDock } from "@/data/Western-Artwork/buildWesternArtworkDock.ts";
import { westernArtworkFAQ } from "@/data/Western-Artwork/faq.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
import { landingWestern as landscapeLocationLanding } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/landingstones.ts";
import { landingWestern as landscapeThemeLanding } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/landingstones.ts";

const pagePath = "/western-artwork";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color";
const canonicalPath = pagePath;

const rotateGallery = (items: any[] = [], offset = 0) => {
  const cleanItems = items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  );
  if (cleanItems.length === 0) return cleanItems;
  const start = offset % cleanItems.length;
  return [...cleanItems.slice(start), ...cleanItems.slice(0, start)];
};

const cowboyColorItems = rotateGallery(cowboyColorData, 17);
const cowboyBlackWhiteItems = rotateGallery(cowboyBlackWhiteData, 23);
const westernLandscapeItems = rotateGallery(westernLandscapeData, 11);
const narrativeColorItems = rotateGallery(narrativeColorData, 203);
const narrativeBlackWhiteItems = rotateGallery(narrativeBlackWhiteData, 109);
const mountainItems = rotateGallery(mountainData, 7);
const westernLandscapeTombstone = landscapeLocationLanding.tombstones.find((stone: any) =>
  String(stone.href || "").includes("/Landscapes/By-Location/West/")
)?.thumb;
const mountainTombstone = landscapeThemeLanding.tombstones.find((stone: any) =>
  String(stone.href || "").includes("/Landscapes/By-Theme/Mountains")
)?.thumb;

const breadcrumbHtml = [
  '<a href="/">Wayne Heim</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  "Western Artwork",
].join(" | ");

const breadcrumbStructuredItems = [
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
];

const { sectionDockItems, dockCenterIndex } = buildWesternArtworkDock();

const gridSections = [
  {
    title: "Western Portrait Artwork - Color Cowboy Studies",
    description: "Character-led wall art where weathered faces, posture, and painterly light carry the human side of the West.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/all#collection-browser",
    ctaLabel: "See the full Western portrait artwork collection",
    ctaThumb: "/img/i-5FX3W9r/s.jpg",
    items: cowboyColorItems,
    limit: 19,
  },
  {
    title: "Western Landscape Artwork - Open Country and Western Light",
    description: "Painterly Western landscape artwork for rooms that need open space, atmosphere, and the geography behind the frontier.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery/all#collection-browser",
    ctaLabel: "See the full Western landscape artwork collection",
    ctaThumb: westernLandscapeTombstone,
    items: westernLandscapeItems,
    limit: 19,
  },
  {
    title: "Narrative Frontier Artwork",
    description: "Story-driven Western scenes where the visible moment carries tension, consequence, and an unfinished chapter.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/all#collection-browser",
    ctaLabel: "See the full narrative frontier collection",
    ctaThumb: "/img/i-B7ZSdfs/s.jpg",
    items: narrativeColorItems,
    limit: 19,
  },
  {
    title: "Black and White Cowboy Artwork - Western Portrait Studies",
    description: "Monochrome cowboy portrait artwork for collectors who want weathered character, tonal weight, and frontier restraint.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white cowboy artwork collection",
    ctaThumb: "/images/tombstones/cowboy-bw-ts.webp",
    items: cowboyBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Western Mountain Artwork - Painterly Mountain Studies",
    description: "Mountain-driven pieces where scale, atmosphere, and landform become emotional structure rather than background.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains/all#collection-browser",
    ctaLabel: "See the full Western mountain artwork collection",
    ctaThumb: mountainTombstone,
    items: mountainItems,
    limit: 19,
  },
  {
    title: "Black and White Frontier Scenes",
    description: "Black and white frontier artwork where atmosphere, contrast, and tonal restraint carry the story further than color would.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white narrative collection",
    ctaThumb: "/img/i-kp5NHNw/s.jpg",
    items: narrativeBlackWhiteItems,
    limit: 19,
  },
];

const countLiveItems = (sections: typeof gridSections) =>
  sections.reduce((total, section) => total + section.items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  ).length, 0);
const westernArtworkLiveCount = countLiveItems(gridSections);

const commercialMiddleCopy = [
  "Western artwork is a broad room and subject search before it is a print decision. It can mean cowboy pieces, landscape work, framed Western art, modern Western wall art, vintage-feeling frontier scenes, or one strong image that sets the tone of a living room, office, lodge, ranch home, or hospitality space.",
  "Start by choosing the visual theme the room needs: a human figure, open country, narrative tension, black and white restraint, mountain scale, or an old-West story register. The sections below keep those choices separate so the page does not collapse into one generic Western decor grid.",
  "Print format, size, and edition details live inside the individual image pages. This page is the artwork map: the place to decide what kind of Western subject belongs on the wall before choosing the exact presentation.",
].join("\n\n");

const copy = {
  seoTitle: "Western Artwork - Cowboy, Landscape & Wall Art by Wayne Heim",
  seoDescription:
    "Western artwork by Wayne Heim for walls and rooms. Cowboy artwork, frontier scenes, Western landscapes, mountain art, black and white studies, framed art, and collector prints.",
  indexDefinition:
    "Wayne Heim's catalog includes color and black and white cowboy portraits, narrative frontier scenes, Western landscapes, and mountain artwork created as collector-grade fine art for homes, offices, lodges, and long-term display.",
  indexLinkNote:
    "This is the K4 route for broad Western art intent: artwork for walls, western themed art, western art prints, landscape artwork, mountain artwork, and painterly Western fine art.",
  printAvailabilityNote: `Western artwork is available from ${getFormattedLowestStandardPrintPrice()} across archival paper and select wood presentations. Edition status and format options are shown on individual image pages.`,
  commercialH1: "Western Artwork for Walls, Rooms, and Collector Spaces",
  commercialDeck:
    "Six artwork routes, 917 works: cowboy figures, open-country landscapes, frontier scenes, black and white studies, mountain art, and Western themed wall pieces organized by room need and visual subject.",
  catalogEntranceTitle: "Western Artwork, Cowboy Portraits, Landscapes, and Frontier Scenes",
  catalogEntranceCopy:
    "Browse Western themed art, cowboy portrait work, black and white Western studies, narrative frontier scenes, Western landscapes, and mountain artwork created as collector-grade fine art.",
  collectionIntro: commercialMiddleCopy,
  breadcrumbCurrentName: "Western Artwork",
  aggregateOfferLowPrice: "25",
  aggregateOfferHighPrice: "5000",
  aggregateOfferCount: String(westernArtworkLiveCount),
  gatewayCollectionName: "Western Artwork",
  gatewayIntroCopy:
    "Western artwork has to solve two problems at once: it has to feel like the West, and it has to hold the wall.",
  gatewaySupportingCopy:
    "That is why the search result mixes product grids, framed wall art, canvas art, paintings, prints, cowboy pieces, landscapes, museums, and modern Western decor. The term is not narrow. It is a room-facing art search with a strong visual vocabulary: cowboy culture, the American frontier, Native American heritage, wildlife, open land, mountain distance, and the kind of work that makes a room feel Western without turning it into a theme set.\n\nWayne Heim's catalog is organized here by what the image does for the wall. Some works give the room a human anchor. Some open the room with landscape. Some bring old-West story pressure. Some remove color and rely on tone. Some give the wall scale through mountains and sky.\n\nUse this page when the search is still broad: artwork for a wall, artwork for a living room, modern Western artwork, vintage Western artwork, or a collector piece that needs more presence than mass-market decor.",
  gatewayKicker: "K4 Studios - Western Artwork Catalog",
  gatewayHeroTitle: "Western Artwork by Wayne Heim",
  gatewayHeroAlt:
    "Painterly Western mountain artwork with open sky, landform, and collector-grade fine art atmosphere.",
  gatewayHeroHref:
    "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains/i-zk7zXP3",
  gatewayHeroSrc: "/img/i-zk7zXP3/m.jpg",
  gatewayHeroSrcSet: "/img/i-zk7zXP3/s.jpg 400w, /img/i-zk7zXP3/m.jpg 720w",
  archiveContextCopy:
    "The K4 Studios catalog is organized by visual role: figure, land, story, tonal restraint, mountain scale, and old-West atmosphere. Open any image for story, sizing, presentation, and collector details. For help choosing artwork for a specific wall or room, contact Wayne at <a href='mailto:wayne@k4studios.com'>wayne@k4studios.com</a>.",
  conceptBlock1Title: "The Human Anchor",
  conceptBlock1Copy:
    "A room often needs one figure before it needs more scenery. Cowboy portrait artwork gives the wall a human center: hat brim, posture, weathered clothing, and the quiet authority of a person who can hold space without bright color or decorative noise.",
  conceptBlock2Title: "The Open Wall",
  conceptBlock2Copy:
    "Western landscape artwork works differently. It opens the wall outward. Land, sky, ridge lines, water, and distance create breathing room in spaces that already carry wood, leather, stone, metal, or heavy furniture.",
  conceptBlock3Title: "The Frontier Scene",
  conceptBlock3Copy:
    "Narrative frontier art carries motion and consequence. These pieces are for rooms that can take a stronger story charge: old-West tension, mounted figures, dust, pursuit, pause, and the feeling that something happened just before the frame.",
  conceptBlock4Title: "The Quieter Figure",
  conceptBlock4Copy:
    "Black and white Western work removes the color language and leaves structure. The figure becomes shape, light, shadow, texture, and expression. This is the better route when a room needs Western presence without a warm palette taking over.",
  conceptBlock5Title: "The Landmark Scale",
  conceptBlock5Copy:
    "Mountain artwork gives the page its largest room register. These works use distance and elevation instead of character. They suit larger walls, lodge entries, offices, stair landings, and spaces where the West needs to arrive through landform rather than figure.",
  conceptBlock6Title: "The Old-West Register",
  conceptBlock6Copy:
    "Black and white frontier scenes bring the vintage side of the West forward without becoming reproduction decor. The story still matters, but the surface is quieter: more memory, less spectacle.",
  faqKicker: "Print & Collector Questions",
  faqTitle: "Western Artwork FAQ",
};
---

<CommercialDoorwayAllPage
  rawGalleryData={cowboyColorItems}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Explore Western Artwork Collections"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West",
    categoryName: "Wild West",
  }}
  identity={{
    collectionName: "Western Artwork",
    variantName: "Fine Art Prints",
    variantDescriptor: "western artwork",
    gatewayBrandLabel: "Western Artwork - Fine Art Prints by Wayne Heim",
  }}
  copy={copy}
  faqItems={westernArtworkFAQ}
  gridSections={gridSections}
  dockVariant="wall-art"
  layoutVariant="cinematic-concept-series-top"
/>
