---
export const prerender = true;

import CommercialDoorwayAllPage from "@/components/doorway/CommercialDoorwayAllPage.astro";
import { galleryData as cowboyBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs";
import { galleryData as narrativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { galleryData as nativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/BWEntranceData.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
import { faqItems as westernBlackWhiteFAQ } from "@/data/hybrid-hubs/western-black-white.ts";

const pagePath = "/Western-Black-and-White-Photography";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White";
const canonicalPath = pagePath;

const rotateGallery = (items: any[] = [], offset = 0) => {
  const cleanItems = items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  );
  if (cleanItems.length === 0) return cleanItems;
  const start = offset % cleanItems.length;
  return [...cleanItems.slice(start), ...cleanItems.slice(0, start)];
};

const cowboyBlackWhiteItems = rotateGallery(cowboyBlackWhiteData, 0);
const narrativeBlackWhiteItems = rotateGallery(narrativeBlackWhiteData, 0);
const nativeBlackWhiteItems = rotateGallery(nativeBlackWhiteData, 0);

const breadcrumbHtml = [
  '<a href="/">Wayne Heim</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  "Western Black and White Photography",
].join(" | ");

const breadcrumbStructuredItems = [
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
];

const supportDockItem = (title: string, href: string, thumb: string, subtitle = "") => ({
  title,
  subtitle,
  href,
  thumb,
  cue: "Browse collection ->",
  dockRole: "support",
  dockPrefix: "",
});

const sectionDockItems = [
  supportDockItem(
    "Learn What Makes an Image Feel Cinematic",
    "/Blog/what-makes-an-image-feel-cinematic",
    "/img/i-kp5NHNw/s.jpg"
  ),
  supportDockItem(
    "Learn What Is Narrative Photography",
    "/Blog/what-is-narrative-photography",
    "/img/i-HfQ5NVR/s.jpg"
  ),
  supportDockItem(
    "Learn What Is Painterly Photography",
    "/Blog/what-is-painterly-photography",
    "/img/i-2GsTkqf/s.jpg"
  ),
  supportDockItem(
    "Learn What Is Historical Western Photography",
    "/Blog/what-is-historical-western-photography",
    "/img/i-FnZ68h3/s.jpg"
  ),
  { separator: true, label: "Core black and white Western collections" },
  {
    title: "Black and White Cowboy Portraits",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    thumb: "/img/i-DJMTZ8z/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    title: "Black and White Western Narratives",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    thumb: "/img/i-mqQxwNn/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    title: "Black and White Native American Portraits",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White/all#collection-browser",
    thumb: "/img/i-Z54nXZm/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  { separator: true, label: "Collector notes and related routes" },
  supportDockItem(
    "Learn What Is Western Black and White Photography",
    "/Blog/what-is-western-black-and-white-photography",
    "/img/i-qMQf7b6/s.jpg"
  ),
  supportDockItem(
    "Learn What Makes a Fine Art Print Worth Owning",
    "/Blog/what-makes-a-fine-art-print-worth-owning",
    "/images/tombstones/print-options-ts.webp"
  ),
  supportDockItem(
    "Compare Wood Prints and Paper Prints",
    "/Blog/wood-prints-vs-paper-prints",
    "/images/tombstones/engrained-ts.webp"
  ),
  supportDockItem(
    "Compare Decor Art and Fine Art",
    "/Blog/decor-art-vs-fine-art",
    "/img/i-44jcjTQ/s.jpg"
  ),
];
const dockCenterIndex = sectionDockItems.findIndex((item: any) => item.title === "Black and White Cowboy Portraits");

const gridSections = [
  {
    title: "Black and White Cowboy Photography",
    description: "Monochrome cowboy portraits where expression, weathering, and tonal restraint carry the frontier presence.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white cowboy portrait collection",
    ctaThumb: "/img/i-DJMTZ8z/s.jpg",
    items: cowboyBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Black and White Western Narrative Photography",
    description: "Story-driven monochrome Western scenes where shadow, silence, and implication do the work of color.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white Western narrative collection",
    ctaThumb: "/img/i-mqQxwNn/s.jpg",
    items: narrativeBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Black and White Native American Portraits",
    description: "Painterly monochrome Native American portraits built around presence, heritage, atmosphere, and tonal quiet.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White/all#collection-browser",
    ctaLabel: "See the full black and white Native American portrait collection",
    ctaThumb: "/img/i-Z54nXZm/s.jpg",
    items: nativeBlackWhiteItems,
    limit: 19,
  },
];

const countLiveItems = (sections: typeof gridSections) =>
  sections.reduce((total, section) => total + section.items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  ).length, 0);
const westernBlackWhiteLiveCount = countLiveItems(gridSections);

const commercialMiddleCopy = [
  "Western black and white photography at K4 Studios is built around restraint: faces, posture, weathered clothing, window light, frontier interiors, and the tonal pressure that remains when color is removed.",
  "Start with the cowboy portrait section when the work needs human gravity and direct presence. Move into the narrative section for old-West tension and story-led scenes. Continue into the Native American portrait section for monochrome work shaped by atmosphere, heritage, and quiet authority.",
  "Size, substrate, and edition details are inside each image page.",
].join("\n\n");

const copy = {
  seoTitle: "Western Black and White Photography - Fine Art Prints by Wayne Heim",
  seoDescription:
    "Western black and white photography prints by Wayne Heim - cowboy portraits, frontier narratives, and Native American portrait work where tonal restraint carries more pressure than color alone. Archival prints from $25 through signed limited editions.",
  indexDefinition:
    "Wayne Heim's Western black and white photography includes monochrome cowboy portraits, black and white Western narrative scenes, and painterly Native American portrait work created as collector-grade fine art prints.",
  indexLinkNote:
    "This is the K4 commercial route for Western black and white photography, black and white cowboy photography, monochrome Western art, and black and white Western wall art.",
  printAvailabilityNote: `Western black and white photography prints are available from ${getFormattedLowestStandardPrintPrice()} across archival paper and select wood presentations. Edition status and format options are shown on individual image pages.`,
  commercialH1: `The Collection - Three Monochrome Series, ${westernBlackWhiteLiveCount} Works`,
  commercialDeck:
    `${westernBlackWhiteLiveCount} black and white Western photographs - cowboy portraits, frontier narrative scenes, and Native American portrait studies organized for collectors, rooms, and tonal decisions.`,
  catalogEntranceTitle: "Western Black and White Photography, Cowboy Portraits, and Monochrome Western Art",
  catalogEntranceCopy:
    "Browse black and white Western photography prints, monochrome cowboy portraits, black and white frontier scenes, and Native American portrait work created as collector-grade fine art.",
  collectionIntro: commercialMiddleCopy,
  breadcrumbCurrentName: "Western Black and White Photography",
  aggregateOfferLowPrice: "25",
  aggregateOfferHighPrice: "5000",
  aggregateOfferCount: String(westernBlackWhiteLiveCount),
  gatewayCollectionName: "Western Black and White Photography",
  gatewayIntroCopy:
    "Western black and white photography prints by Wayne Heim - monochrome cowboy portraits, frontier narrative scenes, and Native American portrait work for living rooms, offices, lodges, ranch interiors, hospitality spaces, and collector walls.",
  gatewaySupportingCopy:
    `These works begin as photography, then are shaped through Heim's painterly process into fine art with tonal depth, human presence, and the atmospheric restraint that monochrome demands. The collection opens with the Sketch Series, 5x7 archival prints from ${getFormattedLowestStandardPrintPrice()} - sized for shelves, desks, and introductory collecting. It scales through open-edition Foundation works, signed Chronicle editions with numbered certificates, and ultra-limited Legend pieces for collectors who want permanence on the wall.\n\nClick into any section to compare prints, read the image story, and view collector and sizing details.`,
  gatewayKicker: "K4 Studios - Western Black and White Fine Art Print Catalog",
  gatewayHeroTitle: "Western Black and White Photography by Wayne Heim",
  gatewayHeroAlt:
    "Black and white cowboy photography print with tonal restraint and painterly Western fine art presence.",
  gatewayHeroHref:
    "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/i-DJMTZ8z",
  gatewayHeroSrc: "/img/i-DJMTZ8z/m.jpg",
  gatewayHeroSrcSet: "/img/i-DJMTZ8z/s.jpg 400w, /img/i-DJMTZ8z/m.jpg 720w",
  archiveContextCopy:
    "Every work on this page is available as a fine art print - with the Sketch Series opening at $25. Click into any image to read the story, compare print options, sizes, and collector details. Questions about a specific piece? Reach Wayne directly at <a href='mailto:wayne@k4studios.com'>wayne@k4studios.com</a>.",
  faqKicker: "Print & Collector Questions",
  faqTitle: "Western Black and White Photography FAQ",
};
---

<CommercialDoorwayAllPage
  rawGalleryData={cowboyBlackWhiteItems}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Explore Western Black and White Photography Collections"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West",
    categoryName: "Wild West",
  }}
  identity={{
    collectionName: "Western Black and White Photography",
    variantName: "Fine Art Prints",
    variantDescriptor: "western black and white photography",
    gatewayBrandLabel: "Western Black and White Photography - Fine Art Prints by Wayne Heim",
  }}
  copy={copy}
  faqItems={westernBlackWhiteFAQ}
  gridSections={gridSections}
  dockVariant="wall-art"
/>
