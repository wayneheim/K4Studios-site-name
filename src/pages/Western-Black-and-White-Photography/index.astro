---
export const prerender = true;
import BaseLayout         from '@/layouts/BaseLayout.astro';
import LandingHeader      from '@/components/Landing-Header.jsx';
import ImageBar2          from '@/components/ImageBar2.jsx';
import TombstoneNav       from '@/components/TombstoneNav.jsx';
import LandingRightImages from '@/components/LandingRightImages.jsx';
import FAQAccordion       from '@/components/FAQAccordion.jsx';
import SiteFooter         from '@/components/Footer.astro';
import MobileStoryImages  from '@/components/MobileStoryImages.jsx';
import StorySlider        from '@/components/StorySlider.tsx';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';

// B/W Western gallery data (for StorySlider + structured data)
import { galleryData as cowboyBWData }
  from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs';
import { storySliderImageIds } from '@/data/storySlider.ts';

import { getStructuredData, getBreadcrumbList } from '@/components/utils/getStructuredData.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';

import { siteNav } from '@/data/siteNav.ts';
import { getFeatheredImages } from '@/components/utils/getFeatheredImages.ts';
import { autoLinkKeywordsInText } from '@/components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '@/data/semantic/K4-Sem.ts';

// ✅ HUB-SCOPED DATA SOURCES
import { landingWestern }
  from '@/data/Western-Black-and-White-Photography/landingstones.ts';
import { bwWesternStory as westernStory }
  from '@/data/Western-Black-and-White-Photography/story.ts';
import { bwWesternFAQ as facingFAQ }
  from '@/data/Western-Black-and-White-Photography/faq.ts';

import '@/styles/global.css';
import '@/styles/oneupheader.css';

// ----------------------
// PATHS
// ----------------------

// ✅ The actual page URL
const pagePath = "/Western-Black-and-White-Photography";
const pageTitle = 'Western Black and White Photography | Cowboy and Frontier Images';
const pageDescription = 'Western black and white photography captures the American West through light, shadow, and form, with monochrome cowboy portraits and frontier images shaped by character, contrast, and atmosphere.';

// ✅ B/W gallery path for image sourcing
const imageSectionPath =
  "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White";

// ----------------------
// STORY SLIDER DATA (B/W images that match storySlider IDs)
// ----------------------
const bwStoryData = cowboyBWData
  .filter((img: any) => storySliderImageIds.includes(img.id))
  .map((img: any) => ({ id: img.id, title: img.title, story: img.story }));

// ----------------------
// NAV HELPERS
// ----------------------
function findNavEntry(nav: any[], url: string): any | null {
  for (const entry of nav) {
    if (entry.href === url) return entry;
    if (entry.children) {
      const found = findNavEntry(entry.children, url);
      if (found) return found;
    }
  }
  return null;
}

// B/W gallery only
const galleryPaths: string[] = [imageSectionPath];

// Load galleryData for those galleryPaths
const allGalleryData = import.meta.glob('../../data/Galleries/**/*.mjs', { eager: true }) as any;
const galleryDatas = galleryPaths.map((path) => {
  const filePath = "../../data/Galleries" + path.replace(/^\/Galleries/, "") + ".mjs";
  return allGalleryData[filePath]?.galleryData || [];
});

// Feathering uses headingCount to decide how many it needs
const headingCount = westernStory.filter((block: any, i: number) => i > 0 && block.subhead).length;

// ✅ Feathered images: B/W Western only
const featheredImages = getFeatheredImages({
  sectionPath: imageSectionPath,
  headingCount: Math.max(headingCount, 9),
  galleryDatas,
  galleryPaths,
  minRating: 3,
  fallbackMin: 1,
  poolMultiplier: 3
});
// Pass full pool to component for client-side rotation

// ----------------------
// STRUCTURED DATA
// ----------------------
const landingDescription =
  landingWestern.subtitle || (landingWestern as any)?.description || "";

const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingWestern.title,
    description: landingDescription,
    url: `https://k4studios.com${pagePath}`,
    keywords: landingWestern.keywords || [],
    copyrightNotice: "© Wayne Heim",
    about: [
      { "@type": "Thing", name: "Western Black and White Photography" },
      { "@type": "Thing", name: "Monochrome Photography" },
      { "@type": "Thing", name: "Cowboy Portraiture" },
      { "@type": "Thing", name: "American West" },
      { "@type": "Thing", name: "Fine Art Photography" },
    ],
    genre: "Western Black and White Photography",
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    acquireLicensePage: "https://k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

// ----------------------
// BREADCRUMB STRUCTURED DATA
// ----------------------
const breadcrumbData = getBreadcrumbList([
  { name: "Home", item: "https://k4studios.com/" },
  { name: "Western Black and White Photography", item: `https://k4studios.com${pagePath}` },
]);

// ----------------------
// FAQ STRUCTURED DATA
// ----------------------
const stripHtml = (text: string) => text.replace(/<[^>]*>/g, '').trim();

const faqStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `https://k4studios.com${pagePath}#faq`,
  mainEntity: facingFAQ.slice(0, 10).map((item: any) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: stripHtml(Array.isArray(item.a) ? item.a.join(" ") : item.a),
    },
  })),
}, null, 2);

// ----------------------
// WEBPAGE SCHEMA
// ----------------------
const webPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `https://k4studios.com${pagePath}#webpage`,
  url: `https://k4studios.com${pagePath}`,
  name: "Western Black and White Photography",
  description: "Western black and white photography by Wayne Heim featuring dramatic monochrome cowboy portraits and frontier imagery with timeless depth.",
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    "@id": "https://k4studios.com/#website",
    name: "K4 Studios",
    url: "https://k4studios.com/"
  },
  about: [
    { "@type": "Thing", name: "Western Black and White Photography" },
    { "@type": "Thing", name: "Monochrome Fine Art" },
    { "@type": "Thing", name: "Cowboy Portraiture" },
    { "@type": "Thing", name: "American West" },
    { "@type": "Thing", name: "Narrative Photography" },
  ],
  author: { "@id": "https://k4studios.com/#person" },
  creator: { "@id": "https://k4studios.com/#person" },
  copyrightHolder: { "@id": "https://k4studios.com/#person" },
  mainEntity: { "@id": `https://k4studios.com${pagePath}#imagegallery` },
}, null, 2);

// OG/Twitter image
function makeAbsoluteUrl(src?: string) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) return src;
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

// Proxy URL helper - ensures SmugMug URLs never appear in SSR HTML
function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return `/img/${imageId}/${size}.jpg`;
}

function pickAltTemplate(img: any, baseTitle: string) {
  const templates = [
    `${baseTitle} in western black and white photography shaped by light, shadow, and atmosphere`,
    `${baseTitle}, a black and white cowboy photography image centered on character and contrast`,
    `${baseTitle} in monochrome Western photography with portrait-driven storytelling`,
  ];
  const hash = String(img.id || baseTitle)
    .split('')
    .reduce((sum, char) => sum + char.charCodeAt(0), 0);
  return templates[hash % templates.length];
}

function findImage(data: any[], id: string) {
  const image = (data || []).find((item: any) => item.id === id && item.visibility !== 'ghost');
  if (!image) {
    throw new Error(`Missing gallery image for black and white western photography page: ${id}`);
  }
  return image;
}

function makeTile(data: any[], id: string, hrefBase: string, category: string, fallback: string) {
  const img = findImage(data, id);
  const title = (img.title || fallback || '').trim();
  return {
    id: img.id,
    title,
    alt: pickAltTemplate(img, title),
    href: `${hrefBase}/${img.id}`,
    category,
  };
}

const featuredTiles = [
  makeTile(cowboyBWData, 'i-HfQ5NVR', imageSectionPath, 'Black and White Cowboy Photography', 'Black and white cowboy portrait'),
  makeTile(cowboyBWData, 'i-qMQf7b6', imageSectionPath, 'Black and White Cowboy Photography', 'Black and white cowboy portrait'),
  makeTile(cowboyBWData, 'i-SwhsL2h', imageSectionPath, 'Black and White Cowboy Photography', 'Black and white frontier portrait'),
  makeTile(cowboyBWData, 'i-W73hxx4', imageSectionPath, 'Black and White Cowboy Photography', 'Black and white cowgirl portrait'),
  makeTile(cowboyBWData, 'i-FnZ68h3', imageSectionPath, 'Black and White Cowboy Photography', 'Black and white cowboy portrait'),
  makeTile(cowboyBWData, 'i-dLDF4Q6', imageSectionPath, 'Black and White Cowboy Photography', 'Black and white frontier portrait'),
  makeTile(cowboyBWData, 'i-5s8Zkrb', imageSectionPath, 'Black and White Cowboy Photography', 'Black and white frontier portrait'),
  makeTile(cowboyBWData, 'i-ffzG95X', imageSectionPath, 'Black and White Cowboy Photography', 'Black and white western portrait'),
];

const landingImg = featheredImages[0];
const landingImgUrl = landingImg?.id ? makeAbsoluteUrl(getProxySrc(landingImg.id, 'l')) : '';

const meta = getLandingMeta(pagePath, landingImgUrl);
meta.title = pageTitle;
meta.description = pageDescription;
meta.ogTitle = pageTitle;
meta.ogDescription = pageDescription;
meta.twitterTitle = pageTitle;
meta.twitterDescription = pageDescription;
if (!meta.ogUrl) meta.ogUrl = `https://k4studios.com${pagePath}`;
if (!meta.twitterUrl) meta.twitterUrl = `https://k4studios.com${pagePath}`;

// ----------------------
// TOMBSTONE THUMBNAILS (all B&W, hardcoded)
// ----------------------
const tombstonesWithThumbs = landingWestern.tombstones.map((stone: any) => ({
  ...stone,
  thumbs: [stone.thumb],
}));
---

<BaseLayout
  title={pageTitle}
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbData}
  meta={meta}
>
  <!-- FAQ Structured Data for rich snippets -->
  <script type="application/ld+json" set:html={faqStructuredData} slot="head"></script>
  <!-- WebPage Schema -->
  <script type="application/ld+json" set:html={webPageSchema} slot="head"></script>

  <!-- Article Structured Data for topical authority -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Western Black and White Photography: Monochrome Portraits of the American West",
    "author": {
      "@type": "Person",
      "name": "Wayne Heim"
    },
    "publisher": {
      "@type": "Organization",
      "name": "K4 Studios",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.k4studios.com/images/k4-logo.png"
      }
    },
    "description": "A comprehensive guide to western black and white photography — what it is, its historical roots in frontier documentation, the painterly monochrome process, and how contrast reveals character in cowboy and frontier portraiture.",
    "mainEntityOfPage": "https://www.k4studios.com/Western-Black-and-White-Photography"
  }
  </script>
  
  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingWestern.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingWestern.breadcrumb} />
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">{landingWestern.title}</h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">{landingWestern.subtitle}</h2>
        <div class="page-intro fade-in reveal-on-scroll">
          <p>
            Western black and white photography captures the American West through light, shadow, and form—removing color to focus on character, contrast, and atmosphere.
          </p>
          <p>
            Often associated with black and white cowboy photography and Western portraiture, these images emphasize expression, texture, and the emotional weight of a moment rather than surface detail.
          </p>
          <p class="page-intro-links">
            Explore related work in <a href="/western-portrait-photography">Western portrait photography</a> and <a href="/cowboy-photography">cowboy photography</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="entry-grid-section">
      <div class="entry-grid-section__inner">
        <h2 class="entry-grid-title reveal-on-scroll">Black and White Western Photography: Character, Contrast, and Story</h2>
        <div class="entry-grid reveal-on-scroll">
          {featuredTiles.map((tile) => (
            <article class="entry-tile">
              <a class="entry-tile__link" href={tile.href} title={tile.title}>
                <div class="entry-tile__image-wrap">
                  <img
                    src={getProxySrc(tile.id, 'm')}
                    alt={tile.alt}
                    loading="lazy"
                    decoding="async"
                    class="entry-tile__image"
                  />
                </div>
                <div class="entry-tile__meta">
                  <p class="entry-tile__category">{tile.category}</p>
                  <h3 class="entry-tile__title">{tile.title}</h3>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="w-full max-w-[1200px] mx-auto px-4">
      <div class="carousel-fade reveal-on-scroll">
        <ImageBar2 client:load />
      </div>
    </div>

    <section class="collections-nav-section">
      <h3 class="collections-heading fade-in reveal-on-scroll">Explore the Stories of the American West</h3>
      <TombstoneNav client:load items={tombstonesWithThumbs} />
    </section>

    <section class="story-layout">
      <div class="text-column">
        <section class="story-section">
          {westernStory.map((section: any, index: number) => (
            <article class="story-block">
              {section.title && (
                <h2 class="slide-in-left" set:html={autoLinkKeywordsInText(section.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}
              {section.subhead && (
                <h3 class="slide-in-left" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}
              {section.tagline && (
                <h4 class="tagline reveal-on-scroll" set:html={autoLinkKeywordsInText(section.tagline, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}

              {section.paragraphs?.map((para: string, i: number) => (
                <p class="reveal-on-scroll" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              ))}

              {section.list && section.list.length > 0 && (
                <ul>
                  {section.list.map((item: string, j: number) => (
                    <li class="reveal-on-scroll" set:html={autoLinkKeywordsInText(item, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
                  ))}
                </ul>
              )}

              {/* Insert StorySlider (secondary variant - reduced visual weight) */}
              {index === 0 && bwStoryData.length > 0 && (
                <div class="story-slider-wrapper reveal-on-scroll mt-6">
                  <div class="story-slider-skeleton relative bg-[#f4f1ec] rounded-lg shadow-sm px-5 py-4 max-w-xl mx-auto border border-[#e0d9cf] mb-8 h-[240px] overflow-hidden opacity-90">
                    <p class="text-[10px] uppercase tracking-[0.12em] text-[#a09080] mb-3">How Story Lives in These Images</p>
                    <div class="animate-pulse">
                      <div class="h-4 bg-[#e0d9cf] rounded w-3/4 mb-3"></div>
                      <div class="h-3.5 bg-[#e0d9cf] rounded w-full mb-2"></div>
                      <div class="h-3.5 bg-[#e0d9cf] rounded w-5/6 mb-2"></div>
                      <div class="h-3.5 bg-[#e0d9cf] rounded w-4/6"></div>
                    </div>
                  </div>

                  <StorySlider
                    client:only="react"
                    stories={bwStoryData}
                    galleryPath="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White"
                    variant="secondary"
                  />
                </div>
              )}

              {section.subhead === "Why Monochrome" && (
                <div class="story-chapter-divider reveal-on-scroll" aria-hidden="true"></div>
              )}
            </article>
          ))}
        </section>

        <MobileStoryImages client:only="react" images={sanitizeForClient(featheredImages)} displayCount={headingCount} />
      </div>

      <div class="sidebar-column hidden md:block">
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages
            client:load
            heading="Collection Samples"
            images={featheredImages}
            displayCount={6}
          />
        </div>
      </div>
    </section>

    <section class="pb-10">
      <input type="checkbox" id="faq-toggle" class="more-toggle" />
      <div class="truncate-container" style="min-height:0;">
        <div class="truncate-text">
          <FAQAccordion items={facingFAQ} />
        </div>
      </div>
      <label for="faq-toggle" class="more-toggle-label"></label>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }

      const faqToggle = document.getElementById("faq-toggle");
      const truncateContainer = document.querySelector(".truncate-container");
      if (truncateContainer && faqToggle) {
        truncateContainer.addEventListener("click", (e) => {
          const summaryClicked = e.target.closest("summary");
          if (summaryClicked && !faqToggle.checked) faqToggle.checked = true;
        });
      }
    });
  </script>

  <style>
    ul { list-style-type: disc; padding-left: 1.25em; }
    ul li { margin-top: 0.15em; margin-left: 1.5em; }
    ul li::marker { margin-top: 0.15em; font-size: 1.2em; color: gray; }

    @media (max-width: 768px) {
      .section-heading .page-title { font-size: 1.5rem; line-height: 1.3; }
      .section-heading .page-subtitle {
        max-width: 42ch; margin-left: auto; margin-right: auto; text-align: center;
        font-size: 1rem; line-height: 1.4; letter-spacing: -0.04em;
      }
      .section-heading-wrap { margin-top: 0.6rem; margin-bottom: 1rem; }
      .sidebar-column { display: none; }
      .story-section { letter-spacing: -0.03em; }
      .story-block h2 {
        letter-spacing: -0.05em;
        font-size: 1.4rem !important;
        margin-top: -0.59rem;
        line-height: 1.15;
      }
    }

    .fade-in {
      opacity: 0; visibility: hidden; transform: translateY(1px);
      transition: opacity 1.75s ease, transform 1.75s ease, visibility .5s linear 1.75s;
    }
    .fade-in.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }
    .page-title.fade-in { transition-delay: .2s; }

    .section-heading-wrap { margin: 0.8rem 0 1.5rem; text-align: center; }
    .section-heading .page-title { font-size: 2rem; margin-bottom: .4rem; }
    .section-heading .page-subtitle { font-size: 1rem; font-weight: 500; color: #6d5b4a; opacity: .9; }

    .story-section {
      line-height: 1.3; padding: 2rem 1.5rem; max-width: 860px; margin: 0 auto;
      font-family: 'Glegoo', serif;
    }
    .story-block { margin-bottom: 2.5rem; }
    .story-block h2 { font-weight: 500; font-size: 1.65rem; margin-bottom: 0.55rem; }
    .story-block h3 { font-weight: 500; font-size: 1.2rem; margin-top: -0.5rem; margin-bottom: -.025rem; color: #5a4a3b; }
    .story-block .tagline { font-size: 1.05rem; font-weight: 500; margin-bottom: 1rem; color: #7a6250; }
    .story-block p { line-height: 1.6; margin-bottom: 1rem; font-size: 1.01rem; }
    .story-block ul { padding-left: 1.4rem; margin-top: 0.5rem; }
    .story-block li { margin-bottom: 0.5rem; font-size: 1rem; }

    .page-subtitle.fade-in {
      opacity: 0 !important;
      transform: translateY(-12px);
      visibility: hidden;
      transition: opacity 1.1s ease-out, transform 1.1s ease-out, visibility 0s linear 1.1s;
      transition-delay: 1s;
    }
    .page-subtitle.fade-in.is-visible {
      opacity: 1 !important;
      transform: translateY(0);
      visibility: visible;
      transition-delay: 1s;
    }

    .carousel-fade {
      opacity: 0; transform: translateY(0px);
      transition: opacity 1.5s ease-out, transform 1.5s ease-out;
      transition-delay: 0.0s;
      visibility: hidden;
    }
    .carousel-fade.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }

    .sample-fade {
      opacity: 0; transform: translateY(0px);
      transition: opacity 1.5s ease-out, transform 1.5s ease-out;
      transition-delay: 0.2s;
      visibility: hidden;
      margin-top: -0.75rem;
    }
    .sample-fade.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }

    .page-intro {
      max-width: 900px;
      margin: 0.6rem auto 0;
      font-family: 'Glegoo', serif;
      text-align: center;
      opacity: 0.92;
    }
    .page-intro p {
      margin: 0 0 0.7rem;
      font-size: 1.02rem;
      line-height: 1.55;
      color: #6d5b4a;
    }
    .page-intro p:last-child { margin-bottom: 0; }
    .page-intro a {
      color: #8b5a2b;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    @media (max-width: 768px) {
      .page-intro { padding: 0 1rem; max-width: 90%; }
      .page-intro p { font-size: 0.95rem; }
    }

    .entry-grid-section {
      padding: 0.25rem 1rem 2rem;
    }
    .entry-grid-section__inner {
      max-width: 1180px;
      margin: 0 auto;
    }
    .entry-grid-title {
      margin: 0 0 1rem;
      font-size: 1.45rem;
      line-height: 1.2;
      color: #2f241b;
      text-align: center;
      font-family: 'Glegoo', serif;
      font-weight: 500;
    }
    .entry-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
    .entry-tile {
      margin: 0;
      background: #fbfaf7;
      border: 1px solid #e7ddd3;
      border-radius: 12px;
      overflow: hidden;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .entry-tile__link {
      display: block;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }
    .entry-tile:hover {
      transform: translateY(-2px);
      border-color: #cfbea8;
      box-shadow: 0 8px 24px rgba(44, 33, 24, 0.08);
    }
    .entry-tile__image-wrap {
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: #efe8de;
    }
    .entry-tile__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.25s ease;
    }
    .entry-tile:hover .entry-tile__image {
      transform: scale(1.02);
    }
