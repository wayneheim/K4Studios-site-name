---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedReadingSection from '@/components/FeaturedReadingSection.astro';
import LandingHeader from '@/components/Landing-Header.jsx';
import ImageBar2 from '@/components/ImageBar2.jsx';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';
import SiteFooter from '@/components/Footer.astro';

import { galleryData as wildWestNarrativesData } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs';
import { slides as wildWestSlides } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/carousel';

import { getStructuredData, getBreadcrumbList } from '@/components/utils/getStructuredData.ts';
import { getOrderedWesternGalleryPaths } from '@/data/carousel/westernRouting.ts';
import { getFeatheredImages } from '@/components/utils/getFeatheredImages.ts';
import { autoLinkKeywordsInText } from '@/components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '@/data/semantic/K4-Sem.ts';

import '@/styles/global.css';
import '@/styles/oneupheader.css';

const pagePath = '/western-storytelling-photography';
const imageSectionPath = '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color';
const wildWestGridBasePath = '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color';

const landingStorytelling = {
  title: 'Western Storytelling Photography',
  subtitle: 'Story-driven Western photography where one frame holds the moment before, the moment after, and the pressure in between.',
  keywords: [
    'western storytelling photography',
    'storytelling photography western',
    'narrative western photography',
    'western fine art photography',
    'one-image movie',
    'cinematic western photography',
    'painterly western photography',
    'western narrative art',
    'western fine art prints',
  ],
  breadcrumb: `
    <a
      href="/Galleries/Painterly-Fine-Art-Photography/Facing-History?focus=frontier"
      style="
        color: inherit;
        text-decoration: none;
        cursor: pointer;
        pointer-events: auto;
        position: relative;
        z-index: 9999;
        transition: color 0.2s ease;
      "
      onmouseover="this.style.color='darkred'"
      onmouseout="this.style.color='inherit'"
    >
      Facing History
    </a>
    |
    <a
      href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West"
      style="
        color: inherit;
        text-decoration: none;
        cursor: pointer;
        pointer-events: auto;
        position: relative;
        z-index: 9999;
        transition: color 0.2s ease;
      "
      onmouseover="this.style.color='darkred'"
      onmouseout="this.style.color='inherit'"
    >
      Wild West
    </a>
    | Western Storytelling Photography
  `,
};

const storytellingStory = [
  {
    title: 'Western Storytelling Photography',
    subhead: 'Frames that refuse to finish themselves.',
    paragraphs: [
      `Western storytelling photography is a form of narrative photography that constructs story through composition, light, and subject placement rather than explicit action or sequence. A single frame carries a before and after, inviting the viewer to complete what is not shown.`,
      `The moment does not settle. Something has already happened. Something else is coming. You feel both before you can name either one.`,
      `That pressure sits at the center of this work. Light, spacing, gesture, and atmosphere do the telling, so the image lands as a lived moment rather than a solved explanation.`,
      `This is not caption-first storytelling. It is story carried by the structure of the image itself, where implication holds longer than information, and the frame continues moving after it stands still.`
    ],
  },
  {
    subhead: 'The One-Image Movie',
    paragraphs: [
      `Here, storytelling is not built through sequence but through implication. A single photograph behaves like a larger chapter because it holds narrative tension inside the frame.`,
      `This is what defines the <strong>One-Image Movie™</strong> - a still image constructed with cinematic restraint, where what is withheld carries as much weight as what is shown.`,
      `The strongest storytelling images do not over-perform. A turn of the shoulder, a held expression, distance between figures, or a strip of light across the ground can carry more consequence than visible action.`,
      `The image does not resolve its story. It creates the conditions for one-and leaves it active in the viewer's mind.`
    ],
  },
  {
    subhead: 'Ground Under the Myth',
    paragraphs: [
      `Western storytelling photography draws from a longer visual tradition shaped by narrative painters and illustrators who built story through structure rather than spectacle.`,
      `Like Remington, Russell, and Wyeth, the image is anchored in human stakes beneath the legend, where atmosphere, environment, and posture help carry the narrative.`,
      `The West is not treated as shorthand or nostalgia. It is held against weather, silence, endurance, and the lived texture of frontier life, which keeps the work from collapsing into genre theater and lets myth remain with weight.`
    ],
  },
];

const storytellingFaq = [
  {
    q: 'What is Western storytelling photography?',
    a: [
      `Western storytelling photography is Western fine art photography built around implication, atmosphere, and consequence rather than simple description. The image suggests what happened before the frame and what may happen after it.`,
      `In Wayne Heim's work, Western storytelling photography uses light, gesture, distance, and restraint to make a still image behave like part of a larger lived moment.`
    ],
  },
  {
    q: 'What makes a Western photograph feel like a story?',
    a: [
      `You feel a before and after inside the frame. The image lands in the middle of pressure rather than arriving as a closed statement.`,
      `Light, distance, posture, and what stays outside the frame usually do more than overt action. The story is implied, not explained.`
    ],
  },
  {
    q: 'Do storytelling photographs need visible action?',
    a: [
      `No. Stillness often carries more weight than motion because it keeps the tension open instead of resolving it immediately.`,
      `A held look, a body turned half away, or a figure pressed against space can feel more narrative than a staged burst of action.`
    ],
  },
  {
    q: 'Is Western storytelling photography the same as documentary photography?',
    a: [
      `No. Documentary work witnesses what is there. Storytelling photography shapes atmosphere, implication, and emotional pressure inside the frame.`,
      `Both can carry truth, but this work leans on authorship, restraint, and the one-image movie rather than straight record.`
    ],
  },
  {
    q: 'What does One-Image Movie mean here?',
    a: [
      `<strong>One-Image Movie™</strong> describes a still frame that behaves like a larger scene. The viewer senses what came before, what may come after, and what is at stake in between.`,
      `The image remains complete, but it does not feel finished. That unfinished pressure is the point.`
    ],
  },
  {
    q: 'Why does atmosphere matter so much in this work?',
    a: [
      `Atmosphere gives the frame emotional weather. Haze, tonal falloff, silence, and distance let the picture feel larger than what it literally shows.`,
      `In Wayne Heim's Western work, atmosphere is never decoration. It is part of the story pressure.`
    ],
  },
  {
    q: 'How is this different from Western portrait photography?',
    a: [
      `Portraiture can stop at presence. Storytelling photography asks the figure to carry implication as well.`,
      `The subject still matters, but the frame is built to suggest consequence, not just likeness.`
    ],
  },
  {
    q: 'Why do these images feel cinematic without looking staged?',
    a: [
      `Because the cinematic quality comes from tension, atmosphere, and restraint rather than theatrical action. The frame suggests more than it states.`,
      `In this work, cinematic feeling comes from implication, pacing, and what the image withholds, not from overdirected performance.`
    ],
  },
  {
    q: 'Are these works available as fine art prints?',
    a: [
      `Yes. These images are offered as archival fine art prints across multiple formats, sizes, and edition levels.`,
      `See <a href='/Other/Print-Options'>Print Options</a> for materials, presentation formats, and collecting paths.`
    ],
  },
  {
    q: 'Where should I start in the work?',
    a: [
      `Start with the images that hold you longest without explaining themselves. That is usually the best signal that the storytelling structure is working.`,
      `From there, move deeper into the <a href='/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives'>Narratives Western gallery</a> and the broader <a href='/Narrative-Western-Art'>Narrative Western Art</a> page.`
    ],
  },
];

const explorationPaths = [
  {
    title: 'Painterly Photography',
    eyebrow: 'Supporting Concept',
    hideEyebrow: true,
    href: '/Blog/what-is-painterly-photography',
    description: 'A signature approach rooted in painting and narrative traditions, where images dissolve the sense of the present and draw the viewer into the moment.',
    cta: 'Learn more -',
    accent: '#6d5b4a',
  },
  {
    title: 'Western Storytelling Photography',
    eyebrow: 'The Wild West - Reimagined',
    href: '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West',
    description: 'Enter the Wild West landing page where Western storytelling photography takes shape through tension, atmosphere, implication, and frontier consequence.',
    cta: '- Explore Western storytelling photography -',
    accent: '#7b4a28',
    featured: true,
  },
  {
    title: 'Facing History',
    eyebrow: 'Supporting Collection',
    hideEyebrow: true,
    href: '/Galleries/Painterly-Fine-Art-Photography/Facing-History',
    description: 'Explore other historically grounded work where portraiture, consequence, and identity are shaped into artfully told moments from America\'s past.',
    cta: 'Explore the collection -',
    accent: '#4d4037',
  },
];

const featuredReadingItems = [
  {
    title: 'What Is Narrative Photography?',
    href: '/Blog/what-is-narrative-photography',
    description: 'Why do some images reach through the frame, grab hold, and make you slow down?',
    eyebrow: 'Guide',
  },
  {
    title: 'What Is Visual Storytelling?',
    href: '/Blog/what-is-visual-storytelling-in-photography',
    description: 'See how a still image can carry motive, tension, and meaning without ever spelling the story out.',
    eyebrow: 'Guide',
  },
  {
    title: 'What Makes an Image Feel Cinematic?',
    href: '/Blog/what-makes-an-image-feel-cinematic',
    description: 'Why does one frame feel charged with a before and after while another just sits there?',
    eyebrow: 'Guide',
  },
  {
    title: 'When the Medium Disappears',
    href: '/Blog/when-the-medium-disappears',
    description: 'What happens when you stop noticing the photograph and start feeling the moment itself?',
    eyebrow: 'Essay',
  },
];

const galleryPaths: string[] = getOrderedWesternGalleryPaths(imageSectionPath);
const allGalleryData = import.meta.glob('../../data/Galleries/**/*.mjs', { eager: true }) as any;
const galleryDatas = galleryPaths.map((path) => {
  const filePath = '../../data/Galleries' + path.replace(/^\/Galleries/, '') + '.mjs';
  return allGalleryData[filePath]?.galleryData || [];
});

const headingCount = storytellingStory.filter((block: any, index: number) => index > 0 && block.subhead).length;
const featheredImages = getFeatheredImages({
  sectionPath: imageSectionPath,
  headingCount: Math.max(headingCount, 8),
  galleryDatas,
  galleryPaths,
  minRating: 3,
  fallbackMin: 1,
  poolMultiplier: 3,
});

const leadStoryBlock = storytellingStory[0];
const secondaryStoryBlocks = storytellingStory.slice(1);
const storytellingFaqSplitIndex = Math.ceil(storytellingFaq.length / 2);
const storytellingFaqLeft = storytellingFaq.slice(0, storytellingFaqSplitIndex);
const storytellingFaqRight = storytellingFaq.slice(storytellingFaqSplitIndex);
const storytellingGridImages = wildWestNarrativesData
  .filter((item: any) => item.id !== 'i-k4studios' && item.visibility !== 'ghost' && item.visibility !== 'hidden')
  .slice(20, 32);

const stripHtml = (text: string) => text.replace(/<[^>]*>/g, '').trim();

const structuredData = getStructuredData({
  type: 'gallery',
  data: {
    title: landingStorytelling.title,
    description: landingStorytelling.subtitle,
    url: `https://www.k4studios.com${pagePath}`,
    keywords: landingStorytelling.keywords,
    copyrightNotice: '© Wayne Heim',
    about: [
      { '@type': 'Thing', name: 'Western Storytelling Photography' },
      { '@type': 'Thing', name: 'Narrative Western Photography' },
      { '@type': 'Thing', name: 'One-Image Movie' },
      { '@type': 'Thing', name: 'Cinematic Western Photography' },
    ],
    genre: 'Western Storytelling Photography',
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: '© Wayne Heim',
    license: 'https://www.k4studios.com/copyright',
    acquireLicensePage: 'https://www.k4studios.com/Other/Print-Options',
    creditText: 'Wayne Heim',
    creatorName: 'Wayne Heim',
    creatorUrl: 'https://www.k4studios.com/',
  },
});

const breadcrumbData = getBreadcrumbList([
  { name: 'Home', item: 'https://www.k4studios.com/' },
  { name: 'Facing History', item: 'https://www.k4studios.com/Galleries/Painterly-Fine-Art-Photography/Facing-History' },
  { name: 'Wild West', item: 'https://www.k4studios.com/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West' },
  { name: 'Western Storytelling Photography', item: `https://www.k4studios.com${pagePath}` },
]);

const faqStructuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `https://www.k4studios.com${pagePath}#faq`,
  mainEntity: storytellingFaq.map((item: any) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(Array.isArray(item.a) ? item.a.join(' ') : item.a),
    },
  })),
}, null, 2);

const webPageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `https://www.k4studios.com${pagePath}#webpage`,
  url: `https://www.k4studios.com${pagePath}`,
  name: landingStorytelling.title,
  description: landingStorytelling.subtitle,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://www.k4studios.com/#website',
    name: 'K4 Studios',
    url: 'https://www.k4studios.com/',
  },
  about: [
    { '@type': 'Thing', name: 'Western Storytelling Photography' },
    { '@type': 'Thing', name: 'Narrative Western Art' },
    { '@type': 'Thing', name: 'One-Image Movie' },
  ],
  author: { '@id': 'https://www.k4studios.com/#person' },
  creator: { '@id': 'https://www.k4studios.com/#person' },
  copyrightHolder: { '@id': 'https://www.k4studios.com/#person' },
  mainEntity: { '@id': `https://www.k4studios.com${pagePath}#imagegallery` },
}, null, 2);

function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return `/img/${imageId}/${size}.jpg`;
}

function makeAbsoluteUrl(src?: string) {
  if (!src) return '';
  if (src.startsWith('http://') || src.startsWith('https://')) return src;
  return `https://www.k4studios.com${src.startsWith('/') ? src : '/' + src}`;
}

const landingImg = featheredImages[0];
const landingImgUrl = landingImg?.id ? makeAbsoluteUrl(getProxySrc(landingImg.id, 'l')) : '';
const meta = {
  title: 'Western Storytelling Photography | K4 Studios',
  description: 'Western storytelling photography by Wayne Heim where one frame holds implication, atmosphere, and frontier consequence without explaining the moment away.',
  canonicalUrl: pagePath,
  ogTitle: 'Western Storytelling Photography | K4 Studios',
  ogDescription: 'Story-driven Western photography where one frame holds the moment before, the moment after, and the pressure in between.',
  ogUrl: pagePath,
  ogImage: landingImgUrl,
  twitterCard: 'summary_large_image',
  twitterImage: landingImgUrl,
};
---

<BaseLayout
  title="Western Storytelling Photography | K4 Studios"
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbData}
  meta={meta}
>
  <script type="application/ld+json" set:html={faqStructuredData} slot="head"></script>
  <script type="application/ld+json" set:html={webPageSchema} slot="head"></script>

  <main class="wallart-page bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingStorytelling.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingStorytelling.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4">
      <div class="carousel-container">
        <div class="carousel-placeholder" aria-hidden="true"></div>
        <div class="carousel-fade reveal-on-scroll">
          <ImageBar2 client:load slides={sanitizeForClient(wildWestSlides)} />
        </div>
      </div>
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">{landingStorytelling.title}</h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">{landingStorytelling.subtitle}</h2>
      </div>
    </section>

    <section class="term-section">
      <div class="term-shell">
        <div class="term-header">
          {leadStoryBlock.title && (
            <h2 class="term-header__title" set:html={autoLinkKeywordsInText(leadStoryBlock.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
          )}
        </div>

        <article class="term-block term-block--lead">
          {leadStoryBlock.subhead && (
            <h3 class="term-block__subhead" set:html={autoLinkKeywordsInText(leadStoryBlock.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
          )}
          {leadStoryBlock.paragraphs?.map((para: string) => (
            <p class="term-block__body" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
          ))}
        </article>

        {secondaryStoryBlocks.map((section: any, index: number) => (
          <article class:list={["term-block", index === 0 ? 'term-block--secondary' : 'term-block--tertiary']}>
            {section.subhead && (
              <h3 class="term-block__subhead" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
            )}
            {section.paragraphs?.map((para: string) => (
              <p class="term-block__body" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
            ))}
            {index === 1 && (
              <div class="term-block__watermark" aria-hidden="true">
                <span>The frame does not settle.</span>
                <span>It keeps opening.</span>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="exploration-section">
      <div class="exploration-shell reveal-on-scroll">
        <p class="exploration-intro">Explore Western Storytelling Photography</p>
        <div class="exploration-grid">
          {explorationPaths.map((path) => (
            <a
              href={path.href}
              class:list={["exploration-card", path.featured && 'exploration-card--featured']}
              style={`--path-accent:${path.accent};`}
            >
              {!path.hideEyebrow && <span class="exploration-card__eyebrow">{path.eyebrow}</span>}
              <h3 class="exploration-card__title">{path.title}</h3>
              <p class="exploration-card__body">{path.description}</p>
              <span class="exploration-card__cta">{path.cta}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="collection-section">
      <div class="collection-shell">
        <div class="collection-heading reveal-on-scroll">
          <p class="collection-kicker">Selected Works</p>
          <h2 class="collection-title">Selected Western Storytelling Photography</h2>
          <p class="collection-intro">Twelve images. Twelve stories held in place. A curated selection where meaning lies beneath the myths.</p>
        </div>

        <div class="wallart-grid reveal-on-scroll">
          {storytellingGridImages.map((item: any) => (
            <a href={`${wildWestGridBasePath}/${item.id}`} class="wallart-grid__tile" title={item.title}>
              <div class="wallart-grid__img-wrap">
                <img
                  src={getProxySrc(item.id, 'm')}
                  data-fallback-src={getProxySrc(item.id, 'l')}
                  alt={item.alt || `Western storytelling photography by Wayne Heim: ${item.title}`}
                  loading="lazy"
                  onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) { this.src = this.dataset.fallbackSrc; }"
                  width="400"
                  height="400"
                  class="wallart-grid__img"
                />
                <span class="wallart-grid__hover">View Image</span>
              </div>
              <p class="wallart-grid__title">{item.title}</p>
            </a>
          ))}
        </div>

      </div>
    </section>

    <FeaturedReadingSection
      title="Exploring Cornerstones, Context and Ideas"
      intro="Expanding horizons by looking past the surface labels into what defines the work. These essays and guides push deeper into story, atmosphere, seeing, and why certain images refuse to let go."
      items={featuredReadingItems}
    />

    <section class="faq-section pb-10">
      <div class="faq-shell reveal-on-scroll">
        <p class="faq-kicker">Collector Questions</p>
        <h2 class="faq-title">Western Storytelling Photography FAQ</h2>

        <div class="faq-columns">
          <div class="faq-column faq-column--left">
            <div class="faq-question-list" role="list">
              {storytellingFaqLeft.map((item: any, index: number) => (
                <button
                  type="button"
                  class="faq-question"
                  data-faq-trigger
                  data-faq-side="left"
                  data-faq-target={`faq-left-${index}`}
                  aria-expanded="false"
                >
                  <span class="faq-question__text">{item.q}</span>
                  <span class="faq-question__icon" aria-hidden="true">+</span>
                </button>
              ))}
            </div>

            <div class="faq-answer-stack">
              {storytellingFaqLeft.map((item: any, index: number) => (
                <div id={`faq-left-${index}`} class="faq-answer" data-faq-panel data-faq-side="left" hidden>
                  {item.a.map((paragraph: string) => (
                    <p set:html={paragraph} />
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="faq-column faq-column--right">
            <div class="faq-question-list" role="list">
              {storytellingFaqRight.map((item: any, index: number) => (
                <button
                  type="button"
                  class="faq-question"
                  data-faq-trigger
                  data-faq-side="right"
                  data-faq-target={`faq-right-${index}`}
                  aria-expanded="false"
                >
                  <span class="faq-question__text">{item.q}</span>
                  <span class="faq-question__icon" aria-hidden="true">+</span>
                </button>
              ))}
            </div>

            <div class="faq-answer-stack">
              {storytellingFaqRight.map((item: any, index: number) => (
                <div id={`faq-right-${index}`} class="faq-answer" data-faq-panel data-faq-side="right" hidden>
                  {item.a.map((paragraph: string) => (
                    <p set:html={paragraph} />
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="faq-overlay faq-overlay--left" data-faq-overlay="left" hidden></div>
          <div class="faq-overlay faq-overlay--right" data-faq-overlay="right" hidden></div>
        </div>

        <div class="faq-header-logo">
          <a href="/" class="faq-header-logo__link" aria-label="Home">
            <img src="/images/K4Logo-web.webp" alt="K4 Studios home" loading="lazy" decoding="async" />
          </a>
        </div>
        <p class="faq-tagline">"History, lives, and hidden moments — experienced within a single image."</p>
      </div>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const els = document.querySelectorAll('.reveal-on-scroll, .slide-in-left');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }

      const faqTriggers = Array.from(document.querySelectorAll('[data-faq-trigger]'));
      const faqPanels = Array.from(document.querySelectorAll('[data-faq-panel]'));
      const faqOverlays = Array.from(document.querySelectorAll('[data-faq-overlay]'));
      const isMobileFaq = () => window.matchMedia('(max-width: 768px)').matches;

      const closeAllFaqPanels = () => {
        faqTriggers.forEach((trigger) => {
          trigger.setAttribute('aria-expanded', 'false');
          const icon = trigger.querySelector('.faq-question__icon');
          if (icon) icon.textContent = '+';
        });

        faqPanels.forEach((panel) => {
          panel.hidden = true;
          panel.classList.remove('is-open');
        });

        faqOverlays.forEach((overlay) => {
          overlay.hidden = true;
          overlay.classList.remove('is-open');
          overlay.innerHTML = '';
        });

        document.querySelectorAll('.faq-mobile-answer').forEach((node) => node.remove());
      };

      faqTriggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const targetId = trigger.getAttribute('data-faq-target');
          const targetPanel = targetId ? document.getElementById(targetId) : null;
          const triggerSide = trigger.getAttribute('data-faq-side');
          const overlaySide = triggerSide === 'left' ? 'right' : 'left';
          const overlay = document.querySelector(`[data-faq-overlay="${overlaySide}"]`);
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          const mobileMode = isMobileFaq();

          closeAllFaqPanels();
          if (!targetPanel || isOpen) return;

          trigger.setAttribute('aria-expanded', 'true');
          const icon = trigger.querySelector('.faq-question__icon');
          if (icon) icon.textContent = '−';

          const questionText = trigger.querySelector('.faq-question__text')?.textContent || '';

          if (mobileMode) {
            const inlineAnswer = document.createElement('div');
            inlineAnswer.className = 'faq-answer faq-mobile-answer is-open';
            inlineAnswer.innerHTML = `
              <p class="faq-overlay__eyebrow">Answer</p>
              <h3 class="faq-overlay__title">${questionText}</h3>
              <div class="faq-overlay__content">${targetPanel.innerHTML}</div>
            `;
            trigger.insertAdjacentElement('afterend', inlineAnswer);
            return;
          }

          if (!overlay) return;

          overlay.innerHTML = `
            <div class="faq-overlay__inner">
              <p class="faq-overlay__eyebrow">Answer</p>
              <h3 class="faq-overlay__title">${questionText}</h3>
              <div class="faq-overlay__content">${targetPanel.innerHTML}</div>
            </div>
          `;
          overlay.hidden = false;
          overlay.classList.add('is-open');
        });
      });

    });
