---

import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import GalleryShell from '../../../../../../components/GalleryShell-Roaring20s-BW.astro';
import { entranceData as BWEntranceData } from "../../../../../../data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/BWEntranceData.ts";
import { galleryData } from '../../../../../../data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White.mjs';
import { getImageMeta } from '../../../../../../components/utils/getImageMeta.ts';
import { getLandingMeta } from '../../../../../../data/landingMeta.ts';

export async function getStaticPaths() {
  return galleryData.map(img => ({
    params: { id: img.id },
  }));
}

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);
if (!imageData) throw new Error(`Image with id ${id} not found.`);

// Get parent gallery meta for fallback
const parentMeta = getLandingMeta("/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White");
const meta = getImageMeta(id, [{ images: galleryData, meta: parentMeta }], parentMeta);
---

<BaseLayout meta={meta}>
  <GalleryShell 
    breadcrumb={BWEntranceData.breadcrumb} 
    entranceData={BWEntranceData}
    initialImageId={id}
  />
</BaseLayout>
