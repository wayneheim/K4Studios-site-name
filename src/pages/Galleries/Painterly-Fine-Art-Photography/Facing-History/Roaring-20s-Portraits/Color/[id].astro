---
export const prerender = true;

import GalleryShell from '../../../../../../components/GalleryShell-Roaring20s-Color.astro';
import { entranceData as ColorEntranceData } from "../../../../../../data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/ColorEntranceData.ts";
import { galleryData } from '../../../../../../data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color.mjs';

// Generate static paths for all visible images at build time
export async function getStaticPaths() {
  return galleryData
    .filter(img => img.visibility !== 'hidden' && img.visibility !== 'hide' && !['hidden', 'hide', 'ghost', 'non', 'none', ''].includes(String(img.visibility ?? 'show').trim().toLowerCase()) && img.id !== 'i-k4studios')
    .map(img => ({ params: { id: img.id } }));
}

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);

// Check if image is missing OR hidden (archived images stay in gallery with visibility: "hidden")

---

<GalleryShell 
  breadcrumb={ColorEntranceData.breadcrumb} 
  entranceData={ColorEntranceData}
  initialImageId={id}
/>
