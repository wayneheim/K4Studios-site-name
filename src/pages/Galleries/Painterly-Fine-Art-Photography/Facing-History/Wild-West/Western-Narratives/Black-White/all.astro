---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/BWEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White";
const canonicalPath = `${basePath}/all`;
const variantDescriptor = "black and white";

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives">Western Narratives</a>',
  `<a href="${basePath}">Black &amp; White</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives", name: "Western Narratives" },
  { href: basePath, name: "Black & White" },
];

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey: "western-narrative-bw",
  currentHref: canonicalPath,
});

const copy = {
  seoTitle: "Black and White Western Photos & Narrative Art Prints - Wayne Heim",
  seoDescription:
    "Browse {imageCount} black and white western photos and Wild West narrative art prints by Wayne Heim. Monochrome frontier scenes and cowboy pictures from the small-works \"Sketch Series\" at $25. Collector notes on every image.",
  indexDefinition:
    `This page presents the complete ${variantDescriptor} archive of Western Narratives by Wayne Heim. The collection gathers story-driven frontier images in monochrome, built around implication, silence, and the emotional pressure of what lies just outside the frame.`,
  indexLinkNote: "All {imageCount} images open to individual artwork pages with full narrative context, metadata, and collector information.",
  printAvailabilityNote: `All works are available as fine art prints from the small-works \"Sketch Series\" at ${getFormattedLowestStandardPrintPrice()} through ultra-limited signed collector editions. Select images are also available in the Engrained Series - produced on Baltic Birch with a five-layer UV process - with image-specific pricing.`,
  commercialH1: "Black and White Western Narrative Photography Collection",
  commercialDeck: "{imageCount} black and white Wild West cowboy pictures and frontier scenes by Wayne Heim.",
  catalogEntranceTitle: "Story-Driven Fine Art Prints by Wayne Heim",
  catalogEntranceCopy: "Browse cinematic, painterly photography built as single-frame stories - artwork created for collectors who want more than decoration.",
  collectionIntro:
    "Browse the complete collection of black and white western narrative art — cowboy pictures, frontier action, open country, and the quiet moments between. Color removed. Atmosphere, gesture, and consequence remain. Each image is shaped by restraint and the tension of what happens next. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayCollectionName: "Western Narratives",
  gatewayIntroCopy:
    "{imageCount} black and white western photos and Wild West narrative art prints by Wayne Heim, available as fine art prints from the small-works \"Sketch Series\" at $25 through ultra-limited signed collector editions. Frontier scenes, cowboy pictures, action, consequence, and quiet — every image a complete story stripped to light, shadow, and human presence. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="The Wild West Black and White Narrative Stories"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives",
    categoryName: "Western Narratives",
  }}
  identity={{
    collectionName: "Western Narratives",
    variantName: "Black & White",
    variantDescriptor,
    gatewayBrandLabel: "Western Narratives Fine Art Prints - Black & White Collection",
  }}
  copy={copy}
/>
