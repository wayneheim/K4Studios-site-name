---
/**
 * Static Image Detail Page
 * 
 * All bot detection, 410s, and redirects are handled by the Cloudflare Worker.
 * This page is purely static — generated at build time for each valid image.
 */
export const prerender = true;

import GalleryShell from '@components/GalleryShell-WesternNarratives-Color.astro';
import { entranceData as ColorEntranceData } from '@data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/ColorEntranceData.ts';
import { galleryData } from '@data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs';
import { getImageMeta } from '@components/utils/getImageMeta.ts';
import { getLandingMeta } from '@data/landingMeta.ts';

// Generate static paths for all visible images at build time
export async function getStaticPaths() {
  return galleryData
    .filter((img: any) => img.visibility !== 'hidden' && img.visibility !== 'hide' && img.visibility !== 'ghost' && img.id !== 'i-k4studios')
    .map((img: any) => ({ params: { id: img.id } }));
}

const { id } = Astro.params;
const imageData = galleryData.find((img: any) => img.id === id);

if (!imageData) {
  throw new Error(`Image not found for Western Narratives Color: ${id}`);
}

const resolvedImageData = imageData;

// Ensure absolute URL (don't prepend if already absolute)
function makeAbsoluteUrl(src: string) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) {
    return src;
  }
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

const imgUrl = makeAbsoluteUrl(resolvedImageData.src);

// Get parent gallery meta, override with correct image URL
const parentMeta = getLandingMeta(
  "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color",
  imgUrl
);

const canonicalUrl = `https://www.k4studios.com${Astro.url.pathname.replace(/\/$/, '')}`;
const meta = getImageMeta(id, [{ images: galleryData, meta: parentMeta }], parentMeta, canonicalUrl);
---

<GalleryShell 
  breadcrumb={ColorEntranceData.breadcrumb} 
  entranceData={ColorEntranceData}
  initialImageId={id}
  currentImageUrl={imgUrl}
  title={meta.title}
/>
