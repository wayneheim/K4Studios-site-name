---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color";
const canonicalPath = `${basePath}/all`;

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives">Western Narratives</a>',
  `<a href="${basePath}">Color</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives", name: "Western Narratives" },
  { href: basePath, name: "Color" },
];

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey: "western-narrative-color",
  currentHref: canonicalPath,
});

const copy = {
  seoTitle: "Color Western Narrative Art Prints | Wild West Cowboy Photography | K4 Studios",
  seoDescription:
    "Browse {imageCount} color Wild West narrative art prints by Wayne Heim — cowboy pictures, frontier scenes, and western storytelling photography from $25. Collector notes on every image.",
  indexDefinition:
    "This page presents the complete color archive of Western Narratives by Wayne Heim. The collection gathers story-driven frontier images built around implication, silence, and the emotional pressure of what lies just outside the frame.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  printAvailabilityNote: `All works are available as fine art prints from ${getFormattedLowestStandardPrintPrice()}. Select images are also available in the Engrained Series - printed on Baltic Birch using a five-layer UV process - with pricing specific to each image.`,
  commercialH1: "Color Western Narrative Photography Collection",
  commercialDeck: "{imageCount} cinematic Wild West cowboy pictures and frontier scenes by Wayne Heim.",
  catalogEntranceTitle: "Story-Driven Fine Art Prints by Wayne Heim",
  catalogEntranceCopy: "Browse cinematic, painterly photography built as single-frame stories - artwork created for collectors who want more than decoration.",
  collectionIntro:
    "Browse the complete collection of color western narrative art — cowboy portraits, frontier action, saloon scenes, open country, and the quiet moments between. Each image is shaped by atmosphere, gesture, and the tension of what happens next. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayCollectionName: "Western Narratives",
  gatewayIntroCopy:
    "{imageCount} color Wild West narrative art prints by Wayne Heim, available as archival fine art from $25. Cowboy pictures, frontier scenes, action, consequence, and quiet — every image a complete western story in a single frame. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="The Wild West Color Narrative Stories"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives",
    categoryName: "Western Narratives",
  }}
  copy={copy}
/>
