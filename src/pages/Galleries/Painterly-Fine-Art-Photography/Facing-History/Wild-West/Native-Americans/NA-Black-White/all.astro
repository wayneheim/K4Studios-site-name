---
export const prerender = false;
/**
 * Native Americans / NA-Black-White all page
 * Template-adapted from the Western Narratives color all page.
 */
import Footer from '@/components/Footer.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchiveContext from '@/components/ArchiveContext.astro';
import LandingHeader from '@/components/Landing-Header.jsx';
import { getSemanticImageUrl } from '@/utils/imageProxy.js';
import { getCollectionImageGalleryGraph } from '@/components/utils/getStructuredData.ts';
import {
  getAggregateOfferForCollection,
  getHighestStandardPrintPrice,
  getFormattedLowestStandardPrintPrice,
  getLowestStandardPrintPrice,
  getStandardPrintSeries,
} from '@/data/pricing/printSeries.js';

import { galleryData as rawGalleryData } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White.mjs';
import { galleryData as narrativeRawGalleryData } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs';
import { entranceData } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/BWEntranceData.ts';
import { buildWildWestAllPageDock } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts';

const activeThemeSlug = Astro.url.searchParams.get('theme') || '';
const isNaNarrativeTheme = activeThemeSlug === 'na-narrative-b-w-images';

const sourceGalleryData = isNaNarrativeTheme ? narrativeRawGalleryData : rawGalleryData;
const galleryData = sourceGalleryData.filter(
  (img: any) => img.visibility !== 'ghost' && img.visibility !== 'hidden' && img.id !== 'i-k4studios'
);

const filteredGalleryData = activeThemeSlug
  ? galleryData.filter((img: any) => Boolean(img?.themes?.[activeThemeSlug]))
  : galleryData;

const siteOrigin = 'https://www.k4studios.com';
const pageBasePath = '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White';
const contentBasePath = isNaNarrativeTheme
  ? '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White'
  : pageBasePath;
const canonicalQuery = isNaNarrativeTheme ? '?theme=na-narrative-b-w-images&view=grid' : '';
const canonicalUrl = `${siteOrigin}${pageBasePath}/all${canonicalQuery}`;

const collectionName = 'Native Americans';
const variantName = isNaNarrativeTheme ? 'Black & White Narrative Works' : 'Black & White Portraits';
const galleryTitle = `${collectionName} - ${variantName}`;
const gallerySubtitle = entranceData?.subtitle || 'Painterly Fine Art Photography';
const imageCount = filteredGalleryData.length;

const seoTitle = isNaNarrativeTheme
  ? `${collectionName} Narrative Fine Art Prints | K4 Studios`
  : `${collectionName} Fine Art Prints | K4 Studios`;
const seoDescription = isNaNarrativeTheme
  ? `Browse ${imageCount} black and white Native American narrative fine art prints by Wayne Heim, with collector notes and print options from ${getFormattedLowestStandardPrintPrice()}.`
  : `Browse ${imageCount} black and white ${collectionName.toLowerCase()} fine art prints by Wayne Heim, with collector notes and print options from ${getFormattedLowestStandardPrintPrice()}.`;

const commercialH1 = isNaNarrativeTheme
  ? 'Native American Black & White Narrative Fine Art Series'
  : 'Native American Black & White Fine Art Series';
const commercialDeck = isNaNarrativeTheme
  ? 'A collection of monochrome Native American narrative artworks by Wayne Heim.'
  : 'A collection of monochrome Native American portrait art by Wayne Heim.';
const collectionIntro = isNaNarrativeTheme
  ? 'Browse the complete black-and-white Native American narrative collection shaped by atmosphere, gesture, silence, and story pressure. Each artwork opens to its full story, collector notes, image metadata, and available print details.'
  : 'Browse the complete black-and-white collection of Native American portrait images shaped by atmosphere, gesture, silence, and tonal structure. Each artwork opens to its full story, collector notes, image metadata, and available print details.';
const gatewayCollectionName = collectionName;
const gatewayIntroCopy = isNaNarrativeTheme
  ? `${imageCount} painterly black-and-white Native American narrative fine art photographs by Wayne Heim, available as archival fine art prints from ${getFormattedLowestStandardPrintPrice()}. Four edition tiers - open-edition studies to ultra-limited signed collector works - on fine art paper and Baltic Birch wood panels.`
  : `${imageCount} painterly black-and-white Native American fine art photographs by Wayne Heim, available as archival fine art prints from ${getFormattedLowestStandardPrintPrice()}. Four edition tiers - open-edition studies to ultra-limited signed collector works - on fine art paper and Baltic Birch wood panels.`;
const gatewayBrandLabel = isNaNarrativeTheme
  ? 'Native American Narrative Fine Art Prints - Black & White Collection'
  : 'Native American Fine Art Prints - Black & White Collection';
const gatewaySupportingCopy = 'Every image below is a complete story in a single frame. Click any work to read the narrative, explore collector notes, and view print details.';
const catalogEntranceTitle = 'Story-Driven Fine Art Prints by Wayne Heim';
const catalogEntranceCopy = 'Browse cinematic, painterly photography built as single-frame stories - artwork created for collectors who want more than decoration.';
const printAvailabilityNote = `All works are available as fine art prints from ${getFormattedLowestStandardPrintPrice()}. Select images are also available in the Engrained Series - printed on Baltic Birch using a five-layer UV process - with pricing specific to each image.`;

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans">Native Americans</a>',
  `<a href="${pageBasePath}">${isNaNarrativeTheme ? 'Black &amp; White Narrative Works' : 'Black &amp; White'}</a>`,
  'Collection',
].join(' | ');

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey: isNaNarrativeTheme ? 'na-narrative-bw' : 'na-portrait-bw',
  currentHref: `${pageBasePath}/all${canonicalQuery}`,
});
const naSectionLabel = isNaNarrativeTheme ? 'Narrative Works' : 'Portraits';
const currentDockTitle = `Black and White Native American ${naSectionLabel}`;
const standardPrintSeries = getStandardPrintSeries();

const cleanForJson = (val = '') =>
  String(val)
    .replace(/[\u0000-\u001F]+/g, ' ')
    .replace(/"/g, '\\"')
    .replace(/\r?\n|\r/g, ' ')
    .trim();

const cleanForDisplay = (val = '') =>
  String(val)
    .replace(/[\u0000-\u001F]+/g, ' ')
    .replace(/\r?\n|\r/g, ' ')
    .trim();

const truncateStory = (story: string, maxLen = 150) => {
  if (!story) return '';
  const cleaned = cleanForDisplay(story);
  if (cleaned.length <= maxLen) return cleaned;
  return cleaned.slice(0, maxLen).replace(/\s+\S*$/, '') + '…';
};

const truncateWords = (text: string, maxWords = 30) => {
  const cleaned = cleanForDisplay(text);
  if (!cleaned) return '';
  const words = cleaned.split(/\s+/);
  if (words.length <= maxWords) return cleaned;
  return `${words.slice(0, maxWords).join(' ')}…`;
};

const getProxySrc = (id: string, size: string = 'l') => {
  const image = filteredGalleryData.find((item: any) => item.id === id)
    || galleryData.find((item: any) => item.id === id)
    || { id };
  return getSemanticImageUrl(image, { galleryPath: contentBasePath }, size);
};

const toAbsoluteK4Url = (url = '') => {
  if (!url) return `${siteOrigin}/images/show-2t.webp`;
  if (/^https?:\/\//i.test(url)) return url;
  return `${siteOrigin}${url.startsWith('/') ? '' : '/'}${url}`;
};

const gatewayHeroItem = filteredGalleryData[0] || galleryData[0];
const gatewayHeroTitle = cleanForDisplay(gatewayHeroItem?.title || galleryTitle);
const gatewayHeroAlt = gatewayHeroItem?.alt
  ? `${cleanForDisplay(gatewayHeroItem.alt).replace(/[.\s]*$/, '')}. Collection hero image.`
  : `Fine art photograph by Wayne Heim: ${gatewayHeroTitle}`;
const gatewayHeroHref = gatewayHeroItem ? `${contentBasePath}/${gatewayHeroItem.id}` : '#collection-grid';
const gatewayHeroSrc = gatewayHeroItem ? getProxySrc(gatewayHeroItem.id, 'l') : '';
const gatewayHeroSrcSet = gatewayHeroItem
  ? `${getProxySrc(gatewayHeroItem.id, 'm')} 720w, ${getProxySrc(gatewayHeroItem.id, 'l')} 1200w`
  : '';
const seenCardAltCounts = new Map<string, number>();
const fallbackSocialImage = '/images/show-2t.webp';
const socialImage = gatewayHeroSrc || (filteredGalleryData[0] ? getProxySrc(filteredGalleryData[0].id, 'l') : '') || fallbackSocialImage;
const socialImageUrl = toAbsoluteK4Url(socialImage);
const socialImageAlt = `${collectionName} Fine Art Prints by Wayne Heim`;
const lowestStandardPrintPrice = getLowestStandardPrintPrice();
const highestStandardPrintPrice = getHighestStandardPrintPrice();
const aggregateOffer = {
  ...getAggregateOfferForCollection(imageCount),
  lowPrice: lowestStandardPrintPrice,
  highPrice: highestStandardPrintPrice,
  offerCount: imageCount,
};

const imageJsonLdMap = new Map();
filteredGalleryData.forEach((item: any) => {
  const imageUrl = getProxySrc(item.id, 'l');
  const linkUrl = `${contentBasePath}/${item.id}`;
  const fullUrl = `https://www.k4studios.com${linkUrl}`;
  const title = cleanForJson(item.title);
  const altText = item.alt
    ? cleanForJson(item.alt)
    : `Native American black and white portrait fine art photograph: ${title} - Wayne Heim`;

  imageJsonLdMap.set(item.id, JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    name: title,
    description: altText,
    contentUrl: imageUrl,
    url: fullUrl,
    creditText: '© Wayne Heim - K4 Studios',
    license: 'https://www.k4studios.com/licensing',
    creator: { '@type': 'Person', name: 'Wayne Heim' },
    mainEntityOfPage: fullUrl,
  }));
});

const collectionImageGalleryGraph = getCollectionImageGalleryGraph({
  pageUrl: canonicalUrl,
  name: `${galleryTitle} Collection`,
  description: seoDescription,
  images: filteredGalleryData,
  basePath: contentBasePath,
});

const structuredDataJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonicalUrl + '#webpage',
      url: canonicalUrl,
      name: seoTitle,
      description: seoDescription,
      inLanguage: 'en',
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://www.k4studios.com/#website',
        name: 'K4 Studios',
        url: 'https://www.k4studios.com/',
        publisher: { '@id': 'https://www.k4studios.com/#organization' },
      },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: socialImageUrl,
        caption: seoTitle,
      },
      creator: { '@id': 'https://www.k4studios.com/#person' },
      publisher: { '@id': 'https://www.k4studios.com/#organization' },
      mainEntity: {
        '@type': 'ImageGallery',
        '@id': canonicalUrl + '#imagegallery',
        name: seoTitle,
        description: seoDescription,
        creator: { '@id': 'https://www.k4studios.com/#person' },
        publisher: { '@id': 'https://www.k4studios.com/#organization' },
      },
      offers: aggregateOffer,
    },
    ...collectionImageGalleryGraph,
    {
      '@type': 'BreadcrumbList',
      '@id': canonicalUrl + '#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, item: { '@id': 'https://www.k4studios.com/', name: 'Home' } },
        { '@type': 'ListItem', position: 2, item: { '@id': 'https://www.k4studios.com/Galleries', name: 'Galleries' } },
        { '@type': 'ListItem', position: 3, item: { '@id': 'https://www.k4studios.com/Galleries/Painterly-Fine-Art-Photography', name: 'Painterly Fine Art Photography' } },
        { '@type': 'ListItem', position: 4, item: { '@id': 'https://www.k4studios.com/Galleries/Painterly-Fine-Art-Photography/Facing-History', name: 'Facing History' } },
        { '@type': 'ListItem', position: 5, item: { '@id': 'https://www.k4studios.com/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West', name: 'Wild West' } },
        { '@type': 'ListItem', position: 6, item: { '@id': 'https://www.k4studios.com/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans', name: 'Native Americans' } },
        { '@type': 'ListItem', position: 7, item: { '@id': 'https://www.k4studios.com/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White', name: 'Black & White' } },
        { '@type': 'ListItem', position: 8, item: { '@id': canonicalUrl, name: 'Collection' } },
      ],
    },
  ],
}, null, 2);

const pageMeta = {
  canonicalUrl,
  robots: 'index, follow',
  ogTitle: seoTitle,
  ogDescription: seoDescription,
  ogImage: socialImage,
  ogImageAlt: socialImageAlt,
  ogUrl: canonicalUrl,
  twitterTitle: seoTitle,
  twitterDescription: seoDescription,
  twitterImage: socialImage,
  twitterUrl: canonicalUrl,
};
---

<BaseLayout title={seoTitle} description={seoDescription} meta={pageMeta} disableAutoBreadcrumbs={true}>
  <script type="application/ld+json" set:html={structuredDataJson} />

  <link href="https://fonts.googleapis.com/css2?family=Glegoo:wght@400;700&display=swap" rel="stylesheet" />

  <LandingHeader client:load breadcrumb={breadcrumbHtml} />

  <div class="gallery-index-wrapper" id="top">
    <section class="collection-gateway catalog-entrance" aria-labelledby="gateway-heading">
      <a class="gateway-artwork" href={gatewayHeroHref} aria-label={`Open artwork detail for ${gatewayHeroTitle}`}>
        <span class="gateway-artwork-mat">
          <img
            src={gatewayHeroSrc}
            srcset={gatewayHeroSrcSet || undefined}
            sizes="(max-width: 768px) 100vw, (max-width: 1100px) 42vw, 480px"
            alt={gatewayHeroAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </span>
      </a>
      <div class="gateway-copy">
        <p class="gateway-kicker">K4 STUDIOS FINE ART PRINT CATALOG</p>
        <p class="gateway-brand" id="gateway-heading">{gatewayBrandLabel}</p>
        <p class="gateway-copy-text">{gatewayIntroCopy}</p>
        <p class="gateway-copy-text">{gatewaySupportingCopy}</p>
      </div>
    </section>

    <section class="collection-dock" aria-labelledby="collection-dock-heading">
      <div class="dock-heading">
        <div>
          <h2 id="collection-dock-heading"><span id="dock-active-prefix"></span><span id="dock-active-title">{currentDockTitle}</span></h2>
        </div>
      </div>
      <div class="dock-shell">
        <div class="dock-track" aria-label="K4 gallery all-page quick links">
          <span id="dock-start" class="dock-anchor" aria-hidden="true"></span>
          {sectionDockItems.map((item: any, idx: number) => {
            const displayTitle = [item.title, item.subtitle].filter(Boolean).join(' ');
            const distance = Math.abs(idx - dockCenterIndex);
            const dockClass = [
              'dock-card',
              item.current ? 'is-center is-current' : '',
              distance === 1 ? 'is-near' : '',
              distance >= 3 ? 'is-far' : '',
            ].filter(Boolean).join(' ');

            return (
              <a
                class={dockClass}
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
                aria-label={item.current ? `Current collection: ${displayTitle}` : `Browse ${displayTitle}`}
                data-dock-title={displayTitle}
                data-current={item.current ? 'true' : undefined}
              >
                <div class="dock-tombstone">
                  <img
                    src={item.thumb}
                    alt={`${displayTitle} tombstone link`}
                    loading={item.current || distance <= 2 ? 'eager' : 'lazy'}
                    width="140"
                    height="160"
                  />
                </div>
              </a>
            );
          })}
          <span id="dock-end" class="dock-anchor" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <header class="collection-hero">
      <h2>{commercialH1}</h2>
      <p class="hero-deck">{commercialDeck}</p>
      <p class="hero-copy">{collectionIntro}</p>
    </header>

    <span id="collection-browser" class="collection-browser-anchor" aria-hidden="true"></span>
    <hr class="catalog-anchor-rule" />
    <p class="print-options-heading">K4 Series and Limited Editions · Fine Art Prints from {getFormattedLowestStandardPrintPrice()}</p>

    <section class="print-options" aria-labelledby="print-options-heading">
      <div class="series-widget" aria-label="Standard K4 paper print series">
        {standardPrintSeries.map((series: any) => (
          <article class="series-tile" data-series-tile>
            <button class="series-trigger" type="button" aria-label={`Show ${series.name} details`}>
              <span class="series-symbol" aria-hidden="true">{series.symbol}</span>
              <span>
                <strong>{series.name}</strong>
                <small>{series.subtitle}</small>
              </span>
            </button>
            <div class="series-detail">
              <p><strong>{series.name}:</strong> {series.collectorSummary}</p>
              <ul>
                {series.sizes.map((entry: any) => (
                  <li>{entry.display}</li>
                ))}
              </ul>
              <a href={series.learnMoreHref}>Learn more →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="catalog-tools" aria-labelledby="catalog-tools-heading">
      <h2 id="catalog-tools-heading" class="catalog-tools-title">{gatewayCollectionName} Collection</h2>
      <span class="catalog-tools-divider" aria-hidden="true">|</span>
      <form class="jump-form" data-jump-form>
        <label for="artwork-number">Jump to artwork #</label>
        <input id="artwork-number" name="artwork-number" type="number" min="1" max={imageCount} inputmode="numeric" />
        <button type="submit">Go</button>
      </form>
      <span class="catalog-tools-divider" aria-hidden="true">|</span>
      <p class="catalog-tools-count">{imageCount} works</p>
    </section>

    <div class="ssr-grid" id="collection-grid">
      {filteredGalleryData.map((item: any, idx: number) => {
        const imageUrl = getProxySrc(item.id, 's');
        const srcsetParts = [
          `${getProxySrc(item.id, 's')} 400w`,
          `${getProxySrc(item.id, 'm')} 600w`,
          `${getProxySrc(item.id, 'l')} 1024w`,
        ].join(', ');
        const linkUrl = `${contentBasePath}/${item.id}`;
        const collectorNotesHref = `${linkUrl}#collector-notes`;
        const title = cleanForDisplay(item.title);

        let altText: string;
        if (item.alt) {
          altText = cleanForDisplay(item.alt);
        } else if (item.description) {
          const firstSentence = item.description.split(/[.!?]/)[0];
          altText = cleanForDisplay(firstSentence.slice(0, 150));
        } else if (item.keywords?.length > 0) {
          const topKeywords = item.keywords.slice(0, 4).join(', ');
          altText = `Native American black and white portrait fine art photograph: ${topKeywords}`;
        } else {
          altText = `Native American black and white portrait fine art photograph: ${title} by Wayne Heim`;
        }

        const normalizedAltKey = altText.toLowerCase();
        const previousAltCount = seenCardAltCounts.get(normalizedAltKey) || 0;
        if (previousAltCount > 0) {
          altText = `${altText.replace(/[.\s]*$/, '')} (${title} - artwork ${idx + 1}).`;
        }
        seenCardAltCounts.set(normalizedAltKey, previousAltCount + 1);

        const storyExcerpt = truncateStory(item.story || '');
        const collectorNoteRaw = item.notes || item.collectorNotes || item.collector_notes || item.description || item.story || '';
        const collectorNoteTeaser = truncateWords(collectorNoteRaw, 30);
        const needsRangeMarker = idx > 0 && idx % 50 === 0;
        const rangeStart = idx + 1;
        const rangeEnd = Math.min(idx + 50, imageCount);

        return (
          <>
            {needsRangeMarker && (
              <div class="catalog-range-marker">
                <span>Artworks {rangeStart}–{rangeEnd} of {imageCount}</span>
                <a href="#top">Back to top</a>
              </div>
            )}
            <div class="ssr-card" id={item.id} data-artwork-number={idx + 1}>
              <a href={linkUrl} class="ssr-card-link">
                <img
                  class="ssr-card-image"
                  src={imageUrl}
                  srcset={srcsetParts || undefined}
                  sizes="(max-width: 640px) 100vw, 250px"
                  alt={altText}
                  loading="lazy"
                />
                <div class="ssr-card-content">
                  <span class="card-number">Artwork {idx + 1} of {imageCount}</span>
                  <h3>{title}</h3>
                  <p class="print-cue sr-only">Fine art print available</p>
                  {storyExcerpt && <p class="story-excerpt">{storyExcerpt}</p>}
                  <span class="card-cta">Explore Story | Order Fine Art Print →</span>
                </div>
              </a>
              <button
                type="button"
                class="collector-notes-trigger"
                data-notes-trigger
                aria-label="View collector note preview"
              >
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 6h4" />
                  <path d="M2 10h4" />
                  <path d="M2 14h4" />
                  <path d="M2 18h4" />
                  <rect width="16" height="20" x="4" y="2" rx="2" />
                  <path d="M16 2v20" />
                </svg>
              </button>
              <div class="collector-note-overlay" data-notes-overlay>
                <p class="collector-note-kicker">Collector Note</p>
                <p class="collector-note-teaser">{collectorNoteTeaser || 'Collector note preview available for this artwork.'}</p>
                <a class="collector-note-link" href={collectorNotesHref}>View full collector notes →</a>
              </div>
            </div>
          </>
        );
      })}
    </div>

    <ArchiveContext
      categoryUrl="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans"
      categoryName="Native Americans"
    />

    <Footer />
  </div>

  <style>
    body { background:#fff; color:#2a1f17; font-family:'Glegoo',serif; }
    html { scroll-behavior:smooth; }
    :global(.breadcrumb-text) { max-width:clamp(260px, 36vw, 560px); overflow:hidden; text-overflow:ellipsis; }
    :global(.breadcrumb-text a) { color:inherit; text-decoration:none; }
    :global(.breadcrumb-text a:hover) { color:#85644b; }
    .gallery-index-wrapper { min-height:100vh; padding:12px 24px 24px; }

    .collection-hero {
      max-width:1280px;
      margin:0 auto 20px;
      padding:10px 28px 2px;
      border-top:1px solid #dccfbe;
      text-align:center;
      background:transparent;
    }
    .collection-hero h2 { margin:0; font-size:clamp(1.85rem, 3.2vw, 2.75rem); line-height:1.14; color:#231a13; font-weight:700; }
    .hero-deck { max-width:900px; margin:16px auto 0; color:#4f4034; font-size:1.12rem; line-height:1.8; }
    .hero-copy { max-width:1080px; margin:16px auto 0; color:#3f3228; font-size:.98rem; line-height:1.75; }

    .collection-gateway {
      max-width:1020px; margin:8px auto 24px; display:grid; grid-template-columns:minmax(0, 1.25fr) minmax(220px, .75fr);
      grid-template-areas:"copy art"; gap:56px; align-items:center; padding:18px 20px; background:transparent;
      border-top:1px solid #dccfbe; border-bottom:1px solid #dccfbe;
    }
    .gateway-copy { grid-area:copy; min-width:0; padding:8px 4px 8px 0; max-width:38rem; }
    .gateway-kicker { margin:0 0 10px; color:#7a6047; font-size:.76rem; letter-spacing:.08em; text-transform:uppercase; }
    .gateway-brand { margin:0 0 14px; color:#231a13; font-size:clamp(2rem, 3.8vw, 3.25rem); line-height:1.02; font-weight:700; max-width:none; }
    .gateway-copy-text { margin:0 0 12px; color:#43362c; font-size:.96rem; line-height:1.72; max-width:38rem; }
    .gateway-copy-text:last-child { margin-bottom:0; }
    .gateway-artwork { grid-area:art; display:block; width:min(100%, 460px); justify-self:end; margin-left:auto; margin-right:6px; text-decoration:none; color:inherit; position:relative; z-index:1; filter:drop-shadow(0 10px 16px rgba(0,0,0,.24)); }
