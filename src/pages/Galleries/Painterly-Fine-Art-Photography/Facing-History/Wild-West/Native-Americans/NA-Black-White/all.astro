---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as portraitGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White.mjs";
import { galleryData as narrativeGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/BWEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const activeThemeSlug = Astro.url.searchParams.get("theme") || "";
const isNaNarrativeTheme = activeThemeSlug === "na-narrative-b-w-images";
const variantDescriptor = "black and white";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White";
const contentBasePath = isNaNarrativeTheme
  ? "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White"
  : basePath;
const canonicalQuery = isNaNarrativeTheme ? "?theme=na-narrative-b-w-images&view=grid" : "";
const canonicalPath = `${basePath}/all${canonicalQuery}`;
const rawGalleryData = isNaNarrativeTheme ? narrativeGalleryData : portraitGalleryData;

const variantName = isNaNarrativeTheme ? "Black & White Narrative Works" : "Black & White Portraits";
const currentKey = isNaNarrativeTheme ? "na-narrative-bw" : "na-portrait-bw";
const currentDockTitle = isNaNarrativeTheme
  ? "Black and White Native American Narrative Works"
  : "Black and White Native American Portraits";

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans">Native Americans</a>',
  `<a href="${basePath}">${isNaNarrativeTheme ? 'Black &amp; White Narrative Works' : 'Black &amp; White Portraits'}</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans", name: "Native Americans" },
  { href: canonicalPath, name: variantName },
];

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey,
  currentHref: canonicalPath,
});

const copy = isNaNarrativeTheme
  ? {
      seoTitle: "Black and White Native American Narrative Photography | Fine Art Prints | K4 Studios",
      seoDescription:
        "Browse {imageCount} black and white Native American narrative fine art prints by Wayne Heim. Monochrome Wild West photography of frontier life, presence, and story from $25.",
      indexDefinition:
        `This page presents the complete ${variantDescriptor} Native American narrative selection from Western Narratives by Wayne Heim. These story-driven works are filtered from the larger monochrome narrative archive and gathered here around Indigenous presence, frontier context, and painterly visual storytelling.`,
      indexLinkNote: "All {imageCount} images open to their original Western Narratives artwork pages with full stories, metadata, and collector information.",
      commercialH1: "Black and White Native American Narrative Photography Collection",
      commercialDeck: "{imageCount} monochrome Native American narrative fine art prints by Wayne Heim.",
      collectionIntro:
        "Browse this curated black and white collection of Native American narrative photography — Wild West scenes shaped by tonal restraint, atmosphere, gesture, and story pressure. Monochrome strips the frame to its essentials — light, shadow, presence, and the quiet tension of the American frontier. Each image is a painterly study in dignity, continuity, and human depth. Every artwork opens to its full story, collector notes, image metadata, and available print details.\n\nFor the full Native American narrative collection in color, see the color gallery.",
      gatewayIntroCopy:
        "{imageCount} black and white Native American narrative fine art prints by Wayne Heim, available as archival fine art from $25. A curated monochrome collection — painterly Wild West photography shaped by atmosphere, gesture, tonal restraint, and the story pressure of the American frontier. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
      gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
    }
  : {
      seoTitle: "Black and White Native American Portrait Photography | Fine Art Prints | K4 Studios",
      seoDescription:
        "Browse {imageCount} black and white Native American portrait fine art prints by Wayne Heim. Monochrome painterly studies of presence, dignity, and the American West from $25.",
      indexDefinition:
        `This page presents the complete ${variantDescriptor} Native American portrait archive by Wayne Heim. The collection distills presence, heritage, identity, gesture, and quiet human force into tonal painterly portrait studies.`,
      indexLinkNote: "All {imageCount} images open to individual artwork pages with full narrative context, metadata, and collector information.",
      commercialH1: "Black and White Native American Portrait Photography",
      commercialDeck: "{imageCount} monochrome Native American portrait fine art prints by Wayne Heim.",
      collectionIntro:
        "Browse this curated black and white collection of Native American portrait photography — {imageCount} images shaped by tonal restraint, atmosphere, gesture, and the quiet force of human presence. Monochrome strips the frame to its essentials — light, shadow, expression, and dignity. Each artwork opens to its full story, collector notes, image metadata, and available print details.\n\nFor the full Native American portrait collection in color, see the color gallery. Native American subjects also appear throughout the Western Narratives collection.",
      gatewayIntroCopy:
        "{imageCount} black and white Native American portrait fine art prints by Wayne Heim, available as archival fine art from $25. A curated monochrome selection — each image a painterly study of presence, dignity, atmosphere, and tonal depth. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
      gatewaySupportingCopy:
        "Click any work to read the full narrative, explore collector notes, and view print details. For the broader Native American portrait collection see the color gallery.",
    };
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={contentBasePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle={currentDockTitle}
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans",
    categoryName: "Native Americans",
  }}
  identity={{
    collectionName: "Native Americans",
    variantName,
    variantDescriptor: isNaNarrativeTheme ? `${variantDescriptor} Native American narrative` : `${variantDescriptor} Native American portrait`,
    gatewayBrandLabel: isNaNarrativeTheme
      ? "Native American Narrative Fine Art Prints - Black & White Collection"
      : "Native American Portrait Fine Art Prints - Black & White Collection",
  }}
  copy={copy}
/>
