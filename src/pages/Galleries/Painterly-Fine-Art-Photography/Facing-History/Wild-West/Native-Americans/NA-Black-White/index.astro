---
export const prerender = true;
import GalleryShell from '@components/GalleryShell-NativeAmericans-BW.astro';
import { entranceData as BWEntranceData } from '@data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/BWEntranceData.ts';

const match = Astro.url.pathname.match(/\/(i-[a-zA-Z0-9]+)/);
const initialImageId = match ? match[1] : undefined;
---

<GalleryShell
  breadcrumb={BWEntranceData.breadcrumb}
  entranceData={BWEntranceData}
  initialImageId={initialImageId}
/>