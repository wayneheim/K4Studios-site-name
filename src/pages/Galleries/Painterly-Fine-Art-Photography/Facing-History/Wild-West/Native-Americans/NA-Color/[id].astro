---
export const prerender = true;

import GalleryShell from '@components/GalleryShell-NativeAmericans-Color.astro';
import { entranceData as ColorEntranceData } from '@data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-EntranceData.ts';
import { galleryData } from '@data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color.mjs';
import { getImageMeta } from '@components/utils/getImageMeta.ts';
import { getLandingMeta } from '@data/landingMeta.ts';

export async function getStaticPaths() {
  return galleryData
    .filter((img: any) => img.visibility !== 'hidden' && img.visibility !== 'hide' && !['hidden', 'hide', 'ghost', 'non', 'none', ''].includes(String(img.visibility ?? 'show').trim().toLowerCase()) && img.id !== 'i-k4studios')
    .map((img: any) => ({ params: { id: img.id } }));
}

const { id } = Astro.params;
const imageData = galleryData.find((img: any) => img.id === id);

if (!imageData) {
  throw new Error(`Image not found for Native American Color: ${id}`);
}

function makeAbsoluteUrl(src: string) {
  if (!src) return '';
  if (src.startsWith('http://') || src.startsWith('https://')) {
    return src;
  }
  return `https://www.k4studios.com${src.startsWith('/') ? src : '/' + src}`;
}

const imgUrl = makeAbsoluteUrl(imageData.src);
const parentMeta = getLandingMeta(
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color',
  imgUrl
);

const canonicalUrl = `https://www.k4studios.com${Astro.url.pathname.replace(/\/$/, '')}`;
const meta = getImageMeta(id, [{ images: galleryData, meta: parentMeta }], parentMeta, canonicalUrl);
---

<GalleryShell
  breadcrumb={ColorEntranceData.breadcrumb}
  entranceData={ColorEntranceData}
  initialImageId={id}
  currentImageUrl={imgUrl}
  title={meta.title}
/>