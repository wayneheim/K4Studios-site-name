---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as portraitGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color.mjs";
import { galleryData as narrativeGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-EntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const activeThemeSlug = Astro.url.searchParams.get("theme") || "";
const isNaNarrativeTheme = activeThemeSlug === "na-narrative-color-images";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color";
const contentBasePath = isNaNarrativeTheme
  ? "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color"
  : basePath;
const canonicalQuery = isNaNarrativeTheme ? "?theme=na-narrative-color-images&view=grid" : "";
const canonicalPath = `${basePath}/all${canonicalQuery}`;
const rawGalleryData = isNaNarrativeTheme ? narrativeGalleryData : portraitGalleryData;

const variantName = isNaNarrativeTheme ? "Narrative Works Color" : "Color Portraits";
const currentKey = isNaNarrativeTheme ? "na-narrative-color" : "na-portrait-color";
const currentDockTitle = isNaNarrativeTheme
  ? "Color Native American Narrative Works"
  : "Color Native American Portraits";

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans">Native Americans</a>',
  `<a href="${basePath}">${variantName}</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans", name: "Native Americans" },
  { href: canonicalPath, name: variantName },
];

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey,
  currentHref: canonicalPath,
});
const lowestStandardPrintPrice = getFormattedLowestStandardPrintPrice();

const copy = isNaNarrativeTheme
  ? {
      seoTitle: "Color Native American Narrative Art Prints | Wild West Fine Art Photography | K4 Studios",
      seoDescription:
        `Browse {imageCount} color Native American narrative fine art prints by Wayne Heim. Painterly Wild West photography of frontier life, presence, and story from the small-works "Sketch Series" at ${lowestStandardPrintPrice}. Collector notes on every image.`,
      indexDefinition:
        "This page presents the complete color Native American narrative selection from Western Narratives by Wayne Heim. These story-driven works are filtered from the larger narrative archive and gathered here around Indigenous presence, frontier context, and painterly visual storytelling.",
      indexLinkNote: "All {imageCount} images open to their original Western Narratives artwork pages with full stories, metadata, and collector information.",
      commercialH1: "Color Native American Narrative Photography Series",
      commercialDeck: "{imageCount} color Native American narrative fine art prints by Wayne Heim.",
      collectionIntro:
        "Browse the complete color collection of Native American narrative photography — Wild West scenes shaped by atmosphere, gesture, silence, and story pressure. Figures on horseback, frontier encounters, open country, and the quiet tension of lives lived at the edge of the American West. Each image is a painterly narrative built around presence, dignity, and human depth. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
      gatewayIntroCopy:
        `{imageCount} color Native American narrative fine art prints by Wayne Heim, available as fine art prints from the small-works "Sketch Series" at ${lowestStandardPrintPrice} through ultra-limited signed collector editions. Painterly Wild West photography shaped by frontier life, atmosphere, gesture, and the story pressure of the American West — every image a complete narrative in a single frame. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.`,
      gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
    }
  : {
      seoTitle: "Native American Portrait Photography | Color Fine Art Prints | K4 Studios",
      seoDescription:
        `Browse {imageCount} color Native American portrait fine art prints by Wayne Heim. Painterly Wild West photography of presence, dignity, and the American frontier from the small-works "Sketch Series" at ${lowestStandardPrintPrice}.`,
      indexDefinition:
        "This page presents the complete color Native American portrait archive by Wayne Heim. The collection gathers painterly images shaped by presence, heritage, identity, gesture, and quiet human force.",
      indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
      commercialH1: "Color Native American Portrait Photography Collection",
      commercialDeck: "{imageCount} color Native American portrait fine art prints by Wayne Heim.",
      collectionIntro:
        "Browse the complete color collection of Native American portrait photography — figures shaped by atmosphere, gesture, silence, and the quiet force of presence. Each portrait is a painterly study in dignity, continuity, and the human depth of the American West. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
      gatewayIntroCopy:
        `{imageCount} color Native American portrait fine art prints by Wayne Heim, available as fine art prints from the small-works "Sketch Series" at ${lowestStandardPrintPrice} through ultra-limited signed collector editions. Painterly Wild West photography shaped by presence, dignity, atmosphere, and the quiet force of the American frontier. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.`,
      gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
    };
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={contentBasePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle={currentDockTitle}
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans",
    categoryName: "Native Americans",
  }}
  identity={{
    collectionName: "Native Americans",
    variantName: isNaNarrativeTheme ? "Narrative Works - Color" : "Color Portraits",
    variantDescriptor: isNaNarrativeTheme ? "color Native American narrative" : "color Native American portrait",
    gatewayBrandLabel: isNaNarrativeTheme
      ? "Native American Narrative Fine Art Prints - Color Collection"
      : "Native American Portrait Fine Art Prints - Color Collection",
  }}
  copy={copy}
/>
