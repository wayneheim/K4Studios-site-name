---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "wwii-portraits-0", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII">WWII</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits">Portraits</a>', `<a href="${basePath}">Color</a>`, 'Collection'].join(' | ');
const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII", name: "WWII" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits", name: "WWII Portraits" },
  { href: basePath, name: "Color" },
];
const copy = {
  seoTitle: "Color WWII Portrait Photography | WWII Inspired Fine Art Prints | K4 Studios",
  seoDescription: "Browse {imageCount} color WWII portrait fine art prints by Wayne Heim. Painterly WWII inspired photography of soldiers, airmen, and wartime characters from $25. Collector notes on every image.",
  indexDefinition: "This page presents the complete color archive of WWII Portraits by Wayne Heim. The collection gathers wartime character studies, reenactor portraits, and Greatest Generation images shaped by painterly color.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "Color WWII Portrait Photography Collection",
  commercialDeck: "{imageCount} color WWII portrait fine art prints by Wayne Heim.",
  catalogEntranceTitle: "WWII Portrait Fine Art Prints by Wayne Heim",
  catalogEntranceCopy: "Browse painterly World War II portrait photography built around sacrifice, resilience, brotherhood, and human presence.",
  collectionIntro: "Browse the complete color collection of WWII portrait photography — soldiers, airmen, nurses, officers, and the human faces of the greatest conflict of the 20th century. Each portrait is painterly WWII inspired photography shaped by wartime atmosphere, uniform detail, expression, and the quiet weight of service and sacrifice. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy: "{imageCount} color WWII portrait fine art prints by Wayne Heim, available as archival fine art from $25. Painterly WWII inspired photography shaped by wartime atmosphere, uniform detail, expression, and the human presence of those who served — every image a complete wartime character study in a single frame. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="The WWII Color Portraits" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits", categoryName: "WWII Portraits" }} identity={{ collectionName: "WWII Portraits", variantName: "Color", variantDescriptor: "color WWII portrait", gatewayBrandLabel: "WWII Portrait Fine Art Prints - Color Collection" }} copy={copy} />
