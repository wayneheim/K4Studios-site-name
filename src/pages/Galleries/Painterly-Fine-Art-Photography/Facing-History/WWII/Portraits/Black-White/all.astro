---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/BWEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White";
const canonicalPath = `${basePath}/all`;
const variantDescriptor = "black and white";
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "wwii-portraits-1", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII">WWII</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits">Portraits</a>', `<a href="${basePath}">Black &amp; White</a>`, 'Collection'].join(' | ');
const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII", name: "WWII" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits", name: "WWII Portraits" },
  { href: basePath, name: "Black & White" },
];
const copy = {
  seoTitle: "Black and White WWII Portrait Photography | WWII Inspired Fine Art Prints | K4 Studios",
  seoDescription: "Browse {imageCount} black and white WWII portrait fine art prints by Wayne Heim. Painterly WWII inspired photography of soldiers, airmen, and wartime characters from $25. Collector notes on every image.",
  indexDefinition: `This page presents the complete ${variantDescriptor} archive of WWII Portraits by Wayne Heim. The collection gathers wartime character studies, reenactor portraits, and Greatest Generation images shaped by tonal painterly atmosphere.`,
  indexLinkNote: "All {imageCount} images open to individual artwork pages with full narrative context, metadata, and collector information.",
  commercialH1: "Black and White WWII Portrait Photography Collection",
  commercialDeck: "{imageCount} black and white WWII portrait fine art prints by Wayne Heim.",
  catalogEntranceTitle: "Black and White WWII Portrait Fine Art Prints",
  catalogEntranceCopy: "Browse monochrome World War II portrait photography built around sacrifice, resilience, brotherhood, and human presence.",
  collectionIntro: "Browse the complete black and white collection of WWII portrait photography — soldiers, airmen, paratroopers, nurses, officers, and the weathered faces of those who carried the weight of the second world war. Monochrome strips the frame to its essentials — tonal depth, uniform detail, expression, and the quiet dignity of service and sacrifice. Painterly WWII inspired photography built around presence, consequence, and human depth. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy: "{imageCount} black and white WWII portrait fine art prints by Wayne Heim — the largest collection of painterly WWII inspired photography on the site. Wartime character studies shaped by tonal depth, uniform detail, expression, and the human presence of those who served — every image a complete story in a single frame. Available as archival fine art from $25 across four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="The WWII Black and White Portraits" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits", categoryName: "WWII Portraits" }} identity={{ collectionName: "WWII Portraits", variantName: "Black & White", variantDescriptor: `${variantDescriptor} WWII portrait`, gatewayBrandLabel: "WWII Portrait Fine Art Prints - Black & White Collection" }} copy={copy} />
