---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/War/Color.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/War/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/War/Color";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "wwii-war-0", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII">WWII</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/War">Art of War</a>', `<a href="${basePath}">Color</a>`, 'Collection'].join(' | ');
const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII", name: "WWII" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/War", name: "WWII Art of War" },
  { href: basePath, name: "Color" },
];
const copy = {
  seoDescription: `Browse {imageCount} painterly color WWII battle fine art prints by Wayne Heim, with combat scenes, wartime storytelling, collector notes, and print options from ${getFormattedLowestStandardPrintPrice()}.`,
  indexDefinition: "This page presents the complete color archive of The Art of War by Wayne Heim. The collection gathers WWII battle scenes, combat reenactment imagery, wartime action, and front-line storytelling shaped by painterly color.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "WWII Art of War Fine Art Series",
  commercialDeck: "A collection of painterly WWII battle and wartime storytelling artwork by Wayne Heim.",
  catalogEntranceTitle: "WWII Battle Fine Art Prints by Wayne Heim",
  catalogEntranceCopy: "Browse painterly World War II battle photography built around action, sacrifice, tension, atmosphere, and front-line story.",
  collectionIntro: "Browse the complete collection of color WWII Art of War images shaped by combat atmosphere, movement, smoke, tension, and consequence. Each artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy: `{imageCount} painterly color WWII battle photographs by Wayne Heim, available as archival fine art prints from ${getFormattedLowestStandardPrintPrice()}. Four edition tiers - open-edition studies to ultra-limited signed collector works - on fine art paper and Baltic Birch wood panels.`,
  gatewaySupportingCopy: "Every image below is a wartime story in a single frame. Click any work to read the narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="The WWII Color Art of War" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/War", categoryName: "WWII Art of War" }} identity={{ collectionName: "WWII Art of War", variantName: "Color", variantDescriptor: "color WWII battle", gatewayBrandLabel: "WWII Art of War Fine Art Prints - Color Collection" }} copy={copy} />
