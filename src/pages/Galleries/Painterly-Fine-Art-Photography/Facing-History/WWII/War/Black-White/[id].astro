---
/**
 * Static Image Detail Page
 * 
 * All bot detection, 410s, and redirects are handled by the Cloudflare Worker.
 * This page is purely static — generated at build time for each valid image.
 */
export const prerender = true;

import GalleryShell from '@/components/GalleryShell-WWIIWar-BW.astro';
import { entranceData as BWEntranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/War/BWEntranceData.ts";
import { galleryData } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/War/Black-White.mjs';

// Generate static paths for all visible images at build time
export async function getStaticPaths() {
  return galleryData
    .filter(img => img.visibility !== 'hidden' && img.visibility !== 'hide' && img.visibility !== 'ghost' && img.id !== 'i-k4studios')
    .map(img => ({ params: { id: img.id } }));
}

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);

// Check if image is missing OR hidden (archived images stay in gallery with visibility: "hidden")

---

<GalleryShell 
  breadcrumb={BWEntranceData.breadcrumb} 
  entranceData={BWEntranceData}
  initialImageId={id}
/>
