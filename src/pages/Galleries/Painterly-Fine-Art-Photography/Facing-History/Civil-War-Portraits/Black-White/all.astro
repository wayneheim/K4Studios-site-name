---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/BWEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White";
const canonicalPath = `${basePath}/all`;
const variantDescriptor = "black and white";

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits">Civil War Portraits</a>',
  `<a href="${basePath}">Black &amp; White</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits", name: "Civil War Portraits" },
  { href: basePath, name: "Black & White" },
];

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey: "civil-war-1",
  currentHref: canonicalPath,
});

const copy = {
  seoTitle: "Black and White Civil War Portrait Photography | Fine Art Prints | K4 Studios",
  seoDescription:
    "Browse {imageCount} black and white Civil War portrait fine art prints by Wayne Heim. Painterly historically themed photography of soldiers, officers, and Civil War characters from $25.",
  indexDefinition:
    `This page presents the complete ${variantDescriptor} archive of Civil War Portraits by Wayne Heim. The collection gathers Union and Confederate reenactor portraits, battlefield character studies, and historically themed images shaped by tonal painterly atmosphere.`,
  indexLinkNote: "All {imageCount} images open to individual artwork pages with full narrative context, metadata, and collector information.",
  commercialH1: "Black and White Civil War Portrait Photography Collection",
  commercialDeck: "{imageCount} black and white Civil War portrait fine art prints by Wayne Heim.",
  catalogEntranceTitle: "Black and White Civil War Fine Art Prints",
  catalogEntranceCopy: "Browse monochrome Civil War portrait photography built around character, history, sacrifice, tonal atmosphere, and human presence.",
  collectionIntro:
    "Browse the complete black and white collection of Civil War portrait photography — soldiers, officers, cavalry, and the weathered faces of America's defining conflict. Monochrome strips the frame to its essentials — tonal depth, uniform detail, expression, and the quiet weight of remembrance. Each portrait is painterly historically themed photography built around presence, consequence, and human depth. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayCollectionName: "Civil War Portraits",
  gatewayIntroCopy:
    "{imageCount} black and white Civil War portrait fine art prints by Wayne Heim, available as archival fine art from $25. Painterly historically themed photography shaped by uniform detail, expression, tonal restraint, and the quiet weight of America's defining conflict — every image a complete historical character study in a single frame. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="The Civil War Black and White Portraits"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits",
    categoryName: "Civil War Portraits",
  }}
  identity={{
    collectionName: "Civil War Portraits",
    variantName: "Black & White",
    variantDescriptor: `${variantDescriptor} Civil War portrait`,
    gatewayBrandLabel: "Civil War Portrait Fine Art Prints - Black & White Collection",
  }}
  copy={copy}
/>
