---
export const prerender = false;

import GalleryShell from '../../../../../../components/GalleryShell-CivilWar-Color.astro';
import { entranceData as ColorEntranceData } from "../../../../../../data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/ColorEntranceData.ts";
import { galleryData } from '../../../../../../data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color.mjs';

import imageIdMap from '@/data/imageIdMap.json';

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);

// Check if image is missing OR hidden (archived images stay in gallery with visibility: "hidden")
const isHidden = imageData?.visibility === 'hidden' || imageData?.visibility === 'hide';
const isBadId = (!imageData || isHidden) && (id && (id.startsWith('i-') || id === 'i'));
if (isBadId) {
  // Smart 404: Check if image exists in another gallery (e.g., Archive)
  const correctGalleryPath = (imageIdMap as Record<string, string>)[id];
  if (correctGalleryPath) {
    // Image found elsewhere - 301 redirect to preserve SEO
    return Astro.redirect(`${correctGalleryPath}/${id}`, 301);
  }
  // Not found anywhere - fall back to gallery landing page
  let cleanUrl = Astro.url.pathname.replace(/\/i[^/]*\/?$/, '');
  cleanUrl = cleanUrl.replace(/\/+$/, '');
  if (typeof window !== "undefined") {
    window.location.replace(cleanUrl);
  } else {
    return Astro.redirect(cleanUrl, 302);
  }
}
---

<GalleryShell 
  breadcrumb={ColorEntranceData.breadcrumb} 
  entranceData={ColorEntranceData}
  initialImageId={id}
/>
