---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color";
const canonicalPath = `${basePath}/all`;

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits">Civil War Portraits</a>',
  `<a href="${basePath}">Color</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits", name: "Civil War Portraits" },
  { href: basePath, name: "Color" },
];

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey: "civil-war-0",
  currentHref: canonicalPath,
});

const copy = {
  seoDescription: `Browse {imageCount} painterly color Civil War portrait fine art prints by Wayne Heim, with reenactment portraits, collector notes, and print options from ${getFormattedLowestStandardPrintPrice()}.`,
  indexDefinition:
    "This page presents the complete color archive of Civil War Portraits by Wayne Heim. The collection gathers Union and Confederate reenactor portraits, battlefield character studies, and historically themed images shaped by painterly color.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "Civil War Portrait Fine Art Series",
  commercialDeck: "A collection of painterly Civil War portrait artwork by Wayne Heim.",
  catalogEntranceTitle: "Civil War Fine Art Prints by Wayne Heim",
  catalogEntranceCopy: "Browse painterly Civil War portrait photography built around character, history, sacrifice, memory, and human presence.",
  collectionIntro:
    "Browse the complete collection of color Civil War portrait images shaped by historical atmosphere, expression, uniform detail, gesture, and remembrance. Each artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayCollectionName: "Civil War Portraits",
  gatewayIntroCopy: `{imageCount} painterly color Civil War portrait photographs by Wayne Heim, available as archival fine art prints from ${getFormattedLowestStandardPrintPrice()}. Four edition tiers - open-edition studies to ultra-limited signed collector works - on fine art paper and Baltic Birch wood panels.`,
  gatewaySupportingCopy: "Every image below is a historical character study in a single frame. Click any work to read the narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="The Civil War Color Portraits"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits",
    categoryName: "Civil War Portraits",
  }}
  identity={{
    collectionName: "Civil War Portraits",
    variantName: "Color",
    variantDescriptor: "color Civil War portrait",
    gatewayBrandLabel: "Civil War Portrait Fine Art Prints - Color Collection",
  }}
  copy={copy}
/>
