---
export const prerender = true;
import GalleryShell from '../../../../../../components/GalleryShell-Cowboy-Color.astro';
import { entranceData as ColorEntranceData } from "../../../../../../data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/ColorEntranceData.ts";

const match = Astro.url.pathname.match(/\/(i-[a-zA-Z0-9]+)/);
const initialImageId = match ? match[1] : undefined;
---

<GalleryShell
  breadcrumb={ColorEntranceData.breadcrumb}
  entranceData={ColorEntranceData}
  initialImageId={initialImageId}
/>
