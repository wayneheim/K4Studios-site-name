---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color";
const canonicalPath = `${basePath}/all`;

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits">Western Cowboy Portraits</a>',
  `<a href="${basePath}">Color</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits", name: "Western Cowboy Portraits" },
  { href: basePath, name: "Color" },
];

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey: "cowboy-portraits-0",
  currentHref: canonicalPath,
});

const copy = {
  seoTitle: "Color Cowboy Portraits & Western Cowboy Pictures | Fine Art Prints | K4 Studios",
  seoDescription:
    "Browse {imageCount} color cowboy portraits and western cowboy pictures by Wayne Heim. Painterly frontier character studies as fine art prints from $25 — archival paper and Baltic Birch wood panels.",
  indexDefinition:
    "This page presents the complete color archive of Western Cowboy Portraits by Wayne Heim. The collection gathers frontier-era character studies, working cowboys, and Western portrait images shaped by warm light, weathered presence, and painterly atmosphere.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  printAvailabilityNote: `All works are available as fine art prints from ${getFormattedLowestStandardPrintPrice()}. Select images are also available in the Engrained Series - printed on Baltic Birch using a five-layer UV process - with pricing specific to each image.`,
  commercialH1: "Color Cowboy Portrait Collection",
  commercialDeck: "{imageCount} color cowboy portraits and western cowboy pictures by Wayne Heim.",
  catalogEntranceTitle: "Western Portrait Fine Art Prints by Wayne Heim",
  catalogEntranceCopy: "Browse painterly cowboy portrait photography built around character, light, posture, and the quiet weight of frontier life.",
  collectionIntro:
    "Browse the complete collection of color cowboy portraits — frontier characters, weathered faces, cowboys on horseback, lawmen, drifters, and frontier women shaped by warmth, dust, and the light of the American West. Each portrait is a painterly character study built around presence, expression, and human depth. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayCollectionName: "Western Cowboy Portraits",
  gatewayIntroCopy:
    "{imageCount} color cowboy portraits and western cowboy pictures by Wayne Heim, available as archival fine art prints from $25. Frontier characters shaped by warmth, dust, distance, and human presence — every image a painterly character study in a single frame. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="The Wild West Color Cowboy Portraits"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits",
    categoryName: "Western Cowboy Portraits",
  }}
  identity={{
    collectionName: "Western Cowboy Portraits",
    variantName: "Color",
    variantDescriptor: "color",
    gatewayBrandLabel: "Western Cowboy Portraits Fine Art Prints - Color Collection",
  }}
  copy={copy}
/>
