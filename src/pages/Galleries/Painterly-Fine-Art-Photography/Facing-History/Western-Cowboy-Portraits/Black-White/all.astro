---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/BWEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White";
const canonicalPath = `${basePath}/all`;
const variantDescriptor = "black and white";

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits">Western Cowboy Portraits</a>',
  `<a href="${basePath}">Black &amp; White</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits", name: "Western Cowboy Portraits" },
  { href: basePath, name: "Black & White" },
];

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey: "cowboy-portraits-1",
  currentHref: canonicalPath,
});

const copy = {
  seoTitle: "Black and White Cowboy Photos & Portrait Prints | K4 Studios",
  seoDescription:
    "Browse {imageCount} black and white cowboy photos and western portrait prints by Wayne Heim. Monochrome frontier character studies from the small-works \"Sketch Series\" at $25 through signed collector editions.",
  indexDefinition:
    `This page presents the complete ${variantDescriptor} archive of Western Cowboy Portraits by Wayne Heim. The collection distills frontier portraiture into light, shadow, expression, posture, and the quieter emotional weight of the American West.`,
  indexLinkNote: "All {imageCount} images open to individual artwork pages with full narrative context, metadata, and collector information.",
  printAvailabilityNote: `All works are available as fine art prints from the small-works \"Sketch Series\" at ${getFormattedLowestStandardPrintPrice()} through ultra-limited signed collector editions. Select images are also available in the Engrained Series - produced on Baltic Birch with a five-layer UV process - with image-specific pricing.`,
  commercialH1: "Black and White Cowboy Portrait Collection",
  commercialDeck: "{imageCount} black and white cowboy photos and western portrait prints by Wayne Heim.",
  catalogEntranceTitle: "Black and White Western Portrait Fine Art Prints",
  catalogEntranceCopy: "Browse monochrome cowboy portrait photography built around expression, tonal atmosphere, and the quiet consequence of frontier presence.",
  collectionIntro:
    "Browse the complete collection of black and white cowboy portraits — frontier characters, weathered faces, lawmen, drifters, frontier women, and the quiet strength of the American West. Each portrait is shaped by shadow, restraint, and human presence. Color removed. Character remains. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayCollectionName: "Western Cowboy Portraits",
  gatewayIntroCopy:
    "{imageCount} black and white cowboy photos and western portrait prints by Wayne Heim, available as fine art prints from the small-works \"Sketch Series\" at $25 through ultra-limited signed collector editions. Frontier characters, weathered faces, quiet strength, and human presence — every image a complete cowboy portrait in a single frame. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="The Wild West Black and White Cowboy Portraits"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits",
    categoryName: "Western Cowboy Portraits",
  }}
  identity={{
    collectionName: "Western Cowboy Portraits",
    variantName: "Black & White",
    variantDescriptor,
    gatewayBrandLabel: "Western Cowboy Portraits Fine Art Prints - Black & White Collection",
  }}
  copy={copy}
/>
