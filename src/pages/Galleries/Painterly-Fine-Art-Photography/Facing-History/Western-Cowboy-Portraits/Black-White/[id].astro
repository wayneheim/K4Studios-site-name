---

import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import GalleryShell from '../../../../../../components/GalleryShell-Cowboy-BW.astro';
import { entranceData as BWEntranceData } from "../../../../../../data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/BWEntranceData.ts";
import { galleryData } from '../../../../../../data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs';
import { getImageMeta } from '../../../../../../components/utils/getImageMeta.ts';
import { getLandingMeta } from '../../../../../../data/landingMeta.ts';

export async function getStaticPaths() {
  return galleryData.map(img => ({
    params: { id: img.id },
  }));
}

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);
if (!imageData) throw new Error(`Image with id ${id} not found.`);

// Ensure absolute URL (don’t prepend if already absolute)
function makeAbsoluteUrl(src) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) {
    return src;
  }
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

const imgUrl = makeAbsoluteUrl(imageData.src);

// Get parent gallery meta, override with correct image URL
const parentMeta = getLandingMeta(
  "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White",
  imgUrl
);

const meta = getImageMeta(id, [{ images: galleryData, meta: parentMeta }], parentMeta);
---

<BaseLayout meta={meta}>
  <GalleryShell 
    breadcrumb={BWEntranceData.breadcrumb} 
    entranceData={BWEntranceData}
    initialImageId={id}
    currentImageUrl={imgUrl}
    title={meta.title}
  />
</BaseLayout>
