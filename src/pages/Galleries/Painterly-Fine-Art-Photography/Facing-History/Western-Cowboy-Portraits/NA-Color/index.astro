---
export const prerender = true;
import GalleryShell from '@components/GalleryShell-Cowboy-NA-Color.astro';
import { entranceData as ColorEntranceData } from '@data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/NA-EntranceData.ts';

const match = Astro.url.pathname.match(/\/(i-[a-zA-Z0-9]+)/);
const initialImageId = match ? match[1] : "i-k4studios";

console.log("🔥 initialImageId:", initialImageId); // ✅ Add this
---

<GalleryShell
  breadcrumb={ColorEntranceData.breadcrumb}
  entranceData={ColorEntranceData}
  initialImageId={initialImageId}
/>
