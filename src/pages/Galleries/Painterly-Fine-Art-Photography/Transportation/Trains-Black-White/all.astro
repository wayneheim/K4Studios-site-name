---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Transportation/Trains-Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Transportation/TransportationTrainsBWEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Transportation/Trains-Black-White";
const canonicalPath = `${basePath}/all`;
const variantDescriptor = "black and white";
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "transportation-1", currentHref: canonicalPath });

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Transportation">Transportation</a>',
  `<a href="${basePath}">Trains Black &amp; White</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Transportation", name: "Transportation" },
  { href: basePath, name: "Trains Black & White" },
];

const copy = {
  seoTitle: "Black and White Train Photography Prints | Steam Engine Fine Art | K4 Studios",
  seoDescription:
    "Browse {imageCount} black and white train and locomotive fine art prints by Wayne Heim — steam engines, vintage railroad photography, and man cave wall art from $25. Collector notes on every image.",
  indexDefinition: `This page presents the complete ${variantDescriptor} archive of train and locomotive photography by Wayne Heim. The collection gathers steam engines, railroads, locomotives, railcars, and transportation icons shaped by tonal painterly atmosphere.`,
  indexLinkNote: "All {imageCount} images open to individual artwork pages with full narrative context, metadata, and collector information.",
  commercialH1: "Black and White Train and Locomotive Photography Collection",
  commercialDeck: "{imageCount} black and white train and locomotive fine art prints by Wayne Heim.",
  catalogEntranceTitle: "Black and White Train and Locomotive Fine Art Prints",
  catalogEntranceCopy: "Browse monochrome railroad photography built around steam, steel, motion, industrial history, and the enduring romance of rail travel.",
  collectionIntro: "Browse the complete black and white collection of train and locomotive photography — steam engines under full power, vintage locomotives emerging from smoke, rail yards at dusk, and the raw mechanical atmosphere of American railroad history. Monochrome strips iron and steam to their essentials — tonal depth, motion, mechanical detail, and the nostalgic weight of a vanishing era. Fine art steam engine photography built for collectors, railroad enthusiasts, and statement wall art in any serious space. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy:
    "{imageCount} black and white train and locomotive fine art prints by Wayne Heim, available as archival fine art from $25. Steam engines, vintage locomotives, railroad atmosphere, smoke, motion, and the mechanical power of American rail history captured in monochrome — every image a complete railroad story in a single frame. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Transportation Black and White Trains and Locomotives"
  archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Transportation", categoryName: "Transportation" }}
  identity={{
    collectionName: "Trains and Locomotives",
    variantName: "Black & White",
    variantDescriptor: `${variantDescriptor} train and locomotive`,
    gatewayBrandLabel: "Train and Locomotive Fine Art Prints - Black & White Collection",
  }}
  copy={copy}
/>
