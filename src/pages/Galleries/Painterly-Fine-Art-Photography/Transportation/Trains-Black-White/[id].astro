---
import GalleryShell from '../../../../../components/GalleryShell-Transportation-Trains-Black-White.astro';
import { entranceData as BWEntranceData } from "../../../../../data/Galleries/Painterly-Fine-Art-Photography/Transportation/TransportationTrainsBWEntranceData.ts";
import { galleryData } from '../../../../../data/Galleries/Painterly-Fine-Art-Photography/Transportation/Trains-Black-White.mjs';

export async function getStaticPaths() {
  return galleryData.map(img => ({
    params: { id: img.id },
  }));
}

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);

const isBadId = !imageData && (id && (id.startsWith('i-') || id === 'i'));
if (isBadId) {
  let cleanUrl = Astro.url.pathname.replace(/\/i[^/]*\/?$/, '');
  cleanUrl = cleanUrl.replace(/\/+$/, '');
  if (typeof window !== "undefined") {
    window.location.replace(cleanUrl);
  } else {
    return Astro.redirect(cleanUrl, 302);
  }
}
---

<GalleryShell 
  breadcrumb={BWEntranceData.breadcrumb} 
  entranceData={BWEntranceData}
  initialImageId={id}
/>
