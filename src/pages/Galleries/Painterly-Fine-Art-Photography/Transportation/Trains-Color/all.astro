---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Transportation/Trains-Color.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Transportation/TransportationTrainsColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Transportation/Trains-Color";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "transportation-0", currentHref: canonicalPath });

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Transportation">Transportation</a>',
  `<a href="${basePath}">Trains Color</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Transportation", name: "Transportation" },
  { href: basePath, name: "Trains Color" },
];

const copy = {
  seoDescription: `Browse {imageCount} painterly color train and locomotive fine art prints by Wayne Heim, with railroad imagery, collector notes, and print options from ${getFormattedLowestStandardPrintPrice()}.`,
  indexDefinition: "This page presents the complete color archive of train and locomotive photography by Wayne Heim. The collection gathers steam engines, railroads, locomotives, railcars, and transportation icons shaped by painterly color.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "Train and Locomotive Fine Art Series",
  commercialDeck: "A collection of painterly color railroad and locomotive artwork by Wayne Heim.",
  catalogEntranceTitle: "Train and Locomotive Fine Art Prints",
  catalogEntranceCopy: "Browse painterly railroad photography built around steam, steel, motion, industrial history, and the enduring romance of rail travel.",
  collectionIntro: "Browse the complete collection of color train and locomotive images shaped by mechanical detail, railroad atmosphere, motion, and history. Each artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy: `{imageCount} painterly color train and locomotive photographs by Wayne Heim, available as archival fine art prints from ${getFormattedLowestStandardPrintPrice()}. Four edition tiers - open-edition studies to ultra-limited signed collector works - on fine art paper and Baltic Birch wood panels.`,
  gatewaySupportingCopy: "Every image below is a railroad story in a single frame. Click any work to read the narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Transportation Color Trains and Locomotives"
  archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Transportation", categoryName: "Transportation" }}
  identity={{
    collectionName: "Trains and Locomotives",
    variantName: "Color",
    variantDescriptor: "color train and locomotive",
    gatewayBrandLabel: "Train and Locomotive Fine Art Prints - Color Collection",
  }}
  copy={copy}
/>
