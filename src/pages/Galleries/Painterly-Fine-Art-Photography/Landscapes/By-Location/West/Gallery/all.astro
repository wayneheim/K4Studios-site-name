---
export const prerender = false;
import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "landscape-location-4", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes">Landscapes</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location">By Location</a>', `<a href="${basePath}">West</a>`, 'Series'].join(' | ');
const breadcrumbStructuredItems = [{ href: "/Galleries", name: "Galleries" }, { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes", name: "Landscapes" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location", name: "By Location" }, { href: basePath, name: "West" }];
const copy = { seoDescription: `Browse {imageCount} painterly Western landscape fine art prints by Wayne Heim, with American West scenery, collector notes, and print options from ${getFormattedLowestStandardPrintPrice()}.`, indexDefinition: "This page presents the complete Western Landscapes archive by Wayne Heim, gathering painterly photographs of mountains, deserts, canyons, rivers, ranchlands, and the American West.", indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.", commercialH1: "Western Landscape Fine Art Series", commercialDeck: "A collection of painterly American West landscape artwork by Wayne Heim.", catalogEntranceTitle: "Western Landscape Fine Art Prints", catalogEntranceCopy: "Browse painterly Western photography built around mountains, deserts, canyons, rivers, distance, and frontier atmosphere.", collectionIntro: "Browse the complete collection of Western landscape images shaped by peaks, desert light, canyons, rivers, and open distance. Each artwork opens to its full story, collector notes, image metadata, and available print details.", gatewayIntroCopy: `{imageCount} painterly Western landscape photographs by Wayne Heim, available as archival fine art prints from ${getFormattedLowestStandardPrintPrice()}. Four edition tiers - open-edition studies to ultra-limited signed collector works - on fine art paper and Baltic Birch wood panels.`, gatewaySupportingCopy: "Every image below is a landscape story in a single frame. Click any work to read the narrative, explore collector notes, and view print details." };
---
<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="Western Painterly Landscapes" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location", categoryName: "Landscapes By Location" }} identity={{ collectionName: "Western Landscapes", variantName: "Gallery", variantDescriptor: "Western landscape", gatewayBrandLabel: "Western Landscape Fine Art Prints - Complete Collection" }} copy={copy} />
