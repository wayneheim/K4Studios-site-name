---
export const prerender = false;
import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/Northeast/Gallery.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/Northeast/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/Northeast/Gallery";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "landscape-location-2", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes">Landscapes</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location">By Location</a>', `<a href="${basePath}">Northeast</a>`, 'Series'].join(' | ');
const breadcrumbStructuredItems = [{ href: "/Galleries", name: "Galleries" }, { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes", name: "Landscapes" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location", name: "By Location" }, { href: basePath, name: "Northeast" }];
const copy = {
  seoTitle: "Northeast Landscape Photography Prints | Painterly Fine Art Landscapes | K4 Studios",
  seoDescription:
    "Browse {imageCount} painterly Northeast landscape fine art prints by Wayne Heim — forest streams, autumn foliage, coastlines, and New England scenery as archival prints from $25. Collector notes on every image.",
  indexDefinition: "This page presents the complete Northeast Landscapes archive by Wayne Heim, gathering painterly photographs of New England, coastlines, forests, lakes, towns, and seasonal atmosphere.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "Northeast Landscape Photography Collection",
  commercialDeck: "{imageCount} painterly Northeast landscape fine art prints by Wayne Heim.",
  catalogEntranceTitle: "Northeast Landscape Fine Art Prints",
  catalogEntranceCopy: "Browse painterly Northeast photography built around coast, woods, historic towns, seasonal color, and morning atmosphere.",
  collectionIntro:
    "Browse the complete collection of Northeast landscape photography — misty forest streams, autumn foliage in peak color, woodland paths, rocky coastlines, and the quiet seasonal light that defines the American Northeast. Each image is painterly fine art landscape photography built around atmosphere, tonal control, water, and the changing moods of a region shaped by season and weather. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy:
    "{imageCount} painterly Northeast landscape fine art prints by Wayne Heim, available as archival fine art from $25. Forest streams, autumn foliage, misty woodland paths, coastlines, and the quiet seasonal light of the American Northeast — every image a complete landscape story shaped by water, weather, and atmosphere. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---
<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="Northeast Painterly Landscapes" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location", categoryName: "Landscapes By Location" }} identity={{ collectionName: "Northeast Landscapes", variantName: "Gallery", variantDescriptor: "Northeast landscape", gatewayBrandLabel: "Northeast Landscape Fine Art Prints - Complete Collection" }} copy={copy} />
