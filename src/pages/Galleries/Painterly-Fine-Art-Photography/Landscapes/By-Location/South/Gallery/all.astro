---
export const prerender = false;
import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/South/Gallery.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/South/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/South/Gallery";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "landscape-location-3", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes">Landscapes</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location">By Location</a>', `<a href="${basePath}">South</a>`, 'Series'].join(' | ');
const breadcrumbStructuredItems = [{ href: "/Galleries", name: "Galleries" }, { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes", name: "Landscapes" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location", name: "By Location" }, { href: basePath, name: "South" }];
const copy = {
  seoTitle: "Southern Landscape Photography Prints | Appalachian Fine Art Landscapes | K4 Studios",
  seoDescription:
    "Browse {imageCount} painterly Southern landscape fine art prints by Wayne Heim — Appalachian forests, mountain streams, ridges, and southern light as archival prints from $25. Collector notes on every image.",
  indexDefinition: "This page presents the complete Southern Landscapes archive by Wayne Heim, gathering painterly photographs of the American South, bayous, mountains, towns, fields, and southern light.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "Southern Landscape Photography Collection",
  commercialDeck: "{imageCount} painterly Southern and Appalachian landscape fine art prints by Wayne Heim.",
  catalogEntranceTitle: "Southern Landscape Fine Art Prints",
  catalogEntranceCopy: "Browse painterly Southern photography built around warm light, water, mountains, small towns, and regional atmosphere.",
  collectionIntro:
    "Browse the complete collection of Southern landscape photography — Appalachian forest streams, misty mountain ridges, dense woodland, cascading waterfalls, and the warm quiet light that defines the American South. Each image is painterly fine art landscape photography built around atmosphere, water, tonal depth, and the ancient character of southern terrain. A growing collection rooted in the Appalachians and expanding across the broader American South. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy:
    "{imageCount} painterly Southern landscape fine art prints by Wayne Heim, available as archival fine art from $25. Appalachian forests, mountain streams, misty ridges, and the warm quiet light of the American South — every image a complete landscape story shaped by water, woodland, and atmosphere. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---
<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="Southern Painterly Landscapes" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location", categoryName: "Landscapes By Location" }} identity={{ collectionName: "Southern Landscapes", variantName: "Gallery", variantDescriptor: "Southern landscape", gatewayBrandLabel: "Southern Landscape Fine Art Prints - Complete Collection" }} copy={copy} />
