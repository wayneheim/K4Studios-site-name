---
export const prerender = false;
import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/Midwest/Gallery.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/Midwest/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/Midwest/Gallery";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "landscape-location-1", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes">Landscapes</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location">By Location</a>', `<a href="${basePath}">Midwest</a>`, 'Series'].join(' | ');
const breadcrumbStructuredItems = [{ href: "/Galleries", name: "Galleries" }, { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes", name: "Landscapes" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location", name: "By Location" }, { href: basePath, name: "Midwest" }];
const copy = {
  seoTitle: "Midwest Landscape Photography Prints | Painterly Fine Art Landscapes - Wayne Heim",
  seoDescription:
    "Browse {imageCount} painterly Midwest landscape fine art prints by Wayne Heim — mills, waterfalls, farmland, storm skies, and heartland scenery as fine art prints from the small-works \"Sketch Series\" at $25. Collector notes on every image.",
  indexDefinition: "This page presents the complete Midwest Landscapes archive by Wayne Heim, gathering painterly photographs of prairies, lakes, fields, rivers, forests, and American heartland atmosphere.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "Midwest Landscape Photography Collection",
  commercialDeck: "{imageCount} painterly Midwest landscape fine art prints by Wayne Heim.",
  catalogEntranceTitle: "Midwest Landscape Fine Art Prints",
  catalogEntranceCopy: "Browse painterly heartland photography built around quiet fields, water, weather, seasonal light, and place.",
  collectionIntro:
    "Browse the complete collection of Midwest landscape photography — historic mills beside waterfalls, storm clouds rolling over farmland, Lake Erie shorelines, forest paths, and the quiet heartland light of the American Midwest. Each image is painterly fine art landscape photography built around weather, water, fields, forests, and the tonal atmosphere of a region most photographers overlook. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy:
    "{imageCount} painterly Midwest landscape fine art prints by Wayne Heim, available as fine art prints from the small-works \"Sketch Series\" at $25 through ultra-limited signed collector editions. Mills, waterfalls, farmland, storm skies, Lake Erie shorelines, and the quiet heartland scenery of the American Midwest — every image a complete landscape story shaped by weather, water, and light. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---
<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="Midwest Painterly Landscapes" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location", categoryName: "Landscapes By Location" }} identity={{ collectionName: "Midwest Landscapes", variantName: "Gallery", variantDescriptor: "Midwest landscape", gatewayBrandLabel: "Midwest Landscape Fine Art Prints - Complete Collection" }} copy={copy} />
