---
export const prerender = false;
import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/International/Gallery.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/International/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/International/Gallery";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "landscape-location-0", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes">Landscapes</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location">By Location</a>', `<a href="${basePath}">International</a>`, 'Series'].join(' | ');
const breadcrumbStructuredItems = [{ href: "/Galleries", name: "Galleries" }, { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes", name: "Landscapes" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location", name: "By Location" }, { href: basePath, name: "International" }];
const copy = {
  seoTitle: "International Landscape Photography Prints | Iceland, Faroe Islands & Beyond | K4 Studios",
  seoDescription:
    "Browse {imageCount} painterly international landscape fine art prints by Wayne Heim — Iceland, Faroe Islands, Newfoundland, Canada, and otherworldly nature from the small-works \"Sketch Series\" at $25. Collector notes on every image.",
  indexDefinition: "This page presents the complete International Landscapes archive by Wayne Heim, gathering painterly landscape photographs from Iceland, Canada, Europe, and other global locations.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "International Landscape Photography Collection",
  commercialDeck: "{imageCount} painterly international landscape fine art prints by Wayne Heim.",
  catalogEntranceTitle: "International Landscape Fine Art Prints",
  catalogEntranceCopy: "Browse painterly landscape photography built around global vistas, weather, distance, atmosphere, and place.",
  collectionIntro:
    "Browse the complete collection of international landscape photography — Iceland's volcanic peaks and waterfalls, the dramatic cliffs of the Faroe Islands, the rugged coastlines of Newfoundland, the wilderness of Canada, and landscapes from beyond American shores shaped by light, weather, ancient terrain, and distance. Each image is painterly fine art landscape photography built around atmosphere, tonal control, and the quiet presence of land under extraordinary skies. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy:
    "{imageCount} painterly international landscape fine art prints by Wayne Heim, available as fine art prints from the small-works \"Sketch Series\" at $25 through ultra-limited signed collector editions. Iceland, the Faroe Islands, Newfoundland, Canada, and the otherworldly nature that exists beyond American borders — landscapes shaped by dramatic light, weather, ancient terrain, and raw distance. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---
<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="International Painterly Landscapes" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location", categoryName: "Landscapes By Location" }} identity={{ collectionName: "International Landscapes", variantName: "Gallery", variantDescriptor: "international landscape", gatewayBrandLabel: "International Landscape Fine Art Prints - Complete Collection" }} copy={copy} />
