---
export const prerender = false;
import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains/Mountains.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "landscape-theme-0", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes">Landscapes</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme">By Theme</a>', `<a href="${basePath}">Mountains</a>`, 'Series'].join(' | ');
const breadcrumbStructuredItems = [{ href: "/Galleries", name: "Galleries" }, { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes", name: "Landscapes" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme", name: "By Theme" }, { href: basePath, name: "Mountains" }];
const copy = {
  seoTitle: "Mountain Landscape Photography Prints | Painterly Fine Art Mountains | K4 Studios",
  seoDescription:
    "Browse {imageCount} painterly mountain landscape fine art prints by Wayne Heim — Tetons, snow peaks, alpine light, and mountain wilderness as fine art prints from the small-works \"Sketch Series\" at $25. Collector notes on every image.",
  indexDefinition: "This page presents the complete Mountain Landscapes archive by Wayne Heim, gathering painterly photographs of peaks, ridgelines, mountain weather, valleys, and high-country atmosphere.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "Mountain Landscape Photography Collection",
  commercialDeck: "{imageCount} painterly mountain landscape fine art prints by Wayne Heim.",
  catalogEntranceTitle: "Mountain Landscape Fine Art Prints",
  catalogEntranceCopy: "Browse painterly mountain photography built around peaks, weather, altitude, ridgelines, distance, and natural drama.",
  collectionIntro:
    "Browse the complete collection of mountain landscape photography — snow-covered peaks, Teton reflections in still water, alpine light across high country, dramatic weather moving through mountain passes, and the quiet distances of wilderness that makes everything else feel small. Each image is painterly fine art landscape photography built around tonal depth, atmosphere, and the geological weight of land shaped over millennia. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy:
    "{imageCount} painterly mountain landscape fine art prints by Wayne Heim, available as fine art prints from the small-works \"Sketch Series\" at $25 through ultra-limited signed collector editions. Snow peaks, Teton reflections, alpine light, dramatic weather, and the vast distances of mountain wilderness — every image a complete mountain story shaped by peaks, valleys, and the weight of land under extraordinary sky. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---
<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="Mountain Painterly Landscapes" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme", categoryName: "Landscapes By Theme" }} identity={{ collectionName: "Mountain Landscapes", variantName: "Theme", variantDescriptor: "mountain landscape", gatewayBrandLabel: "Mountain Landscape Fine Art Prints - Complete Collection" }} copy={copy} />
