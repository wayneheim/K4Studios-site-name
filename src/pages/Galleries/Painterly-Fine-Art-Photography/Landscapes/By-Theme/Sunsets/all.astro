---
export const prerender = false;
import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Sunsets/Sunsets.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Sunsets/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Sunsets";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "landscape-theme-1", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes">Landscapes</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme">By Theme</a>', `<a href="${basePath}">Sunsets</a>`, 'Series'].join(' | ');
const breadcrumbStructuredItems = [{ href: "/Galleries", name: "Galleries" }, { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes", name: "Landscapes" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme", name: "By Theme" }, { href: basePath, name: "Sunsets" }];
const copy = {
  seoTitle: "Sunset Landscape Photography Prints | Painterly Fine Art Sunsets - Wayne Heim",
  seoDescription:
    "Browse {imageCount} painterly sunset landscape fine art prints by Wayne Heim — stormy skies, dramatic light, golden hour reflections, and the charged atmosphere of day's end from the small-works \"Sketch Series\" at $25. Collector notes on every image.",
  indexDefinition: "This page presents the complete Sunset Landscapes archive by Wayne Heim, gathering painterly photographs of golden hour, dramatic skies, silhouetted land, water, and evening atmosphere.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "Sunset Landscape Photography Collection",
  commercialDeck: "{imageCount} painterly sunset landscape fine art prints by Wayne Heim.",
  catalogEntranceTitle: "Sunset Landscape Fine Art Prints",
  catalogEntranceCopy: "Browse painterly sunset photography built around color, sky, silhouette, reflection, weather, and the final light of day.",
  collectionIntro:
    "Browse the complete collection of sunset landscape photography — stormy skies breaking with light, dramatic weather at the edge of day, golden reflections in still water, and the charged atmosphere that builds when a storm and a sunset arrive together. These images cross locations and seasons — unified not by place but by the quality of light at day's end. Each image is painterly fine art sunset photography built around drama, atmosphere, and tonal depth. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy:
    "{imageCount} painterly sunset landscape fine art prints by Wayne Heim, available as fine art prints from the small-works \"Sketch Series\" at $25 through ultra-limited signed collector editions. Stormy skies, dramatic light breaking through weather, water reflections, and the charged atmosphere of the moment when day releases its hold on the land — every image a complete sunset story in a single frame. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---
<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="Sunset Painterly Landscapes" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme", categoryName: "Landscapes By Theme" }} identity={{ collectionName: "Sunset Landscapes", variantName: "Theme", variantDescriptor: "sunset landscape", gatewayBrandLabel: "Sunset Landscape Fine Art Prints - Complete Collection" }} copy={copy} />
