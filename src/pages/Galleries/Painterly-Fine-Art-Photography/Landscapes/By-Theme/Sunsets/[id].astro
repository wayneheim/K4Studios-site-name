---

import BaseLayout from '@/layouts/BaseLayout.astro';
import GalleryShell from "@/components/GalleryShell-Landscapes-Theme-Sunsets.astro";
import { entranceData as ColorEntranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Sunsets/ColorEntranceData.ts";
import { galleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Sunsets/Sunsets.mjs";
import { getImageMeta } from '@/components/utils/getImageMeta.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';

export async function getStaticPaths() {
  return galleryData.map(img => ({
    params: { id: img.id },
  }));
}

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);

const isBadId = !imageData && (id && (id.startsWith('i-') || id === 'i'));
if (isBadId) {
  let cleanUrl = Astro.url.pathname.replace(/\/i[^/]*\/?$/, '');
  cleanUrl = cleanUrl.replace(/\/+$/, '');
  if (typeof window !== "undefined") {
    window.location.replace(cleanUrl);
  } else {
    return Astro.redirect(cleanUrl, 302);
  }
}

function makeAbsoluteUrl(src) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) {
    return src;
  }
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

const imgUrl = makeAbsoluteUrl(imageData.src);

const parentMeta = getLandingMeta(
  "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Sunsets",
  imgUrl
);

const meta = getImageMeta(id, [{ images: galleryData, meta: parentMeta }], parentMeta);
---

<BaseLayout meta={meta}>
  <GalleryShell 
    breadcrumb={ColorEntranceData.breadcrumb} 
    entranceData={ColorEntranceData}
    initialImageId={id}
    currentImageUrl={imgUrl}
    title={meta.title}
  />
</BaseLayout>
