---

import BaseLayout from '@/layouts/BaseLayout.astro';
import GalleryShell from "@/components/GalleryShell-Landscapes-Theme-Water.astro";
import { entranceData as ColorEntranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Water/ColorEntranceData.ts";
import { galleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Water/Water.mjs";
import { getImageMeta } from '@/components/utils/getImageMeta.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';

export async function getStaticPaths() {
  return galleryData.map(img => ({
    params: { id: img.id },
  }));
}

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);
if (!imageData) throw new Error(`Image with id ${id} not found.`);

function makeAbsoluteUrl(src) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) {
    return src;
  }
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

const imgUrl = makeAbsoluteUrl(imageData.src);

const parentMeta = getLandingMeta(
  "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Water",
  imgUrl
);

const meta = getImageMeta(id, [{ images: galleryData, meta: parentMeta }], parentMeta);
---

<BaseLayout meta={meta}>
  <GalleryShell 
    breadcrumb={ColorEntranceData.breadcrumb} 
    entranceData={ColorEntranceData}
    initialImageId={id}
    currentImageUrl={imgUrl}
    title={meta.title}
  />
</BaseLayout>
