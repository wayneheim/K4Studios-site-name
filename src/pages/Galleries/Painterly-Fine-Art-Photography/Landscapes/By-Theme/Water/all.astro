---
export const prerender = false;
import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Water/Water.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Water/ColorEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Water";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "landscape-theme-2", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes">Landscapes</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme">By Theme</a>', `<a href="${basePath}">Water</a>`, 'Series'].join(' | ');
const breadcrumbStructuredItems = [{ href: "/Galleries", name: "Galleries" }, { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes", name: "Landscapes" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme", name: "By Theme" }, { href: basePath, name: "Water" }];
const copy = { seoDescription: `Browse {imageCount} painterly water and waterfall landscape fine art prints by Wayne Heim, with river, lake, and waterfall imagery, collector notes, and print options from ${getFormattedLowestStandardPrintPrice()}.`, indexDefinition: "This page presents the complete Water Landscapes archive by Wayne Heim, gathering painterly photographs of waterfalls, rivers, lakes, shorelines, mist, motion, and still water.", indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.", commercialH1: "Water and Waterfall Landscape Fine Art Series", commercialDeck: "A collection of painterly water and waterfall landscape artwork by Wayne Heim.", catalogEntranceTitle: "Water and Waterfall Fine Art Prints", catalogEntranceCopy: "Browse painterly water photography built around rivers, waterfalls, lakes, reflection, mist, motion, and stillness.", collectionIntro: "Browse the complete collection of water and waterfall landscape images shaped by movement, reflection, mist, texture, and quiet light. Each artwork opens to its full story, collector notes, image metadata, and available print details.", gatewayIntroCopy: `{imageCount} painterly water and waterfall landscape photographs by Wayne Heim, available as archival fine art prints from ${getFormattedLowestStandardPrintPrice()}. Four edition tiers - open-edition studies to ultra-limited signed collector works - on fine art paper and Baltic Birch wood panels.`, gatewaySupportingCopy: "Every image below is a water landscape story in a single frame. Click any work to read the narrative, explore collector notes, and view print details." };
---
<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="Water and Waterfall Painterly Landscapes" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme", categoryName: "Landscapes By Theme" }} identity={{ collectionName: "Water and Waterfall Landscapes", variantName: "Theme", variantDescriptor: "water and waterfall landscape", gatewayBrandLabel: "Water and Waterfall Fine Art Prints - Complete Collection" }} copy={copy} />
