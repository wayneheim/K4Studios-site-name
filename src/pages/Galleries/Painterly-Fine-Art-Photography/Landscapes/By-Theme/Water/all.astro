const basePath = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Water";
const canonicalPath = `${basePath}/all`;
const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({ currentKey: "landscape-theme-2", currentHref: canonicalPath });
const breadcrumbHtml = ['<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes">Landscapes</a>', '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme">By Theme</a>', `<a href="${basePath}">Water</a>`, 'Series'].join(' | ');
const breadcrumbStructuredItems = [{ href: "/Galleries", name: "Galleries" }, { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes", name: "Landscapes" }, { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme", name: "By Theme" }, { href: basePath, name: "Water" }];
const copy = {
  seoTitle: "Waterfall Photography Prints | Water Landscape Fine Art - Wayne Heim",
  seoDescription:
    "Browse {imageCount} painterly water and waterfall fine art prints by Wayne Heim — Iceland waterfalls, lake reflections, rivers, and moving water as fine art prints from the small-works \"Sketch Series\" at $25. Collector notes on every image.",
  indexDefinition: "This page presents the complete Water Landscapes archive by Wayne Heim, gathering painterly photographs of waterfalls, rivers, lakes, shorelines, mist, motion, and still water.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "Water and Waterfall Photography Collection",
  commercialDeck: "{imageCount} painterly water and waterfall fine art prints by Wayne Heim.",
  catalogEntranceTitle: "Water and Waterfall Fine Art Prints",
  catalogEntranceCopy: "Browse painterly water photography built around rivers, waterfalls, lakes, reflection, mist, motion, and stillness.",
  collectionIntro:
    "Browse the complete collection of water and waterfall photography — Iceland's dramatic cascades, lake reflections holding mountain and sky, rivers moving through woodland, coastal water against stone, and the quiet morning light on still water. Water in every form and mood — powerful, reflective, patient, and unstoppable. Each image is painterly fine art landscape photography built around movement, mist, texture, and the tonal depth that water brings to every frame. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayIntroCopy:
    "{imageCount} painterly water and waterfall fine art prints by Wayne Heim, available as fine art prints from the small-works \"Sketch Series\" at $25 through ultra-limited signed collector editions. Iceland waterfalls, lake reflections, rivers, coastal water, and the quiet charged presence of water in motion and at rest — every image a complete water landscape story shaped by movement, mist, reflection, and light. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---
<CommercialCollectionAllPage rawGalleryData={rawGalleryData} entranceData={entranceData} basePath={basePath} canonicalPath={canonicalPath} breadcrumbHtml={breadcrumbHtml} breadcrumbStructuredItems={breadcrumbStructuredItems} sectionDockItems={sectionDockItems} dockCenterIndex={dockCenterIndex} currentDockTitle="Water and Waterfall Painterly Landscapes" archiveContext={{ categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme", categoryName: "Landscapes By Theme" }} identity={{ collectionName: "Water and Waterfall Landscapes", variantName: "Theme", variantDescriptor: "water and waterfall landscape", gatewayBrandLabel: "Water and Waterfall Fine Art Prints - Complete Collection" }} copy={copy} />
