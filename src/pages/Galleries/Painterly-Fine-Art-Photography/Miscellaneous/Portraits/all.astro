---
export const prerender = false;

import CommercialCollectionAllPage from "@/components/all-pages/CommercialCollectionAllPage.astro";
import { galleryData as rawGalleryData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Miscellaneous/Portraits.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Miscellaneous/PortraitsEntranceData.ts";
import { buildWildWestAllPageDock } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/dock/buildWildWestAllPageDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const basePath = "/Galleries/Painterly-Fine-Art-Photography/Miscellaneous/Portraits";
const canonicalPath = `${basePath}/all`;

const { sectionDockItems, dockCenterIndex } = buildWildWestAllPageDock({
  currentKey: "misc-0",
  currentHref: canonicalPath,
});

const breadcrumbHtml = [
  '<a href="/Galleries/Painterly-Fine-Art-Photography">Painterly Fine Art Photography</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Miscellaneous">Miscellaneous</a>',
  `<a href="${basePath}">Portraits</a>`,
  'Collection',
].join(' | ');

const breadcrumbStructuredItems = [
  { href: "/Galleries", name: "Galleries" },
  { href: "/Galleries/Painterly-Fine-Art-Photography", name: "Painterly Fine Art Photography" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Miscellaneous", name: "Miscellaneous" },
  { href: basePath, name: "Portraits" },
];

const copy = {
  seoTitle: "Painterly Fine Art Portrait Photography | Fine Art Portrait Prints - Wayne Heim",
  seoDescription:
    "Browse {imageCount} painterly fine art portrait photographs by Wayne Heim — contemporary portraits, experimental fine art, couples, and character studies as fine art prints from the small-works \"Sketch Series\" at $25. Collector notes on every image.",
  indexDefinition:
    "This page presents the complete Miscellaneous Portraits archive by Wayne Heim. The collection gathers painterly character studies, candid portraits, posed portraits, and expressive human moments outside the larger themed galleries.",
  indexLinkNote: "All {imageCount} images link to individual image pages with full stories, metadata, and collector information.",
  commercialH1: "Painterly Fine Art Portrait Photography Collection",
  commercialDeck: "{imageCount} painterly fine art portrait photographs by Wayne Heim.",
  catalogEntranceTitle: "Painterly Portrait Fine Art Prints",
  catalogEntranceCopy: "Browse fine art portrait photography built around character, expression, atmosphere, gesture, and the quiet story carried by a face.",
  collectionIntro:
    "Browse the complete collection of painterly fine art portrait photography — contemporary women's portraits in Rembrandt-quality light, couples in golden hour atmosphere, experimental fine art departures, period character studies, and the full range of what painterly photography looks like when it moves beyond historical subjects. Each image is built around expression, mood, gesture, and the tonal depth that separates authored fine art from commercial portrait photography. This is what painterly fine art photography actually looks like — not tutorial thumbnails or demonstration shots, but finished works built for walls and collections. Every artwork opens to its full story, collector notes, image metadata, and available print details.",
  gatewayCollectionName: "Miscellaneous Portraits",
  gatewayIntroCopy:
    "{imageCount} painterly fine art portrait photographs by Wayne Heim, available as fine art prints from the small-works \"Sketch Series\" at $25 through ultra-limited signed collector editions. Contemporary character studies, experimental fine art portraiture, couples, atmospheric figures, and the full range of the painterly approach applied beyond historical subjects — every image a complete portrait story in a single frame. Four edition tiers — open-edition studies to ultra-limited signed collector works — on fine art paper and Baltic Birch wood panels.",
  gatewaySupportingCopy: "Click any work to read the full narrative, explore collector notes, and view print details.",
};
---

<CommercialCollectionAllPage
  rawGalleryData={rawGalleryData}
  entranceData={entranceData}
  basePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Miscellaneous Painterly Portraits"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Miscellaneous",
    categoryName: "Miscellaneous Portraits",
  }}
  identity={{
    collectionName: "Miscellaneous Portraits",
    variantName: "Portraits",
    variantDescriptor: "painterly portrait",
    gatewayBrandLabel: "Painterly Portrait Fine Art Prints - Miscellaneous Collection",
  }}
  copy={copy}
/>
