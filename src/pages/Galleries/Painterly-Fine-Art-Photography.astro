---
export const prerender = true;
import BaseLayout         from '@/layouts/BaseLayout.astro';
import LandingHeader      from '@/components/Landing-Header.jsx';
import ImageBar2          from '@/components/ImageBar2.jsx';
import TombstoneNav       from '@/components/TombstoneNav.jsx';
import LandingRightImages from '@/components/LandingRightImages.jsx';
import FeaturedCollection from '@/components/FeaturedCollection.astro';
import FAQAccordion       from '@/components/FAQAccordion.jsx';
import SiteFooter         from '@/components/Footer.astro';
import MobileStoryImages  from '@/components/MobileStoryImages.jsx';
import StorySlider        from '@/components/StorySlider.tsx';
import { galleryData as cowboyColorDataFull } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs';
import { storySliderImageIds } from '@/data/storySlider.ts';
import { getStructuredData } from '@/components/utils/getStructuredData.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';

import { siteNav } from '@/data/siteNav.ts';
import { getSideImages } from '@/components/utils/getSideImages.ts';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';
import { autoLinkKeywordsInText } from '@/components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '@/data/semantic/K4-Sem.ts';

import { landingWestern } from '@/data/Galleries/Painterly-Fine-Art-Photography/landingstones.ts';
import { painterlyStory as westernStory } from '@/data/Galleries/Painterly-Fine-Art-Photography/story.ts';
import { facingFAQ } from '@/data/Galleries/Painterly-Fine-Art-Photography/faq.ts';

import '@/styles/global.css';

// ----------------------
// DYNAMIC LOGIC SECTION
// ----------------------

const sectionPath = "/Galleries/Painterly-Fine-Art-Photography";

// Filter gallery data for StorySlider (reduce payload)
const cowboyColorData = cowboyColorDataFull
  .filter((img: any) => storySliderImageIds.includes(img.id))
  .map((img: any) => ({ id: img.id, title: img.title, story: img.story }));

const headingCount = westernStory.filter((block, i) => i > 0 && block.subhead).length;

function findNavEntry(nav, url) {
  for (const entry of nav) {
    if (entry.href === url) return entry;
    if (entry.children) {
      const found = findNavEntry(entry.children, url);
      if (found) return found;
    }
  }
  return null;
}

function recursivelyGatherAllGalleryHrefs(node) {
  let result = [];
  if (!node) return result;
  if (node.href && node.href.startsWith('/Galleries/')) result.push(node.href);
  if (node.children) node.children.forEach(child => result = result.concat(recursivelyGatherAllGalleryHrefs(child)));
  return result;
}

const landingNav = findNavEntry(siteNav, sectionPath);
const galleryPaths = landingNav
  ? recursivelyGatherAllGalleryHrefs(landingNav)
  : [];
const allGalleryData = import.meta.glob('@/data/Galleries/**/*.mjs', { eager: true }) as any;
const galleryDatas = galleryPaths.map(path => {
  const filePath = "@/data/Galleries" + path.replace(/^\/Galleries/, "") + ".mjs";
  return allGalleryData[filePath]?.galleryData || [];
});

const featheredImages = getSideImages({
  sectionPath,
  headingCount,
  poolMultiplier: 3
});
// Pass full pool to component for client-side rotation

// ----------------------
// Structured Data
// ----------------------
const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingWestern.title,
    description: landingWestern.subtitle || (landingWestern as any)?.description || '',
    url: `https://k4studios.com${sectionPath}`,
    keywords: landingWestern.keywords || [],
    copyrightNotice: "© Wayne Heim"
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    acquireLicensePage: "https://k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

// ----------------------
// NEW: dynamic OG/Twitter image
// ----------------------
function makeAbsoluteUrl(src?: string) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) return src;
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

// Proxy URL helper - ensures SmugMug URLs never appear in SSR HTML
function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return `/img/${imageId}/${size}.jpg`;
}

const landingImg    = featheredImages[0];            // pick first for stability
const landingImgUrl = landingImg?.id ? makeAbsoluteUrl(getProxySrc(landingImg.id, 'l')) : '';

const meta = getLandingMeta(sectionPath, landingImgUrl);
if (!meta.ogUrl)      meta.ogUrl      = `https://k4studios.com${sectionPath}`;
if (!meta.twitterUrl) meta.twitterUrl = `https://k4studios.com${sectionPath}`;

// Featured Collection image (i-7Mzzbvp - "Last Hand" - unmistakably Western)
const featuredCollectionImage = {
  id: "i-7Mzzbvp",
  src: getProxySrc("i-7Mzzbvp", "xl"),
  srcM: getProxySrc("i-7Mzzbvp", "m"),
  srcS: getProxySrc("i-7Mzzbvp", "s"),
  alt: "Painterly Western image of three cowboys on horseback racing forward, guns drawn, in a cloud of dust on the open prairie.",
  width: 600,
  height: 400
};
---

<BaseLayout
  title={landingWestern.title}
  structuredDataJSON={structuredData}
  meta={meta}
>


  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingWestern.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
  <div class="mobile-breadcrumb" set:html={landingWestern.breadcrumb} />
</div>


    <div class="w-full max-w-[1200px] mx-auto px-4">
      <div class="carousel-container">
        <div class="carousel-placeholder" aria-hidden="true"></div>
        <div class="carousel-fade reveal-on-scroll">
          <ImageBar2 client:load />
        </div>
      </div>
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">
          {landingWestern.title}
        </h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">
          {landingWestern.subtitle}
        </h2>
      </div>
    </section>

    <div class="py-5">
      <TombstoneNav items={landingWestern.tombstones} />
    </div>

    <section class="story-layout">
      <div class="text-column">
        <section class="story-section">
          {westernStory.map((section: any, index: number) => (
            <article class="story-block">
              {section.title && <h2 class="slide-in-left" set:html={autoLinkKeywordsInText(section.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
              {section.subhead && <h3 class="slide-in-left" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
              {section.tagline && <h4 class="tagline reveal-on-scroll" set:html={autoLinkKeywordsInText(section.tagline, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
              {section.paragraphs?.map((para: string) => (
                <p class="reveal-on-scroll" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
              ))}
              {section.list && section.list.length > 0 && (
                <ul>
                  {section.list.map((item: string) => (
                    <li class="reveal-on-scroll" set:html={autoLinkKeywordsInText(item, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
                  ))}
                </ul>
              )}
              {/* On Seeing — editorial discovery link */}
              {index === 0 && (
                <aside class="reveal-on-scroll mt-8 mb-6 p-5 bg-[#faf8f5] border-l-2 border-[#c8bfb0] rounded-r" style="max-width: 600px;">
                  <h4 class="text-xs uppercase tracking-widest text-[#8c7d6b] mb-2">On Seeing</h4>
                  <p class="text-sm text-[#4a4a4a] leading-relaxed mb-2">
                    A short series of essays on visual literacy — how images carry meaning, why some endure, and how to look beyond medium and category.
                  </p>
                  <a href="/Other/Seeing" class="text-sm text-[#8b0000] hover:underline">Explore the Seeing essays →</a>
                </aside>
              )}
              {index === 0 && (
                <section class="painterly-portrait-examples">
                  <h2>Examples of Painterly Portrait Photography</h2>

                  <p>
                    Painterly portrait photography applies the tonal hierarchy, directional lighting,
                    and narrative restraint of classical painting traditions to the human subject.
                    These examples demonstrate how the painterly approach translates the emotional
                    presence of portrait painting into photographic form.
                  </p>

                  <div class="portrait-example-grid">
                    <figure class="portrait-tile">
                      <a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/i-c5K798H" aria-label="Open portrait: Old Master–inspired painterly Western portrait">
                        <div class="portrait-media">
                          <img
                            src="/img/i-c5K798H/s.jpg"
                            alt="Old Master–lit painterly Western portrait photography with directional light and deep tonal contrast"
                            title="Old Master–inspired painterly Western portrait"
                            loading="lazy"
                            width="600"
                            height="800"
                          />
                        </div>
                      </a>
                      <figcaption>Directional lighting and tonal hierarchy shape this painterly Western portrait study.</figcaption>
                    </figure>

                    <figure class="portrait-tile">
                      <a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/i-Vr8vzjt" aria-label="Open portrait: Rembrandt-lit painterly Western portrait">
                        <div class="portrait-media">
                          <img
                            src="/img/i-Vr8vzjt/s.jpg"
                            alt="Fine art portrait photography in the painterly tradition using Rembrandt-style side lighting"
                            title="Rembrandt-lit painterly Western portrait"
                            loading="lazy"
                            width="600"
                            height="800"
                          />
                        </div>
                      </a>
                      <figcaption>Painterly portrait photography inspired by classical side-lit portrait composition.</figcaption>
                    </figure>

                    <figure class="portrait-tile">
                      <a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/i-NdQnj6P" aria-label="Open portrait: Cinematic shadow in painterly portrait style">
                        <div class="portrait-media">
                          <img
                            src="/img/i-NdQnj6P/s.jpg"
                            alt="Western portrait rendered in a painterly photographic style with restrained color and cinematic shadow"
                            title="Cinematic shadow in painterly portrait style"
                            loading="lazy"
                            width="600"
                            height="800"
                          />
                        </div>
                      </a>
                      <figcaption>Atmospheric tonality and narrative restraint define this painterly portrait example.</figcaption>
                    </figure>

                    <figure class="portrait-tile">
                      <a href="/Galleries/Painterly-Fine-Art-Photography/Miscellaneous/Portraits/i-dznf8sd" aria-label="Open portrait: Classical atmosphere in painterly portrait photography">
                        <div class="portrait-media">
                          <img
                            src="/img/i-dznf8sd/s.jpg"
                            alt="Painterly portrait photography translating classical portrait painting atmosphere into photographic form"
                            title="Classical atmosphere in painterly portrait photography"
                            loading="lazy"
                            width="600"
                            height="800"
                          />
                        </div>
                      </a>
                      <figcaption>Classical portrait language and controlled tonal depth reinforce the painterly concept.</figcaption>
                    </figure>
                  </div>

                  <p class="portrait-caption">
                    These portraits illustrate how painterly photography blends photographic realism
                    with the visual language of traditional painting.
                  </p>
                </section>
              )}
              {/* Insert StorySlider after section 1 (One-Image Movie intro) */}
              {index === 1 && (
                <div class="story-slider-wrapper reveal-on-scroll mt-8">
                  {/* Skeleton placeholder to prevent CLS */}
                  <div class="story-slider-skeleton relative bg-[#ebe5dc] rounded-lg shadow-md px-6 py-5 max-w-2xl mx-auto border-2 border-[#d8d0c4] mb-12 h-[280px] overflow-hidden">
                    <div class="absolute top-2.5 left-2.5 w-3.5 h-3.5 border-l-2 border-t-2 border-[#c8bfb0]"></div>
                    <div class="absolute bottom-2.5 right-2.5 w-3.5 h-3.5 border-r-2 border-b-2 border-[#c8bfb0]"></div>
                    <p class="text-[11px] uppercase tracking-[0.12em] text-[#8c7d6b] mb-3">One-Image Movie™ Preview</p>
                    <div class="animate-pulse">
                      <div class="h-5 bg-[#d8d0c4] rounded w-3/4 mb-3"></div>
                      <div class="h-4 bg-[#d8d0c4] rounded w-full mb-2"></div>
                      <div class="h-4 bg-[#d8d0c4] rounded w-5/6 mb-2"></div>
                      <div class="h-4 bg-[#d8d0c4] rounded w-4/6"></div>
                    </div>
                  </div>
                  <StorySlider client:only="react" stories={cowboyColorData} galleryPath="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color" />
                </div>
              )}
            </article>
          ))}
        </section>

        <MobileStoryImages client:only="react" images={sanitizeForClient(featheredImages)} displayCount={headingCount} />
      </div>

      <div class="sidebar-column hidden md:block">
        <!-- Featured Collection CTA -->
        <div class="reveal-on-scroll" style="margin-top: 1.5rem; margin-bottom: 6rem;">
          <FeaturedCollection
            image={featuredCollectionImage}
            title="Western Cowboy Collection"
            subtitle="Painterly portraits of the American West"
            ctaText="Enter the Frontier"
            ctaLink="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West"
            collectionName="Western Cowboy Portraits"
            trackingId="Cowboy_Jump_Painterly"
            itemCount={250}
          />
        </div>
        
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages
            client:load
            heading="Explore Other Themes"
            images={sanitizeForClient(featheredImages)}
            displayCount={6}
          />
        </div>
      </div>
    </section>

    <section class="pb-10">
      <input type="checkbox" id="faq-toggle" class="more-toggle" />
      <div class="truncate-container" style="min-height:0;">
        <div class="truncate-text">
          <FAQAccordion items={facingFAQ} />
        </div>
      </div>
      <label for="faq-toggle" class="more-toggle-label"></label>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // Reveal-on-scroll logic
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.15
        });
        els.forEach(el => observer.observe(el));
      }

      // NEW: auto-expand FAQ box if a question is clicked
      const faqToggle = document.getElementById("faq-toggle");
      const truncateContainer = document.querySelector(".truncate-container");

      if (truncateContainer && faqToggle) {
        truncateContainer.addEventListener("click", (e) => {
          const summaryClicked = e.target.closest("summary");
          if (summaryClicked && !faqToggle.checked) {
            faqToggle.checked = true;
          }
        });
      }
    });
  </script>


  <style>

  ul {
  list-style-type: disc;
  padding-left: 1.25em;
}

ul li {
  margin-top: 0.15em;
  margin-left: 1.5em;
}

ul li::marker {
   margin-top: 0.15em;
  font-size: 1.2em; /* makes bullet bigger */
  color: gray;      /* or any tone you want */
}
    @media (max-width: 768px) {
      .section-heading .page-title {
        font-size: 1.5rem;
        line-height: 1.3;
      }

      .section-heading .page-subtitle {
          max-width: 42ch;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
        font-size: 1rem;
        line-height: 1.4;
        letter-spacing: -0.04em;
      }

      .section-heading-wrap {
        margin-top: 1rem;
        margin-bottom: 1rem;
      }

      .sidebar-column {
        display: none;
      }

      .story-section {
        letter-spacing: -0.03em;
      }

      .story-block h2 {
        letter-spacing: -0.05em;
        font-size: 1.4rem !important;
        margin-top: -0.59rem;
        line-height: 1.15;
      }
    }

    .fade-in {
      opacity: 0;
      visibility: hidden;
      transform: translateY(1px);
      transition: opacity 1.75s ease, transform 1.75s ease, visibility .5s linear 1.75s;
    }

    .fade-in.is-visible {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }

    .page-title.fade-in {
      transition-delay: .2s;
    }

    .section-heading-wrap {
      margin: 1.5rem 0;
      text-align: center;
    }

    .section-heading .page-title {
      font-size: 2rem;
      margin-bottom: .4rem;
    }

    .section-heading .page-subtitle {
      font-size: 1rem;
      font-weight: 500;
      color: #6d5b4a;
      opacity: .9;
    }

    .story-section {
      line-height: 1.3;
      padding: 2rem 1.5rem;
      max-width: 860px;
      margin: 0 auto;
      font-family: 'Glegoo', serif;
    }

    .story-block {
      margin-bottom: 2.5rem;
    }

    .story-block h2 {
      font-weight: 500;
      font-size: 1.65rem;
      margin-bottom: 0.55rem;
    }

    .story-section .story-block:first-child h2 {
      letter-spacing: -0.045em;
      white-space: nowrap;
      font-size: 1.58rem;
    }

    @media (max-width: 1024px) {
      .story-section .story-block:first-child h2 {
        white-space: normal;
      }
    }

    .story-block h3 {
      font-weight: 500;
      font-size: 1.2rem;
      margin-top: -0.5rem;
      margin-bottom: -.025rem;
      color: #5a4a3b;
    }

    .story-block .tagline {
      font-size: 1.05rem;
      font-weight: 500;
      margin-bottom: 1rem;
      color: #7a6250;
    }

    .story-block p {
      line-height: 1.6;
      margin-bottom: 1rem;
      font-size: 1.01rem;
    }

    .story-block ul {
      padding-left: 1.4rem;
      margin-top: 0.5rem;
    }

    .story-block li {
      margin-bottom: 0.5rem;
      font-size: 1rem;
    }
.page-subtitle.fade-in {
  opacity: 0 !important; /* Forces initial hidden state */
  transform: translateY(-12px);
  visibility: hidden;
  transition:
    opacity 1.1s ease-out,
    transform 1.1s ease-out,
    visibility 0s linear 1.1s;
  transition-delay: 1s;
}

.page-subtitle.fade-in.is-visible {
  opacity: 1 !important;
  transform: translateY(0);
  visibility: visible;
  transition-delay: 1s;
}

/* Carousel placeholder to prevent CLS */
.carousel-container {
  position: relative;
  width: 100%;
  height: 410px;
  overflow: hidden;
}
.carousel-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: transparent;
}
.carousel-fade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  opacity: 0;
  transform: translateY(0px);
  transition:
    opacity 1.5s ease-out,
    transform 1.5s ease-out;
  transition-delay: 0.0s;
}
@media (max-width: 768px) {
  .carousel-container {
    height: 200px;
  }
}

.sample-fade {
  opacity: 0;
  transform: translateY(0px);
  transition:
    opacity 1.5s ease-out,
    transform 1.5s ease-out;
  transition-delay: 0.2s;
  visibility: hidden;
    margin-top: -0.75rem; /* <-- this line does the nudge */
}

.sample-fade.is-visible {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
}


.carousel-fade.is-visible {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
}

.painterly-portrait-examples {
  margin-top: 2rem;
}

.portrait-example-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 300px));
  justify-content: center;
  gap: 1rem;
  margin-top: 1rem;
  margin-bottom: 1rem;
}

.portrait-tile {
  margin: 0;
}

.portrait-media {
  aspect-ratio: 3 / 4;
  border-radius: 10px;
  overflow: hidden;
}

.portrait-tile figcaption {
  font-size: 0.88rem;
  line-height: 1.35;
  color: #5a4a3b;
  padding-top: 0.5rem;
}

@media (max-width: 768px) {
  .portrait-example-grid {
    grid-template-columns: 1fr;
  }
}

.portrait-example-grid img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.portrait-example-grid .portrait-tile:nth-child(2) img {
  object-position: 30% center;
}

.portrait-example-grid .portrait-tile:nth-child(4) img {
  transform: scale(1.08);
  transform-origin: center center;
}


  </style>
</BaseLayout>
