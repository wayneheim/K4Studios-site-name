---
export const prerender = true;
import { siteNav } from "@/data/siteNav.ts";
import GalleryLightbox from "../../components/GalleryLightbox.jsx";
import Footer from "../../components/Footer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const params = new URLSearchParams(Astro.url.search);
const datasetPathRaw = decodeURIComponent(params.get("dataset") ?? "");
const datasetPath = datasetPathRaw.endsWith(".mjs") ? datasetPathRaw : `${datasetPathRaw}.mjs`;

const modules = import.meta.glob('../data/Galleries/**/*.mjs', { eager: true });

let galleryData = [];
try {
  const mod = modules[`../data${datasetPath}`];
  galleryData = mod.galleryData || mod.default || (Array.isArray(mod) ? mod : []);
} catch (err) {
  console.warn("⚠️ Could not load dataset SSR:", err);
  galleryData = [];
}

const baseUrl = datasetPath.replace(/^\/src\/data/, "").replace(/\.mjs$/i, "");
const canonicalUrl = `https://www.k4studios.com${baseUrl}`;

// 🧹 Text cleaner
function clean(val = "") {
  return String(val)
    .replace(/[\u0000-\u001F]+/g, " ")
    .replace(/"/g, '\\"')
    .replace(/\r?\n|\r/g, " ")
    .trim();
}

// 🧭 Find breadcrumb trail from siteNav
function findBreadcrumbTrail(nav, targetPath) {
  for (const node of nav) {
    if (node.href === targetPath) return [node];
    if (node.children) {
      const childTrail = findBreadcrumbTrail(node.children, targetPath);
      if (childTrail.length) return [node, ...childTrail];
    }
  }
  return [];
}

// Build breadcrumb trail dynamically, excluding "Home" and "Galleries"
const trail = findBreadcrumbTrail(siteNav, baseUrl)
  .filter((node) => node.title !== "Home" && node.title !== "Galleries");

// Human-readable gallery name
const parts = baseUrl.split("/").filter(Boolean);
const last = parts.pop() || "";
const prev = parts.pop() || "";
const galleryName = [prev, last]
  .filter(Boolean)
  .map((s) => s.replace(/-/g, " ").replace(/\b\w/g, (m) => m.toUpperCase()))
  .join(" – ");
---

<BaseLayout title={galleryName} description={`Full SEO index of ${galleryName} from Wayne Heim’s K4 Studios`}>
  <!-- 🚫 NO-MINIFY-START -->
  <script type="application/ld+json" is:inline>
  {JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://www.k4studios.com/#website",
        "name": "K4 Studios",
        "url": "https://www.k4studios.com",
        "publisher": { "@id": "https://www.k4studios.com/#organization" },
        "inLanguage": "en"
      },
      {
        "@type": "Organization",
        "@id": "https://www.k4studios.com/#organization",
        "name": "K4 Studios",
        "url": "https://www.k4studios.com",
        "logo": {
          "@type": "ImageObject",
          "@id": "https://www.k4studios.com/#logo",
          "url": "https://www.k4studios.com/images/K4Logo-web-b.jpg",
          "width": 512,
          "height": 512
        },
        "founder": { "@id": "https://www.k4studios.com/#person" },
        "sameAs": [
          "https://www.instagram.com/k4studios",
          "https://www.pinterest.com/k4studios",
          "https://www.linkedin.com/in/wayneheim"
        ]
      },
      {
        "@type": "Person",
        "@id": "https://www.k4studios.com/#person",
        "name": "Wayne Heim",
        "jobTitle": "Fine Art Photographer & Medical Illustrator",
        "image": "https://www.k4studios.com/images/WayneHeimPortrait.jpg",
        "url": "https://www.k4studios.com/",
        "worksFor": { "@id": "https://www.k4studios.com/#organization" },
        "sameAs": [
          "https://www.instagram.com/k4studios",
          "https://www.pinterest.com/k4studios",
          "https://www.heimmedicalart.com"
        ]
      }
    ]
  }, null, 2)}
  </script>
  <!-- 🚫 NO-MINIFY-END -->

  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <link href="https://fonts.googleapis.com/css2?family=Glegoo:wght@400;700&display=swap" rel="stylesheet" />

  <main>
    <!-- 🧭 Breadcrumb -->
    <nav aria-label="Breadcrumb" class="breadcrumb-nav" itemscope itemtype="https://schema.org/BreadcrumbList">
      <ol class="breadcrumb-list">
        {trail.map((node, index) => {
          const isLast = index === trail.length - 1;
          return (
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              {!isLast ? (
                <a itemprop="item" href={`https://www.k4studios.com${node.href}`}>
                  <span itemprop="name">{node.title}</span>
                </a>
              ) : (
                <span itemprop="name">{node.title}</span>
              )}
              <meta itemprop="position" content={index + 1} />
            </li>
          );
        })}
      </ol>
    </nav>

    <!-- 🖼️ Header -->
    <div class="logo">
      <a href="/" aria-label="Go to K4 Studios Homepage">
        <img src="/images/K4Logo-web-b.jpg" alt="K4 Studios Logo" />
      </a>
    </div>

    <div class="header">
      <a href={canonicalUrl}>{galleryName}</a>
      <p>Mouse over image to see full preview. Click image to view page.</p>
    </div>

    <!-- 🖼️ SSR Grid -->
    <div class="ssr-grid">
      {galleryData.map((item) => {
        const imageUrl = item.srcXL || item.srcL || item.srcM || item.srcS || item.src || "";
        const linkUrl = `${baseUrl}/${item.id}`;
        const fullUrl = `https://www.k4studios.com${linkUrl}`;
        const title = clean(item.title);
        const description = clean(item.description || item.alt || item.title);
        const story = clean(item.story || "");

        return (
          <div class="ssr-card" id={item.id}>
            <a href={linkUrl}>
              <img src={imageUrl} alt={description} title={title} loading="lazy" />
            </a>
            <div class="ssr-card-content">
              <h3>{title}</h3>
              <p>{story}</p>
            </div>

            <!-- 📸 Per-Image JSON-LD -->
            <script type="application/ld+json" is:inline>
            {JSON.stringify({
              "@context": "https://schema.org",
              "@type": "ImageObject",
              name: title,
              description,
              contentUrl: imageUrl,
              url: fullUrl,
              creditText: "© Wayne Heim – K4 Studios",
              license: "https://www.k4studios.com/licensing",
              creator: { "@type": "Person", name: "Wayne Heim" },
              mainEntityOfPage: fullUrl
            }, null, 2)}
            </script>
          </div>
        );
      })}
    </div>

    <!-- 🧱 Collection Page JSON-LD -->
    <script type="application/ld+json" is:inline>
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: clean(galleryName),
      url: canonicalUrl,
      creator: { "@type": "Person", name: "Wayne Heim" },
      creditText: "© Wayne Heim – K4 Studios",
      about: `${clean(galleryName)} from Wayne Heim’s painterly fine art series.`,
      hasPart: galleryData.map((item) => ({
        "@type": "ImageObject",
        name: clean(item.title),
        description: clean(item.description || item.alt || item.title),
        contentUrl: item.srcXL || item.srcL || item.srcM || item.srcS || item.src || "",
        url: `https://www.k4studios.com${baseUrl}/${item.id}`
      }))
    }, null, 2)}
    </script>

    <GalleryLightbox client:only="react" datasetPath={datasetPath} showHeader={false} />
    <Footer />
  </main>

  <style>
    body { background:#fff; color:#2a1f17; font-family:'Glegoo',serif; }
    main { min-height:100vh; padding:24px; }
    .logo { display:flex; justify-content:center; margin:24px 0 16px; }
    .logo a:hover { transform:scale(1.05); }
    .logo img { width:100px; height:100px; border-radius:50%; box-shadow:0 4px 10px rgba(0,0,0,.2); }
    .header { text-align:center; background:#000; color:#fff; padding:16px; border-radius:8px; margin-bottom:24px; }
    .header a { color:#fff; text-decoration:none; font-weight:700; font-size:1.5em; }
    .ssr-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:20px; margin:30px auto; max-width:1600px; }
    .ssr-card { border:1px solid #ddd; border-radius:8px; background:#fff; box-shadow:0 2px 5px rgba(0,0,0,.1); overflow:hidden; }
    .ssr-card img { width:100%; height:140px; object-fit:cover; }
    .ssr-card-content { padding:10px 12px; }
    .ssr-card-content h3 { font-size:.95rem; font-weight:700; margin:0 0 5px; }
    .ssr-card-content p { font-size:.85rem; line-height:1.2rem; margin:0; }

    .breadcrumb-nav { text-align:center; margin-bottom:6px; font-family:'Glegoo', serif; }
    .breadcrumb-list {
      display:inline-flex; flex-wrap:wrap; justify-content:center;
      gap:5px; list-style:none; padding:0; margin:0;
      font-size:0.9rem; color:#6a5747;
    }
    .breadcrumb-list a { color:#85644b; text-decoration:none; transition:color 0.2s ease; }
    .breadcrumb-list a:hover { color:#5a3e2b; }
    .breadcrumb-list li::after { content:"›"; margin:0 4px; color:#9b8b7f; }
    .breadcrumb-list li:last-child::after { content:""; }
  </style>
</BaseLayout>
