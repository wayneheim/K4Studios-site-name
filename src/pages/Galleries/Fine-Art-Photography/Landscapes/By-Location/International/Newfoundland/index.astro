---
export const prerender = true;
import GalleryShell from "@/components/GalleryShell-Landscapes-Location-International-Newfoundland-Traditional.astro";
import { entranceData as ColorEntranceData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Location/International/Newfoundland-ColorEntranceData.ts";
const match = Astro.url.pathname.match(/\/(i-[a-zA-Z0-9]+)/);
const initialImageId = match ? match[1] : undefined;
---

<GalleryShell
  breadcrumb={ColorEntranceData.breadcrumb}
  entranceData={ColorEntranceData}
  initialImageId={initialImageId}
/>
