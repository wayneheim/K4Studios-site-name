---

import BaseLayout from "@/layouts/BaseLayout.astro";
import GalleryShell from "@/components/GalleryShell-Landscapes-Theme-Sunsets-Traditional.astro";
import { entranceData as ColorEntranceData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Theme/Sunsets/ColorEntranceData.ts";
import { galleryData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Theme/Sunsets/Sunsets.mjs";
import { getImageMeta } from "@/components/utils/getImageMeta.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";


export async function getStaticPaths() {
  return galleryData.map(img => ({
    params: { id: img.id },
  }));
}


const { id } = Astro.params;
const image = galleryData.find(img => img.id === id);
if (!image) throw new Error(`Image with id ${id} not found.`);

const meta = {
  ...getImageMeta(image),
  ...getLandingMeta(ColorEntranceData),
};
---


<BaseLayout meta={meta}>
  <GalleryShell 
    breadcrumb={ColorEntranceData.breadcrumb} 
    entranceData={ColorEntranceData}
    initialImageId={id}
  />
</BaseLayout>
