---
import GalleryShell from '@/components/GalleryShell-Landscapes-Theme-Sunsets-Traditional.astro';
import { entranceData as ColorEntranceData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Theme/Sunsets/ColorEntranceData.ts";
import { galleryData } from '@/data/Galleries/Fine-Art-Photography/Landscapes/By-Theme/Sunsets/Sunsets.mjs';

export async function getStaticPaths() {
  return galleryData.map(img => ({
    params: { id: img.id },
  }));
}

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);

const isBadId = !imageData && (id && (id.startsWith('i-') || id === 'i'));
if (isBadId) {
  let cleanUrl = Astro.url.pathname.replace(/\/i[^/]*\/?$/, '');
  cleanUrl = cleanUrl.replace(/\/+$/, '');
  if (typeof window !== "undefined") {
    window.location.replace(cleanUrl);
  } else {
    return Astro.redirect(cleanUrl, 302);
  }
}
---

<GalleryShell 
  breadcrumb={ColorEntranceData.breadcrumb} 
  entranceData={ColorEntranceData}
  initialImageId={id}
/>
