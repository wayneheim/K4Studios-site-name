---

import BaseLayout from "@/layouts/BaseLayout.astro";
import GalleryShell from "@/components/GalleryShell-Architecture-Traditional.astro";
import { entranceData as ColorEntranceData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Theme/Color/ColorEntranceData.ts";
import { galleryData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Theme/Color/Color.mjs";
import { getImageMeta } from "@/components/utils/getImageMeta.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";


export async function getStaticPaths() {
  return galleryData.map(img => ({
    params: { id: img.id },
  }));
}


const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);
if (!imageData) throw new Error(`Image with id ${id} not found.`);

const parentMeta = getLandingMeta("/Galleries/Fine-Art-Photography/Landscapes/By-Theme/Color");
const meta = getImageMeta(id, [{ images: galleryData, meta: parentMeta }], parentMeta);
---


<BaseLayout meta={meta}>
  <GalleryShell 
    breadcrumb={ColorEntranceData.breadcrumb} 
    entranceData={ColorEntranceData}
    initialImageId={id}
  />
</BaseLayout>
