---
/**
 * Static Image Detail Page
 * 
 * All bot detection, 410s, and redirects are handled by the Cloudflare Worker.
 * This page is purely static — generated at build time for each valid image.
 */
export const prerender = true;

import GalleryShell from '@/components/GalleryShell-Transportation-Trains-Black-White-Traditional.astro';
import { entranceData as blackAndWhiteEntranceData } from "@/data/Galleries/Fine-Art-Photography/Transportation/Trains-Black-WhiteEntranceData.ts";
import { galleryData } from '@/data/Galleries/Fine-Art-Photography/Transportation/Trains.mjs';

// Generate static paths for all visible images at build time
export async function getStaticPaths() {
  return galleryData
    .filter(img => img.visibility !== 'hidden' && img.visibility !== 'hide' && img.visibility !== 'ghost' && img.id !== 'i-k4studios')
    .map(img => ({ params: { id: img.id } }));
}

const { id } = Astro.params;

---

<GalleryShell 
  breadcrumb={blackAndWhiteEntranceData.breadcrumb} 
  entranceData={blackAndWhiteEntranceData}
  initialImageId={id}
/>
