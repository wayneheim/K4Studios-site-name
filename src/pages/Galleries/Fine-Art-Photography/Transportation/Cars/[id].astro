---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GalleryShell from "@/components/GalleryShell-Transportation-Cars-Traditional.astro";
import { entranceData as ColorEntranceData } from "@/data/Galleries/Fine-Art-Photography/Transportation/Cars-ColorEntranceData.ts";
import { galleryData } from "@/data/Galleries/Fine-Art-Photography/Transportation/Cars.mjs";
import { getImageMeta } from "@/components/utils/getImageMeta.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";

export async function getStaticPaths() {
  return galleryData.map(img => ({
    params: { id: img.id },
  }));
}

const { id } = Astro.params;
const imageData = galleryData.find(img => img.id === id);
// Gracefully handle missing images - redirect to gallery landing instead of 500
if (!imageData) {
  return Astro.redirect("/Galleries/Fine-Art-Photography/Transportation/Cars", 302);
}


// Ensure absolute URL (don’t prepend if already absolute)
function makeAbsoluteUrl(src) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) {
    return src;
  }
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

const imgUrl = makeAbsoluteUrl(imageData.src);

// Get parent gallery meta, override with correct image URL
const parentMeta = getLandingMeta(
  "/Galleries/Fine-Art-Photography/Transportation/Cars",
  imgUrl
);

const meta = getImageMeta(id, [{ images: galleryData, meta: parentMeta }], parentMeta);
---

<BaseLayout meta={meta}>
  <GalleryShell 
    breadcrumb={ColorEntranceData.breadcrumb} 
    entranceData={ColorEntranceData}
    initialImageId={id}
    currentImageUrl={imgUrl}
    title={meta.title}
  />
</BaseLayout>
