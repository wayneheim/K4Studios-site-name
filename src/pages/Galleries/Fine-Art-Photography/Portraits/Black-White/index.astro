---
export const prerender = true;
import GalleryShell from "@/components/GalleryShell-Portraits-Black-White-Traditional.astro";
import { entranceData as ColorEntranceData } from "@/data/Galleries/Fine-Art-Photography/Portraits/BWEntranceData.ts";

const match = Astro.url.pathname.match(/\/(i-[a-zA-Z0-9]+)/);
const initialImageId = match ? match[1] : null;
---

<GalleryShell
  breadcrumb={ColorEntranceData.breadcrumb}
  entranceData={ColorEntranceData}
  initialImageId={initialImageId}
/>
