---
import GalleryLightbox from "../../components/GalleryLightbox.jsx";
import Footer from "../../components/Footer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLandingMeta } from "@/data/landingMeta.ts";

// ✅ Read query params
const params = new URLSearchParams(Astro.url.search);
const datasetParam = decodeURIComponent(params.get("dataset") ?? "");

// ✅ Normalize and derive datasetPath for later use
//   Example param: "/src/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color"
const datasetPathRaw = datasetParam.replace(/^\/?src\/data\//, "").replace(/\.mjs$/i, "");

// ✅ Dynamic import of the specific gallery dataset
let galleryData = [];
let entranceData = null;
try {
  // Must include .mjs in the static portion for Vite
  const mod = await import(`../../data/${datasetPathRaw}.mjs`);
  galleryData = mod?.galleryData || mod?.default || (Array.isArray(mod) ? mod : []);
} catch (err) {
  console.warn("⚠️ Could not load dataset SSR:", err);
  galleryData = [];
}

// ✅ Load all EntranceData files using Vite glob import
const entranceDataModules = import.meta.glob('../../data/**/*EntranceData.ts', { eager: true });

// ✅ Try to find matching EntranceData for this gallery
const pathParts = datasetPathRaw.split("/").filter(Boolean);
const galleryFolder = pathParts.slice(0, -1).join("/"); // e.g., "Galleries/Painterly.../Western-Cowboy-Portraits"
const galleryName_raw = pathParts[pathParts.length - 1] || ""; // e.g., "Color", "Black-White", "NA-Color"

// Normalize gallery name for matching (remove dashes, lowercase)
const normalizedGalleryName = galleryName_raw.replace(/-/g, "").toLowerCase();

// Build search terms from the gallery name - prioritize the full name and first part
// e.g., "NA-Color" → primary: "na", full: "nacolor"  
// e.g., "Black-White" → primary: "bw", full: "blackwhite"
const nameParts = galleryName_raw.split("-").map(p => p.toLowerCase());
const primaryTerm = nameParts[0]; // First part is most specific (e.g., "na", "black")

// Map common abbreviations
const abbrevMap: Record<string, string> = { "black": "bw" };
const primarySearch = abbrevMap[primaryTerm] || primaryTerm;

// Find matching module - prioritize files that start with the primary term
let bestMatch: { path: string; mod: any; priority: number } | null = null;

for (const [modulePath, mod] of Object.entries(entranceDataModules)) {
  // Must be in the right folder
  if (!modulePath.includes(galleryFolder)) continue;
  
  const fileName = modulePath.split("/").pop() || "";
  const normalizedFileName = fileName.replace(/-/g, "").replace(/entrancedata\.ts$/i, "").toLowerCase();
  
  let priority = 0;
  
  // Highest priority: exact match with primary term at start
  if (normalizedFileName === primarySearch) {
    priority = 100;
  } else if (normalizedFileName.startsWith(primarySearch)) {
    priority = 50;
  } else if (normalizedFileName.includes(primarySearch)) {
    priority = 25;
  } else if (normalizedFileName.includes(normalizedGalleryName)) {
    priority = 10;
  }
  
  if (priority > 0 && (!bestMatch || priority > bestMatch.priority)) {
    bestMatch = { path: modulePath, mod, priority };
  }
}

if (bestMatch) {
  entranceData = (bestMatch.mod as any)?.entranceData || (bestMatch.mod as any)?.default || null;
}

// ✅ Build path + naming
const baseUrl = `/${datasetPathRaw}`;
const parts = baseUrl.split("/").filter(Boolean);
const last = parts.pop() || "";
const prev = parts.pop() || "";
const fallbackGalleryName = [prev, last]
  .filter(Boolean)
  .map((s) => s.replace(/-/g, " ").replace(/\b\w/g, (m) => m.toUpperCase()))
  .join(" – ");

// Always use the path-derived name for the h1 title
const galleryTitle = fallbackGalleryName;
const galleryName = fallbackGalleryName; // used in JSON-LD CollectionPage
const gallerySubtitle = entranceData?.subtitle || "";

const canonicalUrl = `https://www.k4studios.com${baseUrl}`;

// ✅ Get landing page description for intro text
// Prefer entranceData.description if available, otherwise fall back to landingMeta
const landingMeta = getLandingMeta(baseUrl);
const landingDescription = entranceData?.description || landingMeta?.ogDescription || "";

// ✅ Cleaner
const clean = (val = "") =>
  String(val)
    .replace(/[\u0000-\u001F]+/g, " ")
    .replace(/"/g, '\\"')
    .replace(/\r?\n|\r/g, " ")
    .trim();
---

<BaseLayout title={galleryTitle} description={`Full SEO index of ${galleryTitle} from Wayne Heim's K4 Studios`}>
  <!-- 🚫 NO-MINIFY-START (preserve JSON-LD formatting) -->
  <script type="application/ld+json" is:inline>
  {JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://www.k4studios.com/#website",
        "name": "K4 Studios",
        "url": "https://www.k4studios.com",
        "publisher": { "@id": "https://www.k4studios.com/#organization" },
        "inLanguage": "en"
      },
      {
        "@type": "Organization",
        "@id": "https://www.k4studios.com/#organization",
        "name": "K4 Studios",
        "url": "https://www.k4studios.com",
        "logo": {
          "@type": "ImageObject",
          "@id": "https://www.k4studios.com/#logo",
          "url": "https://www.k4studios.com/images/K4Logo-web-b.jpg",
          "width": 512,
          "height": 512
        },
        "founder": { "@id": "https://www.k4studios.com/#person" },
        "sameAs": [
          "https://www.instagram.com/k4studios",
          "https://www.pinterest.com/k4studios",
          "https://www.linkedin.com/in/wayneheim"
        ]
      },
      {
        "@type": "Person",
        "@id": "https://www.k4studios.com/#person",
        "name": "Wayne Heim",
        "jobTitle": "Fine Art Photographer & Medical Illustrator",
        "image": "https://www.k4studios.com/images/WayneHeimPortrait.jpg",
        "url": "https://www.k4studios.com/",
        "worksFor": { "@id": "https://www.k4studios.com/#organization" },
        "sameAs": [
          "https://www.instagram.com/k4studios",
          "https://www.pinterest.com/k4studios",
          "https://www.heimmedicalart.com"
        ]
      }
    ]
  }, null, 2)}
  </script>
  <!-- 🚫 NO-MINIFY-END -->

  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <link href="https://fonts.googleapis.com/css2?family=Glegoo:wght@400;700&display=swap" rel="stylesheet" />

  <main>
    <div class="logo">
      <a href="/" aria-label="Go to K4 Studios Homepage">
        <img src="/images/K4Logo-web-b.jpg" alt="K4 Studios Logo" />
      </a>
    </div>

    <!-- ✅ Dynamic Breadcrumb -->
    <nav aria-label="Breadcrumb" class="breadcrumb-nav" itemscope itemtype="https://schema.org/BreadcrumbList">
      <ol class="breadcrumb-list">
        {(() => {
          const parts = baseUrl.split("/").filter(Boolean);
          let breadcrumbPosition = 1; // Start positions at 1 now that Home is removed
          let pathAccumulator = "";
          return parts
            .map((segment, index) => {
              pathAccumulator += `/${segment}`;
              if (segment.toLowerCase() === "gallery" || segment.toLowerCase() === "galleries") return null;
              const label = segment
                .replace(/-/g, " ")
                .replace(/\b\w/g, (m) => m.toUpperCase());
              const isLast = index === parts.length - 1;
              return (
                <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                  {!isLast ? (
                    <a itemprop="item" href={pathAccumulator}>
                      <span itemprop="name">{label}</span>
                    </a>
                  ) : (
                    <span itemprop="name">{label}</span>
                  )}
                  <meta itemprop="position" content={String(breadcrumbPosition++)} />
                </li>
              );
            })
            .filter(Boolean);
        })()}
      </ol>
    </nav>

    <!-- ✅ Header -->
    <div class="header">
      <h1><a href={canonicalUrl}>{galleryTitle}</a></h1>
      {gallerySubtitle && <p class="subtitle">{gallerySubtitle}</p>}
      <p>Mouse over image to see full preview. Click image to view page.</p>
    </div>

    <!-- ✅ Gallery Intro -->
    {landingDescription && (
      <section class="gallery-intro">
        <p set:html={landingDescription} />
      </section>
    )}

    <!-- ✅ Grid + per-image schema -->
    <div class="ssr-grid">
      {galleryData.map((item) => {
        const imageUrl = item.srcXL || item.srcL || item.srcM || item.srcS || item.src || "";
        const linkUrl = `${baseUrl}/${item.id}`;
        const fullUrl = `https://www.k4studios.com${linkUrl}`;
        const title = clean(item.title);
        const description = clean(item.description || item.alt || item.title);
        const story = clean(item.story || "");

        return (
          <div class="ssr-card" id={item.id}>
            <a href={linkUrl}>
              <img src={imageUrl} alt={description} title={title} loading="lazy" />
            </a>
            <div class="ssr-card-content">
              <h3>{title}</h3>
              <p>{story}</p>
            </div>

            <script type="application/ld+json" is:inline>
            {JSON.stringify({
              "@context": "https://schema.org",
              "@type": "ImageObject",
              name: title,
              description,
              contentUrl: imageUrl,
              url: fullUrl,
              creditText: "© Wayne Heim – K4 Studios",
              license: "https://www.k4studios.com/licensing",
              creator: { "@type": "Person", name: "Wayne Heim" },
              mainEntityOfPage: fullUrl
            }, null, 2)}
            </script>
          </div>
        );
      })}
    </div>

    <!-- ✅ CollectionPage schema -->
    <script type="application/ld+json" is:inline>
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: clean(galleryName),
      url: canonicalUrl,
      isPartOf: {
        "@type": "WebPage",
        "@id": canonicalUrl.substring(0, canonicalUrl.lastIndexOf("/")) // parent section
      },
      creator: { "@type": "Person", name: "Wayne Heim" },
      creditText: "© Wayne Heim – K4 Studios",
      about: `${clean(galleryName)} from Wayne Heim’s painterly fine art series.`,
      hasPart: galleryData.map((item) => ({
        "@type": "ImageObject",
        name: clean(item.title),
        description: clean(item.description || item.alt || item.title),
        contentUrl: item.srcXL || item.srcL || item.srcM || item.srcS || item.src || "",
        url: `https://www.k4studios.com${baseUrl}/${item.id}`
      }))
    }, null, 2)}
    </script>

    <GalleryLightbox client:only="react" datasetPath={datasetPathRaw} showHeader={false} />
    <Footer />
  </main>

  <style>
    body { background:#fff; color:#2a1f17; font-family:'Glegoo',serif; }
    main { min-height:100vh; padding:24px; }

    .logo { display:flex; justify-content:center; margin:32px 0 16px; }
    .logo a:hover { transform:scale(1.05); }
    .logo img { width:100px; height:100px; border-radius:50%; box-shadow:0 4px 10px rgba(0,0,0,.2); }

    .breadcrumb-nav { text-align:center; margin-bottom:8px; font-family:'Glegoo',serif; }
    .breadcrumb-list {
      display:inline-flex; flex-wrap:wrap; justify-content:center;
      gap:6px; list-style:none; padding:0; margin:0;
      font-size:0.9rem; color:#6a5747;
    }
    .breadcrumb-list a { color:#85644b; text-decoration:none; transition:color 0.2s ease; }
    .breadcrumb-list a:hover { color:#5a3e2b; }
    .breadcrumb-list li::after { content:"›"; margin:0 4px; color:#9b8b7f; }
    .breadcrumb-list li:last-child::after { content:""; }

    .header { text-align:center; background:#000; color:#fff; padding:16px; border-radius:8px; margin-bottom:24px; }
    .header h1 { margin:0; font-size:1.5em; font-weight:700; }
    .header h1 a { color:#fff; text-decoration:none; transition:color 0.2s ease; }
    .header h1 a:hover { color:#f0c040; }
    .header .subtitle { margin:4px 0 0; font-size:1em; font-weight:400; font-style:italic; color:#ccc; }
    .header p { margin:8px 0 0; font-size:0.9em; }

    .gallery-intro { max-width:900px; margin:0 auto 24px; text-align:center; }
    .gallery-intro p { font-size:1rem; line-height:1.6; color:#3a2d24; margin:0; }

    .ssr-grid {
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(210px,1fr));
      gap:20px;
      margin:30px auto;
      max-width:1600px;
      align-items:start;
      grid-auto-rows:minmax(260px, auto);
    }

    .ssr-card {
      position:relative;
      border:1px solid #ddd;
      border-radius:8px;
      background:#fff;
      box-shadow:0 2px 5px rgba(0,0,0,.1);
      overflow:hidden;
      transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
    }

    .ssr-card.row-active {
      transform: scale(1.02);
      box-shadow: 0 6px 16px rgba(0,0,0,.12);
    }

    .ssr-card img {
      width:100%;
      height:140px;
      object-fit:cover;
      transition: transform 0.2s ease-out;
      will-change: transform;
    }

    .ssr-card.row-active img {
      transform: scale(1.02);
    }

    .ssr-card-content { padding:10px 12px; }
    .ssr-card-content h3 { font-size:.95rem; font-weight:700; margin:0 0 5px; }
    .ssr-card-content p { font-size:.85rem; line-height:1.2rem; margin:0; }
  </style>

  <script is:inline>
    (function () {
      const grid = document.querySelector('.ssr-grid');
      if (!grid) return;

      const cards = Array.from(grid.querySelectorAll('.ssr-card'));
      if (!cards.length) return;

      let activeRowTop = null;
      let collapseTimer = null;
      const ROW_TOLERANCE = 12; // px

      function getRowTopForCard(card) {
        const rect = card.getBoundingClientRect();
        return rect.top;
      }

      function getRowCardsForTop(rowTop) {
        return cards.filter((c) => {
          const rect = c.getBoundingClientRect();
          return Math.abs(rect.top - rowTop) <= ROW_TOLERANCE;
        });
      }

      function clearActiveRow() {
        cards.forEach((c) => c.classList.remove('row-active'));
        activeRowTop = null;
      }

      function setActiveRowByCard(card) {
        if (!card) return;
        const rowTop = getRowTopForCard(card);

        // Same row – no work needed
        if (activeRowTop !== null && Math.abs(activeRowTop - rowTop) <= ROW_TOLERANCE) {
          return;
        }

        activeRowTop = rowTop;

        cards.forEach((c) => c.classList.remove('row-active'));
        const rowCards = getRowCardsForTop(rowTop);
        rowCards.forEach((c) => c.classList.add('row-active'));
      }

      function findCardForY(clientY) {
        // Find a card whose vertical band contains this Y (used for gaps between cards)
        for (const c of cards) {
          const rect = c.getBoundingClientRect();
          if (clientY >= rect.top - ROW_TOLERANCE && clientY <= rect.bottom + ROW_TOLERANCE) {
            return c;
          }
        }
        return null;
      }

      function handlePointerMove(event) {
        clearTimeout(collapseTimer);

        const target = event.target;
        let card = target.closest('.ssr-card');

        if (!card) {
          // Pointer is between cards or over padding; infer row from Y position
          card = findCardForY(event.clientY);
        }

        if (!card) {
          // Pointer not over/near any row; don't change active row
          return;
        }

        setActiveRowByCard(card);
      }

      grid.addEventListener('mousemove', handlePointerMove);

      grid.addEventListener('mouseenter', () => {
        clearTimeout(collapseTimer);
      });

      grid.addEventListener('mouseleave', () => {
        collapseTimer = setTimeout(() => {
          clearActiveRow();
        }, 180);
      });

      // On resize, layout changes; clear and let next move recompute
      window.addEventListener('resize', () => {
        clearActiveRow();
      });
    })();
  </script>
</BaseLayout>
