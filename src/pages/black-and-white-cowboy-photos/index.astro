---
export const prerender = true;

import CommercialDoorwayAllPage from "@/components/doorway/CommercialDoorwayAllPage.astro";
import { galleryData as cowboyBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs";
import { galleryData as narrativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { galleryData as nativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/BWEntranceData.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const pagePath = "/black-and-white-cowboy-photos";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White";
const canonicalPath = pagePath;
const beyondFrameVideoWidget = {
  videoSlug: "only-path-forward",
  kicker: "Frontier stories come alive.",
  label: "60 seconds: Beyond the frame.",
  compact: true,
  withRules: true,
  ctaWidth: "17rem",
  ruleWidth: "100%",
};

const rotateGallery = (items: any[] = [], offset = 0) => {
  const cleanItems = items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  );
  if (cleanItems.length === 0) return cleanItems;
  const start = offset % cleanItems.length;
  return [...cleanItems.slice(start), ...cleanItems.slice(0, start)];
};

const cowboyBlackWhiteItems = rotateGallery(cowboyBlackWhiteData, 0);
const narrativeBlackWhiteItems = rotateGallery(narrativeBlackWhiteData, 0);
const nativeBlackWhiteItems = rotateGallery(nativeBlackWhiteData, 0);

const breadcrumbHtml = [
  '<a href="/">Wayne Heim</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  "Black and White Cowboy Photos",
].join(" | ");

const breadcrumbStructuredItems = [
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
];

const supportDockItem = (title: string, href: string, thumb: string, subtitle = "") => ({
  title,
  subtitle,
  href,
  thumb,
  cue: "Browse collection ->",
  dockRole: "support",
  dockPrefix: "",
});

const sectionDockItems = [
  supportDockItem(
    "Learn What Makes an Image Feel Cinematic",
    "/Blog/what-makes-an-image-feel-cinematic",
    "/img/i-kp5NHNw/s.jpg"
  ),
  supportDockItem(
    "Learn What Is Narrative Photography",
    "/Blog/what-is-narrative-photography",
    "/img/i-HfQ5NVR/s.jpg"
  ),
  supportDockItem(
    "Learn What Is Painterly Photography",
    "/Blog/what-is-painterly-photography",
    "/img/i-2GsTkqf/s.jpg"
  ),
  supportDockItem(
    "Learn What Is Historical Western Photography",
    "/Blog/what-is-historical-western-photography",
    "/img/i-FnZ68h3/s.jpg"
  ),
  { separator: true, label: "Core black and white Western collections" },
  {
    title: "Black and White Cowboy Portraits",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    thumb: "/img/i-DJMTZ8z/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    title: "Black and White Western Narratives",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    thumb: "/img/i-mqQxwNn/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    title: "Black and White Native American Portraits",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White/all#collection-browser",
    thumb: "/img/i-Z54nXZm/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  { separator: true, label: "Collector notes and related routes" },
  supportDockItem(
    "Learn What Is Western Black and White Photography",
    "/Blog/what-is-western-black-and-white-photography",
    "/img/i-qMQf7b6/s.jpg"
  ),
  supportDockItem(
    "Learn What Makes a Fine Art Print Worth Owning",
    "/Blog/what-makes-a-fine-art-print-worth-owning",
    "/images/tombstones/print-options-ts.webp"
  ),
  supportDockItem(
    "Compare Wood Prints and Paper Prints",
    "/Blog/wood-prints-vs-paper-prints",
    "/images/tombstones/engrained-ts.webp"
