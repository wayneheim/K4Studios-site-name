---
export const prerender = true;

import CommercialDoorwayAllPage from "@/components/doorway/CommercialDoorwayAllPage.astro";
import { galleryData as cowboyBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs";
import { galleryData as narrativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { galleryData as nativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/BWEntranceData.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const pagePath = "/black-and-white-cowboy-photos";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White";
const canonicalPath = pagePath;
const beyondFrameVideoWidget = {
  videoSlug: "only-path-forward",
  kicker: "Frontier stories come alive.",
  label: "60 seconds: Beyond the frame.",
  compact: true,
  withRules: true,
  ctaWidth: "17rem",
  ruleWidth: "100%",
};

const rotateGallery = (items: any[] = [], offset = 0) => {
  const cleanItems = items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  );
  if (cleanItems.length === 0) return cleanItems;
  const start = offset % cleanItems.length;
  return [...cleanItems.slice(start), ...cleanItems.slice(0, start)];
};

const cowboyBlackWhiteItems = rotateGallery(cowboyBlackWhiteData, 0);
const narrativeBlackWhiteItems = rotateGallery(narrativeBlackWhiteData, 0);
const nativeBlackWhiteItems = rotateGallery(nativeBlackWhiteData, 0);

const breadcrumbHtml = [
  '<a href="/">Wayne Heim</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  "Black and White Cowboy Wall Art",
].join(" | ");

const breadcrumbStructuredItems = [
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
];

const supportDockItem = (title: string, href: string, thumb: string, subtitle = "") => ({
  title,
  subtitle,
  href,
  thumb,
  cue: "Browse collection ->",
  dockRole: "support",
  dockPrefix: "",
});

const sectionDockItems = [
  supportDockItem(
    "Learn What Makes an Image Feel Cinematic",
    "/Blog/what-makes-an-image-feel-cinematic",
    "/img/i-kp5NHNw/s.jpg"
  ),
  supportDockItem(
    "Learn What Is Narrative Photography",
    "/Blog/what-is-narrative-photography",
    "/img/i-HfQ5NVR/s.jpg"
  ),
  supportDockItem(
    "Learn What Is Painterly Photography",
    "/Blog/what-is-painterly-photography",
    "/img/i-2GsTkqf/s.jpg"
  ),
  supportDockItem(
    "Learn What Is Historical Western Photography",
    "/Blog/what-is-historical-western-photography",
    "/img/i-FnZ68h3/s.jpg"
  ),
  { separator: true, label: "Core black and white Western collections" },
  {
    title: "Monochrome Cowboy Portrait Prints",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    thumb: "/img/i-DJMTZ8z/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    title: "Black and White Western Narratives",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    thumb: "/img/i-mqQxwNn/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    title: "Black and White Native American Portraits",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White/all#collection-browser",
    thumb: "/img/i-Z54nXZm/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  { separator: true, label: "Collector notes and related routes" },
  supportDockItem(
    "Learn What Is Western Black and White Photography",
    "/Blog/what-is-western-black-and-white-photography",
    "/img/i-qMQf7b6/s.jpg"
  ),
  supportDockItem(
    "Learn What Makes a Fine Art Print Worth Owning",
    "/Blog/what-makes-a-fine-art-print-worth-owning",
    "/images/tombstones/print-options-ts.webp"
  ),
  supportDockItem(
    "Compare Wood Prints and Paper Prints",
    "/Blog/wood-prints-vs-paper-prints",
    "/images/tombstones/engrained-ts.webp"
  ),
  supportDockItem(
    "Compare Decor Art and Fine Art",
    "/Blog/decor-art-vs-fine-art",
    "/img/i-44jcjTQ/s.jpg"
  ),
];
const dockCenterIndex = sectionDockItems.findIndex((item: any) => item.title === "Black and White Western Narratives");

const gridSections = [
  {
    title: "Black and White Western Wall Art",
    description: "Frontier narrative scenes for walls that need story, atmosphere, and old-West tension without relying on warm color. These pieces work as statement art for living rooms, offices, lodge walls, ranch interiors, and hospitality spaces.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white Western wall art collection",
    ctaThumb: "/img/i-mqQxwNn/s.jpg",
    items: narrativeBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Monochrome Cowboy Portrait Prints",
    description: "Black and white cowboy portraits where face, hat brim, coat, hand, posture, and shadow carry the image. Use this route when the room needs human gravity and western character without becoming decorative theme art.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    ctaLabel: "See the full monochrome cowboy portrait print collection",
    ctaThumb: "/img/i-DJMTZ8z/s.jpg",
    items: cowboyBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Black and White Native American Wall Art",
    description: "Restrained monochrome portrait studies shaped by presence, heritage, and tonal quiet. These works belong in rooms where stillness and dignity matter more than spectacle.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White/all#collection-browser",
    ctaLabel: "See the full black and white Native American wall art collection",
    ctaThumb: "/img/i-Z54nXZm/s.jpg",
    items: nativeBlackWhiteItems,
    limit: 19,
  },
];

const countLiveItems = (sections: typeof gridSections) =>
  sections.reduce((total, section) => total + section.items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  ).length, 0);
const blackAndWhiteCowboyPhotosLiveCount = countLiveItems(gridSections);

const commercialMiddleCopy = [
  "Black and white cowboy wall art at K4 Studios is organized around three room-ready monochrome routes: frontier narrative scenes, cowboy portraits, and Native American portrait studies.",
  "Start with frontier narrative work when the wall needs story pressure and cinematic atmosphere. Move into cowboy portraits when the room needs direct human presence, face, posture, and character. Continue into Native American portrait work when the space calls for quiet authority, heritage, and tonal stillness.",
  `The full set includes ${blackAndWhiteCowboyPhotosLiveCount} monochrome western works, but the buying decision should start with the wall: subject, scale, print surface, and how much visual weight the room can hold.`,
].join("\n\n");

const copy = {
  seoTitle: "Black and White Cowboy Wall Art | Fine Art by Wayne Heim",
  seoDescription:
    "Black and white cowboy wall art by Wayne Heim - monochrome western prints for living rooms, offices, and ranch interiors. Archival fine art from $25, four edition tiers.",
  indexDefinition:
    "Wayne Heim's black and white cowboy wall art includes monochrome Western narrative scenes, cowboy portraits, and painterly Native American portrait work created as collector-grade fine art prints for rooms and collector walls.",
  indexLinkNote:
    "Explore black and white cowboy wall art, black and white western wall art, monochrome cowboy prints, and black and white cowboy canvas art with a room-first eye.",
  printAvailabilityNote: `Black and white cowboy wall art prints are available from ${getFormattedLowestStandardPrintPrice()} across archival paper and select wood presentations. Edition status and format options are shown on individual image pages.`,
  commercialH1: `The Collection - Three Monochrome Wall Art Routes, ${blackAndWhiteCowboyPhotosLiveCount} Works`,
  commercialDeck:
    "Frontier narrative scenes, cowboy portraits, and Native American portrait studies organized for rooms, collector walls, and tonal decisions.",
  catalogEntranceTitle: "Black and White Cowboy Wall Art, Frontier Narratives, and Monochrome Western Prints",
  catalogEntranceCopy:
    "Browse black and white cowboy wall art, monochrome frontier scenes, cowboy portrait prints, and Native American portrait work created as collector-grade fine art.",
  collectionIntro: commercialMiddleCopy,
  breadcrumbCurrentName: "Black and White Cowboy Wall Art",
  aggregateOfferLowPrice: "25",
  aggregateOfferHighPrice: "5000",
  aggregateOfferCount: String(blackAndWhiteCowboyPhotosLiveCount),
  gatewayCollectionName: "Black and White Cowboy Wall Art",
  gatewayIntroCopy:
    "Black and white cowboy wall art by Wayne Heim is built for rooms that need Western presence without extra color noise: living rooms, offices, lodges, ranch interiors, hospitality spaces, and collector walls where tone, face, posture, and shadow can carry the room.",
  gatewaySupportingCopy:
    `These are not mass-produced cowboy posters or decorative western prints. Each work begins as photography, then moves through Heim's painterly process so the finished print holds narrative weight, tonal restraint, and the unresolved pressure of a one-image movie.\n\nThe result is monochrome western wall art that can read quietly from across a room and deepen up close: a cowboy portrait, frontier scene, or Native American study shaped as fine art rather than theme decor.\n\nThe collection opens with the Sketch Series, 5x7 prints from ${getFormattedLowestStandardPrintPrice()} - sized for shelves, desks, and introductory collecting. It scales through open-edition Foundation works, signed Chronicle editions with numbered certificates of authenticity, and ultra-limited Legend pieces for collectors who want permanence on the wall.`,
  gatewayKicker: "K4 STUDIOS - BLACK AND WHITE COWBOY WALL ART",
  gatewayHeroTitle: "Black and White Cowboy Wall Art by Wayne Heim",
  gatewayHeroAlt:
    "Black and white cowboy wall art print with tonal restraint and painterly Western fine art presence.",
  gatewayHeroHref:
    "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/i-mqQxwNn",
  gatewayHeroSrc: "/img/i-mqQxwNn/m.jpg",
  gatewayHeroSrcSet: "/img/i-mqQxwNn/s.jpg 400w, /img/i-mqQxwNn/m.jpg 720w",
  archiveContextCopy:
    "Every work on this page is available as fine art wall art - with the Sketch Series opening at $25. For the complete browse set behind these pieces, open the <a href='/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser'>black and white cowboy photos</a> gallery. For the fuller process and portfolio context, explore <a href='/black-and-white-cowboy-photography'>black and white cowboy photography</a> by Wayne Heim. Click into any image to read the story, compare print options, sizes, and collector details. Questions about a specific piece? Reach Wayne directly at <a href='mailto:wayne@k4studios.com'>wayne@k4studios.com</a>.",
  faqKicker: "Print & Collector Questions",
  faqTitle: "Black and White Cowboy Wall Art - Print & Collector Questions",
};

const blackAndWhiteCowboyPhotosFAQ = [
  {
    q: "What size black and white cowboy wall art works best for a living room?",
    a: [
      "For most living rooms, start by matching the print to the wall rather than the subject. A smaller Sketch Series print works well on shelves, desks, intimate groupings, or secondary walls. Foundation prints are the practical wall-art entry point for framed display. Chronicle and Legend editions are better suited to larger focal walls, lodge rooms, offices, ranch interiors, and spaces where the image needs to hold attention from across the room.",
    ],
  },
  {
    q: "Can black and white cowboy prints work in modern or transitional interiors?",
    a: [
      "Yes. Black and white cowboy prints often work especially well in modern, transitional, lodge, ranch, and office interiors because they do not compete with the room's color palette. Monochrome western wall art brings contrast, restraint, and character through tone, posture, shadow, and subject rather than through decorative color.",
    ],
  },
  {
    q: "Are these black and white cowboy wall art prints limited editions?",
    a: [
      "The collection includes both open and limited editions. Sketch and Foundation Series prints are open-edition archival fine art prints starting at $25. Chronicle and Legend Series prints are signed limited editions, numbered and accompanied by a certificate of authenticity for collector walls.",
    ],
  },
  {
    q: "Are paper or wood prints better for black and white cowboy wall art?",
    a: [
      "Archival paper is the most flexible choice when the work will be framed or grouped with other prints. Engrained Baltic Birch wood panels work best when the room needs the print to feel more like an object: rustic, tactile, ready to hang, and connected to wood, leather, stone, or lodge-style materials.",
    ],
  },
];
---

<CommercialDoorwayAllPage
  rawGalleryData={narrativeBlackWhiteItems}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Explore Black and White Cowboy Wall Art"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West",
    categoryName: "Wild West",
  }}
  identity={{
    collectionName: "Black and White Cowboy Wall Art",
    variantName: "Fine Art Prints",
    variantDescriptor: "black and white cowboy wall art",
    gatewayBrandLabel: "Black and White Cowboy Wall Art - Fine Art Prints by Wayne Heim",
  }}
  copy={copy}
  faqItems={blackAndWhiteCowboyPhotosFAQ}
  gridSections={gridSections}
  gatewayVideoWidget={beyondFrameVideoWidget}
  dockVariant="wall-art"
/>
