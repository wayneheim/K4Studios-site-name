---
export const prerender = true;

import CommercialDoorwayAllPage from "@/components/doorway/CommercialDoorwayAllPage.astro";
import { galleryData as cowboyColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as cowboyBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs";
import { galleryData as narrativeColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs";
import { galleryData as narrativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/ColorEntranceData.ts";
import { buildWesternArtPrintsDock } from "@/data/Western-Art-Prints/buildWesternArtPrintsDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
import { faqItems as vintageWesternArtFAQ } from "@/data/hybrid-hubs/vintage-western-art.ts";

const pagePath = "/vintage-western-art";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White";
const canonicalPath = pagePath;

const rotateGallery = (items: any[] = [], offset = 0) => {
  const cleanItems = items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  );
  if (cleanItems.length === 0) return cleanItems;
  const start = offset % cleanItems.length;
  return [...cleanItems.slice(start), ...cleanItems.slice(0, start)];
};

const narrativeColorItems = rotateGallery(narrativeColorData, 18);
const narrativeBlackWhiteItems = rotateGallery(narrativeBlackWhiteData, 9);
const cowboyColorItems = rotateGallery(cowboyColorData, 28);
const cowboyBlackWhiteItems = rotateGallery(cowboyBlackWhiteData, 17);

const breadcrumbHtml = [
  '<a href="/">Wayne Heim</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  "Vintage Western Art",
].join(" | ");

const breadcrumbStructuredItems = [
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
];

const { sectionDockItems, dockCenterIndex } = buildWesternArtPrintsDock();

const gridSections = [
  {
    title: "Black and White Vintage Cowboy Portraits",
    description: "Black and white cowboy portraits for collectors who want old-West gravity, character, and tonal frontier restraint.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white vintage cowboy collection",
    ctaThumb: "/images/tombstones/cowboy-bw-ts.webp",
    items: cowboyBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Vintage Cowboy Art - Color Portraits",
    description: "Color cowboy portrait prints with weathered character, frontier posture, and the painterly period presence that holds a room.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/all#collection-browser",
    ctaLabel: "See the full color vintage cowboy portrait collection",
    ctaThumb: "/img/i-5FX3W9r/s.jpg",
    items: cowboyColorItems,
    limit: 19,
  },
  {
    title: "Old West Black and White Art",
    description: "Monochrome frontier narrative prints where restraint, deep contrast, and old-West tension carry the vintage feeling further than color can.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white old West collection",
    ctaThumb: "/img/i-kp5NHNw/s.jpg",
    items: narrativeBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Vintage Western Art - Color Frontier Scenes",
    description: "Color frontier scenes with old-West atmosphere, painterly light, and story-led Western presence.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/all#collection-browser",
    ctaLabel: "See the full color vintage Western collection",
    ctaThumb: "/img/i-B7ZSdfs/s.jpg",
    items: narrativeColorItems,
    limit: 19,
  },
];

const countLiveItems = (sections: typeof gridSections) =>
  sections.reduce((total, section) => total + section.items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  ).length, 0);
const vintageWesternArtLiveCount = countLiveItems(gridSections);

const commercialMiddleCopy = [
  "Vintage Western art is less about age than about memory. It is the visual language of the West before the myth became polished: frontier towns, lonely riders, guarded faces, period clothing, rough interiors, dust, consequence, and the story pressure that later hardened into legend.",
  "Start with the narrative scenes when the wall needs old-West imagination: the dime-novel charge, the frontier painting mood, the sense that something happened just before the image and something else is about to happen after it. Move into the cowboy portrait sections when the vintage feeling needs to live in face, hat, clothing, posture, and human presence.",
  "These are contemporary K4 Studios works shaped for collectors who want the nostalgia and narrative pull of vintage Western paintings, old posters, and illustrated frontier stories without buying reproduction decor.",
].join("\n\n");

const copy = {
  seoTitle: "Vintage Western Art - Fine Art Prints by Wayne Heim | K4 Studios",
  seoDescription:
    "Vintage Western art by Wayne Heim. Old-West frontier scenes, vintage cowboy portraits, period styling, dime-novel atmosphere, and collector fine art prints from $25.",
  indexDefinition:
    "Wayne Heim's vintage-facing Western catalog includes old-West narrative scenes, cowboy character studies, frontier portraits, black and white Western prints, and painterly artwork created as collector-grade fine art prints.",
  indexLinkNote:
    "This is the K4 commercial route for old-West art, vintage cowboy art, old Western prints, old West posters, and frontier searches that want period atmosphere rather than literal antique objects.",
  printAvailabilityNote: `Vintage Western prints are available from ${getFormattedLowestStandardPrintPrice()} across archival paper and select wood presentations. Edition status and format options are shown on individual image pages.`,
  commercialH1: "Vintage Western Art, Old-West Stories, and Frontier Icons",
  commercialDeck:
    "Four routes through {catalogImageCount} works: old-West frontier scenes, vintage cowboy portraits, black and white studies, and color narratives shaped around the era when Western legends were still being formed.",
  catalogEntranceTitle: "Vintage Western Art, Vintage Cowboy Prints, and Old West Fine Art",
  catalogEntranceCopy:
    "Browse old-West narrative scenes, vintage cowboy portraits, black and white studies, and frontier artwork created as collector-grade fine art.",
  collectionIntro: commercialMiddleCopy,
  breadcrumbCurrentName: "Vintage Western Art",
  aggregateOfferLowPrice: "25",
  aggregateOfferHighPrice: "5000",
  aggregateOfferCount: String(vintageWesternArtLiveCount),
  gatewayCollectionName: "Vintage Western Art",
  gatewayIntroCopy:
    "Vintage Western art begins where history starts becoming legend.",
  gatewaySupportingCopy:
    `The American Wild West was not born as a clean symbol. It was built out of settlement, conflict, ranching, railroads, mining towns, displacement, showmanship, dime-store novels, frontier illustration, and the people who became larger after the telling. The vintage pull comes from that crossing: part history, part memory, part theater, part truth.\n\nWayne Heim's work in this route is not antique reproduction and not modern cowboy decor dressed up with sepia. It is contemporary fine art built around period-correct styling, weathered character, old-West atmosphere, and the narrative charge of the era when the icons of the West were still being formed. The point is not to copy a vintage painting or a pulp cover. The point is to recover the imaginative pressure those images carried.\n\nSketch Series studies begin at ${getFormattedLowestStandardPrintPrice()}, with larger archival paper prints available through the standard K4 print structure. Selected Chronicle and Legend editions add signed numbering and a certificate of authenticity for collector walls.`,
  gatewayKicker: "K4 Studios - Vintage Western Fine Art Print Catalog",
  gatewayHeroTitle: "Vintage Western Art by Wayne Heim",
  gatewayHeroAlt:
    "Color frontier scene with old-West narrative atmosphere, vintage Western styling, and painterly collector wall presence.",
  gatewayHeroHref:
    "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-B7ZSdfs",
  gatewayHeroSrc: "/img/i-B7ZSdfs/m.jpg",
  gatewayHeroSrcSet: "/img/i-B7ZSdfs/s.jpg 400w, /img/i-B7ZSdfs/m.jpg 720w",
  archiveContextCopy:
    "K4 Studios organizes this route by story register: black and white cowboy portraits, color cowboy portraits, monochrome old-West narratives, and color frontier scenes. Open any image for story, sizing, print path, and collector notes. Questions about a specific piece? Reach Wayne directly at <a href='mailto:wayne@k4studios.com'>wayne@k4studios.com</a>.",
  conceptBlock1Title: "THE OLD-WEST FACE",
  conceptBlock1Copy:
    "Black and white cowboy portraits carry the oldest register on this page. Without color, the viewer reads hat, face, hand, cloth, light, and posture as period signals. The vintage effect comes from restraint, not from artificial aging.",
  conceptBlock2Title: "THE PERIOD FIGURE",
  conceptBlock2Copy:
    "Color cowboy portraits bring the era forward through styling, light, and character. The goal is not a modern cowboy costume. It is a figure that feels closer to the 19th-century West, before the cowboy image became clean, branded, and familiar.",
  conceptBlock3Title: "THE DIME-NOVEL SHADOW",
  conceptBlock3Copy:
    "Black and white frontier narratives lean toward the imagination of old posters, pulp covers, and dime-novel suspense. They hold back enough information that the viewer has to finish the scene.",
  conceptBlock4Title: "THE FRONTIER STORY",
  conceptBlock4Copy:
    "Color frontier scenes carry the theatrical side of old-West art: dust, distance, warm light, mounted figures, and old-West tension. This is the route when the wall needs story before it needs portrait.",
  faqKicker: "Print & Collector Questions",
  faqTitle: "Vintage Western Art FAQ",
};
---

<CommercialDoorwayAllPage
  rawGalleryData={cowboyBlackWhiteItems}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Explore Vintage Western Art Collections"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West",
    categoryName: "Wild West",
  }}
  identity={{
    collectionName: "Vintage Western Art",
    variantName: "Fine Art Prints",
    variantDescriptor: "vintage Western art",
    gatewayBrandLabel: "Vintage Western Art - Fine Art Prints by Wayne Heim",
  }}
  copy={copy}
  faqItems={vintageWesternArtFAQ}
  gridSections={gridSections}
  dockVariant="wall-art"
  layoutVariant="cinematic-concept-series-top"
/>
