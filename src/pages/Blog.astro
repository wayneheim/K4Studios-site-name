---
export const prerender = true;
import BaseLayout    from "@/layouts/BaseLayout.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter    from "@/components/Footer.astro";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { getLandingMeta } from "@/data/landingMeta.ts";
import { normalizeImageSrc } from "@/utils/imageProxy.js";

import { posts } from "@/data/Other/Blog/posts.mjs"; // new dataset
import { galleryData as painterlyImages } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as civilWarColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color.mjs";
import { galleryData as civilWarBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White.mjs";
import { galleryData as roaring20sColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color.mjs";
import { galleryData as roaring20sBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White.mjs";
import { galleryData as wwiiPortraitsColor } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color.mjs";
import { galleryData as wwiiPortraitsBW } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White.mjs";
import { autoLinkKeywordsInText } from "@/components/utils/autoLinkKeywordsInText.ts";
import { semantic as k4Semantic } from "@/data/semantic/K4-Sem.ts";
import {
  galleryDataMap,
  sectionGalleries,
  allImages
} from "@/data/galleryMaps/MasterGalleryData.mjs";
import "@/styles/global.css";

// ----------------------
// Dynamic Logic
// ----------------------
const sectionPath = "/Blog";

const structuredData = getStructuredData({
  type: "Blog",
  data: {
    name: "Inside the Frame",
    description: "Conversations with Quill about layered storytelling, composition, and painterly photography.",
    url: `https://k4studios.com${sectionPath}`,
    copyrightNotice: "© Wayne Heim",
    author: {
      "@type": "Person",
      name: "Wayne Heim"
    },
    blogPost: posts.map(p => ({
      "@type": "BlogPosting",
      headline: p.title,
      datePublished: p.date,
      description: p.excerpt,
      image: `https://k4studios.com${normalizeImageSrc(p.cover, 'l')}`,
      url: `https://k4studios.com/Blog/${p.slug}`
    }))
  },
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

// OG/Twitter image - use absolute proxy URL capped at L size
const ogImageUrl = "https://www.k4studios.com/img/i-LCspRF4/l";

const meta = getLandingMeta(sectionPath);
meta.ogImage = ogImageUrl;
meta.twitterImage = ogImageUrl;
if (!meta.ogUrl)      meta.ogUrl      = `https://k4studios.com${sectionPath}`;
if (!meta.twitterUrl) meta.twitterUrl = `https://k4studios.com${sectionPath}`;

// Prepare gallery preview images from multiple painterly galleries
function shuffleArray<T>(arr: T[]): T[] {
  return arr
    .map(value => ({ value, sort: Math.random() }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ value }) => value);
}

// Combine images from multiple Facing History galleries
const allGalleryImages = [
  ...painterlyImages.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color" })),
  ...civilWarColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Color" })),
  ...civilWarBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Civil-War-Portraits/Black-White" })),
  ...roaring20sColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Color" })),
  ...roaring20sBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/Roaring-20s-Portraits/Black-White" })),
  ...wwiiPortraitsColor.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Color" })),
  ...wwiiPortraitsBW.map(img => ({ ...img, galleryPath: "Galleries/Painterly-Fine-Art-Photography/Facing-History/WWII/Portraits/Black-White" }))
].filter(img => img.visibility !== "ghost");

const previewImages = shuffleArray(allGalleryImages).slice(0, 6);
const previewPath = "/Galleries"; // Needed for GalleryPreviewStrip to render

// Setup for keyword linking
const galleryDatas = Object.values(galleryDataMap).flat();
const featheredImages = allImages.filter(img => (img as any).visibility !== "ghost").slice(0, 12);
const galleryPaths = Object.keys(galleryDataMap);
---

<BaseLayout
  title="Inside the Frame – K4 Studios Blog"
  structuredDataJSON={structuredData}
  meta={meta}
>
  <main class="bg-white text-[#2c2c2c] min-h-screen overflow-x-hidden" style="font-family: 'Glegoo', serif;">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb="<a href='/Other' style='color: inherit; text-decoration: none;'>Other</a> › Blog" />
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading" style="font-family: 'Glegoo', serif;">
        <h1 class="page-title fade-in reveal-on-scroll" style="font-family: 'Glegoo', serif;">Inside the Frame</h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll" style="font-family: 'Glegoo', serif;">
          Conversations on story, image, and meaning
        </h2>
      </div>
    </section>

    <!-- Intro block -->
    <section class="intro-text max-w-2xl mx-auto px-4 text-center mb-10">
  <h2 class="text-4xl font-extrabold mb-2" style="font-family: 'Glegoo', serif;">Inside the Frame</h2>
  <h3 class="text-2xl font-semibold mb-8 text-gray-700" style="font-family: 'Glegoo', serif;">The K4 Studios Blog</h3>
        <p class="text-lg leading-relaxed text-gray-700" set:html={autoLinkKeywordsInText('\"Inside the Frame\" is where I step out from behind the lens and share the stories that shape my work. Part interview, part reflection, these posts explore composition, symbolism, and the choices that transform my fine art photography into narrative-driven, storytelling.', galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} /></p>        <p class="text-sm text-gray-500 mt-4 italic">
          <a href="/Other/Seeing" class="text-[#8b0000] hover:underline">Seeing</a> is a short essay series on visual literacy and interpretation.
        </p>    </section>

    <section class="story-layout" style="font-family: 'Glegoo', serif;">
      <!-- MAIN CONTENT (left) -->
      <div class="text-column">
        {posts.map(post => (
          <article class="story-block mb-10">
            <div class="flex flex-col md:flex-row md:items-start gap-4 items-center md:items-start">
              <a href={`/Blog/${post.slug}`} aria-label={post.title} class="flex-shrink-0">
                <img
                  src={normalizeImageSrc(post.cover, 'm')}
                  alt={post.title}
                  class="rounded-2xl shadow max-w-[200px] h-[200px] object-cover"
                  style="aspect-ratio: 1/1;"
                  oncontextmenu="event.preventDefault()"
                />
              </a>
              <div class="flex-1 min-w-0">
                <h2 class="text-xl font-bold mb-2">
                  <a href={`/Blog/${post.slug}`}>{post.title}</a>
                </h2>
                <p class="text-sm text-gray-600 mb-2">{post.date}</p>
                <p class="mb-4" set:html={autoLinkKeywordsInText(post.excerpt, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
                <a href={`/Blog/${post.slug}`} class="underline text-blue-700">Read more →</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- SIDEBAR (right) -->
      <div class="sidebar-column hidden md:block">
        <div class="sample-fade reveal-on-scroll p-4 border rounded-xl shadow bg-gray-50">
          <h3 class="font-bold mb-3">All Posts</h3>
          <ul class="space-y-2">
            {posts.map(post => (
              <li>
                <a href={`/Blog/${post.slug}`} class="block hover:text-red-600">
                  {post.title}
                </a>
                <span class="block text-xs text-gray-500">{post.date}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Full-width divider before Cornerstones -->
    <div class="cornerstones-divider"></div>

    <!-- Cornerstones Section -->
    <section class="cornerstones-section max-w-4xl mx-auto px-4 mt-2 md:mt-4 mb-12">
      <h2 class="cornerstones-heading">Cornerstones</h2>
      <p class="cornerstones-intro">
        Reference articles defining the disciplines behind the work.
      </p>
      <div class="cornerstones-grid">
        <a href="/Blog/what-is-western-art" class="cornerstone-card">
          <h3>What Is Western Art?</h3>
          <p>History, meaning, and evolution of the American West in art</p>
        </a>
        <a href="/Blog/what-is-western-fine-art" class="cornerstone-card">
          <h3>What Is Western Fine Art?</h3>
          <p>Definition, distinction, and why the term matters</p>
        </a>
        <a href="/Blog/what-is-western-fine-art-photography" class="cornerstone-card">
          <h3>What Is Western Fine Art Photography?</h3>
          <p>Definition, distinction, and what it is not</p>
        </a>
        <a href="/Blog/what-is-artistic-western-photography" class="cornerstone-card">
          <h3>What Is Artistic Western Photography?</h3>
          <p>Craft, composition, and the expressive lens</p>
        </a>
        <a href="/Blog/what-is-painterly-photography" class="cornerstone-card">
          <h3>What Is Painterly Photography?</h3>
          <p>Meaning, misuse, and the fine art distinction</p>
        </a>
      </div>
    </section>

    <SiteFooter 
      previewImages={previewImages}
      previewPath={previewPath}
      title="Inside the Frame – K4 Studios Blog"
      label="Explore Galleries"
      class="pt-8 pb-12" 
    />
  </main>

  <style>
    /* Cornerstones Section */
    .cornerstones-divider {
      width: 100%;
      max-width: 900px;
      height: 1px;
      background: linear-gradient(to right, transparent, #d0d0d0 8%, #d0d0d0 92%, transparent);
      margin: 1rem auto 0;
    }
    .cornerstones-heading {
      font-family: 'Glegoo', serif;
      font-size: 1.5rem;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 0.5rem;
      text-align: center;
    }
    .cornerstones-intro {
      text-align: center;
      color: #666;
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }
    .cornerstones-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
    }
    .cornerstone-card {
      display: block;
      padding: 1.25rem 1.5rem;
      background: #faf9f7;
      border: 1px solid #e8e6e3;
      border-radius: 8px;
      text-decoration: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .cornerstone-card:hover {
      border-color: #8b5a2b;
      box-shadow: 0 2px 8px rgba(139, 90, 43, 0.1);
    }
    .cornerstone-card h3 {
      font-family: 'Glegoo', serif;
      font-size: 1.1rem;
      font-weight: 600;
      color: #2c2c2c;
      margin: 0 0 0.35rem 0;
    }
    .cornerstone-card p {
      font-size: 0.9rem;
      color: #666;
      margin: 0;
      font-style: italic;
    }
    
    @media (max-width: 768px) {
      .cornerstones-divider {
        margin-top: 0.5rem !important;
      }
      .cornerstones-section {
        margin-top: 0.5rem !important;
      }
      .sidebar-column {
        display: none !important;
        height: 0 !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .story-layout {
        display: block !important;
      }
      .story-block h2 {
        text-align: center !important;
      }
    }
  </style>
</BaseLayout>
