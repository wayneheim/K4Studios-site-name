---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import LandingHeader from '@/components/Landing-Header.jsx';
import TombstoneNav from '@/components/TombstoneNav.jsx';
import HybridBookCarousel from '@/components/hybrid/HybridBookCarousel.jsx';
import WesternGuideNav from '@/components/authority/WesternGuideNav.astro';
import SiteFooter from '@/components/Footer.astro';

import {
  cowboyColorDataFull,
  westernNarrativesColorData,
  westernNAColorData as cowboyNAData,
  findWesternLandingImage,
} from '@/data/carousel/westernLandingContent.ts';

import { getStructuredData, getBreadcrumbList } from '@/components/utils/getStructuredData.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';
import { getOrderedWesternGalleryPaths } from '@/data/carousel/westernRouting.ts';
import { getFeatheredImages } from '@/components/utils/getFeatheredImages.ts';

import { landingAmericanWesternArt } from '@/data/American-Western-Art/landingstones.ts';
import { americanWesternArtStory } from '@/data/American-Western-Art/story.ts';
import { americanWesternArtFAQ } from '@/data/American-Western-Art/faq.ts';

import '@/styles/global.css';
import '@/styles/oneupheader.css';

const pagePath = '/American-Western-Art';
const imageSectionPath = '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits';
const cowboyColorPath = '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color';
const narrativeColorPath = '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color';
const naColorPath = '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color';
const wildWestCollectionPath = '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West';
const frontierCollectionPath = '/Galleries/Painterly-Fine-Art-Photography/Facing-History?focus=frontier';

const landingDescription = 'Browse American Western art by Wayne Heim: collector-focused cowboy portraits, Indigenous portrait work, and frontier narrative scenes offered as museum-quality fine art prints.';
const introLeadParagraphs = americanWesternArtStory[0]?.paragraphs || [];
const introSupportText = americanWesternArtStory[1]?.paragraphs?.[0] || '';
const faqLeft = americanWesternArtFAQ.slice(0, 4);
const faqRight = americanWesternArtFAQ.slice(4, 8);

const curatedCarouselIds = [
  'i-LCspRF4',
  'i-7Mzzbvp',
  'i-qMQf7b6',
  'i-HfQ5NVR',
  'i-LmpRvHw',
  'i-89qzJ6S',
];

function ensureAlt(img: any, fallback: string = 'Painterly American Western art by Wayne Heim') {
  return (img?.alt || img?.title || fallback || '').trim() || fallback;
}

function topRated(data: any[], count: number, excludedIds: Set<string> = new Set()) {
  return (data || [])
    .filter((img: any) => img.visibility !== 'ghost' && img.visibility !== 'hidden' && img.id !== 'i-k4studios')
    .filter((img: any) => !excludedIds.has(img.id))
    .sort((a: any, b: any) => (b.rating ?? 0) - (a.rating ?? 0) || (a.sortOrder ?? 0) - (b.sortOrder ?? 0))
    .slice(0, count);
}

function buildSlide(img: any, hrefBase: string) {
  return {
    id: img.id,
    title: img.title,
    alt: ensureAlt(img),
    story: img.story || img.description || '',
    href: `${hrefBase}/${img.id}`,
  };
}

function findCuratedImage(id: string) {
  return findWesternLandingImage(id, imageSectionPath);
}

const curatedCarouselSlides = curatedCarouselIds
  .map(findCuratedImage)
  .filter(Boolean)
  .map(({ img, href }: any) => ({
    id: img.id,
    title: img.title,
    alt: ensureAlt(img),
    story: img.story || img.description || '',
    href,
  }));

const fallbackCarouselSlides = [
  ...topRated(cowboyColorDataFull, 3).map((img: any) => buildSlide(img, cowboyColorPath)),
  ...topRated(westernNarrativesColorData, 2).map((img: any) => buildSlide(img, narrativeColorPath)),
  ...topRated(cowboyNAData, 1).map((img: any) => buildSlide(img, naColorPath)),
];

const carouselSlides = curatedCarouselSlides.length >= 6
  ? curatedCarouselSlides
  : fallbackCarouselSlides;

const carouselIds = new Set(carouselSlides.map((slide: any) => slide.id));

const galleryPaths: string[] = getOrderedWesternGalleryPaths(imageSectionPath);
const allGalleryData = import.meta.glob('../../data/Galleries/**/*.mjs', { eager: true }) as any;
const galleryDatas = galleryPaths.map((path) => {
  const filePath = '../../data/Galleries' + path.replace(/^\/Galleries/, '') + '.mjs';
  return allGalleryData[filePath]?.galleryData || [];
});

const headingCount = americanWesternArtStory.filter((block: any, index: number) => index > 0 && block.subhead).length;

const featheredImages = getFeatheredImages({
  sectionPath: imageSectionPath,
  headingCount: Math.max(headingCount, 9),
  galleryDatas,
  galleryPaths,
  minRating: 3,
  fallbackMin: 1,
  poolMultiplier: 3,
});

function makeAbsoluteUrl(src?: string) {
  if (!src) return '';
  if (src.startsWith('http://') || src.startsWith('https://')) return src;
  return `https://www.k4studios.com${src.startsWith('/') ? src : '/' + src}`;
}

function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return `/img/${imageId}/${size}.jpg`;
}

const structuredData = getStructuredData({
  type: 'gallery',
  data: {
    title: landingAmericanWesternArt.title,
    description: landingDescription,
    url: `https://www.k4studios.com${pagePath}`,
    keywords: landingAmericanWesternArt.keywords || [],
    copyrightNotice: '© Wayne Heim',
    about: [
      { '@type': 'Thing', name: 'American Western Art' },
      { '@type': 'Thing', name: 'Cowboy Portraits' },
      { '@type': 'Thing', name: 'Frontier Narratives' },
      { '@type': 'Thing', name: 'Indigenous Portraits' },
      { '@type': 'Thing', name: 'Western Art Prints' },
      { '@type': 'Thing', name: 'Painterly Photography' },
    ],
    genre: 'American Western Art',
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: '© Wayne Heim',
    license: 'https://www.k4studios.com/copyright',
    acquireLicensePage: 'https://www.k4studios.com/Other/Print-Options',
    creditText: 'Wayne Heim',
    creatorName: 'Wayne Heim',
    creatorUrl: 'https://www.k4studios.com/',
  },
});

const breadcrumbData = getBreadcrumbList([
  { name: 'Home', item: 'https://www.k4studios.com/' },
  { name: 'American Western Art', item: `https://www.k4studios.com${pagePath}` },
]);

const stripHtml = (text: string) => text.replace(/<[^>]*>/g, '').trim();

const faqStructuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `https://www.k4studios.com${pagePath}#faq`,
  mainEntity: americanWesternArtFAQ.map((item: any) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(Array.isArray(item.a) ? item.a.join(' ') : item.a),
    },
  })),
}, null, 2);

const webPageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `https://www.k4studios.com${pagePath}#webpage`,
  url: `https://www.k4studios.com${pagePath}`,
  name: 'American Western Art',
  description: landingDescription,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://www.k4studios.com/#website',
    name: 'K4 Studios',
    url: 'https://www.k4studios.com/',
  },
  about: [
    { '@type': 'Thing', name: 'American Western Art' },
    { '@type': 'Thing', name: 'Cowboy Portraits' },
    { '@type': 'Thing', name: 'Indigenous Portraits' },
    { '@type': 'Thing', name: 'Frontier Narratives' },
    { '@type': 'Thing', name: 'Western Art Prints' },
  ],
  author: { '@id': 'https://www.k4studios.com/#person' },
  creator: { '@id': 'https://www.k4studios.com/#person' },
  copyrightHolder: { '@id': 'https://www.k4studios.com/#person' },
  mainEntity: { '@id': `https://www.k4studios.com${pagePath}#imagegallery` },
}, null, 2);

const landingImg = featheredImages[0];
const landingImgUrl = landingImg?.id ? makeAbsoluteUrl(getProxySrc(landingImg.id, 'l')) : '';

const meta = getLandingMeta(pagePath, landingImgUrl);
if (!meta.ogUrl) meta.ogUrl = `https://www.k4studios.com${pagePath}`;
if (!meta.twitterUrl) meta.twitterUrl = `https://www.k4studios.com${pagePath}`;

function getTombstoneThumbs(galleryData: any[]): string[] {
  const validImages = (galleryData || [])
    .filter((img: any) => img.id !== 'i-k4studios' && img.visibility !== 'ghost' && img.visibility !== 'hidden')
    .slice(0, 10);

  return validImages
    .map((img: any) => img.id ? getProxySrc(img.id, 's') : '')
    .filter((src: string) => src !== '');
}

const tombstoneGalleryMap: Record<string, any[]> = {
  [cowboyColorPath]: cowboyColorDataFull,
  [narrativeColorPath]: westernNarrativesColorData,
  [naColorPath]: cowboyNAData,
};

const tombstonesWithThumbs = landingAmericanWesternArt.tombstones.map((stone: any) => {
  if (stone.thumb) return { ...stone, thumbs: [stone.thumb] };

  const thumbSourcePaths = Array.isArray(stone._thumbSources)
    ? stone._thumbSources
    : [stone._thumbSource || stone.href];

  const thumbs = thumbSourcePaths.flatMap((path: string) => {
    const galleryData = tombstoneGalleryMap[path];
    return galleryData ? getTombstoneThumbs(galleryData) : [];
  });

  return {
    ...stone,
    thumb: thumbs[0] || '',
    thumbs,
  };
});

type GridItem = {
  id: string;
  title: string;
  alt: string;
  href: string;
  src?: string;
  srcM?: string;
  seriesLabel?: string;
};

function dedupeGridItems(items: GridItem[]) {
  const seen = new Set<string>();
  return items.filter((item) => {
    if (!item?.id || seen.has(item.id)) return false;
    seen.add(item.id);
    return true;
  });
}

function selectGridItems(
  data: any[],
  hrefBase: string,
  count: number,
  seriesLabel: string,
  excludedIds: Set<string>,
): GridItem[] {
  return topRated(data, count, excludedIds).map((img: any) => ({
    id: img.id,
    title: img.title || 'Featured Work',
    alt: ensureAlt(img),
    href: `${hrefBase}/${img.id}`,
    src: img.src,
    srcM: img.srcM,
    seriesLabel,
  }));
}

const curatedGridImages = dedupeGridItems([
  ...selectGridItems(cowboyColorDataFull, cowboyColorPath, 10, 'Cowboy Portraits', carouselIds),
  ...selectGridItems(westernNarrativesColorData, narrativeColorPath, 10, 'Frontier Narratives', carouselIds),
  ...selectGridItems(cowboyNAData, naColorPath, 6, 'Indigenous Portraits', carouselIds),
]).slice(0, 25);

const quickExploreLinks = [
  { label: 'Cowboy Portraits', href: cowboyColorPath },
  { label: 'Indigenous Portraits', href: naColorPath },
  { label: 'Frontier Narratives', href: narrativeColorPath },
  { label: 'Wild West Collection', href: wildWestCollectionPath },
  { label: 'Print Options', href: '/Other/Print-Options' },
  { label: 'Art of the American West', href: '/Art-of-the-American-West' },
];

const collectingLevels = [
  {
    eyebrow: 'Entry Point',
    title: 'Sketch Series Prints',
    body: 'Smaller open-edition studies that give collectors an accessible way into the work. Built for first purchases, early collecting, and rooms that need frontier character without forcing a massive scale.',
  },
  {
    eyebrow: 'Core Collection',
    title: 'Open & Archive Editions',
    body: 'Full-scale archival prints on museum-grade paper and premium canvas. These are the collector-facing gallery prints designed for long-term display, repeat viewing, and a stronger sense of narrative presence on the wall.',
  },
  {
    eyebrow: 'Signature Works',
    title: 'Limited & Signed Editions',
    body: 'Select American Western art pieces released as numbered, signed works, including presentations on <a href="/Other/K4-Select-Series/Engrained">Engrained™</a> hardwood panels. For edition details, see <a href="/Other/Series">Series Info</a> and <a href="/Other/Print-Options">Print Options</a>.',
  },
];
---

<BaseLayout
  title="American Western Art – Collector Prints & Frontier Narratives by Wayne Heim"
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbData}
  meta={meta}
>
  <script type="application/ld+json" set:html={faqStructuredData} slot="head"></script>
  <script type="application/ld+json" set:html={webPageSchema} slot="head"></script>

  <main class="american-western-art-page bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingAmericanWesternArt.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingAmericanWesternArt.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4">
      <div class="hero-carousel-section reveal-on-scroll">
        <HybridBookCarousel
          client:load
          slides={carouselSlides as unknown as never[]}
          kicker="American Western Art"
          counterLabel="Work"
        />
      </div>
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">{landingAmericanWesternArt.title}</h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">{landingAmericanWesternArt.subtitle}</h2>
      </div>
    </section>

    <section class="term-section">
      <div class="term-shell reveal-on-scroll">
        <article class="term-block term-block--lead">
          {introLeadParagraphs.map((paragraph: string) => (
            <p class="term-block__body">{paragraph}</p>
          ))}
        </article>

        <aside class="term-support" aria-label="How to explore this page">
          <p class="term-support__body">{introSupportText}</p>
        </aside>
      </div>
    </section>

    <section class="collections-nav-section">
      <div class="collections-nav-shell reveal-on-scroll">
        <p class="collections-kicker">Browse by Collection</p>
        <h2 class="collections-title">Start with the branch that fits the work you want to collect</h2>
        <p class="collections-intro">Move directly into cowboy portraiture, Indigenous portrait work, frontier narratives, or the broader Wild West collection.</p>
        <TombstoneNav client:load items={tombstonesWithThumbs} />
      </div>
    </section>

    <section class="collection-section">
      <div class="collection-shell">
        <div class="collection-heading reveal-on-scroll">
          <p class="collection-kicker">Selected Works</p>
          <h2 class="collection-title">Browse American Western Art</h2>
          <p class="collection-intro">A curated selection of American Western art ready to browse.</p>
          <div class="quick-explore-links">
            {quickExploreLinks.map((link) => (
              <a href={link.href} class="quick-explore-links__item">{link.label}</a>
            ))}
          </div>
        </div>

        <div class="wallart-grid reveal-on-scroll">
          {curatedGridImages.map((item: GridItem) => (
            <a href={item.href} class="wallart-grid__tile" title={item.title}>
              <div class="wallart-grid__img-wrap">
                <img
                  src={getProxySrc(item.id, 'm')}
                  data-fallback-src={getProxySrc(item.id, 'l')}
                  alt={item.alt || `American Western art by Wayne Heim: ${item.title}`}
                  loading="lazy"
                  onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) { this.src = this.dataset.fallbackSrc; }"
                  width="400"
                  height="400"
                  class="wallart-grid__img"
                />
                <span class="wallart-grid__hover">View Image</span>
              </div>
              <p class="wallart-grid__title">{item.title}</p>
              {item.seriesLabel && <p class="wallart-grid__series">{item.seriesLabel}</p>}
            </a>
          ))}
        </div>

        <div class="collection-footer reveal-on-scroll">
          <p class="collection-storyline">Each image is a <a href="/Other/One-Image-Movie">one-image movie</a> - click to step inside the story.</p>
          <a href={frontierCollectionPath} class="collection-index-link">View the full frontier collection</a>
        </div>
      </div>
    </section>

    <section class="collecting-section">
      <div class="collecting-shell reveal-on-scroll">
        <div class="collecting-heading">
          <h2 class="collecting-title">Collecting the Work</h2>
          <p class="collecting-intro">This page is built for collectors who want frontier subject matter carried through museum-quality materials, edition structure, and authored image-making rather than generic Western wall art.</p>
        </div>

        <div class="collecting-grid">
          {collectingLevels.map((level) => (
            <article class="collecting-card">
              <p class="collecting-card__eyebrow">{level.eyebrow}</p>
              <h3 class="collecting-card__title">{level.title}</h3>
              <p class="collecting-card__body" set:html={level.body} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="faq-section pb-10">
      <div class="faq-shell reveal-on-scroll">
        <p class="faq-kicker">Collector Questions</p>
        <h2 class="faq-title">American Western Art FAQ</h2>

        <div class="faq-columns">
          <div class="faq-column faq-column--left">
            <div class="faq-question-list" role="list">
              {faqLeft.map((item: any, index: number) => (
                <button
                  type="button"
                  class="faq-question"
                  data-faq-trigger
                  data-faq-side="left"
                  data-faq-target={`faq-left-${index}`}
                  aria-expanded="false"
                >
                  <span class="faq-question__text">{item.q}</span>
                  <span class="faq-question__icon" aria-hidden="true">+</span>
                </button>
              ))}
            </div>

            <div class="faq-answer-stack">
              {faqLeft.map((item: any, index: number) => (
                <div id={`faq-left-${index}`} class="faq-answer" data-faq-panel data-faq-side="left" hidden>
                  {item.a.map((paragraph: string) => (
                    <p set:html={paragraph} />
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="faq-column faq-column--right">
            <div class="faq-question-list" role="list">
              {faqRight.map((item: any, index: number) => (
                <button
                  type="button"
                  class="faq-question"
                  data-faq-trigger
                  data-faq-side="right"
                  data-faq-target={`faq-right-${index}`}
                  aria-expanded="false"
                >
                  <span class="faq-question__text">{item.q}</span>
                  <span class="faq-question__icon" aria-hidden="true">+</span>
                </button>
              ))}
            </div>

            <div class="faq-answer-stack">
              {faqRight.map((item: any, index: number) => (
                <div id={`faq-right-${index}`} class="faq-answer" data-faq-panel data-faq-side="right" hidden>
                  {item.a.map((paragraph: string) => (
                    <p set:html={paragraph} />
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="faq-overlay faq-overlay--left" data-faq-overlay="left" hidden></div>
          <div class="faq-overlay faq-overlay--right" data-faq-overlay="right" hidden></div>
        </div>

        <div class="faq-header-logo">
          <a href="/" class="faq-header-logo__link" aria-label="Home">
            <img src="/images/K4Logo-web.webp" alt="K4 Studios home" loading="lazy" decoding="async" />
          </a>
        </div>
        <p class="faq-tagline">"Frontier lives, collector prints, and authored Western imagery — browsed as work, not wallpaper."</p>
      </div>
    </section>

    <WesternGuideNav currentPath={pagePath} />

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const els = document.querySelectorAll('.reveal-on-scroll, .fade-in');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach((el) => observer.observe(el));
      }

      const faqTriggers = Array.from(document.querySelectorAll('[data-faq-trigger]'));
      const faqPanels = Array.from(document.querySelectorAll('[data-faq-panel]'));
      const faqOverlays = Array.from(document.querySelectorAll('[data-faq-overlay]'));
      const isMobileFaq = () => window.matchMedia('(max-width: 768px)').matches;

      const closeAllFaqPanels = () => {
        faqTriggers.forEach((trigger) => {
          trigger.setAttribute('aria-expanded', 'false');
          const icon = trigger.querySelector('.faq-question__icon');
          if (icon) icon.textContent = '+';
        });

        faqPanels.forEach((panel) => {
          panel.hidden = true;
          panel.classList.remove('is-open');
        });

        faqOverlays.forEach((overlay) => {
          overlay.hidden = true;
          overlay.classList.remove('is-open');
          overlay.innerHTML = '';
        });

        document.querySelectorAll('.faq-mobile-answer').forEach((node) => node.remove());
      };

      faqTriggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const targetId = trigger.getAttribute('data-faq-target');
          const targetPanel = targetId ? document.getElementById(targetId) : null;
          const triggerSide = trigger.getAttribute('data-faq-side');
          const overlaySide = triggerSide === 'left' ? 'right' : 'left';
          const overlay = document.querySelector(`[data-faq-overlay="${overlaySide}"]`);
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          const mobileMode = isMobileFaq();

          closeAllFaqPanels();

          if (!targetPanel || isOpen) return;

          trigger.setAttribute('aria-expanded', 'true');
          const icon = trigger.querySelector('.faq-question__icon');
          if (icon) icon.textContent = '−';

          const questionText = trigger.querySelector('.faq-question__text')?.textContent || '';

          if (mobileMode) {
            const inlineAnswer = document.createElement('div');
            inlineAnswer.className = 'faq-answer faq-mobile-answer is-open';
            inlineAnswer.innerHTML = `
              <p class="faq-overlay__eyebrow">Answer</p>
              <h3 class="faq-overlay__title">${questionText}</h3>
              <div class="faq-overlay__content">${targetPanel.innerHTML}</div>
            `;
            trigger.insertAdjacentElement('afterend', inlineAnswer);
            return;
          }

          if (!overlay) return;

          overlay.innerHTML = `
            <div class="faq-overlay__inner">
              <p class="faq-overlay__eyebrow">Answer</p>
              <h3 class="faq-overlay__title">${questionText}</h3>
              <div class="faq-overlay__content">${targetPanel.innerHTML}</div>
            </div>
          `;
          overlay.hidden = false;
          overlay.classList.add('is-open');
        });
      });
    });
  </script>

  <style>
    .american-western-art-page,
    .american-western-art-page * {
      font-family: 'Glegoo', serif !important;
    }

    .fade-in {
      opacity: 0;
      visibility: hidden;
      transform: translateY(1px);
      transition: opacity 1.75s ease, transform 1.75s ease, visibility 0.5s linear 1.75s;
    }

    .fade-in.is-visible {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }

    .page-title.fade-in {
      transition-delay: 0.2s;
    }

    .hero-carousel-section {
      max-width: 1200px;
      margin: 0 auto 2.1rem;
      padding: 0 1rem;
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 1.2s ease-out, transform 1.2s ease-out;
      visibility: hidden;
    }

    .hero-carousel-section.is-visible {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }

    .section-heading-wrap {
