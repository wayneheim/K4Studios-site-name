---
export const prerender = true;

import CommercialDoorwayAllPage from "@/components/doorway/CommercialDoorwayAllPage.astro";
import { galleryData as cowboyColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as cowboyBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs";
import { galleryData as narrativeColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs";
import { galleryData as narrativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/ColorEntranceData.ts";
import { buildCowboyArtPrintsDock } from "@/data/Cowboy-Art-Prints/buildCowboyArtPrintsDock.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const pagePath = "/cowboy-art-prints";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color";
const canonicalPath = pagePath;
const beyondFrameVideoWidget = {
  videoSlug: "only-path-forward",
  kicker: "Frontier stories come alive.",
  label: "60 seconds: Beyond the frame.",
  compact: true,
  withRules: true,
  ctaWidth: "17rem",
  ruleWidth: "100%",
};

const rotateGallery = (items: any[] = [], offset = 0) => {
  const cleanItems = items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  );
  if (cleanItems.length === 0) return cleanItems;
  const start = offset % cleanItems.length;
  return [...cleanItems.slice(start), ...cleanItems.slice(0, start)];
};

const cowboyColorItems = rotateGallery(cowboyColorData, 41);
const cowboyBlackWhiteItems = rotateGallery(cowboyBlackWhiteData, 32);
const narrativeColorItems = rotateGallery(narrativeColorData, 82);
const narrativeBlackWhiteItems = rotateGallery(narrativeBlackWhiteData, 44);
const breadcrumbHtml = [
  '<a href="/">Wayne Heim</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits">Western Portraits</a>',
  "Cowboy Art Prints",
].join(" | ");

const breadcrumbStructuredItems = [
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits", name: "Western Portraits" },
];

const { sectionDockItems, dockCenterIndex } = buildCowboyArtPrintsDock();

const faqItems = [
  {
    q: "What are cowboy art prints?",
    a: [
      "Cowboy art prints are fine art reproductions of Western-themed imagery - portraits, frontier scenes, and narrative character studies - produced as archival paper and select wood presentations.",
      "At K4 Studios, they begin as photography shaped through a painterly process into works with the mood and presence of classic Western painting rather than straight documentary photography.",
    ],
  },
  {
    q: "Are cowboy art prints mainly decorative?",
    a: [
      "Depends on the work. Mass-market cowboy prints are decorative - they fill a wall. Wayne Heim's prints are authored: each image carries a title, a story, and a named moment.",
      "Collector editions come with signed certificates. The work is built to be lived with, not just displayed.",
    ],
  },
  {
    q: "What should I look for first in a cowboy print?",
    a: [
      "Start with the figure. Does the character hold the frame under pressure, or are they just wearing a hat? Wayne Heim's work treats the cowboy as someone mid-story - weathered, deliberate, carrying consequence.",
      "That's the difference between a print that holds a wall and one that fades into it.",
    ],
  },
  {
    q: "What makes a cowboy print collector-grade?",
    a: [
      "Authorship, editioning, and material quality. Collector-grade prints carry a named artist, archival materials rated for 100+ years, and limited edition numbering with certificates.",
      "Wayne Heim's Chronicle and Legend Series meet all three - signed, numbered, and produced on museum-quality substrates.",
    ],
  },
  {
    q: "What sizes are available for cowboy art prints?",
    a: [
      "Prints range from 5×7 Sketch Series works - sized for shelves, desks, and introductory collecting - through large-format statement pieces for anchor walls.",
      "Size options vary by image and are listed inside each image page alongside substrate and finish choices.",
    ],
  },
  {
    q: "What print materials are available?",
    a: [
      "Every image is available as an archival paper or select wood presentation.",
      "Wood options include the Engrained Series on Baltic Birch panels, which adds grain texture and warmth to the image surface. Material choice affects how the work holds light and how it reads in a room - details are inside each image page.",
    ],
  },
  {
    q: "How does cowboy art photography differ from cowboy painting?",
    a: [
      "Cowboy painting builds from imagination or reference. Wayne Heim's cowboy art photography begins with real people, real light, and real moments - then is shaped through a painterly process into fine art with painted atmosphere and tonal depth.",
      "The result carries the authenticity of photography and the presence of painting.",
    ],
  },
  {
    q: "Can cowboy art prints work in modern interiors?",
    a: [
      "Yes - and often better than expected. The key is restraint: one strong portrait in a clean space carries more weight than a themed arrangement.",
      "Wayne Heim's tonal work and monochrome series integrate well in modern, transitional, and minimalist rooms without reading as decorative Western theme.",
    ],
  },
  {
    q: "What determines the value of a cowboy art print over time?",
    a: [
      "Authorship, edition size, and material quality. Open-edition prints hold display value. Signed limited editions - particularly from small Chronicle or ultra-limited Legend runs - carry documented provenance that supports long-term collector value.",
      "Certificate of authenticity and edition number are included with all limited works.",
    ],
  },
  {
    q: "Where should I start if I am choosing one?",
    a: [
      "Start with the portrait sections - color if you want warmth and painterly light, black and white if you want tonal contrast and old West atmosphere.",
      "Click into any image to read the story before deciding. If you want help choosing for a specific room or wall, reach Wayne directly at <a href='mailto:wayne@k4studios.com'>wayne@k4studios.com</a>.",
    ],
  },
];

const gridSections = [
  {
    title: "Color Cowboy Portrait Art Prints",
    description: "Color portrait prints where painterly light, posture, and frontier character give the figure enough presence to carry a room.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/all#collection-browser",
    ctaLabel: "See the full color cowboy portrait print collection",
    ctaThumb: "/img/i-5FX3W9r/s.jpg",
    items: cowboyColorItems,
    limit: 19,
  },
  {
    title: "Black and White Cowboy Portrait Prints",
    description: "Monochrome cowboy portrait prints built around tonal contrast, weathered faces, hat-brim shadow, and old-West restraint.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white cowboy portrait print collection",
    ctaThumb: "/images/tombstones/cowboy-bw-ts.webp",
    items: cowboyBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Color Western Narrative Art Prints",
    description: "Color frontier scenes and story-led Western artwork where the print is chosen for atmosphere, movement, and the unfinished moment.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/all#collection-browser",
    ctaLabel: "See the full color Western narrative print collection",
    ctaThumb: "/img/i-B7ZSdfs/s.jpg",
    items: narrativeColorItems,
    limit: 19,
  },
  {
    title: "Black and White Frontier Narrative Prints",
    description: "Monochrome narrative prints where contrast, silence, and withheld story give the image its staying power.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white Western narrative print collection",
    ctaThumb: "/img/i-kp5NHNw/s.jpg",
    items: narrativeBlackWhiteItems,
    limit: 19,
  },
];

const countLiveItems = (sections: typeof gridSections) =>
  sections.reduce((total, section) => total + section.items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  ).length, 0);
const cowboyArtPrintsLiveCount = countLiveItems(gridSections);

const commercialMiddleCopy = [
  "This print catalog is organized by the way the work lives on a wall. Portrait sections lead with character and human gravity. Narrative sections carry more implied action, weather, silence, and story.",
  "For a single anchor piece, begin with the portrait work: one face, one figure, one point of pressure. For hallways, offices, lodge walls, ranch homes, and hospitality spaces where the wall needs sequence rather than a single statement, the narrative sections give the collection more movement.",
  `Across the page, ${cowboyArtPrintsLiveCount} works are available as fine art prints. Size, substrate, edition status, image story, and collector notes are inside each image page.`,
].join("\n\n");

const copy = {
  seoTitle: "Cowboy Art Prints - Western Cowboy Artwork Prints by Wayne Heim",
  seoDescription:
    "Cowboy art prints by Wayne Heim. Western cowboy portraits, frontier narrative artwork, black and white prints, archival paper editions, and signed limited editions from $25.",
  indexDefinition:
    "Wayne Heim's cowboy art prints include color cowboy portraits, black and white cowboy prints, narrative frontier scenes, and painterly Western character studies produced as collector-grade fine art prints.",
  indexLinkNote:
    "Explore cowboy art prints, western cowboy art prints, cowboy artwork prints, and collector-ready cowboy photography prints shaped for wall presence and long viewing.",
  printAvailabilityNote: `Cowboy art prints are available from ${getFormattedLowestStandardPrintPrice()} across archival paper and select wood presentations. Edition status and format options are shown on individual image pages.`,
  commercialH1: "Browse Cowboy Art Prints",
  commercialDeck:
    `${cowboyArtPrintsLiveCount} cowboy portrait prints, frontier scenes, black and white Western artwork, and color narrative pieces organized for print buyers, collectors, and room-scale decisions.`,
  catalogEntranceTitle: "Cowboy Art Prints, Western Cowboy Prints, and Frontier Artwork",
  catalogEntranceCopy:
    "Browse cowboy art prints, western cowboy art prints, black and white cowboy prints, and narrative frontier scenes created as collector-grade fine art.",
  collectionIntro: commercialMiddleCopy,
  trustBarCopy:
    "Archival fine art prints are produced to order by K4 Studios. Chronicle and Legend limited editions are individually hand signed and numbered, with certificate of authenticity included.",
  catalogSectionKicker: "Cowboy print section - {sectionCount} works",
  breadcrumbCurrentName: "Cowboy Art Prints",
  aggregateOfferLowPrice: "25",
  aggregateOfferHighPrice: "5000",
  aggregateOfferCount: String(cowboyArtPrintsLiveCount),
  gatewayKicker: "K4 STUDIOS - WESTERN FINE ART PRINT CATALOG",
  gatewayCollectionName: "Cowboy Art Prints",
  gatewayIntroCopy:
    "A cowboy print has to survive the room after the hat, horse, and Western theme have done their first work.",
  gatewaySupportingCopy:
    "Plenty of cowboy art prints decorate a wall for a season. The stronger ones keep asking for a second look because the figure has weight, the light has purpose, and the story feels unfinished. Wayne Heim's print work is built around that difference: not cowboy imagery as filler, but Western character and frontier atmosphere made physical as art.\n\nThese works begin with real people, real light, and real Western subjects, then move through Heim's painterly finishing process until the image carries the presence of Western painting without losing the specificity of the original moment. Portraits hold through expression and posture. Narrative scenes hold through tension, distance, and what the frame refuses to explain.\n\nThe collection is available as archival fine art prints, from the open-edition Sketch Series starting at $25 through signed Chronicle and Legend limited editions. Select works may also be offered as natural Baltic Birch Engrained panels when the wood surface strengthens the historical character of the piece.",
  gatewayBrandLabel: "Cowboy Art Prints - Western Cowboy Artwork Prints by Wayne Heim",
  gatewayHeroTitle: "Cowboy Art Prints by Wayne Heim",
  gatewayHeroAlt:
    "Painterly cowboy portrait used as the hero image for the Cowboy Art Prints page.",
  archiveContextCopy:
    "Cowboy prints work best when the image is chosen for the wall, not only for the subject. Warm wood, leather, stone, iron, linen, and neutral contemporary rooms can all carry Western artwork when the piece has tonal discipline and enough visual weight. For a narrow wall or shelf grouping, begin with smaller Sketch Series works. For a living room, office, lodge entry, or ranch interior, move into Foundation, Chronicle, or Legend sizes that can anchor the space independently.\n\nEvery work on this page is available as a fine art print - with the Sketch Series opening at $25. Click into any image to read the story, compare print options, sizes, and collector details. Questions about a specific piece? Reach Wayne directly at <a href='mailto:wayne@k4studios.com'>wayne@k4studios.com</a>.",
  conceptBlock1Title: "PORTRAIT AS PRESENCE",
  conceptBlock1Copy:
    "Color cowboy portrait prints are the warmest entry point into the collection. They carry skin tone, worn fabric, dust, sun, and the small color notes that make a Western figure feel physically present.\n\nUse this section when the wall needs a human subject with direct gravity: a study, office, lodge room, ranch house hallway, or hospitality space where the art should feel lived-in rather than decorative.",
  conceptBlock2Title: "WHEN COLOR STEPS BACK",
  conceptBlock2Copy:
    "Black and white cowboy prints shift the buying decision from palette to structure. The face, hat brim, coat edge, hand, and posture have to do the work without warm color carrying the mood.\n\nThis section is strongest for rooms with stone, dark wood, leather, black metal, or clean contemporary neutrals where tonal contrast reads clearly from across the room.",
  conceptBlock3Title: "THE STORY WALL",
  conceptBlock3Copy:
    "Narrative Western prints are chosen differently than portraits. The figure may not look directly at the viewer. The scene may withhold the event. The value is in the implied story: what happened before the frame, what might happen next, and why the moment feels charged.\n\nColor narrative work gives designers and collectors a broader room language: movement, atmosphere, historic styling, and enough warmth to connect with wood, textile, and leather surfaces.",
  conceptBlock4Title: "RESTRAINT AND FRONTIER MOOD",
  conceptBlock4Copy:
    "Black and white narrative prints are the quietest section of the page. They work through shadow, distance, silhouette, weather, and the pressure of an unresolved scene.\n\nChoose this group when the wall needs old-West atmosphere without color competition. These pieces pair especially well with restrained interiors, gallery walls, office spaces, and rooms where the art should carry mood rather than theme.",
  faqKicker: "Print & Collector Questions",
  faqTitle: "Cowboy Art Prints FAQ",
};
---

<CommercialDoorwayAllPage
  rawGalleryData={cowboyColorItems}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Explore Cowboy Art Print Collections"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits",
    categoryName: "Western Cowboy Portraits",
  }}
  identity={{
    collectionName: "Cowboy Art Prints",
    variantName: "Western Cowboy Prints",
    variantDescriptor: "cowboy art prints",
    gatewayBrandLabel: "Cowboy Art Prints — Western Cowboy Photography Prints by Wayne Heim",
  }}
  copy={copy}
  faqItems={faqItems}
  gridSections={gridSections}
  gatewayVideoWidget={beyondFrameVideoWidget}
  dockVariant="wall-art"
  layoutVariant="cinematic-concept-series-top"
/>
