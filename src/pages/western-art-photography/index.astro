---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import LandingHeader from '@/components/Landing-Header.jsx';
import SiteFooter from '@/components/Footer.astro';
import { getBreadcrumbList } from '@/components/utils/getStructuredData.ts';

const pagePath = '/western-art-photography';
const targetPath = '/Western-Photography-Art';
const canonicalUrl = `https://www.k4studios.com${pagePath}`;
const targetUrl = `https://www.k4studios.com${targetPath}`;

const breadcrumb =
  `<a href="/" title="Home" style="color: inherit; text-decoration: none; cursor: pointer; pointer-events: auto; position: relative; z-index: 9999; transition: color 0.2s ease;" onmouseover="this.style.color='darkred'" onmouseout="this.style.color='inherit'">Wayne Heim</a> | Western Art Photography`;

const meta = {
  title: 'Western Art Photography | Western Photography Art at K4 Studios',
  description:
    'Western art photography is a bridge term for Western photography art: authored photographs of the American West shaped by painterly craft, frontier atmosphere, and narrative intent rather than simple documentation.',
  canonicalUrl,
  ogUrl: canonicalUrl,
  twitterUrl: canonicalUrl,
};

const breadcrumbsJSON = getBreadcrumbList([
  { name: 'Home', item: 'https://www.k4studios.com/' },
  { name: 'Western Art Photography', item: `https://www.k4studios.com${pagePath}` },
]);

const structuredDataJSON = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `https://www.k4studios.com${pagePath}#webpage`,
  url: `https://www.k4studios.com${pagePath}`,
  name: 'Western Art Photography',
  description: meta.description,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://www.k4studios.com/#website',
    name: 'K4 Studios',
    url: 'https://www.k4studios.com/',
  },
  about: [
    { '@type': 'Thing', name: 'Western Art Photography' },
    { '@type': 'Thing', name: 'Western Photography Art' },
    { '@type': 'Thing', name: 'American West Photography' },
    { '@type': 'Thing', name: 'Narrative Western Art' },
    { '@type': 'Thing', name: 'Painterly Photography' },
    { '@type': 'Thing', name: 'American Frontier' },
  ],
  mainEntity: {
    '@type': 'DefinedTerm',
    name: 'Western Art Photography',
    description: 'A bridge term for Western photography art: authored photographic works that interpret the American West through painterly craft, historical awareness, and narrative intent.',
    sameAs: canonicalUrl,
    relatedLink: targetUrl,
  },
}, null, 2);
---

<BaseLayout
  title="Western Art Photography | Western Photography Art at K4 Studios"
  meta={meta}
  breadcrumbsJSON={breadcrumbsJSON}
  structuredDataJSON={structuredDataJSON}
>
  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={breadcrumb} />
    </div>

    <section class="bridge-wrap">
      <div class="bridge-card">
        <p class="bridge-kicker">Canonical definition bridge</p>
        <h1>Western Art Photography</h1>

        <p>
          Western art photography refers to photographic works that interpret the people,
          landscapes, and history of the American West through artistic intent rather than
          simple documentation.
        </p>

        <p>
          In practice, the terms Western art photography and Western photography art describe
          the same tradition: authored photographic works that translate frontier life into
          narrative-driven fine art.
        </p>

        <p>
          At K4 Studios, this approach takes the form of painterly photography—images crafted
          to carry the emotional weight and storytelling tradition of Western painting while
          remaining rooted in real light and real moments.
        </p>

        <p>
          Within the site taxonomy, that meaning is carried most directly by <a href="/Western-Photography-Art">Western Photography Art</a>, with the story-driven branch becoming explicit in <a href="/Narrative-Western-Art">Narrative Western Art</a> and the frontier doorway opening into <a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History?focus=frontier">Facing History</a>.
        </p>

        <a class="bridge-cta" href={targetPath}>→ Western Photography Art</a>

        <p class="bridge-supporting-links">
          Related: <a href="/Western-Fine-Art-Photography">Western Fine Art Photography</a>
          <span aria-hidden="true"> · </span>
          <a href="/Narrative-Western-Art">Narrative Western Art</a>
          <span aria-hidden="true"> · </span>
          <a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History?focus=frontier">Facing History</a>
        </p>
      </div>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <style>
    .bridge-wrap {
      max-width: 920px;
      margin: 0 auto;
      padding: 2.25rem 1rem 3rem;
    }

    .bridge-card {
      max-width: 760px;
      margin: 0 auto;
      background: #fbfaf7;
      border: 1px solid #e6ddd3;
      border-radius: 12px;
      box-shadow: 0 4px 18px rgba(0,0,0,0.05);
      padding: 2.5rem 2rem;
      text-align: center;
      font-family: 'Glegoo', serif;
    }

    .bridge-kicker {
      margin: 0 0 0.6rem;
      font-size: 0.72rem;
      line-height: 1.2;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #9b8772;
      font-weight: 600;
    }

    .bridge-card h1 {
      margin: 0 0 1rem;
      font-size: 2rem;
      line-height: 1.15;
      color: #3f3025;
    }

    .bridge-card p {
      margin: 0 0 1rem;
      font-size: 1.03rem;
      line-height: 1.65;
      color: #5a4a3b;
    }

    .bridge-cta {
      display: inline-block;
      margin-top: 0.8rem;
      font-size: 1rem;
      font-weight: 600;
      color: #8b5a2b;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    .bridge-cta:hover {
      color: #6d3f1a;
      border-color: #8b5a2b;
    }

    .bridge-supporting-links {
      margin-top: 1rem;
      font-size: 0.95rem;
      line-height: 1.6;
      color: #6a5848;
    }

    .bridge-supporting-links a {
      color: #7b4d24;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .bridge-supporting-links a:hover {
      color: #5f3414;
      border-color: #7b4d24;
    }

    @media (max-width: 768px) {
      .bridge-wrap {
        padding-top: 1.35rem;
      }

      .bridge-card {
        padding: 1.8rem 1.15rem;
      }

      .bridge-card h1 {
        font-size: 1.6rem;
      }

      .bridge-card p {
        font-size: 0.98rem;
      }
    }
  </style>
</BaseLayout>
