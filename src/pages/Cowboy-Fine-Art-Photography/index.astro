---
export const prerender = true;
import BaseLayout         from '@/layouts/BaseLayout.astro';
import LandingHeader      from '@/components/Landing-Header.jsx';
import ImageBar2          from '@/components/ImageBar2.jsx';
import TombstoneNav       from '@/components/TombstoneNav.jsx';
import LandingRightImages from '@/components/LandingRightImages.jsx';
import FAQAccordion       from '@/components/FAQAccordion.jsx';
import SiteFooter         from '@/components/Footer.astro';
import MobileStoryImages  from '@/components/MobileStoryImages.jsx';
import StorySlider        from '@/components/StorySlider.tsx';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';

// Cowboy gallery data
import { galleryData as cowboyColorDataFull }
  from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs';
import { galleryData as cowboyBWData }
  from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs';
import { galleryData as cowboyNAData }
  from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color.mjs';
import { galleryData as westernNarrativesColorData }
  from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs';
import { galleryData as westernNarrativesBWData }
  from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs';
import { storySliderImageIds } from '@/data/storySlider.ts';

import { getStructuredData, getBreadcrumbList } from '@/components/utils/getStructuredData.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';

import { siteNav } from '@/data/siteNav.ts';
import { getOrderedWesternGalleryPaths } from '@/data/carousel/westernRouting.ts';
import { getFeatheredImages } from '@/components/utils/getFeatheredImages.ts';
import { autoLinkKeywordsInText } from '@/components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '@/data/semantic/K4-Sem.ts';

// ✅ HUB-SCOPED DATA SOURCES (Cowboy Authority Hub)
import { landingCowboy }
  from '@/data/Cowboy-Fine-Art-Photography/landingstones.ts';
import { cowboyStory }
  from '@/data/Cowboy-Fine-Art-Photography/story.ts';
import { cowboyFAQ }
  from '@/data/Cowboy-Fine-Art-Photography/faq.ts';

import '@/styles/global.css';
import '@/styles/oneupheader.css';

// ----------------------
// PATHS
// ----------------------

// ✅ The actual page URL — Cowboy Authority Hub
const pagePath = "/Cowboy-Fine-Art-Photography";

// ✅ A REAL siteNav node to power feathering + gallery pool + autolinking
const imageSectionPath =
  "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits";

// ----------------------
// STORY SLIDER DATA
// ----------------------
const cowboyColorData = cowboyColorDataFull
  .filter((img: any) => storySliderImageIds.includes(img.id))
  .map((img: any) => ({ id: img.id, title: img.title, story: img.story }));

// ----------------------
// NAV HELPERS
// ----------------------
function findNavEntry(nav: any[], url: string): any | null {
  for (const entry of nav) {
    if (entry.href === url) return entry;
    if (entry.children) {
      const found = findNavEntry(entry.children, url);
      if (found) return found;
    }
  }
  return null;
}

// Cowboy page uses children-only; keep same behavior for a clean pool.
const galleryPaths: string[] = getOrderedWesternGalleryPaths(imageSectionPath);

// Load galleryData for those galleryPaths
const allGalleryData = import.meta.glob('../../data/Galleries/**/*.mjs', { eager: true }) as any;
const galleryDatas = galleryPaths.map((path) => {
  const filePath = "../../data/Galleries" + path.replace(/^\/Galleries/, "") + ".mjs";
  return allGalleryData[filePath]?.galleryData || [];
});

// Feathering uses headingCount to decide how many it needs
const headingCount = cowboyStory.filter((block: any, i: number) => i > 0 && block.subhead).length;

// ✅ Feathered images: cowboy-universe only
const featheredImages = getFeatheredImages({
  sectionPath: imageSectionPath,
  headingCount: Math.max(headingCount, 9),
  galleryDatas,
  galleryPaths,
  minRating: 3,
  fallbackMin: 1,
  poolMultiplier: 3
});
// Pass full pool to component for client-side rotation

// ----------------------
// STRUCTURED DATA (URL MUST BE THE HUB PAGE)
// ----------------------
const landingDescription =
  landingCowboy.subtitle || (landingCowboy as any)?.description || "";

const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingCowboy.title,
    description: landingDescription,
    url: `https://k4studios.com${pagePath}`,
    keywords: landingCowboy.keywords || [],
    copyrightNotice: "© Wayne Heim",
    about: [
      { "@type": "Thing", name: "Cowboy Fine Art Photography" },
      { "@type": "Thing", name: "American West Art" },
      { "@type": "Thing", name: "American Frontier" },
      { "@type": "Thing", name: "Cowboy Photography" },
      { "@type": "Thing", name: "Black and White Cowboy Photography" },
      { "@type": "Thing", name: "Narrative Western Art" },
      { "@type": "Thing", name: "Cowboy Portraits" },
      { "@type": "Thing", name: "Old West" },
    ],
    genre: "Cowboy Fine Art Photography",
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    acquireLicensePage: "https://k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

// ----------------------
// BREADCRUMB STRUCTURED DATA
// ----------------------
const breadcrumbData = getBreadcrumbList([
  { name: "Home", item: "https://k4studios.com/" },
  { name: "Cowboy Fine Art Photography", item: `https://k4studios.com${pagePath}` },
]);

// ----------------------
// FAQ STRUCTURED DATA (for rich snippets)
// ----------------------
const stripHtml = (text: string) => text.replace(/<[^>]*>/g, '').trim();

const faqStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `https://k4studios.com${pagePath}#faq`,
  mainEntity: cowboyFAQ.slice(0, 10).map((item: any) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: stripHtml(Array.isArray(item.a) ? item.a.join(" ") : item.a),
    },
  })),
}, null, 2);

// ----------------------
// WEBPAGE SCHEMA (subject authority - Cowboy as PRIMARY entity)
// ----------------------
const webPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `https://k4studios.com${pagePath}#webpage`,
  url: `https://k4studios.com${pagePath}`,
  name: "Cowboy Fine Art Photography",
  description: "Cowboy fine art photography by Wayne Heim featuring cowboy portraits, black and white cowboy photography, and authentic frontier character studies.",
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    "@id": "https://k4studios.com/#website",
    name: "K4 Studios",
    url: "https://k4studios.com/"
  },
  about: [
    { "@type": "Thing", name: "Cowboy Fine Art Photography" },
    { "@type": "Thing", name: "Cowboy Photography" },
    { "@type": "Thing", name: "Black and White Cowboy Photography" },
    { "@type": "Thing", name: "Cowboy Portraiture" },
    { "@type": "Thing", name: "Authentic Cowboy Art" },
    { "@type": "Thing", name: "Narrative Western Art" },
    { "@type": "Thing", name: "Cowboy Wall Art" },
  ],
  author: { "@id": "https://k4studios.com/#person" },
  creator: { "@id": "https://k4studios.com/#person" },
  copyrightHolder: { "@id": "https://k4studios.com/#person" },
  mainEntity: { "@id": `https://k4studios.com${pagePath}#imagegallery` },
}, null, 2);

// OG/Twitter image: first feathered image
function makeAbsoluteUrl(src?: string) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) return src;
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

// Proxy URL helper - ensures SmugMug URLs never appear in SSR HTML
function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return `/img/${imageId}/${size}.jpg`;
}

const landingImg = featheredImages[0];
const landingImgUrl = landingImg?.id ? makeAbsoluteUrl(getProxySrc(landingImg.id, 'l')) : '';

// ✅ Meta should be keyed to the HUB PAGE
const meta = getLandingMeta(pagePath, landingImgUrl);
if (!meta.ogUrl) meta.ogUrl = `https://k4studios.com${pagePath}`;
if (!meta.twitterUrl) meta.twitterUrl = `https://k4studios.com${pagePath}`;

// ----------------------
// DYNAMIC TOMBSTONE THUMBNAILS
// ----------------------
function getTombstoneThumbs(galleryData: any[]): string[] {
  const validImages = galleryData
    .filter((img: any) => img.id !== 'i-k4studios' && img.visibility !== 'ghost')
    .slice(0, 10);
  return validImages
    .map((img: any) => img.id ? getProxySrc(img.id, 's') : '')
    .filter((src: string) => src !== '');
}

const tombstoneGalleryMap: Record<string, any[]> = {
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color': cowboyColorDataFull,
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White': cowboyBWData,
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color': cowboyNAData,
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color': westernNarrativesColorData,
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White': westernNarrativesBWData,
};

const tombstonesWithThumbs = landingCowboy.tombstones.map((stone: any) => {
  if (stone.thumb) return { ...stone, thumbs: [stone.thumb] };
  // Use _thumbSource for gallery lookup (all hrefs now point to Facing History)
  const galleryData = tombstoneGalleryMap[stone._thumbSource || stone.href];
  const thumbs = galleryData ? getTombstoneThumbs(galleryData) : [];
  return {
    ...stone,
    thumb: thumbs[0] || '',
    thumbs,
  };
});
---

<BaseLayout
  title="Cowboy Fine Art Photography | Painterly Cowboy Pictures and Western Art Prints"
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbData}
  meta={meta}
>
  <!-- FAQ Structured Data for rich snippets -->
  <script type="application/ld+json" set:html={faqStructuredData} slot="head"></script>
  <!-- WebPage Schema (subject authority - Cowboy as PRIMARY) -->
  <script type="application/ld+json" set:html={webPageSchema} slot="head"></script>

  <!-- Article Structured Data for topical authority -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Cowboy Fine Art Photography: Character-Driven Cowboy Portraits as Authored Fine Art",
    "author": {
      "@type": "Person",
      "name": "Wayne Heim"
    },
    "publisher": {
      "@type": "Organization",
      "name": "K4 Studios",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.k4studios.com/images/k4-logo.png"
      }
    },
    "description": "A comprehensive guide to cowboy fine art photography — what it is, where cowboy art meets photography, the painterly process, and how character-driven cowboy portraits interpret the American West as authored fine art.",
    "mainEntityOfPage": "https://www.k4studios.com/Cowboy-Fine-Art-Photography"
  }
  </script>
  
  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingCowboy.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingCowboy.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4">
      <div class="carousel-fade reveal-on-scroll">
        <ImageBar2 client:load />
      </div>
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">{landingCowboy.title}</h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">{landingCowboy.subtitle}</h2>
        <p class="page-summary fade-in reveal-on-scroll">
          Cowboy fine art photography is authored portraiture that treats the cowboy as a subject worthy of the same interpretive craft traditionally reserved for painted figures.
        </p>
        <h2 class="page-support-heading fade-in reveal-on-scroll">Cowboy Pictures Beyond the Cliche</h2>
        <p class="page-summary fade-in reveal-on-scroll">
          Many people begin with a simple search for cowboy pictures, cowboy photos, cowboy images, or black and white cowboy photos. K4 uses that familiar doorway to lead into something more layered: painterly cowboy photography shaped by gesture, consequence, silence, and story.
        </p>
        <p class="page-summary fade-in reveal-on-scroll">
          Continue into <a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White">black and white cowboy portraits</a>, <a href="/western-portrait-photography">cowgirl photos and Western portraits</a>, and <a href="/Western-Photography-Prints">Western art prints</a>.
        </p>
        <p class="page-context-link fade-in reveal-on-scroll">
          For print-first browsing and format pathways, start with <a href="/Western-Photography-Prints">western photography prints</a>.
        </p>
      </div>
    </section>

    <!-- Tombstones restored to top position -->
    <section class="collections-nav-section">
      <h3 class="collections-heading fade-in reveal-on-scroll">Explore the Stories of the American West</h3>
      <TombstoneNav client:load items={tombstonesWithThumbs} />
    </section>

    <section class="story-layout">
      <div class="text-column">
        <section class="story-section">
          {cowboyStory.map((section: any, index: number) => (
            <article class="story-block">
              {section.title && (
                <h2 class="slide-in-left" set:html={autoLinkKeywordsInText(section.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}
              {section.subhead && (
                <h3 class="slide-in-left" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}
              {section.tagline && (
                <h4 class="tagline reveal-on-scroll" set:html={autoLinkKeywordsInText(section.tagline, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}

              {section.paragraphs?.map((para: string, i: number) => (
                <p class="reveal-on-scroll" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              ))}

              {section.list && section.list.length > 0 && (
                <ul>
                  {section.list.map((item: string, j: number) => (
                    <li class="reveal-on-scroll" set:html={autoLinkKeywordsInText(item, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
                  ))}
                </ul>
              )}

              {/* Insert StorySlider (secondary variant - reduced visual weight) */}
              {index === 0 && (
                <div class="story-slider-wrapper reveal-on-scroll mt-6">
                  <div class="story-slider-skeleton relative bg-[#f4f1ec] rounded-lg shadow-sm px-5 py-4 max-w-xl mx-auto border border-[#e0d9cf] mb-8 h-[240px] overflow-hidden opacity-90">
                    <p class="text-[10px] uppercase tracking-[0.12em] text-[#a09080] mb-3">How Story Lives in These Images</p>
                    <div class="animate-pulse">
                      <div class="h-4 bg-[#e0d9cf] rounded w-3/4 mb-3"></div>
                      <div class="h-3.5 bg-[#e0d9cf] rounded w-full mb-2"></div>
                      <div class="h-3.5 bg-[#e0d9cf] rounded w-5/6 mb-2"></div>
                      <div class="h-3.5 bg-[#e0d9cf] rounded w-4/6"></div>
                    </div>
                  </div>

                  <StorySlider
                    client:only="react"
                    stories={cowboyColorData.map((story: any) => ({ ...story })) as unknown as never[]}
                    galleryPath="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color"
                    variant="secondary"
                  />
                </div>
              )}

              {section.subhead === "Character Over Archetype" && (
                <div class="story-chapter-divider reveal-on-scroll" aria-hidden="true"></div>
              )}
            </article>
          ))}
        </section>

        <MobileStoryImages
          client:only="react"
          images={sanitizeForClient(featheredImages.map((image: any) => ({ ...image }))) as unknown as never[]}
          displayCount={headingCount}
        />
      </div>

      <div class="sidebar-column hidden md:block">
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages
            client:load
            heading="Cowboy Collection Samples"
            images={featheredImages.map((image: any) => ({ ...image })) as unknown as never[]}
            displayCount={6}
          />
        </div>
      </div>
    </section>

    <section class="pb-10">
      <input type="checkbox" id="faq-toggle" class="more-toggle" />
      <div class="truncate-container" style="min-height:0;">
        <div class="truncate-text">
          <FAQAccordion items={cowboyFAQ} />
        </div>
      </div>
      <label for="faq-toggle" class="more-toggle-label"></label>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }

      const faqToggle = document.getElementById("faq-toggle");
      const truncateContainer = document.querySelector(".truncate-container");
      if (truncateContainer && faqToggle) {
        truncateContainer.addEventListener("click", (e) => {
          const summaryClicked = e.target.closest("summary");
          if (summaryClicked && !faqToggle.checked) faqToggle.checked = true;
        });
      }
    });
  </script>

  <style>
    ul { list-style-type: disc; padding-left: 1.25em; }
    ul li { margin-top: 0.15em; margin-left: 1.5em; }
    ul li::marker { margin-top: 0.15em; font-size: 1.2em; color: gray; }

    @media (max-width: 768px) {
      .section-heading .page-title { font-size: 1.5rem; line-height: 1.3; }
      .section-heading .page-subtitle {
        max-width: 42ch; margin-left: auto; margin-right: auto; text-align: center;
        font-size: 1rem; line-height: 1.4; letter-spacing: -0.04em;
      }
      .section-heading-wrap { margin-top: 0.6rem; margin-bottom: 1rem; }
      .sidebar-column { display: none; }
      .story-section { letter-spacing: -0.03em; }
      .story-block h2 {
        letter-spacing: -0.05em;
        font-size: 1.4rem !important;
        margin-top: -0.59rem;
        line-height: 1.15;
      }
    }

    .fade-in {
      opacity: 0; visibility: hidden; transform: translateY(1px);
      transition: opacity 1.75s ease, transform 1.75s ease, visibility .5s linear 1.75s;
    }
    .fade-in.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }
    .page-title.fade-in { transition-delay: .2s; }

    .section-heading-wrap { margin: -3.4rem 0 1.5rem; text-align: center; }
    .section-heading .page-title { font-size: 2rem; margin-bottom: .4rem; }
    .section-heading .page-subtitle { font-size: 1rem; font-weight: 500; color: #6d5b4a; opacity: .9; }

    .story-section {
      line-height: 1.3; padding: 2rem 1.5rem; max-width: 860px; margin: 0 auto;
      font-family: 'Glegoo', serif;
    }
    .story-block { margin-bottom: 2.5rem; }
    .story-block h2 { font-weight: 500; font-size: 1.65rem; margin-bottom: 0.55rem; }
    .story-block h3 { font-weight: 500; font-size: 1.2rem; margin-top: -0.5rem; margin-bottom: -.025rem; color: #5a4a3b; }
    .story-block .tagline { font-size: 1.05rem; font-weight: 500; margin-bottom: 1rem; color: #7a6250; }
    .story-block p { line-height: 1.6; margin-bottom: 1rem; font-size: 1.01rem; }
    .story-block ul { padding-left: 1.4rem; margin-top: 0.5rem; }
    .story-block li { margin-bottom: 0.5rem; font-size: 1rem; }

    .page-subtitle.fade-in {
      opacity: 0 !important;
      transform: translateY(-12px);
      visibility: hidden;
      transition: opacity 1.1s ease-out, transform 1.1s ease-out, visibility 0s linear 1.1s;
      transition-delay: 1s;
    }
    .page-subtitle.fade-in.is-visible {
      opacity: 1 !important;
      transform: translateY(0);
      visibility: visible;
      transition-delay: 1s;
    }

    .carousel-fade {
      opacity: 0; transform: translateY(0px);
      transition: opacity 1.5s ease-out, transform 1.5s ease-out;
      transition-delay: 0.0s;
      visibility: hidden;
    }
    .carousel-fade.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }

    .sample-fade {
      opacity: 0; transform: translateY(0px);
      transition: opacity 1.5s ease-out, transform 1.5s ease-out;
      transition-delay: 0.2s;
      visibility: hidden;
      margin-top: -0.75rem;
    }
    .sample-fade.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }

    /* Page summary sentence */
    .page-summary {
      max-width: 900px;
      margin: 0.6rem auto 0;
      font-size: 1.02rem;
      line-height: 1.55;
      color: #6d5b4a;
      font-family: 'Glegoo', serif;
      text-align: center;
      opacity: 0.92;
    }
    .page-summary a,
    .page-context-link a {
      color: #7a4d25;
      text-decoration: underline;
      text-underline-offset: 0.12em;
    }
    .page-summary a:hover,
    .page-context-link a:hover {
      color: #5d3617;
    }
    .page-support-heading {
      margin: 1.05rem auto 0;
      font-size: 1.12rem;
      line-height: 1.35;
      font-weight: 700;
      color: #705a47;
      text-align: center;
      font-family: 'Glegoo', serif;
    }
    @media (max-width: 768px) {
      .page-summary { font-size: 0.95rem; padding: 0 1rem; max-width: 90%; }
      .page-support-heading { font-size: 1.02rem; padding: 0 1rem; max-width: 90%; }
    }

    /* Collections nav section (tombstones) */
    .collections-nav-section {
      padding: 1.75rem 0 1.5rem;
      text-align: center;
    }

    /* Visual chapter break between narrative sections */
    .story-chapter-divider {
      max-width: 42ch;
      margin: 2.25rem auto 1.25rem;
      border-top: 1px solid #e0d9cf;
      opacity: 0.9;
    }
    .collections-heading {
      margin: 1.3rem auto 0.03rem;
      font-size: 1.16rem;
      line-height: 1.25;
      font-weight: 700;
      color: #8a7a6b;
      font-family: 'Glegoo', serif;
      text-align: center;
      letter-spacing: -0.01em;
    }

    /* TombstoneNav has built-in top padding; tighten it here so the title sits on the divider */
    .collections-nav-section :global(.tombstone-nav) {
      padding: 0.1rem 1rem 2rem;
      margin: 0;
    }
    .collections-nav-section :global(.tombstone-divider) {
      margin: 0.7rem auto 1.5rem;
    }

    /* Cowboy hub: unified gateway behavior (all tiles go same place)
       - no hover scaling
