---
export const prerender = true;
/**
 * Dynamic /all - Complete Gallery Index Pages
 * 
 * Generated at build time for every gallery-source in siteNav.
 * This replaces individual /all.astro files per gallery.
 */
import Footer from "@/components/Footer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteNav } from "@/data/siteNav.ts";

// ✅ Glob import all gallery data at build time
const galleryModules = import.meta.glob('/src/data/**/*.mjs', { eager: true });

// ✅ Generate static paths for all galleries
export function getStaticPaths() {
  // Helper to extract all gallery-source entries from siteNav (must be inside getStaticPaths)
  function extractGallerySources(items: any[], parentLabels: string[] = [], parentHrefs: string[] = []): any[] {
    const results: any[] = [];
    for (const item of items) {
      const currentLabels = [...parentLabels, item.label];
      const currentHrefs = [...parentHrefs, item.href];
      
      if (item.type === "gallery-source") {
        results.push({
          href: item.href,
          label: item.label,
          breadcrumbLabels: currentLabels,
          breadcrumbHrefs: currentHrefs,
        });
      }
      if (item.children) {
        results.push(...extractGallerySources(item.children, currentLabels, currentHrefs));
      }
    }
    return results;
  }

  const galleries = extractGallerySources(siteNav);
  
  return galleries.map((gallery) => {
    // href like "/Galleries/Fine-Art-Photography/Architecture/Gallery"
    // Remove leading slash for path param
    const pathParam = gallery.href.replace(/^\//, '');
    
    return {
      params: { gallery: pathParam },
      props: { 
        galleryHref: gallery.href,
        galleryLabel: gallery.label,
        breadcrumbLabels: gallery.breadcrumbLabels,
        breadcrumbHrefs: gallery.breadcrumbHrefs,
      }
    };
  });
}

// ✅ Get props from static path
const { galleryHref, galleryLabel, breadcrumbLabels, breadcrumbHrefs } = Astro.props;

// ✅ Build data path from href (href + .mjs = data file)
const dataPath = `/src/data${galleryHref}.mjs`;
const mod = galleryModules[dataPath] as any;

// ✅ Load gallery data
const rawGalleryData = mod?.galleryData || mod?.default || [];

// ✅ Filter out ghosts and hidden (archived) images
const galleryData = rawGalleryData.filter((img: any) => 
  img.visibility !== "ghost" && 
  img.visibility !== "hidden" && 
  img.id !== "i-k4studios"
);

// ✅ Gallery metadata
const imageCount = galleryData.length;
const basePath = galleryHref;
const canonicalUrl = `https://www.k4studios.com${basePath}/all`;
const parentUrl = `https://www.k4studios.com${basePath}`;

// ✅ Build gallery title from breadcrumb
const galleryTitle = breadcrumbLabels.slice(-2).join(' – '); // Last 2 levels

// ✅ SEO-optimized title and description
const seoTitle = `${galleryTitle} – Complete Index (${imageCount} Images) | Wayne Heim Fine Art`;
const seoDescription = `Browse all ${imageCount} fine art photographs in ${galleryTitle} by Wayne Heim. View the complete gallery with full stories and collector information.`;

// ✅ Text cleaners
const cleanForDisplay = (val = "") =>
  String(val)
    .replace(/[\u0000-\u001F]+/g, " ")
    .replace(/\r?\n|\r/g, " ")
    .trim();

const truncateStory = (story: string, maxLen = 150) => {
  if (!story) return "";
  const cleaned = cleanForDisplay(story);
  if (cleaned.length <= maxLen) return cleaned;
  return cleaned.slice(0, maxLen).replace(/\s+\S*$/, "") + "…";
};

// ✅ Proxy URL helper - never expose SmugMug URLs to crawlers
const getProxySrc = (id: string, size: string) => `/img/${id}/${size}.jpg`;

// ✅ Build breadcrumb JSON-LD
const breadcrumbItems = breadcrumbHrefs.map((href, idx) => ({
  "@type": "ListItem",
  "position": idx + 1,
  "item": { 
    "@id": `https://www.k4studios.com${href}`, 
    "name": breadcrumbLabels[idx] 
  }
}));
breadcrumbItems.push({
  "@type": "ListItem",
  "position": breadcrumbItems.length + 1,
  "item": { "@id": canonicalUrl, "name": "Complete Index" }
});

// ✅ Pre-build JSON-LD
const structuredDataJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.k4studios.com/#website",
      "name": "K4 Studios",
      "url": "https://www.k4studios.com",
      "publisher": { "@id": "https://www.k4studios.com/#organization" },
      "inLanguage": "en"
    },
    {
      "@type": "Organization",
      "@id": "https://www.k4studios.com/#organization",
      "name": "K4 Studios",
      "url": "https://www.k4studios.com",
      "logo": {
        "@type": "ImageObject",
        "@id": "https://www.k4studios.com/#logo",
        "url": "https://www.k4studios.com/images/K4Logo-web-b.jpg",
        "width": 512,
        "height": 512
      },
      "founder": { "@id": "https://www.k4studios.com/#person" }
    },
    {
      "@type": "Person",
      "@id": "https://www.k4studios.com/#person",
      "name": "Wayne Heim",
      "jobTitle": "Fine Art Photographer",
      "url": "https://www.k4studios.com/"
    },
    {
      "@type": "CollectionPage",
      "@id": canonicalUrl + "#collectionpage",
      "name": galleryTitle + " – Complete Index",
      "url": canonicalUrl,
      "description": seoDescription,
      "isPartOf": { "@id": parentUrl + "#collection" },
      "creator": { "@id": "https://www.k4studios.com/#person" },
      "numberOfItems": imageCount
    },
    {
      "@type": "BreadcrumbList",
      "@id": canonicalUrl + "#breadcrumb",
      "itemListElement": breadcrumbItems
    }
  ]
}, null, 2);

// ✅ Get first image for hero (if exists)
const heroImage = galleryData[0];
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={structuredDataJson} />

  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <link href="https://fonts.googleapis.com/css2?family=Glegoo:wght@400;700&display=swap" rel="stylesheet" />

  <div class="gallery-index-wrapper">
    <div class="logo">
      <a href="/" aria-label="Go to K4 Studios Homepage">
        <img src="/images/K4Logo-web-b.jpg" alt="K4 Studios Logo" />
      </a>
    </div>

    <!-- Breadcrumb (visual only - SEO handled by JSON-LD) -->
    <nav aria-label="Breadcrumb" class="breadcrumb-nav">
      <ol class="breadcrumb-list">
        {breadcrumbHrefs.map((href, idx) => (
          <li>
            {idx < breadcrumbHrefs.length - 1 ? (
              <a href={href}>{breadcrumbLabels[idx]}</a>
            ) : (
              <a href={href}>{breadcrumbLabels[idx]}</a>
            )}
          </li>
        ))}
        <li>Complete Index</li>
      </ol>
    </nav>

    <!-- Header with proper H1/H2 semantic hierarchy -->
    <div class="header">
      <h1>{galleryTitle} – Complete Index ({imageCount} Images)</h1>
      <h2>Fine Art Photography by Wayne Heim</h2>
    </div>

    <!-- Gallery Intro -->
    <section class="gallery-intro">
      <p>This page presents all {imageCount} images in this gallery. Each image links to its dedicated page with full story and collector information.</p>
      <p class="usage-hint">Hover to preview. Click any image to view the full image page.</p>
    </section>

    <!-- Image Grid -->
    {galleryData.length > 0 ? (
      <div class="ssr-grid">
        {galleryData.map((item: any, idx: number) => {
          const imageUrl = getProxySrc(item.id, 's');
          const srcsetParts = [
            `${getProxySrc(item.id, 's')} 400w`,
            `${getProxySrc(item.id, 'm')} 600w`,
            `${getProxySrc(item.id, 'l')} 1024w`
          ].join(", ");
          const linkUrl = `${basePath}/${item.id}`;
          const title = cleanForDisplay(item.title || 'Untitled');
          
          let altText: string;
          if (item.alt) {
            altText = cleanForDisplay(item.alt);
          } else if (item.description) {
            const firstSentence = item.description.split(/[.!?]/)[0];
            altText = cleanForDisplay(firstSentence.slice(0, 150));
          } else if (item.keywords?.length > 0) {
            const topKeywords = item.keywords.slice(0, 4).join(", ");
            altText = `Fine art photograph: ${topKeywords}`;
          } else {
            altText = `Fine art photograph: ${title} by Wayne Heim`;
          }
          
          const storyExcerpt = truncateStory(item.story || "");

          return (
            <div class="ssr-card" id={item.id}>
              <a href={linkUrl} class="ssr-card-link">
                <img 
                  src={imageUrl} 
                  srcset={srcsetParts}
                  sizes="(max-width: 640px) 100vw, 250px"
                  alt={altText} 
                  title={altText} 
                  loading="lazy" 
                />
                <div class="ssr-card-content">
                  <span class="card-number">#{idx + 1}</span>
                  <h3>{title}</h3>
                  {storyExcerpt && <p>{storyExcerpt}</p>}
                </div>
              </a>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="empty-gallery">
        <p>No images found in this gallery.</p>
        <p><a href={basePath}>← Return to gallery</a></p>
      </div>
    )}

    <Footer />
  </div>

  <style>
    body { background:#fff; color:#2a1f17; font-family:'Glegoo',serif; }
    .gallery-index-wrapper { min-height:100vh; padding:24px; }

    .logo { display:flex; justify-content:center; margin:32px 0 16px; }
    .logo a:hover { transform:scale(1.05); }
    .logo img { width:100px; height:100px; border-radius:50%; box-shadow:0 4px 10px rgba(0,0,0,.2); }

    .breadcrumb-nav { text-align:center; margin-bottom:8px; font-family:'Glegoo',serif; }
    .breadcrumb-list {
      display:inline-flex; flex-wrap:wrap; justify-content:center;
      gap:6px; list-style:none; padding:0; margin:0;
      font-size:0.9rem; color:#6a5747;
    }
    .breadcrumb-list a { color:#85644b; text-decoration:none; transition:color 0.2s ease; }
    .breadcrumb-list a:hover { color:#5a3e2b; }
    .breadcrumb-list li::after { content:"›"; margin:0 4px; color:#9b8b7f; }
    .breadcrumb-list li:last-child::after { content:""; }

    .header { text-align:center; background:#000; color:#fff; padding:16px; border-radius:8px; margin-bottom:24px; }
    .header h1 { margin:0; font-size:1.5em; font-weight:700; }
    .header h2 { margin:8px 0 0; font-size:1.1em; font-weight:400; font-style:italic; color:#ccc; }

    .gallery-intro { max-width:900px; margin:0 auto 24px; text-align:center; }
    .gallery-intro p { font-size:1rem; line-height:1.6; color:#3a2d24; margin:0 0 8px; }
    .gallery-intro .usage-hint { font-size:0.9rem; color:#666; font-style:italic; margin-top:12px; }

    .empty-gallery { text-align:center; padding:60px 20px; }
    .empty-gallery a { color:#85644b; }

    .ssr-grid {
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(250px,1fr));
      gap:20px;
      margin:30px auto;
      max-width:1400px;
      padding:0 40px;
      align-items:stretch;
    }

    .ssr-card {
      position:relative;
      border:1px solid #ddd;
      border-radius:8px;
      background:#fff;
      box-shadow:0 2px 5px rgba(0,0,0,.1);
      overflow:hidden;
      transition: box-shadow 0.5s ease-in-out, outline 0.3s ease-in-out, outline-offset 0.3s ease-in-out;
      display:flex;
      flex-direction:column;
      outline: 3px solid transparent;
      outline-offset: -3px;
    }

    .ssr-card.row-active {
      box-shadow: 0 8px 20px rgba(0,0,0,.18);
    }

    .ssr-card.card-hovered {
      outline-color: #c9a227;
      box-shadow: 0 12px 28px rgba(0,0,0,.25);
    }

    .ssr-card-link {
      display:flex;
      flex-direction:column;
      height:100%;
      text-decoration:none;
      color:inherit;
      cursor:pointer;
    }

    .ssr-card img {
      width:100%;
      max-height:144px;
      object-fit:cover;
      object-position:center top;
      transition: max-height 1.1s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .ssr-card.row-active img {
      max-height:280px;
    }

    .ssr-card-content {
      padding:10px 12px;
      max-height:80px;
      overflow:hidden;
      transition: max-height 1.1s cubic-bezier(0.4, 0, 0.2, 1);
      cursor:pointer;
      user-select:none;
    }

    .ssr-card.row-active .ssr-card-content {
      max-height:200px;
    }

    .card-number {
      font-size:.75rem;
      color:#888;
      display:block;
      margin-bottom:2px;
    }

    .ssr-card-content h3 { font-size:.95rem; font-weight:700; margin:0 0 5px; }
    .ssr-card-content p { font-size:.85rem; line-height:1.2rem; margin:0; color:#5a4a3a; }

    /* Mobile: show full image height since no hover available */
    @media (max-width: 768px) {
      .ssr-grid { padding:0 16px; gap:16px; }
      .ssr-card img { max-height:none; height:auto; }
      .ssr-card-content { max-height:none; }
    }
  </style>

  <!-- Warm first visible images -->
  <script is:inline>
    (function() {
      const cards = document.querySelectorAll('.ssr-card');
      if (!cards.length) return;
      
      // Warm first 12-16 images (first 2-3 rows typically visible)
      const WARM_COUNT = Math.min(16, cards.length);
      
      for (let i = 0; i < WARM_COUNT; i++) {
        const imgEl = cards[i].querySelector('img');
        if (!imgEl) continue;
        const src = imgEl.getAttribute('src');
        const match = src?.match(/\/img\/(i-[^/]+)/);
        if (match) {
          // Fire-and-forget warming
          const img = new Image();
          img.src = `/img/${match[1]}/s.jpg`;
          // Also warm 'm' for responsive srcset
          const imgM = new Image();
          imgM.src = `/img/${match[1]}/m.jpg`;
        }
      }
    })();
  </script>

  <script is:inline>
    (function () {
      const grid = document.querySelector('.ssr-grid');
      if (!grid) return;

      const cards = Array.from(grid.querySelectorAll('.ssr-card'));
      if (!cards.length) return;

      let activeRowTop = null;
      let hoveredCard = null;
      let collapseTimer = null;
      const ROW_TOLERANCE = 12;

      function getRowTopForCard(card) {
        return card.getBoundingClientRect().top;
      }

      function getRowCardsForTop(rowTop) {
        return cards.filter((c) => Math.abs(c.getBoundingClientRect().top - rowTop) <= ROW_TOLERANCE);
      }

      function clearActiveRow() {
        cards.forEach((c) => {
          c.classList.remove('row-active');
          c.classList.remove('card-hovered');
        });
        activeRowTop = null;
        hoveredCard = null;
      }

      function setHoveredCard(card) {
        if (hoveredCard === card) return;
        if (hoveredCard) hoveredCard.classList.remove('card-hovered');
        hoveredCard = card;
        if (card) card.classList.add('card-hovered');
      }

      function setActiveRowByCard(card) {
        if (!card) return;
        setHoveredCard(card);
        const rowTop = getRowTopForCard(card);
        if (activeRowTop !== null && Math.abs(activeRowTop - rowTop) <= ROW_TOLERANCE) return;
        activeRowTop = rowTop;
        cards.forEach((c) => c.classList.remove('row-active'));
        getRowCardsForTop(rowTop).forEach((c) => c.classList.add('row-active'));
      }

      function findCardForY(clientY) {
        for (const c of cards) {
          const rect = c.getBoundingClientRect();
          if (clientY >= rect.top - ROW_TOLERANCE && clientY <= rect.bottom + ROW_TOLERANCE) return c;
        }
        return null;
      }

      grid.addEventListener('mousemove', (e) => {
        clearTimeout(collapseTimer);
        let card = e.target.closest('.ssr-card') || findCardForY(e.clientY);
        if (card) setActiveRowByCard(card);
      });

      grid.addEventListener('mouseenter', () => clearTimeout(collapseTimer));
      grid.addEventListener('mouseleave', () => {
        collapseTimer = setTimeout(clearActiveRow, 180);
      });

      window.addEventListener('resize', clearActiveRow);
    })();
  </script>
</BaseLayout>
