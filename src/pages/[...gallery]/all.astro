---
export const prerender = true;
/**
 * Dynamic /all - Gallery Collection Pages
 * 
 * Generated at build time for every gallery-source in siteNav.
 * This replaces individual /all.astro files per gallery.
 */
import Footer from "@/components/Footer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteNav } from "@/data/siteNav.ts";
import {
  getGalleryCollectionContext,
  getGalleryCollectionLabel,
  resolveGallerySourceHref,
} from "@/utils/galleryCollectionNav.ts";
import { getSemanticImageSrcset, getSemanticImageUrl } from "@/utils/imageProxy.js";
import { getCollectionImageGalleryGraph } from "@/components/utils/getStructuredData.ts";

// ✅ Glob import all gallery data at build time
const galleryModules = import.meta.glob('/src/data/**/*.mjs', { eager: true });
const collectionContentModules = {
  ...import.meta.glob('/src/data/Galleries/**/landingstones.ts', { eager: true }),
  ...import.meta.glob('/src/data/Galleries/**/*EntranceData.ts', { eager: true }),
  ...import.meta.glob('/src/data/Other/**/landingstones.ts', { eager: true }),
  ...import.meta.glob('/src/data/Other/**/*EntranceData.ts', { eager: true }),
};

// ✅ Generate static paths for all galleries
export function getStaticPaths() {
  const dedicatedAllPageHrefs = new Set([
    "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color",
    "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White",
    "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color",
    "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Black-White",
  ]);
  // Helper to extract all gallery-source entries from siteNav (must be inside getStaticPaths)
  function extractGallerySources(items: any[], parentLabels: string[] = [], parentHrefs: string[] = []): any[] {
    const results: any[] = [];
    for (const item of items) {
      const currentLabels = [...parentLabels, item.label];
      const currentHrefs = [...parentHrefs, item.href];
      
      if (item.type === "gallery-source") {
        results.push({
          href: item.href,
          label: item.label,
          breadcrumbLabels: currentLabels,
          breadcrumbHrefs: currentHrefs,
        });
      }
      if (item.children) {
        results.push(...extractGallerySources(item.children, currentLabels, currentHrefs));
      }
    }
    return results;
  }

  const galleries = extractGallerySources(siteNav);
  
  return galleries
    .filter((gallery) => !dedicatedAllPageHrefs.has(gallery.href))
    .map((gallery) => {
    // href like "/Galleries/Fine-Art-Photography/Architecture/Gallery"
    // Remove leading slash for path param
    const pathParam = gallery.href.replace(/^\//, '');
    
    return {
      params: { gallery: pathParam },
      props: { 
        galleryHref: gallery.href,
        galleryLabel: gallery.label,
        breadcrumbLabels: gallery.breadcrumbLabels,
        breadcrumbHrefs: gallery.breadcrumbHrefs,
      }
    };
  });
}

// ✅ Get props from static path
const {
  galleryHref,
  galleryLabel,
  breadcrumbLabels,
  breadcrumbHrefs,
}: {
  galleryHref: string;
  galleryLabel: string;
  breadcrumbLabels: string[];
  breadcrumbHrefs: string[];
} = Astro.props;

// ✅ Build data path from href. Most galleries are href + .mjs, but a few
// store the module inside a same-named folder, e.g. /Black-White/Black-White.mjs.
const leafSegment = galleryHref.split('/').filter(Boolean).at(-1) || '';
const dataPathCandidates = [
  `/src/data${galleryHref}.mjs`,
  `/src/data${galleryHref}/${leafSegment}.mjs`,
];
const dataPath = dataPathCandidates.find((candidate) => galleryModules[candidate]);
const mod = dataPath ? galleryModules[dataPath] as any : null;

// ✅ Load gallery data
const rawGalleryData = mod?.galleryData || mod?.default || [];

// ✅ Filter out ghosts and hidden (archived) images
const galleryData = rawGalleryData.filter((img: any) => 
  img.visibility !== "ghost" && 
  img.visibility !== "hidden" && 
  img.id !== "i-k4studios"
);

// ✅ Gallery metadata
const imageCount = galleryData.length;
const basePath = galleryHref;
const canonicalUrl = `https://www.k4studios.com${basePath}/all`;
const parentUrl = `https://www.k4studios.com${basePath}`;

// ✅ Build gallery title from breadcrumb
const galleryTitle = breadcrumbLabels.slice(-2).join(' – '); // Last 2 levels

// ✅ Text cleaners
const cleanForDisplay = (val = "") =>
  String(val)
    .replace(/[\u0000-\u001F]+/g, " ")
    .replace(/\r?\n|\r/g, " ")
    .trim();

const stripHtml = (val = "") =>
  String(val)
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/gi, " ");

const cleanForPlainText = (val = "") => cleanForDisplay(stripHtml(val).replace(/\s+/g, " "));

const truncateText = (text = "", maxLen = 240) => {
  if (!text) return "";
  if (text.length <= maxLen) return text;
  return text.slice(0, maxLen).replace(/\s+\S*$/, "") + "…";
};

const truncateStory = (story: string, maxLen = 150) => {
  if (!story) return "";
  const cleaned = cleanForDisplay(story);
  if (cleaned.length <= maxLen) return cleaned;
  return cleaned.slice(0, maxLen).replace(/\s+\S*$/, "") + "…";
};

const getContentRecord = (mod: any) => {
  if (!mod || typeof mod !== 'object') return null;

  const directCandidates = [
    mod.entranceData,
    mod.landingWestern,
    mod.landingTraditional,
    mod.landingWWII,
    mod.landingCowboy,
    mod.default,
  ].filter(Boolean);

  for (const candidate of directCandidates) {
    if (candidate && typeof candidate === 'object') return candidate;
  }

  return Object.values(mod).find(
    (value: any) => value && typeof value === 'object' && (value.title || value.subtitle || value.description),
  ) || null;
};

const normalizeToken = (value = "") => String(value).toLowerCase().replace(/[^a-z0-9]/g, '');

const scoreEntranceCandidate = (filePath: string, leafSegment: string) => {
  const fileName = normalizeToken(filePath.split('/').pop()?.replace(/\.ts$/, '') || '');
  const leaf = normalizeToken(leafSegment);
  let score = 0;

  if (leaf && fileName.includes(leaf)) score += 10;
  if (leaf.includes('blackwhite') || leaf.includes('bw')) {
    if (fileName.includes('bw') || fileName.includes('black')) score += 6;
  }
  if (leaf.includes('color')) {
    if (fileName.includes('color')) score += 6;
  }
  if (leaf.includes('na') && fileName.includes('na')) score += 5;
  if (leaf.includes('gallery') && fileName.includes('color')) score += 2;

  return score;
};

const findEntranceRecord = (href: string) => {
  const dirPath = href.slice(0, href.lastIndexOf('/'));
  const leafSegment = href.split('/').pop() || '';
  const dirPrefix = `/src/data${dirPath}/`;

  const candidates = Object.entries(collectionContentModules)
    .filter(([filePath]) => filePath.startsWith(dirPrefix) && filePath.endsWith('EntranceData.ts'))
    .sort((a, b) => scoreEntranceCandidate(b[0], leafSegment) - scoreEntranceCandidate(a[0], leafSegment));

  return candidates.length ? getContentRecord(candidates[0][1]) : null;
};

const findNearestLandingRecord = (href: string) => {
  let currentPath = href;

  while (currentPath && currentPath !== '/') {
    const candidatePath = `/src/data${currentPath}/landingstones.ts`;
    if (collectionContentModules[candidatePath]) {
      return getContentRecord(collectionContentModules[candidatePath]);
    }
    currentPath = currentPath.slice(0, currentPath.lastIndexOf('/'));
  }

  return null;
};

const collectionContext = getGalleryCollectionContext(galleryHref);
const entranceRecord = findEntranceRecord(galleryHref);
const landingRecord = findNearestLandingRecord(galleryHref);

const collectionSubtitle = cleanForPlainText(
  entranceRecord?.subtitle ||
  landingRecord?.subtitle ||
  'Fine art photography by Wayne Heim'
);

const collectionLead = cleanForPlainText(
  entranceRecord?.description ||
  landingRecord?.description ||
  landingRecord?.subtitle ||
  `Browse the full ${galleryTitle} collection by Wayne Heim.`
);

const collectionSupportFallback = `This collection page keeps all ${imageCount} visible works in one browseable sequence and links each image to its full story page, collector notes, and image-level detail.`;
const collectionSupport = (() => {
  const sourceText = cleanForPlainText(entranceRecord?.details || landingRecord?.description || '');
  if (!sourceText || sourceText === collectionLead) return collectionSupportFallback;
  return truncateText(sourceText, 340);
})();

const styleLabel = galleryHref.includes('/Painterly-Fine-Art-Photography/')
  ? 'Painterly'
  : (galleryHref.includes('/Fine-Art-Photography/') ? 'Traditional' : '');

const styledGalleryTitle = styleLabel && !new RegExp(`^${styleLabel}\\b`, 'i').test(galleryTitle)
  ? `${styleLabel} ${galleryTitle}`
  : galleryTitle;

const getGalleryVariant = (href: string) => {
  const isBlackWhite = /\/(Black-White|NA-Black-White)(\/|$)/i.test(href);
  const isColor = /\/(Color|NA-Color|Trains-Color)(\/|$)/i.test(href);
  if (isBlackWhite) return 'Black and White';
  if (isColor) return 'Color';
  return '';
};

const getSerpCollectionTitle = (title: string, href: string) => {
  const variant = getGalleryVariant(href);
  const prefix = variant ? `${variant} ` : '';

  if (/Western-Cowboy-Portraits/i.test(href)) {
    return `${prefix}Cowboy Photography | Western Portrait Collection`;
  }

  if (/Western-Narratives/i.test(href)) {
    return `${prefix}Western Photography | Narrative Collection`;
  }

  if (/Native-Americans/i.test(href)) {
    return `${prefix}Native American Photography | Portrait Collection`;
  }

  if (/Civil-War-Portraits/i.test(href)) {
    return `${prefix}Civil War Portrait Photography | Historical Collection`;
  }

  if (/Roaring-20s-Portraits/i.test(href)) {
    return `${prefix}1920s Portrait Photography | Roaring 20s Collection`;
  }

  if (/\/WWII\/War\//i.test(href)) {
    return `${prefix}WWII Photography | War Collection`;
  }

  if (/\/WWII\/Machines\//i.test(href)) {
    return `${prefix}WWII Machine Photography | Military Collection`;
  }

  if (/\/WWII\/Portraits\//i.test(href)) {
    return `${prefix}WWII Portrait Photography | Historical Collection`;
  }

  if (/\/Landscapes\/By-Location\/International\//i.test(href)) {
    const leaf = href.split('/').at(-1) || '';
    const location = leaf === 'Gallery' ? 'International' : leaf.replace(/-/g, ' ');
    return `${location} Landscape Photography | Complete Collection`;
  }

  if (/\/Landscapes\/By-Location\//i.test(href)) {
    const region = href.split('/').at(-2) === 'By-Location' ? 'Regional' : href.split('/').at(-2) || '';
    const label = region === 'By-Location' ? 'Regional' : region.replace(/-/g, ' ');
    return `${label} Landscape Photography | Complete Collection`;
  }

  if (/\/Landscapes\/By-Theme\//i.test(href)) {
    const theme = href.split('/').at(-1)?.replace(/-/g, ' ') || '';
    if (/Black White/i.test(theme)) return 'Black and White Landscape Photography | Complete Collection';
    if (/Color/i.test(theme)) return 'Color Landscape Photography | Complete Collection';
    return `${theme} Landscape Photography | Complete Collection`;
  }

  if (/\/Portraits\//i.test(href) || /\/Portraits$/i.test(href)) {
    if (/Reenactors/i.test(href)) return 'Reenactor Portrait Photography | Complete Collection';
    return `${prefix}Portrait Photography | Complete Collection`;
  }

  if (/\/Transportation\//i.test(href)) {
    if (/Trains-Black-White/i.test(href)) return 'Black and White Train Photography | Transportation Collection';
    if (/Trains-Color|\/Trains$/i.test(href)) return `${prefix || ''}Train Photography | Transportation Collection`;
    if (/Cars/i.test(href)) return 'Car Photography | Transportation Collection';
    if (/Boats/i.test(href)) return 'Boat Photography | Transportation Collection';
    if (/Planes/i.test(href)) return 'Plane Photography | Transportation Collection';
    if (/Military/i.test(href)) return 'Military Vehicle Photography | Transportation Collection';
  }

  if (/\/Architecture\/Gallery/i.test(href)) {
    return 'Architecture Photography | Complete Collection';
  }

  if (/\/Miscellaneous\/Reenactments/i.test(href)) {
    return 'Historical Reenactment Photography | Complete Collection';
  }

  if (/\/Miscellaneous\/Wildlife/i.test(href)) {
    return 'Wildlife Photography | Complete Collection';
  }

  if (/\/Miscellaneous\/Pets/i.test(href)) {
    return 'Pet Photography | Complete Collection';
  }

  if (/\/Other\/Archive/i.test(href)) {
    return 'Photography Archive | Complete Image Collection';
  }

  if (/\/Engrained-Series/i.test(href)) {
    return 'Engrained Wood Print Photography | Complete Collection';
  }

  const readableTitle = title
    .replace(/\s+[–-]\s+Black\s*&\s*White$/i, '')
    .replace(/\s+[–-]\s+Color$/i, '')
    .replace(/\bBlack\s*&\s*White\b/gi, 'Black and White');

  return `${prefix}${readableTitle} | Complete Collection`;
};

const seoCollectionTitle = getSerpCollectionTitle(styledGalleryTitle, galleryHref).replace(/\s+/g, ' ').trim();
const seoCollectionSubject = seoCollectionTitle.split('|')[0].trim();
const descriptionSubject = seoCollectionSubject
  .replace(/\s+Photography$/i, ' photographs')
  .replace(/\s+Portraits$/i, ' portraits')
  .replace(/^Black and White\b/, 'black and white')
  .replace(/^Color\b/, 'color')
  .replace(/\bPortrait photographs\b/g, 'portrait photographs')
  .replace(/\bLandscape photographs\b/g, 'landscape photographs')
  .replace(/\bMachine photographs\b/g, 'machine photographs')
  .replace(/\bTrain photographs\b/g, 'train photographs')
  .replace(/\s+/g, ' ')
  .trim();

// ✅ SEO-optimized title and description
const seoTitle = seoCollectionTitle;
const seoDescription = truncateText(
  `Complete listing of ${imageCount} ${descriptionSubject} by Wayne Heim, with image pages, stories, and collector details.`,
  160,
);

const buildRelatedDescription = (href: string) => {
  const resolvedHref = resolveGallerySourceHref(href);
  const relatedEntrance = findEntranceRecord(resolvedHref);
  const relatedLanding = findNearestLandingRecord(resolvedHref);
  const summary = cleanForPlainText(
    relatedEntrance?.description || relatedLanding?.description || relatedLanding?.subtitle || ''
  );

  return truncateText(
    summary || `Browse the full ${getGalleryCollectionLabel(resolvedHref)} collection.`,
    145,
  );
};

const relatedCollectionLinks = (() => {
  const links: Array<{ href: string; title: string; description: string; eyebrow: string }> = [];

  if (collectionContext.parent?.href) {
    links.push({
      href: collectionContext.parent.href,
      title: `${collectionContext.parent.label} Overview`,
      description: `Return to the ${collectionContext.parent.label} overview for curated entry points and broader context.`,
      eyebrow: 'Overview',
    });
  }

  for (const sibling of collectionContext.siblingGallerySources.slice(0, 3)) {
    const siblingHref = resolveGallerySourceHref(sibling.href);
    const siblingTitle = `${getGalleryCollectionLabel(siblingHref)} Collection`;
    links.push({
      href: `${siblingHref}/all`,
      title: siblingTitle,
      description: buildRelatedDescription(siblingHref),
      eyebrow: 'Sibling Collection',
    });
  }

  for (const siblingCollection of collectionContext.siblingCollections.slice(0, 3)) {
    const siblingHref = resolveGallerySourceHref(siblingCollection.href);
    const siblingTitle = `${getGalleryCollectionLabel(siblingHref)} Collection`;
    links.push({
      href: `${siblingHref}/all`,
      title: siblingTitle,
      description: buildRelatedDescription(siblingHref),
      eyebrow: 'Related Collection',
    });
  }

  return Array.from(new Map(links.map((link) => [link.href, link])).values()).slice(0, 6);
})();

// ✅ Build breadcrumb JSON-LD
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "item": { "@id": "https://www.k4studios.com/", "name": "Home" },
  },
  ...breadcrumbHrefs.map((href: string, idx: number) => ({
  "@type": "ListItem",
  "position": idx + 2,
  "item": { 
    "@id": `https://www.k4studios.com${href}`, 
    "name": breadcrumbLabels[idx] 
  }
  })),
];
breadcrumbItems.push({
  "@type": "ListItem",
  "position": breadcrumbItems.length + 1,
  "item": { "@id": canonicalUrl, "name": "Collection" }
});

// ✅ Pre-build JSON-LD
const collectionImageGalleryGraph = getCollectionImageGalleryGraph({
  pageUrl: canonicalUrl,
  name: `${galleryTitle} Collection`,
  description: seoDescription,
  images: galleryData,
  basePath,
});

const structuredDataJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.k4studios.com/#website",
      "name": "K4 Studios",
      "url": "https://www.k4studios.com",
      "publisher": { "@id": "https://www.k4studios.com/#organization" },
      "inLanguage": "en"
    },
    {
      "@type": "Organization",
      "@id": "https://www.k4studios.com/#organization",
      "name": "K4 Studios",
      "url": "https://www.k4studios.com",
      "logo": {
        "@type": "ImageObject",
        "@id": "https://www.k4studios.com/#logo",
        "url": "https://www.k4studios.com/images/K4Logo-web-b.jpg",
        "width": 512,
        "height": 512
      },
      "founder": { "@id": "https://www.k4studios.com/#person" }
    },
    {
      "@type": "CollectionPage",
      "@id": canonicalUrl + "#collectionpage",
      "name": galleryTitle + " Collection",
      "url": canonicalUrl,
      "description": seoDescription,
      "isPartOf": { "@id": parentUrl + "#collection" },
      "creator": { "@id": "https://www.k4studios.com/#person" },
      "mainEntity": [
        { "@id": canonicalUrl + "#imagegallery" },
        { "@id": canonicalUrl + "#itemlist" }
      ]
    },
    ...collectionImageGalleryGraph,
    {
      "@type": "BreadcrumbList",
      "@id": canonicalUrl + "#breadcrumb",
      "itemListElement": breadcrumbItems
    }
  ]
}, null, 2);

// ✅ Get first image for hero (if exists)
const heroImage = galleryData[0];
---

<BaseLayout title={seoTitle} description={seoDescription} meta={{ canonicalUrl, robots: "index, follow" }}>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={structuredDataJson} />

  <link href="https://fonts.googleapis.com/css2?family=Glegoo:wght@400;700&display=swap" rel="stylesheet" />

  <div class="gallery-index-wrapper">
    <div class="logo">
      <a href="/" aria-label="Go to K4 Studios Homepage">
        <img src="/images/K4Logo-web-b.jpg" alt="K4 Studios Logo" />
      </a>
    </div>

    <!-- Breadcrumb (visual only - SEO handled by JSON-LD) -->
    <nav aria-label="Breadcrumb" class="breadcrumb-nav">
      <ol class="breadcrumb-list">
        {breadcrumbHrefs.map((href: string, idx: number) => (
          <li>
            {idx < breadcrumbHrefs.length - 1 ? (
              <a href={href}>{breadcrumbLabels[idx]}</a>
            ) : (
              <a href={href}>{breadcrumbLabels[idx]}</a>
            )}
          </li>
        ))}
        <li>Collection</li>
      </ol>
    </nav>

    <!-- Header with proper H1/H2 semantic hierarchy -->
    <div class="header">
      <h1>{galleryTitle} Collection ({imageCount} Images)</h1>
      <h2>{collectionSubtitle}</h2>
    </div>

    <!-- Gallery Intro -->
    <section class="gallery-intro">
      <p>{collectionLead}</p>
      <p>{collectionSupport}</p>
      {collectionContext.parent?.href && collectionContext.parent?.label && (
        <p class="overview-link">
          Return to the <a href={collectionContext.parent.href}>{collectionContext.parent.label}</a> overview for curated entry points and the broader series context.
        </p>
      )}
      <p class="usage-hint">Hover to preview. Click any image to view the full image page.</p>
    </section>

    {relatedCollectionLinks.length > 0 && (
      <section class="related-collections" aria-label="Related collections">
        <div class="related-collections__inner">
          <h3>Related Collections</h3>
          <div class="related-collections__grid">
            {relatedCollectionLinks.map((link) => (
              <a href={link.href} class="related-collections__card">
                <span class="related-collections__eyebrow">{link.eyebrow}</span>
                <strong>{link.title}</strong>
                <span>{link.description}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Image Grid -->
    {galleryData.length > 0 ? (
      <div class="ssr-grid">
        {galleryData.map((item: any, idx: number) => {
          const imageUrl = getSemanticImageUrl(item, { galleryPath: basePath }, 's');
          const srcsetParts = getSemanticImageSrcset(item, { galleryPath: basePath });
          const linkUrl = `${basePath}/${item.id}`;
          const title = cleanForDisplay(item.title || 'Untitled');
          
          let altText: string;
          if (item.alt) {
            altText = cleanForDisplay(item.alt);
          } else if (item.description) {
            const firstSentence = item.description.split(/[.!?]/)[0];
            altText = cleanForDisplay(firstSentence.slice(0, 150));
          } else if (item.keywords?.length > 0) {
            const topKeywords = item.keywords.slice(0, 4).join(", ");
            altText = `Fine art photograph: ${topKeywords}`;
          } else {
            altText = `Fine art photograph: ${title} by Wayne Heim`;
          }
          
          const storyExcerpt = truncateStory(item.story || "");

          return (
            <div class="ssr-card" id={item.id}>
              <a href={linkUrl} class="ssr-card-link">
                <img 
                  src={imageUrl} 
                  srcset={srcsetParts}
                  sizes="(max-width: 640px) 100vw, 250px"
                  alt={altText} 
                  title={altText} 
                  loading="lazy" 
                />
                <div class="ssr-card-content">
                  <span class="card-number">#{idx + 1}</span>
                  <h3>{title}</h3>
                  {storyExcerpt && <p>{storyExcerpt}</p>}
                </div>
              </a>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="empty-gallery">
        <p>No images found in this gallery.</p>
        <p><a href={basePath}>← Return to gallery</a></p>
      </div>
    )}

    <Footer />
  </div>

  <style>
    body { background:#fff; color:#2a1f17; font-family:'Glegoo',serif; }
    .gallery-index-wrapper { min-height:100vh; padding:24px; }

    .logo { display:flex; justify-content:center; margin:32px 0 16px; }
    .logo a:hover { transform:scale(1.05); }
    .logo img { width:100px; height:100px; border-radius:50%; box-shadow:0 4px 10px rgba(0,0,0,.2); }

    .breadcrumb-nav { text-align:center; margin-bottom:8px; font-family:'Glegoo',serif; }
    .breadcrumb-list {
      display:inline-flex; flex-wrap:wrap; justify-content:center;
      gap:6px; list-style:none; padding:0; margin:0;
      font-size:0.9rem; color:#6a5747;
    }
    .breadcrumb-list a { color:#85644b; text-decoration:none; transition:color 0.2s ease; }
    .breadcrumb-list a:hover { color:#5a3e2b; }
    .breadcrumb-list li::after { content:"›"; margin:0 4px; color:#9b8b7f; }
    .breadcrumb-list li:last-child::after { content:""; }

    .header { text-align:center; background:#000; color:#fff; padding:16px; border-radius:8px; margin-bottom:24px; }
    .header h1 { margin:0; font-size:1.5em; font-weight:700; }
    .header h2 { margin:8px 0 0; font-size:1.1em; font-weight:400; font-style:italic; color:#ccc; }

    .gallery-intro { max-width:900px; margin:0 auto 24px; text-align:center; }
    .gallery-intro p { font-size:1rem; line-height:1.6; color:#3a2d24; margin:0 0 8px; }
    .gallery-intro .overview-link { margin-top:10px; }
    .gallery-intro a { color:#85644b; text-decoration:none; font-weight:600; }
    .gallery-intro a:hover { color:#5a3e2b; text-decoration:underline; }
    .gallery-intro .usage-hint { font-size:0.9rem; color:#666; font-style:italic; margin-top:12px; }

    .related-collections {
      max-width:1200px;
      margin:0 auto 28px;
      padding:0 16px;
    }

    .related-collections__inner {
      background:#f6f2ee;
      border:1px solid #e2d8cf;
      border-radius:10px;
      padding:22px;
    }

    .related-collections__inner h3 {
      margin:0 0 14px;
      text-align:center;
      font-size:1.1rem;
      color:#2f2219;
    }

    .related-collections__grid {
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
      gap:14px;
    }

    .related-collections__card {
      display:flex;
      flex-direction:column;
      gap:6px;
      padding:14px 16px;
      border-radius:8px;
      border:1px solid #d8cbc0;
      background:#fff;
      color:#3a2d24;
      text-decoration:none;
      transition:transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .related-collections__card:hover {
      transform:translateY(-2px);
      box-shadow:0 8px 18px rgba(0,0,0,.08);
      border-color:#b79d87;
    }

    .related-collections__eyebrow {
      font-size:0.72rem;
      letter-spacing:0.08em;
      text-transform:uppercase;
      color:#8a6d57;
    }

    .related-collections__card strong {
      font-size:1rem;
      color:#2b1f17;
    }

    .related-collections__card span:last-child {
      font-size:0.9rem;
      line-height:1.5;
      color:#5b4a3d;
    }

    .empty-gallery { text-align:center; padding:60px 20px; }
    .empty-gallery a { color:#85644b; }

    .ssr-grid {
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(250px,1fr));
      gap:20px;
      margin:30px auto;
      max-width:1400px;
      padding:0 40px;
      align-items:stretch;
    }

    .ssr-card {
      position:relative;
      border:1px solid #ddd;
      border-radius:8px;
      background:#fff;
      box-shadow:0 2px 5px rgba(0,0,0,.1);
      overflow:hidden;
      transition: box-shadow 0.5s ease-in-out, outline 0.3s ease-in-out, outline-offset 0.3s ease-in-out;
      display:flex;
      flex-direction:column;
      outline: 3px solid transparent;
      outline-offset: -3px;
    }

    .ssr-card.row-active {
      box-shadow: 0 8px 20px rgba(0,0,0,.18);
    }

    .ssr-card.card-hovered {
      outline-color: #c9a227;
      box-shadow: 0 12px 28px rgba(0,0,0,.25);
    }

    .ssr-card-link {
      display:flex;
      flex-direction:column;
      height:100%;
      text-decoration:none;
      color:inherit;
      cursor:pointer;
    }

    .ssr-card img {
      width:100%;
      max-height:144px;
      object-fit:cover;
      object-position:center top;
      transition: max-height 1.1s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .ssr-card.row-active img {
      max-height:280px;
    }

    .ssr-card-content {
      padding:10px 12px;
      max-height:80px;
      overflow:hidden;
      transition: max-height 1.1s cubic-bezier(0.4, 0, 0.2, 1);
      cursor:pointer;
      user-select:none;
    }

    .ssr-card.row-active .ssr-card-content {
      max-height:200px;
    }

    .card-number {
      font-size:.75rem;
      color:#888;
      display:block;
      margin-bottom:2px;
    }

    .ssr-card-content h3 { font-size:.95rem; font-weight:700; margin:0 0 5px; }
    .ssr-card-content p { font-size:.85rem; line-height:1.2rem; margin:0; color:#5a4a3a; }

    /* Mobile: show full image height since no hover available */
    @media (max-width: 768px) {
      .ssr-grid { padding:0 16px; gap:16px; }
      .ssr-card img { max-height:none; height:auto; }
      .ssr-card-content { max-height:none; }
      .related-collections__inner { padding:18px; }
    }
  </style>

  <!-- Warm first visible images -->
  <script is:inline>
    (function() {
      const cards = document.querySelectorAll('.ssr-card');
      if (!cards.length) return;
      
      // Warm first 12-16 images (first 2-3 rows typically visible)
      const WARM_COUNT = Math.min(16, cards.length);
      
      for (let i = 0; i < WARM_COUNT; i++) {
        const imgEl = cards[i].querySelector('img');
        if (!imgEl) continue;
        const warmUrls = new Set();
        const src = imgEl.currentSrc || imgEl.getAttribute('src');
        if (src) warmUrls.add(src);

        const srcset = imgEl.getAttribute('srcset') || '';
        srcset.split(',').forEach((candidate) => {
          const url = candidate.trim().split(/\s+/)[0];
          if (url && /\/img\/i-[^/]+\/m\//.test(url)) warmUrls.add(url);
        });

        warmUrls.forEach((url) => {
          const img = new Image();
          img.src = url;
        });
      }
    })();
  </script>

  <script is:inline>
    (function () {
      const grid = document.querySelector('.ssr-grid');
      if (!grid) return;

      const cards = Array.from(grid.querySelectorAll('.ssr-card'));
      if (!cards.length) return;

      let activeRowTop = null;
      let hoveredCard = null;
      let collapseTimer = null;
      const ROW_TOLERANCE = 12;

      function getRowTopForCard(card) {
        return card.getBoundingClientRect().top;
      }

      function getRowCardsForTop(rowTop) {
        return cards.filter((c) => Math.abs(c.getBoundingClientRect().top - rowTop) <= ROW_TOLERANCE);
      }

      function clearActiveRow() {
        cards.forEach((c) => {
          c.classList.remove('row-active');
          c.classList.remove('card-hovered');
        });
        activeRowTop = null;
        hoveredCard = null;
      }

      function setHoveredCard(card) {
        if (hoveredCard === card) return;
        if (hoveredCard) hoveredCard.classList.remove('card-hovered');
        hoveredCard = card;
        if (card) card.classList.add('card-hovered');
      }

      function setActiveRowByCard(card) {
        if (!card) return;
        setHoveredCard(card);
        const rowTop = getRowTopForCard(card);
        if (activeRowTop !== null && Math.abs(activeRowTop - rowTop) <= ROW_TOLERANCE) return;
        activeRowTop = rowTop;
        cards.forEach((c) => c.classList.remove('row-active'));
        getRowCardsForTop(rowTop).forEach((c) => c.classList.add('row-active'));
      }

      function findCardForY(clientY) {
        for (const c of cards) {
          const rect = c.getBoundingClientRect();
          if (clientY >= rect.top - ROW_TOLERANCE && clientY <= rect.bottom + ROW_TOLERANCE) return c;
        }
        return null;
      }

      grid.addEventListener('mousemove', (e) => {
        clearTimeout(collapseTimer);
        let card = e.target.closest('.ssr-card') || findCardForY(e.clientY);
        if (card) setActiveRowByCard(card);
      });

      grid.addEventListener('mouseenter', () => clearTimeout(collapseTimer));
      grid.addEventListener('mouseleave', () => {
        collapseTimer = setTimeout(clearActiveRow, 180);
      });

      window.addEventListener('resize', clearActiveRow);
    })();
  </script>
</BaseLayout>
