---
export const prerender = true;

import CommercialDoorwayAllPage from "@/components/doorway/CommercialDoorwayAllPage.astro";
import { galleryData as cowboyColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as cowboyBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs";
import { galleryData as narrativeColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs";
import { galleryData as narrativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/ColorEntranceData.ts";
import { buildWesternPhotographyPrintsDock } from "@/data/Western-Photography-Prints/buildWesternPhotographyPrintsDock.ts";
import { westernPhotographyPrintsFAQ } from "@/data/Western-Photography-Prints/faq.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const pagePath = "/Western-Photography-Prints";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color";
const canonicalPath = pagePath;

const rotateGallery = (items: any[] = [], offset = 0) => {
  const cleanItems = items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  );
  if (cleanItems.length === 0) return cleanItems;
  const start = offset % cleanItems.length;
  return [...cleanItems.slice(start), ...cleanItems.slice(0, start)];
};

const narrativeColorItems = rotateGallery(narrativeColorData, 146);
const narrativeBlackWhiteItems = rotateGallery(narrativeBlackWhiteData, 77);
const cowboyColorItems = rotateGallery(cowboyColorData, 89);
const cowboyBlackWhiteItems = rotateGallery(cowboyBlackWhiteData, 58);
const breadcrumbHtml = [
  '<a href="/">Wayne Heim</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  "Western Photography Prints",
].join(" | ");

const breadcrumbStructuredItems = [
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
];

const { sectionDockItems, dockCenterIndex } = buildWesternPhotographyPrintsDock();

const gridSections = [
  {
    title: "Western Photography Prints - Color Frontier Scenes",
    description: "Color Western photography prints with frontier atmosphere, painterly light, and story-led presence for rooms and collectors.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/all#collection-browser",
    ctaLabel: "See the full color Western photography print collection",
    ctaThumb: "/img/i-B7ZSdfs/s.jpg",
    items: narrativeColorItems,
    limit: 19,
  },
  {
    title: "Black and White Western Photography Prints",
    description: "Monochrome Western photography prints where tonal restraint, frontier atmosphere, and contrast carry the story.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white Western photography print collection",
    ctaThumb: "/img/i-kp5NHNw/s.jpg",
    items: narrativeBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Cowboy Photography Prints - Color Western Portraits",
    description: "Color cowboy photography prints with painterly character, authored Western presence, and collector-ready print options.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/all#collection-browser",
    ctaLabel: "See the full color cowboy photography print collection",
    ctaThumb: "/img/i-5FX3W9r/s.jpg",
    items: cowboyColorItems,
    limit: 19,
  },
  {
    title: "Black and White Cowboy Photography Prints",
    description: "Black and white cowboy photography prints for collectors who want tonal weight, weathered character, and frontier restraint.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white cowboy photography print collection",
    ctaThumb: "/images/tombstones/cowboy-bw-ts.webp",
    items: cowboyBlackWhiteItems,
    limit: 19,
  },
];

const countLiveItems = (sections: typeof gridSections) =>
  sections.reduce((total, section) => total + section.items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  ).length, 0);
const westernPhotographyPrintsLiveCount = countLiveItems(gridSections);

const commercialMiddleCopy = [
  "Start with the photographic subject. For story-led frontier scenes, begin with the color or black and white Western narrative sections below. For portrait-led Western photography prints, continue into the cowboy portrait groupings.",
  "Western photography prints at K4 Studios are camera-based works shaped for collector-grade presentation. The page is built for buyers comparing authored Western photographs across subject, finish, format, and room presence.",
  "Each work begins as photography, then is shaped through Wayne Heim's painterly process into fine art with the mood, restraint, and presence of classic Western painting. Prints are available as archival paper and select wood presentations, with size and finish options inside each image page.",
].join("\n\n");

const copy = {
  seoTitle: "Western Photography Prints - Fine Art Photo Prints by Wayne Heim",
  seoDescription:
    "Western photography prints by Wayne Heim - frontier narratives, cowboy portraits, and painterly Western scenes from $25 through signed limited editions. Archival paper and select wood presentations for living rooms, offices, lodges, and collector walls.",
  indexDefinition:
    "Wayne Heim's Western photography prints include frontier narrative scenes, cowboy portraits, black and white Western photographs, and painterly character studies produced as collector-grade fine art prints.",
  indexLinkNote:
    "This is the K4 route for print-focused Western photography intent: Western photography prints, Western photo prints, cowboy photography prints, and collector-ready painterly Western photographs.",
  printAvailabilityNote: `Western photography prints are available from ${getFormattedLowestStandardPrintPrice()} across archival paper and select wood presentations. Edition status and format options are shown on individual image pages.`,
  commercialH1: "Four Print Routes Through the Western Collection",
  commercialDeck:
    "Four series, {catalogImageCount} works: frontier narratives, cowboy portraits, and painterly Western photographs in color and black and white - organized for print buyers, collectors, and interior decisions.",
  catalogEntranceTitle: "Western Photography Prints, Cowboy Portraits, and Frontier Photographs",
  catalogEntranceCopy:
    "Browse Western photography prints, Western photo prints, cowboy photography prints, and narrative frontier photographs created as collector-grade fine art.",
  collectionIntro: commercialMiddleCopy,
  breadcrumbCurrentName: "Western Photography Prints",
  aggregateOfferLowPrice: "25",
  aggregateOfferHighPrice: "5000",
  aggregateOfferCount: String(westernPhotographyPrintsLiveCount),
  gatewayCollectionName: "Western Photography Prints",
  gatewayIntroCopy:
    "Western photography prints are not only images to like. They are objects to choose, size, place, and live with.",
  gatewaySupportingCopy:
    `This page is the print-buying route. The question is not only which Western photograph is strongest, but which subject, tone, size, edition, and presentation will actually work on the wall. A narrative scene, a black and white study, a color cowboy portrait, and a monochrome character piece solve different collecting problems.\n\nWayne Heim's Western photographs begin as camera-made images, then are shaped through a painterly process into archival fine art prints with atmosphere, authorship, and room presence. The print matters because the final object has to carry the story beyond the screen.\n\nHere the format language matters because this is the print-buying page. Sketch Series pieces begin at ${getFormattedLowestStandardPrintPrice()} for smaller placements, while archival paper prints cover the standard wall-art route. Selected Chronicle and Legend editions add signature, numbering, and certificate for collectors. When a Western photograph needs more object presence than paper provides, certain images may also be available as Signature Engrained Series natural Baltic Birch panels.`,
  conceptBlock1Title: "THE PRINT-BUYING QUESTION",
  conceptBlock1Copy:
    "A print page has a practical job. It has to help the buyer compare image families before falling in love with a single piece. Color frontier narratives are the route when the wall needs story, atmosphere, warmth, and a scene that holds attention beyond the first glance.\n\nThese are not generic Western photo prints. They are finished fine art prints built around narrative pressure and collector presentation.",
  conceptBlock2Title: "THE MONOCHROME PRINT DECISION",
  conceptBlock2Copy:
    "Black and white Western photography prints are chosen for a different reason than color prints. They bring restraint, tonal contrast, and old-West atmosphere without adding more warmth to the room.\n\nUse this route when the wall needs gravity rather than color. Monochrome prints often integrate cleanly into offices, studies, lodges, and collector spaces where the image should feel permanent and quiet.",
  conceptBlock3Title: "THE PORTRAIT PRINT",
  conceptBlock3Copy:
    "Color cowboy photography prints work when the buyer wants human presence first. A portrait can anchor a wall because a person asks for a different kind of attention than a landscape or scene.\n\nThe print has to survive the move from screen to room. Wayne Heim's portrait work uses painterly light, weathered clothing, posture, and character so the finished print carries presence at distance and detail up close.",
  conceptBlock4Title: "THE TONAL CHARACTER PRINT",
  conceptBlock4Copy:
    "Black and white cowboy photography prints are the most restrained portrait option. They remove period warmth and leave face, hand, cloth, shadow, and tonal structure to do the work.\n\nChoose this route when the print needs to feel collected rather than decorative: a study wall, office, hallway, ranch interior, lodge corridor, or quiet collector space.",
  archiveContextTitle: "Browse Western Photography Prints",
  archiveContextCopy:
    "Western photography prints at K4 Studios are organized by four print-buying routes: color frontier scenes, black and white frontier scenes, color cowboy portraits, and black and white cowboy portraits.\n\nOpen an image when you are ready to compare the print object itself: size, paper presentation, edition status, certificate details where available, and the story behind the frame. Questions about format or size? Contact wayne@k4studios.com.",
  gatewayKicker: "K4 Studios - Western Photography Print Catalog",
  gatewayHeroTitle: "Western Photography Prints by Wayne Heim",
  gatewayHeroAlt:
    "Story-driven Western photography print candidate with frontier narrative atmosphere and painterly fine art finish.",
  gatewayHeroHref:
    "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/i-LCspRF4",
  gatewayHeroSrc: "/img/i-LCspRF4/m.jpg",
  gatewayHeroSrcSet: "/img/i-LCspRF4/s.jpg 400w, /img/i-LCspRF4/m.jpg 720w",
  faqKicker: "Print & Collector Questions",
  faqTitle: "Western Photography Prints FAQ",
};
---

<CommercialDoorwayAllPage
  rawGalleryData={narrativeColorItems}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Explore Western Photography Print Collections"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West",
    categoryName: "Wild West",
  }}
  identity={{
    collectionName: "Western Photography Prints",
    variantName: "Fine Art Prints",
    variantDescriptor: "western photography prints",
    gatewayBrandLabel: "Western Photography Prints - Fine Art Prints by Wayne Heim",
  }}
  copy={copy}
  faqItems={westernPhotographyPrintsFAQ}
  gridSections={gridSections}
  dockVariant="wall-art"
  layoutVariant="cinematic-concept-series-top"
/>
