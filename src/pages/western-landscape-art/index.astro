---
export const prerender = true;

import KeywordLandingPage from '@/components/doorway/KeywordLandingPage.astro';

import {
  pagePath,
  imageSectionPath,
  gridBasePath,
  galleryPaths,
  landing,
  breadcrumbItems,
  storyBlocks,
  explorationPaths,
  featuredReadingTitle,
  featuredReadingIntro,
  featuredReadingItems,
  collectionGroups,
  gridImages,
  collection,
  faqSection,
  faqItems,
  pageMeta,
  structuredAbout,
  webPageAbout,
  genre,
  collectionAltPrefix,
  hybridCarouselProps,
} from '@/data/hybrid-hubs/western-landscape-art.ts';

import { galleryData as mountainsGallery }
  from '@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains/Mountains.mjs';
---

<KeywordLandingPage
  pagePath={pagePath}
  imageSectionPath={imageSectionPath}
  gridBasePath={gridBasePath}
  galleryPaths={galleryPaths}
  landing={landing}
  breadcrumbItems={breadcrumbItems}
  storyBlocks={storyBlocks}
  faqItems={faqItems}
  explorationIntro="Western Landscape Discovery"
  explorationPaths={explorationPaths}
  featuredReadingTitle={featuredReadingTitle}
  featuredReadingIntro={featuredReadingIntro}
  featuredReadingItems={featuredReadingItems}
  collectionGroups={collectionGroups}
  gridImages={gridImages}
  collection={collection}
  faqSection={faqSection}
  galleryData={mountainsGallery}
  slides={[]}
  meta={{
    title: pageMeta.title,
    description: pageMeta.description,
    ogDescription: pageMeta.description,
  }}
  structuredAbout={structuredAbout}
  webPageAbout={webPageAbout}
  genre={genre}
  collectionAltPrefix={collectionAltPrefix}
  heroVisualMode="hybridCarousel"
  hybridCarouselProps={hybridCarouselProps}
/>