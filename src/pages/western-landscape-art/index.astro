---
export const prerender = true;

import CommercialDoorwayAllPage from "@/components/doorway/CommercialDoorwayAllPage.astro";
import { galleryData as westernLocationData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery.mjs";
import { galleryData as mountainData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains/Mountains.mjs";
import { galleryData as canadaData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Location/International/Canada-Western.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/ColorEntranceData.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";
import { faqItems as westernLandscapeArtFAQ } from "@/data/hybrid-hubs/western-landscape-art.ts";

const pagePath = "/western-landscape-art";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery";
const canonicalPath = pagePath;
const beyondFrameVideoWidget = {
  videoSlug: "only-path-forward",
  kicker: "Frontier stories come alive.",
  label: "60 seconds: Beyond the frame.",
  compact: true,
  withRules: true,
  ctaWidth: "17rem",
  ruleWidth: "100%",
};

const rotateGallery = (items: any[] = [], offset = 0) => {
  const cleanItems = items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    !['hidden', 'hide', 'ghost', 'non', 'none', ''].includes(String(item.visibility ?? 'show').trim().toLowerCase()) &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  );
  if (cleanItems.length === 0) return cleanItems;
  const start = offset % cleanItems.length;
  return [...cleanItems.slice(start), ...cleanItems.slice(0, start)];
};

const westernLocationItems = rotateGallery(westernLocationData, 0);
const mountainItems = rotateGallery(mountainData, 0);
const canadaItems = rotateGallery(canadaData, 0);

const breadcrumbHtml = [
  '<a href="/">Wayne Heim</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Landscapes">Landscapes</a>',
  "Western Landscape Art",
].join(" | ");

const breadcrumbStructuredItems = [
  { href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes", name: "Landscapes" },
];

const supportDockItem = (title: string, href: string, thumb: string, subtitle = "") => ({
  title,
  subtitle,
  href,
  thumb,
  cue: "Browse collection ->",
  dockRole: "support",
  dockPrefix: "",
});

const sectionDockItems = [
  supportDockItem(
    "Learn What Is Western Art",
    "/Blog/what-is-western-art",
    "/img/i-B7ZSdfs/s.jpg"
  ),
  supportDockItem(
    "Learn What Makes a Fine Art Print Worth Owning",
    "/Blog/what-makes-a-fine-art-print-worth-owning",
    "/images/tombstones/print-options-ts.webp"
  ),
  supportDockItem(
    "Compare Wood Prints and Paper Prints",
    "/Blog/wood-prints-vs-paper-prints",
    "/images/tombstones/engrained-ts.webp"
  ),
  supportDockItem(
    "Learn What Is Painterly Photography",
    "/Blog/what-is-painterly-photography",
    "/images/tombstones/Painterly-ts.webp"
  ),
  { separator: true, label: "Core Western landscape art collections" },
  {
    title: "Western Location Landscapes",
    href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery/all#collection-browser",
    thumb: "/img/i-G6gftd8/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    title: "Mountain Landscape Art",
    href: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains/all#collection-browser",
    thumb: "/img/i-b2hZptn/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    title: "Western Canada Landscapes",
    href: "/Galleries/Fine-Art-Photography/Landscapes/By-Location/International/Canada-Western",
    thumb: "/img/i-Nvn4r5N/s.jpg",
    cue: "Browse collection ->",
    dockRole: "core",
    dockPrefix: "",
  },
  { separator: true, label: "Landscape routes and collector notes" },
  supportDockItem(
    "Explore Painterly Landscapes",
    "/Galleries/Painterly-Fine-Art-Photography/Landscapes",
    "/img/i-zk7zXP3/s.jpg"
  ),
  supportDockItem(
    "Water and Waterfall Landscapes",
    "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Water",
    "/img/i-sm7MXM4/s.jpg"
  ),
  supportDockItem(
    "Learn How to Display Western Art at Home",
    "/Blog/how-to-display-western-art-in-a-modern-home",
    "/img/i-44jcjTQ/s.jpg"
  ),
  supportDockItem(
    "Compare Decor Art and Fine Art",
    "/Blog/decor-art-vs-fine-art",
    "/images/tombstones/traditional-ts.webp"
  ),
  supportDockItem(
    "Learn What Makes an Image Feel Cinematic",
    "/Blog/what-makes-an-image-feel-cinematic",
    "/img/i-WfrdxRR/s.jpg"
  ),
];
const dockCenterIndex = sectionDockItems.findIndex((item: any) => item.title === "Mountain Landscape Art");

const gridSections = [
  {
    title: "Western Landscape Art - American West Locations",
    description: "Start with American West landscapes when the wall needs air, horizon, weather, and the open-country pressure that makes the land feel active rather than scenic.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery/all#collection-browser",
    ctaLabel: "See the full Western landscape location collection",
    ctaThumb: "/img/i-G6gftd8/s.jpg",
    items: westernLocationItems,
    limit: 19,
  },
  {
    title: "Mountain Landscape Art",
    description: "Move into mountain landscape art when the room needs vertical scale: ridgelines, weather, shadow, snow, and peak forms strong enough to hold tall walls and lodge architecture.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Theme/Mountains/all#collection-browser",
    ctaLabel: "See the full mountain landscape collection",
    ctaThumb: "/img/i-b2hZptn/s.jpg",
    items: mountainItems,
    limit: 11,
  },
  {
    title: "Canadian Rockies Landscape Art",
    description: "Continue into the Canadian Rockies when the landscape needs a colder register: alpine lakes, waterfalls, northern distance, and Rocky Mountain country with a different kind of silence.",
    galleryPath: "/Galleries/Fine-Art-Photography/Landscapes/By-Location/International/Canada-Western",
    allHref: "/Galleries/Fine-Art-Photography/Landscapes/By-Location/International/Canada-Western",
    ctaLabel: "See the full Western Canada landscape collection",
    ctaThumb: "/img/i-Nvn4r5N/s.jpg",
    items: canadaItems,
    limit: 19,
  },
];

const countLiveItems = (sections: typeof gridSections) =>
  sections.reduce((total, section) => total + section.items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    !['hidden', 'hide', 'ghost', 'non', 'none', ''].includes(String(item.visibility ?? 'show').trim().toLowerCase()) &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  ).length, 0);
const westernLandscapeArtLiveCount = countLiveItems(gridSections);

const commercialMiddleCopy = [
  "Western landscape art at K4 Studios is built around place as presence: open country, mountain weather, Canadian Rockies distance, and the visual pressure of land that does more than sit behind the story.",
  "Start with American West location landscapes for horizon, atmosphere, and the scale of open country. Move into mountain landscape art when the wall needs height, weather, and architectural force. Continue into the Canada gallery for Banff, Jasper, alpine water, and the colder northern distance that no American West view quite matches.",
  "Use the image pages to compare print format, scale, available editions, and the story attached to each landscape.",
].join("\n\n");

const copy = {
  seoTitle: "Western Landscape Art - American West & Mountain Fine Art Prints",
  seoDescription:
    "Western landscape art prints by Wayne Heim. American West open country, mountain landscape prints, and Canadian Rockies fine art photography for homes, lodges, offices, and collector walls.",
  indexDefinition:
    "Wayne Heim's Western landscape art includes American West location landscapes, mountain landscape art prints, and Canadian Rockies photographs created as collector-grade fine art prints.",
  indexLinkNote:
    "Explore Western landscape art, Western landscape wall art, mountain landscape prints, and Canadian Rockies fine art photography shaped for rooms, collectors, and quiet scale.",
  printAvailabilityNote: `Western landscape art prints are available from ${getFormattedLowestStandardPrintPrice()} across archival paper and select wood presentations. Edition status and format options are shown on individual image pages.`,
  commercialH1: "Three Ways the Western Land Holds a Wall",
  commercialDeck:
    "{catalogImageCount} works across three landscape routes: American West open country, mountain landscape art, and Canadian Rockies photographs organized for rooms that need distance, scale, weather, and quiet authority.",
  catalogEntranceTitle: "Western Landscape Art, Mountain Prints, and Canadian Rockies Fine Art",
  catalogEntranceCopy:
    "Browse Western landscape art prints, mountain landscape photography, American West location work, and Western Canada landscapes created as collector-grade fine art.",
  collectionIntro: commercialMiddleCopy,
  breadcrumbCurrentName: "Western Landscape Art",
  aggregateOfferLowPrice: "25",
  aggregateOfferHighPrice: "5000",
  aggregateOfferCount: String(westernLandscapeArtLiveCount),
  gatewayCollectionName: "Western Landscape Art",
  gatewayIntroCopy:
    "Western landscape art is not scenery when the land is doing real work.",
  gatewaySupportingCopy:
    `A weak landscape photograph shows a beautiful place and stops there. A stronger Western landscape keeps acting after recognition. The horizon changes the pace of the room. Weather changes the emotional temperature. A mountain form gives a wall structure. Water and alpine distance alter the silence around the image.\n\nWayne Heim's Western landscape art begins with real terrain, then moves through a painterly finishing process that shapes atmosphere, tonal depth, edge, weather, and distance into finished fine art. The land is not a backdrop for a cowboy story. It is the pressure that makes the West feel like the West: scale, exposure, isolation, endurance, and the quiet authority of geography.\n\nFor collectors, designers, lodge owners, mountain homes, ranch interiors, offices, and hospitality spaces, landscape work solves a different problem than portrait or narrative art. It opens the room. Sketch Series prints begin at ${getFormattedLowestStandardPrintPrice()} for smaller placements; larger archival paper editions carry the wall; selected limited editions add signature, numbering, and certificate when a landscape needs collector permanence. Some images may also suit Signature Engrained Series natural Baltic Birch panels when the material surface strengthens the land's physical presence.`,
  conceptBlock1Title: "THE LAND AS PRESSURE",
  conceptBlock1Copy:
    "Western landscape art begins where the land stops behaving like background. Open country is not empty. It creates exposure, distance, silence, and the feeling that the human story has to answer to something larger than itself.\n\nThe American West location landscapes below are the broadest expression of that idea: horizon, weather, fields, roads, ridges, and long views that give a room air without making the work feel decorative. They belong where the wall needs space to breathe.",
  conceptBlock2Title: "THE VERTICAL WALL",
  conceptBlock2Copy:
    "Mountain landscape art solves a different visual problem. Open country stretches outward; mountains push upward. That makes them useful for fireplace walls, stairwells, great rooms, lodge entries, offices, and rooms where the architecture already has height.\n\nThe mountain works below are built around form, weather, ridgeline, snow, shadow, and distance. They carry scale without needing human figures, and they can make a large wall feel intentional rather than merely filled.",
  conceptBlock3Title: "THE NORTHERN REGISTER",
  conceptBlock3Copy:
    "Canadian Rockies landscape art changes the temperature of the page. Banff, Jasper, alpine lakes, waterfalls, and northern mountain country carry a quieter, colder register than much of the American West.\n\nThese works are useful when the room needs landscape presence with more water, reflection, stone, and high-country silence. They still belong to the larger Western landscape conversation, but they arrive from a different edge of it.",
  archiveContextTitle: "Browse the Western Landscape Art Collection",
  gatewayKicker: "K4 Studios - Western Landscape Fine Art Print Catalog",
  gatewayHeroTitle: "Western Landscape Art by Wayne Heim",
  gatewayHeroAlt:
    "Western landscape art print with open country, mountain distance, and painterly fine art atmosphere.",
  gatewayHeroHref:
    "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/West/Gallery/i-G6gftd8",
  gatewayHeroSrc: "/img/i-G6gftd8/m.jpg",
  gatewayHeroSrcSet: "/img/i-G6gftd8/s.jpg 400w, /img/i-G6gftd8/m.jpg 720w",
  archiveContextCopy:
    "Western landscape art at K4 Studios is organized by the kind of space the wall needs: American West horizon and atmosphere, mountain scale and weather, or Canadian Rockies water, stone, and northern distance.\n\nOpen any image to read its story, compare available sizes and print formats, and check edition details. Questions about a specific landscape, wall size, or room mockup? Contact wayne@k4studios.com.",
  faqKicker: "Print & Collector Questions",
  faqTitle: "Western Landscape Art FAQ",
};
---

<CommercialDoorwayAllPage
  rawGalleryData={westernLocationItems}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Explore Western Landscape Art Collections"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Landscapes",
    categoryName: "Landscapes",
  }}
  identity={{
    collectionName: "Western Landscape Art",
    variantName: "Fine Art Prints",
    variantDescriptor: "western landscape art",
    gatewayBrandLabel: "Western Landscape Art - Fine Art Prints by Wayne Heim",
  }}
  copy={copy}
  faqItems={westernLandscapeArtFAQ}
  gridSections={gridSections}
  gatewayVideoWidget={beyondFrameVideoWidget}
  dockVariant="wall-art"
  layoutVariant="cinematic-concept-series-top"
/>
