---
export const prerender = true;
import BaseLayout         from '@/layouts/BaseLayout.astro';
import { getSemanticImageUrl, normalizeImageSrc } from "@/utils/imageProxy.js";
import LandingHeader      from '@/components/Landing-Header.jsx';
import TombstoneNav       from '@/components/TombstoneNav.jsx';
import CollectionDock     from '@/components/doorway/CollectionDock.astro';
import LandingRightImages from '@/components/LandingRightImages.jsx';
import FAQAccordion       from '@/components/FAQAccordion.jsx';
import SiteFooter         from '@/components/Footer.astro';
import MobileStoryImages  from '@/components/MobileStoryImages.jsx';
import StorySlider        from '@/components/StorySlider.tsx';
import HybridBookCarousel from '@/components/hybrid/HybridBookCarousel.jsx';
import { sanitizeCarouselForClient, sanitizeForClient } from '@/components/utils/normalizeImage.ts';

import {
  cowboyColorDataFull,
  cowboyBWData,
  westernNarrativesColorData,
  westernNarrativesBWData,
  westernNAColorData as cowboyNAData,
} from '@/data/carousel/westernLandingContent.ts';
import { storySliderImageIds } from '@/data/storySlider.ts';

import { getStructuredData, getBreadcrumbList } from '@/components/utils/getStructuredData.ts';
import { getLandingMeta } from '@/data/landingMeta.ts';

import { siteNav } from '@/data/siteNav.ts';
import { getOrderedWesternGalleryPaths } from '@/data/carousel/westernRouting.ts';
import { getFeatheredImages } from '@/components/utils/getFeatheredImages.ts';
import { autoLinkKeywordsInText } from '@/components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '@/data/semantic/K4-Sem.ts';
import { westernArtistAttributionHtml } from '@/data/wayneEntity.js';

import { landingNarrativeWesternArt }
  from '@/data/Narrative-Western-Art/landingstones.ts';
import { narrativeWesternArtStory }
  from '@/data/Narrative-Western-Art/story.ts';
import { narrativeWesternArtFAQ }
  from '@/data/Narrative-Western-Art/faq.ts';

import '@/styles/global.css';
import '@/styles/oneupheader.css';

const pagePath = "/Narrative-Western-Art";
const openingDefinition = [
  "Narrative Western art is a form of Western art that tells stories of the American West through frontier life, historical events, and cultural experience rather than simple representation. It may also be described as storytelling in Western art or Western narrative art, but the core idea is the same: a still image carries the pressure of a larger story.",
  "Rather than functioning as a sealed statement, narrative Western art presents a moment within something larger, often shaped by history, myth, labor, memory, and consequence. The strongest examples feel like an ongoing story rather than a complete declaration, implying what happened before the frame and what may come after it.",
  "Traditionally, this approach has been expressed through painting and illustration, where artists like Charles Russell and Frederic Remington used composition, gesture, and setting to convey story within a single frame. Today, narrative Western art continues that tradition across both traditional and modern mediums, exploring the people, conflicts, and lived realities of the American West through story.",
  "Narrative Western art is not just a style. It is a way of seeing the American West through story, and at its best it opens outward into what led to the moment and what may follow from it."
];

const signatureThesisLine = "Before the legend came the lives that built it.";

const imageSectionPath =
  "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits";

const carouselGalleryBasePath =
  "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color";

const carouselLinkMap: Record<string, string> = {
  color: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color",
  bw: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White",
  cowboy: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color",
  na: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color",
};

const curatedSampleIds = [
  'i-rRdrQBg',
  'i-4Hz6D7k',
  'i-89qzJ6S',
  'i-LmpRvHw',
  'i-qMQf7b6',
  'i-HfQ5NVR',
  'i-LCspRF4',
  'i-7Mzzbvp',
];

function ensureAlt(img: any) {
  const base = (img?.alt || img?.title || '').trim();
  if (!base) return 'Narrative Western art by Wayne Heim';
  if (!img?.alt) return `${base} — narrative Western art by Wayne Heim`;
  return base;
}

function topRated(data: any[], count: number, skipCount: number = 0) {
  return data
    .filter((img: any) => img.visibility !== 'ghost' && img.id !== 'i-k4studios' && img.rating >= 4)
    .sort((a: any, b: any) => a.sortOrder - b.sortOrder)
    .slice(skipCount, skipCount + count);
}

const carouselSlides = [
  ...topRated(westernNarrativesColorData, 2, 0).map((img: any) => ({
    id: img.id,
    title: img.title,
    alt: ensureAlt(img),
    story: img.story || '',
    href: `${carouselLinkMap.color}/${img.id}`,
  })),
  ...topRated(westernNarrativesBWData, 2, 0).map((img: any) => ({
    id: img.id,
    title: img.title,
    alt: ensureAlt(img),
    story: img.story || '',
    href: `${carouselLinkMap.bw}/${img.id}`,
  })),
  ...topRated(cowboyColorDataFull, 1, 8).map((img: any) => ({
    id: img.id,
    title: img.title,
    alt: ensureAlt(img),
    story: img.story || '',
    href: `${carouselLinkMap.cowboy}/${img.id}`,
  })),
  ...topRated(cowboyNAData, 2, 5).map((img: any) => ({
    id: img.id,
    title: img.title,
    alt: ensureAlt(img),
    story: img.story || '',
    href: `${carouselLinkMap.na}/${img.id}`,
  })),
];

const carouselIds = new Set(carouselSlides.map((img: any) => img.id));

const cowboyColorData = cowboyColorDataFull
  .filter((img: any) => storySliderImageIds.includes(img.id))
  .map((img: any) => ({ id: img.id, title: img.title, story: img.story }));

function findNavEntry(nav: any[], url: string): any | null {
  for (const entry of nav) {
    if (entry.href === url) return entry;
    if (entry.children) {
      const found = findNavEntry(entry.children, url);
      if (found) return found;
    }
  }
  return null;
}

const galleryPaths: string[] = getOrderedWesternGalleryPaths(imageSectionPath);

const allGalleryData = import.meta.glob('../../data/Galleries/**/*.mjs', { eager: true }) as any;
const galleryDatas = galleryPaths.map((path) => {
  const filePath = "../../data/Galleries" + path.replace(/^\/Galleries/, "") + ".mjs";
  return allGalleryData[filePath]?.galleryData || [];
});

const headingCount = narrativeWesternArtStory.filter((block: any, i: number) => i > 0 && block.subhead).length;

const landingDescription =
  landingNarrativeWesternArt.subtitle || '';

const featheredImages = getFeatheredImages({
  sectionPath: imageSectionPath,
  headingCount: Math.max(headingCount, 9),
  galleryDatas,
  galleryPaths,
  minRating: 3,
  fallbackMin: 1,
  poolMultiplier: 3
});

const topSampleImages = featheredImages.filter((img: any) => !carouselIds.has(img.id));
const reorderedSampleImages = [...topSampleImages].sort((a: any, b: any) => {
  const aIndex = curatedSampleIds.indexOf(a.id);
  const bIndex = curatedSampleIds.indexOf(b.id);
  const aRank = aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex;
  const bRank = bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex;
  return aRank - bRank;
});
const sampleImages = reorderedSampleImages.length >= 6 ? reorderedSampleImages : featheredImages;

const carouselSlidesClient = sanitizeCarouselForClient(carouselSlides.map((slide: any) => ({ ...slide }))) as any;
const carouselProps = {
  slides: carouselSlidesClient,
  galleryBasePath: carouselGalleryBasePath,
  kicker: "Story Lives Here",
  counterLabel: "Scene",
} as any;
const storySliderStoriesClient = cowboyColorData.map((story: any) => ({ ...story })) as any;
const storySliderProps: any = {
  stories: storySliderStoriesClient,
  galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color",
  variant: "secondary",
};
const mobileStoryImagesClient = sanitizeForClient(
  sampleImages.map((image: any) => ({ ...image }))
) as any;
const sidebarImagesClient = sanitizeForClient(sampleImages.map((image: any) => ({ ...image }))) as any;
const mobileStoryImageProps = {
  images: mobileStoryImagesClient,
  displayCount: headingCount,
} as any;
const sidebarImageProps = {
  heading: "Collection Samples",
  images: sidebarImagesClient,
  displayCount: 6,
} as any;

const narrativeDockItems = [
  {
    title: "See Narrative Western Art vs Traditional Western Art",
    href: "/Blog/narrative-western-art-vs-traditional",
    thumb: "/img/i-B7ZSdfs/s.jpg",
    dockRole: "support",
    dockPrefix: "",
  },
  {
    title: "See What Makes an Image Feel Cinematic",
    href: "/Blog/what-makes-an-image-feel-cinematic",
    thumb: "/img/i-kp5NHNw/s.jpg",
    dockRole: "support",
    dockPrefix: "",
  },
  {
    title: "See How Photography Becomes Narrative Western Art",
    href: "/Blog/can-photography-be-narrative-western-art",
    thumb: "/img/i-HfQ5NVR/s.jpg",
    dockRole: "support",
    dockPrefix: "",
  },
  {
    separator: true,
    label: "Core narrative Western art collections",
  },
  {
    title: "Explore Western Storytelling Photography",
    href: "/western-storytelling-photography",
    thumb: "/img/i-B7ZSdfs/s.jpg",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    title: "Explore Color Western Narrative Prints",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/all#collection-browser",
    thumb: "/img/i-89qzJ6S/s.jpg",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    title: "Explore Black and White Western Narrative Prints",
    href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    thumb: "/img/i-mqQxwNn/s.jpg",
    dockRole: "core",
    dockPrefix: "",
  },
  {
    separator: true,
    label: "Related narrative routes",
  },
  {
    title: "Explore What Is Narrative Photography",
    href: "/Blog/what-is-narrative-photography",
    thumb: "/img/i-qMQf7b6/s.jpg",
    dockRole: "support",
    dockPrefix: "",
  },
  {
    title: "Explore What Is the One-Image Movie",
    href: "/Other/One-Image-Movie",
    thumb: "/img/i-6Ffpw9t/s.jpg",
    dockRole: "support",
    dockPrefix: "",
  },
  {
    title: "Explore What Is Visual Storytelling in Photography",
    href: "/Blog/what-is-visual-storytelling-in-photography",
    thumb: "/img/i-5FX3W9r/s.jpg",
    dockRole: "support",
    dockPrefix: "",
  },
];

const narrativeDockCenterIndex = narrativeDockItems.findIndex((item: any) => item.title === "Western Storytelling Photography");

const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingNarrativeWesternArt.title,
    description: landingDescription,
    url: `https://www.k4studios.com${pagePath}`,
    keywords: landingNarrativeWesternArt.keywords || [],
    copyrightNotice: "© Wayne Heim",
    about: [
      { "@type": "Thing", name: "Narrative Western Art" },
      { "@type": "Thing", name: "Western Narrative Art" },
      { "@type": "Thing", name: "Story-Driven Western Art" },
      { "@type": "Thing", name: "Cowboy Narrative Art" },
      { "@type": "Thing", name: "Western Art Storytelling" },
      { "@type": "Thing", name: "Painterly Photography" },
    ],
    genre: "Narrative Western Art",
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://www.k4studios.com/copyright",
    acquireLicensePage: "https://www.k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://www.k4studios.com/"
  }
});

const breadcrumbData = getBreadcrumbList([
  { name: "Home", item: "https://www.k4studios.com/" },
  { name: "Narrative Western Art", item: `https://www.k4studios.com${pagePath}` },
]);

const stripHtml = (text: string) => text.replace(/<[^>]*>/g, '').trim();

const faqStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `https://www.k4studios.com${pagePath}#faq`,
  mainEntity: narrativeWesternArtFAQ.slice(0, 10).map((item: any) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: stripHtml(Array.isArray(item.a) ? item.a.join(" ") : item.a),
    },
  })),
}, null, 2);

const webPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `https://www.k4studios.com${pagePath}#webpage`,
  url: `https://www.k4studios.com${pagePath}`,
  name: "Narrative Western Art",
  description: "Narrative Western art by Wayne Heim—story-driven painterly photography interpreting the people, atmosphere, and implied drama of the American West.",
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    "@id": "https://www.k4studios.com/#website",
    name: "K4 Studios",
    url: "https://www.k4studios.com/"
  },
  about: [
    { "@type": "Thing", name: "Narrative Western Art" },
    { "@type": "Thing", name: "Western Narrative Art" },
    { "@type": "Thing", name: "Story-Driven Western Art" },
    { "@type": "Thing", name: "One-Image Movie" }
  ],
  author: { "@type": "Person", "@id": "https://www.k4studios.com/#person", name: "Wayne Heim", url: "https://www.k4studios.com/Other/Bio" },
  creator: { "@type": "Person", "@id": "https://www.k4studios.com/#person", name: "Wayne Heim", url: "https://www.k4studios.com/Other/Bio" },
  copyrightHolder: { "@type": "Person", "@id": "https://www.k4studios.com/#person", name: "Wayne Heim", url: "https://www.k4studios.com/Other/Bio" },
  mainEntity: { "@id": `https://www.k4studios.com${pagePath}#imagegallery` },
}, null, 2);

function makeAbsoluteUrl(src?: string) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) return src;
  return `https://www.k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return getSemanticImageUrl(imageId, {}, size);
}

const landingImg = featheredImages[0];
const landingImgUrl = landingImg?.id ? makeAbsoluteUrl(getProxySrc(landingImg.id, 'l')) : '';

const meta = getLandingMeta(pagePath, landingImgUrl);
if (!meta.ogUrl) meta.ogUrl = `https://www.k4studios.com${pagePath}`;
if (!meta.twitterUrl) meta.twitterUrl = `https://www.k4studios.com${pagePath}`;

function getTombstoneThumbs(galleryData: any[]): string[] {
  const validImages = galleryData
    .filter((img: any) => img.id !== 'i-k4studios' && img.visibility !== 'ghost')
    .slice(0, 10);
  return validImages
    .map((img: any) => img.id ? getProxySrc(img.id, 's') : '')
    .filter((src: string) => src !== '');
}

const tombstoneGalleryMap: Record<string, any[]> = {
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color': cowboyColorDataFull,
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White': cowboyBWData,
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color': cowboyNAData,
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color': westernNarrativesColorData,
  '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White': westernNarrativesBWData,
};

const tombstonesWithThumbs = landingNarrativeWesternArt.tombstones.map((stone: any) => {
  if (stone.thumb) {
    const thumb = normalizeImageSrc(stone.thumb, 's');
    return { ...stone, thumb, thumbs: [thumb] };
  }
  const galleryData = tombstoneGalleryMap[stone._thumbSource || stone.href];
  const thumbs = galleryData ? getTombstoneThumbs(galleryData) : [];
  return {
    ...stone,
    thumb: thumbs[0] || '',
    thumbs,
  };
});
---

<BaseLayout
  title="Narrative Western Art – Wayne Heim | K4 Studios"
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbData}
  meta={meta}
>
  <script type="application/ld+json" set:html={faqStructuredData} slot="head"></script>
  <script type="application/ld+json" set:html={webPageSchema} slot="head"></script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Narrative Western Art: Story-Driven Painterly Art of the American West",
    "author": {
      "@type": "Person",
      "name": "Wayne Heim"
    },
    "publisher": {
      "@type": "Organization",
      "name": "K4 Studios",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.k4studios.com/images/k4-logo.png"
      }
    },
    "description": "Narrative Western art is a form of Western art that tells stories of the American West through frontier life, historical experience, and visual storytelling rather than subject matter alone.",
    "mainEntityOfPage": "https://www.k4studios.com/Narrative-Western-Art"
  }
  </script>

  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingNarrativeWesternArt.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingNarrativeWesternArt.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4">
      <div class="hero-carousel-section reveal-on-scroll">
        <HybridBookCarousel
          client:load
          {...carouselProps}
        />
      </div>
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">{landingNarrativeWesternArt.title}</h1>
        <p class="page-context-link fade-in reveal-on-scroll" style="margin-top:0.75rem; margin-bottom:0.25rem; font-weight:600;">
          Narrative Western Art — Definition, Meaning, and Examples
        </p>
        <h2 class="page-subtitle fade-in reveal-on-scroll">{landingNarrativeWesternArt.subtitle}</h2>
        <div class="page-summary fade-in reveal-on-scroll">
          {openingDefinition.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p set:html={westernArtistAttributionHtml} />
          <p>For the artist authority page behind this narrative body of work, see <a href="/wayne-heim-western-fine-art-photography">Wayne Heim</a>.</p>
          <p>For concise companion guides tied to this collection, see <a href="/western-storytelling-photography">Western Storytelling Photography</a>, <a href="/cinematic-western-art">Cinematic Western Art</a>, and <a href="/cowboy-art-prints">Cowboy Art Prints</a>.</p>
        </div>
      </div>
    </section>

    <section class="collections-nav-section">
      <h3 class="collections-heading fade-in reveal-on-scroll">Explore the Narrative Collection</h3>
      <p class="collections-context fade-in reveal-on-scroll">
        These collections provide real examples of narrative Western art in practice.
      </p>
      <TombstoneNav client:load items={tombstonesWithThumbs} />
    </section>

    <section class="story-layout">
      <div class="text-column">
        <section class="story-section">
          {narrativeWesternArtStory.map((section: any, index: number) => (
            <article class="story-block">
              {section.title && (
                <h2 class="slide-in-left" set:html={autoLinkKeywordsInText(section.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}
              {section.subhead && (
                <h3 class="slide-in-left" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}
              {section.tagline && (
                <h4 class="tagline reveal-on-scroll" set:html={autoLinkKeywordsInText(section.tagline, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
              )}

              {section.paragraphs?.map((para: string) => (
                <p
                  class:list={[
                    'reveal-on-scroll',
                    para === signatureThesisLine && 'signature-thesis-line'
                  ]}
                  set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)}
                />
              ))}

              {section.list && section.list.length > 0 && (
                <ul>
                  {section.list.map((item: string) => (
                    <li class="reveal-on-scroll" set:html={autoLinkKeywordsInText(item, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
                  ))}
                </ul>
              )}

              {(section.title === "Narrative Time in Western Art" || section.subhead === "Narrative Time in Western Art") && (
                <div class="story-slider-wrapper reveal-on-scroll mt-6">
                  <div class="story-slider-skeleton relative bg-[#f4f1ec] rounded-lg shadow-sm px-5 py-4 max-w-xl mx-auto border border-[#e0d9cf] mb-8 h-[240px] overflow-hidden opacity-90">
                    <p class="text-[10px] uppercase tracking-[0.12em] text-[#a09080] mb-3">How Story Lives in These Images</p>
                    <div class="animate-pulse">
                      <div class="h-4 bg-[#e0d9cf] rounded w-3/4 mb-3"></div>
                      <div class="h-3.5 bg-[#e0d9cf] rounded w-full mb-2"></div>
                      <div class="h-3.5 bg-[#e0d9cf] rounded w-5/6 mb-2"></div>
                      <div class="h-3.5 bg-[#e0d9cf] rounded w-4/6"></div>
                    </div>
                  </div>

                  <StorySlider client:only="react" {...storySliderProps} />

                  <p class="story-slider-caption reveal-on-scroll">
                    See how a single image can suggest<br />an entire Western story beyond the frame.
                  </p>
                </div>
              )}

              {section.subhead === "Character Before Spectacle" && (
                <div class="story-chapter-divider reveal-on-scroll" aria-hidden="true"></div>
              )}
            </article>
          ))}
        </section>

        <MobileStoryImages client:only="react" {...mobileStoryImageProps} />
      </div>

      <div class="sidebar-column hidden md:block">
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages client:load {...sidebarImageProps} />
        </div>
      </div>
    </section>

    <CollectionDock
      id="narrative-western-art-dock"
      items={narrativeDockItems}
      currentTitle="Explore Narrative Western Art"
      centerIndex={narrativeDockCenterIndex}
      variant="wall-art"
      ariaLabel="Narrative Western Art quick links"
    />

    <section class="pb-10">
      <input type="checkbox" id="faq-toggle" class="more-toggle" />
      <div class="truncate-container" style="min-height:0;">
        <div class="truncate-text">
          <FAQAccordion items={narrativeWesternArtFAQ} />
        </div>
      </div>
      <label for="faq-toggle" class="more-toggle-label"></label>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }

      const faqToggle = document.getElementById("faq-toggle");
      const truncateContainer = document.querySelector(".truncate-container");
      if (truncateContainer && faqToggle) {
        truncateContainer.addEventListener("click", (e) => {
          const summaryClicked = e.target.closest("summary");
          if (summaryClicked && !faqToggle.checked) faqToggle.checked = true;
        });
      }
    });
  </script>

