---
export const prerender = true;

import CommercialDoorwayAllPage from "@/components/doorway/CommercialDoorwayAllPage.astro";
import { galleryData as cowboyColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color.mjs";
import { galleryData as cowboyBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White.mjs";
import { galleryData as narrativeColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs";
import { galleryData as narrativeBlackWhiteData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White.mjs";
import { galleryData as nativeColorData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color.mjs";
import { entranceData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/ColorEntranceData.ts";
import { buildWesternPhotographyArtDock } from "@/data/Western-Photography-Art/buildWesternPhotographyArtDock.ts";
import { westernArtFAQ } from "@/data/Western-Photography-Art/faq.ts";
import { getFormattedLowestStandardPrintPrice } from "@/data/pricing/printSeries.js";

const pagePath = "/Western-Photography-Art";
const basePath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color";
const canonicalPath = pagePath;

const rotateGallery = (items: any[] = [], offset = 0) => {
  const cleanItems = items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  );
  if (cleanItems.length === 0) return cleanItems;
  const start = offset % cleanItems.length;
  return [...cleanItems.slice(start), ...cleanItems.slice(0, start)];
};

const narrativeColorItems = rotateGallery(narrativeColorData, 171);
const narrativeBlackWhiteItems = rotateGallery(narrativeBlackWhiteData, 93);
const cowboyColorItems = rotateGallery(cowboyColorData, 111);
const cowboyBlackWhiteItems = rotateGallery(cowboyBlackWhiteData, 71);
const nativeColorItems = rotateGallery(nativeColorData, 12);
const breadcrumbHtml = [
  '<a href="/">Wayne Heim</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History">Facing History</a>',
  '<a href="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West">Wild West</a>',
  "Western Photography Art",
].join(" | ");

const breadcrumbStructuredItems = [
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History", name: "Facing History" },
  { href: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West", name: "Wild West" },
];

const { sectionDockItems, dockCenterIndex } = buildWesternPhotographyArtDock();

const gridSections = [
  {
    title: "Western Photography Art - Color Frontier Narratives",
    description: "Color Western photography art built around frontier atmosphere, painterly light, and story pressure that carries beyond the frame.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color/all#collection-browser",
    ctaLabel: "See the full color Western narrative art collection",
    ctaThumb: "/img/i-B7ZSdfs/s.jpg",
    items: narrativeColorItems,
    limit: 19,
  },
  {
    title: "Black and White Western Photography Art",
    description: "Monochrome Western photography art where tonal restraint, old West atmosphere, and contrast carry the story.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white Western narrative art collection",
    ctaThumb: "/img/i-kp5NHNw/s.jpg",
    items: narrativeBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Cowboy Photography Art - Color Western Portraits",
    description: "Color cowboy photography art with painterly character, authored presence, and room-ready Western gravity.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Color/all#collection-browser",
    ctaLabel: "See the full color cowboy photography art collection",
    ctaThumb: "/img/i-5FX3W9r/s.jpg",
    items: cowboyColorItems,
    limit: 19,
  },
  {
    title: "Black and White Cowboy Photography Art",
    description: "Black and white cowboy photography art for collectors who want weathered character, tonal weight, and frontier restraint.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/Black-White/all#collection-browser",
    ctaLabel: "See the full black and white cowboy photography art collection",
    ctaThumb: "/images/tombstones/cowboy-bw-ts.webp",
    items: cowboyBlackWhiteItems,
    limit: 19,
  },
  {
    title: "Native American Western Photography Art",
    description: "Historically grounded Native American portrait work shaped with painterly restraint, human presence, and authored respect.",
    galleryPath: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color",
    allHref: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color/all#collection-browser",
    ctaLabel: "See the full Native American Western photography art collection",
    ctaThumb: "/img/i-LCspRF4/s.jpg",
    items: nativeColorItems,
    limit: 19,
  },
];

const countLiveItems = (sections: typeof gridSections) =>
  sections.reduce((total, section) => total + section.items.filter((item: any) =>
    item?.id &&
    item.id !== "i-k4studios" &&
    item.visibility !== "ghost" &&
    item.visibility !== "hidden" &&
    item.visibility !== "hide"
  ).length, 0);
const westernPhotographyArtLiveCount = countLiveItems(gridSections);

const commercialMiddleCopy = [
  "Western photography art names the place where photographic truth meets the older Western art tradition - where a camera-made image carries the authored presence of painting. Start with the subject family below: frontier narrative, cowboy portrait, monochrome atmosphere, or Native American portrait work.",
  "K4 Studios treats the camera as the beginning, not the end. Wayne Heim's images are shaped through painterly process, tonal control, authored titles, and story structure so each finished work carries the presence of art rather than simple photographic record.",
  "These works are available as archival paper and select wood presentations, with the Sketch Series opening at $25 and limited editions available for collectors who want provenance, permanence, and wall presence.",
].join("\n\n");

const copy = {
  seoTitle: "Western Photography Art - Fine Art Prints by Wayne Heim | K4 Studios",
  seoDescription:
    "Western photography art by Wayne Heim - frontier narratives, cowboy portraits, and Native American portrait work shaped through painterly process into collector-grade fine art. Archival prints from $25 through signed limited editions.",
  indexDefinition:
    "Western photography art is authored photographic work that interprets the American West through painterly craft, narrative intent, historical awareness, and collector-grade presentation.",
  indexLinkNote:
    "This is the K4 route for Western photography art, Western art photography, cowboy art photography, frontier photography art, and painterly Western fine art prints.",
  printAvailabilityNote: `Western photography art is available from ${getFormattedLowestStandardPrintPrice()} across archival paper and select wood presentations. Edition status and format options are shown on individual image pages.`,
  commercialH1: "The Collection - Five Subject Series, 840+ Works",
  commercialDeck:
    "Frontier narratives, cowboy portraits, Native American portrait work, and painterly Western photographs in color and black and white.",
  catalogEntranceTitle: "Western Photography Art, Cowboy Portraits, and Frontier Stories",
  catalogEntranceCopy:
    "Browse Western photography art, Western art photography, cowboy portrait art, and narrative frontier imagery created as collector-grade fine art.",
  collectionIntro: commercialMiddleCopy,
  breadcrumbCurrentName: "Western Photography Art",
  aggregateOfferLowPrice: "25",
  aggregateOfferHighPrice: "5000",
  aggregateOfferCount: String(westernPhotographyArtLiveCount),
  gatewayCollectionName: "Western Photography Art",
  gatewayIntroCopy:
    "Western photography art by Wayne Heim, available as archival fine art prints ranging from the small-works introductory Sketch Series at $25 to the ultra-limited, large-format Legend Series for collectors seeking statement pieces with permanence and presence. Frontier narratives, cowboy portraits, Western character studies, Native American portrait work, and story-driven imagery for homes, offices, lodges, ranch interiors, hospitality spaces, and collector walls.",
  gatewaySupportingCopy:
    "Each section is organized by subject, mood, and finish - color or black and white - so you can compare the right Western art photography path before reading into the image story. The collection begins with the small-works Sketch Series, intimate 5×7 open edition pieces priced at $25, then scales through open-edition Foundation works, signed Chronicle editions, and ultra-limited Legend pieces for collectors who want provenance and permanence on the wall.\n\nClick into any section to compare prints, read the image story, and view collector and sizing details.",
  gatewayKicker: "K4 Studios - Western Photography Art Catalog",
  gatewayHeroTitle: "Western Photography Art by Wayne Heim",
  gatewayHeroAlt:
    "Native American rider in painterly Western photography art with open land, atmospheric sky, and authored fine art presence.",
  gatewayHeroHref:
    "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color/i-rRdrQBg",
  gatewayHeroSrc: "/img/i-rRdrQBg/m.jpg",
  gatewayHeroSrcSet: "/img/i-rRdrQBg/s.jpg 400w, /img/i-rRdrQBg/m.jpg 720w",
  archiveContextCopy:
    "Every work on this page is available as fine art - with the Sketch Series opening at $25. Click into any image to read the story, compare print options, sizes, and collector details. Questions about a specific piece? Reach Wayne directly at <a href='mailto:wayne@k4studios.com'>wayne@k4studios.com</a>.",
  faqKicker: "Print & Collector Questions",
  faqTitle: "Western Photography Art FAQ",
};
---

<CommercialDoorwayAllPage
  rawGalleryData={narrativeColorItems}
  entranceData={entranceData}
  basePath={basePath}
  contentBasePath={basePath}
  canonicalPath={canonicalPath}
  breadcrumbHtml={breadcrumbHtml}
  breadcrumbStructuredItems={breadcrumbStructuredItems}
  sectionDockItems={sectionDockItems}
  dockCenterIndex={dockCenterIndex}
  currentDockTitle="Explore Western Photography Art Collections"
  archiveContext={{
    categoryUrl: "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West",
    categoryName: "Wild West",
  }}
  identity={{
    collectionName: "Western Photography Art",
    variantName: "Western Art Photography",
    variantDescriptor: "western photography art",
    gatewayBrandLabel: "Western Photography Art - Western Art Photography by Wayne Heim",
  }}
  copy={copy}
  faqItems={westernArtFAQ}
  gridSections={gridSections}
  dockVariant="wall-art"
/>
