---
export const prerender = true;
import BaseLayout         from '../layouts/BaseLayout.astro';
import LandingHeader      from '../components/Landing-HeaderHome.jsx';
import HomeCarousel       from '../components/HomeCarousel.jsx';
import TombstoneNav       from '../components/TombstoneNav.jsx';
import LandingRightImages from '../components/LandingRightImages.jsx';
import FeaturedCollection from '../components/FeaturedCollection.astro';
import FAQAccordion       from '../components/FAQAccordion.jsx';
import SiteFooter         from '../components/Footer.astro';
import MobileStoryImages  from '../components/MobileStoryImages.jsx';

import { getStructuredData } from '../components/utils/getStructuredData.ts';
import { getLandingMeta }    from '../data/landingMeta.ts';
import { siteNav }           from '../data/siteNav.ts';
import { getSideImagesHome2 as getSideImages } from '../components/utils/getSideImagesHome2.ts';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';

import { autoLinkKeywordsInText } from '../components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '../data/semantic/K4-Sem.ts';

import { landingWestern }    from '../data/home/landingstones.ts';
import { painterlyStory }    from '../data/home/story.ts';
import { facingFAQ }         from '../data/home/faq.ts';

import '../styles/global.css';

const sectionPath = "/index"; // treat homepage as special section
const loreLegacyUrl = "/Other/K4-Select-Series/Engrained/Engrained-Series?theme=lore-and-legacy&view=grid";
const loreLegacyShowUrl = "/Other/Stories/Lore-and-Legacy-Show";
const loreLegacyThemeGalleryId = "/Other/K4-Select-Series/Engrained/Engrained-Series";
const loreLegacyShowGalleryId = "/Other/Stories/Lore-and-Legacy-Show";

function buildLorePixelHandler(action: string, sourceLayer: string, galleryId: string, trigger: string): string {
  const escapedGalleryId = JSON.stringify(galleryId);
  const escapedTheme = JSON.stringify('lore-and-legacy');
  const escapedTrigger = JSON.stringify(trigger);

  return `if (window.k4emitActionPixel) window.k4emitActionPixel('${action}', null, { galleryId: ${escapedGalleryId}, sourceLayer: '${sourceLayer}', pageType: 'landing', theme: ${escapedTheme}, trigger: ${escapedTrigger} });`;
}

const loreLegacyImagePixelHandler = buildLorePixelHandler(
  'home_lore_legacy_image_click',
  'home_lore_legacy_image_click_pixel_v1',
  loreLegacyThemeGalleryId,
  'banner-image'
);
const loreLegacyCtaPixelHandler = buildLorePixelHandler(
  'home_lore_legacy_cta_click',
  'home_lore_legacy_cta_click_pixel_v1',
  loreLegacyThemeGalleryId,
  'banner-cta'
);
const loreLegacyAudioPixelHandler = buildLorePixelHandler(
  'home_lore_legacy_audio_click',
  'home_lore_legacy_audio_click_pixel_v1',
  loreLegacyShowGalleryId,
  'banner-audio-text'
);

const headingCount = painterlyStory.filter((block, i) => i > 0 && block.subhead).length;
// Pool 3x more images for client-side rotation variety
const { featheredImages, galleryDatas, galleryPaths } = getSideImages({
  targetCount: headingCount,
  poolMultiplier: 3
});
// Pass full pool to component, let it pick displayCount randomly on client

// Proxy URL helper - ensures SmugMug URLs never appear in SSR HTML
function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return `/img/${imageId}/${size}`;
}

// Featured Collection image (i-7Mzzbvp - "Last Hand" - unmistakably Western)
const featuredCollectionImage = {
  id: "i-7Mzzbvp",
  src: getProxySrc("i-7Mzzbvp", "xl"),
  srcM: getProxySrc("i-7Mzzbvp", "m"),
  srcS: getProxySrc("i-7Mzzbvp", "s"),
  alt: "Painterly Western image of three cowboys on horseback racing forward, guns drawn, in a cloud of dust on the open prairie.",
  width: 600,
  height: 400
};

// ----------------------
// Structured Data
// ----------------------
const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingWestern.title,
    description: landingWestern.subtitle || landingWestern.description,
    url: `https://k4studios.com/`,
    keywords: landingWestern.keywords || [],
    copyrightNotice: "© Wayne Heim"
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    acquireLicensePage: "https://k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

// ----------------------
// NEW: dynamic OG/Twitter image
// ----------------------
function makeAbsoluteUrl(src?: string) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) return src;
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

const landingImg    = featheredImages[0];   // pick first feathered image for stability
const landingImgUrl = landingImg?.id ? makeAbsoluteUrl(getProxySrc(landingImg.id, 'l')) : '';

const meta = getLandingMeta(sectionPath, landingImgUrl);
if (!meta.ogUrl)      meta.ogUrl      = "https://k4studios.com/";
if (!meta.twitterUrl) meta.twitterUrl = "https://k4studios.com/";
---

<BaseLayout
  title={`${landingWestern.title} - ${landingWestern.subtitle}`}
  structuredDataJSON={structuredData}
  meta={meta}
>

  <main class="bg-white text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:only="react" breadcrumb={landingWestern.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb">
        {landingWestern.breadcrumb}
      </div>
    </div>

    {/* CLS-safe carousel frame - reserves exact height */}
    <div class="carousel-frame">
      {/* LCP Placeholder Overlay */}
      <picture class="carousel-overlay">
        <source media="(max-width: 768px)" srcset="/images/mobile.webp">
        <img
          src="/images/desktop3.webp"
          alt="Featured Artwork"
          class="lcp-placeholder-img"
          fetchpriority="high"
          loading="eager"
          decoding="sync"
          id="lcp-placeholder-img"
        />
      </picture>

      {/* Carousel */}
      <div class="carousel-fade">
        <HomeCarousel client:only="react" />
      </div>
    </div>

    <section class="section-heading-anim-wrap">
      <div class="section-heading-anim">
        <h1 class="hero-subtitle-anim" id="hero-subtitle">
          {landingWestern.subtitle}
        </h1>
        <p class="hero-title-anim" id="hero-title">
          {landingWestern.title}
        </p>
      </div>
    </section>

    <div class="py-5">
      <TombstoneNav client:load items={landingWestern.tombstones} />
    </div>

    <section class="home-show-banner reveal-on-scroll" aria-label="Lore and Legacy show promotion">
      <a class="home-show-banner__image-link" href={loreLegacyUrl} data-k4-pixel="home-lore-legacy-image" data-k4-trigger="banner-image" onpointerdown={loreLegacyImagePixelHandler} onclick={loreLegacyImagePixelHandler}>
        <img
          src="/images/Lore.png"
          alt="Lore and Legacy show artwork from the Enggrained series"
          class="home-show-banner__image"
          loading="lazy"
          decoding="async"
        />
      </a>

      <div class="home-show-banner__content">
        <p class="home-show-banner__eyebrow">Featured Show</p>
        <h2 class="home-show-banner__title">Step Into the Story</h2>
        <ul class="show-feature-bullets">
          <li>Recently showcased at the Great Western Art Show</li>
          <li>
            Profiled in <a href="https://aotw.com/2026/02/painterly-photography/" target="_blank" rel="noopener noreferrer">Art of the West Magazine</a>
          </li>
        </ul>
        <p class="show-feature-body">
          Explore <strong>Lore &amp; Legacy</strong>, the collection of booth images from the show, where painterly Western fine art photography transforms each image into a moment waiting to be completed.
        </p>
        <p class="show-feature-audio-link">
          Want to do more than see them? <a href={loreLegacyShowUrl} data-k4-pixel="home-lore-legacy-audio" data-k4-trigger="banner-audio-text" onpointerdown={loreLegacyAudioPixelHandler} onclick={loreLegacyAudioPixelHandler}>Hear the narrated Lore &amp; Legacy picture show.</a>
        </p>
        <a class="home-show-banner__cta" href={loreLegacyUrl} data-k4-pixel="home-lore-legacy-cta" data-k4-trigger="banner-cta" onpointerdown={loreLegacyCtaPixelHandler} onclick={loreLegacyCtaPixelHandler}>
          Begin the Journey &rarr;
        </a>
      </div>
    </section>

    <section class="story-layout">
      <div class="text-column">
        <section class="story-section">
          {painterlyStory.map((section, index) => (
            <article class="story-block" key={index}>
              {section.title && <h2 class="slide-in-left" set:html={autoLinkKeywordsInText(section.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
              {section.subhead && <h3 class="slide-in-left" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
              {section.tagline && <h4 class="tagline reveal-on-scroll" set:html={autoLinkKeywordsInText(section.tagline, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
              {section.paragraphs?.map((para, i) => (
                <p key={i} class="reveal-on-scroll" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
              ))}
              {section.list && section.list.length > 0 && (
                <ul>
                  {section.list.map((item, j) => (
                    <li key={j} class="reveal-on-scroll" set:html={autoLinkKeywordsInText(item, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
                  ))}
                </ul>
              )}
            </article>
          ))}
        </section>

        <MobileStoryImages client:only="react" images={sanitizeForClient(featheredImages)} displayCount={headingCount} />
      </div>

      <div class="sidebar-column hidden md:block">
        <!-- Featured Collection CTA -->
        <div class="reveal-on-scroll" style="margin-top: 1.5rem; margin-bottom: 6rem;">
          <FeaturedCollection
            image={featuredCollectionImage}
            title="Western Cowboy Collection"
            subtitle="Painterly portraits of the American West"
            ctaText="Enter the Frontier"
            ctaLink="/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits"
            collectionName="Western Cowboy Portraits"
            trackingId="Cowboy_Jump_Home"
            itemCount={250}
          />
        </div>
        
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages
            client:load
            heading="Explore Other Themes"
            images={featheredImages}
            displayCount={6}
          />
        </div>
      </div>
    </section>

    <section class="pb-10">
      <input type="checkbox" id="faq-toggle" class="more-toggle" />
      <div class="truncate-container" style="min-height:0;">
        <div class="truncate-text">
          <FAQAccordion items={facingFAQ} />
        </div>
      </div>
      <label for="faq-toggle" class="more-toggle-label"></label>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // Reveal-on-scroll logic (NO .carousel-fade here)
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }

      // Auto-expand FAQ if clicked
      const faqToggle = document.getElementById("faq-toggle");
      const truncateContainer = document.querySelector(".truncate-container");
      if (truncateContainer && faqToggle) {
        truncateContainer.addEventListener("click", (e) => {
          const summaryClicked = e.target.closest("summary");
          if (summaryClicked && !faqToggle.checked) {
            faqToggle.checked = true;
          }
        });
      }

      // --- LCP Placeholder fade out logic and carousel trigger ---
      const isMobile = window.innerWidth <= 768;
      const fadeDelay = 2800; // Synced with carousel zoom
      setTimeout(() => {
        const lcp = document.getElementById("lcp-placeholder-img");
        if (lcp) {
          lcp.style.transition = "opacity 0.6s ease-out";
          lcp.style.opacity = "0";
          setTimeout(() => { lcp.style.display = "none"; }, 500);
        }
        // FIRE CAROUSEL ZOOM-UP NOW
        const carousel = document.querySelector('.carousel-fade');
        if (carousel) carousel.classList.add('is-visible');
      }, fadeDelay);

      // Heading animation
      setTimeout(() => {
        document.querySelector('.section-heading-anim-wrap')
          ?.classList.add('heading-animated');
      }, 300); // You can tweak this for heading delay as needed
    });
  </script>

  <script is:inline>
    const HOME_IMAGE_LAYER = 'home_lore_legacy_image_click_pixel_v1';
    const HOME_CTA_LAYER = 'home_lore_legacy_cta_click_pixel_v1';
    const HOME_AUDIO_LAYER = 'home_lore_legacy_audio_click_pixel_v1';
    const THEME_GALLERY_ID = '/Other/K4-Select-Series/Engrained/Engrained-Series';
    const AUDIO_GALLERY_ID = '/Other/Stories/Lore-and-Legacy-Show';

    const pixelConfig = {
      'home-lore-legacy-image': {
        action: 'home_lore_legacy_image_click',
        sourceLayer: HOME_IMAGE_LAYER,
        galleryId: THEME_GALLERY_ID,
        pageType: 'landing',
        theme: 'lore-and-legacy'
      },
      'home-lore-legacy-cta': {
        action: 'home_lore_legacy_cta_click',
        sourceLayer: HOME_CTA_LAYER,
        galleryId: THEME_GALLERY_ID,
        pageType: 'landing',
        theme: 'lore-and-legacy'
      },
      'home-lore-legacy-audio': {
        action: 'home_lore_legacy_audio_click',
        sourceLayer: HOME_AUDIO_LAYER,
        galleryId: AUDIO_GALLERY_ID,
        pageType: 'landing',
        theme: 'lore-and-legacy'
      }
    };

    function getLoreSessionId() {
      try {
        let sessionId = sessionStorage.getItem('k4_session_id');
        if (!sessionId) {
          sessionId = window.crypto && typeof window.crypto.randomUUID === 'function'
            ? window.crypto.randomUUID()
            : `${Date.now()}-${Math.random().toString(16).slice(2)}`;
          sessionStorage.setItem('k4_session_id', sessionId);
        }
        return sessionId;
      } catch (_) {
        return '';
      }
    }

    function emitLorePixel(config, trigger) {
      if (!config) return;

      const params = new URLSearchParams({
        t: 'action',
        e: config.action,
        v: String(Date.now()),
        g: config.galleryId,
        pt: config.pageType,
        sl: config.sourceLayer,
        th: config.theme,
        tr: trigger || '',
        path: window.location.pathname
      });

      const sessionId = getLoreSessionId();
      if (sessionId) params.set('sid', sessionId);

      const pixelUrl = `/_state?${params.toString()}`;
      if (typeof fetch === 'function') {
        fetch(pixelUrl, {
          method: 'GET',
          keepalive: true,
          cache: 'no-store',
          credentials: 'same-origin'
        }).catch(() => {
          const image = new Image();
          image.referrerPolicy = 'same-origin';
          image.src = pixelUrl;
        });
        return;
      }

      const image = new Image();
      image.referrerPolicy = 'same-origin';
      image.src = pixelUrl;
    }

    document.addEventListener('DOMContentLoaded', () => {
      const firePixel = (element) => {
        const pixelKey = element.getAttribute('data-k4-pixel');
        const trigger = element.getAttribute('data-k4-trigger') || null;
        const config = pixelKey ? pixelConfig[pixelKey] : null;
        emitLorePixel(config, trigger);
      };

      document.querySelectorAll('[data-k4-pixel]').forEach((element) => {
        element.addEventListener('pointerdown', () => firePixel(element), { passive: true });
        element.addEventListener('click', () => firePixel(element), { passive: true });
      });
    });
  </script>

<style lang="css">
/* CLS-safe carousel frame */
.carousel-frame {
  position: relative;
  width: 100%;
  max-width: 1200px;
  height: 390px;
  margin: 2rem auto 0;
  padding: 0 1rem;
  overflow: hidden;
}
@media (max-width: 768px) {
  .carousel-frame {
    height: 200px;
    margin-top: 1rem;
  }
}

.carousel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  pointer-events: none;
}

.lcp-placeholder-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 1;
  transition: opacity 1.0s ease-out;
}

.carousel-fade {
  opacity: 0;
  transform: scale(0.65);
  transition: opacity 1.0s ease-out, transform 2.5s cubic-bezier(.36,1,.72,1);
  visibility: hidden;
}
.carousel-fade.is-visible {
  opacity: 1;
  transform: scale(1);
  visibility: visible;
}
.sample-fade {
  opacity: 0;
  transform: translateY(0);
  transition: opacity 1.5s ease-out, transform 1.5s ease-out;
  visibility: hidden;
  transition-delay: 0.2s;
  margin-top: -0.75rem;
}
.sample-fade.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }
/* ...rest of your existing styles... */
.section-heading-anim-wrap {
  margin: -1.8rem 0 1.3rem 0;
  min-height: 138px;
  margin-bottom: -6px;
  text-align: center;
  position: relative;
  z-index: 2;
  pointer-events: none;
}
@media (max-width: 768px) {
  .section-heading-anim-wrap {
    margin: -2rem 0 0.5rem 0;
    min-height: 90px;
  }
  .section-heading-anim {
    min-height: 80px;
  }
}
.section-heading-anim {
  position: relative;
  width: 100%;
  min-height: 105px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
/* Subtitle */
.hero-subtitle-anim {
  font-family: "Glegoo", serif;
  font-weight: 400;
  font-size: 1.2rem;
  letter-spacing: -0.018em;
  line-height: 1.1;
  color: #6d5b4a;
  opacity: 1;
  transform: scale(1.7) translateY(53px);
  transition:
    opacity 0.7s cubic-bezier(.33,1,.68,1),
    transform 1.625s cubic-bezier(.38,1,.74,.96),
    filter 0.4s cubic-bezier(.4,1,.7,1);
  transition-delay: 0.21s;
}
.heading-animated .hero-subtitle-anim {
  transform: scale(1) translateY(130px);
  opacity: 0.96;
  transition-delay: 2.21s;
}
/* Title */
.hero-title-anim {
  font-family: "Glegoo", serif;
  font-weight: 800;
  font-size: 3.45rem;
  letter-spacing: -0.04em;
  color: #3e3220;
  opacity: 0;
  transform: translateY(85px) scale(0.8);
  transition:
    opacity 0.52s cubic-bezier(.33,1,.68,1),
    transform 0.9s cubic-bezier(.38,1,.74,.96);
  transition-delay: 0.41s;
  margin-top: .5em;
  margin-bottom: 0.02em;
}
.heading-animated .hero-title-anim {
  opacity: 1;
  transform: translateY(0) scale(1);
  transition-delay: 2.49644s;
}
/* Responsive tweaks */
@media (max-width: 800px) {
  .hero-title-anim {
    font-family: "Glegoo", serif;
    font-weight: 800;
    font-size: 2.65rem;
    letter-spacing: -0.04em;
    color: #3e3220;
    opacity: 0;
    transform: translateY(25px) scale(0.8);
    transition:
      opacity 0.52s cubic-bezier(.33,1,.68,1),
      transform 0.9s cubic-bezier(.38,1,.74,.96);
    transition-delay: 0.21s;
    margin-top: .95em;
    margin-bottom: 0.02em;
  }
  .heading-animated .hero-title-anim {
    opacity: 1;
    transform: translateY(-20px) scale(1);
    transition-delay: 0.24s;
  }
  .heading-animated .hero-subtitle-anim {
    font-size: 1.0rem;
    transform: scale(1) translateY(112px);
    opacity: 0.96;
    filter: blur(0);
    transition-delay: 0.13s;
  }
  .hero-subtitle-anim {
    font-family: "Glegoo", serif;
    font-weight: 400;
    font-size: 1.02rem;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: #6d5b4a;
    opacity: 1;
    transform: scale(1.1) translateY(75px);
    transition:
      opacity 0.7s cubic-bezier(.33,1,.68,1),
      transform 1.625s cubic-bezier(.38,1,.74,.96),
      filter 0.4s cubic-bezier(.4,1,.7,1);
    transition-delay: 0.21s;
  }
}
ul { list-style-type: disc; padding-left: 1.25em; }
ul li { margin-top: 0.15em; margin-left: 1.5em; }
ul li::marker { margin-top: 0.15em; font-size: 1.2em; color: gray; }
@media (max-width: 768px) {
  .section-heading .page-title { font-size: 1.5rem; line-height: 1.3; }
  .section-heading .page-subtitle { max-width: 42ch; margin-left: auto; margin-right: auto; text-align: center; font-size: 1rem; line-height: 1.4; letter-spacing: -0.04em; }
  .section-heading-wrap { margin-top: 1rem; margin-bottom: 1rem; }
  .sidebar-column { display: none; }
  .story-section { letter-spacing: -0.03em; }
  .story-block h2 { letter-spacing: -0.05em; font-size: 1.4rem !important; margin-top: -0.59rem; line-height: 1.15; }
  .story-block h3 { letter-spacing: -0.05em; font-size: 1.4rem !important; margin-top: -0.59rem; line-height: 1.15; }
}
.fade-in { opacity: 0; visibility: hidden; transform: translateY(1px); transition: opacity 1.75s ease, transform 1.75s ease, visibility .5s linear 1.75s; }
.fade-in.is-visible { opacity: 1; transform: translateY(0); visibility: visible; }
.page-title.fade-in { transition-delay: .2s; }
.section-heading-wrap { margin: 1.5rem 0; text-align: center; }
.section-heading .page-title { font-size: 2rem; margin-bottom: .4rem; }
.section-heading .page-subtitle { font-size: 1rem; font-weight: 400; color: #6d5b4a; opacity: .9; }
.story-section { line-height: 1.3; padding: 2rem 1.5rem; max-width: 860px; margin: 0 auto; font-family: 'Glegoo', serif; }
.story-block { margin-bottom: 2.5rem; }
.story-block h2 { font-weight: 500; font-size: 1.65rem; margin-bottom: 0.55rem; }
.story-block h3 { font-weight: 500; font-size: 1.65rem; margin-top: -0.5rem; margin-bottom: 0.55rem; color: inherit; }
.story-block .tagline { font-size: 1.05rem; font-weight: 500; margin-bottom: 1rem; color: #7a6250; }
.story-block p { line-height: 1.6; margin-bottom: 1rem; font-size: 1.01rem; }
.story-block ul { padding-left: 1.4rem; margin-top: 0.5rem; }
.story-block li { margin-bottom: 0.5rem; font-size: 1rem; }
.page-subtitle.fade-in { opacity: 0 !important; transform: translateY(-12px); visibility: hidden; transition: opacity 1.1s ease-out, transform 1.1s ease-out, visibility 0s linear 1.1s; transition-delay: 1s; }
.page-subtitle.fade-in.is-visible { opacity: 1 !important; transform: translateY(0); visibility: visible; transition-delay: 1s; }

.home-show-banner {
  width: min(1200px, calc(100% - 2rem));
  margin: 0.25rem auto 1.75rem;
  padding: 1rem;
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
  align-items: center;
  background: linear-gradient(135deg, #1a130e 0%, #2c1f17 100%);
  border: 1px solid rgba(186, 149, 95, 0.34);
  border-radius: 18px;
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
  overflow: hidden;
  font-family: 'Glegoo', serif;
}

.home-show-banner__image-link {
  display: block;
}

.home-show-banner__image {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 12px;
  transition: transform 0.35s ease, filter 0.35s ease;
}

.home-show-banner__image-link:hover .home-show-banner__image,
.home-show-banner__image-link:focus-visible .home-show-banner__image {
  transform: scale(1.015);
  filter: brightness(1.05);
}

.home-show-banner__content {
  padding: 0.15rem 0.25rem 0.35rem;
  font-family: 'Glegoo', serif;
  color: #eadfce;
}

.home-show-banner__content strong {
  color: #f6ead8;
}

.home-show-banner__eyebrow {
  margin: 0 0 0.45rem;
  font-size: 0.8rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #d9b57a;
  font-family: 'Glegoo', serif;
}

.home-show-banner__title {
  margin: 0 0 0.75rem;
  font-family: 'Glegoo', serif;
  font-size: clamp(1.55rem, 2vw, 2.35rem);
  line-height: 1.08;
  color: #f3eadf;
}

.show-feature-bullets {
  margin: 10px 0 14px;
  padding-left: 18px;
  list-style-type: disc;
  color: #eadfce;
  font-family: 'Glegoo', serif;
}

.show-feature-bullets li {
  font-size: 0.9rem;
  line-height: 1.5;
  margin-bottom: 4px;
  opacity: 0.9;
  color: #eadfce;
}

.show-feature-bullets li::marker {
  color: #d9b57a;
}

.show-feature-bullets a {
  color: #e6c29f;
  text-decoration: underline;
}

.show-feature-bullets a:visited,
.show-feature-bullets a:hover,
.show-feature-bullets a:focus-visible,
.show-feature-body a,
.show-feature-body a:visited,
.show-feature-body a:hover,
.show-feature-body a:focus-visible {
  color: #f0cfab;
}

.show-feature-body {
  margin: 0 0 1rem;
  color: #eadfce;
  line-height: 1.6;
  font-size: 1rem;
  font-family: 'Glegoo', serif;
}

.show-feature-audio-link {
  margin: -0.15rem 0 1rem;
  color: #e6d6c0;
  line-height: 1.5;
  font-size: 0.95rem;
  font-family: 'Glegoo', serif;
}

.show-feature-audio-link a,
.show-feature-audio-link a:visited,
.show-feature-audio-link a:hover,
.show-feature-audio-link a:focus-visible {
  color: #f0cfab;
  text-decoration: underline;
}

.home-show-banner__cta {
  display: inline-block;
  padding: 0.82rem 1.18rem;
  border-radius: 999px;
  background: #d9b57a;
  color: #1c140f;
  text-decoration: none;
  font-weight: 700;
  font-family: 'Glegoo', serif;
  transition: transform 0.25s ease, background 0.25s ease;
}

.home-show-banner__cta:hover,
.home-show-banner__cta:focus-visible {
  background: #ebc88e;
  transform: translateY(-1px);
}

@media (min-width: 900px) {
  .home-show-banner {
    grid-template-columns: minmax(360px, 46%) 1fr;
    padding: 1.15rem;
  }

  .home-show-banner__content {
    padding: 0 0.5rem;
  }
}

@media (max-width: 768px) {
  .home-show-banner {
    width: min(100%, calc(100% - 1rem));
    margin: 0 auto 1rem;
    padding: 0.85rem;
    gap: 1rem;
    border-radius: 14px;
  }

  .home-show-banner__title {
    font-size: 1.45rem;
  }

  .show-feature-body {
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .show-feature-audio-link {
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .show-feature-bullets li {
    font-size: 0.93rem;
    line-height: 1.5;
  }

  .home-show-banner__cta {
    width: 100%;
    text-align: center;
  }
}
</style>
</BaseLayout>
