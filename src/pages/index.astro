---
export const prerender = true;
import BaseLayout         from '../layouts/BaseLayout.astro';
import { getSemanticImageUrl } from "@/utils/imageProxy.js";
import LandingHeader      from '../components/Landing-HeaderHome.jsx';
import HomeCarousel       from '../components/HomeCarousel.jsx';
import TombstoneNav       from '../components/TombstoneNav.jsx';
import LandingRightImages from '../components/LandingRightImages.jsx';
import FeaturedCollection from '../components/FeaturedCollection.astro';
import FAQAccordion       from '../components/FAQAccordion.jsx';
import SiteFooter         from '../components/Footer.astro';
import MobileStoryImages  from '../components/MobileStoryImages.jsx';
import VideoStoryWidget   from '../components/VideoStoryWidget.astro';

import { getFAQPageStructuredData, getStructuredData } from '../components/utils/getStructuredData.ts';
import { getLandingMeta }    from '../data/landingMeta.ts';
import { siteNav }           from '../data/siteNav.ts';
import { getSideImagesHome2 as getSideImages } from '../components/utils/getSideImagesHome2.ts';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';

import { autoLinkKeywordsInText } from '../components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '../data/semantic/K4-Sem.ts';

import { landingWestern }    from '../data/home/landingstones.ts';
import { painterlyStory }    from '../data/home/story.ts';
import { facingFAQ }         from '../data/home/faq.ts';
import { stories as pictureShowStories } from '../data/Other/Stories/stories.mjs';

import '../styles/global.css';
import '../styles/home-index.css';

const sectionPath = "/index"; // treat homepage as special section
const loreLegacyUrl = "/Other/K4-Select-Series/Engrained/Engrained-Series?theme=lore-and-legacy&view=grid";
const loreLegacyThemeGalleryId = "/Other/K4-Select-Series/Engrained/Engrained-Series";

function buildLorePixelHandler(action: string, sourceLayer: string, galleryId: string, trigger: string): string {
  const escapedGalleryId = JSON.stringify(galleryId);
  const escapedTheme = JSON.stringify('lore-and-legacy');
  const escapedTrigger = JSON.stringify(trigger);

  return `if (window.k4emitActionPixel) window.k4emitActionPixel('${action}', null, { galleryId: ${escapedGalleryId}, sourceLayer: '${sourceLayer}', pageType: 'landing', theme: ${escapedTheme}, trigger: ${escapedTrigger} });`;
}

const loreLegacyImagePixelHandler = buildLorePixelHandler(
  'home_lore_legacy_image_click',
  'home_lore_legacy_image_click_pixel_v1',
  loreLegacyThemeGalleryId,
  'banner-image'
);
const loreLegacyCtaPixelHandler = buildLorePixelHandler(
  'home_lore_legacy_cta_click',
  'home_lore_legacy_cta_click_pixel_v1',
  loreLegacyThemeGalleryId,
  'banner-cta'
);

const headingCount = painterlyStory.filter((block, i) => i > 0 && block.subhead).length;
// Pool 3x more images for client-side rotation variety
const { featheredImages, galleryDatas, galleryPaths } = getSideImages({
  targetCount: headingCount,
  poolMultiplier: 3
});
// Pass full pool to component, let it pick displayCount randomly on client

// Proxy URL helper - ensures SmugMug URLs never appear in SSR HTML
function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return getSemanticImageUrl(imageId, {}, size);
}

const pictureShowsUrl = "/Other/Shows";
const pictureShowsTrackingId = "Picture_Shows_Widget_Home";
const pictureShowsWidgetImage = {
  src: "/images/K4-Stories logo1b.webp",
  src2: "/images/K4-Stories logo2.webp",
  src3: "/images/K4-Stories-logo3b.gif",
  alt: "K4 Studios Picture Shows logo",
  width: 640,
  height: 640,
  fit: "contain" as const
};

// ----------------------
// Structured Data
// ----------------------
const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingWestern.title,
    description: landingWestern.subtitle || landingWestern.description,
    url: `https://k4studios.com/`,
    keywords: landingWestern.keywords || [],
    copyrightNotice: "© Wayne Heim"
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    acquireLicensePage: "https://k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});
const faqStructuredData = getFAQPageStructuredData(facingFAQ, "https://k4studios.com/");

// ----------------------
// NEW: dynamic OG/Twitter image
// ----------------------
function makeAbsoluteUrl(src?: string) {
  if (!src) return "";
  if (src.startsWith("http://") || src.startsWith("https://")) return src;
  return `https://k4studios.com${src.startsWith("/") ? src : "/" + src}`;
}

const landingImg    = featheredImages[0];   // pick first feathered image for stability
const landingImgUrl = landingImg?.id ? makeAbsoluteUrl(getProxySrc(landingImg.id, 'l')) : '';

const meta = getLandingMeta(sectionPath, landingImgUrl);
if (!meta.ogUrl)      meta.ogUrl      = "https://k4studios.com/";
if (!meta.twitterUrl) meta.twitterUrl = "https://k4studios.com/";
---

<BaseLayout
  title={`${landingWestern.title} - ${landingWestern.subtitle}`}
  structuredDataJSON={structuredData}
  extraStructuredDataJSON={faqStructuredData}
  meta={meta}
>

  <main class="bg-white text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:only="react" breadcrumb={landingWestern.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb">
        {landingWestern.breadcrumb}
      </div>
    </div>

    {/* CLS-safe carousel frame - reserves exact height */}
    <div class="carousel-frame">
      {/* LCP Placeholder Overlay */}
      <picture class="carousel-overlay">
        <source media="(max-width: 768px)" srcset="/images/mobile.webp">
        <img
          src="/images/desktop3.webp"
          alt="K4 Studios fine art photography preview showing Western portraits, mountain landscapes, and classic Americana artwork"
          class="lcp-placeholder-img"
          fetchpriority="high"
          loading="eager"
          decoding="sync"
          id="lcp-placeholder-img"
        />
      </picture>

      {/* Carousel */}
      <div class="carousel-fade">
        <HomeCarousel client:only="react" />
      </div>
    </div>

    <section class="section-heading-anim-wrap">
      <div class="section-heading-anim">
        <h1 class="hero-subtitle-anim" id="hero-subtitle">
          {landingWestern.subtitle}
        </h1>
        <p class="hero-title-anim" id="hero-title">
          {landingWestern.title}
        </p>
      </div>
    </section>

    <div class="py-5">
      <TombstoneNav client:load items={landingWestern.tombstones} />
    </div>

    <section class="home-picture-shows-mobile" aria-label="Picture Shows link">
      <div class="home-picture-shows-mobile__inner">
        <span class="home-picture-shows-mobile__eyebrow">Picture Shows</span>
        <p class="home-picture-shows-mobile__text">Explore the stories that live beyond the frame.</p>
        <a class="home-picture-shows-mobile__link" href={pictureShowsUrl}>See where they will take you.</a>
      </div>
    </section>

    <div class="story-layout">
      <div class="text-column">
        <div class="story-section">
          {painterlyStory.map((section, index) => (
            <>
              <article class="story-block">
                {section.title && <h2 class="slide-in-left" set:html={autoLinkKeywordsInText(section.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
                {section.subhead && <h3 class="slide-in-left" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
                {section.tagline && <h4 class="tagline reveal-on-scroll" set:html={autoLinkKeywordsInText(section.tagline, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />}
                {section.paragraphs?.map((para, i) => (
                  <>
                    <p class="reveal-on-scroll" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
                    {section.subhead?.includes("Western Frontier") && i === section.paragraphs.length - 1 && (
                      <VideoStoryWidget
                        class="reveal-on-scroll"
                        videoSlug="only-path-forward"
                        kicker="Frontier stories come alive."
                        label="60 seconds: Beyond the frame."
                      />
                    )}
                  </>
                ))}
                {section.list && section.list.length > 0 && (
                  <ul>
                    {section.list.map((item, j) => (
                      <li class="reveal-on-scroll" set:html={autoLinkKeywordsInText(item, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
                    ))}
                  </ul>
                )}
              </article>

            </>
          ))}
        </div>

        <MobileStoryImages client:only="react" images={sanitizeForClient(featheredImages)} displayCount={headingCount} />
      </div>

      <div class="sidebar-column hidden md:block">
        <!-- Featured collection CTA -->
        <div class="reveal-on-scroll" style="margin-top: 1.5rem; margin-bottom: 6rem;">
          <FeaturedCollection
            image={pictureShowsWidgetImage}
            title="K4 Picture Shows"
            subtitle="Explore the stories that live beyond the frame."
            ctaText="See where they will take you."
            ctaLink={pictureShowsUrl}
            collectionName="K4 Studios Picture Shows"
            trackingId={pictureShowsTrackingId}
            trackingEvent="picture_shows_jump"
            itemCount={pictureShowStories.length}
            appendArrow={false}
          />
        </div>
        
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages
            client:load
            heading="Explore Other Themes"
            images={sanitizeForClient(featheredImages)}
            displayCount={6}
          />
        </div>
      </div>
    </div>

    <section class="pb-10">
      <h2 class="sr-only">Frequently Asked Questions</h2>
      <input type="checkbox" id="faq-toggle" class="more-toggle" />
      <div class="truncate-container" style="min-height:0;">
        <div class="truncate-text">
          <FAQAccordion items={facingFAQ} />
        </div>
      </div>
      <label for="faq-toggle" class="more-toggle-label"></label>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // Reveal-on-scroll logic (NO .carousel-fade here)
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }

      // Auto-expand FAQ if clicked
      const faqToggle = document.getElementById("faq-toggle");
      const truncateContainer = document.querySelector(".truncate-container");
      if (truncateContainer && faqToggle) {
        truncateContainer.addEventListener("click", (e) => {
          const summaryClicked = e.target.closest("summary");
          if (summaryClicked && !faqToggle.checked) {
            faqToggle.checked = true;
          }
        });
      }

      // --- LCP Placeholder fade out logic and carousel trigger ---
      const isMobile = window.innerWidth <= 768;
      const fadeDelay = 2800; // Synced with carousel zoom
      setTimeout(() => {
        const lcp = document.getElementById("lcp-placeholder-img");
        if (lcp) {
          lcp.style.transition = "opacity 0.6s ease-out";
          lcp.style.opacity = "0";
          setTimeout(() => { lcp.style.display = "none"; }, 500);
        }
        // FIRE CAROUSEL ZOOM-UP NOW
        const carousel = document.querySelector('.carousel-fade');
        if (carousel) carousel.classList.add('is-visible');
      }, fadeDelay);

      // Heading animation
      setTimeout(() => {
        document.querySelector('.section-heading-anim-wrap')
          ?.classList.add('heading-animated');
      }, 300); // You can tweak this for heading delay as needed
    });
  </script>

  <script is:inline>
    const HOME_IMAGE_LAYER = 'home_lore_legacy_image_click_pixel_v1';
    const HOME_CTA_LAYER = 'home_lore_legacy_cta_click_pixel_v1';
    const THEME_GALLERY_ID = '/Other/K4-Select-Series/Engrained/Engrained-Series';
    const PICTURE_SHOWS_HOME_TRACKING_ID = 'Picture_Shows_Widget_Home';
    const ANALYTICS_ENDPOINT = 'https://edge.k4studios.com/__k4e';

    const pixelConfig = {
      'home-lore-legacy-image': {
        action: 'home_lore_legacy_image_click',
        event: 'home_lore_legacy_image_click',
        sourceLayer: HOME_IMAGE_LAYER,
        galleryId: THEME_GALLERY_ID,
        pageType: 'landing',
        theme: 'lore-and-legacy'
      },
      'home-lore-legacy-cta': {
        action: 'home_lore_legacy_cta_click',
        event: 'home_lore_legacy_cta_click',
        sourceLayer: HOME_CTA_LAYER,
        galleryId: THEME_GALLERY_ID,
        pageType: 'landing',
        theme: 'lore-and-legacy'
      }
    };

    function getLoreSessionId() {
      try {
        const sidMatch = document.cookie.match(/(?:^|;\s*)k4_sid=([^;]+)/);
        let sessionId = sidMatch ? decodeURIComponent(sidMatch[1]) : '';
        if (!sessionId) {
          sessionId = sessionStorage.getItem('k4_session_id') || '';
        }
        if (!sessionId) {
          sessionId = window.crypto && typeof window.crypto.randomUUID === 'function'
            ? window.crypto.randomUUID()
            : `${Date.now()}-${Math.random().toString(16).slice(2)}`;
        }
        sessionStorage.setItem('k4_session_id', sessionId);
        const cookieDomainAttr = window.location.hostname.toLowerCase().endsWith('k4studios.com')
          ? '; Domain=.k4studios.com'
          : '';
        document.cookie = `k4_sid=${encodeURIComponent(sessionId)}; Path=/; SameSite=Lax; Secure${cookieDomainAttr}`;
        return sessionId;
      } catch (_) {
        return '';
      }
    }

    function emitLorePixel(config, trigger) {
      if (!config) return;
      if (typeof window.k4ShouldSuppressAnalytics === 'function' && window.k4ShouldSuppressAnalytics()) return;

      const params = new URLSearchParams({
        t: 'action',
        e: config.action,
        v: String(Date.now()),
        g: config.galleryId,
        pt: config.pageType,
        sl: config.sourceLayer,
        th: config.theme,
        tr: trigger || '',
        path: window.location.pathname
      });

      const sessionId = getLoreSessionId();
      if (sessionId) params.set('sid', sessionId);

      const pixelUrl = `https://edge.k4studios.com/_state?${params.toString()}`;
      if (typeof fetch === 'function') {
        fetch(pixelUrl, {
          method: 'GET',
          keepalive: true,
          cache: 'no-store',
          credentials: 'include'
        }).catch(() => {
          const image = new Image();
          image.referrerPolicy = 'same-origin';
          image.src = pixelUrl;
        });
        return;
      }

      const image = new Image();
      image.referrerPolicy = 'same-origin';
      image.src = pixelUrl;
    }

    function emitTrackingEvent(eventName, extra = {}) {
      if (!eventName) return;
      if (typeof window.k4ShouldSuppressAnalytics === 'function' && window.k4ShouldSuppressAnalytics()) return;

      try {
        if (typeof window.k4track === 'function') {
          window.k4track(eventName, extra);
          return;
        }
      } catch (_) {
        // fall through to best-effort network send
      }

      const sessionId = getLoreSessionId();
      const payload = JSON.stringify({
        session_id: sessionId,
        event: eventName,
        gallery_id: extra.galleryId || null,
        page_type: extra.pageType || null,
        source_layer: extra.sourceLayer || null,
        trigger: extra.trigger || null,
        theme: extra.theme || null
      });

      if (navigator.sendBeacon) {
        const blob = new Blob([payload], { type: 'text/plain;charset=UTF-8' });
        const ok = navigator.sendBeacon(ANALYTICS_ENDPOINT, blob);
        if (ok) return;
      }

      if (typeof fetch === 'function') {
        fetch(ANALYTICS_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
          keepalive: true,
          cache: 'no-store',
          mode: 'cors',
          credentials: 'include'
        }).catch(() => {
          // best-effort only
        });
      }
    }

    function emitLoreEvent(config, trigger) {
      if (!config || !config.event) return;
      emitTrackingEvent(config.event, {
        galleryId: config.galleryId,
        pageType: config.pageType,
        sourceLayer: config.sourceLayer,
        theme: config.theme,
        trigger: trigger || null
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      try {
        if (window.location.pathname === '/' && typeof window.k4track === 'function') {
          window.k4track('pilot_home_page_view', {
            pageType: 'landing',
            sourceLayer: 'pilot_home_v1_page_view',
            theme: 'pilot_home_v1',
            trigger: 'shadow_test'
          });
        }
      } catch (_) {
        // best-effort only
      }

      const firePixel = (element) => {
        const pixelKey = element.getAttribute('data-k4-pixel');
        const trigger = element.getAttribute('data-k4-trigger') || null;
        const config = pixelKey ? pixelConfig[pixelKey] : null;
        emitLoreEvent(config, trigger);
        emitLorePixel(config, trigger);
      };

      document.querySelectorAll('[data-k4-pixel]').forEach((element) => {
        element.addEventListener('pointerdown', () => firePixel(element), { passive: true });
        element.addEventListener('click', () => firePixel(element), { passive: true });
      });

      const pictureShowsMobileLink = document.querySelector('.home-picture-shows-mobile__link');
      if (pictureShowsMobileLink) {
        pictureShowsMobileLink.addEventListener('click', () => {
          emitTrackingEvent('picture_shows_jump', {
            galleryId: PICTURE_SHOWS_HOME_TRACKING_ID,
            pageType: 'landing'
          });
        }, { passive: true });
      }
    });
  </script>


</BaseLayout>
