---
export const prerender = true;
import BaseLayout         from '@/layouts/BaseLayout.astro';
import LandingHeader      from '@/components/Landing-Header.jsx';
import ImageBar2          from '@/components/ImageBar2.jsx';
import TombstoneNav       from '@/components/TombstoneNav.jsx';
import LandingRightImages from '@/components/LandingRightImages.jsx';
// import FAQAccordion       from '@/components/FAQAccordion.jsx';
import SiteFooter         from '@/components/Footer.astro';
import MobileStoryImages  from '@/components/MobileStoryImages.jsx';
import { getStructuredData } from '@/components/utils/getStructuredData.ts';

import { siteNav } from '@/data/siteNav.ts';
import { getSideImages } from '@/components/utils/getSideImages.ts';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';
import { autoLinkKeywordsInText } from '@/components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '@/data/semantic/K4-Sem.ts';

import { landingWestern } from '@/data/Pictorialist-Photography/landingstones.ts';
import { facingHistoryStory as westernStory } from '@/data/Pictorialist-Photography/story.ts';
// import { facingFAQ } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/faq.ts';

import { getLandingMeta } from '@/data/landingMeta.ts';

import '@/styles/global.css';

// ----------------------
// DYNAMIC IMAGE FEATHERING LOGIC
// ----------------------

const sectionPath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History";

type StorySection = {
  title?: string;
  subhead?: string;
  tagline?: string;
  paragraphs?: string[];
  list?: string[];
};

const westernStorySections = westernStory as unknown as StorySection[];
const mobileCount = westernStorySections.filter((block, i) => i > 0 && block.subhead).length;

const landingDescription =
  landingWestern.subtitle || (landingWestern as any)?.description || '';
const landingKeywords = Array.isArray((landingWestern as any)?.keywords)
  ? (landingWestern as any).keywords
  : [];

// --- COLLECT ALL DESCENDANT GALLERIES --- //
function collectGalleryHrefs(node) {
  let hrefs = [];
  if (node.href && node.href.startsWith('/Galleries/')) hrefs.push(node.href);
  if (node.children) node.children.forEach(child => hrefs.push(...collectGalleryHrefs(child)));
  return hrefs;
}

function findNavEntry(nav, url) {
  for (const entry of nav) {
    if (entry.href === url) return entry;
    if (entry.children) {
      const found = findNavEntry(entry.children, url);
      if (found) return found;
    }
  }
  return null;
}

const landingNav = findNavEntry(siteNav, sectionPath);
const galleryPaths = landingNav ? collectGalleryHrefs(landingNav) : [];

const allGalleryData = import.meta.glob<{ galleryData?: any[] }>('@/data/Galleries/**/*.mjs', { eager: true });
const galleryDatas = galleryPaths.map(path => {
  const filePath = `@/data/Galleries${path.replace(/^\/Galleries/, "")}.mjs`;
  return allGalleryData[filePath]?.galleryData ?? [];
});

const featheredImages = getSideImages({
  sectionPath,
  headingCount: mobileCount,
  poolMultiplier: 3
});

// 🟩 STRUCTURED DATA for this landing (uses all feathered images)
const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingWestern.title,
    description: landingDescription,
    url: `https://k4studios.com${sectionPath}`,
    keywords: landingKeywords,
    copyrightNotice: "© Wayne Heim"
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "© Wayne Heim",
    license: "https://k4studios.com/copyright",
    acquireLicensePage: "https://k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://k4studios.com/"
  }
});

// 🟢 OG/Twitter Meta Helper (auto-fills .ogUrl/.twitterUrl fields)
const landingMeta = getLandingMeta(sectionPath);
if (!landingMeta.ogUrl) landingMeta.ogUrl = `https://k4studios.com${sectionPath}`;
if (!landingMeta.twitterUrl) landingMeta.twitterUrl = `https://k4studios.com${sectionPath}`;
---

<!-- ✅ JSON-LD Structured Data for SEO -->
<script type="application/ld+json" is:inline set:html={structuredData}></script>

<!-- ✅ Article Structured Data for topical authority -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Pictorialist Photography: From 19th-Century Movement to Modern Painterly Fine Art",
  "author": {
    "@type": "Person",
    "name": "Wayne Heim"
  },
  "publisher": {
    "@type": "Organization",
    "name": "K4 Studios",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.k4studios.com/images/k4-logo.png"
    }
  },
  "description": "An in-depth explanation of pictorialist photography, its historical roots in the 19th century, and how its principles continue today through modern painterly fine art photography.",
  "mainEntityOfPage": "https://www.k4studios.com/Pictorialist-Photography"
}
</script>

<!-- ✅ FAQ Schema for AI citation -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is pictorialist photography?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pictorialist photography is an artistic movement that emerged in the late nineteenth century when photographers began rejecting the idea that a camera should simply record reality. Early pictorialists believed photography could function as fine art—capable of mood, interpretation, and emotional storytelling. The movement helped establish photography as a legitimate artistic medium, and modern pictorialist photography continues that tradition today."
      }
    },
    {
      "@type": "Question",
      "name": "How does Wayne Heim's approach differ from the historic Pictorialists?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wayne fuses traditional pictorialist principles—mood, texture, narrative intent—with digital technique and a storyteller's eye trained in medical illustration and fine art. The spirit is inherited; the execution is distinctly contemporary."
      }
    },
    {
      "@type": "Question",
      "name": "What is the connection between pictorialism and painterly photography?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Painterly photography descends directly from the pictorialist tradition. The principles are the same—atmosphere, interpretation, authorial craft—applied through contemporary tools and artistic vision. Pictorialism gave painterly photography its philosophical foundation and historical credibility."
      }
    },
    {
      "@type": "Question",
      "name": "How is modern pictorialist photography different from filters or AI effects?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every image is handcrafted from concept to print. There is no shortcut. The painterly quality comes from lived experience, emotional intent, and years of disciplined creative practice—not a slider or a preset."
      }
    },
    {
      "@type": "Question",
      "name": "Why does pictorialism matter today?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In a sea of mass-produced images, modern pictorialism is about authorship, vision, and making art that lingers—inviting viewers to pause, look again, and feel something that stays."
      }
    }
  ]
}
</script>

<BaseLayout
  title={`${landingWestern.title} – ${landingWestern.subtitle}`}
  meta={landingMeta}
>

  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingWestern.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingWestern.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4 pb-0">
      <div class="carousel-fade reveal-on-scroll">
        <ImageBar2 client:load />
      </div>
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">
          {landingWestern.title}
        </h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">
          {landingWestern.subtitle}
        </h2>
        <p class="page-summary fade-in reveal-on-scroll">
          Pictorialist photography is an artistic movement that began in the late nineteenth century and continues today through modern painterly fine art photography.
        </p>
        <p class="page-context-link fade-in reveal-on-scroll">
          In the American West, that legacy continues when a single frame is shaped to carry atmosphere, history, and implied story rather than record alone.
        </p>
      </div>
    </section>

    <div class="py-5">
      <TombstoneNav items={landingWestern.tombstones} />
    </div>

    <section class="story-layout">
      <div class="text-column">
        <section class="story-section">
          {westernStorySections.map((section) => (
            <article class="story-block">
              {section.title && (
                <h2 class="slide-in-left" set:html={autoLinkKeywordsInText(section.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
              )}
              {section.subhead && (
                <h3 class="slide-in-left" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
              )}
              {section.tagline && (
                <h4 class="tagline reveal-on-scroll" set:html={autoLinkKeywordsInText(section.tagline, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
              )}
              {section.paragraphs?.map((para) => (
                <p class="reveal-on-scroll" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
              ))}
              {section.list && section.list.length > 0 && (
                <ul>
                  {section.list.map((item) => (
                    <li class="reveal-on-scroll" set:html={autoLinkKeywordsInText(item, galleryDatas, featheredImages, galleryPaths, k4Semantic, Astro.url.pathname)} />
                  ))}
                </ul>
              )}
            </article>
          ))}
        </section>

        <MobileStoryImages client:only="react" images={sanitizeForClient(featheredImages)} displayCount={mobileCount} />
      </div>

      <div class="sidebar-column hidden md:block">
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages
            client:load
            heading="Collection Samples"
            images={featheredImages}
            displayCount={6}
          />
        </div>
      </div>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }
    });
  </script>
</BaseLayout>

<style>
  ul {
    list-style-type: disc;
    padding-left: 1.25em;
  }
  ul li {
    margin-top: 0.15em;
    margin-left: 1.5em;
  }
  ul li::marker {
    margin-top: 0.15em;
    font-size: 1.2em;
    color: gray;
  }
  @media (max-width: 768px) {
    .section-heading .page-title {
      font-size: 1.5rem;
      line-height: 1.3;
    }
    .section-heading .page-subtitle {
      max-width: 42ch;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
      font-size: 1rem;
      line-height: 1.4;
      letter-spacing: -0.04em;
    }
    .section-heading-wrap {
      margin-top: -4.5rem;
      margin-bottom: 1rem;
    }
    .sidebar-column {
      display: none;
    }
    .story-section {
      letter-spacing: -0.03em;
    }
    .story-block h2 {
      letter-spacing: -0.05em;
      font-size: 1.4rem !important;
      margin-top: -0.59rem;
      line-height: 1.15;
    }
  }
  .fade-in {
    opacity: 0;
    visibility: hidden;
    transform: translateY(1px);
    transition: opacity 1.75s ease, transform 1.75s ease, visibility .5s linear 1.75s;
  }
  .fade-in.is-visible {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }
  .page-title.fade-in {
    transition-delay: .2s;
  }
  .section-heading-wrap {
    margin: -3.8rem 0 1.5rem 0;
    text-align: center;
  }
  .section-heading .page-title {
    font-size: 2rem;
    margin-bottom: .4rem;
  }
  .section-heading .page-subtitle {
    font-size: 1rem;
    font-weight: 500;
    color: #6d5b4a;
    opacity: .9;
  }
  .section-heading .page-summary {
    font-size: 0.92rem;
    font-weight: 400;
    color: #7a6a5a;
    opacity: .85;
    width: min(100%, 760px);
    margin: 0.5rem auto 0;
    line-height: 1.5;
  }
  .story-section {
    line-height: 1.3;
    padding: 2rem 1.5rem;
    max-width: 860px;
    margin: 0 auto;
    font-family: 'Glegoo', serif;
  }
  .story-block {
    margin-bottom: 2.5rem;
  }
  .story-block h2 {
    font-weight: 500;
    font-size: 1.65rem;
    margin-bottom: 0.55rem;
  }
  .story-block h3 {
    font-weight: 500;
    font-size: 1.2rem;
    margin-top: -0.5rem;
    margin-bottom: -.025rem;
    color: #5a4a3b;
  }
  .story-block .tagline {
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 1rem;
    color: #7a6250;
  }
  .story-block p {
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 1rem;
  }
  .story-block ul {
    padding-left: 1.4rem;
    margin-top: 0.5rem;
  }
  .story-block li {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }
  .page-subtitle.fade-in {
    opacity: 0 !important;
    transform: translateY(-12px);
    visibility: hidden;
    transition:
      opacity 1.1s ease-out,
      transform 1.1s ease-out,
      visibility 0s linear 1.1s;
    transition-delay: 1s;
  }
  .page-subtitle.fade-in.is-visible {
    opacity: 1 !important;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 1s;
  }
  .carousel-fade {
    opacity: 0;
    transform: translateY(0px);
    transition:
      opacity 1.5s ease-out,
      transform 1.5s ease-out;
    transition-delay: 0.0s;
    visibility: hidden;
  }
  .sample-fade {
    opacity: 0;
    transform: translateY(0px);
    transition:
      opacity 1.5s ease-out,
      transform 1.5s ease-out;
    transition-delay: 0.2s;
    visibility: hidden;
    margin-top: -0.75rem;
  }
  .sample-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }
  .carousel-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }
</style>
