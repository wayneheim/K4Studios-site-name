---
export const prerender = true;
import BaseLayout         from '@/layouts/BaseLayout.astro';
import LandingHeader      from '@/components/Landing-Header.jsx';
import ImageBar2          from '@/components/ImageBar2.jsx';
// import FAQAccordion       from '@/components/FAQAccordion.jsx';
import SiteFooter         from '@/components/Footer.astro';
import { getStructuredData } from '@/components/utils/getStructuredData.ts';

import { getSideImages } from '@/components/utils/getSideImages.ts';

import { landingWestern } from '@/data/Pictorialist-Photography/landingstones.ts';
import { facingHistoryStory as westernStory } from '@/data/Pictorialist-Photography/story.ts';
// import { facingFAQ } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/faq.ts';

import { getLandingMeta } from '@/data/landingMeta.ts';

import '@/styles/global.css';

import { westernFineArtPage } from '@/data/doorway/western-fine-art';
import EditionGroupHeading from '@/components/gallery/EditionGroupHeading.astro';
import PrintSeriesIcon from '@/components/PrintSeriesIcon.jsx';
import { buildEditionCatalog } from '@/utils/editionCatalog.js';
import { extractImageId, getSemanticImageUrl } from '@/utils/imageProxy.js';
import { getArtworkAltForImageSource } from '@/utils/imageAltLookup';
import { resolveImageCommerce } from '@/data/commerceResolver.js';
import '@/styles/edition-catalog.css';


// ----------------------
// DYNAMIC IMAGE FEATHERING LOGIC
// ----------------------

const pagePath = "/Pictorialist-Photography";
const gallerySectionPath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History";

type StorySection = {
  title?: string;
  subhead?: string;
  tagline?: string;
  paragraphs?: string[];
  list?: string[];
};

const westernStorySections = westernStory as unknown as StorySection[];
const mobileCount = westernStorySections.filter((block, i) => i > 0 && block.subhead).length;

const landingDescription =
  (landingWestern as any)?.description || landingWestern.subtitle || '';
const landingKeywords = Array.isArray((landingWestern as any)?.keywords)
  ? (landingWestern as any).keywords
  : [];

const featheredImages = getSideImages({
  sectionPath: gallerySectionPath,
  headingCount: mobileCount,
  poolMultiplier: 3
});

const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingWestern.title,
    description: landingDescription,
    url: `https://www.k4studios.com${pagePath}`,
    keywords: landingKeywords,
    copyrightNotice: "Copyright Wayne Heim"
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "Copyright Wayne Heim",
    license: "https://www.k4studios.com/copyright",
    acquireLicensePage: "https://www.k4studios.com/licensing",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://www.k4studios.com/"
  }
});

// ðŸŸ¢ OG/Twitter Meta Helper (auto-fills .ogUrl/.twitterUrl fields)
const landingMeta = getLandingMeta(pagePath);
if (!landingMeta.ogUrl) landingMeta.ogUrl = `https://www.k4studios.com${pagePath}`;
if (!landingMeta.twitterUrl) landingMeta.twitterUrl = `https://www.k4studios.com${pagePath}`;

const faqItems = [
  {
    question: "What is pictorialist photography?",
    answer: "Pictorialist photography is a fine art photography movement that began in the late nineteenth century. It treats the photograph as an interpreted artwork shaped by mood, atmosphere, composition, tonal control, and the artist's hand rather than as a mechanical record alone.",
  },
  {
    question: "Who were important pictorialist photographers?",
    answer: "Important pictorialist photographers and related early art-photography figures include Alfred Stieglitz, Gertrude Kasebier, Edward Steichen, Clarence H. White, F. Holland Day, and Julia Margaret Cameron.",
  },
  {
    question: "What is the connection between pictorialism and painterly photography?",
    answer: "Painterly photography descends from the pictorialist tradition. Both approaches value atmosphere, interpretation, tonal control, and artistic authorship over literal documentation alone.",
  },
  {
    question: "How is modern pictorialist photography different from filters or AI effects?",
    answer: "Modern pictorialist photography is built through intentional process from concept to final print. A filter changes the surface of an image; pictorialism changes the purpose of the photograph by making interpretation, atmosphere, and authorship central.",
  },
  {
    question: "Why does pictorialism matter today?",
    answer: "Pictorialism matters today because photography is again being pushed beyond documentation. In a world of instant records, automated edits, and AI effects, pictorialism argues for authored photographs that carry mood, story, and fine art presence.",
  },
];


// Page-local reuse of the Western Fine Art grids; shared templates and copy stay untouched.
const siteOrigin = 'https://www.k4studios.com';
const gridTitles = ['Western Narratives Color', 'Western Narratives B/W', 'Cowboy Portraits Color', 'Cowboy Portraits B/W', 'Native American Portraits', 'Painterly Landscapes'];
const normalizedGridSections = [0, 4, 1, 5, 2, 3].map((sourceIndex, index) => {
  const section = westernFineArtPage.gridSections[sourceIndex];
  return {
    ...section,
    title: gridTitles[index],
    slug: gridTitles[index].toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    items: section.items.filter((image: any) => image?.id && image.id !== 'i-k4studios' && !['hidden', 'hide', 'ghost', 'non', 'none', ''].includes(String(image.visibility ?? 'show').trim().toLowerCase())),
  };
});
const cleanForDisplay = (value = '') => String(value).replace(/[\u0000-\u001F]+/g, ' ').replace(/\r?\n|\r/g, ' ').trim();
const getSectionProxySrc = (image: any, galleryPath: string, size = 'l') => getSemanticImageUrl(image, { galleryPath }, size);
const getCardSeries = (image: any, galleryPath: string) => resolveImageCommerce({ image, galleryPath, pageUrl: `${siteOrigin}${galleryPath}/${image.id}` })?.tiers || [];
const forceImageSize = (src = '', size = 's', galleryPath = '') => {
  const id = extractImageId(src);
  return id ? getSemanticImageUrl({ id }, { galleryPath }, size) : src;
};
const artworkAlt = (image: any) => `${cleanForDisplay(image.title)} - ${cleanForDisplay(image.alt || image.description)}`;
const artwork = (sectionIndex: number, id: string) => {
  const section = normalizedGridSections[sectionIndex];
  const image = section.items.find((item: any) => item.id === id);
  if (!image?.title || !image?.alt) throw new Error(`Missing pictorialist example: ${id}`);
  return { ...image, href: `${section.galleryPath}/${id}`, src: getSectionProxySrc(image, section.galleryPath), alt: artworkAlt(image) };
};
const openingExamples = [artwork(0, 'i-LCspRF4'), artwork(2, 'i-ncFcHDM'), artwork(5, 'i-SNtZNVm')];
const workedExamples: Record<string, Array<{ from: number; to: number; image: ReturnType<typeof artwork> }>> = {
  'Core Principles of Pictorialist Photography': [
    { from: 0, to: 2, image: artwork(0, 'i-gxMVNh3') },
    { from: 2, to: 4, image: artwork(4, 'i-rRdrQBg') },
    { from: 4, to: 5, image: artwork(2, 'i-k4b6c5b') },
  ],
  'Characteristics of Pictorialist Photography': [
    { from: 0, to: 2, image: artwork(2, 'i-QWcX7JT') },
    { from: 2, to: 3, image: artwork(5, 'i-G6gftd8') },
    { from: 3, to: 5, image: artwork(5, 'i-g7SCMTD') },
  ],
};
const stepInsideLinks = [
  { href: '/Painterly-Portrait-Photography', label: 'Painterly Portrait Photography' },
  { href: '/Painterly-Landscape-Photography', label: 'Painterly Landscape Photography' },
  { href: '/Painterly-Transportation-Photography', label: 'Painterly Transportation Photography' },
  { href: '/WWII-Photography', label: 'WWII Photography' },
  { href: '/Roaring-20s-Photography', label: 'Roaring 20s Photography' },
  { href: '/Western-Fine-Art', label: 'Western Fine Art' },
  { href: '/One-Image-Movie', label: 'One-Image Movie' },
];
// Lift answers from the frozen essay, preserving the original wording.
const essaySection = (heading: string) => westernStorySections.find(section => section.subhead === heading)!;
const modernQuestions = essaySection('Modern Pictorialism - Key Questions Answered').list!.map(item => {
  const [, question, answer] = item.match(/^<strong>(.*?)<\/strong><br\s*\/>(.*)$/)!;
  return { question, answers: [answer] };
});
const retainedQuestions = faqItems.filter(item => !['Who were important pictorialist photographers?', 'Why does pictorialism matter today?'].includes(item.question)).map(({ question, answer }) => ({ question, answers: [answer] }));
const liftedQuestions = [
  { question: 'What are some examples of pictorialist photography?', answers: [essaySection('What Is Modern Pictorialism Photography?').paragraphs![1], workedExamples['Core Principles of Pictorialist Photography'].map(({ image }) => `<a href="#example-${image.id}">${image.title}</a>`).join('; ')] },
  { question: 'Who are some famous pictorialists?', answers: [westernStorySections[0].paragraphs![2]] },
  { question: 'Why did pictorialism lose popularity?', answers: [essaySection('Why Pictorialism Still Matters').paragraphs![0]] },
  { question: 'Why was pictorialism controversial?', answers: [essaySection('A Brief History of Pictorialism').paragraphs![0], westernStorySections[0].paragraphs![2]] },
];
const mergedFaq = new Map<string, { question: string; answers: string[] }>();
for (const item of [...modernQuestions, ...retainedQuestions, ...liftedQuestions]) {
  const previous = mergedFaq.get(item.question);
  if (previous) previous.answers.push(...item.answers.filter(answer => !previous.answers.includes(answer)));
  else mergedFaq.set(item.question, { ...item, answers: [...item.answers] });
}
const visibleFaqItems = [...mergedFaq.values()];
const textOnly = (html: string) => html.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
const collectionItemList = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${siteOrigin}${pagePath}#itemlist`,
  itemListElement: normalizedGridSections.flatMap(section => buildEditionCatalog(section.items.slice(0, section.limit), image => getCardSeries(image, section.galleryPath)).orderedEntries.map(({ item }) => ({
    '@type': 'ListItem', name: cleanForDisplay(item.title), url: `${siteOrigin}${section.galleryPath}/${item.id}`,
  }))).map((item, index) => ({ ...item, position: index + 1 })),
}).replace(/</g, '\\u003c');

const truncateStoryExcerpt = (text: string, maxLen = 100) => {
  const cleaned = cleanForDisplay(text);
  if (!cleaned) return "";
  if (cleaned.length <= maxLen) return cleaned;
  const wordSafe = cleaned.slice(0, maxLen).replace(/\s+\S*$/, "").trimEnd();
  return `${wordSafe || cleaned.slice(0, maxLen).trimEnd()}...`;
};

const truncateBookendExcerpt = (text: string, headLen = 100, tailLen = 300) => {
  const cleaned = cleanForDisplay(text);
  if (!cleaned) return "";
  const totalLen = headLen + tailLen;
  if (cleaned.length <= totalLen) return cleaned;
  const head = cleaned.slice(0, headLen).replace(/\s+\S*$/, "").trimEnd();
  const tail = cleaned.slice(-tailLen).replace(/^\S+\s+/, "").trimStart();
  return `${head || cleaned.slice(0, headLen).trimEnd()}\u00a0.\u00a0.\u00a0.\u00a0\u00a0${tail || cleaned.slice(-tailLen).trimStart()}`;
};

const faqStructuredData = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage', '@id': `https://www.k4studios.com${pagePath}#faq`,
  mainEntity: visibleFaqItems.map(item => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answers.map(textOnly).join(' ') } })),
}).replace(/</g, '\\u003c');

const articleStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `https://www.k4studios.com${pagePath}#article`,
  headline: "What Is Pictorialist Photography? Definition, History, and Modern Pictorialism",
  author: {
    "@type": "Person",
    name: "Wayne Heim",
  },
  publisher: {
    "@type": "Organization",
    name: "K4 Studios",
    logo: {
      "@type": "ImageObject",
      url: "https://www.k4studios.com/images/k4-logo.png",
    },
  },
  description: "A definition and history of pictorialist photography, including major artists, core characteristics, historic printing methods, and its renewed relevance to modern painterly fine art photography.",
  mainEntityOfPage: `https://www.k4studios.com${pagePath}`,
});
---

<!-- JSON-LD Structured Data for SEO -->

<!-- Article Structured Data for topical authority -->

<!-- FAQ Schema for AI citation -->

<BaseLayout
  structuredDataJSON={structuredData}
  extraStructuredDataJSON={[articleStructuredData, faqStructuredData, collectionItemList]}
  title={`${landingWestern.title} - ${landingWestern.subtitle}`}
  meta={landingMeta}
>


  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingWestern.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingWestern.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4 pb-0">
      <div class="carousel-fade reveal-on-scroll">
        <ImageBar2 client:load />
      </div>
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">
          {landingWestern.title}
        </h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">
          {landingWestern.subtitle}
        </h2>
        <p class="page-summary fade-in reveal-on-scroll">
          Pictorialist photography began as a fine art movement in the late nineteenth century, arguing that a photograph could be interpreted, shaped, and finished as art rather than treated as a mechanical record. That argument feels newly relevant now, as photographers again push beyond documentation into authored, painterly, story-driven forms of photographic art.
        </p>
      </div>
    </section>

    <section class="story-section">
      {westernStorySections.map((section) => (
        <article class:list={['story-block', { 'story-block--collections': section.subhead === 'What Lives in These Galleries' }]} id={section.subhead === 'Core Principles of Pictorialist Photography' ? 'worked-examples' : section.subhead === 'Modern Pictorialism - Key Questions Answered' ? 'faq' : undefined}>
          {section.title && <h2 class="slide-in-left" set:html={section.title} />}
          {section.subhead && <h3 class="slide-in-left" set:html={section.subhead} />}
          {section.tagline && <h4 class="tagline reveal-on-scroll" set:html={section.tagline} />}
          {section.paragraphs?.map(para => <p class="reveal-on-scroll" set:html={para} />)}
          {section.subhead === 'A Short Definition' && (
            <div class="example-images" aria-label="Examples of modern pictorialist photography">
              {openingExamples.map((image, index) => (
                <figure>
                  <a href={image.href}><img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></a>
                  <figcaption><a href={image.href}>{image.title}</a></figcaption>
                </figure>
              ))}
            </div>
          )}
          {workedExamples[section.subhead || ''] ? workedExamples[section.subhead || ''].map(({ from, to, image }) => (
            <div class="painterly-focus-grid" id={`example-${image.id}`}>
              <figure class="painterly-focus-side">
                <a href={image.href}><img src={image.src} alt={image.alt} loading="lazy" decoding="async" /></a>
                <figcaption><a href={image.href}>{image.title}</a></figcaption>
              </figure>
              <ul class="painterly-focus-main">{section.list!.slice(from, to).map(item => <li set:html={item} />)}</ul>
            </div>
          )) : section.subhead === 'Modern Pictorialism - Key Questions Answered' ? (
            <div class="lesson-faq">
              {visibleFaqItems.map(item => (
                <details>
                  <summary>{item.question}</summary>
                  <div class="faq-answer">{item.answers.map(answer => <p set:html={answer} />)}</div>
                </details>
              ))}
            </div>
          ) : section.list?.length > 0 && <ul>{section.list.map(item => <li class="reveal-on-scroll" set:html={item} />)}</ul>}
          {section.subhead === 'What Lives in These Galleries' && (
            <div class="catalog-section-stack" id="collection-grid">
              {normalizedGridSections.map((section, sectionIndex) => {
                const sectionCatalog = buildEditionCatalog(section.items.slice(0, section.limit), item => getCardSeries(item, section.galleryPath));
                const sectionCount = section.items.length;
                const sectionKicker = `Selected Works - ${sectionCount} in Series`;
                const thumbId = extractImageId(section.ctaThumb);
                const thumbImage = normalizedGridSections.flatMap(group => group.items).find(item => item.id === thumbId);
                const sectionCtaAlt = thumbImage ? artworkAlt(thumbImage) : getArtworkAltForImageSource(section.ctaThumb, section.title);
                return (
              <section class="catalog-gallery-section" id={`section-${section.slug}`} aria-labelledby={`catalog-section-heading-${sectionIndex + 1}`}>
                <div class="catalog-section-heading">
                  {section.timeZone && <p class="catalog-section-timezone">{section.timeZone}</p>}
                  <p class="catalog-section-kicker">{sectionKicker}</p>
                  <h2 id={`catalog-section-heading-${sectionIndex + 1}`}>{section.title}</h2>
                  {section.description && <p>{section.description}</p>}
                </div>

                <div class="ssr-grid ssr-grid--catalog-section">
                  {sectionCatalog.orderedEntries.map(({ item, idx, cardSeries, openEditionOnly }, displayIndex: number) => {
                  const imageUrl = getSectionProxySrc(item, section.galleryPath, 's');
                  const srcsetParts = [
                    `${getSectionProxySrc(item, section.galleryPath, 's')} 400w`,
                    `${getSectionProxySrc(item, section.galleryPath, 'm')} 600w`
                  ].join(", ");
                  const linkUrl = `${section.galleryPath}/${item.id}`;
                  const collectorNotesHref = `${linkUrl}#collector-notes`;
                  const title = cleanForDisplay(item.title);

                  let altText: string;
                  if (item.alt) {
                    altText = cleanForDisplay(item.alt);
                  } else if (item.description) {
                    const firstSentence = item.description.split(/[.!?]/)[0];
                    altText = cleanForDisplay(firstSentence.slice(0, 150));
                  } else if (item.keywords?.length > 0) {
                    const topKeywords = item.keywords.slice(0, 4).join(", ");
                    altText = `Western wall art photograph: ${topKeywords}`;
                  } else {
                    altText = `Western wall art print: ${title} by Wayne Heim`;
                  }

                  const storyExcerpt = truncateStoryExcerpt(item.story || "", 100);
                  const collectorNoteRaw = item.description || "";
                  const collectorNoteTeaser = truncateBookendExcerpt(collectorNoteRaw, 100, 300);
                  const cardSeriesKeys = cardSeries.map((series: any) => series.key).join(' ');

                  return (
                    <>
                    {!sectionCatalog.hasSplit && displayIndex === 0 && Number.isFinite(sectionCatalog.openPrice) && <EditionGroupHeading kind="open" price={sectionCatalog.openPrice} anchorId={'open-edition-prints-' + section.slug} />}
                    {!sectionCatalog.hasSplit && displayIndex === 0 && Number.isFinite(sectionCatalog.limitedPrice) && <EditionGroupHeading title="Limited Edition Prints" kind="limited" price={sectionCatalog.limitedPrice} />}
                    {sectionCatalog.hasSplit && displayIndex === 0 && <EditionGroupHeading title="Limited Edition Prints" kind="limited" price={sectionCatalog.limitedPrice} />}
                    {sectionCatalog.hasSplit && displayIndex === sectionCatalog.limitedCount && <EditionGroupHeading kind="open" price={sectionCatalog.openPrice} anchorId={'open-edition-prints-' + section.slug} />}
                    <div
                      class:list={["ssr-card", { "ssr-card--open-edition": openEditionOnly }]}
                      id={`${sectionIndex + 1}-${item.id}`}
                      data-artwork-number={idx + 1}
                      data-original-index={idx}
                      data-series={cardSeriesKeys}
                      data-edition-group={openEditionOnly ? "open" : "limited"}
                      data-title={title}
                    >
                      <a
                        href={linkUrl}
                        class="ssr-card-link"
                        data-context-image-link
                        data-image-id={item.id}
                        data-gallery-id={section.galleryPath}
                        data-artwork-number={idx + 1}
                      >
                        <img
                          class="ssr-card-image"
                          src={imageUrl}
                          srcset={srcsetParts || undefined}
                          sizes="(max-width: 520px) calc(100vw - 32px), (max-width: 768px) calc((100vw - 48px) / 2), 250px"
                          alt={`${title} - ${altText}`}
                          loading="lazy"
                          decoding="async"
                          fetchpriority="low"
                        />
                        <div class="ssr-card-content">
                          <div class="card-meta-row">
                            <span class="card-number">Image {idx + 1} of {sectionCount}</span>
                            {cardSeries.length > 0 && (
                              <span class="card-series-strip" aria-label="Available print series">
                                {cardSeries.map((series: any, seriesIdx: number) => (
                                  <>
                                    <span
                                      class="card-series-icon"
                                      title={`${series.label} Series Member`}
                                      aria-label={`${series.label} Series Member`}
                                    >
                                      <PrintSeriesIcon seriesKey={series.key} />
                                    </span>
                                    {seriesIdx < cardSeries.length - 1 && <span class="card-series-separator" aria-hidden="true">|</span>}
                                  </>
                                ))}
                              </span>
                            )}
                          </div>
                          <h3>{title}</h3>
                          <p class="print-cue sr-only">Fine art print available</p>
                          {storyExcerpt && <p class="story-excerpt">{storyExcerpt}</p>}
                          <span class="card-cta">
                            <span class="card-cta-desktop">Explore Story | Order Fine Art Print &rarr;</span>
                            <span class="card-cta-mobile">Explore Story | Order</span>
                          </span>
                        </div>
                      </a>
                      <button
                        type="button"
                        class="collector-notes-trigger"
                        data-notes-trigger
                        aria-label="View image description preview"
                      >
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 18v-6a5 5 0 0 1 10 0v6" />
                  <path d="M5 21v-1a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1" />
                  <path d="M12 14v4" />
                  <path d="M12 2v2" />
                  <path d="M4.93 4.93 6.34 6.34" />
                  <path d="M19.07 4.93 17.66 6.34" />
                  <path d="M2 12h2" />
                  <path d="M20 12h2" />
                </svg>
                      </button>
                      <div class="collector-note-overlay" data-notes-overlay>
                        <p class="collector-note-kicker">Image Description</p>
                        <p class="collector-note-teaser">{collectorNoteTeaser || "Image description preview available for this artwork."}</p>
                        <a class="collector-note-link" href={collectorNotesHref}>View full image and details &rarr;</a>
                      </div>
                    </div>
                    </>
                  );
                })}

                {section.alternateCtaHref ? (
                  <div class="ssr-card catalog-collection-cta catalog-collection-cta--split">
                    <a class="catalog-collection-cta__inner catalog-collection-cta__primary" href={section.allHref}>
                        {section.ctaThumb && (
                          <span class="catalog-collection-cta__tombstone" aria-hidden="true">
                            <img src={forceImageSize(section.ctaThumb, 's', section.galleryPath)} alt={sectionCtaAlt} loading="lazy" decoding="async" />
                          </span>
                        )}
                        <span class="catalog-collection-cta__kicker">Full Collection</span>
                        <strong>{section.ctaLabel || `See all ${section.title}`}</strong>
                        <small>{sectionCount} works in this gallery</small>
                    </a>
                    <a class="catalog-collection-cta__alternate" href={section.alternateCtaHref}>
                      <span>{section.alternateCtaKicker || "Alternative View"}</span>
                      <strong>{section.alternateCtaLabel || "See the black and white collection"}</strong>
                      {section.alternateCtaCount && <small>{section.alternateCtaCount}</small>}
                    </a>
                  </div>
                ) : (
                  <a class="ssr-card catalog-collection-cta" href={section.allHref}>
                    <span class="catalog-collection-cta__inner">
                      {section.ctaThumb && (
                        <span class="catalog-collection-cta__tombstone" aria-hidden="true">
                          <img src={forceImageSize(section.ctaThumb, 's', section.galleryPath)} alt={sectionCtaAlt} loading="lazy" decoding="async" />
                        </span>
                      )}
                      <span class="catalog-collection-cta__kicker">Full Collection</span>
                      <strong>{section.ctaLabel || `See all ${section.title}`}</strong>
                      <small>{sectionCount} works in this gallery</small>
                    </span>
                  </a>
                )}
                </div>
              </section>
                );
              })}
            </div>
          )}
          {section.subhead === 'Step Inside' && <p class="step-inside-links">{stepInsideLinks.map((link, index) => <>{index > 0 && ' | '}<a href={link.href}>{link.label}</a></>)}</p>}
        </article>
      ))}
    </section>

