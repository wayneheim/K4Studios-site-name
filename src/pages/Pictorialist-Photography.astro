---
export const prerender = true;
import BaseLayout         from '@/layouts/BaseLayout.astro';
import LandingHeader      from '@/components/Landing-Header.jsx';
import ImageBar2          from '@/components/ImageBar2.jsx';
import TombstoneNav       from '@/components/TombstoneNav.jsx';
import LandingRightImages from '@/components/LandingRightImages.jsx';
// import FAQAccordion       from '@/components/FAQAccordion.jsx';
import SiteFooter         from '@/components/Footer.astro';
import MobileStoryImages  from '@/components/MobileStoryImages.jsx';
import { getStructuredData } from '@/components/utils/getStructuredData.ts';

import { getSideImages } from '@/components/utils/getSideImages.ts';
import { sanitizeForClient } from '@/components/utils/normalizeImage.ts';

import { landingWestern } from '@/data/Pictorialist-Photography/landingstones.ts';
import { facingHistoryStory as westernStory } from '@/data/Pictorialist-Photography/story.ts';
// import { facingFAQ } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/faq.ts';

import { getLandingMeta } from '@/data/landingMeta.ts';

import '@/styles/global.css';

// ----------------------
// DYNAMIC IMAGE FEATHERING LOGIC
// ----------------------

const pagePath = "/Pictorialist-Photography";
const gallerySectionPath = "/Galleries/Painterly-Fine-Art-Photography/Facing-History";

type StorySection = {
  title?: string;
  subhead?: string;
  tagline?: string;
  paragraphs?: string[];
  list?: string[];
};

const westernStorySections = westernStory as unknown as StorySection[];
const mobileCount = westernStorySections.filter((block, i) => i > 0 && block.subhead).length;

const landingDescription =
  (landingWestern as any)?.description || landingWestern.subtitle || '';
const landingKeywords = Array.isArray((landingWestern as any)?.keywords)
  ? (landingWestern as any).keywords
  : [];

const featheredImages = getSideImages({
  sectionPath: gallerySectionPath,
  headingCount: mobileCount,
  poolMultiplier: 3
});

const structuredData = getStructuredData({
  type: "gallery",
  data: {
    title: landingWestern.title,
    description: landingDescription,
    url: `https://www.k4studios.com${pagePath}`,
    keywords: landingKeywords,
    copyrightNotice: "Copyright Wayne Heim"
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: "Copyright Wayne Heim",
    license: "https://www.k4studios.com/copyright",
    acquireLicensePage: "https://www.k4studios.com/Other/Print-Options",
    creditText: "Wayne Heim",
    creatorName: "Wayne Heim",
    creatorUrl: "https://www.k4studios.com/"
  }
});

// ðŸŸ¢ OG/Twitter Meta Helper (auto-fills .ogUrl/.twitterUrl fields)
const landingMeta = getLandingMeta(pagePath);
if (!landingMeta.ogUrl) landingMeta.ogUrl = `https://www.k4studios.com${pagePath}`;
if (!landingMeta.twitterUrl) landingMeta.twitterUrl = `https://www.k4studios.com${pagePath}`;

const faqItems = [
  {
    question: "What is pictorialist photography?",
    answer: "Pictorialist photography is a fine art photography movement that began in the late nineteenth century. It treats the photograph as an interpreted artwork shaped by mood, atmosphere, composition, tonal control, and the artist's hand rather than as a mechanical record alone.",
  },
  {
    question: "Who were important pictorialist photographers?",
    answer: "Important pictorialist photographers and related early art-photography figures include Alfred Stieglitz, Gertrude Kasebier, Edward Steichen, Clarence H. White, F. Holland Day, and Julia Margaret Cameron.",
  },
  {
    question: "What is the connection between pictorialism and painterly photography?",
    answer: "Painterly photography descends from the pictorialist tradition. Both approaches value atmosphere, interpretation, tonal control, and artistic authorship over literal documentation alone.",
  },
  {
    question: "How is modern pictorialist photography different from filters or AI effects?",
    answer: "Modern pictorialist photography is built through intentional craft from concept to final print. A filter changes the surface of an image; pictorialism changes the purpose of the photograph by making interpretation, atmosphere, and authorship central.",
  },
  {
    question: "Why does pictorialism matter today?",
    answer: "Pictorialism matters today because photography is again being pushed beyond documentation. In a world of instant records, automated edits, and AI effects, pictorialism argues for authored photographs that carry mood, story, and fine art presence.",
  },
];

function dedupeFaq(items: typeof faqItems) {
  const seen = new Set<string>();
  return items.filter((item) => {
    const key = item.question.trim().toLowerCase();
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

const faqStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `https://www.k4studios.com${pagePath}#faq`,
  mainEntity: dedupeFaq(faqItems).map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
});

const articleStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `https://www.k4studios.com${pagePath}#article`,
  headline: "What Is Pictorialist Photography? Definition, History, and Modern Pictorialism",
  author: {
    "@type": "Person",
    name: "Wayne Heim",
  },
  publisher: {
    "@type": "Organization",
    name: "K4 Studios",
    logo: {
      "@type": "ImageObject",
      url: "https://www.k4studios.com/images/k4-logo.png",
    },
  },
  description: "A definition and history of pictorialist photography, including major artists, core characteristics, historic printing methods, and its renewed relevance to modern painterly fine art photography.",
  mainEntityOfPage: `https://www.k4studios.com${pagePath}`,
});
---

<!-- JSON-LD Structured Data for SEO -->

<!-- Article Structured Data for topical authority -->

<!-- FAQ Schema for AI citation -->

<BaseLayout
  structuredDataJSON={structuredData}
  extraStructuredDataJSON={[articleStructuredData, faqStructuredData]}
  title={`${landingWestern.title} - ${landingWestern.subtitle}`}
  meta={landingMeta}
>


  <main class="bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landingWestern.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landingWestern.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4 pb-0">
      <div class="carousel-fade reveal-on-scroll">
        <ImageBar2 client:load />
      </div>
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">
          {landingWestern.title}
        </h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">
          {landingWestern.subtitle}
        </h2>
        <p class="page-summary fade-in reveal-on-scroll">
          Pictorialist photography began as a fine art movement in the late nineteenth century, arguing that a photograph could be interpreted, crafted, and finished as art rather than treated as a mechanical record. That argument feels newly relevant now, as photographers again push beyond documentation into authored, painterly, story-driven forms of photographic art.
        </p>
      </div>
    </section>

    <div class="py-5">
      <TombstoneNav items={landingWestern.tombstones} />
    </div>

    <section class="story-layout">
      <div class="text-column">
        <section class="story-section">
          {westernStorySections.map((section) => (
            <article class="story-block">
              {section.title && (
                <h2 class="slide-in-left" set:html={section.title} />
              )}
              {section.subhead && (
                <h3 class="slide-in-left" set:html={section.subhead} />
              )}
              {section.tagline && (
                <h4 class="tagline reveal-on-scroll" set:html={section.tagline} />
              )}
              {section.paragraphs?.map((para) => (
                <p class="reveal-on-scroll" set:html={para} />
              ))}
              {section.list && section.list.length > 0 && (
                <ul>
                  {section.list.map((item) => (
                    <li class="reveal-on-scroll" set:html={item} />
                  ))}
                </ul>
              )}
            </article>
          ))}
        </section>

        <MobileStoryImages client:only="react" images={sanitizeForClient(featheredImages) as any} displayCount={3} />
      </div>

      <div class="sidebar-column hidden md:block">
        <div class="sample-fade reveal-on-scroll">
          <LandingRightImages
            client:load
            heading="Collection Samples"
            images={sanitizeForClient(featheredImages) as any}
            displayCount={3}
          />
        </div>
      </div>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }
    });
  </script>
  <style is:global>
    .carousel-fade {
      min-height: 410px !important;
    }
    .carousel-trim--bottom {
      bottom: 4px !important;
    }
    @media (max-width: 768px) {
      .carousel-fade {
        min-height: 220px !important;
      }
      .carousel-trim--bottom {
        bottom: 4px !important;
      }
    }
  </style>

<style>
  ul {
    list-style-type: disc;
    padding-left: 1.25em;
  }
  ul li {
    margin-top: 0.15em;
    margin-left: 1.5em;
  }
  ul li::marker {
    margin-top: 0.15em;
    font-size: 1.2em;
    color: gray;
  }
  @media (max-width: 768px) {
    .section-heading .page-title {
      font-size: 1.5rem;
      line-height: 1.3;
    }
    .section-heading .page-subtitle {
      max-width: 42ch;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
      font-size: 1rem;
      line-height: 1.4;
      letter-spacing: -0.04em;
    }
    .section-heading-wrap {
      margin-top: -4.5rem;
      margin-bottom: 1rem;
    }
    .sidebar-column {
      display: none;
    }
    .story-section {
      letter-spacing: -0.03em;
    }
    .story-block h2 {
      letter-spacing: -0.05em;
      font-size: 1.4rem !important;
      margin-top: -0.59rem;
      line-height: 1.15;
    }
  }
  .fade-in {
    opacity: 0;
    visibility: hidden;
    transform: translateY(1px);
    transition: opacity 1.75s ease, transform 1.75s ease, visibility .5s linear 1.75s;
  }
  .fade-in.is-visible {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }
  .page-title.fade-in {
    transition-delay: .2s;
  }
  .section-heading-wrap {
    margin: -3.8rem 0 1.5rem 0;
    text-align: center;
  }
  .section-heading .page-title {
    font-size: 2rem;
    margin-bottom: .4rem;
  }
  .section-heading .page-subtitle {
    font-size: 1rem;
    font-weight: 500;
    color: #6d5b4a;
    opacity: .9;
  }
  .section-heading .page-summary {
    font-size: 0.92rem;
    font-weight: 400;
    color: #7a6a5a;
    opacity: .85;
    width: min(100%, 760px);
    margin: 0.5rem auto 0;
    line-height: 1.5;
  }
  .story-section {
    line-height: 1.3;
    padding: 2rem 1.5rem;
    max-width: 860px;
    margin: 0 auto;
    font-family: 'Glegoo', serif;
  }
  .story-block {
    margin-bottom: 2.5rem;
  }
  .story-block h2 {
    font-weight: 500;
    font-size: 1.65rem;
    margin-bottom: 0.55rem;
  }
  .story-block h3 {
    font-weight: 500;
    font-size: 1.2rem;
    margin-top: -0.5rem;
    margin-bottom: -.025rem;
    color: #5a4a3b;
  }
  .story-block .tagline {
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 1rem;
    color: #7a6250;
  }
  .story-block p {
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 1rem;
  }
  .story-block ul {
    padding-left: 1.4rem;
    margin-top: 0.5rem;
  }
  .story-block li {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }
  .page-subtitle.fade-in {
    opacity: 0 !important;
    transform: translateY(-12px);
    visibility: hidden;
    transition:
      opacity 1.1s ease-out,
      transform 1.1s ease-out,
      visibility 0s linear 1.1s;
    transition-delay: 1s;
  }
  .page-subtitle.fade-in.is-visible {
    opacity: 1 !important;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 1s;
  }
  .carousel-fade {
    opacity: 0;
    transform: translateY(0px);
    transition:
      opacity 1.5s ease-out,
      transform 1.5s ease-out;
    transition-delay: 0.0s;
    visibility: hidden;
  }
  .sample-fade {
    opacity: 0;
    transform: translateY(0px);
    transition:
      opacity 1.5s ease-out,
      transform 1.5s ease-out;
    transition-delay: 0.2s;
    visibility: hidden;
    margin-top: -0.75rem;
  }
  .sample-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }
  .carousel-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }
</style>
</BaseLayout>
