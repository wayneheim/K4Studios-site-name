---
import { getSemanticImageUrl } from '@/utils/imageProxy.js';

interface Props {
  images: {
    id: string;
    title?: string;
    alt?: string;
    src: string;
    visibility?: string;
    galleryPath: string;
  }[];
  limit?: number;
  label?: string;
}

const { images, limit = 6, label = "Explore Galleries" } = Astro.props;

const visibleImages = images.filter(img => img.visibility !== "ghost").slice(0, limit);
const middleIndex = Math.floor(visibleImages.length / 2);
---

<section class="gallery-preview-strip" aria-label="Blog gallery preview strip">
<style>
  .gallery-preview-strip {
    margin-top: 2.5rem;
    padding: 1rem 0;
    opacity: 0;
    animation: fadeStripIn 0.4s ease forwards;
    animation-delay: 850ms;
    max-width: 100%;
    overflow: hidden;
    min-width: 0;
  }

  @keyframes fadeStripIn { to { opacity: 1; } }

  .gallery-label-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    min-width: 0;
    padding: 0 0.25rem;
  }

  .gallery-label {
    font-size: 1.2rem;
    font-weight: 500;
    color: #444;
    font-family: 'Glegoo', serif;
    opacity: 0;
    animation: fadeLabelIn 0.75s ease-out forwards;
    animation-delay: 600ms;
    max-width: 100%;
    text-align: center;
    white-space: normal;
    overflow-wrap: anywhere;
    line-height: 1.35;
  }

  .gallery-hr {
    display: inline-block;
    height: 1px;
    background-color: #ccc;
    flex-grow: 1;
    max-width: 300px;
    transform: scaleX(0);
    opacity: 0;
  }

  .gallery-hr-left {
    transform-origin: right;
    animation: lineGrowLeft 1.2s ease-out forwards;
    animation-delay: 1200ms;
  }

  .gallery-hr-right {
    transform-origin: left;
    animation: lineGrowRight 1.2s ease-out forwards;
    animation-delay: 1200ms;
  }

  @keyframes fadeLabelIn { to { opacity: 0.75; } }
  @keyframes lineGrowLeft { to { transform: scaleX(1); opacity: 1; } }
  @keyframes lineGrowRight { to { transform: scaleX(1); opacity: 1; } }

  .gallery-strip {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    gap: 1rem;
    justify-content: flex-start;
    padding: 0 1rem;
    max-width: 100%;
    box-sizing: border-box;
    scrollbar-width: none;
    min-width: 0;
  }
  .gallery-strip::-webkit-scrollbar { display: none; }
  @media (min-width: 640px) {
    .gallery-strip { justify-content: center; }
  }

  .gallery-thumb {
    flex: 0 0 auto;
    width: 110px;
    height: 110px;
    border-radius: 6px;
    overflow: hidden;
    display: block;
    border: 2px solid #ccc;
    opacity: 0;
    transform: scale(0.95);
    animation: fadeInCenter 2s ease forwards;
    contain: content;
    will-change: transform, opacity;
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 540px) {
    .gallery-preview-strip {
      margin-top: 2rem;
      padding: 0.75rem 0;
    }

    .gallery-label-frame {
      gap: 0.45rem;
    }

    .gallery-label {
      font-size: 1rem;
      flex: 1 1 auto;
    }

    .gallery-hr {
      flex: 1 1 28px;
      min-width: 24px;
    }

    .gallery-strip {
      gap: 0.75rem;
      padding: 0 0.25rem;
    }

    .gallery-thumb {
      width: clamp(82px, 25vw, 104px);
      height: clamp(82px, 25vw, 104px);
    }
  }

  .anim-left { animation-name: fadeSlideLeft; }
  .anim-right { animation-name: fadeSlideRight; }
  .anim-center { animation-name: fadeInCenter; }

  @keyframes fadeInCenter { to { opacity: 1; transform: scale(1); } }
  @keyframes fadeSlideLeft {
    0% { opacity: 0; transform: translateX(30px) scale(0.9); }
    100% { opacity: 1; transform: translateX(0) scale(1); }
  }
  @keyframes fadeSlideRight {
    0% { opacity: 0; transform: translateX(-30px) scale(0.9); }
    100% { opacity: 1; transform: translateX(0) scale(1); }
  }
</style>
  <div class="gallery-label-frame">
    <span class="gallery-hr gallery-hr-left" />
    <span class="gallery-label">{label}</span>
    <span class="gallery-hr gallery-hr-right" />
  </div>

  <div class="gallery-strip">
    {visibleImages.map((img, index) => {
      const offset = index - middleIndex;
      const delay = Math.abs(offset) * 100 + 400;
      const direction = offset === 0 ? "center" : offset < 0 ? "left" : "right";
      return (
        <a
          href={`/${img.galleryPath}/${img.id}`}
          class={`gallery-thumb anim-${direction}`}
          title={img.title ?? img.alt ?? "Gallery image"}
          style={`animation-delay: ${delay}ms`}
        >
          <img
            src={getSemanticImageUrl(img, { galleryPath: img.galleryPath }, 's')}
            alt={img.alt ?? img.title ?? "Gallery image"}
            loading="lazy"
          />
        </a>
      );
    })}
  </div>
</section>
