---
import GalleryShellCore from '@/components/GalleryShellCore.astro';
import ChapterViewer from '@/components/Chapter-WesternNarrativesColor.jsx';
import ChapterViewerDirect from '@/components/ChapterWesternNarrativesColorDirect.jsx';
import { galleryData as allImages } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color.mjs';
import { landingWestern as landingData } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/landingstones.ts';
import * as visualIndexModule from '@/data/visualIndex.json';
import { getSemanticImageUrl } from '@/utils/imageProxy.js';

const GALLERY_PATH = '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Western-Narratives/Color';
const FALLBACK_DESCRIPTION = 'Explore painterly Western narrative photography in color by Wayne Heim.';
const visualIndex = visualIndexModule.default || visualIndexModule;
const DIRECT_IMAGE_DIMENSIONS = {
  "i-7Mzzbvp": { width: 1024, height: 709 },
};

const { breadcrumb, entranceData, initialImageId } = Astro.props;
const shouldSsrChapterViewer = Boolean(initialImageId && initialImageId !== "i-k4studios") || Astro.url.searchParams.get("view") === "grid";
const isDirectImagePage = Boolean(initialImageId && initialImageId !== "i-k4studios");

function isNavigableImage(img) {
  const visibility = String(img?.visibility || '').toLowerCase().trim();
  return Boolean(img?.id) && visibility !== 'ghost' && visibility !== 'hidden' && visibility !== 'hide';
}

function toDirectImage(entry) {
  if (!entry) return null;
  const visualMeta = visualIndex?.[entry.id] || DIRECT_IMAGE_DIMENSIONS[entry.id] || {};
  const {
    src,
    srcS,
    srcM,
    srcL,
    srcXL,
    srcOriginal,
    image,
    imageUrl,
    url,
    thumb,
    preview,
    keywords,
    galleries,
    ...safeEntry
  } = entry;

  return {
    ...safeEntry,
    width: entry.width || visualMeta.width,
    height: entry.height || visualMeta.height,
    src: getSemanticImageUrl(entry, { galleryPath: GALLERY_PATH }, 'm'),
  };
}

const navigableImages = allImages.filter(isNavigableImage);
const currentIndex = isDirectImagePage
  ? navigableImages.findIndex((img) => img.id === initialImageId)
  : -1;
const currentImage = currentIndex >= 0 ? navigableImages[currentIndex] : null;
const prevImage = currentIndex > 0 ? navigableImages[currentIndex - 1] : null;
const nextImage = currentIndex >= 0 && currentIndex < navigableImages.length - 1
  ? navigableImages[currentIndex + 1]
  : null;
const directImagePayload = currentImage
  ? {
      currentImage: toDirectImage(currentImage),
      prevImage: toDirectImage(prevImage),
      nextImage: toDirectImage(nextImage),
      index: currentIndex,
      totalCount: navigableImages.length,
      galleryMeta: {
        title: "WILD-WEST: Western Narratives",
        basePath: GALLERY_PATH,
        chapterName: "Western Narratives - Color",
        sectionName: "Wild West",
      },
    }
  : null;

---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  {directImagePayload ? (
    <ChapterViewerDirect
      slot="chapter-viewer"
      client:load
      initialImageId={initialImageId}
      directImagePayload={directImagePayload}
    />
  ) : shouldSsrChapterViewer ? (
    <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId} />
  ) : (
    <ChapterViewer slot="chapter-viewer" client:only="react" initialImageId={initialImageId} />
  )}
</GalleryShellCore>
