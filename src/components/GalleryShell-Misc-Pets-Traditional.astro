---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Misc-Pets-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Miscellaneous/Pets.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Miscellaneous/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Miscellaneous/Pets";
const FALLBACK_DESCRIPTION = "Explore traditional fine art pet photography by Wayne Heim. Beloved companions captured with artistry and warmth.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId || "i-k4studios"} />
</GalleryShellCore>
