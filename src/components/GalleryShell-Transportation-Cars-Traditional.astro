---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Transportation-Cars-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Transportation/Cars.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Transportation/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Transportation/Cars";
const FALLBACK_DESCRIPTION = "Explore traditional fine art car and automobile photography by Wayne Heim. Classic vehicles, vintage trucks, and automotive art.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId || "i-k4studios"} />
</GalleryShellCore>
