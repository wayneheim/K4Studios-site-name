---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Portraits-Black-White-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Portraits/Black-White.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Portraits/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Portraits/Black-White";
const FALLBACK_DESCRIPTION = "Explore traditional black and white fine art portrait photography by Wayne Heim. Timeless character studies with dramatic lighting.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
const shouldSsrChapterViewer = Boolean(initialImageId && initialImageId !== "i-k4studios") || Astro.url.searchParams.get("view") === "grid";

---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  {shouldSsrChapterViewer ? (
    <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId} />
  ) : (
    <ChapterViewer slot="chapter-viewer" client:only="react" initialImageId={initialImageId} />
  )}
</GalleryShellCore>
