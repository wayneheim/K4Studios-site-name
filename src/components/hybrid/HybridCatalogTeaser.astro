---
/**
 * HybridCatalogTeaser.astro
 *
 * A 3×4 teaser grid (12 images) for Hybrid Hub pages.
 * Clean thumbnails via proxy /img/{id}/m, title only, links to individual artwork.
 * Followed by a "Explore the Full Collection →" footer link.
 *
 * Props:
 *   heading        — Section heading
 *   subheading     — Optional subheading (plain text)
 *   subheadingHtml — Optional subheading (HTML string, for inline links)
 *   images         — Array of { id, title, alt?, href? } (12 items)
 *   galleryHref    — URL for the "Explore Full Collection" CTA
 *   galleryLabel   — CTA text (default: "Explore the Full Collection →")
 */
interface CatalogImage {
  id: string;
  title: string;
  alt?: string;
  href?: string;
}
interface Props {
  heading?: string;
  subheading?: string;
  subheadingHtml?: string;
  images: CatalogImage[];
  galleryHref: string;
  galleryLabel?: string;
}

const {
  heading = "Notable Works from the Western Fine Art Collection",
  subheading = "A curated selection drawn from our larger archive of limited edition works.",
  subheadingHtml,
  images,
  galleryHref,
  galleryLabel = "Explore the Full Collection →",
} = Astro.props;

const getProxySrc = (id: string, size: string) => `/img/${id}/${size}.jpg`;
---

<section class="hybrid-catalog reveal-on-scroll">
  <h2 class="hybrid-catalog__heading">{heading}</h2>
  {subheadingHtml ? (
    <p class="hybrid-catalog__subheading" set:html={subheadingHtml} />
  ) : (
    <p class="hybrid-catalog__subheading">{subheading}</p>
  )}
  <div class="hybrid-catalog__grid">
    {images.map((img) => (
      <a
        href={img.href || `${galleryHref}/${img.id}`}
        class="hybrid-catalog__card"
        aria-label={`View "${img.title}"`}
      >
        <div class="hybrid-catalog__thumb-wrap">
          <img
            src={getProxySrc(img.id, "m")}
            alt={img.alt || img.title}
            width="400"
            height="280"
            loading="lazy"
            decoding="async"
          />
          <div class="hybrid-catalog__hover-cta">View Details &amp; Editions →</div>
        </div>
        <span class="hybrid-catalog__title">{img.title}</span>
      </a>
    ))}
  </div>
  <div class="hybrid-catalog__footer">
    <a href={galleryHref} class="hybrid-catalog__cta">{galleryLabel}</a>
  </div>
</section>

<style>
  .hybrid-catalog {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 2rem;
    font-family: 'Glegoo', serif;
    border-top: 1px solid #e8e2da;
  }

  .hybrid-catalog__heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.18rem;
    line-height: 1.3;
    text-align: center;
  }

  .hybrid-catalog__subheading {
    font-size: 0.88rem;
    color: #6b5c4e;
    text-align: center;
    margin: 0 0 1.65rem;
    font-style: italic;
    letter-spacing: 0.01em;
  }

  .hybrid-catalog__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.7rem;
  }

  .hybrid-catalog__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    overflow: hidden;
    background: #f9f7f4;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    transition: box-shadow 0.25s ease;
  }
  .hybrid-catalog__card:hover {
    box-shadow: 0 4px 14px rgba(0,0,0,0.10);
  }

  .hybrid-catalog__thumb-wrap {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    position: relative;
  }

  .hybrid-catalog__hover-cta {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 4;
    background: rgba(26, 22, 18, 0.78);
    color: #f5f0ea;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
    padding: 0.45rem 0.5rem;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.22s cubic-bezier(0.22,1,0.36,1), opacity 0.22s ease;
    pointer-events: none;
    font-family: 'Glegoo', serif;
  }
  .hybrid-catalog__card:hover .hybrid-catalog__hover-cta {
    transform: translateY(0);
    opacity: 1;
  }

  .hybrid-catalog__thumb-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid rgba(78, 132, 86, 0.78);
    box-shadow: inset 0 0 0 1px rgba(78, 132, 86, 0.42);
    opacity: 0;
    pointer-events: none;
    z-index: 3;
    transition: opacity 0.22s ease;
  }
  .hybrid-catalog__thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform-origin: center center;
    transition: transform 19.25s ease-in;
    will-change: transform;
  }

  .hybrid-catalog__card:hover .hybrid-catalog__thumb-wrap img {
    transition: transform 8.15s ease-out;
    transform: scale(1.1) translate(-4%, -4%) rotate(-1.5deg);
  }

  .hybrid-catalog__card:hover .hybrid-catalog__thumb-wrap::after {
    opacity: 1;
  }

  .hybrid-catalog__title {
    display: block;
    padding: 0.5rem 0.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #2a2420;
    line-height: 1.3;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }



  .hybrid-catalog__footer {
    text-align: center;
    margin-top: 1.5rem;
  }

  .hybrid-catalog__cta {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 600;
    color: #8b5a2b;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
    font-family: 'Glegoo', serif;
  }
  .hybrid-catalog__cta:hover {
    border-color: #8b5a2b;
    color: #6d3f1a;
  }

  /* Responsive: 3 cols → 2 cols */
  @media (max-width: 768px) {
    .hybrid-catalog__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.55rem;
    }
  }
  @media (max-width: 480px) {
    .hybrid-catalog__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.45rem;
    }
    .hybrid-catalog__title {
      font-size: 0.78rem;
      padding: 0.4rem 0.5rem;
    }
  }
</style>
