---
/**
 * HybridPhotographers.astro
 *
 * "Notable Western Fine Art Photographers" entity-positioning section.
 * Surveys the lineage from painters/illustrators through contemporary photographers,
 * positioning the studio's artist as a natural extension of the tradition.
 *
 * Props:
 *   heading — Section H2
 *   intro   — Lead paragraph (HTML string)
 *   entries — Array of { name, era, note } objects (note may contain HTML)
 */
interface Props {
  heading: string;
  intro: string;
  entries: { name: string; era: string; note: string }[];
}

const { heading, intro, entries } = Astro.props;
---

<section class="hybrid-photographers reveal-on-scroll">
  <h2 class="hybrid-photographers__heading">{heading}</h2>
  <p class="hybrid-photographers__intro" set:html={intro} />

  <dl class="hybrid-photographers__list">
    {entries.map((e) => (
      <div class="hybrid-photographers__entry">
        <dt>
          <span class="hybrid-photographers__name">{e.name}</span>
          <span class="hybrid-photographers__era">{e.era}</span>
        </dt>
        <dd set:html={e.note} />
      </div>
    ))}
  </dl>
</section>

<style>
  .hybrid-photographers {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 1.5rem 2.5rem;
    font-family: 'Glegoo', serif;
    border-top: 1px solid #e8e2da;
  }

  .hybrid-photographers__heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 1rem;
    line-height: 1.3;
    text-align: center;
  }

  .hybrid-photographers__intro {
    font-size: 0.97rem;
    line-height: 1.75;
    color: #3a3530;
    margin: 0 0 1.5rem;
    text-align: left;
  }

  .hybrid-photographers__list {
    margin: 0;
    padding: 0;
  }

  .hybrid-photographers__entry {
    margin: 0 0 1.35rem;
    padding: 0 0 1.35rem;
    border-bottom: 1px solid #eee8e0;
  }
  .hybrid-photographers__entry:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .hybrid-photographers__entry dt {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.35rem;
  }

  .hybrid-photographers__name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1a1a1a;
  }

  .hybrid-photographers__era {
    font-size: 0.82rem;
    font-weight: 400;
    color: #8a7e72;
    white-space: nowrap;
  }

  .hybrid-photographers__entry dd {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.7;
    color: #3a3530;
  }

  @media (max-width: 600px) {
    .hybrid-photographers__heading {
      font-size: 1.25rem;
    }
    .hybrid-photographers {
      padding: 1.5rem 1rem 2rem;
    }
    .hybrid-photographers__entry dt {
      flex-direction: column;
      gap: 0.1rem;
    }
  }
</style>
