---
/**
 * HybridCollectorClose.astro
 *
 * The closing "collector" block for Hybrid Hub pages.
 * Short paragraph about limited editions, archival materials, Engrained wood prints.
 * Then a final CTA to the gallery or contact.
 *
 * Props:
 *   heading     — e.g. "Collected by Those Who Demand the Exceptional"
 *   paragraphs  — Array of HTML strings (1-2 short paragraphs)
 *   ctaHref     — CTA destination URL
 *   ctaLabel    — CTA button text (default: "Start Your Collection")
 */
interface Props {
  heading: string;
  paragraphs: string[];
  ctaHref: string;
  ctaLabel?: string;
}

const { heading, paragraphs, ctaHref, ctaLabel = "Start Your Collection" } = Astro.props;
---

<section class="hybrid-close reveal-on-scroll">
  <h2 class="hybrid-close__heading">{heading}</h2>
  <div class="hybrid-close__body">
    {paragraphs.map((p) => <p set:html={p} />)}
  </div>
  <div class="hybrid-close__cta-wrap">
    <a href={ctaHref} class="hybrid-close__cta">{ctaLabel}</a>
  </div>
</section>

<style>
  .hybrid-close {
    max-width: 780px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
    font-family: 'Glegoo', serif;
    text-align: center;
    border-top: 1px solid #e8e2da;
  }

  .hybrid-close__heading {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 1rem;
    line-height: 1.3;
  }

  .hybrid-close__body p {
    font-size: 0.97rem;
    line-height: 1.75;
    color: #3a3530;
    margin: 0 0 1rem;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .hybrid-close__cta-wrap {
    margin-top: 1.5rem;
  }

  .hybrid-close__cta {
    display: inline-block;
    padding: 0.75rem 2rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    background: #6d5b4a;
    border-radius: 6px;
    text-decoration: none;
    font-family: 'Glegoo', serif;
    transition: background 0.2s ease, box-shadow 0.2s ease;
    letter-spacing: 0.02em;
  }
  .hybrid-close__cta:hover {
    background: #5a4a3b;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  @media (max-width: 600px) {
    .hybrid-close__heading {
      font-size: 1.2rem;
    }
    .hybrid-close {
      padding: 2rem 1rem 2.5rem;
    }
  }
</style>
