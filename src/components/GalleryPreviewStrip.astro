---
interface Props {
  images: {
    id: string;
    title?: string;
    alt?: string;
    src: string;
    visibility?: string;
  // ...existing code...
  }[];
  path: string; // exact gallery URL (preferred)
  limit?: number;
  label?: string;
}

const { images, path, limit = 6, label = "Gallery Preview" } = Astro.props;

// CHANGED: take the exact gallery URL if given; otherwise use the current page path as-is
const rawBaseUrl = (typeof path === "string" && path.length) ? path : Astro.url.pathname;

// Dynamic resolution using siteNav: if provided base is a parent (collection) node, find first descendant gallery-source
import { siteNav } from '@/data/siteNav';
import { getSemanticImageUrl } from '@/utils/imageProxy.js';

type NavNode = { href: string; type?: string; children?: NavNode[] };

function findNode(tree: NavNode[], href: string): NavNode | null {
  for (const n of tree) {
    if (n.href === href) return n;
    if (n.children) {
      const found = findNode(n.children as NavNode[], href);
      if (found) return found;
    }
  }
  return null;
}

function findFirstGallerySource(node: NavNode): NavNode | null {
  if (node.type === 'gallery-source') return node;
  if (node.children) {
    for (const c of node.children) {
      const gs = findFirstGallerySource(c as NavNode);
      if (gs) return gs;
    }
  }
  return null;
}

function resolveGalleryBase(base: string): string {
  const trimmed = base.replace(/\/$/, '');
  const node = findNode(siteNav as NavNode[], trimmed);
  if (!node) return trimmed; // unknown path; leave as-is
  if (node.type === 'gallery-source') return trimmed; // already a leaf
  const leaf = findFirstGallerySource(node);
  return leaf ? leaf.href : trimmed;
}

const resolvedBaseUrl = resolveGalleryBase(rawBaseUrl);

function joinPath(base: string, seg: string) {
  const b = base.endsWith('/') ? base.slice(0, -1) : base;
  return `${b}/${seg}`;
}

// Seeded shuffle - deterministic per path for consistent warming
function seededShuffle<T>(arr: T[], seed: string): T[] {
  // Simple hash function to convert seed string to number
  let hash = 0;
  for (let i = 0; i < seed.length; i++) {
    hash = ((hash << 5) - hash) + seed.charCodeAt(i);
    hash = hash & hash; // Convert to 32-bit integer
  }
  
  // Seeded pseudo-random number generator (mulberry32)
  const seededRandom = () => {
    let t = hash += 0x6D2B79F5;
    t = Math.imul(t ^ t >>> 15, t | 1);
    t ^= t + Math.imul(t ^ t >>> 7, t | 61);
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
  
  return arr
    .map(value => ({ value, sort: seededRandom() }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ value }) => value);
}

// Build-time: seeded shuffle picks 12 candidates (deterministic per path)
// These 12 are what get warmed - client picks 6 from them for variety
const POOL_SIZE = 12;
const candidatePool = seededShuffle(
  images.filter(img => ['show', 'normal'].includes(String(img.visibility ?? '').trim().toLowerCase())),
  resolvedBaseUrl
).slice(0, POOL_SIZE);

// Random client-side shuffle of the pool, then take first 6
// This adds variety on reload while staying within the warmed set
function clientShuffle<T>(arr: T[]): T[] {
  return arr
    .map(value => ({ value, sort: Math.random() }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ value }) => value);
}

const visibleImages = clientShuffle(candidatePool).slice(0, limit);

const middleIndex = Math.floor(visibleImages.length / 2);

// Export the hero image ID (first of seeded pool) for warming
const heroImageId = candidatePool[0]?.id || null;
---

<section class="gallery-preview-strip" aria-label="Gallery preview strip">
  <div class="gallery-label-frame">
    <span class="gallery-hr gallery-hr-left" />
    <span class="gallery-label">{label}</span>
    <span class="gallery-hr gallery-hr-right" />
  </div>

  <div class="gallery-strip">
    {visibleImages.map((img, index) => {
      const offset = index - middleIndex;
      const delay = Math.abs(offset) * 100 + 400;
      const direction = offset === 0 ? "center" : offset < 0 ? "left" : "right";
      return (
        <a
          href={joinPath(resolvedBaseUrl, img.id)}
          class={`gallery-thumb anim-${direction}`}
          title={img.title ?? img.alt ?? "Gallery image"}
          style={`animation-delay: ${delay}ms`}
          data-image-id={img.id}
          data-preview-click
        >
          <img
            src={getSemanticImageUrl(img, { galleryPath: resolvedBaseUrl }, 's')}
            alt={img.alt ?? img.title ?? "Gallery image"}
            loading="lazy"
          />
        </a>
      );
    })}
  </div>
</section>

<script>
  const analyticsEndpoint = 'https://edge.k4studios.com/__k4e';
  const pixelEndpoint = 'https://edge.k4studios.com/_state';

  // Track preview strip clicks
  document.querySelectorAll('[data-preview-click]').forEach(link => {
    link.addEventListener('click', () => {
      const w = window as any;

      if (typeof w.k4ShouldSuppressAnalytics === 'function' && w.k4ShouldSuppressAnalytics()) {
        return;
      }

      const imageId = link.getAttribute('data-image-id') || null;
      const href = link.getAttribute('href') || '';
      let previewGalleryId = null;
      try {
        const url = new URL(href, window.location.href);
        previewGalleryId = url.pathname.replace(/\/i-[A-Za-z0-9_-]+\/?$/, '');
      } catch {}

      // Prefer shared analytics helpers to keep dedupe/session behavior consistent.
  const k4track = typeof w.k4track === 'function' ? w.k4track : null;
  const k4emitActionPixel = typeof w.k4emitActionPixel === 'function' ? w.k4emitActionPixel : null;

      if (k4track) {
        k4track('gallery_preview_click', {
          imageId,
          galleryId: previewGalleryId || null,
          sourceLayer: 'gallery_preview_click_pixel_v1',
          pageType: 'gallery',
          trigger: 'gallery_preview_strip'
        });
      }

      if (k4emitActionPixel) {
        k4emitActionPixel('gallery_preview_click', imageId, {
          galleryId: previewGalleryId || null,
          sourceLayer: 'gallery_preview_click_pixel_v1',
          pageType: 'gallery',
          trigger: 'gallery_preview_strip'
        });
        return;
      }

      // Fallback only when global analytics helpers are unavailable.
      const sidMatch = document.cookie.match(/(?:^|;\s*)k4_sid=([^;]+)/);
      const cookieSid = sidMatch ? decodeURIComponent(sidMatch[1]) : '';
      const sessionId = cookieSid || sessionStorage.getItem('k4_session_id') || crypto.randomUUID();
      sessionStorage.setItem('k4_session_id', sessionId);
      const cookieDomainAttr = window.location.hostname.toLowerCase().endsWith('k4studios.com')
        ? '; Domain=.k4studios.com'
        : '';
      document.cookie = `k4_sid=${encodeURIComponent(sessionId)}; Path=/; SameSite=Lax; Secure${cookieDomainAttr}`;
      const payload = JSON.stringify({
        session_id: sessionId,
        event: 'gallery_preview_click',
        image_id: imageId,
        gallery_id: previewGalleryId || null,
        page_type: 'gallery',
        trigger: 'gallery_preview_strip'
      });
      const sendViaFetch = () => {
        fetch(analyticsEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
          keepalive: true,
          cache: 'no-store',
          mode: 'cors',
          credentials: 'include'
        }).catch(() => {});
      };

      if (navigator.sendBeacon) {
        const blob = new Blob([payload], { type: 'text/plain;charset=UTF-8' });
        const ok = navigator.sendBeacon(analyticsEndpoint, blob);
        if (ok) return;
      }

      sendViaFetch();

      try {
        const params = new URLSearchParams({
          t: 'action',
          e: 'gallery_preview_click',
          sid: sessionId,
          path: window.location.pathname,
          sl: 'gallery_preview_click_pixel_v1',
          pt: 'gallery',
          tr: 'gallery_preview_strip',
          v: String(Date.now())
        });
        if (imageId) params.set('id', imageId);
        if (previewGalleryId) params.set('g', previewGalleryId);
        fetch(`${pixelEndpoint}?${params.toString()}`, {
          method: 'GET',
          keepalive: true,
          cache: 'no-store',
          credentials: 'include'
        }).catch(() => {
          const img = new Image();
          img.referrerPolicy = 'same-origin';
          img.src = `${pixelEndpoint}?${params.toString()}`;
        });
      } catch {}
    });
  });

  // Warm preview strip images (s for display, l for click-through)
  (() => {
    const stripImgs = document.querySelectorAll('.gallery-strip img');
    if (!stripImgs.length) return;
    
    // Fire-and-forget warming via Image() preload
    const warmImage = (id, size) => {
      const img = new Image();
      img.src = `/img/${id}/${size}.jpg`;
    };
    
    stripImgs.forEach(img => {
      const src = img.getAttribute('src');
      const match = src?.match(/\/img\/(i-[^/]+)/);
      if (match) {
        warmImage(match[1], 's'); // Display size
        warmImage(match[1], 'l'); // Click-through size
      }
    });
  })();
</script>

<style>
  .gallery-preview-strip {
    margin-top: 0.5rem;
    padding: 0.25rem 0;
    opacity: 0;
    animation: fadeStripIn 0.4s ease forwards;
    animation-delay: 850ms;
    position: relative;
    z-index: 1;
  }

  @keyframes fadeStripIn { to { opacity: 1; } }

  .gallery-label-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .gallery-label {
    font-size: 1.2rem;
    font-weight: 500;
    color: #444;
    font-family: 'Glegoo', serif;
    opacity: 0;
    animation: fadeLabelIn 0.75s ease-out forwards;
    animation-delay: 600ms;
    white-space: nowrap;
  }

  .gallery-hr {
    display: inline-block;
    height: 1px;
    background-color: #ccc;
    flex-grow: 1;
    max-width: 300px;
    transform: scaleX(0);
    opacity: 0;
  }

  .gallery-hr-left {
    transform-origin: right;
    animation: lineGrowLeft 1.2s ease-out forwards;
    animation-delay: 1200ms;
  }

  .gallery-hr-right {
    transform-origin: left;
    animation: lineGrowRight 1.2s ease-out forwards;
    animation-delay: 1200ms;
  }

  @keyframes fadeLabelIn { to { opacity: 0.75; } }
  @keyframes lineGrowLeft { to { transform: scaleX(1); opacity: 1; } }
  @keyframes lineGrowRight { to { transform: scaleX(1); opacity: 1; } }

  .gallery-strip {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 1rem;
    justify-content: center;
    padding: 0 1rem;
  }

  .gallery-thumb {
    flex: 0 0 auto;
    width: 110px;
    height: 110px;
    border-radius: 6px;
    overflow: hidden;
    display: block;
    border: 2px solid #ccc;
    opacity: 0;
    transform: scale(0.95);
    animation: fadeInCenter 2s ease forwards;
    contain: content;
    will-change: transform, opacity;
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .anim-left { animation-name: fadeSlideLeft; }
  .anim-right { animation-name: fadeSlideRight; }
  .anim-center { animation-name: fadeInCenter; }

  @keyframes fadeInCenter { to { opacity: 1; transform: scale(1); } }
  @keyframes fadeSlideLeft {
    0% { opacity: 0; transform: translateX(30px) scale(0.9); }
    100% { opacity: 1; transform: translateX(0) scale(1); }
  }
  @keyframes fadeSlideRight {
    0% { opacity: 0; transform: translateX(-30px) scale(0.9); }
    100% { opacity: 1; transform: translateX(0) scale(1); }
  }
</style>

<script>
  const checkAndHidePreview = () => {
    const chapter = document.getElementById("chapter-section");
  const preview = document.querySelector(".gallery-preview-strip") as HTMLElement;
  if (!chapter || !preview) return;

    const isVisible = chapter.classList.contains("section-visible");
    if (isVisible) {
      preview.style.transition = "opacity 0.5s ease";
      preview.style.opacity = "0";
      setTimeout(() => { preview.style.display = "none"; }, 500);
    }
  };

  window.addEventListener("DOMContentLoaded", () => {
    checkAndHidePreview();
    const chapter = document.getElementById("chapter-section");
    if (!chapter) return;
    const observer = new MutationObserver(() => { checkAndHidePreview(); });
    observer.observe(chapter, { attributes: true, attributeFilter: ["class"] });
  });
</script>
