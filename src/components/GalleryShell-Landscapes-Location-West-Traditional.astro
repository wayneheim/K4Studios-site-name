---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Landscapes-Location-West-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Location/West/Gallery.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Location/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Landscapes/By-Location/West/Gallery";
const FALLBACK_DESCRIPTION = "Explore traditional fine art landscape photography of the American West by Wayne Heim. Mountains, deserts, canyons, and wide-open skies.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId || "i-k4studios"} />
</GalleryShellCore>
