---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GalleryHeader from "@/components/Gallery-LandingHeader.jsx";
import GalleryInfo from "@/components/GalleryInfo.jsx";
import ChapterViewer from "@/components/Chapter-Architecture-Traditional.jsx";
import Footer from "@/components/Footer.astro";

import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Architecture/Gallery.mjs";
import { landingWestern as landingArchitecture } from "@/data/Galleries/Fine-Art-Photography/Architecture/landingstones.ts";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";

/** ----------------------------------------------------------------
 * Robust mojibake cleaner: safe default + common CP1252/UTF8 swaps
 * ---------------------------------------------------------------- */
function fixMojibake(str = "") {
  return String(str)
    .replace(/â€™/g, "’")
    .replace(/â€œ/g, "“")
    .replace(/â€�/g, "”")
    .replace(/â€“/g, "–")
    .replace(/â€”/g, "—")
    .replace(/â€¦/g, "…")
    .replace(/Ã©/g, "é")
    .replace(/Ã¨/g, "è")
    .replace(/Ãª/g, "ê")
    .replace(/Ã´/g, "ô")
    .replace(/Ã¶/g, "ö")
    .replace(/Ã¼/g, "ü")
    .replace(/ÃŸ/g, "ß")
    .replace(/Ã /g, "à")
    .replace(/Â©/g, "©")
    .replace(/â„¢/g, "™")
    .replace(/â€˜/g, "‘")
    .replace(/â€¢/g, "•")
    .replace(/Â/g, "");
}

const { breadcrumb, entranceData = {}, initialImageId } = Astro.props;

/** ---------------------------------------------------------------
 * Image context
 * --------------------------------------------------------------- */
const isGhost = !initialImageId || initialImageId === "i-k4studios";
const currentImage = isGhost
  ? null
  : allImages.find((img) => img.id === initialImageId && img.visibility !== "ghost");

// Non-ghost preview images (up to 8)
const previewImages = allImages.filter((img) => img.visibility !== "ghost").slice(0, 8);
const previewPath = "/Galleries/Fine-Art-Photography/Architecture/Gallery";

// Random preview for intro image (stable enough for landing)
const singlePreviewImage =
  previewImages.length
    ? previewImages[Math.floor(Math.random() * previewImages.length)]
    : null;

/** ---------------------------------------------------------------
 * Entry content with fallbacks
 * --------------------------------------------------------------- */
const usedEntranceData = {
  ...entranceData,
  image: singlePreviewImage
    ? {
        src: singlePreviewImage.src,
        alt:
          singlePreviewImage.alt ||
          singlePreviewImage.title ||
          entranceData?.image?.alt,
        caption: singlePreviewImage.title || entranceData?.image?.caption,
      }
    : entranceData?.image,
  breadcrumb: entranceData?.breadcrumb || breadcrumb,
  title:
    entranceData?.title ||
    landingArchitecture?.title ||
    "Traditional Architecture Photography by Wayne Heim",
  subtitle:
    entranceData?.subtitle ||
    landingArchitecture?.subtitle ||
    "Fine Art Prints of Historic Buildings & Landmarks",
};

/** ---------------------------------------------------------------
 * SITE / URL helpers
 * --------------------------------------------------------------- */
const siteBase = import.meta.env.SITE || "https://www.k4studios.com";
const pathOnly = Astro.url.pathname; // no search/hash
const canonicalUrl = `${siteBase}${pathOnly.replace(/\/$/, "")}`;
const galleryAbsUrl = `${siteBase}${previewPath}`;

/** ---------------------------------------------------------------
 * Structured data (image open => image; otherwise => gallery)
 * Ensure absolute URL is used for the gallery item
 * --------------------------------------------------------------- */
const imageStructuredData = currentImage
  ? getStructuredData({ type: "image", data: currentImage })
  : getStructuredData({
      type: "gallery",
      data: {
        title: fixMojibake(usedEntranceData.title),
        description: fixMojibake(usedEntranceData.subtitle),
        url: galleryAbsUrl,
      },
      images: previewImages,
    });

/** ---------------------------------------------------------------
 * Page Title & Descriptions (dynamic, non-duplicative)
 * --------------------------------------------------------------- */
const cleanGalleryTitle =
  "Traditional Architecture Photography by Wayne Heim – Fine Art of Buildings & Landmarks";

const pageTitle = currentImage
  ? `${fixMojibake(currentImage.title)} – Traditional Architecture Photography by Wayne Heim`
  : usedEntranceData.title && usedEntranceData.title !== "Gallery"
    ? `${fixMojibake(usedEntranceData.title)} – Traditional Architecture Photography by Wayne Heim`
    : cleanGalleryTitle;

// Description: prefer image description; else curated subtitle; else fallback
const baseFallbackDescription =
  "Discover traditional architecture photography prints by award-winning photographer Wayne Heim — classic buildings, historic landmarks, rustic barns, and timeless Americana fine art.";

const pageDescription =
  (currentImage?.description && fixMojibake(currentImage.description)) ||
  (usedEntranceData?.subtitle && fixMojibake(usedEntranceData.subtitle)) ||
  baseFallbackDescription;

/** ---------------------------------------------------------------
 * OG / Twitter (always point to canonical; image changes if on image)
 * --------------------------------------------------------------- */
const ogImage = currentImage ? currentImage.src : usedEntranceData.image?.src;
const ogAlt =
  (currentImage && (currentImage.alt || currentImage.title)) ||
  (usedEntranceData.image?.alt || cleanGalleryTitle);

const meta = {
  description: pageDescription,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogImage: ogImage,
  ogType: currentImage ? "article" : "website",
  ogUrl: canonicalUrl,
  ogImageAlt: ogAlt,
  twitterTitle: pageTitle,
  twitterDescription: pageDescription,
  twitterImage: ogImage,
  twitterUrl: canonicalUrl,
  twitterImageAlt: ogAlt,
};
---

<BaseLayout title={pageTitle} meta={meta} structuredDataJSON={imageStructuredData}>
  <div id="gallery-content" class="flex-grow relative overflow-hidden">
    <!-- Header stays fixed above intro -->
    <div id="header-section" class="section-visible" style="z-index: 10; position: relative;">
      <GalleryHeader client:load breadcrumb={breadcrumb} />
    </div>

    <div class="h-0 md:h-5"></div>

    <!-- Intro: only one h1 per page -->
    <div id="intro-section" class="section-visible" style="z-index: 1; position: relative;">
      <h1 class="gallery-landing-title">{fixMojibake(usedEntranceData.title)}</h1>
      {usedEntranceData.subtitle && (
        <h2 class="gallery-landing-subtitle">{fixMojibake(usedEntranceData.subtitle)}</h2>
      )}
      <GalleryInfo client:load entranceData={{
        ...usedEntranceData,
        title: fixMojibake(usedEntranceData.title),
        subtitle: fixMojibake(usedEntranceData.subtitle),
        image: usedEntranceData.image
      }} />
    </div>

    <!-- Chapter Viewer: Hidden initially -->
    <div id="chapter-section" class="section-hidden" style="display: none;">
      {/*
        If ChapterViewer renders <h1>, we’ll still keep a single page <h1> above.
        (Best practice is to change ChapterViewer to use <h2>, but leaving here as-is to avoid a component edit.)
      */}
      <ChapterViewer client:load initialImageId={initialImageId || "i-k4studios"} />
    </div>
  </div>

  <div class="h-12 md:h-20"></div>

  <Footer
    previewImages={previewImages}
    previewPath={previewPath}
  />

  <style>
    @media (max-width: 767px) {
      #nav-toggle { display: none !important; }
      #intro-section { margin-top: 3.5rem !important; }
      .gallery-landing-title,
      .gallery-landing-subtitle { margin-left: 2.1rem !important; margin-right: 2.1rem !important; }
      .gallery-landing-subtitle { text-align: center; }
    }
    .hamburger-circle { display: none !important; }
    .section-hidden {
      display: none !important;
      opacity: 0;
      transform: translateX(100%);
      transition: opacity 2s ease, transform 1.2s ease;
      pointer-events: none;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 0;
      z-index: 0;
    }
    .section-visible {
      opacity: 1;
      transform: translateX(0%);
      transition: opacity 1s ease, transform 1.2s ease;
      pointer-events: auto;
      position: relative;
      width: 100%;
      z-index: 2;
    }
    #gallery-content *,
    .gallery-landing-title,
    .gallery-landing-subtitle,
    #gallery-content h3,
    #gallery-content p,
    #gallery-content a {
      font-family: 'Glegoo', serif !important;
      color: #2c2c2c !important;
      line-height: 1.5 !important;
    }
    .gallery-landing-title {
      font-size: 1.1rem !important;
      font-weight: 700 !important;
      margin-top: 2em !important;
      margin-left: 5.5em;
      margin-bottom: 0.3em !important;
      letter-spacing: 0.01em;
      line-height: 1.12;
    }
    .gallery-landing-subtitle {
      font-size: 0.95rem !important;
      font-weight: 500 !important;
      margin-left: 6.5em;
      margin-bottom: 0.5em;
      letter-spacing: 0.01em;
      line-height: 1.15;
    }
    #gallery-content p { font-size: 1rem !important; margin-bottom: 1em !important; }
    #gallery-content a { text-decoration: underline !important; color: #85644b !important; }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const exploreButton = document.querySelector('.explore-button');
      const header = document.getElementById('header-section');
      const intro = document.getElementById('intro-section');
      const chapter = document.getElementById('chapter-section');
      const navToggle = document.getElementById('nav-toggle');
      let isMenuOpen = false;

      // Deep-link image logic (open viewer if URL ends with /i-xxxxx)
      const deepLinkMatch = window.location.pathname.match(/\/(i-[a-zA-Z0-9_-]+)$/);
      if (deepLinkMatch && deepLinkMatch[1] !== "i-k4studios") {
        setTimeout(() => exploreButton?.click(), 50);
      }

      exploreButton?.addEventListener('click', () => {
        header.classList.add('section-hidden');
        intro.classList.add('section-hidden');
        chapter.style.display = 'block';
        setTimeout(() => {
          chapter.classList.remove('section-hidden');
          chapter.classList.add('section-visible');
        }, 50);
        if (window.innerWidth >= 768) {
          document.getElementById('nav-toggle')?.classList.remove('hidden');
        }
      });

      navToggle?.addEventListener('click', () => {
        isMenuOpen = !isMenuOpen;
        const label = document.getElementById('menu-label');
        if (label) label.textContent = isMenuOpen ? "M−" : "M+";
        document.getElementById('floating-header')?.classList.toggle('show');
      });
    });

    // Disable right-click on images
    document.addEventListener('contextmenu', e => {
      if (e.target.tagName === 'IMG') e.preventDefault();
    });
  </script>
</BaseLayout>
