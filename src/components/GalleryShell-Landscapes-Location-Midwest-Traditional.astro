---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Landscapes-Location-Midwest-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Location/Midwest/Gallery.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Location/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Landscapes/By-Location/Midwest/Gallery";
const FALLBACK_DESCRIPTION = "Explore traditional fine art landscape photography of the American Midwest by Wayne Heim. Prairies, farmlands, and heartland beauty.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
const shouldSsrChapterViewer = Boolean(initialImageId && initialImageId !== "i-k4studios") || Astro.url.searchParams.get("view") === "grid";
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  {shouldSsrChapterViewer ? (
    <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId || "i-k4studios"} />
  ) : (
    <ChapterViewer slot="chapter-viewer" client:only="react" initialImageId={initialImageId || "i-k4studios"} />
  )}
</GalleryShellCore>
