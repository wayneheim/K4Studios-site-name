---
interface Props { text: string; }
const { text } = Astro.props;
---
<aside class="essay-context-link">
  <strong>The Story Inside the Stone</strong>
  <span>{text}</span>
  <a href="/Other/The-Story-Inside-the-Stone">Read the essay <span aria-hidden="true">&rarr;</span></a>
</aside>
<style>
  .essay-context-link { max-width: 820px; margin: 2rem auto; padding: 1.15rem 1.4rem; border-left: 3px solid rgba(139,95,27,.42); background: #fbf7f1; color: #342c26; font-family: "Glegoo", serif; line-height: 1.65; }
  .essay-context-link strong, .essay-context-link > span { display: block; }
  .essay-context-link > span { margin: .25rem 0 .55rem; color: #62564d; }
  .essay-context-link a { color: #762f1f; font-weight: 700; text-underline-offset: .15em; }
</style>
