---
import type { K4Video } from "@/data/videos/videoRegistry";
import { formatIsoDuration, getVideoThumbnail, getVideoTypeGroup, getVideoUrl, isRealYouTubeId, slugifyVideoLabel } from "@/data/videos/videoRegistry";

const { video } = Astro.props as { video: K4Video };
const href = getVideoUrl(video);
const thumbnail = getVideoThumbnail(video);
const dateLabel = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(new Date(`${video.date}T00:00:00`));
const themeClass = slugifyVideoLabel(video.theme);
const typeClass = slugifyVideoLabel(video.type);
const typeGroup = getVideoTypeGroup(video.type);
const durationLabel = formatIsoDuration(video.duration);
const hasExternalYouTube = isRealYouTubeId(video.youtubeId);
const externalYouTubeHref = hasExternalYouTube ? video.externalUrl || `https://www.youtube.com/watch?v=${video.youtubeId}` : undefined;
const watchHref = video.hasDedicatedPage ? href : externalYouTubeHref || href;
const watchLabel = video.hasDedicatedPage ? "K4 watch page" : "YouTube";
const watchIsExternal = Boolean(!video.hasDedicatedPage && externalYouTubeHref);
---

<article
  id={video.slug}
  class={`video-card type-card-${typeGroup.key}`}
  data-video-card
  data-date={video.date}
  data-title={video.title}
  data-type={video.type}
  data-type-group={typeGroup.label}
  data-type-key={typeGroup.key}
  data-theme={video.theme}
  data-theme-key={themeClass}
  data-featured={video.featured ? "true" : "false"}
>
  <a class="thumb-link" href={href} aria-label={`Watch or read more about ${video.title}`}>
    <div class="thumb-wrap">
      <img src={thumbnail} alt={video.thumbnailAlt || `${video.title} video thumbnail`} loading="lazy" />
      <span class="play-mark" aria-hidden="true">Play</span>
    </div>
  </a>

  <div class="card-body">
    <div class="badge-row" aria-label="Video details">
      <span class={`badge type type-${typeClass}`}>{video.type}</span>
      <span class={`badge subject theme-${themeClass}`}>{video.theme}</span>
      {video.featured && <span class="badge featured">Featured</span>}
    </div>
    <div class="meta-stack">
      {durationLabel && <span class="runtime">{durationLabel}</span>}
      <span class="date">{dateLabel}</span>
    </div>
    <h2><a href={href}>{video.title}</a></h2>
    <p class="dek">{video.dek || video.description}</p>
    <div class="card-actions">
      <span class="watch-label">Watch:</span>
      {watchHref && (
        <a class="external-link" href={watchHref} target={watchIsExternal ? "_blank" : undefined} rel={watchIsExternal ? "noopener noreferrer" : undefined}>
          {watchLabel}
        </a>
      )}
    </div>
  </div>
</article>
