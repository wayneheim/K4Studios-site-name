---
export interface KeywordLandingBreadcrumbItem {
  name: string;
  item: string;
}

export interface KeywordLandingConfig {
  title: string;
  subtitle: string;
  keywords: string[];
  breadcrumb: string;
}

export interface KeywordLandingStoryBlock {
  title?: string;
  subhead?: string;
  paragraphs: string[];
}

export interface KeywordLandingFaqItem {
  q: string;
  a: string[];
}

export interface KeywordLandingExplorationPath {
  title: string;
  eyebrow?: string;
  hideEyebrow?: boolean;
  href: string;
  description: string;
  cta: string;
  accent: string;
  featured?: boolean;
}

export interface KeywordLandingReadingItem {
  title: string;
  href: string;
  description: string;
  eyebrow?: string;
}

export interface KeywordLandingGridItem {
  id: string;
  title: string;
  alt: string;
  href?: string;
  src?: string;
  srcM?: string;
  seriesLabel?: string;
}

export interface KeywordLandingCollectionRow {
  label: string;
  href: string;
  cta?: string;
  items: KeywordLandingGridItem[];
}

export interface KeywordLandingCollectionGroup {
  title: string;
  description: string;
  rows: KeywordLandingCollectionRow[];
}

export interface KeywordLandingCollectionConfig {
  kicker?: string;
  title: string;
  intro: string;
}

export interface KeywordLandingFaqSectionConfig {
  kicker?: string;
  title: string;
  tagline?: string;
}

interface Props {
  pagePath: string;
  imageSectionPath: string;
  gridBasePath: string;
  galleryPaths?: string[];
  landing: KeywordLandingConfig;
  breadcrumbItems: KeywordLandingBreadcrumbItem[];
  storyBlocks: KeywordLandingStoryBlock[];
  faqItems: KeywordLandingFaqItem[];
  explorationIntro?: string;
  explorationPaths: KeywordLandingExplorationPath[];
  featuredReadingTitle?: string;
  featuredReadingIntro?: string;
  featuredReadingItems: KeywordLandingReadingItem[];
  collectionGroups?: KeywordLandingCollectionGroup[];
  gridImages?: KeywordLandingGridItem[];
  collection: KeywordLandingCollectionConfig;
  faqSection: KeywordLandingFaqSectionConfig;
  galleryData: any[];
  slides: any[];
  meta: {
    title: string;
    description: string;
    ogDescription?: string;
  };
  structuredAbout?: string[];
  webPageAbout?: string[];
  genre?: string;
  collectionAltPrefix?: string;
  heroVisualMode?: 'imageBar' | 'hybridCarousel';
  hybridCarouselProps?: any;
}

import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedReadingSection from '@/components/FeaturedReadingSection.astro';
import LandingHeader from '@/components/Landing-Header.jsx';
import ImageBar2 from '@/components/ImageBar2.jsx';
import HybridBookCarousel from '@/components/hybrid/HybridBookCarousel.jsx';
import SiteFooter from '@/components/Footer.astro';

import { getStructuredData, getBreadcrumbList } from '@/components/utils/getStructuredData.ts';
import { getOrderedWesternGalleryPaths } from '@/data/carousel/westernRouting.ts';
import { getFeatheredImages } from '@/components/utils/getFeatheredImages.ts';
import { autoLinkKeywordsInText } from '@/components/utils/autoLinkKeywordsInText.ts';
import { semantic as k4Semantic } from '@/data/semantic/K4-Sem.ts';

import '@/styles/global.css';
import '@/styles/oneupheader.css';

const {
  pagePath,
  imageSectionPath,
  gridBasePath,
  galleryPaths: overrideGalleryPaths = [],
  landing,
  breadcrumbItems,
  storyBlocks = [],
  faqItems = [],
  explorationIntro = `Explore ${landing.title}`,
  explorationPaths = [],
  featuredReadingTitle = 'Explore the Ideas',
  featuredReadingIntro = '',
  featuredReadingItems = [],
  collectionGroups = [],
  gridImages: providedGridImages = [],
  collection,
  faqSection,
  galleryData = [],
  slides = [],
  meta,
  structuredAbout = [landing.title],
  webPageAbout = structuredAbout,
  genre = landing.title,
  collectionAltPrefix = landing.title,
  heroVisualMode = 'imageBar',
  hybridCarouselProps = null,
} = Astro.props as Props;

const galleryPaths: string[] = overrideGalleryPaths.length
  ? overrideGalleryPaths
  : getOrderedWesternGalleryPaths(imageSectionPath);
const allGalleryData = import.meta.glob('../../data/Galleries/**/*.mjs', { eager: true }) as any;
const galleryDatas = galleryPaths.map((path) => {
  const normalizedPath = path.replace(/^\/Galleries/, '');
  const directFilePath = '../../data/Galleries' + normalizedPath + '.mjs';
  const nestedFilePath = '../../data/Galleries' + normalizedPath + '/' + normalizedPath.split('/').pop() + '.mjs';
  return allGalleryData[directFilePath]?.galleryData || allGalleryData[nestedFilePath]?.galleryData || [];
});

const headingCount = storyBlocks.filter((block, index) => index > 0 && block.subhead).length;
const featheredImages = getFeatheredImages({
  sectionPath: imageSectionPath,
  headingCount: Math.max(headingCount, 8),
  galleryDatas,
  galleryPaths,
  minRating: 3,
  fallbackMin: 1,
  poolMultiplier: 3,
});

const leadStoryBlock = storyBlocks[0];
const secondaryStoryBlocks = storyBlocks.slice(1, 3);
const faqSplitIndex = Math.ceil(faqItems.length / 2);
const faqLeft = faqItems.slice(0, faqSplitIndex);
const faqRight = faqItems.slice(faqSplitIndex);
const gridImages = (providedGridImages?.length
  ? providedGridImages
  : (galleryData || [])
      .filter((item: any) => item.id !== 'i-k4studios' && item.visibility !== 'ghost' && item.visibility !== 'hidden')
      .slice(0, 12)
);

const hasCollectionGroups = collectionGroups.length > 0;

const stripHtml = (text: string) => text.replace(/<[^>]*>/g, '').trim();

const structuredData = getStructuredData({
  type: 'gallery',
  data: {
    title: landing.title,
    description: landing.subtitle,
    url: `https://www.k4studios.com${pagePath}`,
    keywords: landing.keywords,
    copyrightNotice: '© Wayne Heim',
    about: structuredAbout.map((name) => ({ '@type': 'Thing', name })),
    genre,
  },
  images: featheredImages,
  defaults: {
    copyrightNotice: '© Wayne Heim',
    license: 'https://www.k4studios.com/copyright',
    acquireLicensePage: 'https://www.k4studios.com/Other/Print-Options',
    creditText: 'Wayne Heim',
    creatorName: 'Wayne Heim',
    creatorUrl: 'https://www.k4studios.com/',
  },
});

const breadcrumbData = getBreadcrumbList(breadcrumbItems);

const faqStructuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `https://www.k4studios.com${pagePath}#faq`,
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(Array.isArray(item.a) ? item.a.join(' ') : item.a),
    },
  })),
}, null, 2);

const webPageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `https://www.k4studios.com${pagePath}#webpage`,
  url: `https://www.k4studios.com${pagePath}`,
  name: landing.title,
  description: landing.subtitle,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://www.k4studios.com/#website',
    name: 'K4 Studios',
    url: 'https://www.k4studios.com/',
  },
  about: webPageAbout.map((name) => ({ '@type': 'Thing', name })),
  author: { '@id': 'https://www.k4studios.com/#person' },
  creator: { '@id': 'https://www.k4studios.com/#person' },
  copyrightHolder: { '@id': 'https://www.k4studios.com/#person' },
  mainEntity: { '@id': `https://www.k4studios.com${pagePath}#imagegallery` },
}, null, 2);

function getProxySrc(imageId: string, size: string = 'm'): string {
  if (!imageId) return '';
  return `/img/${imageId}/${size}.jpg`;
}

function makeAbsoluteUrl(src?: string) {
  if (!src) return '';
  if (src.startsWith('http://') || src.startsWith('https://')) return src;
  return `https://www.k4studios.com${src.startsWith('/') ? src : '/' + src}`;
}

const landingImg = featheredImages[0];
const landingImgUrl = landingImg?.id ? makeAbsoluteUrl(getProxySrc(landingImg.id, 'l')) : '';
const computedMeta = {
  title: meta.title,
  description: meta.description,
  canonicalUrl: pagePath,
  ogTitle: meta.title,
  ogDescription: meta.ogDescription || landing.subtitle,
  ogUrl: pagePath,
  ogImage: landingImgUrl,
  twitterCard: 'summary_large_image',
  twitterImage: landingImgUrl,
};
---

<BaseLayout
  title={meta.title}
  structuredDataJSON={structuredData}
  breadcrumbsJSON={breadcrumbData}
  meta={computedMeta}
>
  <script type="application/ld+json" set:html={faqStructuredData} slot="head"></script>
  <script type="application/ld+json" set:html={webPageSchema} slot="head"></script>

  <main class="wallart-page bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={landing.breadcrumb} />
    </div>

    <div class="mobile-breadcrumb-wrapper">
      <div class="mobile-breadcrumb" set:html={landing.breadcrumb} />
    </div>

    <div class="w-full max-w-[1200px] mx-auto px-4">
      {heroVisualMode === 'hybridCarousel' ? (
        <div class="hero-carousel-section reveal-on-scroll">
          <HybridBookCarousel client:load {...(hybridCarouselProps || {})} />
        </div>
      ) : (
        <div class="carousel-container">
          <div class="carousel-placeholder" aria-hidden="true"></div>
          <div class="carousel-fade reveal-on-scroll">
            <ImageBar2 client:load slides={slides} />
          </div>
        </div>
      )}
    </div>

    <section class="section-heading-wrap">
      <div class="section-heading">
        <h1 class="page-title fade-in reveal-on-scroll">{landing.title}</h1>
        <h2 class="page-subtitle fade-in reveal-on-scroll">{landing.subtitle}</h2>
      </div>
    </section>

    <section class="term-section">
      <div class="term-shell">
        <div class="term-header">
          {leadStoryBlock?.title && (
            <h2 class="term-header__title" set:html={autoLinkKeywordsInText(leadStoryBlock.title, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
          )}
        </div>

        {leadStoryBlock && (
          <article class="term-block term-block--lead">
            {leadStoryBlock.subhead && (
              <h3 class="term-block__subhead" set:html={autoLinkKeywordsInText(leadStoryBlock.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
            )}
            {leadStoryBlock.paragraphs?.map((para: string) => (
              <p class="term-block__body" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
            ))}
          </article>
        )}

        {secondaryStoryBlocks.map((section: KeywordLandingStoryBlock, index: number) => (
          <article class:list={["term-block", index === 0 ? 'term-block--secondary' : 'term-block--tertiary']}>
            {section.subhead && (
              <h3 class="term-block__subhead" set:html={autoLinkKeywordsInText(section.subhead, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
            )}
            {section.paragraphs?.map((para: string) => (
              <p class="term-block__body" set:html={autoLinkKeywordsInText(para, galleryDatas, featheredImages, galleryPaths, k4Semantic, pagePath)} />
            ))}
            {index === 1 && (
              <div class="term-block__watermark" aria-hidden="true">
                <span>The frame does not settle.</span>
                <span>It keeps opening.</span>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="exploration-section">
      <div class="exploration-shell reveal-on-scroll">
        <p class="exploration-intro">{explorationIntro}</p>
        <div class="exploration-grid">
          {explorationPaths.map((path) => (
            <a
              href={path.href}
              class:list={["exploration-card", path.featured && 'exploration-card--featured']}
              style={`--path-accent:${path.accent};`}
            >
              {!path.hideEyebrow && <span class="exploration-card__eyebrow">{path.eyebrow}</span>}
              <h3 class="exploration-card__title">{path.title}</h3>
              <p class="exploration-card__body">{path.description}</p>
              <span class="exploration-card__cta">{path.cta}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="collection-section">
      <div class="collection-shell">
        <div class="collection-heading reveal-on-scroll">
          <p class="collection-kicker">{collection.kicker || 'Selected Works'}</p>
          <h2 class="collection-title">{collection.title}</h2>
          <p class="collection-intro">{collection.intro}</p>
        </div>

        {hasCollectionGroups ? (
          <div class="collection-groups reveal-on-scroll">
            {collectionGroups.map((group: KeywordLandingCollectionGroup) => (
              <article class="collection-group">
                <div class="collection-group__header">
                  <h3 class="collection-group__title">{group.title}</h3>
                  <p class="collection-group__description">{group.description}</p>
                </div>

                <div class="collection-group__rows">
                  {group.rows.map((row: KeywordLandingCollectionRow) => (
                    <section class="collection-row">
                      <div class="wallart-grid wallart-grid--preview-row">
                        {row.items.map((item: KeywordLandingGridItem) => (
                          <a href={item.href || `${gridBasePath}/${item.id}`} class="wallart-grid__tile" title={item.title}>
                            <div class="wallart-grid__img-wrap">
                              <img
                                src={getProxySrc(item.id, 'm')}
                                data-fallback-src={item.srcM || item.src || ''}
                                alt={item.alt || `${collectionAltPrefix} by Wayne Heim: ${item.title}`}
                                loading="lazy"
                                onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) { this.src = this.dataset.fallbackSrc; }"
                                width="400"
                                height="400"
                                class="wallart-grid__img"
                              />
                              <span class="wallart-grid__hover">View Image</span>
                            </div>
                            <p class="wallart-grid__title">{item.title}</p>
                          </a>
                        ))}

                        <a href={row.href} class="wallart-grid__see-more-bar" title={row.cta || 'See more'} aria-label={row.cta || 'See more'}>
                          <span class="wallart-grid__see-more-glyph" aria-hidden="true">
                            <svg viewBox="0 0 40 160" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M8 12L31 80L8 160" />
                            </svg>
                          </span>
                          <span class="wallart-grid__see-more-label">See More</span>
                        </a>
                      </div>
                    </section>
                  ))}
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="wallart-grid reveal-on-scroll">
            {gridImages.map((item: any) => (
              <a href={item.href || `${gridBasePath}/${item.id}`} class="wallart-grid__tile" title={item.title}>
                <div class="wallart-grid__img-wrap">
                  <img
                    src={getProxySrc(item.id, 'm')}
                    data-fallback-src={item.srcM || item.src || ''}
                    alt={item.alt || `${collectionAltPrefix} by Wayne Heim: ${item.title}`}
                    loading="lazy"
                    onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) { this.src = this.dataset.fallbackSrc; }"
                    width="400"
                    height="400"
                    class="wallart-grid__img"
                  />
                  <span class="wallart-grid__hover">View Image</span>
                </div>
                <p class="wallart-grid__title">{item.title}</p>
                {item.seriesLabel && <p class="wallart-grid__series">{item.seriesLabel}</p>}
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <FeaturedReadingSection
      title={featuredReadingTitle}
      intro={featuredReadingIntro}
      items={featuredReadingItems}
    />

    <section class="faq-section pb-10">
      <div class="faq-shell reveal-on-scroll">
        <p class="faq-kicker">{faqSection.kicker || 'Collector Questions'}</p>
        <h2 class="faq-title">{faqSection.title}</h2>

        <div class="faq-columns">
          <div class="faq-column faq-column--left">
            <div class="faq-question-list" role="list">
              {faqLeft.map((item: KeywordLandingFaqItem, index: number) => (
                <button
                  type="button"
                  class="faq-question"
                  data-faq-trigger
                  data-faq-side="left"
                  data-faq-target={`faq-left-${index}`}
                  aria-expanded="false"
                >
                  <span class="faq-question__text">{item.q}</span>
                  <span class="faq-question__icon" aria-hidden="true">+</span>
                </button>
              ))}
            </div>

            <div class="faq-answer-stack">
              {faqLeft.map((item: KeywordLandingFaqItem, index: number) => (
                <div id={`faq-left-${index}`} class="faq-answer" data-faq-panel data-faq-side="left" hidden>
                  {item.a.map((paragraph: string) => (
                    <p set:html={paragraph} />
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="faq-column faq-column--right">
            <div class="faq-question-list" role="list">
              {faqRight.map((item: KeywordLandingFaqItem, index: number) => (
                <button
                  type="button"
                  class="faq-question"
                  data-faq-trigger
                  data-faq-side="right"
                  data-faq-target={`faq-right-${index}`}
                  aria-expanded="false"
                >
                  <span class="faq-question__text">{item.q}</span>
                  <span class="faq-question__icon" aria-hidden="true">+</span>
                </button>
              ))}
            </div>

            <div class="faq-answer-stack">
              {faqRight.map((item: KeywordLandingFaqItem, index: number) => (
                <div id={`faq-right-${index}`} class="faq-answer" data-faq-panel data-faq-side="right" hidden>
                  {item.a.map((paragraph: string) => (
                    <p set:html={paragraph} />
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="faq-overlay faq-overlay--left" data-faq-overlay="left" hidden></div>
          <div class="faq-overlay faq-overlay--right" data-faq-overlay="right" hidden></div>
        </div>

        <div class="faq-header-logo">
          <a href="/" class="faq-header-logo__link" aria-label="Home">
            <img src="/images/K4Logo-web.webp" alt="K4 Studios home" loading="lazy" decoding="async" />
          </a>
        </div>
        <p class="faq-tagline">{faqSection.tagline || '"History, lives, and hidden moments — experienced within a single image."'}</p>
      </div>
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const els = document.querySelectorAll('.reveal-on-scroll, .slide-in-left');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }

      const faqTriggers = Array.from(document.querySelectorAll('[data-faq-trigger]'));
      const faqPanels = Array.from(document.querySelectorAll('[data-faq-panel]'));
      const faqOverlays = Array.from(document.querySelectorAll('[data-faq-overlay]'));
      const isMobileFaq = () => window.matchMedia('(max-width: 768px)').matches;

      const closeAllFaqPanels = () => {
        faqTriggers.forEach((trigger) => {
          trigger.setAttribute('aria-expanded', 'false');
          const icon = trigger.querySelector('.faq-question__icon');
          if (icon) icon.textContent = '+';
        });

        faqPanels.forEach((panel) => {
          panel.hidden = true;
          panel.classList.remove('is-open');
        });

        faqOverlays.forEach((overlay) => {
          overlay.hidden = true;
          overlay.classList.remove('is-open');
          overlay.innerHTML = '';
        });

        document.querySelectorAll('.faq-mobile-answer').forEach((node) => node.remove());
      };

      faqTriggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const targetId = trigger.getAttribute('data-faq-target');
          const targetPanel = targetId ? document.getElementById(targetId) : null;
          const triggerSide = trigger.getAttribute('data-faq-side');
          const overlaySide = triggerSide === 'left' ? 'right' : 'left';
          const overlay = document.querySelector(`[data-faq-overlay="${overlaySide}"]`);
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          const mobileMode = isMobileFaq();

          closeAllFaqPanels();
          if (!targetPanel || isOpen) return;

          trigger.setAttribute('aria-expanded', 'true');
          const icon = trigger.querySelector('.faq-question__icon');
          if (icon) icon.textContent = '−';

          const questionText = trigger.querySelector('.faq-question__text')?.textContent || '';

          if (mobileMode) {
            const inlineAnswer = document.createElement('div');
            inlineAnswer.className = 'faq-answer faq-mobile-answer is-open';
            inlineAnswer.innerHTML = `
              <p class="faq-overlay__eyebrow">Answer</p>
              <h3 class="faq-overlay__title">${questionText}</h3>
              <div class="faq-overlay__content">${targetPanel.innerHTML}</div>
            `;
            trigger.insertAdjacentElement('afterend', inlineAnswer);
            return;
          }

          if (!overlay) return;

          overlay.innerHTML = `
            <div class="faq-overlay__inner">
              <p class="faq-overlay__eyebrow">Answer</p>
              <h3 class="faq-overlay__title">${questionText}</h3>
              <div class="faq-overlay__content">${targetPanel.innerHTML}</div>
            </div>
          `;
          overlay.hidden = false;
          overlay.classList.add('is-open');
        });
      });
    });
  </script>

  <style>
    .wallart-page,
    .wallart-page * {
      font-family: 'Glegoo', serif !important;
    }
    .wallart-page {
      background: #ffffff;
      color: #2c2c2c;
      min-height: 100vh;
      overflow-x: hidden;
    }
    .mobile-breadcrumb-wrapper {
      display: none;
      max-width: 1200px;
      margin: 0 auto 0.35rem;
      padding: 0 1rem;
    }
    .mobile-breadcrumb {
      color: #5f4d40;
      font-size: 0.95rem;
      line-height: 1.4;
    }
    .mobile-breadcrumb :global(a) {
      color: #7d4f2f;
      text-decoration: none;
    }
    .mobile-breadcrumb :global(a:hover) {
      text-decoration: underline;
    }
    .fade-in {
      opacity: 0;
      visibility: hidden;
      transform: translateY(1px);
      transition: opacity 1.75s ease, transform 1.75s ease, visibility .5s linear 1.75s;
    }
    .fade-in.is-visible {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }
    .page-title.fade-in {
      transition-delay: .2s;
    }
    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .reveal-on-scroll.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .carousel-container {
      position: relative;
      width: 100%;
      height: 410px;
      overflow: hidden;
    }
    .carousel-placeholder {
      position: absolute;
      inset: 0;
      background: transparent;
    }
    .carousel-fade {
      opacity: 0;
      transform: translateY(0px);
      transition: opacity 1.5s ease-out, transform 1.5s ease-out;
      visibility: hidden;
    }
    .carousel-fade.is-visible {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }
    .hero-carousel-section {
      margin: 0 0 0.75rem;
    }
