      .cinematic-collecting-section,
      .cinematic-closing-callout {
        padding:22px 18px;
      }
      .series-widget {
        grid-template-columns:1fr;
      }
      .series-detail {
        position:static;
        width:auto;
        margin:0 12px 12px 34px;
        opacity:1;
        visibility:visible;
        pointer-events:auto;
        transform:none;
        display:none;
        box-shadow:0 10px 22px rgba(48,34,23,.1);
      }
      .series-detail-footer {
        align-items:flex-start;
        gap:10px;
      }
      .series-tile.is-active .series-detail,
      .series-tile.is-hover-ready .series-detail {
        display:block;
        transform:none;
      }
      .catalog-section-heading {
        width:calc(100% - 32px);
        padding:18px 18px 20px;
        text-align:center;
      }
      .catalog-grid-intro {
        width:calc(100% - 32px);
        padding:18px 18px 16px;
        text-align:center;
      }
      .cinematic-concept-block {
        width:calc(100% - 32px);
        padding:24px 18px;
      }
      .cinematic-concept-block p:not(.cinematic-concept-block__kicker) {
        font-size:.96rem;
        line-height:1.72;
      }
      .catalog-section-heading p:not(.catalog-section-kicker):not(.catalog-section-timezone) {
        margin-left:auto;
        margin-right:auto;
      }
      .catalog-gallery-section {
        margin-bottom:38px;
      }
      .ssr-grid--catalog-section {
        grid-template-columns:repeat(2,minmax(0,1fr));
      }
      .catalog-collection-cta {
        min-height:260px;
      }
      .faq-shell {
        padding:1rem .85rem 1.2rem;
      }
      .faq-title {
        width:auto;
        left:auto;
        transform:none;
        font-size:1.28rem;
        gap:.5rem;
        word-break:break-word;
      }
      .faq-columns {
        grid-template-columns:1fr;
        position:static;
        min-height:unset;
        gap:.9rem;
      }
      .faq-column--right {
        border-left:0;
        border-top:1px solid rgba(121,98,78,.15);
        padding-left:0;
        padding-top:.95rem;
      }
      .faq-overlay {
        position:static;
        width:auto;
        margin-top:.85rem;
      }
      .faq-mobile-answer {
        margin-top:-.3rem;
        margin-bottom:.25rem;
      }
      .faq-header-logo {
        margin:.6rem auto 0;
        margin-left:0;
        margin-bottom:0;
      }
      .faq-header-logo img {
        width:46px;
        height:46px;
      }
      .faq-tagline {
        font-size:.93rem;
        line-height:1.48;
        padding:0 .3rem;
      }
      .ssr-grid {
        grid-template-columns:repeat(2,minmax(0,1fr));
        padding:0 16px;
        gap:16px;
      }
      .ssr-grid--catalog-section {
        grid-template-columns:repeat(2,minmax(0,1fr));
      }
      .ssr-card-image {
        width:100%;
        height:auto;
      }
      .ssr-card-content {
        display:flex;
        flex-direction:column;
        min-height:auto;
        height:auto;
        margin-top:0;
        transform:none;
        background:#fffdf9;
        border-top:1px solid #e6d9ca;
      }
      .card-cta-desktop {
        display:none;
      }
      .card-cta-mobile {
        display:inline;
      }
    }

    @media (hover: none), (pointer: coarse) {
      .ssr-card:hover,
      .ssr-card:focus-within {
        border-color:#b46a5f;
        box-shadow:0 8px 22px rgba(48,34,23,.08);
      }
      .ssr-card:hover .ssr-card-content,
      .ssr-card:focus-within .ssr-card-content {
        transform:none;
      }
      .ssr-card-link {
        pointer-events:auto;
        touch-action:manipulation;
      }
      .ssr-card-content {
        pointer-events:auto;
      }
      .ssr-card:hover .card-number,
      .ssr-card:focus-within .card-number,
      .ssr-card:hover .card-meta-row,
      .ssr-card:focus-within .card-meta-row,
      .ssr-card:hover .ssr-card-content h3,
      .ssr-card:focus-within .ssr-card-content h3,
      .ssr-card:hover .print-cue,
      .ssr-card:focus-within .print-cue,
      .ssr-card:hover .story-excerpt,
      .ssr-card:focus-within .story-excerpt {
        opacity:1;
        transform:none;
        max-height:none;
        overflow:visible;
        pointer-events:auto;
      }
      .ssr-card:hover .card-meta-row,
      .ssr-card:focus-within .card-meta-row {
        margin-bottom:6px;
      }
      .ssr-card:hover .ssr-card-content h3,
      .ssr-card:focus-within .ssr-card-content h3 {
        margin:0 0 8px;
      }
      .ssr-card:hover .story-excerpt,
      .ssr-card:focus-within .story-excerpt {
        margin:0 0 14px;
      }
      .ssr-card:has(.collector-notes-trigger:hover):not(.is-notes-open) .collector-note-overlay,
      .ssr-card:has(.collector-notes-trigger:focus-visible):not(.is-notes-open) .collector-note-overlay {
        opacity:0;
        visibility:hidden;
        pointer-events:none;
        transform:translateY(4px);
      }
      .ssr-card:has(.collector-notes-trigger:hover):not(.is-notes-open) .ssr-card-image,
      .ssr-card:has(.collector-notes-trigger:focus-visible):not(.is-notes-open) .ssr-card-image {
        filter:none;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const titleNode = document.getElementById('dock-active-title');
      const prefixNode = document.getElementById('dock-active-prefix');
      const dockCards = Array.from(document.querySelectorAll('[data-dock-title]'));
      if (!titleNode || dockCards.length === 0) return;

      const current = dockCards.find((card) => card.getAttribute('aria-current') === 'page');
      const fallbackTitle = titleNode.textContent || '';

      const setDockTitle = (value, prefix = 'Browse') => {
        if (prefixNode) prefixNode.textContent = prefix ? `${prefix} ` : '';
        titleNode.textContent = value || fallbackTitle;
      };

      setDockTitle(fallbackTitle, '');
      const centerCurrentCard = () => {
        if (!current) return;
        const track = current.closest('.dock-track');
        if (!track) return;
        const targetLeft = current.offsetLeft - (track.clientWidth - current.clientWidth) / 2;
        const maxLeft = Math.max(0, track.scrollWidth - track.clientWidth);
        track.scrollLeft = Math.max(0, Math.min(targetLeft, maxLeft));
      };
      requestAnimationFrame(() => requestAnimationFrame(centerCurrentCard));
      window.addEventListener('load', centerCurrentCard, { once: true });
      window.addEventListener('resize', centerCurrentCard);

      dockCards.forEach((card) => {
        if (card.getAttribute('data-current') === 'true') return;
        card.addEventListener('mouseenter', () => setDockTitle(card.getAttribute('data-dock-title'), card.getAttribute('data-dock-prefix') ?? 'Browse'));
        card.addEventListener('focus', () => setDockTitle(card.getAttribute('data-dock-title'), card.getAttribute('data-dock-prefix') ?? 'Browse'));
      });

      const dock = document.querySelector('.collection-dock');
      dock?.addEventListener('mouseleave', () => setDockTitle(fallbackTitle, ''));
      dock?.addEventListener('focusout', (event) => {
        if (!dock.contains(event.relatedTarget)) setDockTitle(fallbackTitle, '');
      });

      const jumpForm = document.querySelector('[data-jump-form]');
      jumpForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        const input = jumpForm.querySelector('input[name="artwork-number"]');
        const rawValue = Number(input?.value || 0);
        if (!Number.isFinite(rawValue) || rawValue < 1) return;
        const target = document.querySelector(`[data-artwork-number="${Math.floor(rawValue)}"]`);
        target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    })();

    (() => {
      const grid = document.getElementById('collection-grid');
      const sortButtons = Array.from(document.querySelectorAll('[data-series-sort]'));
      const countNode = document.querySelector('[data-catalog-count]');
      if (!grid || sortButtons.length === 0) return;

      const originalNodes = Array.from(grid.children);
      const cards = originalNodes.filter((node) => node.classList?.contains('ssr-card'));
      const totalCount = cards.length;
      const seriesMeta = {
        foundation: { label: 'Foundation', symbol: '\u2605' },
        chronicle: { label: 'Chronicle', symbol: '\u2318' },
        legend: { label: 'Legend', symbol: '\u2756' },
      };
      const seriesCounts = Object.keys(seriesMeta).reduce((counts, key) => {
        counts[key] = cards.filter((card) =>
          String(card.dataset.series || '').split(/\s+/).includes(key)
        ).length;
        return counts;
      }, {});

      sortButtons.forEach((button) => {
        const seriesKey = button.getAttribute('data-series-sort') || 'catalog';
        if (seriesKey === 'catalog') return;
        const count = seriesCounts[seriesKey] || 0;
        if (count === 0) {
          const meta = seriesMeta[seriesKey] || { label: 'Series' };
          button.disabled = true;
          button.classList.add('is-disabled');
          button.setAttribute('aria-disabled', 'true');
          button.setAttribute('title', `No ${meta.label} works in this collection`);
        }
      });

      const clearSortState = () => {
        cards.forEach((card) => card.classList.remove('is-series-sort-match'));
      };

      const setActiveButton = (activeKey) => {
        sortButtons.forEach((button) => {
          const isActive = button.getAttribute('data-series-sort') === activeKey;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      };

      const makeDivider = (seriesKey, matchCount) => {
        const meta = seriesMeta[seriesKey] || { label: 'Selected', symbol: '' };
        const divider = document.createElement('div');
        divider.className = 'catalog-range-marker series-sort-divider';
        divider.style.gridColumn = '1 / -1';
        divider.setAttribute('data-series-sort-divider', 'true');
        divider.innerHTML = `<span class="series-sort-divider-copy"><strong>End of ${meta.symbol} ${meta.label} Series Works</strong><small>Additional Series Works continue below in catalog order.</small></span><a href="#top">Back to top \u2191</a>`;
        divider.dataset.matchCount = String(matchCount);
        return divider;
      };

      const makeRangeMarker = (start, end, total, label = 'Artworks') => {
        const marker = document.createElement('div');
        marker.className = 'catalog-range-marker';
        marker.style.gridColumn = '1 / -1';
        marker.innerHTML = `<span>${label} ${start}&ndash;${end} of ${total}</span><a href="#top">Back to top</a>`;
        return marker;
      };

      const withRangeMarkers = (cardList, total, label = 'Artworks') => {
        const nodes = [];
        cardList.forEach((card, idx) => {
          if (idx > 0 && idx % 50 === 0) {
            const rangeStart = idx + 1;
            const rangeEnd = Math.min(idx + 50, total);
            nodes.push(makeRangeMarker(rangeStart, rangeEnd, total, label));
          }
          nodes.push(card);
        });
        return nodes;
      };

      const withCatalogRangeMarkers = (cardList) => {
        const nodes = [];
        let activeGroup = 0;
        cardList.forEach((card) => {
          const artworkNumber = Number(card.dataset.artworkNumber || 0);
          const group = Math.floor(Math.max(artworkNumber - 1, 0) / 50);
          if (group > activeGroup) {
            const rangeStart = group * 50 + 1;
            const rangeEnd = Math.min(rangeStart + 49, totalCount);
            nodes.push(makeRangeMarker(rangeStart, rangeEnd, totalCount));
            activeGroup = group;
          }
          nodes.push(card);
        });
        return nodes;
      };

      const applySort = (seriesKey) => {
        clearSortState();
        setActiveButton(seriesKey);

        if (seriesKey === 'catalog') {
          grid.replaceChildren(...originalNodes);
          if (countNode) countNode.textContent = `${totalCount} works`;
          window.dispatchEvent(new Event('resize'));
          return;
        }

        const matchingCards = cards.filter((card) =>
          String(card.dataset.series || '').split(/\s+/).includes(seriesKey)
        );
        const remainingCards = cards.filter((card) => !matchingCards.includes(card));

        matchingCards.forEach((card) => card.classList.add('is-series-sort-match'));
        const divider = makeDivider(seriesKey, matchingCards.length);
        grid.replaceChildren(
          ...withRangeMarkers(matchingCards, matchingCards.length, 'Series works'),
          divider,
          ...withCatalogRangeMarkers(remainingCards)
        );

        const meta = seriesMeta[seriesKey] || { label: 'Selected' };
        if (countNode) countNode.textContent = `${matchingCards.length} ${meta.label} \u00b7 ${totalCount} works`;
        window.dispatchEvent(new Event('resize'));
      };

      sortButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (button.disabled) return;
          applySort(button.getAttribute('data-series-sort') || 'catalog');
        });
      });
    })();

    (() => {
      const faqTriggers = Array.from(document.querySelectorAll('[data-faq-trigger]'));
      const faqPanels = Array.from(document.querySelectorAll('[data-faq-panel]'));
      const faqOverlays = Array.from(document.querySelectorAll('[data-faq-overlay]'));
      if (faqTriggers.length === 0) return;

      const isMobileFaq = () => window.matchMedia('(max-width: 768px)').matches;

      const closeAllFaqPanels = () => {
        faqTriggers.forEach((trigger) => {
          trigger.setAttribute('aria-expanded', 'false');
          const icon = trigger.querySelector('.faq-question__icon');
          if (icon) icon.textContent = '+';
        });

        faqPanels.forEach((panel) => {
          panel.setAttribute('aria-hidden', 'true');
          panel.classList.remove('is-open');
        });

        faqOverlays.forEach((overlay) => {
          overlay.hidden = true;
          overlay.classList.remove('is-open');
          overlay.innerHTML = '';
        });

        document.querySelectorAll('.faq-mobile-answer').forEach((node) => node.remove());
      };

      faqTriggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const targetId = trigger.getAttribute('data-faq-target');
          const targetPanel = targetId ? document.getElementById(targetId) : null;
          const triggerSide = trigger.getAttribute('data-faq-side');
          const overlaySide = triggerSide === 'left' ? 'right' : 'left';
          const overlay = document.querySelector(`[data-faq-overlay="${overlaySide}"]`);
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          const mobileMode = isMobileFaq();

          closeAllFaqPanels();
          if (!targetPanel || isOpen) return;

          trigger.setAttribute('aria-expanded', 'true');
          targetPanel.setAttribute('aria-hidden', 'false');
          targetPanel.classList.add('is-open');
          const icon = trigger.querySelector('.faq-question__icon');
          if (icon) icon.textContent = '-';
          const questionText = trigger.querySelector('.faq-question__text')?.textContent || '';

          if (mobileMode) {
            const inlineAnswer = document.createElement('div');
            inlineAnswer.className = 'faq-answer faq-mobile-answer is-open';
            inlineAnswer.innerHTML = `
              <p class="faq-overlay__eyebrow">Answer</p>
              <h3 class="faq-overlay__title">${questionText}</h3>
              <div class="faq-overlay__content">${targetPanel.innerHTML}</div>
            `;
            trigger.insertAdjacentElement('afterend', inlineAnswer);
            return;
          }

          if (!overlay) return;
          overlay.innerHTML = `
            <div class="faq-overlay__inner">
              <p class="faq-overlay__eyebrow">Answer</p>
              <h3 class="faq-overlay__title">${questionText}</h3>
              <div class="faq-overlay__content">${targetPanel.innerHTML}</div>
            </div>
          `;
          overlay.hidden = false;
          overlay.classList.add('is-open');
        });
      });
    })();

    (() => {
      const cards = Array.from(document.querySelectorAll('.ssr-card'));
      if (cards.length === 0) return;

      const isDesktopHover = () =>
        window.matchMedia('(min-width: 769px)').matches &&
        window.matchMedia('(hover: hover)').matches &&
        window.matchMedia('(pointer: fine)').matches;

      const applyRowCropping = () => {
        if (!isDesktopHover()) {
          cards.forEach((card) => card.style.removeProperty('--card-overlap'));
          return;
        }

        const measured = cards
          .map((card) => {
            const image = card.querySelector('.ssr-card-image');
            if (!image) return null;
            const imageHeight = image.getBoundingClientRect().height;
            if (imageHeight <= 0) return null;
            const top = Math.round(card.getBoundingClientRect().top);
            return { card, imageHeight, top };
          })
          .filter(Boolean)
          .sort((a, b) => a.top - b.top);

        if (measured.length === 0) return;

        const rows = [];
        measured.forEach((item) => {
          const row = rows[rows.length - 1];
          if (!row || Math.abs(row.top - item.top) > 4) {
            rows.push({ top: item.top, items: [item] });
            return;
          }
          row.items.push(item);
        });

        rows.forEach((row) => {
          const minImageHeight = Math.min(...row.items.map((item) => item.imageHeight));
          row.items.forEach((item) => {
            const overlap = Math.max(0, Math.round(item.imageHeight - minImageHeight));
            item.card.style.setProperty('--card-overlap', `${overlap}px`);
          });
        });
      };

      let frame = 0;
      const scheduleCropping = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(applyRowCropping);
      };

      if (isDesktopHover()) {
        cards.forEach((card) => {
          const image = card.querySelector('.ssr-card-image');
          if (!image || image.complete) return;
          image.addEventListener('load', scheduleCropping, { once: true });
        });
      }

      window.addEventListener('resize', scheduleCropping);
      window.addEventListener('load', scheduleCropping, { once: true });
      scheduleCropping();
    })();

    (() => {
      const links = Array.from(document.querySelectorAll('[data-doorway-image-link]'));
      if (links.length === 0) return;

      const trackDoorwayImageClick = (link) => {
        const imageId = link.getAttribute('data-image-id') || null;
        const galleryId = link.getAttribute('data-gallery-id') || window.location.pathname;
        const artworkNumber = link.getAttribute('data-artwork-number') || null;
        const context = {
          galleryId,
          imageId,
          pageType: 'image',
          trigger: 'commercial_doorway_grid',
          sourceLayer: 'commercial_doorway_all_page',
          artworkNumber,
        };

        if (typeof window.k4track === 'function') {
          window.k4track('browse_all_image_click', context);
        }
        if (typeof window.k4emitActionPixel === 'function') {
          window.k4emitActionPixel('browse_all_image_click', imageId, {
            galleryId,
            sourceLayer: 'doorway_browse_all_image_click_pixel_v1',
            pageType: 'image',
            trigger: 'commercial_doorway_grid',
          });
        }
      };

      links.forEach((link) => {
        link.addEventListener('click', () => trackDoorwayImageClick(link), { capture: true });
      });
    })();

    (() => {
      const tiles = Array.from(document.querySelectorAll('[data-series-tile]'));
      if (tiles.length === 0) return;
      const hoverDelay = 420;
      const hoverTimers = new WeakMap();
      const supportsDelayedHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      const clearHoverTimer = (tile) => {
        const timer = hoverTimers.get(tile);
        if (timer) {
          window.clearTimeout(timer);
          hoverTimers.delete(tile);
        }
      };

      const closeTiles = (except = null) => {
        tiles.forEach((tile) => {
          if (tile !== except) {
            clearHoverTimer(tile);
            tile.classList.remove('is-active', 'is-hover-ready');
          }
        });
      };

      tiles.forEach((tile) => {
        const trigger = tile.querySelector('.series-trigger');
        trigger?.addEventListener('click', (event) => {
          event.stopPropagation();
          clearHoverTimer(tile);
          const willOpen = !tile.classList.contains('is-active');
          closeTiles(tile);
          tile.classList.remove('is-hover-ready');
          tile.classList.toggle('is-active', willOpen);
        });
        tile.addEventListener('pointerenter', () => {
          if (!supportsDelayedHover) return;
          clearHoverTimer(tile);
          hoverTimers.set(tile, window.setTimeout(() => {
            closeTiles(tile);
            tile.classList.add('is-hover-ready');
          }, hoverDelay));
        });
        tile.addEventListener('pointerleave', () => {
          clearHoverTimer(tile);
          tile.classList.remove('is-hover-ready');
        });
        tile.addEventListener('focusout', (event) => {
          if (!tile.contains(event.relatedTarget)) {
            clearHoverTimer(tile);
            tile.classList.remove('is-active', 'is-hover-ready');
          }
        });
      });

      document.addEventListener('click', (event) => {
        if (!event.target.closest('[data-series-tile]')) closeTiles();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeTiles();
      });
    })();

    (() => {
      const noteCards = Array.from(document.querySelectorAll('.ssr-card'));
      const noteTriggers = Array.from(document.querySelectorAll('[data-notes-trigger]'));
      if (noteCards.length === 0 || noteTriggers.length === 0) return;

      const closeAll = (except = null) => {
        noteCards.forEach((card) => {
          if (card !== except) card.classList.remove('is-notes-open');
        });
      };

      noteTriggers.forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const card = trigger.closest('.ssr-card');
          if (!card) return;
          const willOpen = !card.classList.contains('is-notes-open');
          closeAll(card);
          card.classList.toggle('is-notes-open', willOpen);
          if (willOpen) {
            const link = card.querySelector('[data-doorway-image-link]');
            const imageId = link?.getAttribute('data-image-id') || null;
            const galleryId = link?.getAttribute('data-gallery-id') || window.location.pathname;
            if (typeof window.k4track === 'function') {
              window.k4track('collector_notes_open', {
                galleryId,
                imageId,
                pageType: 'gallery',
                trigger: 'commercial_doorway_card_notes',
                sourceLayer: 'commercial_doorway_all_page',
              });
            }
            if (typeof window.k4emitActionPixel === 'function') {
              window.k4emitActionPixel('collector_notes_open', imageId, {
                galleryId,
                sourceLayer: 'doorway_collector_notes_open_pixel_v1',
                pageType: 'gallery',
                trigger: 'commercial_doorway_card_notes',
              });
            }
          }
        });
      });

      document.addEventListener('click', (event) => {
        if (event.target.closest('[data-notes-trigger]') || event.target.closest('[data-notes-overlay]')) return;
        closeAll();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeAll();
      });
    })();

  </script>

</BaseLayout>
