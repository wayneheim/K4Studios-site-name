---
import Footer from "@/components/Footer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArchiveContext from "@/components/ArchiveContext.astro";
import WesternDefinitions from "@/components/blog/WesternDefinitions.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import VideoStoryWidget from "@/components/VideoStoryWidget.astro";
import { extractImageId, getSemanticImageUrl } from "@/utils/imageProxy.js";
import {
  getFormattedLowestStandardPrintPrice,
  getStandardPrintSeries,
} from "@/data/pricing/printSeries.js";
import { getSketchOfferShippingDetails, resolveImageCommerce } from "@/data/commerceResolver.js";

type BreadcrumbItem = { name: string; href: string };
type GridSection = {
  title: string;
  slug?: string;
  description?: string;
  timeZone?: string;
  galleryPath: string;
  allHref: string;
  ctaLabel?: string;
  ctaThumb?: string;
  alternateCtaLabel?: string;
  alternateCtaHref?: string;
  alternateCtaKicker?: string;
  alternateCtaCount?: string;
  items: any[];
  limit?: number;
};
type GatewayVideoWidget = {
  videoSlug?: string;
  youtubeId?: string;
  kicker?: string;
  label?: string;
  title?: string;
  compact?: boolean;
  withRules?: boolean;
  ctaWidth?: string;
  ruleWidth?: string;
};
type AuthorityItem = {
  label?: string;
  text: string;
};

const {
  rawGalleryData,
  entranceData,
  basePath,
  contentBasePath: configuredContentBasePath,
  canonicalPath: configuredCanonicalPath,
  breadcrumbHtml,
  breadcrumbStructuredItems,
  sectionDockItems,
  dockCenterIndex,
  currentDockTitle,
  archiveContext = {},
  identity = {},
  copy = {},
  faqItems = [],
  gridSections = [],
  gatewayVideoWidget = null,
  dockVariant = "",
  layoutVariant = "",
} = Astro.props as {
  rawGalleryData: any[];
  entranceData?: any;
  basePath: string;
  contentBasePath?: string;
  canonicalPath?: string;
  breadcrumbHtml: string;
  breadcrumbStructuredItems: BreadcrumbItem[];
  sectionDockItems: any[];
  dockCenterIndex: number;
  currentDockTitle: string;
  archiveContext?: {
    categoryUrl?: string;
    categoryName?: string;
  };
  identity?: {
    collectionName?: string;
    variantName?: string;
    variantDescriptor?: string;
    gatewayBrandLabel?: string;
  };
  copy?: Record<string, any>;
  faqItems?: Array<{ q: string; a: string[] }>;
  gridSections?: GridSection[];
  gatewayVideoWidget?: GatewayVideoWidget | null;
  dockVariant?: string;
  layoutVariant?: string;
};

// âœ… Filter out ghosts and hidden (archived) images
const galleryData = rawGalleryData.filter((img: any) => 
  img.visibility !== "ghost" && 
  img.visibility !== "hidden" && 
  img.id !== "i-k4studios"
);

const activeThemeSlug = Astro.url.searchParams.get("theme") || "";
const filteredGalleryData = activeThemeSlug
  ? galleryData.filter((img: any) => Boolean(img?.themes?.[activeThemeSlug]))
  : galleryData;

const humanizeSegment = (segment = "") =>
  decodeURIComponent(String(segment || ""))
    .replace(/-/g, " ")
    .trim();
const slugify = (value = "") =>
  String(value || "")
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

// âœ… Clean URL paths
const siteOrigin = "https://www.k4studios.com";
const contentBasePath = configuredContentBasePath || basePath;
const canonicalPath = configuredCanonicalPath || `${basePath}/all`;
const canonicalUrl = `${siteOrigin}${canonicalPath}`;
const galleryBaseUrl = `${siteOrigin}${contentBasePath}`;
const collectionPageId = `${canonicalUrl}#collectionpage`;
const imageGalleryId = `${galleryBaseUrl}#imagegallery`;
const itemListId = `${canonicalUrl}#itemlist`;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;

// âœ… Gallery metadata
const collectionSlug = basePath.split("/").filter(Boolean).at(-2) || "Western-Narratives";
const variantSlug = basePath.split("/").filter(Boolean).at(-1) || "Color";
const collectionName = identity.collectionName || humanizeSegment(collectionSlug) || "Western Narratives";
const variantName = identity.variantName || humanizeSegment(variantSlug) || "Color";
const variantDescriptor = identity.variantDescriptor || variantName.toLowerCase();
const galleryTitle = `${collectionName} - ${variantName}`;
const gallerySubtitle = entranceData?.subtitle || "Painterly Fine Art Photography";
const imageCount = filteredGalleryData.length;
const formatCopy = (value = "") =>
  String(value)
    .replaceAll("{imageCount}", String(imageCount))
    .replaceAll("{catalogImageCount}", String(catalogImageCount))
    .replaceAll("{variantName}", variantName)
    .replaceAll("{variantLower}", variantName.toLowerCase())
    .replaceAll("{variantDescriptor}", variantDescriptor)
    .replaceAll("{collectionName}", collectionName)
    .replaceAll("{collectionLower}", collectionName.toLowerCase())
    .replaceAll("{lowestPrintPrice}", getFormattedLowestStandardPrintPrice());
const normalizedGridSections = gridSections
  .map((section) => ({
    ...section,
    slug: section.slug || slugify(section.title),
    items: (section.items || []).filter((img: any) =>
      img?.id &&
      img.visibility !== "ghost" &&
      img.visibility !== "hidden" &&
      img.id !== "i-k4studios"
    ),
    limit: section.limit || 19,
  }))
  .filter((section) => section.items.length > 0);
const hasSectionedCatalog = normalizedGridSections.length > 0;
const catalogImageCount = hasSectionedCatalog
  ? normalizedGridSections.reduce((total, section) => total + section.items.length, 0)
  : imageCount;
const schemaImageGalleryId = hasSectionedCatalog ? `${canonicalUrl}#imagegallery` : imageGalleryId;

// âœ… Search-facing title and description (factual, not poetic)
const gatewayBrandLabel = identity.gatewayBrandLabel || `${collectionName} Fine Art Prints - ${variantName} Collection`;
const gatewayBrandLabelDisplay = formatCopy(gatewayBrandLabel);
const gatewayBrandLabelLines = gatewayBrandLabelDisplay
  .split(/\n+/)
  .map((line) => line.trim())
  .filter(Boolean);
const seoTitle = formatCopy(copy.seoTitle || `${gatewayBrandLabel} | K4 Studios`);
const seoDescription = formatCopy(copy.seoDescription || `Browse ${imageCount} ${variantDescriptor} ${collectionName.toLowerCase()} fine art prints by Wayne Heim, with collector notes and print options from ${getFormattedLowestStandardPrintPrice()}.`);

// âœ… Genre definition (entity authority - what IS this type of photography)

// âœ… Authoritative definition block (per Quill: scope, authorship, completeness)
const indexDefinition = formatCopy(copy.indexDefinition || `This page presents the complete ${variantName.toLowerCase()} archive of ${collectionName} by Wayne Heim.`);
const indexLinkNote = formatCopy(copy.indexLinkNote || `All ${imageCount} images link to individual image pages with full stories, metadata, and collector information.`);
const printAvailabilityNote = formatCopy(copy.printAvailabilityNote || `All works are available as fine art prints from ${getFormattedLowestStandardPrintPrice()}. Select images are also available in the Engrained Series - printed on Baltic Birch using a five-layer UV process - with pricing specific to each image.`);
const commercialH1 = formatCopy(copy.commercialH1 || `${collectionName} Fine Art Series`);
const commercialDeck = formatCopy(copy.commercialDeck || `A collection of painterly fine art photography by Wayne Heim.`);
const gridIntroTitle = formatCopy(copy.gridIntroTitle || "");
const gridIntroCopy = formatCopy(copy.gridIntroCopy || "");
const catalogEntranceTitle = formatCopy(copy.catalogEntranceTitle || `Story-Driven Fine Art Prints by Wayne Heim`);
const catalogEntranceCopy = formatCopy(copy.catalogEntranceCopy || `Browse cinematic, painterly photography built as single-frame stories - artwork created for collectors who want more than decoration.`);
const collectionIntro = formatCopy(copy.collectionIntro || `Browse the complete collection. Each artwork opens to its full story, collector notes, image metadata, and available print details.`);
const collectionIntroParagraphs = collectionIntro
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const trustBarCopy = formatCopy(copy.trustBarCopy || "");
const isCinematicConceptSeriesTopLayout = layoutVariant === "cinematic-concept-series-top";
const isCinematicConceptLayout = layoutVariant === "cinematic-concept" || isCinematicConceptSeriesTopLayout;
const showDockBeforeCatalog = !isCinematicConceptLayout || isCinematicConceptSeriesTopLayout;
const showDockAfterCatalog = isCinematicConceptLayout && !isCinematicConceptSeriesTopLayout;
const showSeriesBeforeCatalog = !isCinematicConceptLayout || isCinematicConceptSeriesTopLayout;
const showSeriesAfterCatalog = isCinematicConceptLayout && !isCinematicConceptSeriesTopLayout;
const catalogSectionKickerTemplate = String(copy.catalogSectionKicker || "Selected Western Wall Art - {sectionCount} in Series");
const splitConceptCopy = (value = "") =>
  formatCopy(value)
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
const conceptBlocks = [
  {
    title: formatCopy(copy.conceptBlock1Title || ""),
    paragraphs: splitConceptCopy(copy.conceptBlock1Copy || ""),
  },
  {
    title: formatCopy(copy.conceptBlock2Title || ""),
    paragraphs: splitConceptCopy(copy.conceptBlock2Copy || ""),
  },
  {
    title: formatCopy(copy.conceptBlock3Title || ""),
    paragraphs: splitConceptCopy(copy.conceptBlock3Copy || ""),
  },
  {
    title: formatCopy(copy.conceptBlock4Title || ""),
    paragraphs: splitConceptCopy(copy.conceptBlock4Copy || ""),
  },
  {
    title: formatCopy(copy.conceptBlock5Title || ""),
    paragraphs: splitConceptCopy(copy.conceptBlock5Copy || ""),
  },
  {
    title: formatCopy(copy.conceptBlock6Title || ""),
    paragraphs: splitConceptCopy(copy.conceptBlock6Copy || ""),
  },
];
const collectingKicker = formatCopy(copy.collectingKicker || "");
const collectingTitle = formatCopy(copy.collectingTitle || "");
const collectingParagraphs = splitConceptCopy(copy.collectingCopy || "");
const archiveContextKicker = formatCopy(copy.archiveContextKicker || "");
const archiveContextTitle = formatCopy(copy.archiveContextTitle || "");
const archiveContextParagraphs = splitConceptCopy(copy.archiveContextCopy || "");
const cornerstoneVariant = String(copy.cornerstoneVariant || "").trim();
const gatewayKicker = formatCopy(copy.gatewayKicker || "K4 STUDIOS FINE ART PRINT CATALOG");
const gatewayCollectionName = formatCopy(copy.gatewayCollectionName || collectionName);
const gatewayBrandClass = String(copy.gatewayBrandClass || "").trim();
const gatewayIntroCopy = formatCopy(copy.gatewayIntroCopy || `${imageCount} painterly ${variantName.toLowerCase()} ${collectionName.toLowerCase()} fine art photographs by Wayne Heim, available as archival fine art prints from ${getFormattedLowestStandardPrintPrice()}. Four edition tiers - open-edition studies to ultra-limited signed collector works - on fine art paper and Baltic Birch wood panels.`);
const gatewaySupportingCopy = formatCopy(copy.gatewaySupportingCopy || `Every image below is a complete story in a single frame. Click any work to read the narrative, explore collector notes, and view print details.`);
const gatewaySupportingParagraphs = gatewaySupportingCopy
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const defaultAuthorityItems: AuthorityItem[] = [
  {
    label: "Editorial recognition",
    text: "Featured by Art of the West in a 2026 editorial on painterly Western photography, One-Image Movies, and narrative fine art process.",
  },
  {
    label: "Juried Western exhibition",
    text: "Two works accepted into the 2026 Western Spirit Juried Art Show & Sale at the Cheyenne Frontier Days Old West Museum.",
  },
  {
    label: "Western Art Week",
    text: "Accepted exhibitor in the 2026 Great Western Art Show during Western Art Week in Great Falls, Montana.",
  },
  {
    label: "Artist background",
    text: "Award-winning medical illustrator with a BFA from the Cleveland Institute of Art, bringing disciplined visual structure to the photographic work.",
  },
];
const authorityItems = (Array.isArray(copy.authorityItems) ? copy.authorityItems : defaultAuthorityItems)
  .map((item: AuthorityItem | string) => {
    if (typeof item === "string") {
      return { text: formatCopy(item) };
    }

    return {
      label: item?.label ? formatCopy(item.label) : "",
      text: item?.text ? formatCopy(item.text) : "",
    };
  })
  .filter((item: AuthorityItem) => item.text);
const showAuthorityPanel = copy.showAuthorityPanel !== false && authorityItems.length > 0;
const authorityKicker = formatCopy(copy.authorityKicker || "Final Notes");
const authorityTitle = formatCopy(copy.authorityTitle || "About the artist behind the work");
const authorityIntro = formatCopy(copy.authorityIntro || "Wayne Heim's painterly Western photography is grounded in decades of visual storytelling as a fine art photographer and award-winning medical illustrator, with peer-reviewed exhibition and editorial recognition in Western art contexts.");
const authorityPrimaryHref = String(copy.authorityPrimaryHref || "/News-Awards");
const authorityPrimaryLabel = formatCopy(copy.authorityPrimaryLabel || "View press, awards, and exhibitions");
const authoritySecondaryHref = String(copy.authoritySecondaryHref || "/Other/Bio");
const authoritySecondaryLabel = formatCopy(copy.authoritySecondaryLabel || "About Wayne Heim");
const standardPrintSeries = getStandardPrintSeries() as Array<{
  name: string;
  subtitle: string;
  collectorSummary: string;
  symbol: string;
  learnMoreHref: string;
  sizes: Array<{ display: string }>;
}>;

// âœ… Text cleaner for JSON-LD (escapes quotes for JSON)
const cleanForJson = (val = "") =>
  String(val)
    .replace(/[\u0000-\u001F]+/g, " ")
    .replace(/"/g, '\\"')
    .replace(/\r?\n|\r/g, " ")
    .trim();

// âœ… Text cleaner for HTML display (preserves quotes)
const cleanForDisplay = (val = "") =>
  String(val)
    .replace(/[\u0000-\u001F]+/g, " ")
    .replace(/\r?\n|\r/g, " ")
    .trim();

const hasDanglingEnding = (text = "") =>
  /\b(?:a|an|and|as|at|between|by|for|from|in|into|of|on|or|the|through|to|under|with|without)\.?$/i.test(text.trim());

const trimAtCleanWordBoundary = (text = "", maxLen = 150) => {
  let trimmed = text.slice(0, maxLen).replace(/\s+\S*$/, "").trim();
  trimmed = trimmed.replace(/\s+\b(?:a|an|and|as|at|between|by|for|from|in|into|of|on|or|the|through|to|under|with|without)$/i, "").trim();
  return trimmed ? `${trimmed}…` : "";
};

const truncateExcerpt = (text: string, maxLen = 150) => {
  const cleaned = cleanForDisplay(text);
  if (!cleaned) return "";
  if (cleaned.length <= maxLen) return cleaned;

  const limitSlice = cleaned.slice(0, maxLen + 1);
  const sentenceMatches = [...limitSlice.matchAll(/[.!?](?=(?:["')\]]*)\s|(?:["')\]]*)$)/g)];
  const sentenceEnd = sentenceMatches.at(-1)?.index;

  if (sentenceEnd !== undefined && sentenceEnd >= 40) {
    const sentenceExcerpt = limitSlice.slice(0, sentenceEnd + 1).trim();
    if (!hasDanglingEnding(sentenceExcerpt)) return sentenceExcerpt;
  }

  return trimAtCleanWordBoundary(cleaned, maxLen);
};

const truncateStoryExcerpt = (text: string, maxLen = 100) => {
  const cleaned = cleanForDisplay(text);
  if (!cleaned) return "";
  if (cleaned.length <= maxLen) return cleaned;
  const wordSafe = cleaned.slice(0, maxLen).replace(/\s+\S*$/, "").trimEnd();
  return `${wordSafe || cleaned.slice(0, maxLen).trimEnd()}...`;
};

const buildSketchProductDescription = (image: any, imageName: string) => {
  const imageSummary = truncateExcerpt(image?.description || image?.alt || "", 130);
  const base = `${imageName} is offered as a Sketch Series fine art print by Wayne Heim through K4 Studios.`;
  return imageSummary ? `${base} ${imageSummary}` : base;
};

const buildSketchProductOffer = (image: any, imagePageUrl: string, galleryPath: string) => {
  const commerce = resolveImageCommerce({
    image,
    galleryPath,
    pageUrl: imagePageUrl,
  });

  return commerce?.merchantOffer || {
    "@type": "Offer",
    "url": imagePageUrl,
    "price": 25,
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": { "@id": "https://www.k4studios.com/#organization" },
    "shippingDetails": getSketchOfferShippingDetails(),
  };
};

const truncateBookendExcerpt = (text: string, headLen = 100, tailLen = 300) => {
  const cleaned = cleanForDisplay(text);
  if (!cleaned) return "";
  const totalLen = headLen + tailLen;
  if (cleaned.length <= totalLen) return cleaned;
  const head = cleaned.slice(0, headLen).replace(/\s+\S*$/, "").trimEnd();
  const tail = cleaned.slice(-tailLen).replace(/^\S+\s+/, "").trimStart();
  return `${head || cleaned.slice(0, headLen).trimEnd()}\u00a0.\u00a0.\u00a0.\u00a0\u00a0${tail || cleaned.slice(-tailLen).trimStart()}`;
};

// âœ… Proxy URL helper - never expose SmugMug URLs to crawlers
const getProxySrc = (id: string, size: string = 'l') => {
  const image = filteredGalleryData.find((item: any) => item.id === id)
    || galleryData.find((item: any) => item.id === id)
    || { id };
  return getSemanticImageUrl(image, { galleryPath: contentBasePath }, size);
};

const getSectionProxySrc = (image: any, galleryPath: string, size: string = 'l') =>
  getSemanticImageUrl(image, { galleryPath }, size);

const forceImageSize = (src = "", size: string = 's', galleryPath = contentBasePath) => {
  const value = String(src || "");
  if (!value) return "";
  if (value.startsWith("/images/")) return value;

  const imageId = extractImageId(value);
  if (!imageId) return value;

  const image = filteredGalleryData.find((item: any) => item.id === imageId)
    || galleryData.find((item: any) => item.id === imageId)
    || { id: imageId };

  return getSemanticImageUrl(image, { galleryPath }, size);
};

const getCardSeries = (image: any, galleryPath = contentBasePath) => {
  const commerce: any = resolveImageCommerce({
    image,
    galleryPath,
    pageUrl: `${siteOrigin}${galleryPath}/${image?.id || ""}`,
  });
  return commerce?.tiers || [];
};

const toAbsoluteK4Url = (url = "") => {
  if (!url) return `${siteOrigin}/images/show-2t.webp`;
  if (/^https?:\/\//i.test(url)) return url;
  return `${siteOrigin}${url.startsWith("/") ? "" : "/"}${url}`;
};

const gatewayHeroItem = filteredGalleryData[0] || galleryData[0];
const gatewayHeroOverrideSrc = forceImageSize(formatCopy(copy.gatewayHeroSrc || ""), 'm');
const gatewayHeroTitle = cleanForDisplay(formatCopy(copy.gatewayHeroTitle || "") || gatewayHeroItem?.title || galleryTitle);
const gatewayHeroAlt = copy.gatewayHeroAlt
  ? cleanForDisplay(formatCopy(copy.gatewayHeroAlt))
  : gatewayHeroItem?.alt
  ? `${cleanForDisplay(gatewayHeroItem.alt).replace(/[.\s]*$/, "")}. Collection hero image.`
  : `Fine art photograph by Wayne Heim: ${gatewayHeroTitle}`;
const gatewayHeroHref = copy.gatewayHeroHref
  ? formatCopy(copy.gatewayHeroHref)
  : gatewayHeroItem
    ? `${contentBasePath}/${gatewayHeroItem.id}`
    : "#collection-grid";
const gatewayHeroSrc = gatewayHeroOverrideSrc || (gatewayHeroItem ? getProxySrc(gatewayHeroItem.id, 'm') : "");
const gatewayHeroSrcSet = gatewayHeroOverrideSrc
  ? `${forceImageSize(gatewayHeroOverrideSrc, 's')} 400w, ${forceImageSize(gatewayHeroOverrideSrc, 'm')} 720w`
  : gatewayHeroItem
  ? `${getProxySrc(gatewayHeroItem.id, 's')} 400w, ${getProxySrc(gatewayHeroItem.id, 'm')} 720w`
  : "";
const gatewayHeroObjectPosition = formatCopy(copy.gatewayHeroObjectPosition || "center 28%");
const gatewayHeroStyle = [
  `--gateway-hero-object-position:${gatewayHeroObjectPosition}`,
].join(";");
const seenCardAltCounts = new Map<string, number>();
const fallbackSocialImage = "/images/show-2t.webp";
const socialImage = gatewayHeroSrc || (filteredGalleryData[0] ? getProxySrc(filteredGalleryData[0].id, 'l') : "") || fallbackSocialImage;
const socialImageUrl = toAbsoluteK4Url(socialImage);
const socialImageAlt = `${collectionName} Fine Art Prints by Wayne Heim`;
const MAX_PRODUCT_SCHEMA_ITEMS = 48;

// âœ… Pre-build per-image JSON-LD to avoid streaming issues
const imageJsonLdMap = new Map();
filteredGalleryData.forEach((item: any) => {
  // Capped at 'l' to protect XL from bot discovery
  const imageUrl = getProxySrc(item.id, 'l');
  const linkUrl = `${contentBasePath}/${item.id}`;
  const fullUrl = `https://www.k4studios.com${linkUrl}`;
  const title = cleanForJson(item.title);
  const altText = item.alt 
    ? cleanForJson(item.alt)
    : `Western cowboy fine art photograph: ${title} - Wayne Heim`;
  
  imageJsonLdMap.set(item.id, JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ImageObject",
    name: title,
    description: altText,
    contentUrl: imageUrl,
    url: fullUrl,
    creditText: "(c) Wayne Heim - K4 Studios",
    license: "https://www.k4studios.com/licensing",
    creator: { "@type": "Person", name: "Wayne Heim" },
    mainEntityOfPage: fullUrl
  }));
});

const schemaListItems = hasSectionedCatalog
  ? normalizedGridSections.flatMap((section) =>
      section.items.map((image: any) => ({
        image,
        galleryPath: section.galleryPath,
      }))
    )
  : filteredGalleryData.map((image: any) => ({
      image,
      galleryPath: contentBasePath,
    }));
const schemaListItemCount = schemaListItems.filter((entry: any) => entry.image?.id).length;

const itemListElement = schemaListItems
  .filter((entry: any) => entry.image?.id)
  .slice(0, MAX_PRODUCT_SCHEMA_ITEMS)
  .map((entry: any, index: number) => {
    const image = entry.image;
    const imageBaseUrl = `${siteOrigin}${entry.galleryPath || contentBasePath}`;
    const imagePageUrl = `${imageBaseUrl}/${image.id}`;
    const imageName = cleanForDisplay(image.title || image.id);

    return {
      "@type": "ListItem",
      "position": index + 1,
      "url": imagePageUrl,
      "name": imageName,
      "item": {
        "@type": "Product",
        "@id": `${imagePageUrl}#product-sketch`,
        "name": `${imageName} - Sketch Series Print`,
        "url": imagePageUrl,
        "image": toAbsoluteK4Url(getProxySrc(image.id, 'l')),
        "description": buildSketchProductDescription(image, imageName),
        "sku": `${image.id}-sketch`,
        "brand": {
          "@type": "Brand",
          "@id": "https://www.k4studios.com/#organization",
          "name": "K4 Studios"
        },
        "offers": buildSketchProductOffer(image, imagePageUrl, entry.galleryPath || contentBasePath),
      },
    };
  });
const stripHtml = (value = "") =>
  String(value)
    .replace(/<[^>]+>/g, "")
    .replace(/\s+/g, " ")
    .trim();
const faqSchemaEntity = faqItems
  .filter((item: any) => item?.q && Array.isArray(item.a) && item.a.length > 0)
  .map((item: any) => ({
    "@type": "Question",
    "name": stripHtml(item.q),
    "acceptedAnswer": {
      "@type": "Answer",
      "text": stripHtml(item.a.join(" ")),
    },
  }));

const breadcrumbJsonItems = [
  { "@type": "ListItem", "position": 1, "item": { "@id": `${siteOrigin}/`, "name": "Home" } },
  ...(breadcrumbStructuredItems || []).map((item, index) => ({
    "@type": "ListItem",
    "position": index + 2,
    "item": {
      "@id": `${siteOrigin}${item.href}`,
      "name": item.name,
    },
  })),
  { "@type": "ListItem", "position": (breadcrumbStructuredItems || []).length + 2, "item": { "@id": canonicalUrl, "name": copy.breadcrumbCurrentName || collectionName } },
];

const structuredDataJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": collectionPageId,
      "url": canonicalUrl,
      "name": seoTitle,
      "description": seoDescription,
      "inLanguage": "en",
      "isPartOf": {
        "@id": "https://www.k4studios.com/#website"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": socialImageUrl,
        "caption": seoTitle
      },
      "creator": { "@id": "https://www.k4studios.com/#person" },
      "publisher": { "@id": "https://www.k4studios.com/#organization" },
      "mainEntity": { "@id": schemaImageGalleryId }
    },
    {
      "@type": "ImageGallery",
      "@id": schemaImageGalleryId,
      "url": hasSectionedCatalog ? canonicalUrl : galleryBaseUrl,
      "name": hasSectionedCatalog ? `${collectionName} Collection` : `${galleryTitle} Collection`,
      "description": seoDescription,
      "creator": { "@id": "https://www.k4studios.com/#person" },
      "publisher": { "@id": "https://www.k4studios.com/#organization" },
      "mainEntity": { "@id": itemListId }
    },
    {
      "@type": "ItemList",
      "@id": itemListId,
      "name": hasSectionedCatalog ? `${collectionName} Image List` : `${galleryTitle} Image List`,
      "numberOfItems": schemaListItemCount,
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "itemListElement": itemListElement
    },
    {
      "@type": "BreadcrumbList",
      "@id": breadcrumbId,
      "itemListElement": breadcrumbJsonItems
    },
    ...(faqSchemaEntity.length > 0 ? [{
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqSchemaEntity
    }] : [])
  ]
}, null, 2);

const pageMeta = {
  canonicalUrl,
  robots: "index, follow",
  descriptionMaxLength: copy.descriptionMaxLength || 190,
  ogTitle: seoTitle,
  ogDescription: seoDescription,
  ogImage: socialImage,
  ogImageAlt: socialImageAlt,
  ogUrl: canonicalUrl,
  twitterTitle: seoTitle,
  twitterDescription: seoDescription,
  twitterImage: socialImage,
  twitterUrl: canonicalUrl,
};

const compactBreadcrumbHtml = breadcrumbHtml
  .replace(/>Wayne Heim</g, ">WH<")
  .replace(/Western Wall Art for Interior Designers/g, "Western Art for Interior Designers")
  .replace(/\s*\|\s*<a href="[^"]*\/K4-Select-Series">K4 Select Series<\/a>/g, "")
  .replace(/Painterly Fine Art Photography/g, "Painterly Photography")
  .replace(/Facing History/g, "FH")
  .replace(/>By (Location|Theme)</g, ">$1<")
  .replace(/\|\s*(?:Collection|Series)\s*$/, "");

const faqSplitIndex = Math.ceil(faqItems.length / 2);
const faqLeft = faqItems.slice(0, faqSplitIndex);
const faqRight = faqItems.slice(faqSplitIndex);
---

<BaseLayout title={seoTitle} description={seoDescription} meta={pageMeta} structuredDataJSON={structuredDataJson} disableAutoBreadcrumbs={true}>
  <link href="https://fonts.googleapis.com/css2?family=Glegoo:wght@400;700&display=swap" rel="stylesheet" />

  <div class="all-page-header-frame">
    <LandingHeader client:load breadcrumb={compactBreadcrumbHtml} />
  </div>

  <div class:list={["gallery-index-wrapper", isCinematicConceptLayout && "cinematic-concept-page", isCinematicConceptSeriesTopLayout && "cinematic-concept-series-top-page"]} id="top">
    <!-- K4 Studios Catalog Entrance -->
    <section class="collection-gateway catalog-entrance" aria-labelledby="gateway-heading">
      <div class="gateway-artwork-column">
        <a class="gateway-artwork" href={gatewayHeroHref} aria-label={`Open artwork detail for ${gatewayHeroTitle}`}>
          <span class="gateway-artwork-mat">
            <img
              src={gatewayHeroSrc}
              srcset={gatewayHeroSrcSet || undefined}
              sizes="(max-width: 768px) 100vw, (max-width: 1100px) 42vw, 480px"
              alt={gatewayHeroAlt}
              style={gatewayHeroStyle}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </span>
        </a>
        {gatewayVideoWidget && (
          <VideoStoryWidget class="gateway-video-widget" {...gatewayVideoWidget} />
        )}
      </div>
      <div class="gateway-copy">
        <p class="gateway-kicker">{gatewayKicker}</p>
        <h1 class:list={["gateway-brand", gatewayBrandClass]} id="gateway-heading">
          {gatewayBrandLabelLines.length > 1
            ? gatewayBrandLabelLines.map((line, index) => (
                <><span>{line}</span>{index < gatewayBrandLabelLines.length - 1 && <br />}</>
              ))
            : gatewayBrandLabelDisplay}
        </h1>
        <p class="gateway-copy-text">{gatewayIntroCopy}</p>
        {gatewaySupportingParagraphs.map((paragraph) => (
          <p class="gateway-copy-text">{paragraph}</p>
        ))}
      </div>
    </section>

    <!-- K4 Section Dock Prototype -->
    {showDockBeforeCatalog && (
    <section class:list={["collection-dock", dockVariant === "wall-art" && "collection-dock--wall-art"]} aria-labelledby="collection-dock-heading">
      <div class="dock-heading">
        <div>
          <h2 id="collection-dock-heading"><span id="dock-active-prefix"></span><span id="dock-active-title">{currentDockTitle}</span></h2>
        </div>
      </div>
      <div class="dock-shell">
        <div class="dock-track" aria-label="K4 gallery all-page quick links">
          <span id="dock-start" class="dock-anchor" aria-hidden="true"></span>
          {sectionDockItems.map((item: any, idx: number) => {
            if (item.separator) {
              return <span class="dock-separator" role="separator" aria-label={item.label || "Related section divider"}></span>;
            }

            const displayTitle = [item.title, item.subtitle].filter(Boolean).join(' ');
            const dockActionLabel = item.dockPrefix === "" ? displayTitle : `${item.dockPrefix || "Browse"} ${displayTitle}`;
            const distance = Math.abs(idx - dockCenterIndex);
            const dockClass = [
              'dock-card',
              item.dockRole ? `dock-card--${item.dockRole}` : '',
              item.current ? 'is-center is-current' : '',
              distance === 1 ? 'is-near' : '',
              distance >= 3 ? 'is-far' : '',
            ].filter(Boolean).join(' ');

            return (
              <a
                class={dockClass}
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
                aria-label={item.current ? `Current collection: ${displayTitle}` : dockActionLabel}
                data-dock-title={displayTitle}
                data-dock-prefix={item.dockPrefix}
                data-current={item.current ? 'true' : undefined}
              >
                <div class="dock-tombstone">
                  <img
                    src={forceImageSize(item.thumb, 's')}
                    alt=""
                    loading={item.current || distance <= 1 ? 'eager' : 'lazy'}
                    width="140"
                    height="160"
                  />
                </div>
                <span class="sr-only">{item.current ? `Current collection: ${displayTitle}` : dockActionLabel}</span>
              </a>
            );
          })}
          <span id="dock-end" class="dock-anchor" aria-hidden="true"></span>
        </div>
      </div>
    </section>
    )}

    <!-- Current Collection Identity -->
    <section class="collection-hero" aria-labelledby="collection-hero-heading">
      <h2 id="collection-hero-heading">{commercialH1}</h2>
      <p class="hero-deck">{commercialDeck}</p>
      {collectionIntroParagraphs.length > 0 && (
        <p class="hero-copy">
          {collectionIntroParagraphs.map((paragraph, index) => (
            <>
              {index > 0 && <><br /><br /></>}
              <span set:html={paragraph}></span>
            </>
          ))}
        </p>
      )}
    </section>

    <span id="collection-browser" class="collection-browser-anchor" aria-hidden="true"></span>
    <hr class="catalog-anchor-rule" />
    {showSeriesBeforeCatalog && (
      <>
        <p class="print-options-heading">K4 Series and Limited Editions &middot; Fine Art Prints from {getFormattedLowestStandardPrintPrice()}</p>

        <!-- Available Print Series -->
        <section class="print-options" aria-labelledby="print-options-heading">
          <div class="series-widget" aria-label="Standard K4 paper print series">
            {standardPrintSeries.map((series) => (
              <article class="series-tile" data-series-tile>
                <button class="series-trigger" type="button" aria-label={`Show ${series.name} details`}>
                  <span class="series-symbol" aria-hidden="true">{series.symbol}</span>
                  <span>
                    <strong>{series.name}</strong>
                    <small>{series.subtitle}</small>
                  </span>
                </button>
                <div class="series-detail">
                  <p class="series-detail-copy">
                    <span class="series-detail-title">
                      <span class="series-detail-symbol" aria-hidden="true">{series.symbol}</span>
                      <strong>{series.name}:</strong>
                    </span>
                    <span>{series.collectorSummary}</span>
                  </p>
                  <div class="series-detail-footer">
                    <ul class="series-detail-sizes">
                      {series.sizes.map((entry: any) => (
                        <li>{entry.display}</li>
                      ))}
                    </ul>
                    <a class="series-detail-link" href={series.learnMoreHref}>Learn more &rarr;</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      </>
    )}

    {trustBarCopy && (
      <p class="catalog-trust-bar" set:html={trustBarCopy}></p>
    )}

    {normalizedGridSections.length === 0 && (
      <>
        <!-- Catalog Tools -->
        <section class="catalog-tools" aria-labelledby="catalog-tools-heading">
          <h2 id="catalog-tools-heading" class="catalog-tools-title">{gatewayCollectionName} Collection</h2>
          <span class="catalog-tools-divider" aria-hidden="true">|</span>
          <div class="series-sort" aria-label="Sort collection by print series">
            <span class="series-sort-label">Sorting:</span>
            <button class="series-sort-button is-active" type="button" data-series-sort="catalog" aria-pressed="true" title="Catalog order / all works">#/&#10045;</button>
            <button class="series-sort-button" type="button" data-series-sort="foundation" aria-pressed="false" title="Foundation first">&#9733;</button>
            <button class="series-sort-button" type="button" data-series-sort="chronicle" aria-pressed="false" title="Chronicle first">&#8984;</button>
            <button class="series-sort-button" type="button" data-series-sort="legend" aria-pressed="false" title="Legend first">&#10070;</button>
          </div>
          <span class="catalog-tools-divider" aria-hidden="true">|</span>
          <form class="jump-form" data-jump-form>
            <label for="artwork-number">Jump to image #</label>
            <input id="artwork-number" name="artwork-number" type="number" min="1" max={imageCount} inputmode="numeric" />
            <button type="submit">Go</button>
          </form>
          <span class="catalog-tools-divider" aria-hidden="true">|</span>
          <p class="catalog-tools-count" data-catalog-count>{imageCount} works</p>
        </section>

        <!-- Image Grid -->
        <div class="ssr-grid" id="collection-grid">
          {filteredGalleryData.map((item: any, idx: number) => {
        // Use smallest sufficient size for 250px grid cards via proxy
        const imageUrl = getProxySrc(item.id, 's');
        const srcsetParts = [
          `${getProxySrc(item.id, 's')} 400w`,
          `${getProxySrc(item.id, 'm')} 600w`
        ].join(", ");
        const linkUrl = `${contentBasePath}/${item.id}`;
        const collectorNotesHref = `${linkUrl}#collector-notes`;
        const title = cleanForDisplay(item.title);
        
        // âœ… Auto alt text: prioritize existing alt, then build from description/keywords
        let altText: string;
        if (item.alt) {
          altText = cleanForDisplay(item.alt);
        } else if (item.description) {
          // Use first sentence of description (truncated)
          const firstSentence = item.description.split(/[.!?]/)[0];
          altText = cleanForDisplay(firstSentence.slice(0, 150));
        } else if (item.keywords?.length > 0) {
          // Build from keywords: "Western portrait: keyword1, keyword2, keyword3"
          const topKeywords = item.keywords.slice(0, 4).join(", ");
          altText = `Western fine art photograph: ${topKeywords}`;
        } else {
          altText = `Western cowboy fine art photograph: ${title} by Wayne Heim`;
        }

        const normalizedAltKey = altText.toLowerCase();
        const previousAltCount = seenCardAltCounts.get(normalizedAltKey) || 0;
        if (previousAltCount > 0) {
          altText = `${altText.replace(/[.\s]*$/, "")} (${title} - artwork ${idx + 1}).`;
        }
        seenCardAltCounts.set(normalizedAltKey, previousAltCount + 1);
        
        const storyExcerpt = truncateStoryExcerpt(item.story || "", 100);
        const collectorNoteRaw = item.description || "";
        const collectorNoteTeaser = truncateBookendExcerpt(collectorNoteRaw, 100, 300);
        const cardSeries = getCardSeries(item);
        const cardSeriesKeys = cardSeries.map((series: any) => series.key).join(' ');
        const needsRangeMarker = idx > 0 && idx % 50 === 0;
        const rangeStart = idx + 1;
        const rangeEnd = Math.min(idx + 50, imageCount);

        return (
          <>
            {needsRangeMarker && (
              <div class="catalog-range-marker">
                <span>Artworks {rangeStart}&ndash;{rangeEnd} of {imageCount}</span>
                <a href="#top">Back to top</a>
              </div>
            )}
            <div
              class="ssr-card"
              id={item.id}
              data-artwork-number={idx + 1}
              data-original-index={idx}
              data-series={cardSeriesKeys}
            >
              <a
                href={linkUrl}
                class="ssr-card-link"
                data-doorway-image-link
                data-image-id={item.id}
                data-gallery-id={contentBasePath}
                data-artwork-number={idx + 1}
              >
                <img 
                  class="ssr-card-image"
                  src={imageUrl} 
                  srcset={srcsetParts || undefined}
                  sizes="(max-width: 520px) calc(100vw - 32px), (max-width: 768px) calc((100vw - 48px) / 2), 250px"
                  alt={altText} 
                  loading="lazy" 
                  decoding="async"
                  fetchpriority="low"
                />
                <div class="ssr-card-content">
                  <div class="card-meta-row">
                    <span class="card-number">Image {idx + 1} of {imageCount}</span>
                    {cardSeries.length > 0 && (
                      <span class="card-series-strip" aria-label="Available print series">
                        {cardSeries.map((series: any, seriesIdx: number) => (
                          <>
                            <span
                              class="card-series-icon"
                              title={`${series.label} Series Member`}
                              aria-label={`${series.label} Series Member`}
                            >
                              {series.icon}
                            </span>
                            {seriesIdx < cardSeries.length - 1 && <span class="card-series-separator" aria-hidden="true">|</span>}
                          </>
                        ))}
                      </span>
                    )}
                  </div>
                  <h3>{title}</h3>
                  <p class="print-cue sr-only">Fine art print available</p>
                  {storyExcerpt && <p class="story-excerpt">{storyExcerpt}</p>}
                  <span class="card-cta">
                    <span class="card-cta-desktop">Explore Story | Order Fine Art Print &rarr;</span>
                    <span class="card-cta-mobile">Explore Story | Order</span>
                  </span>
                </div>
              </a>
              <button
                type="button"
                class="collector-notes-trigger"
                data-notes-trigger
                aria-label="View image description preview"
              >
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 18v-6a5 5 0 0 1 10 0v6" />
                  <path d="M5 21v-1a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1" />
                  <path d="M12 14v4" />
                  <path d="M12 2v2" />
                  <path d="M4.93 4.93 6.34 6.34" />
                  <path d="M19.07 4.93 17.66 6.34" />
                  <path d="M2 12h2" />
                  <path d="M20 12h2" />
                </svg>
              </button>
              <div class="collector-note-overlay" data-notes-overlay>
                <p class="collector-note-kicker">Image Description</p>
                <p class="collector-note-teaser">{collectorNoteTeaser || "Image description preview available for this artwork."}</p>
                <a class="collector-note-link" href={collectorNotesHref}>View full image and details &rarr;</a>
              </div>
            </div>
          </>
        );
          })}
        </div>
      </>
    )}

    {normalizedGridSections.length > 0 && (
      <div class="catalog-section-stack" id="collection-grid">
        {(gridIntroTitle || gridIntroCopy) && (
          <section class="catalog-grid-intro" aria-labelledby="catalog-grid-intro-heading">
            {gridIntroTitle && <h2 id="catalog-grid-intro-heading">{gridIntroTitle}</h2>}
            {gridIntroCopy && <p>{gridIntroCopy}</p>}
          </section>
        )}
        {normalizedGridSections.map((section, sectionIndex) => {
          const visibleItems = section.items.slice(0, section.limit);
          const sectionCount = section.items.length;
          const conceptBlock = isCinematicConceptLayout ? conceptBlocks[sectionIndex] : null;
          const sectionKicker = formatCopy(catalogSectionKickerTemplate)
            .replaceAll("{sectionCount}", String(sectionCount))
            .replaceAll("{sectionTitle}", section.title);
          const sectionCtaAlt = `${section.ctaLabel || `See all ${section.title}`} thumbnail`;

          return (
            <>
              {conceptBlock && (conceptBlock.title || conceptBlock.paragraphs.length > 0) && (
                <section class="cinematic-concept-block" aria-labelledby={`cinematic-concept-${sectionIndex + 1}`}>
                  {conceptBlock.title && <p id={`cinematic-concept-${sectionIndex + 1}`} class="cinematic-concept-block__kicker">{conceptBlock.title}</p>}
                  {conceptBlock.paragraphs.map((paragraph) => (
                    <p set:html={paragraph}></p>
                  ))}
                </section>
              )}

              <section class="catalog-gallery-section" id={`section-${section.slug}`} aria-labelledby={`catalog-section-heading-${sectionIndex + 1}`}>
                <div class="catalog-section-heading">
                  {section.timeZone && <p class="catalog-section-timezone">{section.timeZone}</p>}
                  <p class="catalog-section-kicker">{sectionKicker}</p>
                  <h2 id={`catalog-section-heading-${sectionIndex + 1}`}>{section.title}</h2>
                  {section.description && <p>{section.description}</p>}
                </div>

                <div class="ssr-grid ssr-grid--catalog-section">
                  {visibleItems.map((item: any, idx: number) => {
                  const imageUrl = getSectionProxySrc(item, section.galleryPath, 's');
                  const srcsetParts = [
                    `${getSectionProxySrc(item, section.galleryPath, 's')} 400w`,
                    `${getSectionProxySrc(item, section.galleryPath, 'm')} 600w`
                  ].join(", ");
                  const linkUrl = `${section.galleryPath}/${item.id}`;
                  const collectorNotesHref = `${linkUrl}#collector-notes`;
                  const title = cleanForDisplay(item.title);

                  let altText: string;
                  if (item.alt) {
                    altText = cleanForDisplay(item.alt);
                  } else if (item.description) {
                    const firstSentence = item.description.split(/[.!?]/)[0];
                    altText = cleanForDisplay(firstSentence.slice(0, 150));
                  } else if (item.keywords?.length > 0) {
                    const topKeywords = item.keywords.slice(0, 4).join(", ");
                    altText = `Western wall art photograph: ${topKeywords}`;
                  } else {
                    altText = `Western wall art print: ${title} by Wayne Heim`;
                  }

                  const storyExcerpt = truncateStoryExcerpt(item.story || "", 100);
                  const collectorNoteRaw = item.description || "";
                  const collectorNoteTeaser = truncateBookendExcerpt(collectorNoteRaw, 100, 300);
                  const cardSeries = getCardSeries(item, section.galleryPath);
                  const cardSeriesKeys = cardSeries.map((series: any) => series.key).join(' ');

                  return (
                    <div
                      class="ssr-card"
                      id={`${sectionIndex + 1}-${item.id}`}
                      data-artwork-number={idx + 1}
                      data-original-index={idx}
                      data-series={cardSeriesKeys}
                    >
                      <a
                        href={linkUrl}
                        class="ssr-card-link"
                        data-doorway-image-link
                        data-image-id={item.id}
                        data-gallery-id={section.galleryPath}
                        data-artwork-number={idx + 1}
                      >
                        <img
                          class="ssr-card-image"
                          src={imageUrl}
                          srcset={srcsetParts || undefined}
                          sizes="(max-width: 520px) calc(100vw - 32px), (max-width: 768px) calc((100vw - 48px) / 2), 250px"
                          alt={altText}
                          loading="lazy"
                          decoding="async"
                          fetchpriority="low"
                        />
                        <div class="ssr-card-content">
                          <div class="card-meta-row">
                            <span class="card-number">Image {idx + 1} of {sectionCount}</span>
                            {cardSeries.length > 0 && (
                              <span class="card-series-strip" aria-label="Available print series">
                                {cardSeries.map((series: any, seriesIdx: number) => (
                                  <>
                                    <span
                                      class="card-series-icon"
                                      title={`${series.label} Series Member`}
                                      aria-label={`${series.label} Series Member`}
                                    >
                                      {series.icon}
                                    </span>
                                    {seriesIdx < cardSeries.length - 1 && <span class="card-series-separator" aria-hidden="true">|</span>}
                                  </>
                                ))}
                              </span>
                            )}
                          </div>
                          <h3>{title}</h3>
                          <p class="print-cue sr-only">Fine art print available</p>
                          {storyExcerpt && <p class="story-excerpt">{storyExcerpt}</p>}
                          <span class="card-cta">
                            <span class="card-cta-desktop">Explore Story | Order Fine Art Print &rarr;</span>
                            <span class="card-cta-mobile">Explore Story | Order</span>
                          </span>
                        </div>
                      </a>
                      <button
                        type="button"
                        class="collector-notes-trigger"
                        data-notes-trigger
                        aria-label="View image description preview"
                      >
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M7 18v-6a5 5 0 0 1 10 0v6" />
                          <path d="M5 21v-1a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1" />
                          <path d="M12 14v4" />
                          <path d="M12 2v2" />
                          <path d="M4.93 4.93 6.34 6.34" />
                          <path d="M19.07 4.93 17.66 6.34" />
                          <path d="M2 12h2" />
                          <path d="M20 12h2" />
                        </svg>
                      </button>
                      <div class="collector-note-overlay" data-notes-overlay>
                        <p class="collector-note-kicker">Image Description</p>
                        <p class="collector-note-teaser">{collectorNoteTeaser || "Image description preview available for this artwork."}</p>
                        <a class="collector-note-link" href={collectorNotesHref}>View full image and details &rarr;</a>
                      </div>
                    </div>
                  );
                })}

                {section.alternateCtaHref ? (
                  <div class="ssr-card catalog-collection-cta catalog-collection-cta--split">
                    <a class="catalog-collection-cta__inner catalog-collection-cta__primary" href={section.allHref}>
                        {section.ctaThumb && (
                          <span class="catalog-collection-cta__tombstone" aria-hidden="true">
                            <img src={forceImageSize(section.ctaThumb, 's', section.galleryPath)} alt={sectionCtaAlt} loading="lazy" decoding="async" />
                          </span>
                        )}
                        <span class="catalog-collection-cta__kicker">Full Collection</span>
                        <strong>{section.ctaLabel || `See all ${section.title}`}</strong>
                        <small>{sectionCount} works in this gallery</small>
                    </a>
                    <a class="catalog-collection-cta__alternate" href={section.alternateCtaHref}>
                      <span>{section.alternateCtaKicker || "Alternative View"}</span>
                      <strong>{section.alternateCtaLabel || "See the black and white collection"}</strong>
                      {section.alternateCtaCount && <small>{section.alternateCtaCount}</small>}
                    </a>
                  </div>
                ) : (
                  <a class="ssr-card catalog-collection-cta" href={section.allHref}>
                    <span class="catalog-collection-cta__inner">
                      {section.ctaThumb && (
                        <span class="catalog-collection-cta__tombstone" aria-hidden="true">
                          <img src={forceImageSize(section.ctaThumb, 's', section.galleryPath)} alt={sectionCtaAlt} loading="lazy" decoding="async" />
                        </span>
                      )}
                      <span class="catalog-collection-cta__kicker">Full Collection</span>
                      <strong>{section.ctaLabel || `See all ${section.title}`}</strong>
                      <small>{sectionCount} works in this gallery</small>
                    </span>
                  </a>
                )}
                </div>
              </section>
            </>
          );
        })}
        {isCinematicConceptLayout && conceptBlocks.slice(normalizedGridSections.length).map((block, extraIndex) => (
          (block.title || block.paragraphs.length > 0) && (
            <section class="cinematic-concept-block cinematic-concept-block--bridge" aria-labelledby={`cinematic-concept-extra-${extraIndex + 1}`}>
              {block.title && <p id={`cinematic-concept-extra-${extraIndex + 1}`} class="cinematic-concept-block__kicker">{block.title}</p>}
              {block.paragraphs.map((paragraph) => (
                <p set:html={paragraph}></p>
              ))}
            </section>
          )
        ))}
      </div>
    )}

    {isCinematicConceptLayout && (collectingTitle || collectingParagraphs.length > 0) && (
      <section class="cinematic-collecting-section" aria-labelledby="cinematic-collecting-heading">
        {collectingKicker && <p class="cinematic-collecting-section__kicker">{collectingKicker}</p>}
        {collectingTitle && <h2 id="cinematic-collecting-heading">{collectingTitle}</h2>}
        {collectingParagraphs.map((paragraph) => (
          <p set:html={paragraph}></p>
        ))}
      </section>
    )}

    {showSeriesAfterCatalog && (
      <>
        <p class="print-options-heading">K4 Series and Limited Editions &middot; Fine Art Prints from {getFormattedLowestStandardPrintPrice()}</p>

