---
import {
  relatedCollectionsBySlug,
  type RelatedCollectionEntry,
} from "@/data/doorway/relatedCollections";

type Props = {
  slug?: string;
  title?: string;
};

const { slug = "", title = "Related Collections" } = Astro.props as Props;
const entry = relatedCollectionsBySlug[slug] as RelatedCollectionEntry | undefined;
const shouldRender = Boolean(entry && !entry.locked && entry.siblings.length > 0);

const labelForSlug = (value: string) =>
  value
    .replace(/^\//, "")
    .replace(/-/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase())
    .replace(/\bAnd\b/g, "and")
    .replace(/\bOf\b/g, "of")
    .replace(/\bThe\b/g, "the")
    .replace(/\bFor\b/g, "for")
    .replace(/\bArt\b/g, "Art")
    .replace(/\bWwii\b/g, "WWII");
---

{shouldRender && (
  <section class="related-collections" aria-labelledby="related-collections-heading">
    <div class="related-collections__inner">
      <p class="related-collections__kicker">Continue Through the Work</p>
      <h2 id="related-collections-heading">{title}</h2>
      <div class="related-collections__links" aria-label="Related collection pages">
        {entry.siblings.map((href) => (
          <a href={href}>{labelForSlug(href)}</a>
        ))}
      </div>
      <a class="related-collections__pillar" href={entry.pillar}>
        The argument behind the work
      </a>
    </div>
  </section>
)}

<style>
  .related-collections {
    width: min(1020px, calc(100% - 80px));
    margin: 54px auto 28px;
    padding: 24px 0 0;
    border-top: 1px solid #dccfbe;
    color: #2a1f17;
    font-family: "Glegoo", serif;
  }

  .related-collections__inner {
    display: grid;
    gap: 16px;
  }

  .related-collections__kicker {
    margin: 0;
    color: #7a6b5e;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .related-collections h2 {
    margin: 0;
    color: #2f241c;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.25;
    letter-spacing: 0;
  }

  .related-collections__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .related-collections a {
    color: #6f4d35;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .related-collections a:hover,
  .related-collections a:focus-visible {
    color: #3f2b1d;
    text-decoration: underline;
  }

  .related-collections__links a {
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .related-collections__pillar {
    justify-self: start;
    font-size: 0.9rem;
    font-style: italic;
  }

  @media (max-width: 720px) {
    .related-collections {
      width: calc(100% - 32px);
      margin-top: 38px;
    }

    .related-collections__links {
      display: grid;
      gap: 9px;
    }
  }
</style>
