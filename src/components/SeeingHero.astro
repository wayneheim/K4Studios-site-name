---
import NarrativeAudioButton from "@/components/NarrativeAudioButton.jsx";

const { titleLines, imageSrc, imageLink, imageAlt = "Seeing", essayNumber, tightTracking = false, audioSrc = "", audioVolume = 0.3 } = Astro.props;
---

<section class="seeing-hero-wrap">
  <div class="seeing-hero-grid">
    <div class="seeing-hero-number">
      #{essayNumber}
    </div>

    <div class="seeing-hero-text">
      <h1 class="seeing-hero-title" style={tightTracking ? "letter-spacing: -0.01em;" : ""}>
        {titleLines.map(line => (
          <>
            {line}<br />
          </>
        ))}
      </h1>
    </div>

    <div class="seeing-hero-media">
      <div class="seeing-hero-image">
        {imageLink ? (
          <a href={imageLink} target="_blank" rel="noopener noreferrer">
            <img src={imageSrc} alt={imageAlt} />
          </a>
        ) : (
          <img src={imageSrc} alt={imageAlt} />
        )}
      </div>
      {audioSrc && (
        <NarrativeAudioButton client:load src={audioSrc} title={imageAlt} volume={audioVolume} />
      )}
    </div>
  </div>
</section>

<style>
  .seeing-hero-wrap {
    max-width: 760px;
    margin: 2.5rem auto 3rem;
    padding: 0 1.5rem;
  }

  .seeing-hero-grid {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 2rem;
  }

  .seeing-hero-number {
    font-family: 'Glegoo', serif;
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    font-weight: 700;
    color: #3b342e;
    opacity: 0.25;
    line-height: 1;
    letter-spacing: -0.02em;
    align-self: start;
    margin-top: 0.45em;
  }

  .seeing-hero-title {
    font-family: 'Glegoo', serif;
    font-style: italic;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.05em;
    font-size: clamp(1.6rem, 2.8vw, 2rem);
    margin: 0;
    text-align: center;
    color: #3b342e;
    opacity: 0.7;
  }

  .seeing-hero-media {
    position: relative;
    flex-shrink: 0;
  }

  .seeing-hero-image {
    width: 160px;
    height: 160px;
    border-radius: 9999px;
    overflow: hidden;
  }

  .seeing-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    display: block;
  }

  :global(.narrative-audio-button) {
    position: absolute;
    right: -0.65rem;
    bottom: 0.35rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(95, 66, 48, 0.45);
    background: rgba(255, 255, 255, 0.94);
    color: #8b4513;
    box-shadow: 0 0.3rem 0.9rem rgba(42, 31, 23, 0.22);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  :global(.narrative-audio-button:hover),
  :global(.narrative-audio-button.is-playing) {
    background: #f7efe7;
    border-color: rgba(139, 69, 19, 0.75);
    color: #6f3210;
    transform: translateY(-1px);
  }

  :global(.narrative-audio-button svg) {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 2.4;
  }

  @media (max-width: 768px) {
    .seeing-hero-grid {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
      justify-items: center;
    }

    .seeing-hero-number {
      font-size: 2.5rem;
    }

    .seeing-hero-title {
      text-align: center;
    }

    :global(.narrative-audio-button) {
      right: 0.1rem;
      bottom: 0.1rem;
    }
  }
</style>
