---
const { titleLines, imageSrc, imageLink, imageAlt = "Seeing", essayNumber, tightTracking = false } = Astro.props;
---

<section class="seeing-hero-wrap">
  <div class="seeing-hero-grid">
    <div class="seeing-hero-number">
      #{essayNumber}
    </div>

    <div class="seeing-hero-text">
      <h1 class="seeing-hero-title" style={tightTracking ? "letter-spacing: -0.01em;" : ""}>
        {titleLines.map(line => (
          <>
            {line}<br />
          </>
        ))}
      </h1>
    </div>

    <div class="seeing-hero-image">
      {imageLink ? (
        <a href={imageLink} target="_blank" rel="noopener noreferrer">
          <img src={imageSrc} alt={imageAlt} />
        </a>
      ) : (
        <img src={imageSrc} alt={imageAlt} />
      )}
    </div>
  </div>
</section>

<style>
  .seeing-hero-wrap {
    max-width: 760px;
    margin: 2.5rem auto 3rem;
    padding: 0 1.5rem;
  }

  .seeing-hero-grid {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 2rem;
  }

  .seeing-hero-number {
    font-family: 'Glegoo', serif;
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    font-weight: 700;
    color: #3b342e;
    opacity: 0.25;
    line-height: 1;
    letter-spacing: -0.02em;
    align-self: start;
    margin-top: 0.45em;
  }

  .seeing-hero-title {
    font-family: 'Glegoo', serif;
    font-style: italic;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.05em;
    font-size: clamp(1.6rem, 2.8vw, 2rem);
    margin: 0;
    text-align: center;
    color: #3b342e;
    opacity: 0.7;
  }

  .seeing-hero-image {
    width: 160px;
    height: 160px;
    border-radius: 9999px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .seeing-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    display: block;
  }

  @media (max-width: 768px) {
    .seeing-hero-grid {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
      justify-items: center;
    }

    .seeing-hero-number {
      font-size: 2.5rem;
    }

    .seeing-hero-title {
      text-align: center;
    }
  }
</style>
