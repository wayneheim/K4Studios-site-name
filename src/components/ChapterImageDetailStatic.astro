---
import { getCollectionContextEntry, buildCollectionContextStatement } from "@/data/semantic/collectionContext";
import { getSemanticImageUrl } from "@/utils/imageProxy.js";

interface Props {
  image: any;
  galleryPath: string;
  galleryTitle: string;
  index: number;
  count: number;
  images?: any[];
  prevImage?: any;
  nextImage?: any;
}

const {
  image,
  galleryPath,
  galleryTitle,
  index,
  count,
  images = [],
  prevImage = null,
  nextImage = null,
} = Astro.props;

function cleanText(value = "") {
  return String(value || "").replace(/\s+/g, " ").trim();
}

function buildCaptionExcerpt(description = "", minChars = 150, maxChars = 280) {
  const text = cleanText(description);
  if (!text) return "";
  if (text.length <= maxChars) return text;

  const boundedText = text.slice(0, maxChars + 1);
  const sentenceBoundaryMatches = [...boundedText.matchAll(/[.!?](?=\s|$)/g)];
  const preferredBoundary = sentenceBoundaryMatches
    .map((match) => match.index)
    .filter((idx) => typeof idx === "number" && idx >= minChars)
    .pop();

  let cutIndex = typeof preferredBoundary === "number" ? preferredBoundary + 1 : -1;
  if (cutIndex === -1) {
    const safeSlice = boundedText.slice(0, maxChars);
    const lastSpace = safeSlice.lastIndexOf(" ");
    cutIndex = lastSpace > minChars ? lastSpace : maxChars;
  }

  return `${text.slice(0, cutIndex).trim()}...`;
}

const imageUrl = getSemanticImageUrl(image, { galleryPath });
const zoomImageUrl = getSemanticImageUrl(image, { galleryPath }, "xl");
const alt = image?.alt || image?.title || "K4 Studios fine art photograph";
const title = image?.title || alt;
const story = image?.story || "";
const description = image?.description || "";
const notes = image?.notes || "";
const caption = buildCaptionExcerpt(description);
const prevHref = prevImage ? `${galleryPath}/${prevImage.id}` : "";
const nextHref = nextImage ? `${galleryPath}/${nextImage.id}` : "";
const jumpTargets = (images.length ? images : [image])
  .map((entry) => entry?.id)
  .filter(Boolean);
const collectionContextEntry = getCollectionContextEntry(galleryPath);
const collectionContextStatement = collectionContextEntry
  ? buildCollectionContextStatement(collectionContextEntry)
  : "";

const chevronLeftSvg = `<svg aria-hidden="true" viewBox="0 0 24 24" class="w-5 h-5 text-gray-300 transition-colors" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="m14 8-4 4 4 4"></path></svg>`;
const chevronRightSvg = `<svg aria-hidden="true" viewBox="0 0 24 24" class="w-5 h-5 text-gray-300 transition-colors" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="m10 8 4 4-4 4"></path></svg>`;
const gridSvg = `<svg aria-hidden="true" viewBox="0 0 24 24" class="w-5 h-5 text-gray-400 transition-colors" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg>`;
const menuSvg = `<svg aria-hidden="true" viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path></svg>`;
const circleXSvg = `<svg aria-hidden="true" viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>`;
const notebookSvg = `<svg aria-hidden="true" viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="#9bb69e" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h4"></path><path d="M2 10h4"></path><path d="M2 14h4"></path><path d="M2 18h4"></path><rect width="16" height="20" x="4" y="2" rx="2"></rect><path d="M16 2v20"></path></svg>`;
const likeSvg = `<svg aria-hidden="true" viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="#a8b0bb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v11"></path><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"></path></svg>`;
const arrowRightSvg = `<svg aria-hidden="true" viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>`;
---

<div
  class="min-h- bg-white text-black font-serif px-5 py-2 md:py-8 overflow-x-hidden"
  style="font-family:Glegoo, serif;max-width:100%;width:100%;box-sizing:border-box"
>
  <div class="relative max-w-6xl mx-auto">
    <div
      class="flex flex-col md:flex-row gap-6 md:gap-6 items-center justify-center md:min-h-[75vh]"
      data-image-id={image.id}
      style="touch-action:pan-y pinch-zoom;opacity:1;transform:none"
    >
      <div class="flex flex-col items-center relative chapter-image-container-mobile" style="width:fit-content;min-width:0">
        <figure style="margin:0">
          <div class="w-full relative flex items-center justify-center mb-0 chapter-image-container-mobile">
            <div class="relative flex flex-row justify-center chapter-image-container-mobile" style="max-width:575px;width:fit-content">
              <div class="relative flex justify-center items-center chapter-image-container-mobile" style="width:fit-content;max-width:100%;margin:0 auto">
                <img
                  src={imageUrl}
                  data-static-zoom-trigger
                  data-zoom-src={zoomImageUrl}
                  alt={alt}
                  itemprop="image contentUrl"
                  class="chapter-image-mobile rounded-lg block"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  draggable="false"
                  style="cursor:zoom-in;max-width:100%;width:auto;height:auto;max-height:70vh;transition:box-shadow .3s ease;border:1px solid rgba(110,110,110,0.28);box-shadow:0 2px 5px rgba(0,0,0,0.10)"
                />
                {notes && (
                  <button
                    type="button"
                    data-static-notes-btn
                    class="hidden md:flex absolute top-2 right-3 w-8 h-9 border border-gray-300 bg-white text-gray-400 rounded-md shadow hover:bg-gray-200 transition z-30 items-center justify-center"
                    style="box-shadow:0 2px 6px rgba(80,60,30,0.10);transform:translateX(50px)"
                    aria-label="View Collector Notes"
                    title="View Collector Notes"
                  >
                    <span class="absolute left-2 top-[2px] text-[12px] text-red-600 font-semibold">*</span>
                    <span set:html={notebookSvg} />
                  </button>
                )}
              </div>
            </div>
          </div>
          {caption && (
            <figcaption class="mx-auto mt-2 mb-2 px-3" style="max-width:500px" itemprop="caption">
              <p class="image-caption" style="text-align:center;font-style:italic;margin-top:0.25rem;margin-bottom:0;font-size:0.74rem;line-height:1.35;color:#9ca3af;opacity:1;min-height:2.7em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                "{caption}"
              </p>
            </figcaption>
          )}
        </figure>

        <div class="flex items-center justify-center gap-2 mb-1 mt-4">
          <div class="flex items-center gap-1 md:gap-6 mx-auto rounded-xl shadow-sm px-3 py-1 select-none bg-white max-w-[1300px]" style="max-width:1300px;min-width:0;justify-content:space-evenly;border:1px solid #e5e7eb">
            <a href={galleryPath} class="flex items-center justify-center w-7 h-7 text-gray-500 text-lg transition-colors duration-150 hover:text-gray-700 border border-gray-200 hover:bg-gray-100 bg-white rounded-full shadow-sm hover:border-red-200 hover:border-gray-300 focus:border-gray-300" aria-label="Show gallery menu" title="Show Gallery" data-menu-btn set:html={menuSvg} />
            <div class="text-sm text-gray-400 font-medium flex items-center whitespace-nowrap" style="letter-spacing:-0.085em" data-count>{index + 1} - {count}</div>
            <form class="flex items-center gap-1 text-xs" style="min-width:50px" data-static-jump-form data-jump-targets={JSON.stringify(jumpTargets)} data-gallery-path={galleryPath}>
              <input
                type="number"
                name="chapterNum"
                min="1"
                max={count}
                step="1"
                inputmode="numeric"
                placeholder="#"
                class="w-20 border border-gray-200 rounded px-1 py-1 text-center"
                style="font-size:1em"
              />
              <button type="submit" class="bg-gray-100 px-1 py-1 text-gray-400 border border-gray-300 rounded shadow hover:border-red-200 hover:text-gray-500 hover:bg-gray-100 text-xs" aria-label="Jump to image number" title="Jump to image">
                <span set:html={arrowRightSvg} />
              </button>
            </form>
            <a href={`${galleryPath}?view=grid`} aria-label="View Grid Mode" title="View Grid Mode" class="md:hidden flex items-center justify-center gap-1 transition-colors" style="color:#84766d;opacity:0.65" data-grid-btn>
              <span set:html={gridSvg} />
              <span class="text-xs" style="color:#84766d;opacity:0.5">- All</span>
            </a>
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-gray-300 bg-white shadow hover:bg-gray-100 transition-colors hover:border-red-200" aria-label="Like this image" title="Like this image" data-like-btn set:html={likeSvg} />
            <a href={image?.buyLink || "/Other/Print-Options"} class="inline-flex items-center justify-center h-8 rounded-full text-[11px] font-semibold tracking-tight leading-none shadow transition border border-gray-300 hover:border-red-200 px-2.5 min-w-[68px]" style="background-color:#bbb6b1;color:#fff" title="Click to see pricing and editions" data-cart-btn>Pricing</a>
            <a href={galleryPath} class="inline-flex items-center justify-center w-8 h-8 border border-gray-300 bg-white text-gray-300 rounded-full shadow-sm hover:bg-gray-700 hover:text-gray-200 hover:border-red-200 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-gray-400 transition-colors cursor-pointer" aria-label="Exit Chapter View" title="Exit Viewer" data-exit-btn set:html={circleXSvg} />
          </div>
        </div>
        <a href={`${galleryPath}?view=grid`} class="group my-3 inline-flex items-center gap-2 rounded-full px-3 py-1 border border-gray-200 hover:border-red-300 shadow-sm transition-colors" style="letter-spacing:.02em;background-color:rgba(240,238,233,.85)" aria-label="Play K4 Slideshow" title="Play K4 Story Show" data-slideshow-btn>
          <span class="inline-flex items-center justify-center w-4 h-4 text-gray-400 group-hover:text-red-700 transition-colors">▶</span>
          <span class="text-sm font-medium text-gray-400 group-hover:text-gray-500 transition-colors">Play Show</span>
        </a>
      </div>

      <div class="w-full md:pl-8" style="flex:1 1 27rem;max-width:28rem;min-width:0">
        <nav class="mb-4 flex justify-center relative z-0 hidden md:flex" aria-label="Gallery navigation">
          <a href={galleryPath.replace(/\/Color$/, "")} rel="up" title={galleryTitle} class="relative block group">
            <img src="/images/K4Logo-web.webp" alt={galleryTitle} width="96" height="96" class="h-16.5 mb-5 transition-opacity duration-300 group-hover:opacity-0 group-hover:pointer-events-none" style="border-radius:999px;width:96px;height:96px;max-width:96px;object-fit:cover;opacity:.20" />
            <span class="absolute inset-0 flex items-center justify-center text-center text-[#7a6a58] font-semibold opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none bg-white rounded-full" style="border-radius:999px;width:96px;height:96px;margin:0 auto">{galleryTitle}</span>
            <span class="sr-only">{galleryTitle}</span>
          </a>
        </nav>

        <div class="text-center" style="font-family:'Glegoo', serif;margin-bottom:0.5rem">
          <p class="font-semibold tracking-wide text-[#85644b]" style="font-size:1.55rem;opacity:0.5;line-height:1.35;margin-bottom:0.25rem">Chapter {index + 1}:</p>
          <h1 class="font-semibold tracking-wide text-[#85644b] chapter-title" itemprop="name" style="font-size:1.55rem;opacity:0.5;line-height:1.35;margin-top:0;margin-bottom:0">{title}</h1>
        </div>

        {story && (
          <section class="image-story" aria-labelledby={`image-story-heading-${image.id}`}>
            <h2 id={`image-story-heading-${image.id}`} class="sr-only">Story</h2>
            <p class="italic text-base mt-3 md:text-lg mb-4 leading-snug text-left">{story}</p>
          </section>
        )}

        {(description || notes || collectionContextStatement) && (
          <details class="more-about-image" style="margin:0">
            <summary style="display:block;list-style:none;cursor:pointer;font-size:0.85rem;color:#7a6a58;font-family:'Glegoo', serif;padding:0.5rem 0;text-align:center">
              <span class="plus-minus-icon" style="display:inline-block;font-size:0.9em;margin-right:0.4em;font-weight:bold"></span>
              More about this image
            </summary>
            <div class="details-content" style="font-size:0.9rem;line-height:1.7;padding-top:0.5rem;border-top:1px dashed rgba(200, 190, 180, 0.4);text-align:left">
              {description && (
                <section class="image-description" aria-labelledby={`image-description-heading-${image.id}`}>
                  <h2 id={`image-description-heading-${image.id}`} class="sr-only">About this image</h2>
                  <p itemprop="description" style="margin:0 0 1rem">{description}</p>
                </section>
              )}
              {collectionContextStatement && (
                <aside class="collection-context-note" aria-labelledby={`series-context-heading-${image.id}`} style="margin:0 0 1rem;color:#7a6a58;font-size:0.86rem;line-height:1.65">
                  <h3 id={`series-context-heading-${image.id}`} class="sr-only">Part of the {galleryTitle} series</h3>
                  {collectionContextStatement}
                </aside>
              )}
              {notes && (
                <section id={`canonical-notes-${image.id}`} class="notes-section" data-notes-canonical="true" aria-labelledby={`collector-notes-heading-${image.id}`} style="margin-top:1rem;padding-top:0.75rem;border-top:1px dashed rgba(200, 190, 180, 0.4)">
                  <h3 id={`collector-notes-heading-${image.id}`} class="notes-label" style="font-size:0.85rem;font-weight:500;color:#928176;margin:0 0 0.5rem;letter-spacing:0.04em">Collector Notes:</h3>
                  <p style="font-style:italic;color:#9a9a99;margin:0;mix-blend-mode:multiply">{notes}</p>
                </section>
              )}
            </div>
          </details>
        )}

        <div class="hidden md:flex justify-center items-center gap-6 pt-6 clear-both" data-image-id={image.id}>
          {prevHref ? (
            <a href={prevHref} class="bg-white p-1 rounded shadow flex items-center justify-center border border-gray-200 hover:border-gray-300 transition-colors" title="Back" aria-label="Previous Chapter" data-prev-btn="true">
              <span set:html={chevronLeftSvg} />
              <span class="sr-only">Previous</span>
            </a>
          ) : (
            <span class="bg-white p-1 rounded shadow flex items-center justify-center border border-gray-200 transition-colors" style="opacity:0.45" aria-hidden="true" data-prev-btn="true">
              <span set:html={chevronLeftSvg} />
            </span>
          )}
          <a href={`${galleryPath}?view=grid`} class="bg-gray-100 w-11 h-11 rounded-full shadow flex items-center justify-center border border-gray-200 hover:border-gray-300 transition-colors" title="Index View" aria-label="Grid View" data-grid-btn="true">
            <span set:html={gridSvg} />
            <span class="sr-only">Grid View</span>
          </a>
          {nextHref ? (
            <a href={nextHref} class="bg-white p-1 rounded shadow flex items-center justify-center border border-gray-200 hover:border-gray-300 transition-colors" title="Next" aria-label="Next Chapter" data-next-btn="true">
              <span set:html={chevronRightSvg} />
              <span class="sr-only">Next</span>
            </a>
          ) : (
            <span class="bg-white p-1 rounded shadow flex items-center justify-center border border-gray-200 transition-colors" style="opacity:0.45" aria-hidden="true" data-next-btn="true">
              <span set:html={chevronRightSvg} />
            </span>
          )}
        </div>
      </div>
    </div>
  </div>
  <div class="static-zoom-overlay" data-static-zoom-overlay aria-hidden="true">
    <button type="button" class="static-zoom-close" data-static-zoom-close aria-label="Close expanded image" set:html={circleXSvg} />
    <img data-static-zoom-image src="" alt={alt} loading="lazy" decoding="async" />
  </div>
</div>

<style>
  .chapter-image-mobile:hover {
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85), 0 4px 15px 4px rgba(134, 134, 134, 0.85) !important;
  }

  .static-zoom-overlay {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(255,255,255,.96);
    z-index: 99999;
    cursor: zoom-out;
  }

  .static-zoom-overlay.is-open {
    display: flex;
  }

  .static-zoom-overlay img {
    max-width: min(96vw, 1600px);
    max-height: 92vh;
    width: auto;
    height: auto;
    border-radius: .5rem;
    box-shadow: 0 16px 48px rgba(0,0,0,.24);
  }

  .static-zoom-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid #d1d5db;
    background: #fff;
    color: #9ca3af;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,.12);
    cursor: pointer;
  }

  body.static-zoom-open {
    overflow: hidden;
  }
</style>

<script is:inline>
  (() => {
    const zoomTrigger = document.querySelector("[data-static-zoom-trigger]");
    const overlay = document.querySelector("[data-static-zoom-overlay]");
    const zoomImage = document.querySelector("[data-static-zoom-image]");
    const closeButton = document.querySelector("[data-static-zoom-close]");

    const closeZoom = () => {
      if (!overlay) return;
      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.classList.remove("static-zoom-open");
    };

    if (zoomTrigger && overlay && zoomImage && closeButton) {
      zoomTrigger.addEventListener("click", () => {
        if (window.matchMedia("(max-width: 767px)").matches) return;
        zoomImage.src = zoomTrigger.getAttribute("data-zoom-src") || zoomTrigger.currentSrc || zoomTrigger.src;
        overlay.classList.add("is-open");
        overlay.setAttribute("aria-hidden", "false");
        document.body.classList.add("static-zoom-open");
      });
      closeButton.addEventListener("click", closeZoom);
      overlay.addEventListener("click", (event) => {
        if (event.target === overlay) closeZoom();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeZoom();
      });
    }

    document.querySelectorAll("[data-static-jump-form]").forEach((form) => {
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const input = form.querySelector("[name='chapterNum']");
        const number = parseInt(input && input.value, 10);
        const targets = JSON.parse(form.getAttribute("data-jump-targets") || "[]");
        const targetId = targets[number - 1];
        const galleryPath = form.getAttribute("data-gallery-path") || "";
        if (targetId && galleryPath) {
          window.location.href = `${galleryPath}/${targetId}`;
        }
      });
    });

    const notesButton = document.querySelector("[data-static-notes-btn]");
    const details = document.querySelector(".more-about-image");
    if (notesButton && details) {
      notesButton.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        details.open = !details.open;
      });
    }
  })();
</script>
