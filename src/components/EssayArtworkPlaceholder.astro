---
interface Props {
  title: string;
  src?: string;
  href?: string;
  alt?: string;
  placement?: "hero" | "inline";
  side?: "left" | "right";
  aspectRatio?: string;
  maxWidth?: string;
  crop?: boolean;
  objectPosition?: string;
}

const {
  title,
  src,
  href,
  alt,
  placement = "inline",
  side = "right",
  aspectRatio = placement === "hero" ? "16 / 10" : "4 / 3",
  maxWidth,
  crop = false,
  objectPosition = "center center",
} = Astro.props;
---

<figure
  class:list={[
    "essay-artwork-placeholder",
    `essay-artwork-placeholder--${placement}`,
    placement === "inline" && `essay-artwork-placeholder--${side}`,
  ]}
  style={`--placeholder-aspect-ratio: ${aspectRatio};${maxWidth ? ` max-width: ${maxWidth};` : ""}`}
  data-artwork-title={title}
>
  {src ? (
    href ? (
      <a class="essay-artwork-placeholder__link" href={href} aria-label={`Open ${title} artwork detail page`}>
        <img
          class:list={[crop && "essay-artwork-placeholder__image--crop"]}
          src={src}
          alt={alt || ""}
          loading={placement === "hero" ? "eager" : "lazy"}
          style={crop ? `object-position: ${objectPosition}` : undefined}
        />
      </a>
    ) : (
      <img
        class:list={[crop && "essay-artwork-placeholder__image--crop"]}
        src={src}
        alt={alt || ""}
        loading={placement === "hero" ? "eager" : "lazy"}
        style={crop ? `object-position: ${objectPosition}` : undefined}
      />
    )
  ) : (
    <div class="essay-artwork-placeholder__field" aria-hidden="true">
      <span class="essay-artwork-placeholder__mark">K4</span>
      <span class="essay-artwork-placeholder__rule"></span>
      <span class="essay-artwork-placeholder__status">Artwork forthcoming</span>
    </div>
  )}
  <figcaption><strong>{title}</strong></figcaption>
</figure>

<style>
  .essay-artwork-placeholder {
    margin: 0;
    border: 1px solid #ded3c7;
    border-radius: 8px;
    background: #fbf7f1;
    overflow: hidden;
  }

  .essay-artwork-placeholder--hero {
    width: 100%;
    margin: 2.5rem auto 0;
    box-shadow: 0 22px 56px rgba(47, 38, 31, 0.12);
  }

  .essay-artwork-placeholder--inline {
    width: min(22rem, 44%);
    margin: 0.35rem 0 1.4rem 1.8rem;
    float: right;
  }

  .essay-artwork-placeholder--inline.essay-artwork-placeholder--left {
    margin: 0.35rem 1.8rem 1.4rem 0;
    float: left;
  }

  .essay-artwork-placeholder__field {
    display: flex;
    aspect-ratio: var(--placeholder-aspect-ratio);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    background:
      linear-gradient(135deg, rgba(139, 95, 27, 0.08), transparent 45%),
      #f3eee7;
    color: #8b7355;
  }

  .essay-artwork-placeholder__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .essay-artwork-placeholder img {
    display: block;
    width: 100%;
    height: auto;
  }

  .essay-artwork-placeholder .essay-artwork-placeholder__image--crop {
    aspect-ratio: var(--placeholder-aspect-ratio);
    object-fit: cover;
  }

  .essay-artwork-placeholder__mark {
    font-family: "Glegoo", serif;
    font-size: clamp(2.3rem, 7vw, 4.5rem);
    line-height: 1;
  }

  .essay-artwork-placeholder__rule {
    width: 4.5rem;
    height: 1px;
    margin: 0.55rem 0 0.65rem;
    background: #b78b52;
  }

  .essay-artwork-placeholder__status {
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  figcaption {
    padding: 0.72rem 0.9rem;
    color: #6e6259;
    font-size: 0.82rem;
    line-height: 1.5;
    text-align: center;
  }

  figcaption strong {
    color: #332821;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .essay-artwork-placeholder--inline,
    .essay-artwork-placeholder--inline.essay-artwork-placeholder--left {
      float: none;
      width: 100%;
      margin: 1.25rem 0;
    }
  }
</style>
