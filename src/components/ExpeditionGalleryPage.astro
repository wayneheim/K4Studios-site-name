---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExpeditionLikeButton from "@/components/ExpeditionLikeButton.jsx";
import ExpeditionExploreMore from "@/components/ExpeditionExploreMore.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter from "@/components/Footer.astro";
import { getPublicSmugMugGalleryPage } from "@/lib/smugmug";
import type { Expedition } from "@/data/Other/Expeditions/shoots";
import "@/styles/global.css";

const { expedition, testMode = false } = Astro.props as {
  expedition: Expedition;
  testMode?: boolean;
};
const galleryPath = new URL(expedition.galleryUrl).pathname;
const PAGE_SIZE = 24;
const copyrightYear = new Date().getFullYear();
const requestedPage = Number.parseInt(Astro.url.searchParams.get("page") || "1", 10);
const page = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

let gallery;
let loadError = "";

try {
  gallery = await getPublicSmugMugGalleryPage({
    nickname: "wayne-heim",
    galleryPath,
    page,
    pageSize: PAGE_SIZE,
  });
} catch (error) {
  loadError = error instanceof Error ? error.message : "The SmugMug gallery could not be loaded.";
  console.error("[SmugMug proof of concept]", error);
}

const pageNumbers = gallery
  ? Array.from({ length: gallery.pageCount }, (_, index) => index + 1)
  : [];
const firstVisible = gallery ? (gallery.page - 1) * gallery.pageSize + 1 : 0;
const lastVisible = gallery ? Math.min(gallery.page * gallery.pageSize, gallery.total) : 0;
const formatPrice = (price: number, currency: string) => new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: currency || "USD",
  maximumFractionDigits: Number.isInteger(price) ? 0 : 2,
}).format(price);
const priceSizeAreas = gallery
  ? [...new Set(gallery.prices.map((option) => option.width * option.height))].sort((a, b) => a - b)
  : [];
const priceTier = (width: number, height: number) =>
  Math.min(5, Math.max(1, priceSizeAreas.indexOf(width * height) + 1));
const reverseImageNumber = (index: number) => gallery
  ? gallery.total - ((gallery.page - 1) * gallery.pageSize + index)
  : 0;
const expeditionLikeImages = gallery?.images.map((image, index) => ({
  // The shared notification endpoint uses the site's canonical i-{key} ID format.
  imageId: `i-${image.key}`,
  pageTitle: `${expedition.title} — Image ${reverseImageNumber(index)}`,
})) || [];
const canonicalPath = `/Other/Expeditions/${expedition.slug}`;
const canonicalUrl = `https://www.k4studios.com${canonicalPath}${page > 1 ? `?page=${page}` : ""}`;
const pageTitle = `${expedition.title} Expedition Gallery | K4 Studios`;
const pageDescription = `${expedition.description} Browse current pre-release photographs and available Expedition print options.`;
const pageMeta = {
  seoTitle: pageTitle,
  preserveTitleExact: true,
  seoDescription: pageDescription,
  canonicalUrl,
  ogUrl: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogType: "website",
  robots: testMode ? "noindex, nofollow" : "index, follow",
};
const structuredData = testMode ? undefined : {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: pageTitle,
  description: pageDescription,
  isPartOf: {
    "@type": "WebSite",
    "@id": "https://www.k4studios.com/#website",
    name: "K4 Studios",
    url: "https://www.k4studios.com/",
  },
  mainEntity: {
    "@type": "ImageGallery",
    "@id": `${canonicalUrl}#imagegallery`,
    name: `${expedition.title} Expedition Gallery`,
    description: expedition.description,
    numberOfItems: gallery?.total || 0,
    creator: {
      "@type": "Person",
      name: "Wayne Heim",
      url: "https://www.k4studios.com/Other/Bio",
    },
  },
};
const breadcrumbData = testMode ? undefined : {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.k4studios.com/" },
    { "@type": "ListItem", position: 2, name: "Other", item: "https://www.k4studios.com/Other" },
    { "@type": "ListItem", position: 3, name: "Expeditions", item: "https://www.k4studios.com/Other/Expeditions" },
    { "@type": "ListItem", position: 4, name: expedition.title, item: `https://www.k4studios.com${canonicalPath}` },
  ],
};
const breadcrumbHtml = `<a href='/Other' style='color: inherit; text-decoration: none;'>Other</a> &rsaquo; <a href='/Other/Expeditions' style='color: inherit; text-decoration: none;'>Expeditions</a> &rsaquo; ${expedition.title}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  meta={pageMeta}
  structuredDataJSON={structuredData ? JSON.stringify(structuredData) : undefined}
  breadcrumbsJSON={breadcrumbData ? JSON.stringify(breadcrumbData) : undefined}
>
  <main class="poc-page">
    <div class="poc-shell">
      <LandingHeader
        client:load
        breadcrumb={breadcrumbHtml}
      />

      <header class="poc-header">
        <p class="eyebrow">Expedition Pre-Release</p>
        <h1>{expedition.title}</h1>
        <p class="lede">
          Photographs in this Expedition are available at special pre-release pricing while they remain
          here. New photographs will continue to be added—check back often.
        </p>
        <aside class="release-note">
          <strong>Selected for release?</strong>
          <span>
            When an image is chosen for a finished K4 collection, it leaves the Expedition and
            pre-release pricing ends.
          </span>
        </aside>

        {gallery && (
          <div class="api-status" role="status">
            <span class="status-dot" aria-label="Gallery connected"></span>
            Showing images {firstVisible}–{lastVisible} of {gallery.total} from this gallery
          </div>
        )}
      </header>

      {loadError ? (
        <section class="error-panel" role="alert">
          <h2>The test gallery could not be loaded</h2>
          <p>{loadError}</p>
          <p>Confirm the local SmugMug environment values and restart the development server.</p>
        </section>
      ) : (
        <>
          {gallery && gallery.prices.length > 0 && (
            <section class="gallery-pricing" aria-labelledby="gallery-pricing-title">
              <div class="pricing-heading">
                <h2 id="gallery-pricing-title">Expedition Prints</h2>
                <p class="eyebrow pricing-subtitle">Pre-Release Sizes and Pricing</p>
                <p>
                  Special sizes and pricing are available while an image remains in this Expedition. If
                  selected for a finished K4 collection, the image leaves the Expedition and becomes
                  available at standard gallery pricing.
                </p>
              </div>
              <ul class="price-grid">
                {gallery.prices.map((option, index) => (
                  <li
                    class:list={[
                      `price-tier-${priceTier(option.width, option.height)}`,
                      {
                        "price-tier-start": index > 0 &&
                          gallery.prices[index - 1].width * gallery.prices[index - 1].height !==
                            option.width * option.height,
                      },
                    ]}
                  >
                    <span class="price-product">{option.productName}</span>
                    <span class="price-finish">{option.finish}</span>
                    <strong>{formatPrice(option.price, option.currency)}</strong>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {gallery && gallery.pageCount > 1 && (
            <div class="pagination-region pagination-region-top" id="expedition-grid">
              <p class="gallery-order-note">
                Images are displayed in upload order, with the newest photographs first.
              </p>
              <nav class="pagination" aria-label="Gallery pages above photographs">
                <a
                  class:list={["page-arrow", { disabled: gallery.page === 1 }]}
                  href={gallery.page > 1 ? `?page=${gallery.page - 1}#expedition-grid` : undefined}
                  aria-label="Previous gallery page"
                  aria-disabled={gallery.page === 1 ? "true" : undefined}
                >
                  &larr; Previous
                </a>

                <div class="page-numbers">
                  {pageNumbers.map((pageNumber) => (
                    <a
                      class:list={["page-number", { current: pageNumber === gallery.page }]}
                      href={`?page=${pageNumber}#expedition-grid`}
                      aria-current={pageNumber === gallery.page ? "page" : undefined}
                    >
                      {pageNumber}
                    </a>
                  ))}
                </div>

                <a
                  class:list={["page-arrow", { disabled: gallery.page === gallery.pageCount }]}
                  href={gallery.page < gallery.pageCount ? `?page=${gallery.page + 1}#expedition-grid` : undefined}
                  aria-label="Next gallery page"
                  aria-disabled={gallery.page === gallery.pageCount ? "true" : undefined}
                >
                  Next &rarr;
                </a>
              </nav>
            </div>
          )}

          <section class="image-grid" aria-label={`${expedition.title} photographs`}>
            {gallery?.images.map((image, index) => (
              <article class="image-card">
                <button
                  class="image-button"
                  type="button"
                  data-lightbox-open
                  data-large-src={image.srcL}
                  data-image-id={image.key}
                  data-title={`Image ${reverseImageNumber(index)}`}
                  data-order-url={image.orderUrl}
                  aria-label={`Preview Image ${reverseImageNumber(index)} from ${expedition.title}`}
                >
                  <span class="image-frame">
                    <img
                      src={image.thumbnailUrl}
                      alt={`Pre-release photograph from ${expedition.title}, Image ${reverseImageNumber(index)}`}
                      width={image.width}
                      height={image.height}
                      loading={index < 6 ? "eager" : "lazy"}
                      decoding="async"
                      draggable="false"
                    />
                  </span>
                  <span class="image-meta">
                    <span class="preview-label">Image {reverseImageNumber(index)}</span>
                  </span>
                </button>
              </article>
            ))}
          </section>

          {gallery && gallery.pageCount > 1 && (
            <div class="pagination-region pagination-region-bottom">
              <p class="gallery-order-note">
                Images are displayed in upload order, with the newest photographs first.
              </p>
              <nav class="pagination" aria-label="Gallery pages below photographs">
                <a
                  class:list={["page-arrow", { disabled: gallery.page === 1 }]}
                  href={gallery.page > 1 ? `?page=${gallery.page - 1}#expedition-grid` : undefined}
                  aria-label="Previous gallery page"
                  aria-disabled={gallery.page === 1 ? "true" : undefined}
                >
                  &larr; Previous
                </a>

                <div class="page-numbers">
                  {pageNumbers.map((pageNumber) => (
                    <a
                      class:list={["page-number", { current: pageNumber === gallery.page }]}
                      href={`?page=${pageNumber}#expedition-grid`}
                      aria-current={pageNumber === gallery.page ? "page" : undefined}
                    >
                      {pageNumber}
                    </a>
                  ))}
                </div>

                <a
                  class:list={["page-arrow", { disabled: gallery.page === gallery.pageCount }]}
                  href={gallery.page < gallery.pageCount ? `?page=${gallery.page + 1}#expedition-grid` : undefined}
                  aria-label="Next gallery page"
                  aria-disabled={gallery.page === gallery.pageCount ? "true" : undefined}
                >
                  Next &rarr;
                </a>
              </nav>
            </div>
          )}

          <ExpeditionExploreMore rotationKey={`${expedition.slug}:${page}`} />

        </>
      )}
    </div>

    <SiteFooter title={`${expedition.title} Expedition Gallery`} label="K4 Studios" class="pt-8 pb-12" />
  </main>

  <dialog
    class="lightbox"
    data-lightbox
    data-expedition-title={expedition.title}
    data-gallery-id={canonicalPath}
  >
    <form method="dialog">
      <button class="lightbox-close" aria-label="Close image preview">&times;</button>
    </form>
    <div class="lightbox-content">
      <div class="lightbox-image-wrap">
        <img data-lightbox-image src="" alt="" draggable="false" />
        <button
          class="lightbox-nav lightbox-prev"
          type="button"
          data-lightbox-prev
          aria-label="View previous photograph"
        >
          <span aria-hidden="true">&larr;</span>
        </button>
        <button
          class="lightbox-nav lightbox-next"
          type="button"
          data-lightbox-next
          aria-label="View next photograph"
        >
          <span aria-hidden="true">&rarr;</span>
        </button>
        <p class="copyright-notice">
          &copy; {copyrightYear} Wayne Heim / K4 Studios. All rights reserved.
        </p>
      </div>
      <div class="lightbox-details">
        <p class="eyebrow">{expedition.title}</p>
        <h2 data-lightbox-title></h2>
        <hr class="lightbox-like-divider" />
        <div class="lightbox-like-inline">
          <ExpeditionLikeButton client:load images={expeditionLikeImages} />
        </div>
        <div class="lightbox-controls">
          <button type="button" class="slideshow-toggle" data-slideshow-toggle>
            Start slideshow
          </button>
          <span class="image-counter" data-image-counter aria-live="polite"></span>
        </div>
        <p class="slideshow-page-hint" data-slideshow-hint aria-hidden="true">
          To view more images from this gallery, return to the grid and choose the next page to view
          the next group.
        </p>
        <a
          class="order-link"
          data-lightbox-order
          href="#"
          target="_blank"
          rel="nofollow noopener noreferrer"
        >
          Order Prints <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </dialog>

  <div class="image-protection-message" data-image-protection role="status" aria-live="polite">
    This photograph is copyright protected. Please use the ordering options for authorized prints.
  </div>

  <script>
    const dialog = document.querySelector("[data-lightbox]");
    const dialogImage = dialog?.querySelector("[data-lightbox-image]");
    const dialogTitle = dialog?.querySelector("[data-lightbox-title]");
    const dialogOrder = dialog?.querySelector("[data-lightbox-order]");
    const previousButton = dialog?.querySelector("[data-lightbox-prev]");
    const nextButton = dialog?.querySelector("[data-lightbox-next]");
    const slideshowButton = dialog?.querySelector("[data-slideshow-toggle]");
    const slideshowHint = dialog?.querySelector("[data-slideshow-hint]");
    const imageCounter = dialog?.querySelector("[data-image-counter]");
    const protectionMessage = document.querySelector("[data-image-protection]");
    const previewButtons = Array.from(document.querySelectorAll("[data-lightbox-open]"));
    const paginationLinks = Array.from(document.querySelectorAll(".pagination a[href]"));
    let activeIndex = 0;
    let slideshowTimer;
    let imageTransitionTimer;
    let protectionTimer;
    let slideshowHintTimer;
    let slideshowHintShown = false;
    const slideshowHintStorageKey = "k4-expedition-slideshow-hint-seen";

    const imageIdAt = (index) => {
      const button = previewButtons[index];
      if (!(button instanceof HTMLElement) || !button.dataset.imageId) return null;
      return button.dataset.imageId.startsWith("i-")
        ? button.dataset.imageId
        : `i-${button.dataset.imageId}`;
    };

    const trackExpeditionEvent = (eventName, { index = null, trigger } = {}) => {
      if (typeof window.k4track !== "function") return;
      window.k4track(eventName, {
        galleryId: dialog?.dataset.galleryId || window.location.pathname,
        imageId: Number.isInteger(index) ? imageIdAt(index) : null,
        pageType: "gallery",
        trigger,
      });
    };

    const trackDisplayedImage = (trigger) => {
      trackExpeditionEvent("chapter_view", { index: activeIndex, trigger });
    };

    const hideSlideshowHint = () => {
      window.clearTimeout(slideshowHintTimer);
      if (!(slideshowHint instanceof HTMLElement)) return;
      slideshowHint.classList.remove("visible");
      slideshowHint.setAttribute("aria-hidden", "true");
    };

    const showSlideshowHintOnce = () => {
      if (!(slideshowHint instanceof HTMLElement) || slideshowHintShown) return;

      try {
        if (window.sessionStorage.getItem(slideshowHintStorageKey)) return;
        window.sessionStorage.setItem(slideshowHintStorageKey, "true");
      } catch {
        // If storage is unavailable, the hint can still appear during this page view.
      }

      slideshowHintShown = true;
      slideshowHint.classList.add("visible");
      slideshowHint.setAttribute("aria-hidden", "false");
      slideshowHintTimer = window.setTimeout(hideSlideshowHint, 5000);
    };

    const updatePreviewImage = (src, alt) => {
      if (!(dialogImage instanceof HTMLImageElement)) return;
      window.clearTimeout(imageTransitionTimer);

      if (!(dialog instanceof HTMLDialogElement) || !dialog.open || !dialogImage.src) {
        dialogImage.src = src;
        dialogImage.alt = alt;
        dialogImage.classList.remove("is-transitioning");
        return;
      }

      dialogImage.classList.add("is-transitioning");
      imageTransitionTimer = window.setTimeout(() => {
        dialogImage.src = src;
        dialogImage.alt = alt;
        requestAnimationFrame(() => dialogImage.classList.remove("is-transitioning"));
      }, 350);
    };

    const showProtectionMessage = () => {
      if (!(protectionMessage instanceof HTMLElement)) return;
      window.clearTimeout(protectionTimer);
      protectionMessage.classList.add("visible");
      protectionTimer = window.setTimeout(() => {
        protectionMessage.classList.remove("visible");
      }, 3200);
    };

    const showImage = (index) => {
      if (previewButtons.length === 0) return;
      activeIndex = (index + previewButtons.length) % previewButtons.length;
      const button = previewButtons[activeIndex];
      if (!(button instanceof HTMLElement)) return;

      const title = button.dataset.title || dialog?.dataset.expeditionTitle || "Expedition photograph";

      if (dialog instanceof HTMLDialogElement) {
        dialog.dataset.activeImageIndex = String(activeIndex);
      }
      window.dispatchEvent(new CustomEvent("k4:expedition-image-change", {
        detail: { index: activeIndex },
      }));

      updatePreviewImage(button.dataset.largeSrc || "", title);
      if (dialogTitle) dialogTitle.textContent = title;
      if (dialogOrder instanceof HTMLAnchorElement) {
        dialogOrder.href = button.dataset.orderUrl || "#";
      }
      if (imageCounter) {
        imageCounter.textContent = `${activeIndex + 1} of ${previewButtons.length}`;
      }

      const followingButton = previewButtons[(activeIndex + 1) % previewButtons.length];
      if (followingButton instanceof HTMLElement && followingButton.dataset.largeSrc) {
        new Image().src = followingButton.dataset.largeSrc;
      }
    };

    const stopSlideshow = () => {
      if (slideshowTimer) window.clearInterval(slideshowTimer);
      slideshowTimer = undefined;
      hideSlideshowHint();
      if (slideshowButton) slideshowButton.textContent = "Start slideshow";
      if (dialog instanceof HTMLDialogElement) dialog.classList.remove("is-slideshow");
    };

    const toggleSlideshow = () => {
      if (slideshowTimer) {
        stopSlideshow();
        return;
      }

      slideshowTimer = window.setInterval(() => {
        showImage(activeIndex + 1);
        trackExpeditionEvent("slideshow_nav_next", {
          index: activeIndex,
          trigger: "expedition_slideshow_auto",
        });
        trackDisplayedImage("expedition_slideshow_auto");
      }, 3500);
      if (slideshowButton) slideshowButton.textContent = "Exit slideshow";
      if (dialog instanceof HTMLDialogElement) dialog.classList.add("is-slideshow");
      trackExpeditionEvent("slideshow_start", {
        index: activeIndex,
        trigger: "expedition_slideshow_button",
      });
      showSlideshowHintOnce();
    };

    previewButtons.forEach((button, index) => {
      button.addEventListener("click", () => {
        if (!(dialog instanceof HTMLDialogElement)) return;
        showImage(index);
        trackExpeditionEvent("grid_image_click", {
          index: activeIndex,
          trigger: "expedition_thumbnail",
        });
        trackDisplayedImage("expedition_thumbnail");
        dialog.showModal();
      });
    });

    const navigateImage = (offset, eventName, trigger) => {
      showImage(activeIndex + offset);
      trackExpeditionEvent(eventName, { index: activeIndex, trigger });
      trackDisplayedImage(trigger);
    };

    previousButton?.addEventListener("click", () => {
      navigateImage(-1, "nav_prev", "expedition_lightbox_button");
    });
    nextButton?.addEventListener("click", () => {
      navigateImage(1, "nav_next", "expedition_lightbox_button");
    });
    slideshowButton?.addEventListener("click", toggleSlideshow);
    dialogOrder?.addEventListener("click", () => {
      trackExpeditionEvent("order_smugmug_clicked", {
        index: activeIndex,
        trigger: "expedition_order_prints",
      });
    });

    paginationLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (!(link instanceof HTMLAnchorElement)) return;
        const currentPage = Number(new URL(window.location.href).searchParams.get("page") || "1");
        const targetPage = Number(new URL(link.href).searchParams.get("page") || "1");
        const movingForward = targetPage > currentPage;
        trackExpeditionEvent(movingForward ? "grid_show_more" : "grid_show_previous", {
          trigger: movingForward ? "expedition_pagination_next" : "expedition_pagination_previous",
        });
      });
    });

    document.addEventListener("keydown", (event) => {
      if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return;
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        navigateImage(-1, "nav_prev", "expedition_lightbox_keyboard");
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        navigateImage(1, "nav_next", "expedition_lightbox_keyboard");
      }
    });

    dialog?.addEventListener("close", stopSlideshow);
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
    });

    document.querySelectorAll(".image-frame img, [data-lightbox-image]").forEach((image) => {
      image.addEventListener("contextmenu", (event) => {
        event.preventDefault();
        showProtectionMessage();
      });
      image.addEventListener("dragstart", (event) => event.preventDefault());
    });
  </script>

  <style>
    .poc-page {
      min-height: 100vh;
      color: #2d2924;
      background: #fff;
      font-family: "Glegoo", serif;
    }

    .poc-shell {
      width: min(1500px, calc(100% - 32px));
      margin: 0 auto;
      padding: 0 0 64px;
    }

    .poc-header {
      max-width: 900px;
      margin: 0 auto;
      padding: 76px 20px 48px;
      text-align: center;
    }

    .eyebrow {
      margin: 0 0 12px;
      color: #8a4f27;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-family: "Glegoo", serif;
      font-size: clamp(2.25rem, 5vw, 4.8rem);
      font-weight: 400;
      line-height: 1.02;
    }

    .lede {
      max-width: 760px;
      margin: 24px auto 0;
      color: #615b53;
      font-size: clamp(1rem, 1.6vw, 1.16rem);
      line-height: 1.8;
    }

    .release-note {
      max-width: 720px;
      margin: 24px auto 0;
      padding: 16px 20px;
      border-left: 3px solid #9a653d;
      color: #4f463e;
      background: rgba(255, 255, 255, 0.52);
      font-size: 0.9rem;
      line-height: 1.65;
      text-align: left;
    }

    .release-note strong {
      display: block;
      margin-bottom: 3px;
      color: #8a4f27;
      font-weight: 700;
    }

    .api-status {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-top: 24px;
      padding: 8px 14px;
      border: 1px solid #cfc5b8;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.66);
      color: #514b44;
      font-size: 0.8rem;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #517d4b;
      box-shadow: 0 0 0 3px rgba(81, 125, 75, 0.14);
    }

    .image-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 28px 18px;
      align-items: start;
    }

    .image-card {
      min-width: 0;
    }

    .image-button {
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      color: inherit;
      background: transparent;
      font: inherit;
      text-align: left;
      cursor: zoom-in;
    }

    .image-frame {
      display: grid;
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      place-items: center;
      background: #221f1c;
      box-shadow: 0 9px 28px rgba(39, 30, 22, 0.12);
    }

