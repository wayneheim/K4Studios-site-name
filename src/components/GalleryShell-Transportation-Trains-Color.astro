---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Transportation-Trains-Color.jsx";
import { galleryData as allImages } from "@/data/Galleries/Painterly-Fine-Art-Photography/Transportation/Trains-Color.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Transportation/landingstones.ts";

const GALLERY_PATH = "/Galleries/Painterly-Fine-Art-Photography/Transportation/Trains-Color";
const FALLBACK_DESCRIPTION = "Painterly color train photography by Wayne Heim — vibrant railroad, steam engine, and locomotive fine art prints for collectors and story-lovers.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
const shouldSsrChapterViewer = Boolean(initialImageId && initialImageId !== "i-k4studios") || Astro.url.searchParams.get("view") === "grid";
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  {shouldSsrChapterViewer ? (
    <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId} />
  ) : (
    <ChapterViewer slot="chapter-viewer" client:only="react" initialImageId={initialImageId} />
  )}
</GalleryShellCore>
