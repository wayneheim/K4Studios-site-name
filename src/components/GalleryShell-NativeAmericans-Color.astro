---
import GalleryShellCore from '@/components/GalleryShellCore.astro';
import ChapterViewer from '@/components/Chapter-NativeAmericansColor.jsx';
import { galleryData as allImages } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color.mjs';
import { landingWestern as landingData } from '@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/landingstones.ts';

const GALLERY_PATH = '/Galleries/Painterly-Fine-Art-Photography/Facing-History/Wild-West/Native-Americans/NA-Color';
const FALLBACK_DESCRIPTION = 'Explore painterly Native American portrait photography in color by Wayne Heim.';

const { breadcrumb, entranceData, initialImageId } = Astro.props;
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId || 'i-k4studios'} />
</GalleryShellCore>