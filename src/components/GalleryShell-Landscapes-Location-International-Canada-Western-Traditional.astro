---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Landscapes-Location-International-Canada-Western-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Location/International/Canada-Western.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Location/International/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Landscapes/By-Location/International/Canada-Western";
const FALLBACK_DESCRIPTION = "Explore traditional fine art landscape photography of Western Canada by Wayne Heim. Majestic Rocky Mountain peaks, pristine lakes, and wilderness vistas.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId || "i-k4studios"} />
</GalleryShellCore>
