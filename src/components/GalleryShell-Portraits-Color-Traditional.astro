---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Portraits-Color-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Portraits/Color.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Portraits/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Portraits/Color";
const FALLBACK_DESCRIPTION = "Explore traditional color fine art portrait photography by Wayne Heim. Vibrant character studies with rich tones and storytelling.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId || "i-k4studios"} />
</GalleryShellCore>
