---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Transportation-Military-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Transportation/Military.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Transportation/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Transportation/Military";
const FALLBACK_DESCRIPTION = "Explore traditional fine art military vehicle photography by Wayne Heim. Tanks, jeeps, and historic military transport.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
const shouldSsrChapterViewer = Boolean(initialImageId && initialImageId !== "i-k4studios") || Astro.url.searchParams.get("view") === "grid";
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  {shouldSsrChapterViewer ? (
    <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId} />
  ) : (
    <ChapterViewer slot="chapter-viewer" client:only="react" initialImageId={initialImageId} />
  )}
</GalleryShellCore>
