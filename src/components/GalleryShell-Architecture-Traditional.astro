---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Architecture-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Architecture/Gallery.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Architecture/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Architecture/Gallery";
const FALLBACK_DESCRIPTION = "Explore traditional fine art architecture photography by Wayne Heim. Historic buildings, structures, and architectural details.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId || "i-k4studios"} />
</GalleryShellCore>
