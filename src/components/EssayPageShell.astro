---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingHeader from "@/components/Landing-Header.jsx";
import SiteFooter from "@/components/Footer.astro";
import "@/styles/global.css";

interface Artwork {
  src: string;
  href?: string;
  alt: string;
  title?: string;
}

interface RelatedEssay {
  title: string;
  seoTitle?: string;
  description: string;
  href: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  canonicalPath: string;
  eyebrow?: string;
  heroArtwork?: Artwork;
  relatedEssays?: RelatedEssay[];
  bottomCta?: { label: string; href: string };
  structuredData?: Record<string, unknown>;
}

const {
  title,
  seoTitle = title,
  subtitle,
  description,
  canonicalPath,
  eyebrow = "Foundational Writing",
  heroArtwork,
  relatedEssays = [],
  bottomCta,
  structuredData,
} = Astro.props;

const canonicalUrl = `https://www.k4studios.com${canonicalPath}`;
const meta = {
  seoTitle,
  preserveTitleExact: true,
  seoDescription: description,
  canonicalUrl,
  ogUrl: canonicalUrl,
  ogTitle: seoTitle,
  ogDescription: description,
  ogType: "article",
  robots: "index, follow",
};
---

<BaseLayout title={title} description={description} meta={meta} structuredDataJSON={structuredData}>
  <main class="essay-shell">
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={`Other > Essays & Writings > ${title}`} />
    </div>

    <header class:list={["essay-hero", !heroArtwork && "essay-hero--text-only"]}>
      <div class="essay-hero__copy">
        <p class="essay-eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="essay-subtitle">{subtitle}</p>
        <slot name="lead" />
      </div>
      {heroArtwork && (
        <figure class="essay-hero__artwork">
          {heroArtwork.href ? (
            <a href={heroArtwork.href} aria-label={`Open ${heroArtwork.title || title} artwork detail page`}>
              <img src={heroArtwork.src} alt={heroArtwork.alt} />
            </a>
          ) : (
            <img src={heroArtwork.src} alt={heroArtwork.alt} />
          )}
          {heroArtwork.title && <figcaption>{heroArtwork.title}</figcaption>}
        </figure>
      )}
    </header>

    <article class="essay-body"><slot /></article>

    {relatedEssays.length > 0 && (
      <aside class="essay-related" aria-labelledby="related-essays-heading">
        <p class="essay-eyebrow">Continue Reading</p>
        <h2 id="related-essays-heading">Related Essays & Ideas</h2>
        <div class="essay-related__grid">
          {relatedEssays.map((essay) => (
            <a href={essay.href}>
              <strong>{essay.title}</strong>
              <span>{essay.description}</span>
            </a>
          ))}
        </div>
      </aside>
    )}

    {bottomCta && <a class="essay-bottom-cta" href={bottomCta.href}>{bottomCta.label} <span aria-hidden="true">&rarr;</span></a>}

    <SiteFooter previewImages={[]} previewPath="/Galleries/Painterly-Fine-Art-Photography" title={title} label="" />
  </main>
</BaseLayout>

<style>
  .essay-shell { min-height: 100vh; overflow-x: hidden; background: #fff; color: #2c2c2c; font-family: "Glegoo", serif; }
  .essay-hero { display: block; max-width: 1020px; margin: 0 auto; padding: clamp(3rem, 7vw, 5.75rem) 1.5rem 3rem; }
  .essay-hero--text-only { display: block; max-width: 760px; text-align: center; }
  .essay-hero__copy { max-width: 820px; margin: 0 auto; padding: 0 1.5rem; box-sizing: border-box; }
  .essay-eyebrow { margin: 0 0 .7rem; color: #8b5f1b; font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .essay-hero h1 { margin: 0; color: #2f261f; font-size: clamp(2.7rem, 7vw, 5.5rem); font-weight: 700; line-height: .98; }
  .essay-subtitle { margin: 1rem 0 0; color: #6a5c52; font-size: clamp(1.08rem, 2vw, 1.38rem); line-height: 1.5; }
  .essay-hero__copy :global(.essay-lead) { width: 100%; margin: 1.65rem 0 0; color: #443b34; font-size: 1.06rem; line-height: 1.78; }
  .essay-hero__copy :global(.essay-lead p) { margin: 0 0 .85rem; }
  .essay-hero__artwork { width: 100%; margin: 2.5rem auto 0; }
  .essay-hero__artwork a { display: block; background: #1d1712; }
  .essay-hero__artwork img { display: block; width: 100%; height: auto; object-fit: contain; box-shadow: 0 22px 56px rgba(47,38,31,.16); }
  .essay-hero__artwork figcaption { margin-top: .7rem; color: #74685f; font-size: .84rem; text-align: center; }
  .essay-body { max-width: 820px; margin: 0 auto; padding: 0 1.5rem 2.5rem; }
  .essay-body :global(.essay-section) { clear: both; padding: 2.25rem 0 1.5rem; }
  .essay-body :global(.essay-section h2) { margin: 0; color: #332821; font-size: clamp(1.55rem, 3vw, 2.2rem); font-weight: 600; line-height: 1.2; }
  .essay-body :global(.essay-section h2::after) { content: ""; display: block; height: 1px; margin: .75rem 0 1.4rem; background: linear-gradient(90deg, rgba(139,95,27,.38), rgba(139,95,27,0)); }
  .essay-body :global(.essay-section p) { margin: 0 0 1.15rem; color: #342c26; font-size: 1.04rem; line-height: 1.82; }
  .essay-body :global(.essay-pull-quote) { margin: 2.25rem auto; padding: 1.35rem clamp(1rem, 4vw, 2rem); border-block: 1px solid rgba(139,95,27,.28); color: #382d25; font-size: clamp(1.3rem, 3vw, 1.8rem); font-style: italic; line-height: 1.55; text-align: center; }
  .essay-body :global(.essay-cascade) { margin: 1.5rem 0 1.75rem; padding-left: 1.25rem; border-left: 3px solid rgba(139,95,27,.42); color: #463a31; font-size: 1.12rem; line-height: 1.9; }
  .essay-body :global(.essay-artwork) { width: min(22rem, 44%); margin: .35rem 0 1.4rem 1.8rem; float: right; border: 1px solid #ded3c7; background: #fbf7f1; }
  .essay-body :global(.essay-artwork--left) { float: left; margin: .35rem 1.8rem 1.4rem 0; }
  .essay-body :global(.essay-artwork img) { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center top; }
  .essay-body :global(.essay-artwork figcaption) { padding: .8rem .9rem; color: #6e6259; font-size: .82rem; line-height: 1.5; }
  .essay-related { max-width: 900px; margin: 1rem auto 2rem; padding: 2rem 1.5rem; border-top: 1px solid #d9cdbf; }
  .essay-related h2 { margin: 0 0 1.35rem; color: #332821; font-size: clamp(1.5rem, 3vw, 2rem); }
  .essay-related__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .essay-related__grid a { padding: 1.1rem; border: 1px solid #ded3c7; background: #fbf7f1; color: inherit; text-decoration: none; }
  .essay-related__grid strong, .essay-related__grid span { display: block; }
  .essay-related__grid strong { color: #3b2f27; }
  .essay-related__grid span { margin-top: .5rem; color: #695e55; font-size: .86rem; line-height: 1.55; }
  .essay-bottom-cta { display: block; width: fit-content; margin: 0 auto 4rem; color: #713f2b; font-weight: 700; text-underline-offset: .25em; }
  @media (max-width: 760px) { .essay-hero { padding-top: 2.25rem; } .essay-hero h1 { font-size: clamp(2.55rem, 14vw, 4.5rem); } .essay-body :global(.essay-artwork), .essay-body :global(.essay-artwork--left) { float: none; width: 100%; margin: 1.25rem 0; } .essay-related__grid { grid-template-columns: 1fr; } }
</style>
