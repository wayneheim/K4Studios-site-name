---
interface GuideLink {
  href: string;
  label: string;
  description: string;
}

const defaultGuideLinks: GuideLink[] = [
  {
    href: '/Blog/what-is-western-art',
    label: 'What Is Western Art, Really?',
    description: 'The root definition page covering the larger Western tradition, its history, and why the subject still matters',
  },
  {
    href: '/Art-of-the-American-West',
    label: 'Art of the American West',
    description: 'A definition-led guide to the canon, themes, legacy, and continuing life of the American West in art',
  },
  {
    href: '/Masters-of-American-Western-Art',
    label: 'Masters of American Western Art',
    description: 'Historical authority on the artists, landscapes, and myth-makers who shaped the tradition',
  },
  {
    href: '/American-Western-Art',
    label: 'American Western Art',
    description: 'The more collection-driven bridge connecting frontier history to Wayne Heim\'s limited-edition Western work',
  },
  {
    href: '/Fine-Art-Photography-of-the-American-West',
    label: 'Fine Art Photography of the American West',
    description: 'The broader photographic umbrella treating the American West as a full historical environment',
  },
  {
    href: '/Western-Frontier-Art',
    label: 'Western Frontier Art',
    description: 'The historically focused branch centered on frontier life, conflict, and consequence rather than decor styling',
  },
  {
    href: '/Photography-in-Western-Art',
    label: 'Photography in Western Art',
    description: 'How photography entered the Western tradition through authorship, atmosphere, and narrative',
  },
  {
    href: '/Western-Fine-Art-Photography',
    label: 'Western Fine Art Photography',
    description: 'A deeper look at authored Western photography as fine art rather than documentary imagery',
  },
  {
    href: '/Cowboy-Photography',
    label: 'Cowboy Photography',
    description: 'Narrative cowboy portraiture and frontier character as an artistic subject',
  },
];

const {
  currentPath = '',
  heading = 'Continue the Western Art Guide',
  guideLinks = defaultGuideLinks,
} = Astro.props as {
  currentPath?: string;
  heading?: string;
  guideLinks?: GuideLink[];
};

const normalizePath = (path: string) => String(path || '').replace(/\/+$/, '').toLowerCase();
const normalizedCurrentPath = normalizePath(currentPath || Astro.url.pathname);
---

<hr class="guide-divider" />

<div class="western-guide-nav">
  <h3>{heading}</h3>
  <p class="guide-subhead">Follow the full guide path from definition to subject focus.</p>
  <nav class="western-guide-links" aria-label="Western Art Guide">
    {guideLinks.map((link, index) => {
      const isActive = normalizePath(link.href) === normalizedCurrentPath;

      return (
        <a
          href={link.href}
          class={`guide-card${isActive ? ' active' : ''}`}
          aria-current={isActive ? 'page' : undefined}
        >
          <span class="guide-card-num">{index + 1}</span>
          <h4>{link.label}</h4>
          <p>{link.description}</p>
        </a>
      );
    })}
  </nav>
</div>

<style>
  .guide-divider {
    width: min(900px, calc(100% - 2rem));
    margin: 3.25rem auto 2.5rem;
    border: 0;
    border-top: 1px solid #e3d9cf;
  }

  .western-guide-nav {
    max-width: 900px;
    margin: 0 auto 3.75rem;
    padding: 0 1rem;
    text-align: center;
  }

  .western-guide-nav h3 {
    font-family: 'Glegoo', serif;
    font-size: clamp(1.35rem, 1.9vw, 1.7rem);
    font-weight: 500;
    color: #8a6a45;
    margin: 0 0 0.45rem;
    letter-spacing: -0.005em;
  }

  .guide-subhead {
    color: #7a6a5b;
    font-size: 0.92rem;
    margin: 0 0 1.45rem;
    font-family: 'Glegoo', serif;
  }

  .western-guide-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    align-items: stretch;
  }

  .guide-card {
    position: relative;
    display: block;
    padding: 0.95rem 2.6rem 0.95rem 1rem;
    background: #faf9f7;
    border: 1px solid #e2d9cf;
    border-radius: 8px;
    text-decoration: none;
    text-align: left;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
  }

  .guide-card:hover {
    border-color: #b99b7d;
    box-shadow: 0 2px 10px rgba(139, 90, 43, 0.08);
    background: #fcfbf9;
  }

  .guide-card.active {
    background: #e9dfd4;
    border-color: #c7b19a;
    box-shadow: inset 0 0 0 1px rgba(185, 155, 125, 0.18);
  }

  .guide-card-num {
    position: absolute;
    top: 0.68rem;
    right: 0.68rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: rgba(185, 155, 125, 0.72);
    color: #fff;
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1;
  }

  .guide-card h4 {
    margin: 0 0 0.28rem;
    color: #2a2520;
    font-size: 0.94rem;
    font-weight: 600;
    font-family: 'Glegoo', serif;
    letter-spacing: -0.01em;
  }

  .guide-card p {
    margin: 0;
    color: #7b6d60;
    font-size: 0.8rem;
    line-height: 1.35;
    font-style: italic;
    font-family: 'Glegoo', serif;
  }

  @media (max-width: 720px) {
    .western-guide-links {
      grid-template-columns: 1fr;
    }
  }
</style>
