---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Landscapes-Theme-Mountains-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Theme/Mountains/Mountains.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Landscapes/By-Theme/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Landscapes/By-Theme/Mountains";
const FALLBACK_DESCRIPTION = "Explore traditional fine art mountain photography by Wayne Heim. Majestic peaks, alpine vistas, and rugged landscapes.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId || "i-k4studios"} />
</GalleryShellCore>
