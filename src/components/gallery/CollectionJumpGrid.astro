---
import { getArtworkAltForImageSource } from "@/utils/imageAltLookup";
import { extractImageId, getSemanticImageUrl } from "@/utils/imageProxy.js";

type JumpItem = {
  title?: string;
  subtitle?: string;
  thumb?: string;
  href: string;
  current?: boolean;
  focused?: boolean;
};

const {
  items,
  centerIndex = -1,
  currentTitle = "Explore the Complete Collections",
  imageContextPath = "",
} = Astro.props as {
  items: JumpItem[];
  centerIndex?: number;
  currentTitle?: string;
  imageContextPath?: string;
};

const forceImageSize = (src = "", size = "s") => {
  const value = String(src || "");
  if (!value || value.startsWith("/images/")) return value;

  const imageId = extractImageId(value);
  if (!imageId) return value;

  return getSemanticImageUrl(
    { id: imageId },
    imageContextPath ? { galleryPath: imageContextPath } : {},
    size,
  );
};
---

<section class="collection-dock" aria-labelledby="collection-dock-heading">
  <div class="dock-heading">
    <h2 id="collection-dock-heading">
      <span data-dock-active-prefix></span><span data-dock-active-title>{currentTitle}</span>
    </h2>
  </div>
  <div class="dock-shell">
    <div class="dock-track" aria-label="K4 gallery all-page quick links">
      <span class="dock-anchor" aria-hidden="true"></span>
      {items.map((item, index) => {
        const displayTitle = [item.title, item.subtitle].filter(Boolean).join(" ");
        const imageAlt = getArtworkAltForImageSource(item.thumb, displayTitle);
        const distance = centerIndex >= 0 ? Math.abs(index - centerIndex) : Number.POSITIVE_INFINITY;
        const dockClass = [
          "dock-card",
          index === centerIndex ? "is-center" : "",
          item.current ? "is-current" : "",
          item.focused ? "is-focused" : "",
          distance === 1 ? "is-near" : "",
          centerIndex >= 0 && distance >= 3 ? "is-far" : "",
        ].filter(Boolean).join(" ");

        return (
          <a
            class={dockClass}
            href={item.href}
            aria-current={item.current ? "page" : undefined}
            aria-label={item.current ? `Current collection: ${displayTitle}` : `Browse ${displayTitle}`}
            data-dock-title={displayTitle}
            data-current={item.current ? "true" : undefined}
            data-focus={item.focused ? "true" : undefined}
          >
            <div class="dock-tombstone">
              <img
                src={forceImageSize(item.thumb, "s")}
                alt={imageAlt}
                loading={item.current || item.focused || distance <= 2 ? "eager" : "lazy"}
                width="140"
                height="160"
              />
            </div>
          </a>
        );
      })}
      <span class="dock-anchor" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .collection-dock {
    position: relative;
    max-width: 1320px;
    margin: 14px auto 24px;
    padding: 14px 18px 18px;
    background: #fff;
    border-top: 1px solid #d3c3b1;
    border-bottom: 1px solid #d3c3b1;
    box-shadow: none;
    overflow: hidden;
  }
  .collection-dock::before,
  .collection-dock::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 14px;
    pointer-events: none;
  }
  .collection-dock::before {
    top: 0;
    background: linear-gradient(90deg, rgba(53, 40, 28, 0) 0%, rgba(53, 40, 28, .5) 14%, rgba(53, 40, 28, .5) 86%, rgba(53, 40, 28, 0) 100%);
    filter: blur(4px);
    transform: translateY(-62%);
  }
  .collection-dock::after {
    bottom: 0;
    background: linear-gradient(90deg, rgba(53, 40, 28, 0) 0%, rgba(53, 40, 28, .44) 14%, rgba(53, 40, 28, .44) 86%, rgba(53, 40, 28, 0) 100%);
    filter: blur(4px);
    transform: translateY(62%);
  }
  .dock-heading {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    margin-bottom: 10px;
    text-align: center;
  }
  .dock-heading h2 {
    margin: 0;
    color: #2f241b;
    font-size: 1.38rem;
    line-height: 1.35;
    min-height: 1.9em;
  }
  [data-dock-active-title] { color: #6d4d34; }
  .dock-shell { position: relative; }
  .dock-track {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 6px;
    min-height: 102px;
    padding: 4px 28px 10px;
    perspective: 900px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: #b89b78 #efe6da;
  }
  .dock-track::-webkit-scrollbar { height: 8px; }
  .dock-track::-webkit-scrollbar-track { background: #efe6da; }
  .dock-track::-webkit-scrollbar-thumb { background: #b89b78; border-radius: 999px; }
  .dock-anchor { flex: 0 0 1px; height: 1px; }
  .dock-card {
    flex: 0 0 58px;
    color: inherit;
    text-decoration: none;
    transform: translateY(5px) scale(.86);
    opacity: .82;
    transition: transform .24s ease, opacity .24s ease, filter .24s ease;
    filter: saturate(.92);
    text-align: center;
    scroll-snap-align: center;
  }
  .dock-card.is-near { flex-basis: 64px; transform: translateY(1px) scale(.94); opacity: .9; }
  .dock-card.is-center { flex-basis: 78px; transform: translateY(-3px) scale(1.04); opacity: 1; filter: saturate(1.04); z-index: 2; }
  .dock-card.is-current .dock-tombstone,
  .dock-card.is-focused .dock-tombstone { border-color: #9b7451; box-shadow: 0 18px 38px rgba(48,34,23,.2); }
  .dock-card.is-current:hover,
  .dock-card.is-current:focus-visible,
  .dock-card.is-focused:hover,
  .dock-card.is-focused:focus-visible { transform: translateY(-3px) scale(1.04); }
  .dock-card.is-current:hover,
  .dock-card.is-current:focus-visible { cursor: default; }
  .dock-card.is-far { transform: translateY(8px) scale(.8); opacity: .68; }
  .dock-card:hover,
  .dock-card:focus-visible {
    transform: translateY(-6px) scale(1.02);
    opacity: 1;
    filter: saturate(1.05);
    outline: none;
    z-index: 3;
  }
  .dock-tombstone {
    aspect-ratio: 3.5 / 4;
    position: relative;
    background: #fffdf9;
    border: 1px solid #bda27c;
    border-radius: 0% 0% 25% 25% / 0% 0% 20% 20%;
    box-shadow: inset 0 -1px 1px rgba(255,255,255,.6), inset 0 1px 2px rgba(0,0,0,.08), 0 10px 22px rgba(48,34,23,.13);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dock-tombstone img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3.5 / 4;
    object-fit: cover;
    object-position: center 15%;
    background: #efe7dc;
  }
  @media (max-width: 980px) {
    .dock-heading { display: block; }
    .collection-dock { padding-left: 0; padding-right: 0; }
    .dock-track { min-height: 0; padding: 8px 24px 18px; }
    .dock-card,
    .dock-card.is-near,
    .dock-card.is-center,
    .dock-card.is-far {
      flex: 0 0 72px;
      transform: none;
      opacity: 1;
      filter: none;
      scroll-snap-align: center;
    }
    .dock-card:hover,
    .dock-card:focus-visible { transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".collection-dock").forEach((dock) => {
    if (dock.dataset.jumpGridReady === "delegated-v2") return;
    dock.dataset.jumpGridReady = "delegated-v2";

    const titleNode = dock.querySelector<HTMLElement>("[data-dock-active-title]");
    const prefixNode = dock.querySelector<HTMLElement>("[data-dock-active-prefix]");
    const dockCards = Array.from(dock.querySelectorAll<HTMLElement>("[data-dock-title]"));
    if (!titleNode || dockCards.length === 0) return;

    const current = dockCards.find((card) => card.getAttribute("aria-current") === "page" || card.dataset.focus === "true");
    const fallbackTitle = titleNode.textContent || "";
    const setDockTitle = (value: string | null, prefix = "Browse") => {
      if (prefixNode) prefixNode.textContent = prefix ? `${prefix} ` : "";
      titleNode.textContent = value || fallbackTitle;
    };

    setDockTitle(fallbackTitle, "");
    const centerCurrentCard = () => {
      if (!current) return;
      const track = current.closest<HTMLElement>(".dock-track");
      if (!track) return;
      const targetLeft = current.offsetLeft - (track.clientWidth - current.clientWidth) / 2;
      const maxLeft = Math.max(0, track.scrollWidth - track.clientWidth);
      track.scrollLeft = Math.max(0, Math.min(targetLeft, maxLeft));
    };

    requestAnimationFrame(() => requestAnimationFrame(centerCurrentCard));
    window.addEventListener("load", centerCurrentCard, { once: true });
    window.addEventListener("resize", centerCurrentCard);

    const identifyCard = (target: EventTarget | null) => {
      if (!(target instanceof Element)) return;
      const card = target.closest<HTMLElement>("[data-dock-title]");
      if (!card || !dock.contains(card) || card.dataset.current === "true") return;
      setDockTitle(card.dataset.dockTitle || null);
    };

    dock.addEventListener("mouseover", (event) => identifyCard(event.target));
    dock.addEventListener("focusin", (event) => identifyCard(event.target));
    dock.addEventListener("mouseleave", () => setDockTitle(fallbackTitle, ""));
    dock.addEventListener("focusout", (event) => {
      if (!dock.contains(event.relatedTarget as Node | null)) setDockTitle(fallbackTitle, "");
    });
  });
</script>
