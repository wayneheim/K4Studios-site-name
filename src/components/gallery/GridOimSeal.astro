---
import registry from '@/data/contentClassificationRegistry.json';
import { isOimImage } from '@/utils/contentReview.mjs';
const { imageId, footer = false } = Astro.props;
const marked = isOimImage(imageId, null, registry);
---
{marked && (
  <span class={footer ? 'card-cta grid-oim-footer' : undefined}>
  <button class="grid-oim-seal" type="button" data-oim-seal aria-label="About OIM-1" aria-haspopup="dialog" title="About OIM-1">
    <img src="/images/OIM-1-web.webp" alt="OIM-1" width="34" height="34" loading="lazy" />
  </button>
  <span class="grid-oim-caption">This image is part of the OIM-1 collection.</span>
  </span>
)}

<style is:global>
  .ssr-card > .card-artwork-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }
  .ssr-card > .card-artwork-link:focus-visible {
    outline: 2px solid #8a3d2b;
    outline-offset: -3px;
  }
  .ssr-card > .ssr-card-link > .ssr-card-content {
    position: relative;
    z-index: 3;
    pointer-events: none;
  }
  /* Override the templates' touch rules so text taps reach the chapter link. */
  .ssr-card .ssr-card-content,
  .ssr-card .ssr-card-content * {
    pointer-events: none !important;
  }
  .ssr-card .ssr-card-content .grid-oim-seal,
  .ssr-card .ssr-card-content .grid-oim-seal * {
    pointer-events: auto !important;
  }
  .ssr-card.ssr-card .collector-note-overlay { z-index: 5; }
  .ssr-card.ssr-card .collector-notes-trigger { z-index: 6; }
  .ssr-card .card-cta:has(.grid-oim-seal) {
    position: relative;
    padding-top: 22px;
  }
  .ssr-grid .ssr-card:has(.grid-oim-seal) .ssr-card-content .story-excerpt {
    margin-bottom: 30px !important;
  }
  .ssr-card .grid-oim-seal {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 3px;
    border: 0;
    border-radius: 50%;
    background: #fffdf9;
    cursor: pointer;
    pointer-events: auto;
  }
  .ssr-card .grid-oim-seal img {
    display: block;
    width: 34px;
    height: 34px;
    max-height: none;
    object-fit: contain;
  }
  .ssr-card .grid-oim-seal:hover { background: #f1ebe3; }
  .ssr-card .grid-oim-seal:focus-visible {
    outline: 2px solid #8a3d2b;
    outline-offset: 2px;
  }
  .ssr-card:has(.grid-oim-footer) .ssr-card-content { max-height: none; }
  .grid-oim-footer {
    display: block;
    margin-top: 26px;
    border-top: 1px solid #e3d7c9;
  }
  .ssr-card .grid-oim-caption {
    position: absolute;
    top: calc(100% + 8px);
    left: -8px;
    right: -8px;
    color: #7a6047;
    font: 400 0.75rem/1.4 Arial, sans-serif;
    letter-spacing: normal;
    text-align: center;
    white-space: normal;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .ssr-card:is(:hover, :focus-within) .grid-oim-caption {
    visibility: visible;
    opacity: 1;
  }
  .ssr-grid .ssr-card:has(.grid-oim-seal):is(:hover, :focus-within) .ssr-card-content {
    padding-bottom: 56px;
  }
</style>
