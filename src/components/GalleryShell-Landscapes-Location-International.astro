---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Landscapes-Location-International.jsx";
import { galleryData as allImages } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/International/Gallery.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/landingstones.ts";

const GALLERY_PATH = "/Galleries/Painterly-Fine-Art-Photography/Landscapes/By-Location/International/Gallery";
const FALLBACK_DESCRIPTION = "Explore painterly fine art photography of landscapes from around the world by Wayne Heim.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
const shouldSsrChapterViewer = Boolean(initialImageId && initialImageId !== "i-k4studios") || Astro.url.searchParams.get("view") === "grid";
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  {shouldSsrChapterViewer ? (
    <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId} />
  ) : (
    <ChapterViewer slot="chapter-viewer" client:only="react" initialImageId={initialImageId} />
  )}
</GalleryShellCore>
