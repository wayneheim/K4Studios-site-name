---
/**
 * GalleryShellCore.astro
 * 
 * Shared core for all GalleryShell components.
 * Wrappers pass gallery-specific data as props and ChapterViewer via named slot.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import GalleryHeader from "@/components/Gallery-LandingHeader.jsx";
import GalleryInfo from "@/components/GalleryInfo.jsx";
import Footer from "@/components/Footer.astro";
import { buildImageSeoTitle } from "@/utils/buildImageSeoTitle";
import "@/styles/gallery-shell-core.css";

import { getStructuredData } from "@/components/utils/getStructuredData.ts";
import { getBreadcrumbList } from "@/components/utils/getStructuredData.ts";
import { getCollectionContextEntry } from "@/data/semantic/collectionContext";

interface Props {
  allImages: any[];
  landingData: any;
  galleryPath: string;
  baseFallbackDescription: string;
  breadcrumb?: any;
  entranceData?: any;
  initialImageId?: string;
}

const {
  allImages,
  landingData,
  galleryPath,
  baseFallbackDescription,
  breadcrumb,
  entranceData = {},
  initialImageId
} = Astro.props;

/** ----------------------------------------------------------------
 * Robust mojibake cleaner
 * ---------------------------------------------------------------- */
function fixMojibake(str = "") {
  return String(str)
    .replace(/â€™/g, "’")
    .replace(/â€œ/g, "“")
    .replace(/â€�/g, "”")
    .replace(/â€“/g, "–")
    .replace(/â€”/g, "—")
    .replace(/â€¦/g, "…")
    .replace(/Ã©/g, "é")
    .replace(/Ã¨/g, "è")
    .replace(/Ãª/g, "ê")
    .replace(/Ã´/g, "ô")
    .replace(/Ã¶/g, "ö")
    .replace(/Ã¼/g, "ü")
    .replace(/ÃŸ/g, "ß")
    .replace(/Ã /g, "à")
    .replace(/Â©/g, "©")
    .replace(/â„¢/g, "™")
    .replace(/â€˜/g, "‘")
    .replace(/â€¢/g, "•")
    .replace(/Â/g, "");
}

function isNavigableImage(img: any) {
  const visibility = String(img?.visibility || "").toLowerCase().trim();
  return Boolean(img?.id) && visibility !== "ghost" && visibility !== "hidden" && visibility !== "hide";
}

/** ---------------------------------------------------------------
 * Image context
 * --------------------------------------------------------------- */
const isGhost = !initialImageId || initialImageId === "i-k4studios";
const navigableImages = allImages.filter(isNavigableImage);
const currentImage = isGhost
  ? null
  : navigableImages.find((img) => img.id === initialImageId);

const previewImages = navigableImages.slice(0, 8);
const previewPath = galleryPath;

const singlePreviewImage =
  previewImages.length > 0
    ? previewImages[0]
    : null;

const currentIndex = navigableImages.findIndex((img) => img.id === initialImageId);
const forcedImage = currentIndex >= 0 ? navigableImages[currentIndex] : singlePreviewImage;
const selectedImage = currentImage || forcedImage;

const usedEntranceData = {
  ...entranceData,
  image: selectedImage
    ? {
        id: selectedImage.id,
        alt: entranceData?.image?.alt || selectedImage.alt || selectedImage.title,
        caption: entranceData?.image?.caption,
      }
    : entranceData?.image,
  breadcrumb: entranceData?.breadcrumb || breadcrumb,
  title: entranceData?.title || landingData?.title || "Gallery",
  subtitle: entranceData?.subtitle || landingData?.subtitle || "",
  description: entranceData?.description || landingData?.description || "",
};

/** ---------------------------------------------------------------
 * SITE / URL helpers
 * --------------------------------------------------------------- */
const siteBase = import.meta.env.SITE || "https://www.k4studios.com";
const pathOnly = Astro.url.pathname;
const lastSegment = pathOnly.split("/").pop() || "";
const isImagePage = lastSegment.startsWith("i-");
// Include theme param in canonical if present (themes are indexable)
const themeParam = Astro.url.searchParams.get("theme");
const canonicalPath = isImagePage ? `${previewPath}/${lastSegment}` : previewPath;
const canonicalUrl = `${siteBase}${canonicalPath.replace(/\/$/, "")}${themeParam ? `?theme=${themeParam}` : ""}`;
const galleryAbsUrl = `${siteBase}${previewPath}`;
const collectionContextEntry = getCollectionContextEntry(previewPath);
const collectionContextUrl = collectionContextEntry?.collectionUrl
  ? `${siteBase}${collectionContextEntry.collectionUrl}`
  : undefined;

/** ---------------------------------------------------------------
 * Detect if this is an image page or shared theme link
 * (moved early — needed for breadcrumb + structured data decisions)
 * --------------------------------------------------------------- */
const isCivilWarGallery = galleryPath.includes('/Civil-War-Portraits');
// Check for ?view=grid (shared theme links should skip intro)
const isDirectGridView = Astro.url.searchParams.get("view") === "grid";
const skipIntro = isImagePage || isDirectGridView;

/** ---------------------------------------------------------------
 * Structured data
 * --------------------------------------------------------------- */
const imageStructuredData = currentImage
  ? getStructuredData({
      type: "image",
      data: {
        ...currentImage,
        pageUrl: canonicalUrl,
        galleryUrl: galleryAbsUrl,
        galleryTitle: galleryPath
          .split("/")
          .filter(Boolean)
          .slice(-2)
          .map((s) => s.replace(/-/g, " "))
          .join(" – "),
        collectionContext: collectionContextEntry
          ? {
              seriesName: collectionContextEntry.seriesName,
              collectionUrl: collectionContextUrl,
            }
          : undefined,
      },
    })
  : getStructuredData({
      type: "gallery",
      data: {
        title: fixMojibake(usedEntranceData.title),
        description: fixMojibake(usedEntranceData.description) || fixMojibake(usedEntranceData.subtitle),
        url: galleryAbsUrl,
      },
      images: previewImages,
    });

/** ---------------------------------------------------------------
 * Breadcrumb JSON-LD (image pages only)
 * Derives hierarchy from galleryPath segments so Bing can
 * place each image page within the site structure.
 * --------------------------------------------------------------- */
function buildBreadcrumbItems(galleryPath: string, imageTitle: string | undefined, pageUrl: string) {
  const items: Array<{ name: string; item: string }> = [
    { name: "Home", item: "https://www.k4studios.com/" },
  ];
  // Split galleryPath into segments, e.g. /Galleries/Painterly-.../Facing-.../Western-.../Color
  const segments = galleryPath.replace(/^\//, "").split("/");
  let accumulated = "";
  for (const seg of segments) {
    accumulated += "/" + seg;
    // Human-readable: replace hyphens with spaces
    const label = seg.replace(/-/g, " ");
    items.push({ name: label, item: `https://www.k4studios.com${accumulated}` });
  }
  // Add the current image page as the last breadcrumb
  if (imageTitle) {
    items.push({ name: imageTitle, item: pageUrl });
  }
  return items;
}

const breadcrumbsJSON = isImagePage && currentImage
  ? getBreadcrumbList(buildBreadcrumbItems(galleryPath, fixMojibake(currentImage.title), canonicalUrl))
  : undefined;

/** ---------------------------------------------------------------
 * Page Title & Descriptions
 * --------------------------------------------------------------- */
const siteName = "Wayne Heim";
const siteSuffix = "Fine Art Photography";
const fallbackTitle = "Gallery | Wayne Heim Fine Art Photography";

function isGenericImageTitle(value = "") {
  const normalized = String(value || "").trim().toLowerCase();
  return !normalized || /^(untitled|image|photo|no\s*title)$/i.test(normalized);
}

function appendSiteTitle(title: string) {
  if (!title) return fallbackTitle;
  const lower = title.toLowerCase();
  if (lower.includes(siteName.toLowerCase())) return title;
  if (lower.includes(siteSuffix.toLowerCase())) return title;
  return `${title} | ${siteName} ${siteSuffix}`;
}

const pageTitle = currentImage
  ? appendSiteTitle(
      buildImageSeoTitle(
        {
          title: fixMojibake(currentImage.title),
          alt: fixMojibake(currentImage.alt),
          description: fixMojibake(currentImage.description),
          story: fixMojibake(currentImage.story),
        },
        {
          galleryPath,
          galleryTitle: fixMojibake(usedEntranceData.title),
        }
      ) ||
      fixMojibake(
        !isGenericImageTitle(currentImage.title)
          ? currentImage.title
          : !isGenericImageTitle(currentImage.alt)
          ? currentImage.alt
          : `${currentImage.id || "Image"}`
      )
    )
  : appendSiteTitle(fixMojibake(usedEntranceData.title));

const pageDescription =
  isImagePage
    ? (currentImage?.description && fixMojibake(currentImage.description)) ||
      (currentImage?.story && fixMojibake(currentImage.story)) ||
      (currentImage?.alt && fixMojibake(currentImage.alt)) ||
      baseFallbackDescription
    : (usedEntranceData?.description && fixMojibake(usedEntranceData.description)) ||
      (usedEntranceData?.subtitle && fixMojibake(usedEntranceData.subtitle)) ||
      baseFallbackDescription;

/** ---------------------------------------------------------------
 * OG / Twitter
 * --------------------------------------------------------------- */
const ogImage = selectedImage?.id ? `${siteBase}/img/${selectedImage.id}/l.jpg` : selectedImage?.src;
const ogAlt = selectedImage?.alt || selectedImage?.title || fixMojibake(usedEntranceData.title);

const meta = {
  canonicalUrl,
  description: pageDescription,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogImage: ogImage,
  ogType: currentImage ? "article" : "website",
  ogUrl: canonicalUrl,
  ogImageAlt: ogAlt,
  twitterTitle: pageTitle,
  twitterDescription: pageDescription,
  twitterImage: ogImage,
  twitterUrl: canonicalUrl,
  twitterImageAlt: ogAlt,
};

---

<BaseLayout title={pageTitle} meta={meta} structuredDataJSON={imageStructuredData} breadcrumbsJSON={breadcrumbsJSON}>
  <div id="gallery-content" class="flex-grow relative">
    {/* Header */}
    {!skipIntro && (
      <div id="header-section" class="section-visible" style="z-index: 10; position: relative;">
        <GalleryHeader client:load breadcrumb={breadcrumb} />
      </div>
    )}

    <div class="h-0 md:h-5"></div>

    {/* Intro */}
    {!skipIntro && (
      <div id="intro-section" class="section-visible" style="z-index: 1; position: relative; min-height: 600px;">
        <h1 class="gallery-landing-title">{fixMojibake(usedEntranceData.title)}</h1>
        {usedEntranceData.subtitle && (
          <h2 class="gallery-landing-subtitle">{fixMojibake(usedEntranceData.subtitle)}</h2>
        )}
        <GalleryInfo 
          client:load 
          galleryKey={galleryPath}
          entranceData={{
            ...usedEntranceData,
            title: fixMojibake(usedEntranceData.title),
            subtitle: fixMojibake(usedEntranceData.subtitle),
            image: usedEntranceData.image
          }} 
        />
      </div>
    )}

    {/* Chapter Viewer - ALWAYS rendered (may be hidden) so client-side theme logic can show it */}
    <div 
      id="chapter-section" 
      class={skipIntro ? "section-visible" : "section-hidden"} 
      style={skipIntro ? "display: block;" : "display: none;"}
    >
      <slot name="chapter-viewer" />
    </div>
  </div>

  <div class="h-12 md:h-20"></div>

  {/* ImageDetailsWidget removed - "More about this image" now in ChapterGalleryBase */}

  <Footer
    previewImages={previewImages}
    previewPath={previewPath}
    currentImageUrl={selectedImage?.id ? `${siteBase}/img/${selectedImage.id}/xl.jpg` : undefined}
    title={pageTitle}
    allImages={allImages}
    galleryTitle={fixMojibake(usedEntranceData.title)}
  />

  {!isImagePage && (
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const exploreButton = document.querySelector('.explore-button');
        const header = document.getElementById('header-section');
        const intro = document.getElementById('intro-section');
        const chapter = document.getElementById('chapter-section');
        const navToggle = document.getElementById('nav-toggle');
        let isMenuOpen = false;

        // 🔧 HYDRATION FIX: Auto-enter grid view if theme or view=grid param is in URL
        const params = new URLSearchParams(window.location.search);
        const hasTheme = params.has('theme');
        const hasViewGrid = params.get('view') === 'grid';
        
        if (hasTheme || hasViewGrid) {
          // Hide landing sections, show chapter section immediately
          header?.classList.add('section-hidden');
          header && (header.style.display = 'none');
          intro?.classList.add('section-hidden');
          intro && (intro.style.display = 'none');
          if (chapter) {
            chapter.style.display = 'block';
            chapter.classList.remove('section-hidden');
            chapter.classList.add('section-visible');
          }
          if (window.innerWidth >= 768) {
            document.getElementById('nav-toggle')?.classList.remove('hidden');
          }
        }

        exploreButton?.addEventListener('click', () => {
          window.dispatchEvent(new Event('enterChapters'));
          header?.classList.add('section-hidden');
          intro?.classList.add('section-hidden');
          if (chapter) {
            chapter.style.display = 'block';
            setTimeout(() => {
              chapter.classList.remove('section-hidden');
              chapter.classList.add('section-visible');
            }, 50);
          }
          if (window.innerWidth >= 768) {
            document.getElementById('nav-toggle')?.classList.remove('hidden');
          }
        });

        navToggle?.addEventListener('click', () => {
          isMenuOpen = !isMenuOpen;
          const label = document.getElementById('menu-label');
          if (label) label.textContent = isMenuOpen ? "M−" : "M+";
          document.getElementById('floating-header')?.classList.toggle('show');
        });
      });

      document.addEventListener('contextmenu', e => {
        const target = e.target as HTMLElement | null;
        if (target?.tagName === 'IMG') {
          e.preventDefault();
        }
      });
    </script>
  )}
</BaseLayout>
