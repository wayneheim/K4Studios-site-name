---
import { getSemanticImageUrl } from "@/utils/imageProxy.js";

const {
  id,
  galleryPath,
  alt,
  caption,
  href,
  label,
  eyebrow = "From the Collection",
  align = "left",
} = Astro.props as {
  id: string;
  galleryPath: string;
  alt: string;
  caption: string;
  href: string;
  label: string;
  eyebrow?: string;
  align?: "left" | "right";
};

const pieceHref = `${galleryPath}/${id}`;
---

<aside class={`cornerstone-door cornerstone-door--${align}`}>
  <a class="cornerstone-door__image" href={pieceHref} aria-label={`Open artwork: ${alt}`}>
    <img src={getSemanticImageUrl({ id }, { galleryPath }, "l")} alt={alt} loading="lazy" />
  </a>
  <div class="cornerstone-door__copy">
    <span>{eyebrow}</span>
    <p>{caption}</p>
    <a class="cornerstone-door__collection" href={href}>{label} <span aria-hidden="true">→</span></a>
  </div>
</aside>

<style>
  .cornerstone-door {
    clear:both;
    float:none;
    width:min(100%,420px);
    margin:1.35rem 0 1.75rem;
    padding:.7rem;
    border:1px solid rgba(121,98,78,.16);
    border-radius:14px;
    background:#faf7f3;
    box-shadow:0 10px 24px rgba(52,38,26,.08);
  }
  .cornerstone-door--left { margin-right:auto; }
  .cornerstone-door--right { margin-right:0; margin-left:auto; }
  .cornerstone-door__image { display:block; overflow:hidden; border-radius:10px; background:#eee5da; }
  .cornerstone-door__image img { display:block; width:100%; height:auto; max-height:390px; object-fit:cover; object-position:top center; transition:transform .4s ease; }
  .cornerstone-door__image:hover img { transform:scale(1.025); }
  .cornerstone-door__copy { padding:.7rem .25rem .2rem; }
  .cornerstone-door__copy > span { display:block; margin-bottom:.3rem; color:#8b5a2b; font-size:.68rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  .cornerstone-door__copy p { margin:0 0 .45rem; color:#504238; font-size:.82rem; font-style:italic; line-height:1.45; }
  .cornerstone-door__collection { color:#6d4225; font-size:.78rem; font-weight:700; text-decoration:none; }
  .cornerstone-door__collection:hover { color:#8b1a1a; }
  @media (max-width:700px) {
    .cornerstone-door,
    .cornerstone-door--right { width:100%; max-width:420px; margin:1.35rem auto 1.65rem; }
    .cornerstone-door__image img { max-height:none; }
  }
</style>
