---
import { getSemanticImageUrl } from "@/utils/imageProxy.js";

type BridgeItem = {
  id: string;
  galleryPath: string;
  href?: string;
  alt: string;
  caption: string;
};

const {
  kicker = "See the Work",
  title,
  intro = "",
  items,
  ctaHref,
  ctaLabel,
} = Astro.props as {
  kicker?: string;
  title: string;
  intro?: string;
  items: BridgeItem[];
  ctaHref: string;
  ctaLabel: string;
};
---

<section class="cornerstone-bridge" aria-label={title}>
  <div class="cornerstone-bridge__shell">
    <p class="cornerstone-bridge__kicker">{kicker}</p>
    <h2>{title}</h2>
    {intro && <p class="cornerstone-bridge__intro">{intro}</p>}
    <div class="cornerstone-bridge__grid">
      {items.slice(0, 3).map((item, index) => (
        <figure>
          <a href={item.href || `${item.galleryPath}/${item.id}`}>
            <img
              src={getSemanticImageUrl({ id: item.id }, { galleryPath: item.galleryPath }, "l")}
              alt={item.alt}
              loading={index === 0 ? "eager" : "lazy"}
            />
          </a>
          <figcaption>{item.caption}</figcaption>
        </figure>
      ))}
    </div>
    <a class="cornerstone-bridge__cta" href={ctaHref}>{ctaLabel}</a>
  </div>
</section>

<style>
  .cornerstone-bridge { width:100%; margin:0 auto 2rem; padding:0 1rem; }
  .cornerstone-bridge__shell {
    max-width:920px;
    margin:0 auto;
    padding:1.3rem 1.4rem 1.45rem;
    border:1px solid rgba(121,98,78,.16);
    border-radius:18px;
    background:linear-gradient(145deg,rgba(250,248,245,.98),rgba(245,239,232,.96));
    box-shadow:0 14px 34px rgba(52,38,26,.07);
    text-align:center;
  }
  .cornerstone-bridge__kicker {
    margin:0 0 .45rem;
    color:#8b5a2b;
    font-size:.76rem;
    font-weight:700;
    letter-spacing:.12em;
    text-transform:uppercase;
  }
  .cornerstone-bridge h2 { max-width:52rem; margin:0 auto .65rem; color:#241b15; font-size:clamp(1.2rem,2.4vw,1.65rem); line-height:1.3; }
  .cornerstone-bridge__intro { max-width:52rem; margin:0 auto 1rem; color:#4a3d34; font-size:.96rem; line-height:1.6; }
  .cornerstone-bridge__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.85rem; max-width:850px; margin:1.1rem auto 1rem; }
  .cornerstone-bridge figure { min-width:0; margin:0; }
  .cornerstone-bridge figure a { display:block; aspect-ratio:3/4; overflow:hidden; border:1px solid rgba(121,98,78,.14); border-radius:12px; background:#efe7dc; box-shadow:0 8px 18px rgba(41,30,21,.06); }
  .cornerstone-bridge img { display:block; width:100%; height:100%; object-fit:cover; object-position:top center; transition:transform .45s ease; }
  .cornerstone-bridge a:hover img { transform:scale(1.035); }
  .cornerstone-bridge figcaption { margin-top:.5rem; color:#6a5a4c; font-size:.78rem; font-style:italic; line-height:1.35; }
  .cornerstone-bridge__cta { display:inline-block; margin-top:.3rem; padding-bottom:.1rem; border-bottom:1px solid rgba(123,74,40,.35); color:#7b4a28; font-size:.92rem; font-weight:700; text-decoration:none; }
  .cornerstone-bridge__cta:hover { color:#5f381e; border-bottom-color:rgba(95,56,30,.55); }
  @media (max-width:680px) {
    .cornerstone-bridge { padding:0 .75rem; }
    .cornerstone-bridge__shell { padding:1rem .85rem 1.15rem; border-radius:14px; }
    .cornerstone-bridge__grid { grid-template-columns:1fr; max-width:360px; }
  }
</style>
