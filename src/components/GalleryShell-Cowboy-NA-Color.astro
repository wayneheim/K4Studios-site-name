---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GalleryHeader from "@/components/Gallery-LandingHeader.jsx";
import GalleryInfo from "@/components/GalleryInfo.jsx";
import ChapterViewer from "@/components/Chapter-Cowboy-NA-Color.jsx";
import Footer from "@/components/Footer.astro";

import { galleryData as allImages } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/NA-Color.mjs";
import { landingWestern } from "@/data/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/landingstones.ts";
import { getStructuredData } from "@/components/utils/getStructuredData.ts";

/** Dynamic routes for each image (/i-xxxxx) */
export async function getStaticPaths() {
  return allImages
    .filter((img) => img.visibility !== "ghost")
    .map((img) => ({ params: { id: img.id } }));
}

function fixMojibake(str = "") {
  return String(str)
    .replace(/â€™/g, "’")
    .replace(/â€œ/g, "“")
    .replace(/â€�/g, "”")
    .replace(/â€“/g, "–")
    .replace(/â€”/g, "—")
    .replace(/â€¦/g, "…")
    .replace(/Ã©/g, "é")
    .replace(/Ã¨/g, "è")
    .replace(/Ãª/g, "ê")
    .replace(/Ã´/g, "ô")
    .replace(/Ã¶/g, "ö")
    .replace(/Ã¼/g, "ü")
  .replace(/ÃŸ/g, "ß")
    .replace(/Ã /g, "à")
    .replace(/Â©/g, "©")
    .replace(/â„¢/g, "™")
    .replace(/â€˜/g, "‘")
    .replace(/â€¢/g, "•")
    .replace(/Â/g, "");
}

const { breadcrumb, entranceData = {} } = Astro.props;
const { id } = Astro.params;
const initialImageId = id || Astro.props.initialImageId;

const isGhost = !initialImageId || initialImageId === "i-k4studios";
const currentImage = isGhost
  ? null
  : allImages.find((img) => img.id === initialImageId && img.visibility !== "ghost");

const previewImages = allImages.filter((img) => img.visibility !== "ghost").slice(0, 8);
const previewPath =
  "/Galleries/Painterly-Fine-Art-Photography/Facing-History/Western-Cowboy-Portraits/NA-Color";

const singlePreviewImage =
  previewImages.length > 0
    ? previewImages[Math.floor(Math.random() * previewImages.length)]
    : null;

const currentIndex = allImages.findIndex(
  (img) => img.id === initialImageId && img.visibility !== "ghost"
);
const forcedImage = currentIndex >= 0 ? allImages[currentIndex] : singlePreviewImage;
const selectedImage = currentImage || forcedImage;

const usedEntranceData = {
  ...entranceData,
  image: selectedImage
    ? {
        src: selectedImage.src,
        alt: selectedImage.alt || selectedImage.title || entranceData?.image?.alt,
        caption: selectedImage.title || entranceData?.image?.caption,
      }
    : entranceData?.image,
  breadcrumb: entranceData?.breadcrumb || breadcrumb,
  title: entranceData?.title || landingWestern?.title || "Gallery",
  subtitle: entranceData?.subtitle || landingWestern?.subtitle || "",
  description: entranceData?.description || landingWestern?.description || "",
};

const pathOnly = Astro.url.pathname.replace(/\/$/, "");
const origin = (Astro.url && typeof Astro.url.origin === "string" && Astro.url.origin !== "null")
  ? Astro.url.origin
  : "";
const canonicalUrl = origin ? `${origin}${pathOnly}` : undefined;
const galleryAbsUrl = origin ? `${origin}${previewPath}` : previewPath;

const imageStructuredData = currentImage
  ? getStructuredData({ type: "image", data: currentImage })
  : getStructuredData({
      type: "gallery",
      data: {
        title: fixMojibake(usedEntranceData.title),
        description:
          fixMojibake(usedEntranceData.description) ||
          fixMojibake(usedEntranceData.subtitle),
        url: galleryAbsUrl,
      },
      images: previewImages,
    });

const siteName = "Wayne Heim";
const siteSuffix = "Fine Art Photography";
const fallbackTitle = "Gallery | Wayne Heim Fine Art Photography";

function appendSiteTitle(title) {
  if (!title) return fallbackTitle;
  const lower = title.toLowerCase();
  if (lower.includes(siteName.toLowerCase())) return title;
  if (lower.includes(siteSuffix.toLowerCase())) return title;
  return `${title} | ${siteName} ${siteSuffix}`;
}

const pageTitle = currentImage
  ? (currentImage.title === "Untitled"
      ? appendSiteTitle("Untitled — Fine Art Photography")
      : appendSiteTitle(fixMojibake(currentImage.title)))
  : appendSiteTitle(fixMojibake(usedEntranceData.title));

const baseFallbackDescription =
  "Explore Native American portraits and painterly Western cowboy art in color by Wayne Heim.";

const pageDescription =
  (currentImage?.description && fixMojibake(currentImage.description)) ||
  (usedEntranceData?.description && fixMojibake(usedEntranceData.description)) ||
  (usedEntranceData?.subtitle && fixMojibake(usedEntranceData.subtitle)) ||
  baseFallbackDescription;

/** Debug log for build */
console.log("Selected Image for OG/Twitter:", {
  id: selectedImage?.id,
  src: selectedImage?.src,
  title: selectedImage?.title,
  alt: selectedImage?.alt,
  width: selectedImage?.width,
  height: selectedImage?.height,
  isImagePage: !!currentImage
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  meta={{
    ogTitle: pageTitle,
    ogDescription: pageDescription,
    ogImage: selectedImage?.src,
    ogType: !!currentImage ? "article" : "website",
    twitterTitle: pageTitle,
    twitterDescription: pageDescription,
    twitterImage: selectedImage?.src,
    twitterCard: selectedImage?.src ? "summary_large_image" : "summary",
    canonicalUrl: canonicalUrl,
  }}
  preloadImage={
    selectedImage
      ? {
          src: selectedImage.src,
          alt: selectedImage.alt,
          title: selectedImage.title,
          description: selectedImage.description,
          story: selectedImage.story,
          width: selectedImage.width,
          height: selectedImage.height
        }
      : null
  }
  isImagePage={!!currentImage}
  structuredDataJSON={imageStructuredData}
>
  <div id="gallery-content" class="flex-grow relative overflow-hidden">
    <!-- Header -->
    <div id="header-section" class="section-visible" style="z-index:10;position:relative;">
      <GalleryHeader client:load breadcrumb={breadcrumb} />
    </div>

    <div class="h-0 md:h-5"></div>

    <!-- Intro -->
    <div id="intro-section" class="section-visible" style="z-index:1;position:relative;">
      <h1 class="gallery-landing-title">{fixMojibake(usedEntranceData.title)}</h1>
      {usedEntranceData.subtitle && (
        <h2 class="gallery-landing-subtitle">{fixMojibake(usedEntranceData.subtitle)}</h2>
      )}
      <GalleryInfo
        client:load
        entranceData={{
          ...usedEntranceData,
          title: fixMojibake(usedEntranceData.title),
          subtitle: fixMojibake(usedEntranceData.subtitle),
          image: usedEntranceData.image
        }}
      />
    </div>

    <!-- Chapter Viewer -->
    <div id="chapter-section" class="section-hidden" style="display:none;">
      <ChapterViewer client:load initialImageId={initialImageId || "i-k4studios"} />
    </div>
  </div>

  <div class="h-12 md:h-20"></div>

  <Footer
    previewImages={previewImages}
    previewPath={previewPath}
    currentImageUrl={selectedImage ? (selectedImage.src.startsWith('http') ? selectedImage.src : `${origin || 'https://k4studios.com'}${selectedImage.src.startsWith('/') ? selectedImage.src : '/' + selectedImage.src}`) : undefined}
    title={pageTitle}
  />

  <style>
    @media (max-width: 767px) {
      #nav-toggle {
        display: none !important;
      }
      #intro-section {
        margin-top: 3.5rem !important;
      }
      .gallery-landing-title,
      .gallery-landing-subtitle {
        margin-left: 2.1rem !important;
        margin-right: 2.1rem !important;
      }
      .gallery-landing-subtitle {
        text-align: center;
      }
    }
    .hamburger-circle {
      display: none !important;
    }
    .section-hidden {
      display: none !important;
      opacity: 0;
      transform: translateX(100%);
      transition: opacity 2s ease, transform 1.2s ease;
      pointer-events: none;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 0;
      z-index: 0;
    }
    .section-visible {
      opacity: 1;
      transform: translateX(0);
      transition: opacity 1s ease, transform 1.2s ease;
      pointer-events: auto;
      position: relative;
      width: 100%;
      z-index: 2;
    }
    #gallery-content *,
    .gallery-landing-title,
    .gallery-landing-subtitle,
    #gallery-content h3,
    #gallery-content p,
    #gallery-content a {
      font-family: 'Glegoo', serif !important;
      color: #2c2c2c !important;
      line-height: 1.5 !important;
    }
    .gallery-landing-title {
      font-size: 1.1rem !important;
      font-weight: 700 !important;
      margin-top: 2em !important;
      margin-left: 5.5em;
      margin-bottom: 0.3em !important;
      letter-spacing: 0.01em;
      line-height: 1.12;
    }
    .gallery-landing-subtitle {
      font-size: 0.95rem !important;
      font-weight: 500 !important;
      margin-left: 6.5em;
      margin-bottom: 0.5em;
      letter-spacing: 0.01em;
      line-height: 1.15;
    }
    #gallery-content p {
      font-size: 1rem !important;
      margin-bottom: 1em !important;
    }
    #gallery-content a {
      text-decoration: underline !important;
      color: #85644b !important;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const exploreButton = document.querySelector(".explore-button");
      const header = document.getElementById("header-section");
      const intro = document.getElementById("intro-section");
      const chapter = document.getElementById("chapter-section");
      const navToggle = document.getElementById("nav-toggle");
      let isMenuOpen = false;

      const deepLinkMatch = window.location.pathname.match(/\/(i-[a-zA-Z0-9_-]+)$/);
      if (deepLinkMatch && deepLinkMatch[1] !== "i-k4studios") {
        setTimeout(() => exploreButton?.click(), 50);
      }

      exploreButton?.addEventListener("click", () => {
        header.classList.add("section-hidden");
        intro.classList.add("section-hidden");
        chapter.style.display = "block";
        setTimeout(() => {
          chapter.classList.remove("section-hidden");
          chapter.classList.add("section-visible");
        }, 50);
        if (window.innerWidth >= 768) {
          document.getElementById("nav-toggle")?.classList.remove("hidden");
        }
      });

      navToggle?.addEventListener("click", () => {
        isMenuOpen = !isMenuOpen;
        const label = document.getElementById("menu-label");
        if (label) label.textContent = isMenuOpen ? "M−" : "M+";
        document.getElementById("floating-header")?.classList.toggle("show");
      });
    });

    document.addEventListener("contextmenu", (e) => {
      if (e.target.tagName === "IMG") e.preventDefault();
    });
  </script>
</BaseLayout>
