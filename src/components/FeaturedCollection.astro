---
/**
 * FeaturedCollection.astro
 * 
 * Reusable "featured collection" callout widget with embedded structured data.
 * Use this to highlight a specific collection (e.g., Western Cowboy Portraits)
 * and give visitors a fast lane to that section.
 * 
 * Structured data uses CollectionPage schema for Google rich results.
 */
import { getSemanticImageSrcset, getSemanticImageUrl } from '@/utils/imageProxy.js';

interface Props {
  /** The featured image to display */
  image: {
    src: string;
    srcS?: string;
    srcM?: string;
    srcL?: string;
    src2?: string;
    src3?: string;
    alt: string;
    id?: string;
    width?: number;
    height?: number;
    fit?: 'cover' | 'contain';
  };
  /** Collection title displayed prominently */
  title: string;
  /** Short description/subtitle */
  subtitle?: string;
  /** CTA button text */
  ctaText?: string;
  /** CTA link destination */
  ctaLink: string;
  /** Collection name for structured data */
  collectionName: string;
  /** Number of items in collection (for schema) */
  itemCount?: number;
  /** Optional: hide on mobile */
  hideOnMobile?: boolean;
  /** Optional: custom tracking ID for analytics */
  trackingId?: string;
  /** Optional: analytics event name for CTA clicks */
  trackingEvent?: string;
  /** Optional: append arrow to CTA label */
  appendArrow?: boolean;
  /** Optional: emit CollectionPage JSON-LD for this featured destination */
  emitStructuredData?: boolean;
}

const {
  image,
  title,
  subtitle = "Painterly Fine Art Photography",
  ctaText = "Enter the Frontier",
  ctaLink,
  collectionName,
  itemCount,
  hideOnMobile = false,
  trackingId,
  trackingEvent = 'cowboy_jump',
  appendArrow = true,
  emitStructuredData = true
} = Astro.props;

// Use trackingId if provided, otherwise fall back to collectionName
const analyticsLabel = trackingId || collectionName;
const analyticsEndpoint = 'https://edge.k4studios.com/__k4e';
const pixelEndpoint = 'https://edge.k4studios.com/_state';
const siteOrigin = 'https://www.k4studios.com';

const toAbsoluteUrl = (value: string) => {
  if (!value) return siteOrigin;
  if (value.startsWith('http://') || value.startsWith('https://')) return value;
  const normalized = value.startsWith('/') ? value : `/${value}`;
  return new URL(normalized, siteOrigin).toString();
};

const encodeLocalAssetUrl = (value?: string) => {
  if (!value) return '';
  if (value.startsWith('http://') || value.startsWith('https://')) return value;
  return encodeURI(value);
};

const hasProxyImage = Boolean(image.id);
const imageContext = { galleryPath: ctaLink };

// Use proxy URLs for gallery images and pass through local/static assets unchanged.
const displaySrc = hasProxyImage
  ? getSemanticImageUrl(image, imageContext, 'm')
  : encodeLocalAssetUrl(image.srcM || image.src);
const srcsetValue = hasProxyImage
  ? getSemanticImageSrcset(image, imageContext)
  : [
      image.srcS ? `${encodeLocalAssetUrl(image.srcS)} 400w` : '',
      (image.srcM || image.src) ? `${encodeLocalAssetUrl(image.srcM || image.src)} 600w` : '',
      (image.srcL || image.src) ? `${encodeLocalAssetUrl(image.srcL || image.src)} 1024w` : ''
    ].filter(Boolean).join(', ');
const fullUrl = toAbsoluteUrl(ctaLink);
// Capped at 'l' to protect XL from bot discovery via structured data.
const structuredImageUrl = hasProxyImage
  ? toAbsoluteUrl(getSemanticImageUrl(image, imageContext))
  : toAbsoluteUrl(image.srcL || image.srcM || image.src);
const acquireLicensePage = 'https://www.k4studios.com/licensing';
const ctaLabel = appendArrow ? `${ctaText} →` : ctaText;

// Build structured data for this featured collection
// Uses proxied gallery URLs when available and falls back to local/static assets for branded cards.
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": collectionName,
  "description": subtitle,
  "url": fullUrl,
  "creator": {
    "@type": "Person",
    "name": "Wayne Heim",
    "url": "https://www.k4studios.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "K4 Studios",
    "url": "https://www.k4studios.com"
  },
  "image": {
    "@type": "ImageObject",
    "url": structuredImageUrl,
    "name": title,
    "description": image.alt,
    "creditText": "Wayne Heim",
    "copyrightNotice": "© Wayne Heim",
    "license": "https://www.k4studios.com/copyright",
    "acquireLicensePage": acquireLicensePage,
    "creator": {
      "@type": "Person",
      "name": "Wayne Heim",
      "url": "https://www.k4studios.com/"
    },
    "copyrightHolder": {
      "@type": "Person",
      "name": "Wayne Heim",
      "url": "https://www.k4studios.com/"
    }
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": collectionName,
    "numberOfItems": itemCount,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "url": fullUrl,
        "name": title,
        "image": structuredImageUrl
      }
    ]
  }
});
---

<aside 
  class:list={["featured-collection-widget", { "hide-mobile": hideOnMobile }]}
  aria-label={`Featured: ${collectionName}`}
>
  {emitStructuredData && (
    <script type="application/ld+json" set:html={structuredData} />
  )}
  
  <a href={ctaLink} class="fc-link" aria-label={`${ctaText} – ${collectionName}`}>
    <div class:list={["fc-mat", { "fc-mat--contain": image.fit === 'contain' }]}>
      <div class:list={["fc-image-wrap", { "fc-image-wrap--contain": image.fit === 'contain' }]}>
        <div class="fc-image-stack" data-hover-phase="base" data-hover-src={image.src2 || ''} data-hover-gif={image.src3 || ''}>
          <img 
            src={displaySrc}
            srcset={srcsetValue || undefined}
            sizes="(max-width: 768px) 100vw, 320px"
            alt={image.alt}
            width={image.width || 600}
            height={image.height || 400}
            class:list={["fc-image", "fc-image--base", { "fc-image--contain": image.fit === 'contain' }]}
            loading="lazy"
            decoding="async"
          />
          {image.src2 && (
            <img
              src={encodeLocalAssetUrl(image.src2)}
              alt=""
              aria-hidden="true"
              class:list={["fc-image", "fc-image--overlay", "fc-image--hover", { "fc-image--contain": image.fit === 'contain' }]}
              loading="lazy"
              decoding="async"
            />
          )}
          {image.src3 && (
            <img
              src={encodeLocalAssetUrl(image.src3)}
              alt=""
              aria-hidden="true"
              class:list={["fc-image", "fc-image--overlay", "fc-image--gif", { "fc-image--contain": image.fit === 'contain' }]}
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      </div>
    </div>
    
    <div class="fc-content">
      <h3 class="fc-title">{title}</h3>
      {subtitle && <p class="fc-subtitle">{subtitle}</p>}
      <span class="fc-cta" data-hover={ctaLabel}>{ctaLabel}</span>
    </div>
  </a>
</aside>

<script define:vars={{ collectionName, ctaLink, analyticsLabel, trackingEvent, analyticsEndpoint, pixelEndpoint }}>
  const emitActionPixel = (action, imageId = null, extra = {}) => {
    if (typeof window.k4ShouldSuppressAnalytics === 'function' && window.k4ShouldSuppressAnalytics()) {
      return;
    }
    try {
      if (window.k4emitActionPixel) {
        window.k4emitActionPixel(action, imageId, extra);
        return;
      }
      const params = new URLSearchParams({
        t: 'action',
        e: action,
        v: String(Date.now())
      });
      if (imageId) params.set('id', imageId);
      if (extra?.sourceLayer) params.set('sl', String(extra.sourceLayer));
      if (extra?.galleryId) params.set('g', String(extra.galleryId));
      if (extra?.pageType) params.set('pt', String(extra.pageType));
      if (extra?.trigger) params.set('tr', String(extra.trigger));
      const img = new Image();
      img.referrerPolicy = 'same-origin';
      img.src = `${pixelEndpoint}?${params.toString()}`;
    } catch {}
  };

  const sendK4 = (eventName, extra = {}) => {
    if (typeof window.k4ShouldSuppressAnalytics === 'function' && window.k4ShouldSuppressAnalytics()) {
      return;
    }
    try {
      if (window.k4track) {
        window.k4track(eventName, extra);
        return;
      }
    } catch {}

    const sidMatch = document.cookie.match(/(?:^|;\s*)k4_sid=([^;]+)/);
    const cookieSid = sidMatch ? decodeURIComponent(sidMatch[1]) : '';
    const generatedSid = crypto.randomUUID();
    const sessionId = cookieSid || sessionStorage.getItem('k4_session_id') || generatedSid;
    sessionStorage.setItem('k4_session_id', sessionId);
    const cookieDomainAttr = window.location.hostname.toLowerCase().endsWith('k4studios.com')
      ? '; Domain=.k4studios.com'
      : '';
    document.cookie = `k4_sid=${encodeURIComponent(sessionId)}; Path=/; SameSite=Lax; Secure${cookieDomainAttr}`;

    const payload = JSON.stringify({
      session_id: sessionId,
      event: eventName,
      gallery_id: analyticsLabel,
      page_type: 'landing',
      source_layer: extra?.sourceLayer || null,
      trigger: extra?.trigger || null,
      theme: extra?.theme || null,
    });

    const sendViaFetch = () => {
      fetch(analyticsEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: payload,
        keepalive: true,
        cache: 'no-store',
        mode: 'cors',
        credentials: 'include'
      }).catch(() => {});
    };

    if (navigator.sendBeacon) {
      const blob = new Blob([payload], { type: 'text/plain;charset=UTF-8' });
      const ok = navigator.sendBeacon(analyticsEndpoint, blob);
      if (ok) return;
    }

    sendViaFetch();
  };

  // Track clicks on the Featured Collection CTA
  document.addEventListener('DOMContentLoaded', () => {
    const widget = document.querySelector('.featured-collection-widget');
    const link = widget?.querySelector('.fc-link');
    const imageStack = widget?.querySelector('.fc-image-stack');
    let hoverTimer = null;
    
    if (link) {
      link.addEventListener('click', () => {
        // Skip logging on localhost (admin/dev work)
        if (window.location.hostname === 'localhost') return;

        sendK4(trackingEvent, { galleryId: analyticsLabel, pageType: 'landing' });
      });
    }

    if (link && imageStack) {
      const hoverSrc = imageStack.getAttribute('data-hover-src');
      const hoverGif = imageStack.getAttribute('data-hover-gif');

      const setHoverPhase = (phase) => {
        imageStack.setAttribute('data-hover-phase', phase);
      };

      if (hoverSrc || hoverGif) {
        link.addEventListener('mouseenter', () => {
          setHoverPhase(hoverSrc ? 'hover' : 'base');
          if (hoverTimer) window.clearTimeout(hoverTimer);
          if (hoverGif) {
            hoverTimer = window.setTimeout(() => {
              setHoverPhase('gif');
            }, 400);
          }
        });

        link.addEventListener('mouseleave', () => {
          if (hoverTimer) window.clearTimeout(hoverTimer);
          setHoverPhase('base');
        });
      }
    }
    
    // Warm the featured image immediately (s, m, l sizes)
    const fcImg = widget?.querySelector('.fc-image');
    if (fcImg) {
      const src = fcImg.getAttribute('src');
      const match = src?.match(/\/img\/(i-[^/]+)/);
      if (match) {
        ['s', 'm', 'l'].forEach(size => {
          const img = new Image();
          img.src = `/img/${match[1]}/${size}.jpg`;
        });
      }
    }
  });
</script>

<style>
  .featured-collection-widget {
    margin-bottom: 1.5rem;
    font-family: 'Glegoo', serif;
  }
  
  .hide-mobile {
    display: none;
  }
  
  @media (min-width: 768px) {
    .hide-mobile {
      display: block;
    }
  }
  
  .fc-link {
    display: block;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(135deg, #faf8f5 0%, #f5f0e8 100%);
    border: 1px solid #e3d5c9;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(101, 76, 56, 0.08);
    transition: all 0.3s ease;
  }
  
  .fc-link:hover {
    box-shadow: 0 4px 14px rgba(117, 88, 62, 0.16);
    border-color: #8d735c;
  }
  
  .fc-mat {
    padding: 0.5rem;
    background: linear-gradient(135deg, #f5f0e8 0%, #ebe4da 100%);
  }

  .fc-mat--contain {
    padding: 0.25rem;
  }
  
  .fc-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 6px;
  }

  .fc-image-wrap--contain {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 5 / 4;
    padding: 0.35rem;
    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.98) 0%, #f3ede5 68%, #e5d8ca 100%);
  }

  .fc-image-stack {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  .fc-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 8s ease-out, opacity 0.45s ease;
    will-change: transform;
  }

  .fc-image--contain {
    object-fit: contain;
  }

  .fc-image--overlay {
    opacity: 0;
    pointer-events: none;
  }

  .fc-image-stack[data-hover-phase='hover'] .fc-image--base,
  .fc-image-stack[data-hover-phase='gif'] .fc-image--base {
    opacity: 0;
  }

  .fc-image-stack[data-hover-phase='hover'] .fc-image--hover {
    opacity: 1;
  }

  .fc-image-stack[data-hover-phase='gif'] .fc-image--hover {
    opacity: 0;
  }

  .fc-image-stack[data-hover-phase='gif'] .fc-image--gif {
    opacity: 1;
  }
  
  .fc-link:hover .fc-image:not(.fc-image--contain) {
    transition: transform 8s ease-out;
    transform: scale(1.1) translate(-2%, 4%) rotate(-1.5deg);
  }

  .fc-link:hover .fc-image--contain {
    transition: transform 0.45s ease, filter 0.45s ease;
    transform: scale(1.01);
    filter: drop-shadow(0 3px 10px rgba(88, 64, 45, 0.14));
  }
  
  .fc-link:not(:hover) .fc-image:not(.fc-image--contain) {
    transition: transform 16s ease-in;
  }
  
  .fc-content {
    padding: 0.875rem 1rem;
    text-align: center;
  }
  
  .fc-title {
    font-size: 1rem;
    font-weight: 700;
    color: #2c2c2c;
    margin: 0 0 0.25rem 0;
    line-height: 1.3;
  }
  
  .fc-subtitle {
    font-size: 0.8rem;
    color: #666;
    margin: 0 0 0.5rem 0;
    line-height: 1.4;
  }
  
  .fc-cta {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(139, 0, 0, 0.45);
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(139, 0, 0, 0.35);
    border-radius: 20px;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
  }
  
  .fc-cta::after {
    content: attr(data-hover);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: inherit;
    box-sizing: border-box;
    font: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.6s ease, opacity 0.6s ease;
    white-space: nowrap;
  }
  
  .fc-link:hover .fc-cta {
    background: rgba(139, 0, 0, 0.6);
    color: transparent;
    transition: background 0.2s ease, color 0.6s ease;
  }
  
  .fc-link:hover .fc-cta::after {
    transform: translateY(0);
    opacity: 1;
    color: white;
  }
  
  /* Compact variant for sidebar placement */
  @media (min-width: 768px) {
    .fc-content {
      padding: 0.75rem 0.875rem;
    }
    
    .fc-title {
      font-size: 0.95rem;
    }
  }
</style>
