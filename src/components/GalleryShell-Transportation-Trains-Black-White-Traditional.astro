---
import GalleryShellCore from "@/components/GalleryShellCore.astro";
import ChapterViewer from "@/components/Chapter-Transportation-Trains-Black-White-Traditional.jsx";
import { galleryData as allImages } from "@/data/Galleries/Fine-Art-Photography/Transportation/Trains.mjs";
import { landingWestern as landingData } from "@/data/Galleries/Fine-Art-Photography/Transportation/landingstones.ts";

const GALLERY_PATH = "/Galleries/Fine-Art-Photography/Transportation/Trains-Black-White";
const FALLBACK_DESCRIPTION = "Explore traditional black and white train photography by Wayne Heim. Monochrome locomotives, railroad scenes, and steam-era fine art prints.";

const { breadcrumb, entranceData, initialImageId } = Astro.props;
const shouldSsrChapterViewer = Boolean(initialImageId && initialImageId !== "i-k4studios") || Astro.url.searchParams.get("view") === "grid";
---

<GalleryShellCore
  allImages={allImages}
  landingData={landingData}
  galleryPath={GALLERY_PATH}
  baseFallbackDescription={FALLBACK_DESCRIPTION}
  breadcrumb={breadcrumb}
  entranceData={entranceData}
  initialImageId={initialImageId}
>
  {shouldSsrChapterViewer ? (
    <ChapterViewer slot="chapter-viewer" client:load initialImageId={initialImageId || "i-k4studios"} />
  ) : (
    <ChapterViewer slot="chapter-viewer" client:only="react" initialImageId={initialImageId || "i-k4studios"} />
  )}
</GalleryShellCore>