---
const { title = 'Gallery', structuredDataJSON, meta = {}, preloadImage } = Astro.props;

// Fallbacks for meta
const pageTitle =
  meta.title ||
  preloadImage?.title || // ✅ Use image title
  title ||
  'K4 Studios – Fine Art Photography';

const pageDescription =
  meta.description ||
  preloadImage?.description || // ✅ Use image description if available
  preloadImage?.story ||       // ✅ Fallback to story
  'Discover painterly fine art photography, Western stories, and historical portraits by Wayne Heim. Explore galleries, stories, and limited edition prints from K4 Studios.';

// Strip any HTML tags if accidentally passed in
const cleanTitle = pageTitle.replace(/<[^>]*>/g, '');

// Open Graph/Twitter fallbacks
const ogTitle = meta.ogTitle || preloadImage?.title || pageTitle;
const ogDescription = meta.ogDescription || preloadImage?.description || pageDescription;
const ogImage = meta.ogImage || preloadImage?.src || preloadImage;
const ogUrl = meta.ogUrl || Astro.url.pathname;

const twitterTitle = meta.twitterTitle || ogTitle;
const twitterDescription = meta.twitterDescription || ogDescription;
const twitterImage = meta.twitterImage || ogImage;
const twitterUrl = meta.twitterUrl || ogUrl;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{cleanTitle}</title>
    <meta name="description" content={pageDescription} />

    {structuredDataJSON && (
      <script type="application/ld+json" set:html={structuredDataJSON} />
    )}

    {/* OG tags */}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={meta.ogType || "website"} />
    <meta property="og:url" content={ogUrl} />

    {/* Twitter tags */}
    <meta name="twitter:card" content={meta.twitterCard || "summary_large_image"} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={twitterImage} />
    <meta name="twitter:url" content={twitterUrl} />

    <!-- Google Fonts: Preconnect and Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://photos.smugmug.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" rel="stylesheet" />

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage?.src || preloadImage} />
    )}
    <!-- Make Tailwind CSS non-blocking -->
    <link
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <style>
      body {
        font-family: 'Glegoo', serif;
        background: rgba(255, 255, 255, 1);
        margin: 0;
        padding: 0;
        color: #2e2e2eff;
        margin-top: 1rem;
      }
      .page-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0;
      }
    </style>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0J1HSKFC04"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0J1HSKFC04');
    </script>
  </head>

  <body>
    <div class="page-container">
      <slot />
    </div>
    <div id="overlay-root"></div>

    <!-- SVG sharpening filter (for magnifier) -->
    <svg width="0" height="0" style="position:absolute">
      <filter id="sharpen">
        <feConvolveMatrix order="3" kernelMatrix="
          0 -.5 0
          -.5 3.2 -.5
          0 -.5 0
        " divisor="1.2"/>
      </filter>
    </svg>
    
  </body>
</html>
