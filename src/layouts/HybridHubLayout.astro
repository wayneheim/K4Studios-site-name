---
/**
 * HybridHubLayout.astro
 * 
 * Reusable layout for Hybrid Authority–Commerce Hub pages.
 * Wraps BaseLayout and provides the standard hub page skeleton:
 *   Header → Carousel → Thesis → Definition → Catalog → Close → FAQ → Footer
 * 
 * Each section is a named <slot> so the page can compose components freely.
 * The layout handles: head injection, reveal-on-scroll observer, and shared styles.
 */
import BaseLayout from './BaseLayout.astro';
import LandingHeader from '@/components/Landing-Header.jsx';
import SiteFooter from '@/components/Footer.astro';
import '@/styles/global.css';
import '@/styles/oneupheader.css';

export const prerender = true;

const {
  title,
  breadcrumb,
  meta = {},
  structuredDataJSON,
  breadcrumbsJSON,
} = Astro.props;
---

<BaseLayout
  title={title}
  structuredDataJSON={structuredDataJSON}
  breadcrumbsJSON={breadcrumbsJSON}
  meta={meta}
>
  <!-- Allow pages to inject structured data into <head> -->
  <slot name="head" slot="head" />

  <main class="hybrid-hub bg-[#ffffff] text-[#2c2c2c] font-serif min-h-screen overflow-x-hidden">

    <!-- SECTION A — Header / Nav -->
    <div class="drawer-mode">
      <LandingHeader client:load breadcrumb={breadcrumb} />
    </div>

    <!-- SECTION B — Hero Spread Carousel (Emotional Entry) -->
    <section class="hybrid-carousel-section reveal-on-scroll" aria-label="Featured works">
      <slot name="carousel" />
    </section>

    <!-- SECTION C — Artistic Thesis / Elevator Pitch (H1 lives here) -->
    <section class="hybrid-thesis-section" aria-label="About this collection">
      <slot name="thesis" />
    </section>

    <!-- SECTION D — Definition Block (SEO Anchor) -->
    <section class="hybrid-definition-section" aria-label="Definition">
      <slot name="definition" />
    </section>

    <!-- SECTION E — Mini Catalog Teaser (Commercial Resolution) -->
    <section class="hybrid-catalog-section" aria-label="Browse the collection">
      <slot name="catalog" />
    </section>

    <!-- SECTION F — Collector Close -->
    <section class="hybrid-close-section" aria-label="Collector information">
      <slot name="close" />
    </section>

    <!-- SECTION G — FAQ -->
    <section class="hybrid-faq-section" aria-label="Frequently asked questions">
      <slot name="faq" />
    </section>

    <SiteFooter class="pt-8 pb-12" />
  </main>

  <!-- Reveal-on-scroll observer -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const els = document.querySelectorAll(".reveal-on-scroll, .slide-in-left");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });
        els.forEach(el => observer.observe(el));
      } else {
        // Fallback: show everything immediately
        els.forEach(el => el.classList.add("is-visible"));
      }
    });
  </script>

  <style>
    /* ─── Shared Hybrid Hub Styles ─────────────────────── */
    .hybrid-hub {
      font-family: 'Glegoo', serif;
    }

    /* Reveal animations */
    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.9s ease-out, transform 0.9s ease-out;
      visibility: hidden;
    }
    .reveal-on-scroll.is-visible {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }

    .slide-in-left {
      opacity: 0;
      transform: translateX(-12px);
      transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      visibility: hidden;
    }
    .slide-in-left.is-visible {
      opacity: 1;
      transform: translateX(0);
      visibility: visible;
    }

    /* Section spacing */
    .hybrid-carousel-section {
      padding: 0.5rem 0 1rem;
    }
    .hybrid-thesis-section {
      padding: 1.5rem 0 1rem;
    }
    .hybrid-definition-section {
      padding: 1rem 0;
    }
    .hybrid-faq-section {
      padding: 1rem 0 1.5rem;
    }
    .hybrid-catalog-section {
      padding: 2rem 0;
    }
    .hybrid-close-section {
      padding: 1rem 0 2rem;
    }

    @media (max-width: 768px) {
      .hybrid-thesis-section {
        padding: 1rem 0 0.5rem;
      }
    }
  </style>
</BaseLayout>
