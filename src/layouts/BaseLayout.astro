---
const {
  title = 'Gallery',
  structuredDataJSON,
  meta = {},
  // 👇 add these three (we’ll pass them from the page)
  lcpSmall,
  lcpMed,
  lcpLarge,
} = Astro.props;

// Load local, pinned Tailwind build
import "@/styles/global.css";

// Strip any HTML tags if accidentally passed in
const cleanTitle = title.replace(/<[^>]*>/g, '');
const lcpFallback = lcpMed || lcpLarge || lcpSmall; // safest single URL
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{cleanTitle}</title>

    {structuredDataJSON && (
      <script type="application/ld+json" set:html={structuredDataJSON} />
    )}

    {meta.ogTitle && (
      <>
        <meta property="og:title" content={meta.ogTitle} />
        <meta property="og:description" content={meta.ogDescription} />
        <meta property="og:image" content={meta.ogImage} />
        <meta property="og:type" content={meta.ogType || "website"} />
        <meta property="og:url" content={meta.ogUrl} />
      </>
    )}
    {meta.twitterTitle && (
      <>
        <meta name="twitter:card" content={meta.twitterCard || "summary_large_image"} />
        <meta name="twitter:title" content={meta.twitterTitle} />
        <meta name="twitter:description" content={meta.twitterDescription} />
        <meta name="twitter:image" content={meta.twitterImage} />
        <meta name="twitter:url" content={meta.twitterUrl} />
      </>
    )}

    <!-- (optional) quicker font warmup -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" rel="stylesheet" />

    {lcpFallback && (
      <link
        rel="preload"
        as="image"
        href={lcpFallback}
        imagesrcset={lcpSmall && lcpMed && lcpLarge
          ? `${lcpSmall} 640w, ${lcpMed} 1024w, ${lcpLarge} 1600w`
          : undefined}
        imagesizes="(min-width: 1024px) 900px, 90vw"
        fetchpriority="high"
      />
    )}

    <style>
      body {
        font-family: 'Glegoo', serif;
        background: rgb(255, 255, 255);
        margin: 0;
        padding: 0;
        color: #2e2e2eff;
        margin-top: 1rem;
      }
      .page-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0;
      }
    </style>
  </head>

  <body>
    <div class="page-container">
      <slot />
    </div>
    <div id="overlay-root"></div>
  </body>
</html>


