---
import GalleryTourSkipClearer from "../components/GalleryTourSkipClearer.jsx";

export const prerender = true;

// ✅ Safe server-side URL parsing
let lastSegment = "";
let isImagePage = false;
try {
  if (Astro.url?.pathname) {
    lastSegment = Astro.url.pathname.split("/").pop() || "";
    isImagePage = lastSegment.startsWith("i-");
  }
} catch {
  isImagePage = false;
}

const {
  title = 'Gallery',
  structuredDataJSON,
  breadcrumbsJSON,
  meta = {},
  preloadImage
} = Astro.props;

// ✅ Safe URL parsing (works server-side)
const parseSite = (value) => {
  if (!value) return null;
  try {
    return new URL(value);
  } catch {
    return null;
  }
};

const siteUrl =
  parseSite(Astro.site) ||
  parseSite(import.meta.env.SITE) ||
  new URL('https://www.k4studios.com');

const siteOrigin = siteUrl.origin;

const ensureAbsoluteUrl = (value) => {
  if (!value) return null;
  try {
    return new URL(value, siteOrigin).toString();
  } catch {
    return value;
  }
};

// Titles
const galleryTitle = meta.title || title || 'K4 Studios – Fine Art Photography';
let pageTitle = isImagePage
  ? (preloadImage?.title || meta.ogTitle || meta.ogImageTitle || galleryTitle)
  : galleryTitle;

// Remove HTML & redundant separators
const cleanTitle = (pageTitle || '')
  .replace(/<[^>]*>/g, '')
  .replace(/\s*\|\s*Wayne Heim.*$/gi, '')
  .trim();

const defaultDescription =
  'Discover painterly fine art photography, Western stories, and historical portraits by Wayne Heim. Explore galleries, stories, and limited edition prints from K4 Studios.';

// ✅ Trim helper
const trimDescription = (text = '', maxLength = 160) => {
  if (!text) return '';
  const trimmed = text.trim();
  return trimmed.length > maxLength
    ? trimmed.slice(0, trimmed.lastIndexOf(' ', maxLength)) + '…'
    : trimmed;
};

const seoDescriptionRaw =
  meta.description ||
  (isImagePage ? preloadImage?.description : null) ||
  (Astro.url?.pathname === '/'
    ? defaultDescription
    : `${cleanTitle} – Fine Art Photography by Wayne Heim`);

const seoDescription = trimDescription(seoDescriptionRaw);

const socialDescription =
  (isImagePage && preloadImage?.story)
    ? preloadImage.story
    : (meta.story || seoDescriptionRaw);

// ✅ OG / Twitter image setup
let rawOgImage;
let ogAlt;
let ogWidth = preloadImage?.width || "1600";
let ogHeight = preloadImage?.height || "1200";

if (isImagePage && preloadImage?.src) {
  rawOgImage = preloadImage.src;
  ogAlt = preloadImage.alt || preloadImage.title || cleanTitle;
  ogWidth = preloadImage.width || ogWidth;
  ogHeight = preloadImage.height || ogHeight;
} else if (meta.ogImage) {
  rawOgImage = meta.ogImage;
  ogAlt = meta.ogImageAlt || meta.ogImageTitle || cleanTitle;
} else {
  rawOgImage = "/images/show-2t.webp";
  ogAlt = cleanTitle;
}

const canonicalUrl = ensureAbsoluteUrl(meta.canonicalUrl || Astro.url?.pathname || '/');
const ogUrl = canonicalUrl;

const ogImage = ensureAbsoluteUrl(rawOgImage).replace(/^http:/, 'https:');
const ogImageSecureUrl = ensureAbsoluteUrl(meta.ogImageSecureUrl || rawOgImage)?.replace(/^http:/, 'https:');

const ogType = isImagePage ? "article" : (meta.ogType || "website");

const twitterTitle = meta.twitterTitle || cleanTitle;
const twitterImage = ensureAbsoluteUrl(meta.twitterImage || rawOgImage).replace(/^http:/, 'https:');
const twitterUrl = ogUrl;

const inferMimeType = (url) => {
  if (!url) return null;
  try {
    const ext = new URL(url).pathname.split('.').pop()?.toLowerCase();
    switch (ext) {
      case 'jpg': case 'jpeg': return 'image/jpeg';
      case 'png': return 'image/png';
      case 'webp': return 'image/webp';
      case 'gif': return 'image/gif';
      case 'avif': return 'image/avif';
      default: return null;
    }
  } catch { return null; }
};

const ogImageType = meta.ogImageType || inferMimeType(ogImage) || 'image/jpeg';
const twitterCard = meta.twitterCard || (twitterImage ? 'summary_large_image' : 'summary');
const keywords =
  meta.keywords ||
  (Array.isArray(preloadImage?.keywords)
    ? preloadImage.keywords.join(', ')
    : preloadImage?.keywords || '');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {import.meta.env.PROD && <base href="https://www.k4studios.com" />}

    <title>{cleanTitle}</title>
    <meta name="description" content={seoDescription} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Wayne Heim" />
    <meta name="copyright" content="© Wayne Heim, K4 Studios" />
    <meta name="creator" content="Wayne Heim" />
    {isImagePage && <meta name="robots" content="noai, noimageai" />}
    <link rel="canonical" href={canonicalUrl} />

    {structuredDataJSON && <script type="application/ld+json" set:html={structuredDataJSON}></script>}
    {breadcrumbsJSON && <script type="application/ld+json" set:html={breadcrumbsJSON}></script>}

    <!-- ✅ OG / Twitter -->
    <meta property="og:title" content={cleanTitle} />
    <meta property="og:description" content={socialDescription || seoDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImageSecureUrl && <meta property="og:image:secure_url" content={ogImageSecureUrl} />}
    <meta property="og:image:width" content={ogWidth} />
    <meta property="og:image:height" content={ogHeight} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="K4 Studios – Fine Art Photography" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={socialDescription} />
    {twitterImage && <meta name="twitter:image" content={twitterImage} />}
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="twitter:url" content={twitterUrl} />

    <!-- ✅ Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" rel="stylesheet" />

    <style>
      body {
        font-family: 'Glegoo', serif;
        background: #fff;
        margin: 0;
        padding: 0;
        color: #2e2e2e;
        margin-top: 1rem;
      }
      .page-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0;
      }
    </style>

    <!-- ✅ Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0J1HSKFC04"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0J1HSKFC04', { send_page_view: true });
    </script>

    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "tuibatmru4");
    </script>
  </head>

  <body>
    <GalleryTourSkipClearer client:load />
    <div class="page-container">
      <slot />
    </div>
    <div id="overlay-root"></div>

    <svg width="0" height="0" style="position:absolute">
      <filter id="sharpen">
        <feConvolveMatrix order="3" kernelMatrix="0 -.5 0 -.5 3.2 -.5 0 -.5 0" divisor="1.2" />
      </filter>
    </svg>

  <!-- 🧹 SmugMug JSON-LD scrubber (robust final client-side fallback) -->
<script>
  function removeSmugMugJsonLd() {
    document.querySelectorAll('script[type="application/ld+json"]').forEach((s) => {
      try {
        const text = s.textContent.trim();
        if (!text.includes("photos.smugmug.com")) return;
        const json = JSON.parse(text);
        if (
          (json["@type"] === "ImageObject" || json.type === "ImageObject") &&
          (!json["@id"] || !text.includes('"creditText"'))
        ) {
          console.log("🧹 Removed SmugMug JSON-LD injected block");
          s.remove();
        }
      } catch {}
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    removeSmugMugJsonLd();

    const observer = new MutationObserver((mutations) => {
      let needsClean = false;
      for (const m of mutations) {
        for (const n of m.addedNodes) {
          if (n.nodeType === 1 && n.tagName === "SCRIPT") {
            needsClean = true;
          }
        }
      }
      if (needsClean) removeSmugMugJsonLd();
    });

    // Watch both head and body for new scripts
    observer.observe(document.documentElement, { childList: true, subtree: true });

    // Safety sweep after 5s for very delayed injects
    setTimeout(removeSmugMugJsonLd, 5000);
  });
</script>

  </body>
</html>
