---
import { normalizeImageSrc, extractImageId } from "@/utils/imageProxy.js";

export const prerender = true;

// ✅ Safe server-side URL parsing
let lastSegment = "";
let isImagePage = false;
try {
  if (Astro.url?.pathname) {
    lastSegment = Astro.url.pathname.split("/").pop() || "";
    isImagePage = lastSegment.startsWith("i-");
  }
} catch {
  isImagePage = false;
}

const {
  title = 'Gallery',
  structuredDataJSON,
  breadcrumbsJSON,
  extraStructuredDataJSON,
  meta = {},
  description,
  preloadImage,
  disableAutoBreadcrumbs = false
} = Astro.props;

// ✅ Safe URL parsing (works server-side)
const parseSite = (value) => {
  if (!value) return null;
  try {
    return new URL(value);
  } catch {
    return null;
  }
};

const siteUrl =
  parseSite(Astro.site) ||
  parseSite(import.meta.env.SITE) ||
  new URL('https://www.k4studios.com');

const siteOrigin = siteUrl.origin;
const canonicalOrigin = import.meta.env.PROD ? 'https://www.k4studios.com' : siteOrigin;
const k4Person = {
  '@type': 'Person',
  '@id': 'https://www.k4studios.com/#person',
  name: 'Wayne Heim',
  url: 'https://www.k4studios.com/Other/Bio',
};
const k4Organization = {
  '@type': 'Organization',
  '@id': 'https://www.k4studios.com/#organization',
  name: 'K4 Studios',
  url: 'https://www.k4studios.com/',
};

const normalizeK4Host = (value) => {
  if (!value || typeof value !== 'string') return value;
  return value.replace(/https?:\/\/(?:www\.)?k4studios\.com/gi, 'https://www.k4studios.com');
};

const ensureAbsoluteUrl = (value) => {
  if (!value) return null;
  try {
    return normalizeK4Host(new URL(value, canonicalOrigin).toString());
  } catch {
    return normalizeK4Host(value);
  }
};

const normalizeMetaText = (value = '', options = {}) =>
  String(value || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(options.preserveDashes ? /$^/g : /[\u2013\u2014]/g, ' - ')
    .replace(/\u00a9/g, '(c)')
    .replace(/\s+/g, ' ')
    .trim();

const trimAtWord = (text = '', maxLength = 160, options = {}) => {
  const normalized = normalizeMetaText(text, options);
  if (!normalized) return '';
  if (normalized.length <= maxLength) return normalized;

  const slice = normalized.slice(0, maxLength + 1);
  const boundary = slice.lastIndexOf(' ');
  const trimmed = (boundary > Math.floor(maxLength * 0.6)
    ? slice.slice(0, boundary)
    : normalized.slice(0, maxLength)).trim();

  return `${trimmed}\u2026`;
};

const trimTitle = (text = '', maxLength = 95, options = {}) => {
  const normalized = normalizeMetaText(text, options);
  if (!normalized) return '';
  if (normalized.length <= maxLength) return normalized;

  return trimAtWord(normalized, maxLength, options);
};

const normalizeDescription = (text = '', fallback = '', minimumLength = 110, maximumLength = 160, options = {}) => {
  const normalized = normalizeMetaText(text, options);
  const fallbackText = trimAtWord(fallback, maximumLength, options);

  if (!normalized) return fallbackText;
  if (normalized.length >= minimumLength) return trimAtWord(normalized, maximumLength, options);

  const supplements = [
    'Explore painterly fine art photography, Western stories, and limited edition prints at K4 Studios.',
    'View collector-focused galleries, stories, and archival print options at K4 Studios.',
  ];

  for (const supplement of supplements) {
    const combined = `${normalized} ${supplement}`.trim();
    if (combined.length >= minimumLength) {
      return trimAtWord(combined, maximumLength, options);
    }
  }

  return fallbackText;
};

// Titles
const titleTextOptions = { preserveDashes: meta.preserveTitleDashes === true };
const galleryTitle = meta.seoTitle || title || meta.title || meta.ogTitle || 'Fine Art Photography - Wayne Heim';
let pageTitle = isImagePage
  ? (meta.seoTitle || title || meta.title || meta.ogTitle || meta.twitterTitle || meta.ogImageTitle || preloadImage?.title || galleryTitle)
  : galleryTitle;

// Remove HTML & redundant separators
const normalizedTitleBase = normalizeMetaText(pageTitle || '', titleTextOptions);
const cleanTitleBase = isImagePage
  ? normalizedTitleBase.trim()
  : meta.preserveTitleExact === true
    ? normalizedTitleBase.trim()
    : normalizedTitleBase
      .replace(/\s*\|\s*Wayne Heim.*$/gi, '')
      .trim();
const cleanTitle = isImagePage
  ? cleanTitleBase
  : trimTitle(cleanTitleBase, 95, titleTextOptions);

const pathname = Astro.url?.pathname || '';
let finalTitle = cleanTitle;
if (/^\/Other\/Show(?:\/|$)/i.test(pathname) && !/\|\s*Show$/i.test(finalTitle)) {
  finalTitle = `${finalTitle} | Show`;
}
if (/^\/Other\/Stories(?:\/|$)/i.test(pathname) && !/\|\s*Stories$/i.test(finalTitle)) {
  finalTitle = `${finalTitle} | Stories`;
}

const defaultDescription =
  'Discover painterly fine art photography, Western stories, and historical portraits by Wayne Heim. Explore galleries, stories, and limited edition prints from K4 Studios.';

const seoDescriptionRaw =
  description ||
  meta.seoDescription ||
  meta.ogDescription ||
  meta.twitterDescription ||
  meta.description ||
  (isImagePage ? preloadImage?.description : null) ||
  (Astro.url?.pathname === '/'
    ? defaultDescription
    : `${finalTitle} - Fine Art Photography by Wayne Heim`);

const seoDescriptionOptions = { preserveDashes: meta.preserveDescriptionDashes === true };
const seoDescription = normalizeDescription(seoDescriptionRaw, defaultDescription, 110, 160, seoDescriptionOptions);
const seoDescriptionMaxLength =
  Number.isFinite(Number(meta.descriptionMaxLength)) && Number(meta.descriptionMaxLength) > 0
    ? Number(meta.descriptionMaxLength)
    : 160;
let finalSeoDescription =
  seoDescriptionMaxLength === 160
    ? seoDescription
    : normalizeDescription(seoDescriptionRaw, defaultDescription, 80, seoDescriptionMaxLength, seoDescriptionOptions);

if (!isImagePage && /^\/Other\/(?:Show|Stories)(?:\/|$)/i.test(pathname)) {
  const sectionLabel = /^\/Other\/Show(?:\/|$)/i.test(pathname) ? 'K4 show page.' : 'K4 story page.';
  if (!finalSeoDescription.toLowerCase().includes(sectionLabel.toLowerCase())) {
    const suffix = ` ${sectionLabel}`;
    const maxDescriptionLength = Math.max(80, seoDescriptionMaxLength);
    const baseLength = Math.max(0, maxDescriptionLength - suffix.length);
    finalSeoDescription = `${trimAtWord(finalSeoDescription, baseLength).replace(/\.\.\.$/, '').trim()}${suffix}`;
  }
}

const socialDescription =
  (isImagePage && preloadImage?.story)
    ? preloadImage.story
    : (meta.story || seoDescriptionRaw);

// ✅ OG / Twitter image setup
let rawOgImage;
let ogAlt;
let ogWidth = preloadImage?.width || "1600";
let ogHeight = preloadImage?.height || "1200";

if (isImagePage && preloadImage?.src) {
  rawOgImage = preloadImage.src;
  ogAlt = preloadImage.alt || preloadImage.title || finalTitle;
  ogWidth = preloadImage.width || ogWidth;
  ogHeight = preloadImage.height || ogHeight;
} else if (meta.ogImage) {
  rawOgImage = meta.ogImage;
  ogAlt = meta.ogImageAlt || meta.ogImageTitle || finalTitle;
} else {
  rawOgImage = "/images/show-2t.webp";
  ogAlt = finalTitle;
}

const canonicalUrl = ensureAbsoluteUrl(meta.canonicalUrl || Astro.url?.pathname || '/');
const emitCanonical = meta.noCanonical !== true && meta.canonical !== false;
const ogUrl = ensureAbsoluteUrl(meta.ogUrl || canonicalUrl);
const isInternalPreviewPage =
  /\/(?:Builder-Test[^/]*|Test-Show[^/]*|Test-show[^/]*|Template)(?:\/|$)/i.test(pathname) ||
  /\/index%20copy(?:\/|$)/i.test(pathname) ||
  /\/index copy(?:\/|$)/i.test(pathname);
const robotsContent = meta.robots || (isInternalPreviewPage ? "noindex, follow" : (isImagePage ? "index, follow, noai, noimageai" : null));
const clarityDelayMs = isImagePage ? 4000 : 2000;
const analyticsDelayMs = isImagePage ? 4000 : 0;

// Convert any SmugMug URLs to proxy format for OG/Twitter images
// Default to 'l' to protect XL from bot discovery
const toAbsoluteProxyUrl = (src: string, size = 'l') => {
  if (!src) return '';
  // If it's already a local/static image, just make it absolute
  if (src.startsWith('/images/')) return ensureAbsoluteUrl(src);

  // Already a proxy URL: preserve semantic filenames and upgrade legacy sizes.
  if (src.startsWith('/img/')) {
    return ensureAbsoluteUrl(normalizeImageSrc(src, size));
  }
  if (/^https?:\/\/(?:www\.)?k4studios\.com\/img\//i.test(src)) {
    try {
      const path = new URL(src).pathname;
      return ensureAbsoluteUrl(normalizeImageSrc(path, size));
    } catch {
      return normalizeK4Host(src);
    }
  }

  // Extract image ID and convert to absolute proxy URL
  const imageId = extractImageId(src) || (src.startsWith('i-') ? src : null);
  if (imageId) {
    return ensureAbsoluteUrl(normalizeImageSrc(imageId, size));
  }
  // Fallback - try to use as-is (shouldn't happen)
  return ensureAbsoluteUrl(src);
};

// Cap OG/Twitter images at L to keep XL out of bot-discoverable surfaces
const ogImage = toAbsoluteProxyUrl(rawOgImage, 'l');
const ogImageSecureUrl = ogImage;

const commerceOffer = meta.commerceOffer || null;
const productPriceAmount = commerceOffer?.price ?? commerceOffer?.lowPrice;
const productPriceCurrency = commerceOffer?.priceCurrency || "USD";
const productAvailability = commerceOffer?.availability
  ? String(commerceOffer.availability).replace(/^https?:\/\/schema\.org\//i, "").replace(/([a-z])([A-Z])/g, "$1 $2").toLowerCase()
  : null;
const ogType = meta.ogType || (isImagePage && commerceOffer ? "product" : (isImagePage ? "article" : "website"));

const twitterTitle = isImagePage ? finalTitle : (meta.twitterTitle || finalTitle);
const twitterImage = toAbsoluteProxyUrl(meta.twitterImage || rawOgImage, 'l');
const twitterUrl = ensureAbsoluteUrl(meta.twitterUrl || ogUrl);

const stripHash = (value) => String(value || '').split('#')[0];

const labelFromSegment = (segment = '') => {
  const decoded = decodeURIComponent(String(segment || ''));
  const specialLabels = {
    'K4': 'K4',
    'WWII': 'WWII',
    'NA': 'Native American',
    'B': 'Black & White',
    'BW': 'Black & White',
  };

  if (/^i-[A-Za-z0-9-]+$/.test(decoded)) {
    return preloadImage?.title || decoded;
  }

  return decoded
    .split('-')
    .filter(Boolean)
    .map((part) => specialLabels[part] || (/^[A-Z0-9]+$/.test(part) ? part : `${part.charAt(0).toUpperCase()}${part.slice(1)}`))
    .join(' ')
    .replace(/\bBlack White\b/gi, 'Black & White')
    .replace(/\bFine Art Photography\b/g, 'Fine Art Photography')
    .trim();
};

const buildAutoBreadcrumbs = () => {
  if (!pathname || pathname === '/') return null;

  const segments = pathname.split('/').filter(Boolean);
  if (!segments.length) return null;

  const itemListElement = [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.k4studios.com/",
    },
  ];

  const cumulative = [];
  segments.forEach((segment, index) => {
    cumulative.push(segment);
    const itemUrl = ensureAbsoluteUrl(`/${cumulative.join('/')}`);
    itemListElement.push({
      "@type": "ListItem",
      position: index + 2,
      name: index === segments.length - 1
        ? (isImagePage ? (preloadImage?.title || labelFromSegment(segment)) : labelFromSegment(segment))
        : labelFromSegment(segment),
      item: itemUrl,
    });
  });

  return JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${stripHash(canonicalUrl)}#breadcrumbs`,
    itemListElement,
  });
};

const isGalleryRoute =
  /^\/Galleries(?:\/|$)/i.test(pathname) ||
  /^\/Other\/(?:Archive|K4-Select-Series)(?:\/|$)/i.test(pathname);

const buildAutoWebPageSchema = () => {
  const pageType = isGalleryRoute ? "CollectionPage" : "WebPage";
  const webPage = {
    "@context": "https://schema.org",
    "@type": pageType,
    "@id": `${stripHash(canonicalUrl)}#webpage`,
    url: canonicalUrl,
    name: finalTitle,
    description: finalSeoDescription,
    inLanguage: "en",
    isPartOf: {
      "@type": "WebSite",
      "@id": "https://www.k4studios.com/#website",
      name: "Wayne Heim - K4 Studios",
      url: "https://www.k4studios.com/",
      publisher: k4Organization,
    },
    primaryImageOfPage: ogImage
      ? {
          "@type": "ImageObject",
          url: ogImage,
          caption: ogAlt || finalTitle,
        }
      : undefined,
    creator: k4Person,
    publisher: k4Organization,
  };

  if (isGalleryRoute) {
    webPage.mainEntity = {
      "@type": "ImageGallery",
      "@id": `${stripHash(canonicalUrl)}#imagegallery`,
      name: finalTitle,
      description: finalSeoDescription,
      creator: k4Person,
      publisher: k4Organization,
    };
  }

  return JSON.stringify(webPage);
};

const buildAutoImageSchema = () => {
  if (!isImagePage) return null;

  return JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["ImageObject", "VisualArtwork"],
    "@id": `${stripHash(canonicalUrl)}#image`,
    name: preloadImage?.title || finalTitle,
    description: finalSeoDescription,
    caption: preloadImage?.alt || preloadImage?.title || finalTitle,
    url: canonicalUrl,
    contentUrl: ogImage || undefined,
    thumbnailUrl: twitterImage || ogImage || undefined,
    identifier: lastSegment,
    creator: k4Person,
    copyrightHolder: k4Person,
    creditText: "Wayne Heim",
    copyrightNotice: "Copyright Wayne Heim, www.k4studios.com. All rights reserved.",
    license: "https://www.k4studios.com/licensing",
    acquireLicensePage: "https://www.k4studios.com/licensing",
    encodingFormat: ogImageType,
    inLanguage: "en",
    mainEntityOfPage: { "@id": `${stripHash(canonicalUrl)}#webpage` },
    ...(preloadImage?.width ? { width: preloadImage.width } : {}),
    ...(preloadImage?.height ? { height: preloadImage.height } : {}),
  });
};

const inferMimeType = (url) => {
  if (!url) return null;
  try {
    const ext = new URL(url).pathname.split('.').pop()?.toLowerCase();
    switch (ext) {
      case 'jpg': case 'jpeg': return 'image/jpeg';
      case 'png': return 'image/png';
      case 'webp': return 'image/webp';
      case 'gif': return 'image/gif';
      case 'avif': return 'image/avif';
      default: return null;
    }
  } catch { return null; }
};

const ogImageType = meta.ogImageType || inferMimeType(ogImage) || 'image/jpeg';
const twitterCard = meta.twitterCard || (twitterImage ? 'summary_large_image' : 'summary');
const normalizedStructuredDataJSON = normalizeK4Host(structuredDataJSON);
const normalizedAutoImageJSON = !normalizedStructuredDataJSON ? normalizeK4Host(buildAutoImageSchema()) : null;
const normalizedBreadcrumbsJSON = disableAutoBreadcrumbs ? null : normalizeK4Host(breadcrumbsJSON || buildAutoBreadcrumbs());
const normalizedExtraStructuredDataJSON = Array.isArray(extraStructuredDataJSON)
  ? extraStructuredDataJSON.map(normalizeK4Host)
  : (extraStructuredDataJSON ? [normalizeK4Host(extraStructuredDataJSON)] : []);

const collectSchemaTypes = (value, types = new Set()) => {
  if (!value) return types;
  if (Array.isArray(value)) {
    value.forEach((item) => collectSchemaTypes(item, types));
    return types;
  }
  if (typeof value !== 'object') return types;

  const type = value['@type'];
  if (Array.isArray(type)) {
    type.forEach((item) => types.add(String(item)));
  } else if (type) {
    types.add(String(type));
  }

  if (value['@graph']) collectSchemaTypes(value['@graph'], types);
  Object.values(value).forEach((item) => {
    if (item && typeof item === 'object') collectSchemaTypes(item, types);
  });
  return types;
};

const jsonContainsSchemaType = (json, typeName) => {
  if (!json || typeof json !== 'string') return false;
  try {
    return collectSchemaTypes(JSON.parse(json)).has(typeName);
  } catch {
    return new RegExp(`"@type"\\s*:\\s*"${typeName}"`).test(json);
  }
};

const suppliedJsonLd = [
  normalizedStructuredDataJSON,
  normalizedBreadcrumbsJSON,
  ...normalizedExtraStructuredDataJSON,
].filter(Boolean);
const hasExplicitPageSchema = suppliedJsonLd.some((json) =>
  jsonContainsSchemaType(json, 'WebPage') || jsonContainsSchemaType(json, 'CollectionPage')
);
const normalizedAutoWebPageJSON = hasExplicitPageSchema ? null : normalizeK4Host(buildAutoWebPageSchema());
const siteIdentityStructuredDataJSON = pathname === '/' ? JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://www.k4studios.com/#person",
        name: "Wayne Heim",
        url: "https://www.k4studios.com/Other/Bio",
        image: "https://www.k4studios.com/images/Bio-Heim.jpg",
        jobTitle: "Western Fine Art Photographer, Fine Art Photographer, and Medical Illustrator",
        worksFor: { "@id": "https://www.k4studios.com/#organization" },
        brand: { "@id": "https://www.k4studios.com/#organization" },
        knowsAbout: [
          "Western fine art photography",
          "painterly photography",
          "cowboy photography",
          "living history",
          "historical reenactment photography",
          "medical illustration",
          "visual storytelling",
          "Western photographer",
          "Western photographers",
        ],
      },
      {
        "@type": "Organization",
        "@id": "https://www.k4studios.com/#organization",
        name: "K4 Studios",
        url: "https://www.k4studios.com/",
        founder: { "@id": "https://www.k4studios.com/#person" },
        logo: {
          "@type": "ImageObject",
          url: "https://www.k4studios.com/images/K4Logo-web-c.webp",
          width: 512,
          height: 512,
        },
      },
    ],
  }) : null;
const jsonLdScripts = [
  siteIdentityStructuredDataJSON,
  normalizedAutoWebPageJSON,
  normalizedAutoImageJSON,
  normalizedStructuredDataJSON,
  normalizedBreadcrumbsJSON,
  ...normalizedExtraStructuredDataJSON,
]
  .filter(Boolean)
  .map((json) => `<script type="application/ld+json">${json}</script>`)
  .join('\n');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalSeoDescription} />
    <meta name="author" content="Wayne Heim" />
    <meta name="copyright" content="Copyright Wayne Heim, K4 Studios" />
    <meta name="creator" content="Wayne Heim" />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    {emitCanonical && <link rel="canonical" href={canonicalUrl} />}
    <noscript>
      <style>
        .reveal-on-scroll,
        .slide-in-left {
          opacity: 1 !important;
          transform: none !important;
          visibility: visible !important;
        }
      </style>
    </noscript>

    <Fragment set:html={jsonLdScripts} />
    <slot name="head" />

    <!-- ✅ OG / Twitter -->
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={socialDescription || seoDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImageSecureUrl} />
    <meta property="og:image:width" content={ogWidth} />
    <meta property="og:image:height" content={ogHeight} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:type" content={ogType} />
    {commerceOffer && productPriceAmount !== undefined && productPriceAmount !== null && (
      <meta property="product:price:amount" content={String(productPriceAmount)} />
    )}
    {commerceOffer && <meta property="product:price:currency" content={productPriceCurrency} />}
    {commerceOffer && productAvailability && <meta property="product:availability" content={productAvailability} />}
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="Wayne Heim - K4 Studios" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={twitterImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="twitter:url" content={twitterUrl} />

    <!-- ✅ Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" rel="stylesheet" />

    <style>
      body {
        font-family: 'Glegoo', serif;
        background: #fff;
        margin: 0;
        padding: 0;
        color: #2e2e2e;
        margin-top: 1rem;
      }
      .page-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0;
      }

      .k4-collection-loading {
        position: fixed;
        inset: 0;
        z-index: 2147483000;
        display: grid;
        place-items: center;
        padding: 24px;
        background: rgba(17, 12, 8, 0.72);
        color: #fff8ee;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 160ms ease, visibility 160ms ease;
      }

      .k4-collection-loading.is-active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .k4-collection-loading__panel {
        display: flex;
        align-items: center;
        gap: 14px;
        max-width: min(92vw, 420px);
        padding: 16px 18px;
        border: 1px solid rgba(255, 248, 238, 0.24);
        border-radius: 8px;
        background: rgba(34, 24, 16, 0.9);
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.32);
      }

      .k4-collection-loading__hourglass {
        position: relative;
        width: 20px;
        height: 28px;
        flex: 0 0 auto;
        border: 1.5px solid rgba(233, 201, 134, 0.82);
        border-radius: 6px;
        box-shadow: inset 0 0 0 1px rgba(10, 7, 5, 0.32);
        background: linear-gradient(
          to bottom,
          transparent 44%,
          rgba(233, 201, 134, 0.28) 44%,
          rgba(233, 201, 134, 0.28) 56%,
          transparent 56%
        );
        transform-origin: 50% 50%;
        animation: k4-hourglass-turn 1.15s cubic-bezier(0.55, 0.08, 0.36, 0.96) infinite;
      }

      .k4-collection-loading__hourglass::before,
      .k4-collection-loading__hourglass::after {
        content: "";
        position: absolute;
        left: 50%;
        width: 11px;
        height: 9px;
        transform: translateX(-50%);
        background: rgba(233, 201, 134, 0.86);
        filter: saturate(1.03);
      }

      .k4-collection-loading__hourglass::before {
        top: 4px;
        clip-path: polygon(0 0, 100% 0, 50% 100%);
        transform-origin: 50% 85%;
        animation: k4-hourglass-top 1.15s ease-in-out infinite;
      }

      .k4-collection-loading__hourglass::after {
        bottom: 4px;
        clip-path: polygon(50% 0, 0 100%, 100% 100%);
        transform-origin: 50% 15%;
        opacity: 0.34;
        animation: k4-hourglass-bottom 1.15s ease-in-out infinite;
      }

      .k4-collection-loading__copy {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
      }

      .k4-collection-loading__copy strong {
        font-size: 0.98rem;
        line-height: 1.25;
        font-weight: 700;
      }

      .k4-collection-loading__copy span {
        font-size: 0.82rem;
        line-height: 1.35;
        color: rgba(255, 248, 238, 0.78);
      }

      @keyframes k4-hourglass-turn {
        0%, 72% { transform: rotate(0deg); }
        100% { transform: rotate(180deg); }
      }

      @keyframes k4-hourglass-top {
        0%, 20% {
          opacity: 0.88;
          transform: translateX(-50%) scaleY(1);
        }
        55%, 100% {
          opacity: 0.28;
          transform: translateX(-50%) scaleY(0.4);
        }
      }

      @keyframes k4-hourglass-bottom {
        0%, 20% {
          opacity: 0.3;
          transform: translateX(-50%) scaleY(0.45);
        }
        55%, 100% {
          opacity: 0.82;
          transform: translateX(-50%) scaleY(1);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .k4-collection-loading,
        .k4-collection-loading__hourglass {
          transition: none;
          animation: none;
        }

        .k4-collection-loading__hourglass::before,
        .k4-collection-loading__hourglass::after {
          animation: none;
        }
      }
    </style>

    <!-- Microsoft Clarity - heatmaps & session recordings (deferred to not block render) -->
    <script define:vars={{ clarityDelayMs }}>
      // Load Clarity after page is interactive to avoid blocking LCP
      if (typeof window !== 'undefined') {
        window.addEventListener('load', function() {
          setTimeout(function() {
            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "tuibatmru4");
          }, clarityDelayMs);
        });
      }
    </script>

    <!-- Session + visitor cookie bridge: mint stable first-party IDs before analytics writes -->
    <script>
      (function () {
        try {
          function readCookie(name) {
            var match = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]+)'));
            return match ? match[1] : null;
          }

          function randomId() {
            return (window.crypto && window.crypto.randomUUID)
              ? window.crypto.randomUUID()
              : (String(Date.now()) + '-' + Math.random().toString(16).slice(2));
          }

          var domainAttr = (location.hostname && location.hostname.toLowerCase().endsWith('k4studios.com'))
            ? '; Domain=.k4studios.com'
            : '';

          function getReferrerHost() {
            try {
              return document.referrer ? new URL(document.referrer).hostname.toLowerCase() : '';
            } catch (e) {
              return '';
            }
          }

          var currentHost = (location.hostname || '').toLowerCase();
          var referrerHost = getReferrerHost();
          var now = Date.now();
          var sessionTimeoutSeconds = 30 * 60;
          var sessionTimeoutMs = sessionTimeoutSeconds * 1000;
          var shouldRotateProdSession = currentHost.endsWith('k4studios.com')
            && currentHost !== 'edge.k4studios.com'
            && (referrerHost === 'edge.k4studios.com' || referrerHost === 'localhost' || referrerHost.indexOf('localhost:') === 0);

          var sid = readCookie('k4_sid');
          var lastActivityRaw = readCookie('k4_session_last_activity') || sessionStorage.getItem('k4_session_last_activity');
          var lastActivity = Number(lastActivityRaw || 0);
          var sessionExpired = !!lastActivity && (now - lastActivity > sessionTimeoutMs);
          if (!shouldRotateProdSession && !sessionExpired && !sid) {
            sid = sessionStorage.getItem('k4_session_id');
          }
          var rotatedSession = shouldRotateProdSession || sessionExpired || !sid;
          if (rotatedSession) {
            sid = randomId();
          }
          if (sid) {
            sessionStorage.setItem('k4_session_id', sid);
            sessionStorage.setItem('k4_session_last_activity', String(now));
            if (rotatedSession) {
              sessionStorage.removeItem('k4_event_order');
              sessionStorage.removeItem('k4_entry_referrer');
              sessionStorage.removeItem('k4_campaign_attribution');
              sessionStorage.removeItem('k4_previous_page');
            }
          }

          var vid = readCookie('k4_vid');
          if (!vid) {
            try {
              vid = localStorage.getItem('k4_vid') || '';
            } catch (e) {
              vid = '';
            }
          }
          if (!vid) {
            vid = randomId();
          }

          if (vid) {
            try {
              localStorage.setItem('k4_vid', vid);
            } catch (e) {}
          }

          if (sid) {
            document.cookie = 'k4_sid=' + encodeURIComponent(sid) + '; Path=/; Max-Age=' + sessionTimeoutSeconds + '; SameSite=Lax; Secure' + domainAttr;
            document.cookie = 'k4_session_last_activity=' + encodeURIComponent(String(now)) + '; Path=/; Max-Age=' + sessionTimeoutSeconds + '; SameSite=Lax; Secure' + domainAttr;
          }
          if (vid) {
            document.cookie = 'k4_vid=' + encodeURIComponent(vid) + '; Path=/; Max-Age=31536000; SameSite=Lax; Secure' + domainAttr;
          }
        } catch (e) {}
      })();
    </script>

    <!-- K4 Custom Analytics - track all page views -->
    <script define:vars={{ analyticsDelayMs }}>
      window.__k4AnalyticsDelayMs = analyticsDelayMs;
    </script>
    <script>
      import { trackPageView } from '../utils/analytics';

      const runK4PageView = () => {
        try {
          trackPageView();
        } catch (_) {}
      };

      const analyticsDelayMs = Number(globalThis.__k4AnalyticsDelayMs || 0);

      if (analyticsDelayMs > 0 && typeof window !== 'undefined') {
        window.addEventListener('load', () => {
          window.setTimeout(() => {
            if ('requestIdleCallback' in window) {
              window.requestIdleCallback(runK4PageView, { timeout: 1000 });
            } else {
              runK4PageView();
            }
          }, analyticsDelayMs);
        }, { once: true });
      } else {
        runK4PageView();
      }
    </script>
  </head>

  <body>
    <div class="k4-collection-loading" id="k4-collection-loading" role="status" aria-live="polite" aria-hidden="true">
      <div class="k4-collection-loading__panel">
        <span class="k4-collection-loading__hourglass" aria-hidden="true"></span>
        <span class="k4-collection-loading__copy">
          <strong>Curating collection...</strong>
          <span>Loading the complete gallery.</span>
        </span>
      </div>
    </div>
    <div class="page-container">
      <slot />
    </div>
    <div id="overlay-root"></div>

    <svg width="0" height="0" style="position:absolute">
      <filter id="sharpen">
        <feConvolveMatrix order="3" kernelMatrix="0 -.5 0 -.5 3.2 -.5 0 -.5 0" divisor="1.2" />
      </filter>
    </svg>

    <script>
      (function () {
        var overlay = document.getElementById('k4-collection-loading');
        if (!overlay) return;

        function isModifiedClick(event) {
          return event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;
        }

        function shouldShowCollectionLoader(anchor) {
          if (!anchor || !anchor.href) return false;
          if (anchor.target && anchor.target.toLowerCase() !== '_self') return false;
          if (anchor.hasAttribute('download')) return false;

          var destination;
          try {
            destination = new URL(anchor.href, window.location.href);
          } catch (e) {
            return false;
          }

          if (destination.origin !== window.location.origin) return false;
          if (!/\/all\/?$/i.test(destination.pathname)) return false;

          var current = new URL(window.location.href);
          var sameDocument =
            current.pathname === destination.pathname &&
            current.search === destination.search &&
            current.hash !== destination.hash;
          if (sameDocument) return false;

          return true;
        }

        function showCollectionLoader() {
          overlay.classList.add('is-active');
          overlay.setAttribute('aria-hidden', 'false');
        }

        document.addEventListener('click', function (event) {
          if (isModifiedClick(event)) return;

          var anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
          if (!shouldShowCollectionLoader(anchor)) return;

          showCollectionLoader();
          event.preventDefault();

          window.requestAnimationFrame(function () {
            window.setTimeout(function () {
              window.location.href = anchor.href;
            }, 60);
          });
        }, true);

        window.addEventListener('pageshow', function () {
          overlay.classList.remove('is-active');
          overlay.setAttribute('aria-hidden', 'true');
        });
      })();
    </script>

  </body>
</html>
