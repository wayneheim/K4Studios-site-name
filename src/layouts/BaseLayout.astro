---
import GalleryTourSkipClearer from "../components/GalleryTourSkipClearer.jsx";

const {
  title = "Gallery",
  structuredDataJSON,
  breadcrumbsJSON,
  meta = {},
  preloadImage
} = Astro.props;

// Detect if this is an image page
const lastSegment = Astro.url?.pathname?.split("/").pop() || "";
const isImagePage = lastSegment.startsWith("i-");

// Parse site origin
const parseSite = (value) => {
  if (!value) return null;
  try { return new URL(value); } catch { return null; }
};
const siteUrl =
  parseSite(Astro.site) ||
  parseSite(import.meta.env.SITE) ||
  new URL("https://www.k4studios.com");
const siteOrigin = Astro.url?.origin || siteUrl.origin;

// Title & description logic
const galleryTitle = meta.title || title || "K4 Studios – Fine Art Photography";
let pageTitle = isImagePage
  ? (preloadImage?.title || meta.ogTitle || galleryTitle)
  : galleryTitle;

const cleanTitle = (pageTitle || "")
  .replace(/<[^>]*>/g, "")
  .replace(/\s*\|\s*Wayne Heim.*$/gi, "")
  .trim();

const defaultDescription =
  "Discover painterly fine art photography, Western stories, and historical portraits by Wayne Heim. Explore galleries, stories, and limited edition prints from K4 Studios.";

const trimDescription = (text = "", maxLength = 160) => {
  const trimmed = text.trim();
  return trimmed.length > maxLength
    ? trimmed.slice(0, trimmed.lastIndexOf(" ", maxLength)) + "…"
    : trimmed;
};

const seoDescriptionRaw =
  meta.description ||
  (isImagePage ? preloadImage?.description : null) ||
  (Astro.url?.pathname === "/"
    ? defaultDescription
    : `${cleanTitle} – Fine Art Photography by Wayne Heim`);

const seoDescription = trimDescription(seoDescriptionRaw);

// OG/Twitter images
let rawOgImage = preloadImage?.src || meta.ogImage || "/images/default-og.jpg";
const ogAlt = preloadImage?.alt || preloadImage?.title || cleanTitle;
const ogWidth = preloadImage?.width || "1600";
const ogHeight = preloadImage?.height || "1200";
const ogType = isImagePage ? "article" : "website";

const ensureAbsoluteUrl = (v) =>
  v ? new URL(v, siteOrigin).toString().replace(/^http:/, "https:") : v;

const ogImage = ensureAbsoluteUrl(rawOgImage);
const twitterCard = meta.twitterCard || (ogImage ? "summary_large_image" : "summary");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {import.meta.env.PROD && <base href="https://www.k4studios.com" />}

    <!-- ✅ Always render SEO title + description -->
    <title>{cleanTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="author" content="Wayne Heim" />
    <meta name="copyright" content="© Wayne Heim, K4 Studios" />
    <meta name="creator" content="Wayne Heim" />
    {isImagePage && <meta name="robots" content="noai, noimageai" />}

    {structuredDataJSON && (
      <script type="application/ld+json" set:html={structuredDataJSON} />
    )}
    {breadcrumbsJSON && (
      <script type="application/ld+json" set:html={breadcrumbsJSON} />
    )}

    <!-- ✅ Open Graph -->
    <meta property="og:title" content={cleanTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:width" content={ogWidth} />
    <meta property="og:image:height" content={ogHeight} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="K4 Studios – Fine Art Photography" />
    <meta property="og:locale" content="en_US" />

    <!-- ✅ Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={cleanTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!-- ✅ Pinterest (if image page) -->
    {isImagePage && (
      <>
        <meta name="pinterest:rich_title" content={preloadImage?.title || cleanTitle} />
        <meta name="pinterest:description" content={preloadImage?.story || preloadImage?.description || defaultDescription} />
        <meta name="pinterest:image" content={ogImage} />
        <meta name="pinterest:creator" content="Wayne Heim" />
      </>
    )}

    <!-- ✅ Global Schema Graph -->
    <script type="application/ld+json">
      {{
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://www.k4studios.com/#website",
            "name": "K4 Studios",
            "url": "https://www.k4studios.com",
            "publisher": { "@id": "https://www.k4studios.com/#organization" },
            "inLanguage": "en"
          },
          {
            "@type": "Organization",
            "@id": "https://www.k4studios.com/#organization",
            "name": "K4 Studios",
            "url": "https://www.k4studios.com",
            "logo": {
              "@type": "ImageObject",
              "@id": "https://www.k4studios.com/#logo",
              "url": "https://www.k4studios.com/images/K4Logo-web-b.jpg",
              "width": 512,
              "height": 512
            },
            "founder": { "@id": "https://www.k4studios.com/#person" },
            "sameAs": [
              "https://www.instagram.com/k4studios",
              "https://www.pinterest.com/k4studios",
              "https://www.linkedin.com/in/wayneheim"
            ]
          },
          {
            "@type": "Person",
            "@id": "https://www.k4studios.com/#person",
            "name": "Wayne Heim",
            "jobTitle": "Fine Art Photographer & Medical Illustrator",
            "image": "https://www.k4studios.com/images/WayneHeimPortrait.jpg",
            "url": "https://www.k4studios.com/",
            "worksFor": { "@id": "https://www.k4studios.com/#organization" },
            "sameAs": [
              "https://www.instagram.com/k4studios",
              "https://www.pinterest.com/k4studios",
              "https://www.heimmedicalart.com"
            ]
          }
        ]
      }}
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://photos.smugmug.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" rel="stylesheet" />

    {preloadImage?.src && <link rel="preload" as="image" href={preloadImage.src} />}

    <style>
      body {{
        font-family: 'Glegoo', serif;
        background: #fff;
        margin: 0;
        padding: 0;
        color: #2e2e2e;
        margin-top: 1rem;
      }}
      .page-container {{
        max-width: 1200px;
        margin: 0 auto;
        padding: 0;
      }}
    </style>

    <!-- Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0J1HSKFC04"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(...args){{window.dataLayer.push(args);}}
      gtag('js', new Date());
      gtag('config', 'G-0J1HSKFC04', {{
        'api_secret': 'puQODutySsiMJp5q3kkfhA',
        'send_page_view': true
      }});
    </script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){{
        c[a]=c[a]||function(){{(c[a].q=c[a].q||[]).push(arguments)}};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      }})(window, document, "clarity", "script", "tuibatmru4");
    </script>
  </head>

  <body>
    <GalleryTourSkipClearer client:load />
    <div class="page-container">
      <slot />
    </div>
    <div id="overlay-root"></div>

    <!-- SVG sharpening filter -->
    <svg width="0" height="0" style="position:absolute">
      <filter id="sharpen">
        <feConvolveMatrix order="3" kernelMatrix="0 -.5 0 -.5 3.2 -.5 0 -.5 0" divisor="1.2" />
      </filter>
    </svg>
  </body>
</html>
