---
import GalleryTourSkipClearer from "../components/GalleryTourSkipClearer.jsx";
import { normalizeImageSrc, extractImageId } from "@/utils/imageProxy.js";

export const prerender = true;

// ✅ Safe server-side URL parsing
let lastSegment = "";
let isImagePage = false;
let pathnameForMeta = '';
try {
  if (Astro.url?.pathname) {
    pathnameForMeta = Astro.url.pathname;
    lastSegment = Astro.url.pathname.split("/").pop() || "";
    isImagePage = lastSegment.startsWith("i-");
  }
} catch {
  isImagePage = false;
}

const {
  title = 'Gallery',
  structuredDataJSON,
  breadcrumbsJSON,
  meta = {},
  description,
  preloadImage
} = Astro.props;

// ✅ Safe URL parsing (works server-side)
const parseSite = (value) => {
  if (!value) return null;
  try {
    return new URL(value);
  } catch {
    return null;
  }
};

const siteUrl =
  parseSite(Astro.site) ||
  parseSite(import.meta.env.SITE) ||
  new URL('https://www.k4studios.com');

const siteOrigin = siteUrl.origin;
const canonicalOrigin = import.meta.env.PROD ? 'https://www.k4studios.com' : siteOrigin;

const normalizeK4Host = (value) => {
  if (!value || typeof value !== 'string') return value;
  return value.replace(/https?:\/\/(?:www\.)?k4studios\.com/gi, 'https://www.k4studios.com');
};

const ensureAbsoluteUrl = (value) => {
  if (!value) return null;
  try {
    return normalizeK4Host(new URL(value, canonicalOrigin).toString());
  } catch {
    return normalizeK4Host(value);
  }
};

const normalizeText = (value = '') =>
  String(value || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const formatPathSegment = (segment = '') =>
  segment
    .replace(/-/g, ' ')
    .replace(/\b\w/g, (m) => m.toUpperCase())
    .trim();

const deriveContextKeyword = (pathname = '') => {
  const segments = String(pathname || '').split('/').filter(Boolean);
  if (!segments.length) return '';

  const ignored = new Set(['galleries', 'other', 'show', 'shows', 'stories', 'story', 'blog']);
  const genericTail = new Set([
    'gallery',
    'all',
    'color',
    'black-white',
    'by-location',
    'by-theme',
    'by-subject',
    'portraits',
    'series',
  ]);

  const useful = segments
    .map((segment) => ({
      raw: segment,
      lower: segment.toLowerCase(),
      label: formatPathSegment(segment),
    }))
    .filter((segment) => !ignored.has(segment.lower) && !segment.lower.startsWith('i-'));

  if (!useful.length) return '';

  const chosen = [];
  for (let i = useful.length - 1; i >= 0; i -= 1) {
    const segment = useful[i];
    if (genericTail.has(segment.lower) && chosen.length === 0) {
      continue;
    }
    chosen.unshift(segment.label);
    if (chosen.length >= 2) break;
  }

  if (!chosen.length) {
    return normalizeText(useful.slice(-2).map((segment) => segment.label).join(' '));
  }

  return normalizeText(chosen.join(' '));
};

const imageContextKeyword = deriveContextKeyword(pathnameForMeta);

const trimAtWord = (text = '', maxLength = 160) => {
  const normalized = normalizeText(text);
  if (!normalized) return '';
  if (normalized.length <= maxLength) return normalized;

  const slice = normalized.slice(0, maxLength + 1);
  const boundary = slice.lastIndexOf(' ');
  const trimmed = (boundary > Math.floor(maxLength * 0.6)
    ? slice.slice(0, boundary)
    : normalized.slice(0, maxLength)).trim();

  return `${trimmed}…`;
};

const trimTitle = (text = '', maxLength = 65) => {
  const normalized = normalizeText(text);
  if (!normalized) return '';
  if (normalized.length <= maxLength) return normalized;

  const separatorPatterns = [' | ', ' – ', ' — ', ' - ', ': '];
  for (const separator of separatorPatterns) {
    const head = normalized.split(separator)[0]?.trim();
    if (head && head.length >= 18 && head.length <= maxLength) {
      return head;
    }
  }

  return trimAtWord(normalized, maxLength);
};

const normalizeImageTitle = (text = '', contextKeyword = '', imageRef = '', maximumLength = 88) => {
  const baseTitle = normalizeText(text) || 'Fine Art Photograph';
  const contextText = normalizeText(contextKeyword);
  const refText = normalizeText(imageRef);

  const baseLower = baseTitle.toLowerCase();
  const compactContext = trimAtWord(contextText, 28).replace(/[.…]+$/g, '');
  const contextSuffix =
    compactContext && !baseLower.includes(compactContext.toLowerCase())
      ? ` | ${compactContext}`
      : '';

  const withContext = `${baseTitle}${contextSuffix}`;
  const refSuffix =
    refText && !withContext.toLowerCase().includes(refText.toLowerCase())
      ? ` | ${refText}`
      : '';

  const extras = `${contextSuffix}${refSuffix}`;
  if (!extras) {
    return trimAtWord(baseTitle, maximumLength).replace(/[.…]+$/g, '');
  }

  const maxBody = Math.max(28, maximumLength - extras.length);
  const body = trimAtWord(baseTitle, maxBody).replace(/[\s|:;,.!?…]+$/g, '');
  return `${body}${extras}`;
};

const deriveNonImageTitleContext = (pathname = '') => {
  const segments = String(pathname || '').split('/').filter(Boolean);
  if (!segments.length) return '';

  const lowered = segments.map((segment) => segment.toLowerCase());
  if (lowered[0] === 'other' && lowered[1] === 'show') return 'Show Section';
  if (lowered[0] === 'other' && lowered[1] === 'stories') return 'Stories Section';

  const hasPainterly = lowered.includes('painterly-fine-art-photography');
  const hasFineArt = lowered.includes('fine-art-photography');
  const styleLabel = hasPainterly ? 'Painterly' : (hasFineArt ? 'Fine Art' : '');

  const modeMap = {
    'na-black-white': 'Native American Black & White',
    'na-color': 'Native American Color',
    'black-white': 'Black & White',
    'color': 'Color',
  };

  const modeSegment = lowered.find((segment) => Object.prototype.hasOwnProperty.call(modeMap, segment));
  const modeLabel = modeSegment ? modeMap[modeSegment] : '';

  let parentLabel = '';
  if (modeSegment && modeSegment.startsWith('na-')) {
    const modeIndex = lowered.lastIndexOf(modeSegment);
    parentLabel = formatPathSegment(segments[modeIndex - 1] || '');
  }

  const parts = [];
  if (styleLabel) parts.push(styleLabel);
  if (parentLabel) parts.push(parentLabel);
  if (modeLabel) parts.push(modeLabel);
  if (parts.length) return normalizeText(parts.join(' '));

  const ignored = new Set(['galleries', 'other', 'blog', 'index', 'all']);
  const meaningful = segments.filter((segment) => {
    const lower = segment.toLowerCase();
    return !ignored.has(lower) && !lower.startsWith('i-');
  });
  if (!meaningful.length) return styleLabel;

  const tail = [];
  for (let i = meaningful.length - 1; i >= 0; i -= 1) {
    const label = formatPathSegment(meaningful[i]);
    if (!label) continue;
    if (tail[0] && tail[0].toLowerCase() === label.toLowerCase()) continue;
    tail.unshift(label);
    if (tail.length >= 2) break;
  }

  if (styleLabel && !tail.join(' ').toLowerCase().includes(styleLabel.toLowerCase())) {
    tail.unshift(styleLabel);
  }

  return normalizeText(tail.join(' '));
};

const deriveNonImageTitleVariant = (pathname = '') => {
  const segments = String(pathname || '').split('/').filter(Boolean);
  if (!segments.length) return '';

  const lowered = segments.map((segment) => segment.toLowerCase());
  const ignored = new Set(['galleries', 'other', 'blog', 'index']);
  const meaningful = lowered.filter((segment) => !ignored.has(segment) && !segment.startsWith('i-'));
  const variantParts = [];

  if (lowered[lowered.length - 1] === 'all') {
    variantParts.push('All Images');
  }

  if (
    meaningful.length >= 2 &&
    meaningful[meaningful.length - 1] === meaningful[meaningful.length - 2]
  ) {
    variantParts.push(`${formatPathSegment(meaningful[meaningful.length - 1])} Collection`);
  }

  return normalizeText(variantParts.join(' | '));
};

const normalizeStandardTitle = (text = '', pathname = '', maximumLength = 88) => {
  const baseTitle = trimTitle(text, 72);
  const context = deriveNonImageTitleContext(pathname);
  const variant = deriveNonImageTitleVariant(pathname);
  if (!baseTitle) return baseTitle;

  const suffixParts = [];
  const baseLower = baseTitle.toLowerCase();
  if (context && !baseLower.includes(context.toLowerCase())) {
    suffixParts.push(context);
  }
  const existingSuffix = suffixParts.join(' ').toLowerCase();
  if (variant && !baseLower.includes(variant.toLowerCase()) && !existingSuffix.includes(variant.toLowerCase())) {
    suffixParts.push(variant);
  }

  if (!suffixParts.length) return baseTitle;

  const suffix = ` | ${suffixParts.join(' | ')}`;
  const maxBody = Math.max(32, maximumLength - suffix.length);
  const body = trimAtWord(baseTitle, maxBody).replace(/[\s|:;,.!?…]+$/g, '');
  return `${body}${suffix}`;
};

const appendBrandSuffix = (text = '', maximumLength = 88) => {
  const normalized = normalizeText(text);
  if (!normalized) return normalized;

  const lower = normalized.toLowerCase();
  if (lower.includes('k4 studios')) {
    return normalized;
  }

  const suffix = ' | K4 Studios';
  const maxBody = Math.max(28, maximumLength - suffix.length);
  const body = trimAtWord(normalized, maxBody).replace(/[\s|:;,.!?…]+$/g, '');
  return `${body}${suffix}`;
};

const normalizeDescription = (text = '', fallback = '', minimumLength = 110, maximumLength = 160) => {
  const normalized = normalizeText(text);
  const fallbackText = trimAtWord(fallback, maximumLength);

  if (!normalized) return fallbackText;
  if (normalized.length >= minimumLength) return trimAtWord(normalized, maximumLength);

  const supplements = [
    'Explore painterly fine art photography, Western stories, and limited edition prints at K4 Studios.',
    'View collector-focused galleries, stories, and archival print options at K4 Studios.',
  ];

  for (const supplement of supplements) {
    const combined = `${normalized} ${supplement}`.trim();
    if (combined.length >= minimumLength) {
      return trimAtWord(combined, maximumLength);
    }
  }

  return fallbackText;
};

const normalizeImageDescription = (text = '', imageTitle = '', fallback = '', imageRef = '', contextKeyword = '', maximumLength = 160) => {
  const normalized = normalizeText(text);
  const titleText = normalizeText(imageTitle);
  const fallbackText = trimAtWord(fallback, maximumLength);
  const contextText = normalizeText(contextKeyword);
  const keywordSentence = contextText ? `Part of the ${contextText} collection.` : '';
  const referenceSentence = imageRef ? `Image ${imageRef}.` : '';

  const withReference = (baseText = '') => {
    const candidate = normalizeText(baseText);
    const candidateLower = candidate.toLowerCase();
    if (!referenceSentence && !keywordSentence) return trimAtWord(candidate, maximumLength);

    const extras = [];
    if (keywordSentence && !candidateLower.includes(contextText.toLowerCase())) {
      extras.push(keywordSentence);
    }
    if (referenceSentence && !candidateLower.includes(imageRef.toLowerCase())) {
      extras.push(referenceSentence);
    }

    if (!extras.length) {
      return trimAtWord(candidate, maximumLength);
    }

    const extrasText = extras.join(' ');
    const reserve = extrasText.length + 1;
    const maxBody = Math.max(60, maximumLength - reserve);
    const body = trimAtWord(candidate, maxBody).replace(/[.!?…]+$/g, '');
    return `${body}. ${extrasText}`;
  };

  const titleHint = titleText
    ? `View ${titleText} by Wayne Heim.`
    : 'View this fine art image by Wayne Heim.';

  if (!normalized) {
    return withReference(`${titleHint} ${fallbackText}`.trim());
  }

  const hasTitleSignal = titleText && normalized.toLowerCase().includes(titleText.toLowerCase());
  if (normalized.length >= 100 && hasTitleSignal) {
    return withReference(normalized);
  }

  const cleaned = normalized.replace(/[.!?…]+$/g, '');
  return withReference(`${cleaned}. ${titleHint}`.trim());
};

// Titles
const galleryTitle = meta.title || title || 'K4 Studios – Fine Art Photography';
let pageTitle = isImagePage
  ? (preloadImage?.title || meta.ogTitle || meta.ogImageTitle || galleryTitle)
  : galleryTitle;

// Remove HTML & redundant separators
const cleanTitleBase = normalizeText(pageTitle || '')
  .replace(/\s*\|\s*Wayne Heim.*$/gi, '')
  .trim();
const cleanTitle = isImagePage
  ? normalizeImageTitle(cleanTitleBase || galleryTitle, imageContextKeyword, lastSegment)
  : normalizeStandardTitle(cleanTitleBase, pathnameForMeta);
const finalTitle = appendBrandSuffix(cleanTitle, isImagePage ? 96 : 88);

const defaultDescription =
  'Discover painterly fine art photography, Western stories, and historical portraits by Wayne Heim. Explore galleries, stories, and limited edition prints from K4 Studios.';

const seoDescriptionRaw =
  description ||
  meta.description ||
  (isImagePage ? preloadImage?.description : null) ||
  (Astro.url?.pathname === '/'
    ? defaultDescription
    : `${cleanTitle} – Fine Art Photography by Wayne Heim`);

const seoDescription = isImagePage
  ? normalizeImageDescription(seoDescriptionRaw, cleanTitle, defaultDescription, lastSegment, imageContextKeyword)
  : normalizeDescription(seoDescriptionRaw, defaultDescription);

const socialDescription =
  (isImagePage && preloadImage?.story)
    ? preloadImage.story
    : (meta.story || seoDescriptionRaw);

// ✅ OG / Twitter image setup
let rawOgImage;
let ogAlt;
let ogWidth = preloadImage?.width || "1600";
let ogHeight = preloadImage?.height || "1200";

if (isImagePage && preloadImage?.src) {
  rawOgImage = preloadImage.src;
  ogAlt = preloadImage.alt || preloadImage.title || cleanTitle;
  ogWidth = preloadImage.width || ogWidth;
  ogHeight = preloadImage.height || ogHeight;
} else if (meta.ogImage) {
  rawOgImage = meta.ogImage;
  ogAlt = meta.ogImageAlt || meta.ogImageTitle || cleanTitle;
} else {
  rawOgImage = "/images/show-2t.webp";
  ogAlt = cleanTitle;
}

const canonicalUrl = ensureAbsoluteUrl(meta.canonicalUrl || Astro.url?.pathname || '/');
const ogUrl = ensureAbsoluteUrl(meta.ogUrl || canonicalUrl);

// Convert any SmugMug URLs to proxy format for OG/Twitter images
// Default to 'l' to protect XL from bot discovery
const toAbsoluteProxyUrl = (src: string, size = 'l') => {
  if (!src) return '';
  // If it's already a local/static image, just make it absolute
  if (src.startsWith('/images/')) return ensureAbsoluteUrl(src);

  // Extract image ID and convert to absolute proxy URL
  const imageId = extractImageId(src) || (src.startsWith('i-') ? src : null);
  if (imageId) {
    return `${canonicalOrigin}/img/${imageId}/${size}.jpg`;
  }
  // Already a proxy URL? Make it absolute
  if (src.startsWith('/img/')) {
    return `${canonicalOrigin}${src.replace(/(\/(?:s|m|l|xl|src))(?:\.jpe?g)?$/i, '$1.jpg')}`;
  }
  // Fallback - try to use as-is (shouldn't happen)
  return ensureAbsoluteUrl(src);
};

// Cap OG/Twitter images at L to keep XL out of bot-discoverable surfaces
const ogImage = toAbsoluteProxyUrl(rawOgImage, 'l');
const ogImageSecureUrl = ogImage;

const ogType = isImagePage ? "article" : (meta.ogType || "website");

const twitterTitle = meta.twitterTitle || cleanTitle;
const twitterImage = toAbsoluteProxyUrl(meta.twitterImage || rawOgImage, 'l');
const twitterUrl = ensureAbsoluteUrl(meta.twitterUrl || ogUrl);

const inferMimeType = (url) => {
  if (!url) return null;
  try {
    const ext = new URL(url).pathname.split('.').pop()?.toLowerCase();
    switch (ext) {
      case 'jpg': case 'jpeg': return 'image/jpeg';
      case 'png': return 'image/png';
      case 'webp': return 'image/webp';
      case 'gif': return 'image/gif';
      case 'avif': return 'image/avif';
      default: return null;
    }
  } catch { return null; }
};

const ogImageType = meta.ogImageType || inferMimeType(ogImage) || 'image/jpeg';
const twitterCard = meta.twitterCard || (twitterImage ? 'summary_large_image' : 'summary');
const normalizedStructuredDataJSON = normalizeK4Host(structuredDataJSON);
const normalizedBreadcrumbsJSON = normalizeK4Host(breadcrumbsJSON);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {import.meta.env.PROD && <base href="https://www.k4studios.com" />}

    <title>{finalTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="author" content="Wayne Heim" />
    <meta name="copyright" content="© Wayne Heim, K4 Studios" />
    <meta name="creator" content="Wayne Heim" />
    {isImagePage && <meta name="robots" content="index, follow, noai, noimageai" />}
    <link rel="canonical" href={canonicalUrl} />

    {normalizedStructuredDataJSON && <script type="application/ld+json" set:html={normalizedStructuredDataJSON}></script>}
    {normalizedBreadcrumbsJSON && <script type="application/ld+json" set:html={normalizedBreadcrumbsJSON}></script>}

    <!-- ✅ OG / Twitter -->
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={socialDescription || seoDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImageSecureUrl && <meta property="og:image:secure_url" content={ogImageSecureUrl} />}
    <meta property="og:image:width" content={ogWidth} />
    <meta property="og:image:height" content={ogHeight} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="K4 Studios – Fine Art Photography" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={appendBrandSuffix(twitterTitle, isImagePage ? 96 : 88)} />
    <meta name="twitter:description" content={socialDescription} />
    {twitterImage && <meta name="twitter:image" content={twitterImage} />}
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="twitter:url" content={twitterUrl} />

    <!-- ✅ Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Glegoo&display=swap" rel="stylesheet" />

    <style>
      body {
        font-family: 'Glegoo', serif;
        background: #fff;
        margin: 0;
        padding: 0;
        color: #2e2e2e;
        margin-top: 1rem;
      }
      .page-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0;
      }
    </style>

    <!-- Microsoft Clarity - heatmaps & session recordings (deferred to not block render) -->
    <script>
      // Load Clarity after page is interactive to avoid blocking LCP
      if (typeof window !== 'undefined') {
        window.addEventListener('load', function() {
          setTimeout(function() {
            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "tuibatmru4");
          }, 2000); // 2 second delay after load
        });
      }
    </script>

    <!-- Session + visitor cookie bridge: mint stable first-party IDs before analytics writes -->
    <script>
      (function () {
        try {
          function readCookie(name) {
            var match = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]+)'));
            return match ? match[1] : null;
          }

          function randomId() {
            return (window.crypto && window.crypto.randomUUID)
              ? window.crypto.randomUUID()
              : (String(Date.now()) + '-' + Math.random().toString(16).slice(2));
          }

          var domainAttr = (location.hostname && location.hostname.toLowerCase().endsWith('k4studios.com'))
            ? '; Domain=.k4studios.com'
            : '';

          function getReferrerHost() {
            try {
              return document.referrer ? new URL(document.referrer).hostname.toLowerCase() : '';
            } catch (e) {
              return '';
            }
          }

          var currentHost = (location.hostname || '').toLowerCase();
          var referrerHost = getReferrerHost();
          var shouldRotateProdSession = currentHost.endsWith('k4studios.com')
            && currentHost !== 'edge.k4studios.com'
            && (referrerHost === 'edge.k4studios.com' || referrerHost === 'localhost' || referrerHost.indexOf('localhost:') === 0);

          var sid = readCookie('k4_sid');
          if (!shouldRotateProdSession && !sid) {
            sid = sessionStorage.getItem('k4_session_id');
          }
          if (shouldRotateProdSession || !sid) {
            sid = randomId();
          }
          if (sid) {
            sessionStorage.setItem('k4_session_id', sid);
            sessionStorage.removeItem('k4_event_order');
          }

          var vid = readCookie('k4_vid');
          if (!vid) {
            try {
              vid = localStorage.getItem('k4_vid') || '';
            } catch (e) {
              vid = '';
            }
          }
          if (!vid) {
            vid = randomId();
          }

          if (vid) {
            try {
              localStorage.setItem('k4_vid', vid);
            } catch (e) {}
          }

          if (sid) {
            document.cookie = 'k4_sid=' + encodeURIComponent(sid) + '; Path=/; SameSite=Lax; Secure' + domainAttr;
          }
          if (vid) {
            document.cookie = 'k4_vid=' + encodeURIComponent(vid) + '; Path=/; Max-Age=31536000; SameSite=Lax; Secure' + domainAttr;
          }
        } catch (e) {}
      })();
    </script>

    <!-- K4 Custom Analytics - track all page views -->
    <script>
      import { trackPageView } from '../utils/analytics';

      trackPageView();
    </script>
    
    <!-- Allow pages to inject custom head content -->
    <slot name="head" />
  </head>

  <body>
    <GalleryTourSkipClearer client:load />
    <div class="page-container">
      <slot />
    </div>
    <div id="overlay-root"></div>

    <svg width="0" height="0" style="position:absolute">
      <filter id="sharpen">
        <feConvolveMatrix order="3" kernelMatrix="0 -.5 0 -.5 3.2 -.5 0 -.5 0" divisor="1.2" />
      </filter>
    </svg>

  <!-- 🧹 SmugMug JSON-LD scrubber (robust final client-side fallback) -->
<script>
  function removeSmugMugJsonLd() {
    document.querySelectorAll('script[type="application/ld+json"]').forEach((s) => {
      try {
        const text = s.textContent.trim();
        if (!text.includes("photos.smugmug.com")) return;
        const json = JSON.parse(text);
        if (
          (json["@type"] === "ImageObject" || json.type === "ImageObject") &&
          (!json["@id"] || !text.includes('"creditText"'))
        ) {
          console.log("🧹 Removed SmugMug JSON-LD injected block");
          s.remove();
        }
      } catch {}
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    removeSmugMugJsonLd();

    const observer = new MutationObserver((mutations) => {
      let needsClean = false;
      for (const m of mutations) {
        for (const n of m.addedNodes) {
          if (n.nodeType === 1 && (n as Element).tagName === "SCRIPT") {
            needsClean = true;
          }
        }
      }
      if (needsClean) removeSmugMugJsonLd();
    });

    // Watch both head and body for new scripts
    observer.observe(document.documentElement, { childList: true, subtree: true });

    // Safety sweep after 5s for very delayed injects
    setTimeout(removeSmugMugJsonLd, 5000);
  });
</script>

  </body>
</html>
